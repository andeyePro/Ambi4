{
  "name": "ambi4",
  "compatibility_date": "2026-07-24",
  "routes": [
    { "pattern": "ambi4.work", "custom_domain": true },
    { "pattern": "www.ambi4.work", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },

  // Staging. Same static assets, its own Worker and its own hostname, so a
  // build can be looked at on a real device before it reaches ambi4.work.
  //
  // Build it with PUBLIC_AMBI4_ENV=dev so the footer stamp says which site you
  // are on and every page carries noindex — a second indexed copy of the whole
  // app would compete with the real one for its own name.
  //
  //   PUBLIC_AMBI4_ENV=dev npm run build && npx wrangler deploy --env dev
  //
  // The custom_domain route creates the mcdev DNS record on the first deploy,
  // provided the ambi4.work zone sits in the same Cloudflare account.
  "env": {
    "dev": {
      "name": "ambi4-dev",
      "routes": [
        { "pattern": "mcdev.ambi4.work", "custom_domain": true }
      ],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
