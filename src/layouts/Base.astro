---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Customisable endless music generated just for you, to help you work.' } = Astro.props;
import '../styles/global.css';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navLinks = [
  { href: '/', label: 'Generator' },
  { href: '/playlists/', label: 'Playlists' },
];
const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === currentPath;
---
<html lang="en-gb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">Ambi4: Ambience for Work</a>
      <nav class="site-nav" aria-label="Site">
        {navLinks.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>&copy; 2024&ndash;2026 <a href="https://andeye.com">andeye Ltd</a></span>
      <span> · Coded with <a href="https://vibe.andeye.com" rel="noopener noreferrer" target="_blank">Vibe</a></span>
      <span> · <a href="https://andeye.com/terms">Terms</a></span>
      <span> · <a href="https://andeye.com/privacy">Privacy</a></span>
    </footer>
  </body>
</html>

<style>
  .site-nav {
    display: flex;
    gap: 20px;
    margin-top: 8px;
    font-family: var(--label-font);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-nav a {
    color: var(--secondary);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:hover {
    color: var(--link);
  }

  .site-nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    border-bottom-color: var(--accent-warm);
  }
</style>
