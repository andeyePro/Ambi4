---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Customisable endless music generated just for you, to help you work.' } = Astro.props;
import '../styles/global.css';
import pkg from '../../package.json';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Playlists parked 2026-07-25 (imagery + artist range being rebuilt) — page stays
// reachable at /playlists/, just not in the nav.
const navLinks = [
  { href: '/', label: 'Generator' },
];
const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === currentPath;

// Build stamp — Astro exposes neither a build date nor the deploy commit SHA
// by default. process.env is only available in frontmatter (build-time
// Node), guarded in case a future runtime doesn't provide it.
let buildSha = '';
try {
  buildSha = (process.env.CF_PAGES_COMMIT_SHA ?? process.env.WORKERS_CI_COMMIT_SHA ?? '').slice(0, 7);
} catch {
  buildSha = '';
}
const buildDate = new Date().toISOString().slice(0, 10);

// Deploy environment. `dev` is the mcdev.ambi4.work staging site, which serves
// the SAME ./dist as production — so the only way to tell the two apart is a
// build-time flag. It does two things: stamps the footer so a screenshot says
// which site it came from, and keeps the staging copy out of search results,
// because a second indexed copy of the whole app would compete with the real
// one for its own name.
let deployEnv = '';
try {
  deployEnv = String(process.env.PUBLIC_AMBI4_ENV ?? '').trim().toLowerCase();
} catch {
  deployEnv = '';
}
const isProduction = deployEnv === '' || deployEnv === 'production';
const buildStamp =
  `v${pkg.version} · ${buildDate}${buildSha ? ' ' + buildSha : ''}` +
  (isProduction ? '' : ` · ${deployEnv}`);
---
<html lang="en-gb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {!isProduction && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">Ambi4: Ambience for Work</a>
      <!-- v0.0.41: the nav row carries page-level actions on its right. The
           guided-tour `?` lives here rather than in the transport panel, where
           it sat beside the Processor label and read as documentation for the
           processor control. A page with no actions renders nothing. -->
      <div class="site-nav-row">
        <nav class="site-nav" aria-label="Site">
          {navLinks.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
          ))}
        </nav>
        <div class="site-actions"><slot name="header-actions" /></div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>&copy; 2024&ndash;2026 <a href="https://andeye.com">andeye Ltd</a></span>
      <span> · Coded with <a href="https://vibe.andeye.com" rel="noopener noreferrer" target="_blank">Vibe</a></span>
      <span> · <a href="https://andeye.com/terms">Terms</a></span>
      <span> · <a href="https://andeye.com/privacy">Privacy</a></span>
      <span> · <a href="https://github.com/andeyePro/Ambi4">AGPL-3.0 source</a></span>
      <span class="build-stamp">{buildStamp}</span>
    </footer>
  </body>
</html>

<style>
  .site-nav-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    /* v0.0.44: matches the content column. The layout wrapper is 720px minus
       32px of padding, but the generator itself is capped at 640px, so a header
       action pinned to the wrapper's edge overhung the panels below it by 48px.
       Right-aligned actions have to share the column they sit above. */
    max-width: 640px;
  }

  .site-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .site-nav {
    display: flex;
    gap: 20px;
    margin-top: 8px;
    font-family: var(--label-font);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-nav a {
    color: var(--secondary);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:hover {
    color: var(--link);
  }

  .site-nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    border-bottom-color: var(--accent-warm);
  }

    .build-stamp {
    display: inline-block;
    color: var(--secondary);
    font-size: 11px;
    opacity: 0.75;
  }
</style>
