---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Customisable endless music generated just for you, to help you work.' } = Astro.props;
import '../styles/global.css';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Playlists parked 2026-07-25 (imagery + artist range being rebuilt) — page stays
// reachable at /playlists/, just not in the nav.
const navLinks = [
  { href: '/', label: 'Generator' },
];
const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === currentPath;

// Build stamp — Astro exposes neither a build date nor the deploy commit SHA
// by default. process.env is only available in frontmatter (build-time
// Node), guarded in case a future runtime doesn't provide it.
let buildSha = '';
try {
  buildSha = (process.env.CF_PAGES_COMMIT_SHA ?? process.env.WORKERS_CI_COMMIT_SHA ?? '').slice(0, 7);
} catch {
  buildSha = '';
}
const buildDate = new Date().toISOString().slice(0, 10);
const buildStamp = buildSha ? `build ${buildDate} ${buildSha}` : `build ${buildDate}`;
---
<html lang="en-gb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">Ambi4: Ambience for Work</a>
      <nav class="site-nav" aria-label="Site">
        {navLinks.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>&copy; 2024&ndash;2026 <a href="https://andeye.com" class="andeye-link"><svg class="andeye-wink" viewBox="0 0 24 24" aria-hidden="true"><g class="eye-open"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.6" fill="currentColor"/></g><path class="eye-wink" d="M4 13c2.5 2.5 5 3.5 8 3.5s5.5-1 8-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>andeye Ltd</a></span>
      <span> · Coded with <a href="https://vibe.andeye.com" rel="noopener noreferrer" target="_blank">Vibe</a></span>
      <span> · <a href="https://andeye.com/terms">Terms</a></span>
      <span> · <a href="https://andeye.com/privacy">Privacy</a></span>
      <span class="build-stamp">{buildStamp}</span>
    </footer>
  </body>
</html>

<style>
  .site-nav {
    display: flex;
    gap: 20px;
    margin-top: 8px;
    font-family: var(--label-font);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-nav a {
    color: var(--secondary);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:hover {
    color: var(--link);
  }

  .site-nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    border-bottom-color: var(--accent-warm);
  }

  /* Placeholder wink mark (hand-coded SVG, not AI art) pending the official
     andeye logo asset. Text-height, blinks every few seconds; static when the
     user prefers reduced motion. */
  .andeye-link { display: inline-flex; align-items: center; gap: 4px; }
  .andeye-wink { height: 1em; width: 1em; }
  .andeye-wink .eye-wink { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .andeye-wink .eye-open { animation: andeye-blink 6s infinite; }
    .andeye-wink .eye-wink { animation: andeye-wink 6s infinite; }
    @keyframes andeye-blink { 0%, 91%, 97%, 100% { opacity: 1; } 92%, 96% { opacity: 0; } }
    @keyframes andeye-wink { 0%, 91%, 97%, 100% { opacity: 0; } 92%, 96% { opacity: 1; } }
  }

  .build-stamp {
    display: inline-block;
    color: var(--secondary);
    font-size: 11px;
    opacity: 0.75;
  }
</style>
