---
interface Props {
  playlist: string;
  title: string;
}
const { playlist, title } = Astro.props;
---
<iframe
  allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
  height="450"
  style="width:100%;max-width:720px;overflow:hidden;border-radius:10px;border:0;"
  src={`https://embed.music.apple.com/gb/playlist/${playlist}`}
  title={`Apple Music playlist: ${title}`}
></iframe>
