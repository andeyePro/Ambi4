---
/**
 * PresetCover — a deterministic, code-drawn cover for a generator-made
 * playlist. No external asset, no fetch, no AI art: the seed string (a
 * preset slug, or any other stable identifier) is hashed and the hash
 * alone drives every visual choice below. Same seed always renders the
 * same SVG, byte for byte — the provenance IS the algorithm.
 *
 * This exists for the `ambi4-made` playlist category (see TODO.md
 * ## Parked): entries there have no sourced image, so `artwork` stays
 * `null` and `presetSeed` selects this cover instead. It intentionally
 * does not touch the real Web Audio engine or its live params — it is a
 * cheap, deterministic stand-in derived only from the seed text, not a
 * rendering of the actual generated audio.
 *
 * Usage: <PresetCover seed={entry.data.presetSeed} title={entry.data.title} />
 */
interface Props {
  seed: string;
  size?: number;
  title?: string;
}

const { seed, size = 480, title } = Astro.props;

// FNV-1a — small, dependency-free, stable across platforms.
function fnv1a(str: string): number {
  let h = 0x811c9dc5;
  for (let i = 0; i < str.length; i += 1) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return h >>> 0;
}

// mulberry32 — deterministic PRNG seeded from the FNV-1a hash above.
function mulberry32(seed32: number): () => number {
  let a = seed32;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(fnv1a(seed));
const next = (min: number, max: number) => min + rand() * (max - min);

const cx = size / 2;
const cy = size / 2;

const bgHue = Math.floor(next(0, 360));
const bg = `hsl(${bgHue} 38% 11%)`;

// One arc per "track" — a stand-in for pad/arp/melody/bass/percussion,
// echoing the generator's own track model without reading it directly.
const TRACK_COUNT = 5;
const arcs = Array.from({ length: TRACK_COUNT }, (_, i) => {
  const hue = (bgHue + 40 + i * next(35, 65)) % 360;
  const radius = (size / 2) * (0.28 + (i / TRACK_COUNT) * 0.62) * next(0.92, 1.08);
  const startAngle = next(0, 360);
  const sweep = next(70, 220) * (rand() < 0.5 ? 1 : -1);
  const strokeWidth = next(2, 7);
  const opacity = next(0.35, 0.85);

  const toXY = (angleDeg: number) => {
    const a = (angleDeg * Math.PI) / 180;
    return [cx + radius * Math.cos(a), cy + radius * Math.sin(a)];
  };
  const [x1, y1] = toXY(startAngle);
  const [x2, y2] = toXY(startAngle + sweep);
  const largeArc = Math.abs(sweep) > 180 ? 1 : 0;
  const sweepFlag = sweep > 0 ? 1 : 0;

  return {
    d: `M ${x1.toFixed(2)} ${y1.toFixed(2)} A ${radius.toFixed(2)} ${radius.toFixed(2)} 0 ${largeArc} ${sweepFlag} ${x2.toFixed(2)} ${y2.toFixed(2)}`,
    stroke: `hsl(${hue.toFixed(0)} 65% 62%)`,
    strokeWidth: strokeWidth.toFixed(2),
    opacity: opacity.toFixed(2),
  };
});

// A short waveform-style polyline across the centre, again seed-derived.
const WAVE_POINTS = 24;
const waveAmplitude = size * 0.09;
const wavePoints = Array.from({ length: WAVE_POINTS }, (_, i) => {
  const x = (size * 0.12) + (i / (WAVE_POINTS - 1)) * (size * 0.76);
  const y = cy + Math.sin(i * next(0.4, 0.9) + fnv1a(`${seed}:${i}`)) * waveAmplitude * next(0.6, 1);
  return `${x.toFixed(2)},${y.toFixed(2)}`;
}).join(' ');
const waveHue = (bgHue + 180) % 360;
---

<svg
  class="preset-cover"
  viewBox={`0 0 ${size} ${size}`}
  width={size}
  height={size}
  role="img"
  aria-label={title ? `Generated cover for ${title}` : `Generated cover (seed: ${seed})`}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="0" y="0" width={size} height={size} fill={bg} />
  {arcs.map((arc) => (
    <path
      d={arc.d}
      fill="none"
      stroke={arc.stroke}
      stroke-width={arc.strokeWidth}
      stroke-linecap="round"
      opacity={arc.opacity}
    />
  ))}
  <polyline
    points={wavePoints}
    fill="none"
    stroke={`hsl(${waveHue.toFixed(0)} 70% 75%)`}
    stroke-width="2"
    stroke-linecap="round"
    opacity="0.9"
  />
</svg>

<style>
  .preset-cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius, 8px);
  }
</style>
