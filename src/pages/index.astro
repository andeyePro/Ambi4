            arp: { state: 'on', voice: 'crystal', level: 0.6, randomness: 0.7 },
            melody: { state: 'on', voice: 'flute', level: 0.6, randomness: 0.65, dissonance: 0.35 },
            bass: { state: 'auto', voice: 'sub', level: 0.7 },
