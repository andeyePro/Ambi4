      max-width: 220px;
      margin-bottom: 0;
      padding-top: 20px; /* headroom for the centre mark ("Evolving") */
      --knob-size: 96px;
    }

    .dial-slot {
      display: flex;
      justify-content: center;
    }

    /* -- processor dial (transport panel) -- */

    .processor-row {
      display: flex;
      align-items: center;
      gap: 12px;
      --knob-size: 64px;
    }

    .processor-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    /* -- v13 tooltips + ⓘ info boxes -- */

    .ui-tooltip {
      position: absolute;
      z-index: 40;
      max-width: 260px;
      padding: 6px 9px;
      font-size: 13px;
      line-height: 1.4;
      color: var(--text);
      background: var(--panel, var(--bg));
      border: 1px solid var(--panel-edge, var(--border));
      border-radius: var(--radius);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      pointer-events: none;
    }

    .info-anchor {
      position: relative;
      display: inline-flex;
    }

    .info-button {
      width: 22px;
      height: 22px;
      font-size: 12px;
      font-style: italic;
    }

    .info-box {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 30;
      width: max-content;
      max-width: min(360px, calc(100vw - 32px));
      padding: 10px 12px;
      font-size: 13px;
      line-height: 1.5;
      color: var(--text);
      background: var(--panel, var(--bg));
      border: 1px solid var(--panel-edge, var(--border));
      border-radius: var(--radius);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    }

    /* -- v13 click-to-type readouts -- */

    .typable {
      padding: 1px 4px;
      font: inherit;
      color: inherit;
      background: none;
      border: 1px dashed transparent;
      border-radius: 4px;
      cursor: text;
    }

    .typable:hover,
    .typable:focus-visible {
      border-color: var(--border);
    }

    .typable-input {
      width: 5em;
      padding: 1px 4px;
      font: inherit;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--link);
      border-radius: 4px;
    }

    .control input[type='range'] {
      width: 100%;
    }

    .control select {
      width: 100%;
      padding: 8px;
      font-size: 16px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .control input:focus-visible,
    .control select:focus-visible,
    .presets-group input:focus-visible,
    .presets-group select:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .hint {
      margin-top: 6px;
      color: var(--secondary);
      font-size: 14px;
    }

    /* -- presets fieldset (the old sleep/alarm fieldset was replaced by the
          transport popovers below) -- */

    .presets-group {
      margin-bottom: 20px;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .presets-group legend {
      padding: 0 6px;
      font-weight: 700;
    }

    .timer-row,
    .preset-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .timer-custom {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .presets-group input[type='text'] {
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      flex: 1 1 160px;
    }

    .presets-group select {
      flex: 1 1 160px;
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* -- segmented control (3-state track state / 2-state arp mode) -- */

    .segmented {
      display: inline-flex;
      flex-wrap: wrap;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .segmented input[type='radio'] {
      position: absolute;
      opacity: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }

    .segmented label {
      padding: 6px 12px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      color: var(--text);
      border-right: 1px solid var(--border);
    }

    .segmented label:last-of-type {
      border-right: none;
    }

    .segmented input[type='radio']:checked + label {
      background: var(--link);
      color: var(--bg);
    }

    .segmented input[type='radio']:focus-visible + label {
      outline: 3px solid var(--link);
      outline-offset: -3px;
    }

    /* -- tracks section -- */

    .tracks-section {
      margin-bottom: 24px;
    }

    .tracks-heading {
      font-size: 16px;
      margin-top: 0;
      margin-bottom: 12px;
    }

    .track-rows {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* v14: ONE line per track — lamp+name, voice, Level, Randomness, Edit —
       with the track's own colour as a left accent bar. */
    .track-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      padding-left: 8px;
      border-left: 3px solid var(--track-accent, var(--border));
    }

    /* v9 cost meter: a thin bar showing how many notes this track has
       sounding, tinted with the track colour. Populated at 1 Hz while the
       engine runs, hidden when there are no stats to show. */
    .cost-meter {
      display: block;
      width: 100%;
      height: 3px;
      margin-top: 2px;
      background: var(--panel-inset, var(--border));
      border-radius: 2px;
      overflow: hidden;
    }

    .cost-meter-fill {
      display: block;
      width: 0;
      height: 100%;
      background: var(--track-accent, var(--link));
      transition: width 0.4s linear;
    }

    /* Status strip under the row's controls: what the engine is actually
       resolving to right now, plus the cost meter. */
    .track-foot {
      display: block;
      flex-basis: 100%;
    }

    .resolved-readout {
      display: block;
      color: var(--secondary);
      font-size: 12px;
      font-family: var(--label-font, inherit);
      letter-spacing: 0.04em;
      min-height: 14px;
    }

    .track-name {
      width: 84px;
      flex-shrink: 0;
      font-weight: 600;
    }

    /* v12: track-name is now a lamp button — off/auto/on lamp dot (black/
       grey/white) + the track name, cycling state on click, native <button>
       so it's keyboard-operable for free. */
    .track-lamp {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      width: 84px;
      border: none;
      background: none;
      padding: 3px 4px;
      margin: -3px -4px;
      border-radius: var(--radius);
      cursor: pointer;
      font: inherit;
      color: inherit;
      text-align: left;
    }

    .track-lamp:hover {
      background: var(--panel-inset, rgba(255, 255, 255, 0.08));
    }

    .track-lamp:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    /* The lamp dot is the shared .track-chip, so it carries the track's own
       identity colour; state modulates how lit it reads. */
    .track-row[data-track-state='off'] .lamp-dot {
      background: var(--knob-face);
      opacity: 0.5;
    }

    .track-row[data-track-state='auto'] .lamp-dot {
      opacity: 0.65;
    }

    .track-row[data-track-state='on'] .lamp-dot {
      opacity: 1;
      box-shadow: 0 0 5px var(--track-accent, var(--knob-pointer));
    }

    /* v8: melody/bass ship state 'off' — a textual cue (not colour alone)
       so a silent track is obviously wake-able, not just quietly missing. */
    .track-row[data-track-state='off'] .track-name {
      color: var(--secondary);
      font-weight: 400;
      font-style: italic;
    }

    .track-row[data-track-state='off'] .track-name::after {
      content: ' — off';
    }

    .track-voice {
      flex: 1 1 140px;
      min-width: 120px;
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* v8: per-track Level knob/slider, in the main tracks-panel row */
    .track-level {
      display: flex;
      align-items: center;
    }

    .level-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .level-slider {
      display: inline-flex;
      align-items: center;
    }

    .level-slider input[type='range'] {
      width: 120px;
    }

    .voice-edit-toggle[aria-expanded='true'] {
      background: var(--link);
      color: var(--bg);
      border-color: var(--link);
    }

    /* -- track-extras: Random / Hold / Randomness cluster (main row AND the
          voice editor header mirror share this class) -- */

    .track-extras {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }

    .rand-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .rand-slider {
      display: inline-flex;
      align-items: center;
    }

    .rand-slider input[type='range'] {
      width: 120px;
    }

    /* -- voice editor module (faceplate look comes from .module-panel) -- */

    .voice-editor {
      margin-top: 10px;
    }

    .scope-head {
      position: relative;
      max-width: 420px;
      margin: 0 auto 16px;
    }

    .patch-scope {
      display: block;
      width: 100%;
      height: 130px;
      background: var(--scope-bg, #10140f);
      border: 1px solid var(--panel-edge, var(--border));
      border-radius: var(--radius);
    }

    .scope-mode {
      position: absolute;
      top: 8px;
      right: 10px;
      font-family: var(--label-font, inherit);
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--secondary);
    }

    .scope-mode-live {
      color: var(--accent-warm, #d98324);
    }

    .knob-sections {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 14px;
    }

    .knob-section > .panel-label {
      display: block;
      margin-bottom: 8px;
    }

    /* Knobs wrap into a grid; still usable at 360 px viewport width. */
    .knob-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
      gap: 12px 8px;
      align-items: end;
      justify-items: center;
    }

    .knob-cell {
      display: flex;
      justify-content: center;
      width: 100%;
    }

    .knob-cell-toggle {
      align-self: center;
    }

    /* v12: shape-dial glyph readout (knob.js's `glyph` option) — icon(s)
       inline before the text, coloured with the readout's own text colour. */
    .knob-value-glyph {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      margin-right: 4px;
      vertical-align: middle;
      color: var(--text);
    }

    .osc2-toggle[aria-pressed='true'] {
      background: var(--link);
      color: var(--bg);
      border-color: var(--link);
    }

    .voice-editor .ve-section {
      margin-bottom: 12px;
    }

    .voice-editor .ve-heading {
      display: block;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--secondary);
    }

    .voice-editor .ve-control {
      margin-bottom: 10px;
    }

    .voice-editor .ve-control label {
      font-size: 14px;
    }

    .voice-editor select {
      width: 100%;
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* -- v6/v8: voice-editor header (track name + Random/Hold/Randomness) -- */

    .ve-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
    }

    .ve-extras {
      flex: 1 1 auto;
      justify-content: flex-end;
    }

    /* -- v6: per-track randomisation-target mini knobs -- */

    .vary-row {
      margin-bottom: 16px;
    }

    .vary-row > .panel-label {
      display: block;
      margin-bottom: 8px;
    }

    .vary-cells {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 8px;
    }

    .vary-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .vary-slider {
      flex: 1 1 160px;
      margin-bottom: 0;
    }

    /* -- v6: arpeggiator section (relocated into the Arp track's editor) -- */

    .arp-inline {
      margin-bottom: 20px;
    }

    .arp-inline > .panel-label {
      display: block;
      margin-bottom: 8px;
    }

    .arp-manual {
      margin-top: 10px;
    }

    /* -- v6: shared step sequencer (melody/bass/arp single-lane,
          percussion three-lane) — grid width driven by --seq-cols, set by
          the page script per track/metre/arp-rate -- */

    .seq {
      margin-bottom: 20px;
    }

    .seq-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
    }

    .seq-scroll {
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .seq-beats,
    .seq-lane {
      display: grid;
      grid-template-columns: repeat(var(--seq-cols, 16), minmax(22px, 1fr));
      gap: 3px;
    }

    .seq-beats {
      margin-bottom: 2px;
    }

    /* Pulls the (now separate role="row") probability strip back up
       against its own cell row rather than sitting a full flex gap away. */
    .seq-prob-row {
      margin-top: -3px;
    }

    .seq-beat-mark {
      font-size: 10px;
      text-align: center;
      color: var(--secondary);
    }

    .seq-rows {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .seq-lane-label {
      grid-column: 1 / -1;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--secondary);
    }

    /* v14 multi-sequencer strip: tab per sequencer, "+" copies the current
       one, and one weight number ("how likely the others hand over to me"). */
    .seq-tabs {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .seq-tabs-single .seq-tab-strip,
    .seq-tabs-single .seq-weight {
      display: none;
    }

    .seq-title {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .seq-add {
      padding: 4px 12px;
      line-height: 1;
    }

    .seq-weight {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--secondary);
    }

    .seq-weight input {
      width: 68px;
      padding: 4px 6px;
      font-size: 13px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* v14 probability groups: a dot per step above its lane, coloured by
       group. Inside a group a step only gets its chance if the group's
       previous step actually sounded. */
    .seq-dot-row {
      margin-bottom: 2px;
    }

    .seq-dot-cell {
      display: flex;
      justify-content: center;
    }

    .seq-dot {
      width: 10px;
      height: 10px;
      padding: 0;
      background: none;
      border: 1px solid var(--border);
      border-radius: 50%;
      cursor: pointer;
    }

    .seq-dot-on {
      border-color: transparent;
    }

    .seq-dot:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 2px;
    }

    .seq-cell {
      position: relative;
      min-height: 48px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      cursor: pointer;
      overflow: hidden;
    }

    .seq-cell-beat {
      border-left: 2px solid var(--accent-warm, var(--link));
    }

    .seq-cell-on {
      border-color: var(--link);
    }

    .seq-cell:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .seq-band {
      position: absolute;
      display: block;
      left: 2px;
      right: 2px;
      bottom: 0;
      height: 0;
      background: var(--accent-warm, var(--link));
      opacity: 0.55;
      border-radius: 2px;
      pointer-events: none;
    }

    .seq-cell-on .seq-band {
      opacity: 0.85;
    }

    /* Fat grab handle riding the band's loud edge — ≥10 px tall so the
       velocity top is grabbable without pixel-hunting (v13 correction). */
    .seq-band-top {
      position: absolute;
      display: block;
      left: 0;
      right: 0;
      height: 12px;
      margin-bottom: -6px;
      cursor: ns-resize;
      touch-action: none;
    }

    .seq-band-top::after {
      content: '';
      position: absolute;
      left: 2px;
      right: 2px;
      top: 5px;
      height: 2px;
      border-radius: 2px;
      background: var(--knob-pointer, var(--text));
      opacity: 0.7;
    }

    /* A tied step bridges visually into the next one: one long note. */
    .seq-cell-tie {
      border-right-color: transparent;
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
    }

    .seq-cell-tie::after {
      content: '';
      position: absolute;
      right: -4px;
      top: 45%;
      width: 5px;
      height: 3px;
      background: var(--accent-warm, var(--link));
    }

    /* v14 playhead: the sounding step lights up. The cream --knob-pointer
       reads as the asked-for white on the dark theme; --text carries the
       mark on the light theme, where a literal white would vanish. */
    .seq-cell-playing {
      border-color: var(--text);
      box-shadow: inset 0 0 0 2px var(--knob-pointer);
    }

    .seq-prob {
      position: relative;
      display: block;
      height: 5px;
      margin-top: 2px;
      background: var(--border);
      border-radius: 3px;
      cursor: pointer;
      overflow: hidden;
    }

    .seq-prob-fill {
      position: absolute;
      display: block;
      top: 0;
      left: 0;
      bottom: 0;
      width: 0;
      background: var(--link);
    }

    /* A ranged (drifting) step prob shows its min–max window instead of a
       from-zero fill, tinted like the knob's own range arc. */
    .seq-prob-fill-range {
      background: var(--accent-warm, var(--link));
      opacity: 0.85;
    }

    /* -- v14: dissonance dial, factory presets, tutorial panel -- */

    .dissonance-row {
      display: flex;
      align-items: flex-end;
      margin-bottom: 16px;
    }

    .dissonance-knob {
      width: 84px;
    }

    .factory-presets {
      margin-bottom: 20px;
    }

    .factory-presets > .panel-label {
      display: block;
      margin-bottom: 10px;
    }

    .factory-preset-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 8px;
    }

    .factory-preset {
      display: flex;
      flex-direction: column;
      gap: 3px;
      align-items: flex-start;
      text-align: left;
    }

    .factory-preset-name {
      font-weight: 700;
    }

    .factory-preset-blurb {
      font-weight: 400;
      font-size: 13px;
      color: var(--secondary);
    }

    /* Docked right of the main column on a wide screen; a plain block
       beneath it on a narrow one. */
    .tutorial-panel {
      position: fixed;
      top: 96px;
      right: 16px;
      z-index: 25;
      width: 280px;
      max-height: calc(100vh - 128px);
      overflow-y: auto;
    }

    .tutorial-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
    }

    .tutorial-step-text {
      margin: 0 0 12px;
      font-size: 14px;
      line-height: 1.5;
    }

    .tutorial-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .tutorial-highlight {
      outline: 3px solid var(--accent-warm, var(--link));
      outline-offset: 4px;
      border-radius: var(--radius);
    }

    @media (max-width: 1100px) {
      .tutorial-panel {
        position: static;
        width: auto;
        max-width: 640px;
        max-height: none;
        margin-bottom: 20px;
      }
    }

    /* -- custom structure builder -- */

    .custom-structure {
      margin: -8px 0 20px;
    }

    .structure-blocks {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 12px;
    }

    .structure-block {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      padding: 8px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .structure-block select {
      width: auto;
      padding: 6px;
    }

    .structure-block input[type='number'] {
      width: 64px;
      padding: 6px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .structure-block input[type='range'] {
      flex: 1 1 100px;
    }

    .structure-block button {
      padding: 4px 8px;
      font-size: 13px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .structure-block button:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .secondary-button {
      padding: 8px 14px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .secondary-button:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    #generator-unavailable {
      color: var(--secondary);
    }

    /* -- small-screen touch targets (~44px) -- */

    @media (max-width: 480px) {
