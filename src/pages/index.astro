      color: var(--secondary);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .step-cell-marked {
      font-weight: 700;
    }

    .step-cell[aria-pressed='true'] {
      background: var(--link);
      color: var(--bg);
      border-color: var(--link);
    }

    .step-cell:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    #generator-unavailable {
      color: var(--secondary);
    }

    /* -- small-screen touch targets (~44px) -- */

    @media (max-width: 480px) {
      .step-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .step-cell {
        min-height: 44px;
        padding: 14px 0;
        font-size: 14px;
      }

      .segmented label {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 10px 14px;
      }
    }
  </style>
