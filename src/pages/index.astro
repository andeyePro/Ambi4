      {
        name: 'Long Corridor',
        blurb: 'One chord, drifting filters, no hurry at all.',
        params: {
          bpm: 44, root: 'B', mode: 'aeolian', timeSignature: '3/4',
          complexity: 0.2, repetition: 0.85, structure: 'drone', volume: 0.68,
          tracks: {
            pad: { state: 'on', voice: 'strings', level: { min: 0.55, max: 0.85 }, randomness: 0.12 },
            arp: { state: 'off' },
            melody: { state: 'off' },
            bass: { state: 'off' },
            texture: { state: 'auto', voice: 'grains', level: { min: 0.3, max: 0.55 }, randomness: 0.2 },
            percussion: { state: 'off' },
          },
        },
      },
    ];

    const DEFAULTS = {
      swing: 0,
      complexity: 0.5,
      repetition: 0.5,
      volume: 0.8,
      root: 'C',
      mode: 'majorPentatonic',
      timeSignature: '4/4',
      bpm: 60,
      structure: 'auto',
      customStructure: [
        { label: 'A', bars: 8, intensity: 0.4 },
        { label: 'B', bars: 8, intensity: 0.7 },
      ],
      arp: {
        mode: 'auto',
        pattern: 'up',
        rate: '1/8',
        octaves: 2,
        gate: 0.6,
        steps: new Array(16).fill(true),
      },
      tracks: {
        pad: { state: 'auto', voice: 'warm', level: 0.8, hold: false, randomness: 0.5, dissonance: 0, vary: defaultVary() },
        arp: {
          state: 'auto',
          voice: 'softPluck',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...withSequencers('arp'),
        },
        // v14 user verdict: melody joins the default mix ('auto'); bass stays
        // OFF until the groove rework passes the listener's own gate.
        melody: {
          state: 'auto',
          voice: 'pluck',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...withSequencers('melody'),
        },
        bass: {
          state: 'off',
          voice: 'sub',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...withSequencers('bass'),
        },
        texture: { state: 'auto', voice: 'sparkle', level: 0.8, hold: false, randomness: 0.5, dissonance: 0, vary: defaultVary() },
        percussion: {
          state: 'auto',
          voice: 'soft',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          vary: defaultVary(),
          ...withSequencers('percussion'),
        },
      },
      patches: {},
      // `ui` is page-only state: stripped before anything reaches the engine
      // (engineParamsFrom) or a preset snapshot (paramsSnapshot).
      ui: { activeTab: 'simple', processor: 'auto', tutorialOpen: false, tutorialStep: 0 },
    };

    // Used only when a voice doesn't export .defaults (older engine-voices).
    const FALLBACK_PATCH = {
      source: { osc1: 'sine', osc2: null, mix: 0.5, detune: 4, octave: 0 },
      filter: { type: 'lowpass', cutoff: 2000, q: 0.7, envAmount: 0.3 },
      adsr: { attack: 0.01, decay: 0.2, sustain: 0.7, release: 0.5 },
      sends: { reverb: 0.3, delay: 0.15 },
    };

    function isPlainObject(value) {
      return value !== null && typeof value === 'object' && !Array.isArray(value);
    }

    /**
     * Deep-merge `saved` over `defaults`; arrays are replaced wholesale.
     * Keys present only in `saved` are kept (needed for the sparse `patches`
     * map, whose keys aren't in DEFAULTS).
     */
    function deepMerge(defaults, saved) {
      if (Array.isArray(defaults)) {
        return Array.isArray(saved) ? saved : defaults;
      }
      if (isPlainObject(defaults)) {
        if (!isPlainObject(saved)) return structuredClone(defaults);
        const out = {};
        for (const key of Object.keys(defaults)) {
          out[key] = deepMerge(defaults[key], saved[key]);
        }
        for (const key of Object.keys(saved)) {
          if (!(key in out)) out[key] = structuredClone(saved[key]);
        }
        return out;
      }
      return saved === undefined ? defaults : saved;
    }

    // ---- v7 RangeValue (number | {min,max}) helpers ----------------------

    function isNumberOrRange(v) {
      return (
        (typeof v === 'number' && Number.isFinite(v)) ||
        (isPlainObject(v) && typeof v.min === 'number' && typeof v.max === 'number')
      );
    }

    /** Clamp/repair a RangeValue field over an arbitrary [lo,hi] domain;
     * falls back to `fallback` when `v` is neither a finite number nor a
     * valid {min,max} pair. The voice-patch fields (Hz, seconds, cents, Q)
     * that went rangeable in the v7 sweep live outside 0–1, hence the
     * explicit domain — normaliseRangeValue below is the 0–1 specialisation
     * used by the track-level fields (level, randomness, sequencer prob). */
    function sanitiseRangeValueIn(v, lo, hi, fallback) {
      if (typeof v === 'number' && Number.isFinite(v)) return clamp(v, lo, hi);
      if (isPlainObject(v) && Number.isFinite(v.min) && Number.isFinite(v.max)) {
        let min = clamp(v.min, lo, hi);
        let max = clamp(v.max, lo, hi);
        if (min > max) [min, max] = [max, min];
        return { min, max };
      }
      return fallback;
    }

    /** Clamp/repair a RangeValue field; falls back to `fallback` (a plain
     * number) when `v` is neither a finite number nor a {min,max} object. */
    function normaliseRangeValue(v, fallback) {
      return sanitiseRangeValueIn(v, 0, 1, fallback);
    }

    /** A representative plain number for a RangeValue field — used by
     * controls that stay single-value editors (sequencer prob keyboard
     * path, slider fallbacks) even though the field itself may hold a
     * drifting {min,max}. */
    function rangeMid(v) {
      return typeof v === 'number' ? v : (v.min + v.max) / 2;
    }

    /** Apply `fn` to a RangeValue's number(s), preserving its shape —
     * for rounding/clamping a knob's emitted number|{min,max} before it's
     * written into patch/settings state. */
    function mapRV(v, fn) {
      return isPlainObject(v) ? { min: fn(v.min), max: fn(v.max) } : fn(v);
    }

    // ---- sequencer step-prob range helpers (0–1 domain only) ------------
    // The step-prob keyboard/pointer editors stay single-value EDITORS (they
    // move one number: the midpoint), but must not silently collapse a
    // {min,max} loaded from a preset/older save — these keep the window's
    // width while sliding it, clamping/sliding at the 0–1 edges rather than
    // truncating the width there.

    function clampProbWindow(mid, width) {
      let min = mid - width / 2;
      let max = mid + width / 2;
      if (min < 0) {
        max -= min;
        min = 0;
      }
      if (max > 1) {
        min -= max - 1;
        max = 1;
      }
      return { min: clamp(min, 0, 1), max: clamp(max, 0, 1) };
    }

    /** Move a prob RangeValue's midpoint to `mid`, keeping its width; a
     * plain number just becomes `mid`. */
    function shiftRangeMid(v, mid) {
      mid = clamp(mid, 0, 1);
      if (!isPlainObject(v)) return mid;
      const width = clamp(v.max - v.min, 0, 1);
      return clampProbWindow(mid, width);
    }

    /** Widen/narrow a prob RangeValue by `delta` around its current
     * midpoint (splitting a plain number into a range on first widen);
     * narrowing to ~0 collapses back to a plain number. */
    function resizeRangeWidth(v, delta) {
      const isRange = isPlainObject(v);
      const width = isRange ? clamp(v.max - v.min, 0, 1) : 0;
      const mid = isRange ? clamp((v.min + v.max) / 2, 0, 1) : clamp(v, 0, 1);
      const nextWidth = clamp(width + delta, 0, 1);
      if (nextWidth <= 0.001) return mid;
      return clampProbWindow(mid, nextWidth);
    }

    // ---- v6 sequencer migration + normalisation -------------------------

    /**
     * Pre-v6 saves (and submitted presets) carry the arp step mask as 16
     * booleans in arp.steps with no tracks.arp.sequencer. Map them into the
     * new Step shape once, per the contract (on → prob 1, band 0.5–0.9);
     * slots 16–19 pad with "on" (the legacy default). Mutates `saved`.
     */
    function migrateLegacyArpSteps(saved) {
      if (!isPlainObject(saved)) return;
      const legacy =
        isPlainObject(saved.arp) && Array.isArray(saved.arp.steps) ? saved.arp.steps : null;
      if (!legacy) return;
      if (
        isPlainObject(saved.tracks) &&
        isPlainObject(saved.tracks.arp) &&
        isPlainObject(saved.tracks.arp.sequencer)
      ) {
        return; // already v6-shaped; the sequencer is the source of truth
      }
      const steps = Array.from({ length: SEQ_SLOTS }, (_, i) => ({
        on: i < legacy.length ? !!legacy[i] : true,
        prob: 1,
        vmin: 0.5,
        vmax: 0.9,
      }));
      if (!isPlainObject(saved.tracks)) saved.tracks = {};
      if (!isPlainObject(saved.tracks.arp)) saved.tracks.arp = {};
      saved.tracks.arp.sequencer = {
        mode: saved.arp.mode === 'manual' ? 'manual' : 'auto',
        steps,
      };
    }

    function normaliseLane(arr, kind) {
      const out = defaultLane(kind);
      if (!Array.isArray(arr)) return out;
      for (let i = 0; i < SEQ_SLOTS; i++) {
        const s = arr[i];
        if (typeof s === 'boolean') {
          out[i] = { on: s, prob: 1, vmin: 0.5, vmax: 0.9 };
          continue;
        }
        if (!isPlainObject(s)) continue;
        const num = (v, d) => (typeof v === 'number' && Number.isFinite(v) ? clamp(v, 0, 1) : d);
        // prob is rangeable (v7 addendum) — preserve a valid {min,max}
        // instead of collapsing it to the plain-number fallback. vmin/vmax
        // are NOT rangeable (a per-note velocity band already), so they
        // stay plain numbers via num().
        const step = { on: s.on === true, prob: normaliseRangeValue(s.prob, 1), vmin: num(s.vmin, 0.5), vmax: num(s.vmax, 0.9) };
        if (step.vmin > step.vmax) [step.vmin, step.vmax] = [step.vmax, step.vmin];
        // v14 tie/group are OPTIONAL: a step that never carried one keeps the
        // key absent, matching the engine's own sanitiser so a round-trip
        // through getParams() doesn't grow the payload.
        if (s.tie === true) step.tie = true;
        if (Number.isFinite(s.group) && s.group >= 0) step.group = Math.floor(s.group);
        out[i] = step;
      }
      return out;
    }

    /** One sequencer of a track's list: mode + Markov transition weights +
     * lane(s). `weights` is padded/truncated to the list length by the caller. */
    function normaliseSequencer(seq, track) {
      const src = isPlainObject(seq) ? seq : {};
      const steps =
        track === 'percussion'
          ? (() => {
              const raw = isPlainObject(src.steps) ? src.steps : {};
              return {
                low: normaliseLane(raw.low, 'low'),
                mid: normaliseLane(raw.mid, 'mid'),
                high: normaliseLane(raw.high, 'high'),
              };
            })()
          : normaliseLane(src.steps, track);
      const weights = Array.isArray(src.weights)
        ? src.weights.map((w) => (Number.isFinite(w) ? clamp(w, 0, 100) : 1))
        : [1];
      return { mode: src.mode === 'manual' ? 'manual' : 'auto', weights: weights.length ? weights : [1], steps };
    }

    /**
     * Rebuild a track's sequencer LIST. A pre-v14 save carries only the
     * singular `sequencer`; it becomes sequencers[0]. Afterwards `sequencer`
     * is re-pointed at sequencers[0] (the same object, as the engine does)
     * so every v6-era read/write path still works unchanged.
     */
    function normaliseSequencerList(t, track) {
      const list = Array.isArray(t.sequencers) && t.sequencers.length
        ? t.sequencers
        : [isPlainObject(t.sequencer) ? t.sequencer : {}];
      t.sequencers = list.slice(0, SEQ_MAX).map((seq) => normaliseSequencer(seq, track));
      const n = t.sequencers.length;
      for (const seq of t.sequencers) {
        seq.weights = Array.from({ length: n }, (unused, i) =>
          i < seq.weights.length ? seq.weights[i] : 1
        );
      }
      t.sequencer = t.sequencers[0];
    }

    /**
     * Runs after every deepMerge over DEFAULTS: clamps the v6 track fields,
     * rebuilds step arrays as fresh 20-slot objects (also breaking any
     * aliasing of DEFAULTS' arrays), and re-derives the legacy arp.steps
     * boolean mirror from the arp sequencer's on-flags.
     */
    function normaliseV6Tracks(s) {
      s.swing = clamp(typeof s.swing === 'number' && Number.isFinite(s.swing) ? s.swing : 0, 0, 1);
      for (const id of TRACK_IDS) {
        const t = s.tracks[id];
        t.level = normaliseRangeValue(t.level, 0.8);
        t.hold = t.hold === true;
        // Rangeable (v7 addendum) — preserve a valid {min,max}; only a
        // genuinely invalid value falls back to the 0.5 default.
        t.randomness = normaliseRangeValue(t.randomness, 0.5);
        if (TUNED_TRACKS.includes(id)) t.dissonance = normaliseRangeValue(t.dissonance, 0);
        else delete t.dissonance;
        const vary = isPlainObject(t.vary) ? t.vary : {};
        t.vary = defaultVary();
        for (const [key] of VARY_KEYS) {
          const v = vary[key];
          if (typeof v === 'number' && Number.isFinite(v)) t.vary[key] = clamp(v, 0, 1);
        }
      }
      for (const id of SEQ_TRACKS) normaliseSequencerList(s.tracks[id], id);
      // Legacy boolean mask follows the arp's FIRST sequencer (kept for older
      // engines and for the combined-complexity estimate).
      s.arp.steps = s.tracks.arp.sequencers[0].steps.slice(0, 16).map((st) => !!st.on);
    }

    // ---- tempo mapping (one tempo, two views) ---------------------------
    // The Simple "Speed" slider position t (0–1) is a log-mapped view of
    // bpm 40–120 with 60 bpm at the slider centre, using two log segments:
    //   t <= 0.5:  bpm = 40 * (60/40)^(t/0.5)
    //   t >  0.5:  bpm = 60 * (120/60)^((t-0.5)/0.5)
    // The engine always receives { bpm, speed: 1 } — `speed` is deprecated
    // at the UI level per the v3 contract addendum.
    // 20-220 bpm (commercially-proven extremes), 60 bpm at the dial centre.
    function bpmFromSpeedT(t) {
      return t <= 0.5
        ? 20 * Math.pow(3, t / 0.5)
        : 60 * Math.pow(220 / 60, (t - 0.5) / 0.5);
    }
    function speedTFromBpm(bpm) {
      return bpm <= 60
        ? 0.5 * (Math.log(bpm / 20) / Math.log(3))
        : 0.5 + 0.5 * (Math.log(bpm / 60) / Math.log(220 / 60));
    }

    function logToValue(t, min, max) {
      return min * Math.pow(max / min, t);
    }
    function valueToLog(v, min, max) {
      return Math.log(v / min) / Math.log(max / min);
    }

    function clamp(v, lo, hi) {
      return Math.min(hi, Math.max(lo, v));
    }

    // ---- oscillator shape model (v5 morph) ------------------------------
    // shape: 0 sine, 1 triangle, 2 sawtooth, 3 square; fractional = morph.
    // Legacy persisted patches (and older voice defaults) store strings in
    // osc1/osc2 — map them onto the dial.
    const SHAPE_NAMES = ['sine', 'triangle', 'sawtooth', 'square'];
    const SHAPE_LABELS = ['Sine', 'Tri', 'Saw', 'Sq'];
    const SHAPE_FROM_STRING = { sine: 0, triangle: 1, sawtooth: 2, square: 3 };

    // v12: mini waveform glyphs for the shape dials — inline SVG paths on a
    // 24×24 canvas, stroked in currentColor so they pick up the theme's
    // tick/text colour wherever they're placed (ring mark or readout).
    const SHAPE_GLYPH_PATHS = [
      // sine
      '<path d="M1 12 C4 3 8 3 12 12 C16 21 20 21 23 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
      // triangle
      '<path d="M1 12 L6.5 3 L12 12 L17.5 21 L23 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
      // sawtooth
      '<path d="M2 20 L11 4 L11 20 L20 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
      // square
      '<path d="M2 20 L2 4 L11 4 L11 20 L20 20 L20 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
    ];

    // v14: what each canonical mark sounds like, shown as an SVG <title> on
    // the mark glyph — a native tooltip that reaches AT as well, and needs no
    // knob.js change (markGlyphs markup is inserted verbatim).
    const SHAPE_MARK_HINTS = [
      'Sine — pure, no harmonics: the softest of the four.',
      'Triangle — odd harmonics, falling away fast: hollow and flute-like.',
      'Sawtooth — every harmonic: bright and brassy, the richest.',
      'Square — odd harmonics only: hollow but strong, clarinet-ish.',
    ];

    function shapeMarkGlyph(index) {
      return `<title>${SHAPE_MARK_HINTS[index]}</title>${SHAPE_GLYPH_PATHS[index]}`;
    }

    // Passed to knob.js's `markGlyphs`: one entry per canonical mark value.
    // The 24×24 paths are centred on the mark by the -12,-12 translate.
    const SHAPE_MARK_GLYPHS = Object.fromEntries(
      [0, 1, 2, 3].map((i) => [
        i,
        `<svg viewBox="0 0 24 24" width="12" height="12" x="-6" y="-6" overflow="visible">${shapeMarkGlyph(i)}</svg>`,
      ])
    );

    // ---- v14 live mini-waveform readout ---------------------------------
    // The shape dials used to print "Saw~Sq" and a pair of static icons. The
    // readout is now a tiny trace of the ACTUAL interpolated wave: the four
    // canonical shapes are crossfaded sample-by-sample, which is exactly
    // linear interpolation of their Fourier coefficients (the engine's own
    // morph), so what you see is the wave you get. Redrawn only when the
    // value changes — knob.js calls `glyph` from updateView, never on a timer.
    function canonicalWave(kind, phase) {
      switch (kind) {
        case 0:
          return Math.sin(2 * Math.PI * phase);
        case 1:
          // 0 at phase 0, +1 at a quarter, -1 at three quarters — in phase
          // with the sine above, so a morph between them never lurches.
          return 4 * Math.abs(phase - Math.floor(phase + 0.75) + 0.25) - 1;
        case 2:
          return 2 * (phase - Math.floor(phase + 0.5));
        default:
          return phase < 0.5 ? 1 : -1;
      }
    }

    function morphedWave(shape, phase) {
      const c = clamp(shape, 0, 3);
      const lo = Math.floor(c);
      const hi = Math.min(3, lo + 1);
      const t = c - lo;
      return canonicalWave(lo, phase) * (1 - t) + canonicalWave(hi, phase) * t;
    }

    const WAVE_W = 46;
    const WAVE_H = 18;
    const WAVE_SAMPLES = 64;

    function shapeGlyph(v) {
      const points = [];
      for (let i = 0; i <= WAVE_SAMPLES; i++) {
        const phase = i / WAVE_SAMPLES;
        const y = WAVE_H / 2 - morphedWave(v, phase) * (WAVE_H / 2 - 1.5);
        points.push(`${((phase * WAVE_W).toFixed(1))},${y.toFixed(1)}`);
      }
      return (
        `<svg class="wave-readout" viewBox="0 0 ${WAVE_W} ${WAVE_H}" width="${WAVE_W}" height="${WAVE_H}" aria-hidden="true">` +
        `<polyline points="${points.join(' ')}" fill="none" stroke="currentColor" stroke-width="1.5" ` +
        'stroke-linejoin="round" stroke-linecap="round"/></svg>'
      );
    }

    function readShape(source, n) {
      const shape = source[`shape${n}`];
      if (typeof shape === 'number' && Number.isFinite(shape)) return clamp(shape, 0, 3);
      if (typeof shape === 'string' && shape in SHAPE_FROM_STRING) {
        return SHAPE_FROM_STRING[shape];
      }
      const osc = source[`osc${n}`];
      if (typeof osc === 'string' && osc in SHAPE_FROM_STRING) return SHAPE_FROM_STRING[osc];
      return null;
    }

    // Write both key families: shape1/shape2 numbers are authoritative for a
    // v5 engine/voices build; nearest-string osc1/osc2 keeps an older build
    // (or a not-yet-updated sanitiser) honouring the edit.
    function writeShape(source, n, value) {
      if (value === null) {
        source[`shape${n}`] = null;
        source[`osc${n}`] = null;
        return;
      }
      const v = clamp(value, 0, 3);
      source[`shape${n}`] = v;
      source[`osc${n}`] = SHAPE_NAMES[Math.round(v)];
    }

    async function loadPrefsModule() {
      try {
        const mod = await import('../scripts/prefs.js');
        if (mod && mod.prefs && typeof mod.prefs.get === 'function') {
          return { prefs: mod.prefs, consentPrompt: mod.consentPrompt };
        }
      } catch {
        // fall through to the session-memory shim
      }
      // prefs.js missing or broken: degrade to session-memory settings.
      const mem = new Map();
      return {
        prefs: {
          consent: () => 'denied',
          setConsent: () => {},
          get: (k) => (mem.has(k) ? structuredClone(mem.get(k)) : null),
          set: (k, v) => {
            mem.set(k, structuredClone(v));
            return false;
          },
          remove: (k) => {
            mem.delete(k);
          },
        },
        consentPrompt: async () => false,
      };
    }

    async function init() {
      if (typeof window.AudioContext === 'undefined' && typeof window.webkitAudioContext === 'undefined') {
        unavailable.hidden = false;
        return;
      }

      let createEngine;
      try {
        ({ createEngine } = await import('../scripts/ambient-engine.js'));
      } catch {
        unavailable.hidden = false;
        return;
      }

      const engine = createEngine();

      // ---- v6 capability detection --------------------------------------
      // Gating choice: the new params (hold / randomness / vary / sequencer)
      // are always SENT — the engine sanitiser drops unknown keys safely, so
      // a pre-v6 engine just ignores them and they still persist for later.
      // But controls the user could see doing nothing are only RENDERED when
      // the engine advertises support: getParams() exposing the field, and
      // randomise being a function. Exception: the arp step grid always
      // renders, because its on/off flags degrade gracefully to the legacy
      // arp.steps boolean mask that every v2+ engine honours.
      const engineCaps = {
        randomise: typeof engine.randomise === 'function',
        getResolved: typeof engine.getResolved === 'function',
        getStats: typeof engine.getStats === 'function',
        setPowerBudget: typeof engine.setPowerBudget === 'function',
        swing: false,
        randomness: {},
        dissonance: {},
        vary: {},
        sequencer: {},
        sequencers: {},
        level: {},
      };
      try {
        const p = engine.getParams() || {};
        engineCaps.swing = typeof p.swing === 'number';
        const t = isPlainObject(p.tracks) ? p.tracks : {};
        for (const id of TRACK_IDS) {
          const entry = isPlainObject(t[id]) ? t[id] : {};
          // Accept a plain {min,max} RangeValue too (v7), not just a bare
          // number — a range-shipping engine must not make the knob vanish.
          engineCaps.randomness[id] = isNumberOrRange(entry.randomness);
          engineCaps.dissonance[id] = isNumberOrRange(entry.dissonance);
          engineCaps.vary[id] = isPlainObject(entry.vary);
          engineCaps.sequencer[id] = isPlainObject(entry.sequencer);
          engineCaps.sequencers[id] = Array.isArray(entry.sequencers);
          engineCaps.level[id] = isNumberOrRange(entry.level);
        }
      } catch {}

      const { prefs, consentPrompt } = await loadPrefsModule();

      // ---- settings load + legacy migration -----------------------------

      let settings;
      {
        let saved = null;
        try {
          saved = prefs.get('generator');
        } catch {
          saved = null;
        }
        let migratedFromLegacy = false;
        if (!saved) {
          try {
            const raw = localStorage.getItem(LEGACY_STORAGE_KEY);
            if (raw) {
              saved = JSON.parse(raw);
              // v2 had independent speed (0.25–2) and bpm; v3 has one tempo.
              // Fold the old multiplier into bpm on migration.
              if (typeof saved.speed === 'number' && typeof saved.bpm === 'number') {
                saved.bpm = Math.round(clamp(saved.bpm * saved.speed, 20, 220));
              }
              delete saved.speed;
              migratedFromLegacy = true;
            }
          } catch {
            saved = null;
          }
        }
        if (migratedFromLegacy) {
          // The data is in memory now — drop the stale key unconditionally
          // so later loads can never re-migrate over newer settings.
          try {
            localStorage.removeItem(LEGACY_STORAGE_KEY);
          } catch {}
        }
        migrateLegacyArpSteps(saved);
        settings = deepMerge(DEFAULTS, saved || {});
        normaliseV6Tracks(settings);
        if (migratedFromLegacy && prefs.consent() === 'granted') {
          prefs.set('generator', settings);
        }
      }

      // ---- consent-gated persistence ------------------------------------

      const consentSlot = document.getElementById('consent-slot');
      let deniedThisSession = false;
      let consentAsking = null;

      function ensureConsent() {
        const c = prefs.consent();
        if (c === 'granted') return Promise.resolve(true);
        if (c === 'denied' || deniedThisSession) return Promise.resolve(false);
        if (!consentAsking) {
          consentAsking = Promise.resolve(
            consentPrompt(consentSlot, 'Remember your settings and presets on this device?')
          )
            .then((granted) => {
              if (!granted) deniedThisSession = true;
              consentAsking = null;
              return granted;
            })
            .catch(() => {
              deniedThisSession = true;
              consentAsking = null;
              return false;
            });
        }
        return consentAsking;
      }

      function persistKey(key, value) {
        // prefs.set without consent writes to session memory and returns
        // false — so the value survives in-session either way.
        prefs.set(key, value);
        if (prefs.consent() === 'granted') {
          try {
            localStorage.removeItem(LEGACY_STORAGE_KEY);
          } catch {}
          return;
        }
        if (prefs.consent() === null && !deniedThisSession) {
          ensureConsent().then((granted) => {
            if (granted) {
              prefs.set(key, value);
              try {
                localStorage.removeItem(LEGACY_STORAGE_KEY);
              } catch {}
            }
          });
        }
      }

      // Sliders fire an input event per pixel of drag; debounce the storage
      // write. pagehide flushes any pending write (see lifecycle handlers).
      let persistTimer = null;
      function persistSettings() {
        if (persistTimer !== null) clearTimeout(persistTimer);
        persistTimer = setTimeout(() => {
          persistTimer = null;
          persistKey('generator', settings);
        }, 250);
      }
      function flushPersistSettings() {
        if (persistTimer !== null) {
          clearTimeout(persistTimer);
          persistTimer = null;
          persistKey('generator', settings);
        }
      }

      // ---- visualiser (optional decoration) -----------------------------

      const canvas = document.getElementById('track-visualiser');
      let visualiserHandle = null;
      // Declared up here (not with the governor block below) because
      // updateScopeMode reads the budget and can run before it.
      let governor = null;
      let powerBudget = null;
      try {
      const { initVisualiser } = await import('../scripts/visualiser.js');
        visualiserHandle = initVisualiser(canvas, engine);
      } catch {
        // The generator works without it.
      }

      // ---- element handles ----------------------------------------------

      const toggleButton = document.getElementById('toggle-play');
      const playLabel = toggleButton.querySelector('.play-toggle-label');
      const playGlyph = toggleButton.querySelector('.play-glyph');
      const finishGlyph = toggleButton.querySelector('.finish-glyph');
      const stopNowButton = document.getElementById('stop-now');
      const recordButton = document.getElementById('record-toggle');
      const recordStatus = document.getElementById('record-status');
      const transportStatus = document.getElementById('transport-status');

      // v15: a transport control can be demoted to Advanced-only by adding
      // its data-transport id to SIMPLE_HIDDEN — nothing else changes.
      function applyTransportVisibility(tabName) {
        for (const el of document.querySelectorAll('[data-transport]')) {
          const owner = el.closest('.popover-anchor') || el;
          owner.hidden = tabName === 'simple' && SIMPLE_HIDDEN.has(el.dataset.transport);
        }
      }

      // iOS routes Web Audio through the ringer channel, so the hardware
      // silent switch mutes it — surface a hint only where it applies.
      const isIOS =
        /iP(hone|ad|od)/.test(navigator.platform || '') ||
        (navigator.maxTouchPoints > 1 && /Mac/.test(navigator.platform || ''));
      if (isIOS) document.getElementById('ios-silent-hint').hidden = false;

      // v12: the Simple tab's five dials (Speed/Complexity/Repetition/
      // Randomness/Volume) are built further down, once knobApi has loaded —
      // `.set(v)` normalises knob-vs-slider-fallback for every call site
      // above that point (setTempo, updateComplexityDisplay, syncUIFromSettings).
      let speedDial = null;
      let complexityDial = null;
      let repetitionDial = null;
      let randomnessDial = null;
      let volumeDial = null;
      let swingDial = null;
      let processorDial = null;
      const rootSelect = document.getElementById('root');
      const modeSelect = document.getElementById('mode');
      const timeSignatureSelect = document.getElementById('timeSignature');
      const bpmInput = document.getElementById('bpm');
      const bpmReadout = document.getElementById('bpm-readout');
      let bpmTypable = null;
      const structureSelect = document.getElementById('structure');

      function engineParamsFrom(s) {
        const p = structuredClone(s);
        delete p.ui;
        p.speed = 1; // deprecated at UI level; back-compat pin
        return p;
      }

      // ---- combined-complexity estimate (display only) ------------------
      // When the user hand-sets advanced choices, the complexity slider
      // becomes a read-out of a derived "combined complexity" estimate. It
      // moves ONLY the slider thumb — never engine params, never the stored
      // complexity, never the advanced choices. Components (each 0–1,
      // included only when hand-set):
      //   structure != auto → mean section intensity of the chosen preset:
      //     drone 0.35, waves 0.50, build 0.55, abab 0.55, journey 0.55,
      //     custom = mean of the custom blocks' intensities
      //   arp manual → (enabled-step fraction) × rate weight
      //     (1/4 → 0.4, 1/8 → 0.6, 1/8T → 0.7, 1/16 → 0.9)
      //   any track forced on → (tracks with state 'on') / 6
      // estimate = arithmetic mean of the included components. With nothing
      // hand-set the slider shows the stored complexity.
      const STRUCTURE_MEAN_INTENSITY = {
        drone: 0.35,
        waves: 0.5,
        build: 0.55,
        abab: 0.55,
        journey: 0.55,
      };
      const ARP_RATE_WEIGHT = { '1/4': 0.4, '1/8': 0.6, '1/8T': 0.7, '1/16': 0.9 };

      function updateComplexityDisplay() {
        const parts = [];
        if (settings.structure !== 'auto') {
          if (settings.structure === 'custom' && settings.customStructure.length) {
            parts.push(
              settings.customStructure.reduce((s, b) => s + b.intensity, 0) /
                settings.customStructure.length
            );
          } else {
            parts.push(STRUCTURE_MEAN_INTENSITY[settings.structure] ?? 0.5);
          }
        }
        if (settings.arp.mode === 'manual') {
          // Density against the true per-bar step count, not the fixed
          // 16-slot legacy mirror length — otherwise a slow arp rate (few
          // steps actually in play) reads as artificially sparse.
          const n = Math.min(16, arpStepsPerBar());
          const frac = n > 0 ? settings.arp.steps.slice(0, n).filter(Boolean).length / n : 0;
          parts.push(frac * (ARP_RATE_WEIGHT[settings.arp.rate] ?? 0.6));
        }
        const forcedOn = TRACK_IDS.filter((id) => settings.tracks[id].state === 'on').length;
        if (forcedOn > 0) parts.push(forcedOn / TRACK_IDS.length);
        const shown = parts.length
          ? parts.reduce((s, p) => s + p, 0) / parts.length
          : settings.complexity;
        complexityDial?.set(clamp(shown, 0, 1));
      }

      // ---- tempo (one value, two views) ---------------------------------

      function setTempo(bpm, { skipSpeedThumb = false } = {}) {
        bpm = Math.round(clamp(bpm, 20, 220));
        settings.bpm = bpm;
        bpmInput.value = String(bpm);
        bpmTypable?.refresh();
        if (!skipSpeedThumb) speedDial?.set(speedTFromBpm(bpm));
        engine.setParams({ bpm, speed: 1 });
        persistSettings();
      }

      bpmInput.addEventListener('input', () => {
        setTempo(parseInt(bpmInput.value, 10));
      });

      // ---- simple dials (built once knobApi has loaded, further down) ---
      // Commit bodies for Complexity/Repetition/Volume/Randomness live next
      // to buildSimpleDial(); this is the fan-out helper Randomness needs.

      function meanRandomness() {
        const vals = TRACK_IDS.map((id) =>
          rangeMid(sanitiseRangeValueIn(settings.tracks[id].randomness, 0, 1, 0.5))
        );
        return vals.reduce((a, b) => a + b, 0) / vals.length;
      }

      /**
       * What the Simple tab's fused Randomness dial should READ. Normally the
       * dial's own x, recovered exactly: every track carries the same
       * randomness and repetition is its mirror (1 - x), so the shared value —
       * range included — is handed straight back. Once the Advanced tab has
       * hand-set repetition or an individual track's randomness to something
       * no single x could produce, it falls back to the blended estimate
       * ((1 - repetition) + mean(randomness)) / 2: a display only, exactly
       * like the combined-complexity read-out, never written anywhere.
       */
      function fusedRandomnessValue() {
        const first = settings.tracks[TRACK_IDS[0]].randomness;
        const shape = JSON.stringify(first);
        const uniform = TRACK_IDS.every(
          (id) => JSON.stringify(settings.tracks[id].randomness) === shape
        );
        const mid = rangeMid(sanitiseRangeValueIn(first, 0, 1, 0.5));
        if (uniform && Math.abs(1 - settings.repetition - mid) < 0.02) return first;
        return clamp((1 - settings.repetition + meanRandomness()) / 2, 0, 1);
      }

      for (const [select, key] of [
        [rootSelect, 'root'],
        [modeSelect, 'mode'],
        [timeSignatureSelect, 'timeSignature'],
      ]) {
        select.addEventListener('change', () => {
          settings[key] = select.value;
          engine.setParams({ [key]: select.value });
          if (key === 'timeSignature') {
            // Metre drives steps-per-bar: re-render any open step grids.
            for (const ed of openEditors.values()) {
              try {
                ed.seq?.refresh();
              } catch {}
            }
          }
          persistSettings();
        });
      }

      // ---- tabs ----------------------------------------------------------

      const tabButtons = [
        document.getElementById('tab-simple'),
        document.getElementById('tab-advanced'),
      ];
      const tabPanels = {
        simple: document.getElementById('panel-simple'),
        advanced: document.getElementById('panel-advanced'),
      };
      const tabNames = ['simple', 'advanced'];

      function activateTab(name, { focus = false, persist = true } = {}) {
        if (!tabNames.includes(name)) name = 'simple';
        tabButtons.forEach((button, i) => {
          const active = tabNames[i] === name;
          button.setAttribute('aria-selected', String(active));
          button.tabIndex = active ? 0 : -1;
          tabPanels[tabNames[i]].hidden = !active;
          if (active && focus) button.focus();
        });
        applyTransportVisibility(name);
        if (settings.ui.activeTab !== name) {
          settings.ui.activeTab = name;
          if (persist) persistSettings();
        }
      }

      tabButtons.forEach((button, i) => {
        button.addEventListener('click', () => activateTab(tabNames[i]));
        button.addEventListener('keydown', (event) => {
          let target = null;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            target = (i + 1) % tabNames.length;
          } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            target = (i - 1 + tabNames.length) % tabNames.length;
          } else if (event.key === 'Home') {
            target = 0;
          } else if (event.key === 'End') {
            target = tabNames.length - 1;
          }
          if (target !== null) {
            event.preventDefault();
            activateTab(tabNames[target], { focus: true });
          }
        });
      });

      // ---- tracks section ------------------------------------------------

      // A default-off track (v8: melody/bass ship silent) needs its state
      // obvious at a glance, not just implied by which segmented pill is
      // lit — data-track-state drives a textual "— Off" cue in CSS so the
      // listener isn't left wondering why a track is silent. v12: the same
      // data-track-state attribute also drives the track-row lamp's dot
      // colour (off/auto/on), so the row's aria-label is refreshed here too.
      const TRACK_STATE_TEXT = { off: 'Off', auto: 'Auto', on: 'On' };

      function syncTrackOffIndicator(id) {
        const row = document.querySelector(`.track-row[data-track="${id}"]`);
        const state = settings.tracks[id].state;
        if (row) row.dataset.trackState = state;
        const lamp = document.getElementById(`track-lamp-${id}`);
        if (lamp) {
          lamp.setAttribute(
            'aria-label',
            `${TRACK_LABELS[id]} state: ${TRACK_STATE_TEXT[state] || state}. Press to cycle Off, Auto, On.`
          );
        }
      }

      // v14: the Off/Auto/On segmented control moved OUT of the row (which is
      // now a single line: lamp+name, voice, Level, Randomness, Edit) and
      // into the Edit panel header, so it exists only while that editor is
      // open. Instances register here; the row lamp is the always-present
      // state control.
      const stateControls = new Map(); // track -> { set(state) }

      function syncTrackStateUI() {
        for (const id of TRACK_IDS) {
          stateControls.get(id)?.set(settings.tracks[id].state);
          syncTrackOffIndicator(id);
        }
        updateComplexityDisplay();
      }

      function buildStateControl(container, track) {
        const group = document.createElement('div');
        group.className = 'segmented track-state';
        group.setAttribute('role', 'radiogroup');
        group.setAttribute('aria-label', `${TRACK_LABELS[track]} state`);
        const radios = [];
        for (const state of TRACK_STATE_CYCLE) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `track-state-${track}`;
          input.id = `track-${track}-${state}`;
          input.value = state;
          input.checked = settings.tracks[track].state === state;
          const label = document.createElement('label');
          label.htmlFor = input.id;
          label.textContent = TRACK_STATE_TEXT[state];
          input.addEventListener('change', () => {
            if (!input.checked) return;
            setTrackState(track, state);
          });
          group.append(input, label);
          radios.push(input);
        }
        container.append(group);
        const handle = {
          set: (state) => {
            for (const input of radios) input.checked = input.value === state;
          },
        };
        stateControls.set(track, handle);
        return handle;
      }

      // v12: single commit path for a track's state — the segmented radios
      // AND the track-row lamp button both funnel through this, so they can
      // never desync from one another.
      const TRACK_STATE_CYCLE = ['off', 'auto', 'on'];

      function setTrackState(id, state) {
        settings.tracks[id].state = state;
        engine.setParams({ tracks: { [id]: { state } } });
        updateComplexityDisplay();
        syncTrackOffIndicator(id);
        stateControls.get(id)?.set(state);
        persistSettings();
      }

      // Short "what does this one sound like" hints on the voice selects —
      // the kit hints the v13 round asked for, extended to every track.
      // Hoisted above the first describe() caller — `let` after the call
      // site is a temporal-dead-zone crash (shipped blank-page bug, 6105e0d).
      let tipSeq = 0;

      const VOICE_HINTS = {
        pad: 'The sustained chord bed. Warm is the default; Glass is brighter, Choir the most vocal.',
        arp: 'The broken-chord line. Soft pluck sits back, Crystal cuts through, Marimba is woody.',
        melody: 'The tune. Pluck and Keys are struck; Flute and Bell ring on.',
        bass: 'The bottom. Sub is pure weight, Round has body, Breath adds air.',
        texture: 'The atmosphere between the notes. Wash is the widest, Grains the grittiest.',
        percussion: 'The kit. Soft kit is brushed and quiet, Hand drum is warm and tuned, Ticks is a dry pulse.',
      };

      for (const id of TRACK_IDS) {
        const voiceSelect = document.getElementById(`track-voice-${id}`);
        const lamp = document.getElementById(`track-lamp-${id}`);
        describe(voiceSelect, VOICE_HINTS[id]);
        if (lamp) describe(lamp, 'Off never plays · Auto lets the generator decide · On always plays.');

        if (lamp) {
          lamp.addEventListener('click', () => {
            const cur = settings.tracks[id].state;
            const next = TRACK_STATE_CYCLE[(TRACK_STATE_CYCLE.indexOf(cur) + 1) % TRACK_STATE_CYCLE.length];
            setTrackState(id, next);
          });
        }

        voiceSelect.addEventListener('change', () => {
          settings.tracks[id].voice = voiceSelect.value;
          engine.setParams({ tracks: { [id]: { voice: voiceSelect.value } } });
          persistSettings();
          const editor = document.getElementById(`voice-editor-${id}`);
          if (!editor.hidden) renderVoiceEditor(id);
        });
      }

      // ---- voice editors (v3 patch model, v5 module look) ---------------

      let voicesModulePromise = null;
      function getVoicesTable() {
        if (!voicesModulePromise) {
          voicesModulePromise = import('../scripts/engine-voices.js')
            .then((m) => m.VOICES || null)
            .catch(() => null);
        }
        return voicesModulePromise;
      }

      function sendPatch(track, voiceId, patch) {
        engine.setParams({ patches: { [track]: { [voiceId]: structuredClone(patch) } } });
      }

      // Optional v5 modules. Either can be absent or broken — the editor
      // then degrades: no knob.js → the slider/select controls below; no
      // scope.js → no scope head, knobs still work.
      let knobApi = null;
      let scopeApi = null;
      try {
      const m = await import('../scripts/knob.js');
        if (m && typeof m.createKnob === 'function') knobApi = m;
      } catch {}
      try {
      const m = await import('../scripts/scope.js');
        if (m && typeof m.renderPatchWave === 'function') scopeApi = m;
      } catch {}

      // Representative pitch for the static scope trace, per track register.
      const SCOPE_FREQ = { pad: 220, bass: 55, melody: 330, texture: 440, arp: 330, percussion: 220 };

      // ---- v6: per-track Random / Hold / Randomness + vary targets ------

      const pctFormat = (v) => `${Math.round(v * 100)}%`;

      // ---- v13 tooltips + ⓘ info boxes -----------------------------------
      // Native `title` is unreachable by touch and unreliable by keyboard, so
      // compact labels get a themed tooltip shown on hover AND focus, plus a
      // visually-hidden description node the control points at with
      // aria-describedby (so the text reaches AT even when nothing is drawn).
      const tooltipEl = document.createElement('div');
      tooltipEl.className = 'ui-tooltip';
      tooltipEl.setAttribute('role', 'tooltip');
      tooltipEl.hidden = true;
      document.body.append(tooltipEl);

      function hideTooltip() {
        tooltipEl.hidden = true;
      }

      function showTooltip(el, text) {
        tooltipEl.textContent = text;
        tooltipEl.hidden = false;
        const r = el.getBoundingClientRect();
        const w = tooltipEl.offsetWidth;
        const left = clamp(r.left + r.width / 2 - w / 2, 8, Math.max(8, window.innerWidth - w - 8));
        tooltipEl.style.left = `${left + window.scrollX}px`;
        tooltipEl.style.top = `${r.bottom + window.scrollY + 6}px`;
      }

      /** Attach a hover/focus tooltip + an AT description. Returns `el`. */
      function describe(el, text) {
        if (!el || !text) return el;
        let descId = el.getAttribute('aria-describedby');
        if (!descId && el.parentNode) {
          const desc = document.createElement('span');
          desc.className = 'visually-hidden';
          desc.id = `ui-desc-${++tipSeq}`;
          desc.textContent = text;
          el.parentNode.insertBefore(desc, el.nextSibling);
          descId = desc.id;
          el.setAttribute('aria-describedby', descId);
        }
        el.addEventListener('pointerenter', () => showTooltip(el, text));
        el.addEventListener('pointerleave', hideTooltip);
        el.addEventListener('focus', () => showTooltip(el, text));
        el.addEventListener('blur', hideTooltip);
        return el;
      }

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hideTooltip();
      });

      // ---- v13 click-to-type on page-level numeric readouts ---------------
      // knob.js already does this for every dial readout. This is the same
      // gesture for the numbers the page owns outside a knob: the readout is
      // a button, clicking (or Enter/Space) swaps it for a text input, and
      // Enter/blur commits through the SAME clamp path as the control it
      // mirrors. Escape cancels. Zero cost while idle.
      function makeTypable(host, { read, commit, format, label }) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'typable';
        button.setAttribute('aria-label', label);
        const refresh = () => {
          button.textContent = format(read());
        };
        refresh();
        button.addEventListener('click', () => {
          const input = document.createElement('input');
          input.type = 'text';
          input.className = 'typable-input';
          input.setAttribute('aria-label', label);
          input.value = String(read());
          host.replaceChild(input, button);
          input.focus();
          input.select();
          const done = (save) => {
            if (input.parentNode !== host) return;
            host.replaceChild(button, input);
            const parsed = parseFloat(input.value);
            if (save && Number.isFinite(parsed)) commit(parsed);
            refresh();
            button.focus();
          };
          input.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
              event.preventDefault();
              done(true);
            } else if (event.key === 'Escape') {
              event.preventDefault();
              done(false);
            }
          });
          input.addEventListener('blur', () => done(true));
        });
        host.innerHTML = '';
        host.append(button);
        return { refresh };
      }

      /** A small ⓘ button that toggles a dismissable info box under it. */
      function infoButton(container, title, body) {
        const wrap = document.createElement('span');
        wrap.className = 'info-anchor';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'round-button info-button';
        btn.textContent = 'i';
        btn.setAttribute('aria-label', `About ${title}`);
        btn.setAttribute('aria-expanded', 'false');
        const box = document.createElement('div');
        box.className = 'info-box module-panel';
        box.hidden = true;
        box.textContent = body;
        btn.addEventListener('click', () => {
          const open = box.hidden;
          box.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        });
        box.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          box.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        });
        wrap.append(btn, box);
        container.append(wrap);
        return wrap;
      }

      // ---- v14 randomness = the hold control ------------------------------
      // The Random button and the Hold toggle are gone: this one dial does
      // both jobs. 0 means "hold" — the engine keeps looping the material it
      // is playing now — and re-rolls scale in as the dial rises.
      const HOLD_EPSILON = 0.0001;
      const RANDOMNESS_HINT = '0 = hold: loops the current bars exactly. Higher re-rolls more often.';

      function isHoldValue(v) {
        return rangeMid(sanitiseRangeValueIn(v, 0, 1, 0.5)) <= HOLD_EPSILON;
      }

      const randomnessFormat = (v) => (v <= HOLD_EPSILON ? 'Hold' : pctFormat(v));

      // ---- v12: Simple tab music-box dials --------------------------------
      // knob.js when available, native <input type=range> fallback when not
      // (per-dial: whichever built cleanly). Both paths funnel into the same
      // commit callback, so there's exactly one source of truth per dial —
      // no shadow/dual-wiring, no reentrancy to reason about.
      // v14 single labelling: knob.js draws the dial's own name under the
      // face, so the markup's <label> row (which exists for the no-knob
      // slider fallback) is hidden the moment a knob builds — the name then
      // appears exactly once. The end-marks (`.dial-ends`, "Slow"/"Fast" at
      // the tick extremes) live in the markup and are never removed, so a
      // failed knob build must not wipe the slot wholesale.
      function buildSimpleDial(dialId, opts, commit) {
        const box = document.getElementById(dialId);
        if (!box) return { set() {} };
        const control = box.closest('.control');
        const labelRow = control ? control.querySelector('.control-label-row') : null;
        if (knobApi) {
          try {
            const handle = knobApi.createKnob(box, { ...opts, onInput: commit });
            if (labelRow) labelRow.hidden = true;
            if (control) control.classList.add('dial-knob');
            return {
              el: handle.el,
              set: (v) => {
                try {
                  handle.set?.(v);
                } catch {}
              },
            };
          } catch {
            for (const stale of box.querySelectorAll('.knob')) stale.remove();
          }
        }
        if (control) control.classList.add('dial-fallback');
        const input = document.createElement('input');
        input.type = 'range';
        if (opts.id) input.id = opts.id;
        input.min = String(opts.min);
        input.max = String(opts.max);
        if (opts.step) input.step = String(opts.step);
        const initial = typeof opts.value === 'object' ? (opts.value.min + opts.value.max) / 2 : opts.value;
        input.value = String(initial);
        box.append(input);
        input.addEventListener('input', () => commit(parseFloat(input.value)));
        return {
          el: input,
          set: (v) => {
            input.value = String(typeof v === 'object' ? (v.min + v.max) / 2 : v);
          },
        };
      }

      speedDial = buildSimpleDial(
        'speed-dial',
        {
          id: 'speed',
          label: 'Speed',
          min: 0,
          max: 1,
          step: 0.001,
          value: speedTFromBpm(settings.bpm),
          format: (t) => `${Math.round(bpmFromSpeedT(t))} bpm`,
          defaultValue: speedTFromBpm(DEFAULTS.bpm),
        },
        (t) => setTempo(bpmFromSpeedT(t), { skipSpeedThumb: true })
      );

      complexityDial = buildSimpleDial(
        'complexity-dial',
        {
          id: 'complexity',
          label: 'Complexity',
          min: 0,
          max: 1,
          step: 0.01,
          value: settings.complexity,
          format: pctFormat,
          defaultValue: DEFAULTS.complexity,
        },
        (value) => {
          // Moving Complexity is an explicit "let the engine decide" gesture:
          // structure, arp mode and every track state return to Auto, then
          // the new complexity is sent.
          settings.complexity = value;
          settings.structure = 'auto';
          settings.arp.mode = 'auto';
          for (const id of TRACK_IDS) settings.tracks[id].state = 'auto';
          syncStructureUI();
          syncArpUI();
          syncTrackStateUI();
          const trackStates = {};
          for (const id of TRACK_IDS) trackStates[id] = { state: 'auto' };
          engine.setParams({
            complexity: value,
            structure: 'auto',
            arp: { mode: 'auto' },
            tracks: trackStates,
          });
          persistSettings();
        }
      );

      // Advanced keeps Repetition as its own dial (the Simple tab's fused
      // Randomness dial writes it, but hand-setting it here is what makes
      // that dial fall back to its blended read-out).
      repetitionDial = buildSimpleDial(
        'repetition-dial',
        {
          id: 'repetition',
          label: 'Repetition',
          min: 0,
          max: 1,
          step: 0.01,
          value: settings.repetition,
          format: pctFormat,
          defaultValue: DEFAULTS.repetition,
        },
        (value) => {
          settings.repetition = value;
          engine.setParams({ repetition: value });
          randomnessDial?.set(fusedRandomnessValue());
          persistSettings();
        }
      );

      // ONE dial for "how much does this thing change" (user decision, v15):
      // Repetitive ← Evolving → Random. It drives BOTH halves of that
      // question in a single setParams: repetition = 1 - x (tight hook at 0,
      // loose at 1) and every track's randomness = x (perfect-loop hold at 0,
      // maximal wander at 1). Advanced still exposes the two separately; when
      // they're hand-set to a pair no single x could produce, this dial just
      // shows the blended estimate (fusedRandomnessValue) without touching
      // them — the same interlink manners as Complexity.
      //
      // Range capability is asymmetric on purpose: tracks[t].randomness is a
      // genuine RangeValue, but repetition is a top-level engine param and
      // ambient-engine.js's NUMERIC_RANGES only accept plain numbers there.
      // So a range from this dial is written verbatim to every track's
      // randomness, and repetition takes 1 - (midpoint of that range).
      randomnessDial = buildSimpleDial(
        'randomness-dial',
        {
          id: 'randomness',
          label: 'Randomness',
          min: 0,
          max: 1,
          step: 0.01,
          marks: [0, 0.5, 1],
          value: fusedRandomnessValue(),
          format: randomnessFormat,
          allowRange: true,
          defaultValue: DEFAULTS.tracks.pad.randomness,
        },
        (value) => {
          const repetition = clamp(1 - rangeMid(sanitiseRangeValueIn(value, 0, 1, 0.5)), 0, 1);
          settings.repetition = repetition;
          const trackStates = {};
          for (const id of TRACK_IDS) {
            settings.tracks[id].randomness = value;
            settings.tracks[id].hold = isHoldValue(value);
            trackStates[id] = { randomness: value, hold: settings.tracks[id].hold };
          }
          engine.setParams({ repetition, tracks: trackStates });
          repetitionDial?.set(repetition);
          syncAllTrackExtras();
          persistSettings();
        }
      );
      describe(
        randomnessDial.el,
        `${RANDOMNESS_HINT} It sets repetition and every track's randomness together.`
      );

      volumeDial = buildSimpleDial(
        'volume-dial',
        {
          id: 'volume',
          label: 'Master volume',
          min: 0,
          max: 1,
          step: 0.01,
          value: settings.volume,
          // Hi-fi attenuator convention: dB relative to full output.
          format: (v) => (v <= 0.001 ? '-\u221e dB' : `${(20 * Math.log10(v)).toFixed(v > 0.5 ? 1 : 0)} dB`),
          marks: [0, 0.1, 0.25, 0.5, 0.8, 1],
          defaultValue: DEFAULTS.volume,
        },
        (value) => {
          settings.volume = value;
          engine.setParams({ volume: value });
          persistSettings();
        }
      );

      bpmTypable = makeTypable(bpmReadout, {
        read: () => settings.bpm,
        commit: (v) => setTempo(v),
        format: (v) => String(v),
        label: 'Beats per minute — click to type a value',
      });

      // ---- v14 Swing (global; Advanced tab) -------------------------------
      // Only rendered when the engine advertises the param — a dial that
      // visibly does nothing is worse than no dial.
      if (engineCaps.swing) {
        const swingControl = document.getElementById('dial-swing');
        if (swingControl) swingControl.hidden = false;
        swingDial = buildSimpleDial(
          'swing-dial',
          {
            id: 'swing',
            label: 'Swing',
            min: 0,
            max: 1,
            step: 0.01,
            value: settings.swing,
            format: (v) => (v <= 0.005 ? 'Straight' : pctFormat(v)),
            defaultValue: DEFAULTS.swing,
          },
          (value) => {
            settings.swing = value;
            engine.setParams({ swing: value });
            persistSettings();
          }
        );
        describe(
          swingDial.el,
          'Delays every off-beat subdivision — straight at 0, a classic long-short shuffle at the top. Sequencers, arp and percussion all follow it.'
        );
      }

      const DICE_SVG =
        '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">' +
        '<rect x="3" y="3" width="18" height="18" rx="3"/>' +
        '<circle cx="8" cy="8" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="16" cy="8" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="8" cy="16" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="16" cy="16" r="1.4" fill="currentColor" stroke="none"/>' +
        '</svg>';

      // The same Random/Hold/Randomness cluster renders in the tracks-panel
      // row AND in the track's Edit panel header; instances register here so
      // a change through one mirror syncs the other.
      const extrasInstances = new Map(); // track -> Set of instances

      function registerExtras(track, inst) {
        if (!extrasInstances.has(track)) extrasInstances.set(track, new Set());
        extrasInstances.get(track).add(inst);
      }

      function unregisterExtras(track, inst) {
        if (inst) extrasInstances.get(track)?.delete(inst);
      }

      function syncTrackExtras(track, skip) {
        const set = extrasInstances.get(track);
        if (!set) return;
        for (const inst of set) {
          if (inst !== skip && inst.setRand) {
            inst.setRand(settings.tracks[track].randomness);
          }
        }
      }

      function syncAllTrackExtras() {
        for (const id of TRACK_IDS) syncTrackExtras(id);
      }

      // v14: the Random button and Hold toggle are GONE from the row — the
      // Randomness dial alone drives both (0 = hold). engine.randomise() is
      // kept for power use behind a small dice icon, and only inside the Edit
      // panel header (`withDice`), never in the row.
      function buildTrackExtras(container, track, { knobs = null, withDice = false } = {}) {
        const inst = { setRand: null };
        if (withDice && engineCaps.randomise) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'round-button track-random';
          btn.innerHTML = DICE_SVG;
          btn.setAttribute('aria-label', `Re-roll ${TRACK_LABELS[track]}`);
          btn.addEventListener('click', () => {
            try {
              engine.randomise(track);
            } catch {}
          });
          container.append(btn);
          describe(btn, `Re-roll ${TRACK_LABELS[track]}'s material from the next bar.`);
        }
        if (engineCaps.randomness[track]) {
          // v7/v8: the capability probe (engineCaps.randomness, built from
          // isNumberOrRange) already accepts a RangeValue reply from the
          // engine, so — per the v8 ruling ("randomness stays a number
          // default until the page probe widens") — this control can now
          // ship rangeDefault: true. onValue is fed straight from the knob
          // (number|{min,max}, already clamped/quantised by knob.js).
          const onValue = (v) => {
            v = sanitiseRangeValueIn(v, 0, 1, 0.5);
            settings.tracks[track].randomness = v;
            // One dial, both params: the engine keeps `hold` as its own
            // switch, the UI drives it off the dial's zero position.
            settings.tracks[track].hold = isHoldValue(v);
            engine.setParams({
              tracks: { [track]: { randomness: v, hold: settings.tracks[track].hold } },
            });
            syncTrackExtras(track, inst);
            // Keep the Simple tab's fused Randomness dial current when a
            // single track's own knob moves independently of the others —
            // it falls back to its blended read-out (display only).
            randomnessDial?.set(fusedRandomnessValue());
            persistSettings();
          };
          if (knobApi) {
            const cell = document.createElement('div');
            cell.className = 'rand-knob';
            container.append(cell);
            try {
              const handle = knobApi.createKnob(cell, {
                label: 'Randomness',
                min: 0,
                max: 1,
                value: sanitiseRangeValueIn(settings.tracks[track].randomness, 0, 1, 0.5),
                format: randomnessFormat,
                allowRange: true,
                rangeDefault: true,
                defaultValue: DEFAULTS.tracks[track].randomness,
                onInput: onValue,
              });
              describe(handle.el, RANDOMNESS_HINT);
              if (knobs) knobs.push(handle);
              inst.setRand = (v) => {
                try {
                  handle.set?.(v);
                } catch {}
              };
            } catch {
              cell.remove();
            }
          }
          if (!inst.setRand) {
            // Slider fallback (no knob.js): single-value only, same
            // midpoint-display / collapse-on-edit policy as the voice
            // editor's slider fallback.
            const wrap = document.createElement('label');
            wrap.className = 'rand-slider';
            const name = document.createElement('span');
            name.className = 'visually-hidden';
            name.textContent = `${TRACK_LABELS[track]} randomness. ${RANDOMNESS_HINT}`;
            const input = document.createElement('input');
            input.type = 'range';
            input.min = '0';
            input.max = '1';
            input.step = '0.01';
            input.value = String(rangeMid(sanitiseRangeValueIn(settings.tracks[track].randomness, 0, 1, 0.5)));
            input.addEventListener('input', () => onValue(parseFloat(input.value)));
            wrap.append(name, input);
            container.append(wrap);
            describe(input, RANDOMNESS_HINT);
            inst.setRand = (v) => {
              input.value = String(rangeMid(sanitiseRangeValueIn(v, 0, 1, 0.5)));
            };
          }
        }
        return inst;
      }

      // Vary knobs run on a 22-position scale: raw 0 is the Auto detent
      // (null — "follows Randomness"); raw 1–21 map to explicit 0–100%.
      const varyFormat = (raw) =>
        Math.round(raw) <= 0 ? 'Auto (follows Randomness)' : pctFormat((Math.round(raw) - 1) / 20);
      const varyRawFromValue = (v) => (v === null ? 0 : 1 + Math.round(clamp(v, 0, 1) * 20));
      const varyValueFromRaw = (raw) =>
        Math.round(raw) <= 0 ? null : clamp((Math.round(raw) - 1) / 20, 0, 1);

      function buildVaryRow(container, track, knobs) {
        if (!engineCaps.vary[track]) return;
        const row = document.createElement('div');
        row.className = 'vary-row';
        const title = document.createElement('span');
        title.className = 'panel-label';
        title.textContent = 'Randomise';
        const cells = document.createElement('div');
        cells.className = 'vary-cells';
        row.append(title, cells);
        container.append(row);

        for (const [key, label] of VARY_KEYS) {
          const commitVary = (value) => {
            settings.tracks[track].vary[key] = value;
            engine.setParams({ tracks: { [track]: { vary: { [key]: value } } } });
            persistSettings();
          };
          const raw = varyRawFromValue(settings.tracks[track].vary[key]);
          let built = false;
          if (knobApi) {
            const cell = document.createElement('div');
            cell.className = 'vary-knob';
            cells.append(cell);
            try {
              const handle = knobApi.createKnob(cell, {
                label,
                min: 0,
                max: 21,
                step: 1,
                value: raw,
                marks: [0],
                format: varyFormat,
                // DEFAULTS.tracks[*].vary is all-null (the Auto detent, raw 0)
                // for every track/key — dblclick returns to "follows Randomness".
                defaultValue: 0,
                onInput: (v) => commitVary(varyValueFromRaw(v)),
              });
              describe(
                handle.el,
                `How much ${TRACK_LABELS[track]}'s ${label.toLowerCase()} varies. At the left detent it follows this track's Randomness dial; anywhere else overrides it.`
              );
              if (knobs) knobs.push(handle);
              built = true;
            } catch {
              cell.remove();
            }
          }
          if (!built) {
            const wrap = document.createElement('div');
            wrap.className = 'control vary-slider';
            const id = `vary-${track}-${key}`;
            const lrow = document.createElement('div');
            lrow.className = 'control-label-row';
            const lab = document.createElement('label');
            lab.htmlFor = id;
            lab.textContent = label;
            const readout = document.createElement('span');
            readout.className = 'value-readout';
            readout.textContent = varyFormat(raw);
            lrow.append(lab, readout);
            const input = document.createElement('input');
            input.type = 'range';
            input.id = id;
            input.min = '0';
            input.max = '21';
            input.step = '1';
            input.value = String(raw);
            input.setAttribute('aria-valuetext', varyFormat(raw));
            input.addEventListener('input', () => {
              const r = parseInt(input.value, 10) || 0;
              readout.textContent = varyFormat(r);
              input.setAttribute('aria-valuetext', varyFormat(r));
              commitVary(varyValueFromRaw(r));
            });
            wrap.append(lrow, input);
            cells.append(wrap);
          }
        }
      }

      // ---- v14: per-track Dissonance (tuned tracks only) -----------------
      // How far this instrument may stray from the chord the group is
      // playing: 0 is strict, low values allow passing/neighbour tones,
      // high ones borrow from outside the mode. RangeValue-capable, so it
      // can drift between two bounds like every other v7 dial.
      const DISSONANCE_HINT =
        'How far this instrument may stray from the group chord. 0 keeps strictly to it.';

      function buildDissonanceControl(container, track, knobs) {
        if (!engineCaps.dissonance[track]) return;
        const commitDissonance = (v) => {
          v = sanitiseRangeValueIn(v, 0, 1, 0);
          settings.tracks[track].dissonance = v;
          engine.setParams({ tracks: { [track]: { dissonance: v } } });
          persistSettings();
        };
        const value = sanitiseRangeValueIn(settings.tracks[track].dissonance, 0, 1, 0);
        const row = document.createElement('div');
        row.className = 'dissonance-row';
        container.append(row);
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell dissonance-knob';
          row.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label: 'Dissonance',
              min: 0,
              max: 1,
              value,
              format: pctFormat,
              allowRange: true,
              defaultValue: 0,
              onInput: commitDissonance,
            });
            describe(handle.el, DISSONANCE_HINT);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `dissonance-${track}`;
        const labelRow = document.createElement('div');
        labelRow.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = 'Dissonance';
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        readout.textContent = pctFormat(rangeMid(value));
        labelRow.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(rangeMid(value));
        input.addEventListener('input', () => {
          const v = parseFloat(input.value);
          readout.textContent = pctFormat(v);
          commitDissonance(v);
        });
        wrap.append(labelRow, input);
        row.append(wrap);
        describe(input, DISSONANCE_HINT);
      }

      // ---- v6: shared step sequencer ------------------------------------

      function currentStepsPerBar() {
        return STEPS_PER_BAR[settings.timeSignature] || 16;
      }

      // Pulse (beat) marks come from where the metre's pulses actually
      // start, not a naive "every 4th step" — that's only right for simple
      // meters. Compound x/8 meters group in dotted-quarter (6/8: two
      // groups of three eighths) or mixed (7/8: 2+2+3 eighths, the common
      // grouping) pulses, so their marks land at irregular step offsets.
      const SEQ_PULSE_STARTS = {
        '3/4': [0, 4, 8],
        '4/4': [0, 4, 8, 12],
        '5/4': [0, 4, 8, 12, 16],
        '6/8': [0, 6],
        '7/8': [0, 4, 8],
      };

      function currentPulseStarts() {
        return (
          SEQ_PULSE_STARTS[settings.timeSignature] ||
          // Unlisted signature: fall back to every-4th-step (the old,
          // simple-meter assumption) rather than showing nothing.
          Array.from({ length: Math.ceil(currentStepsPerBar() / 4) }, (_, i) => i * 4)
        );
      }

      // ---- v8 exception: the ARP lane is indexed by arp-step-within-bar at
      // the CURRENT rate, not the bar's metre — its length and pulse marks
      // must be re-derived from settings.arp.rate (and re-rendered when the
      // rate changes, same as a time-signature change re-renders the rest).
      const ARP_RATE_WHOLE_FRACTION = { '1/4': 1 / 4, '1/8': 1 / 8, '1/16': 1 / 16, '1/8T': 1 / 12 };

      function arpStepsPerBar() {
        const [num, den] = String(settings.timeSignature).split('/').map(Number);
        const barWhole = (num || 4) / (den || 4); // bar duration in whole notes
        const rateFraction = ARP_RATE_WHOLE_FRACTION[settings.arp.rate] || ARP_RATE_WHOLE_FRACTION['1/8'];
        // Nudge off an exact-integer float boundary before ceil (e.g.
        // 1/0.125 landing at 8.000000000000002) so it can't over-count.
        return clamp(Math.ceil(barWhole / rateFraction - 1e-6), 1, SEQ_SLOTS);
      }

      function arpPulseStarts(n) {
        // One mark per quarter-note-equivalent worth of arp steps, so the
        // grid still reads by the beat, just counted in the arp's own rate.
        const rateFraction = ARP_RATE_WHOLE_FRACTION[settings.arp.rate] || ARP_RATE_WHOLE_FRACTION['1/8'];
        const perBeat = Math.max(1, Math.round(0.25 / rateFraction));
        const marks = [];
        for (let i = 0; i < n; i += perBeat) marks.push(i);
        return marks;
      }

      function stepsPerBarFor(track) {
        return track === 'arp' ? arpStepsPerBar() : currentStepsPerBar();
      }

      function pulseStartsFor(track, n) {
        return track === 'arp' ? arpPulseStarts(n) : currentPulseStarts();
      }

      /**
       * Push a track's whole sequencer LIST. `sequencers` is authoritative
       * for a v14 engine; the singular `sequencer` (an alias of [0]) rides
       * along so a pre-v14 sanitiser still honours the first pattern. An
       * engine that understands neither simply drops both keys.
       */
      function commitSequencer(track) {
        const t = settings.tracks[track];
        t.sequencer = t.sequencers[0];
        const partial = {
          tracks: {
            [track]: {
              sequencers: structuredClone(t.sequencers),
              sequencer: structuredClone(t.sequencers[0]),
            },
          },
        };
        if (track === 'arp') {
          // Mirror the on-flags into the legacy boolean mask so pre-v6
          // engines still honour the grid (and the complexity estimate
          // keeps working). The mirror is fixed at 16 slots, but only the
          // first arpStepsPerBar() of those actually sound this bar — pad
          // the rest with false so a pre-v6 engine can't play a step that
          // isn't really in the pattern (and the complexity estimate below
          // isn't skewed by stale "on" flags left over from a faster rate).
          const steps = t.sequencers[0].steps;
          const n = Math.min(16, arpStepsPerBar());
          settings.arp.steps = Array.from({ length: 16 }, (unused, i) => (i < n ? !!steps[i].on : false));
          partial.arp = { steps: settings.arp.steps.slice() };
          updateComplexityDisplay();
        }
        engine.setParams(partial);
        persistSettings();
      }

      /** Next free probability-group id in a lane (v14 conditional trigs). */
      function nextGroupId(lane, slots) {
        let top = -1;
        for (let i = 0; i < slots; i++) {
          const g = lane[i] && lane[i].group;
          if (Number.isFinite(g) && g > top) top = g;
        }
        return top + 1;
      }

      const SEQ_LEGEND =
        'Keys: arrows move · Enter/Space toggles a step · Shift+↑/↓ velocity top · ' +
        'Alt+↑/↓ velocity bottom · [ and ] (or , and .) probability, Shift+[ / Shift+] ' +
        '(or Shift+, / Shift+.) narrows/widens a drifting probability range · T ties a ' +
        'step to the next one · G joins or leaves the probability group above the step. ' +
        'Pointer: drag a cell vertically for the velocity band, grab the fat handle at ' +
        'the band top for its loudest edge, drag sideways across cells to tie them into ' +
        'one long note, and drag the thin bar under a step for its probability. The dots ' +
        'above the grid colour-code probability groups: inside a group a step only gets ' +
        'its chance if the previous step in that group actually sounded.';

      /**
       * Shared metre-aware step grid: one lane for melody/bass/arp, three
       * (High/Mid/Low, high at the top) for percussion. Per step: on/off,
       * velocity band (vertical drag, fat top handle), probability (mini-bar
       * under the cell), tie (sideways drag) and probability group (dot row).
       * A track may own SEVERAL sequencers (v14 Markov chain): the tab strip
       * picks which one this grid edits, "+" copies the current one, and each
       * carries a weight — how likely the others are to hand over to it at
       * loop end. Cells form a roving-tabindex ARIA grid; every value is
       * keyboard-adjustable and announced via aria-label.
       */
      function buildSequencer(container, track) {
        const label = TRACK_LABELS[track];
        const lanes =
          track === 'percussion'
            ? PERC_LANES.map(([key, laneLabel]) => ({ key, label: laneLabel }))
            : [{ key: null, label: null }];
        const list = () => settings.tracks[track].sequencers;
        let active = 0;
        const current = () => list()[Math.min(active, list().length - 1)];
        const laneSteps = (lane) => (lane.key ? current().steps[lane.key] : current().steps);

        const root = document.createElement('div');
        root.className = 'seq';
        container.append(root);

        const head = document.createElement('div');
        head.className = 'seq-head';
        const titleBox = document.createElement('span');
        titleBox.className = 'seq-title';
        const title = document.createElement('span');
        title.className = 'panel-label';
        title.textContent = 'Step sequencer';
        titleBox.append(title);
        infoButton(titleBox, 'the step sequencer', SEQ_LEGEND);
        const modeGroup = document.createElement('div');
        modeGroup.className = 'segmented';
        modeGroup.setAttribute('role', 'radiogroup');
        modeGroup.setAttribute('aria-label', `${label} sequencer mode`);
        const modeRadios = [];
        for (const m of ['auto', 'manual']) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `seq-mode-${track}`;
          input.id = `seq-mode-${track}-${m}`;
          input.value = m;
          input.checked = current().mode === m;
          const lab = document.createElement('label');
          lab.htmlFor = input.id;
          lab.textContent = m === 'auto' ? 'Auto' : 'Manual';
          input.addEventListener('change', () => {
            if (!input.checked) return;
            current().mode = m;
            commitSequencer(track);
          });
          modeGroup.append(input, lab);
          modeRadios.push(input);
        }
        head.append(titleBox, modeGroup);

        // -- v14 multi-sequencer tab strip + per-sequencer weight -----------
        const tabsRow = document.createElement('div');
        tabsRow.className = 'seq-tabs';
        const tabs = document.createElement('div');
        tabs.className = 'segmented seq-tab-strip';
        tabs.setAttribute('role', 'tablist');
        tabs.setAttribute('aria-label', `${label} sequencers`);
        const addButton = document.createElement('button');
        addButton.type = 'button';
        addButton.className = 'secondary-button seq-add';
        addButton.textContent = '+';
        addButton.setAttribute('aria-label', 'Add a sequencer (copies the current one)');
        const weightWrap = document.createElement('label');
        weightWrap.className = 'seq-weight';
        const weightLabel = document.createElement('span');
        weightLabel.textContent = 'Weight';
        const weightInput = document.createElement('input');
        weightInput.type = 'number';
        weightInput.min = '0';
        weightInput.max = '100';
        weightInput.step = '0.5';
        weightInput.inputMode = 'decimal';
        weightWrap.append(weightLabel, weightInput);
        tabsRow.append(tabs, addButton, weightWrap);
        describe(
          weightInput,
          'How likely the other sequencers are to hand over to this one when a loop ends.'
        );
        describe(addButton, 'Add a sequencer — a copy of the one showing now.');

        const scroll = document.createElement('div');
        scroll.className = 'seq-scroll';
        const beatsEl = document.createElement('div');
        beatsEl.className = 'seq-beats';
        beatsEl.setAttribute('aria-hidden', 'true');
        const gridEl = document.createElement('div');
        gridEl.className = 'seq-rows';
        gridEl.setAttribute('role', 'grid');
        gridEl.setAttribute('aria-label', `${label} step sequencer`);
        scroll.append(beatsEl, gridEl);

        root.append(head, tabsRow, scroll);

        let cellRefs = []; // [lane][step] -> { cell, band, bandTop, probFill, dot }
        let focusPos = { lane: 0, step: 0 };
        let playhead = -1;

        function stepText(lane, i, s) {
          const lanePart = lane.label ? `${lane.label} lane, ` : '';
          const probPart = isPlainObject(s.prob)
            ? `probability ${Math.round(s.prob.min * 100)} to ${Math.round(s.prob.max * 100)}%, drifting`
            : `probability ${Math.round(s.prob * 100)}%`;
          const tiePart = s.tie === true ? ', tied to the next step' : '';
          const groupPart = Number.isFinite(s.group) ? `, group ${s.group + 1}` : '';
          return (
            `${lanePart}step ${i + 1}: ${s.on ? 'on' : 'off'}, ` +
            `velocity ${Math.round(s.vmin * 100)} to ${Math.round(s.vmax * 100)}%, ` +
            probPart +
            tiePart +
            groupPart
          );
        }

        function updateCell(li, i) {
          const lane = lanes[li];
          const s = laneSteps(lane)[i];
          const ref = cellRefs[li][i];
          ref.cell.classList.toggle('seq-cell-on', s.on);
          ref.cell.classList.toggle('seq-cell-tie', s.tie === true);
          // role=gridcell + a label stating on/off/velocity/probability is
          // the valid pattern here: aria-selected implies row/grid
          // *selection* (not toggle state) and aria-pressed is only valid
          // on button-role elements, so neither belongs on a gridcell —
          // the label alone carries the state. aria-valuetext is likewise
          // dropped: it's a range-widget attribute, inert on a gridcell.
          const text = stepText(lane, i, s);
          ref.cell.setAttribute('aria-label', text);
          ref.band.style.bottom = `${s.vmin * 100}%`;
          ref.band.style.height = `${Math.max(0, s.vmax - s.vmin) * 100}%`;
          // The fat grab handle rides the band's loud edge; ≥10 px tall (CSS)
          // so the velocity top is reachable without pixel-hunting.
          ref.bandTop.style.bottom = `${s.vmax * 100}%`;
          // A plain prob fills from 0 to the value (matches the on/off
          // cell's velocity band read); a ranged prob instead shows the
          // drifting window itself (left edge at min, width = max-min).
          if (isPlainObject(s.prob)) {
            ref.probFill.style.left = `${s.prob.min * 100}%`;
            ref.probFill.style.width = `${Math.max(0, s.prob.max - s.prob.min) * 100}%`;
            ref.probFill.classList.add('seq-prob-fill-range');
          } else {
            ref.probFill.style.left = '0';
            ref.probFill.style.width = `${s.prob * 100}%`;
            ref.probFill.classList.remove('seq-prob-fill-range');
          }
          const grouped = Number.isFinite(s.group);
          ref.dot.classList.toggle('seq-dot-on', grouped);
          ref.dot.style.background = grouped
            ? GROUP_COLOURS[s.group % GROUP_COLOURS.length]
            : '';
          ref.dot.setAttribute(
            'aria-label',
            grouped
              ? `Step ${i + 1} is in probability group ${s.group + 1}. Press to leave it.`
              : `Step ${i + 1} is ungrouped. Press to join the group above it, or start one.`
          );
        }

        function setFocus(li, i, focus = true) {
          const n = stepsPerBarFor(track);
          li = clamp(li, 0, lanes.length - 1);
          i = clamp(i, 0, n - 1);
          const prev = (cellRefs[focusPos.lane] || [])[focusPos.step];
          if (prev) prev.cell.tabIndex = -1;
          focusPos = { lane: li, step: i };
          const ref = cellRefs[li][i];
          ref.cell.tabIndex = 0;
          if (focus) ref.cell.focus();
        }

        /** Join the group above, or start a new one; a grouped step leaves. */
        function toggleGroup(li, i) {
          const lane = laneSteps(lanes[li]);
          const s = lane[i];
          if (Number.isFinite(s.group)) {
            delete s.group;
          } else {
            const prev = i > 0 ? lane[i - 1] : null;
            s.group = prev && Number.isFinite(prev.group)
              ? prev.group
              : nextGroupId(lane, stepsPerBarFor(track));
          }
          updateCell(li, i);
          commitSequencer(track);
        }

        function wireCell(li, i, cell, probEl, bandTop, dot) {
          const getStep = () => laneSteps(lanes[li])[i];
          const commit = () => {
            updateCell(li, i);
            commitSequencer(track);
          };

          dot.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleGroup(li, i);
          });

          // Fat handle: drags the band's TOP (loudest) edge on its own.
          bandTop.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            e.preventDefault();
            e.stopPropagation();
            setFocus(li, i);
            const rect = cell.getBoundingClientRect();
            const vAt = (clientY) => clamp(1 - (clientY - rect.top) / rect.height, 0, 1);
            const onMove = (ev) => {
              const s = getStep();
              s.on = true;
              s.vmax = Math.max(s.vmin, vAt(ev.clientY));
              updateCell(li, i);
            };
            const onUp = () => {
              bandTop.removeEventListener('pointermove', onMove);
              bandTop.removeEventListener('pointerup', onUp);
              bandTop.removeEventListener('pointercancel', onUp);
              commitSequencer(track);
            };
            try {
              bandTop.setPointerCapture(e.pointerId);
            } catch {}
            bandTop.addEventListener('pointermove', onMove);
            bandTop.addEventListener('pointerup', onUp);
            bandTop.addEventListener('pointercancel', onUp);
          });

          cell.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            e.preventDefault();
            setFocus(li, i);
            const rect = cell.getBoundingClientRect();
            const vAt = (clientY) => clamp(1 - (clientY - rect.top) / rect.height, 0, 1);
            const v0 = vAt(e.clientY);
            const slots = stepsPerBarFor(track);
            const columnWidth = rect.width + 3; // grid gap
            let gesture = null; // 'band' | 'tie'
            let tieEnd = i;

            /** Sideways drag merges the crossed steps into one tied note. */
            const applyTie = (end) => {
              const lane = laneSteps(lanes[li]);
              const last = clamp(end, i, slots - 1);
              for (let k = i; k <= last; k++) {
                lane[k].on = true;
                if (k < last) lane[k].tie = true;
                else delete lane[k].tie;
                updateCell(li, k);
              }
              // Dragging back shortens the run: the steps beyond it lose the
              // tie they picked up on the way out.
              for (let k = last + 1; k <= tieEnd && k < slots; k++) {
                delete lane[k].tie;
                updateCell(li, k);
              }
              tieEnd = last;
            };

            const onMove = (ev) => {
              const dx = ev.clientX - e.clientX;
              const dy = ev.clientY - e.clientY;
              if (!gesture) {
                if (Math.abs(dx) < 6 && Math.abs(dy) < 4) return;
                gesture = Math.abs(dx) > Math.abs(dy) ? 'tie' : 'band';
              }
              if (gesture === 'tie') {
                applyTie(i + Math.round(dx / Math.max(1, columnWidth)));
                return;
              }
              const v1 = vAt(ev.clientY);
              const s = getStep();
              s.on = true; // shaping a band implies the step should sound
              s.vmin = Math.min(v0, v1);
              s.vmax = Math.max(v0, v1);
              updateCell(li, i);
            };
            const finish = (toggleOnTap) => () => {
              cell.removeEventListener('pointermove', onMove);
              cell.removeEventListener('pointerup', up);
              cell.removeEventListener('pointercancel', cancel);
              if (!gesture && toggleOnTap) {
                const s = getStep();
                s.on = !s.on;
                updateCell(li, i);
              }
              commitSequencer(track);
            };
            const up = finish(true);
            const cancel = finish(false);
            try {
              cell.setPointerCapture(e.pointerId);
            } catch {}
            cell.addEventListener('pointermove', onMove);
            cell.addEventListener('pointerup', up);
            cell.addEventListener('pointercancel', cancel);
          });

          const probFromEvent = (ev) => {
            const r = probEl.getBoundingClientRect();
            const p = clamp((ev.clientX - r.left) / Math.max(1, r.width), 0, 1);
            const s = getStep();
            // The mini-bar drags the midpoint only — an existing {min,max}
            // shifts with it (width preserved) rather than collapsing.
            s.prob = shiftRangeMid(s.prob, Math.round(p * 20) / 20);
            updateCell(li, i);
          };
          probEl.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            e.preventDefault();
            setFocus(li, i);
            probFromEvent(e);
            const onMove = (ev) => probFromEvent(ev);
            const onUp = () => {
              probEl.removeEventListener('pointermove', onMove);
              probEl.removeEventListener('pointerup', onUp);
              probEl.removeEventListener('pointercancel', onUp);
              commitSequencer(track);
            };
            try {
              probEl.setPointerCapture(e.pointerId);
            } catch {}
            probEl.addEventListener('pointermove', onMove);
            probEl.addEventListener('pointerup', onUp);
            probEl.addEventListener('pointercancel', onUp);
          });

          cell.addEventListener('keydown', (e) => {
            const s = getStep();
            const nudge = 0.05;
            const snap = (v) => Math.round(v * 20) / 20;
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              s.on = !s.on;
              commit();
            } else if (e.key === 't' || e.key === 'T') {
              // Keyboard equivalent of the sideways tie drag.
              e.preventDefault();
              if (s.tie === true) delete s.tie;
              else if (i < stepsPerBarFor(track) - 1) s.tie = true;
              commit();
            } else if (e.key === 'g' || e.key === 'G') {
              e.preventDefault();
              toggleGroup(li, i);
            } else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
              const d = e.key === 'ArrowUp' ? nudge : -nudge;
              if (e.shiftKey) {
                e.preventDefault();
                s.vmax = clamp(snap(s.vmax + d), s.vmin, 1);
                commit();
              } else if (e.altKey) {
                e.preventDefault();
                s.vmin = clamp(snap(s.vmin + d), 0, s.vmax);
                commit();
              } else if (lanes.length > 1) {
                e.preventDefault();
                setFocus(li + (e.key === 'ArrowDown' ? 1 : -1), i);
              } else {
                // Single-lane track: there's no other lane for plain
                // Up/Down to move focus to, so nudge the whole velocity
                // band (vmin+vmax together) instead of silently eating
                // the key (which would otherwise block page scroll for
                // nothing).
                e.preventDefault();
                const width = s.vmax - s.vmin;
                const vmin = clamp(snap(s.vmin + d), 0, 1 - width);
                s.vmin = vmin;
                s.vmax = clamp(snap(vmin + width), 0, 1);
                commit();
              }
            } else if (e.key === 'ArrowRight') {
              e.preventDefault();
              setFocus(li, i + 1);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              setFocus(li, i - 1);
            } else if (e.key === 'Home') {
              e.preventDefault();
              setFocus(li, 0);
            } else if (e.key === 'End') {
              e.preventDefault();
              setFocus(li, stepsPerBarFor(track) - 1);
            } else if (e.key === '[' || e.key === ',') {
              e.preventDefault();
              // Moves the midpoint only — an existing {min,max} shifts with
              // it (width preserved), same policy as the pointer drag.
              s.prob = shiftRangeMid(s.prob, snap(rangeMid(s.prob) - nudge));
              commit();
            } else if (e.key === ']' || e.key === '.') {
              e.preventDefault();
              s.prob = shiftRangeMid(s.prob, snap(rangeMid(s.prob) + nudge));
              commit();
            } else if (e.key === '{' || e.key === '<') {
              // Shift+[ / Shift+, — narrow the drifting prob range around
              // its midpoint (narrowing to ~0 collapses back to a number).
              e.preventDefault();
              s.prob = resizeRangeWidth(s.prob, -nudge * 2);
              commit();
            } else if (e.key === '}' || e.key === '>') {
              // Shift+] / Shift+. — widen it (splitting a plain number into
              // a range on first widen).
              e.preventDefault();
              s.prob = resizeRangeWidth(s.prob, nudge * 2);
              commit();
            }
          });
        }

        function renderTabs() {
          const seqs = list();
          tabs.innerHTML = '';
          // A single sequencer needs no chooser and no transition weight —
          // the strip only earns its space once there's something to pick
          // between. "+" stays, so a second one is always one click away.
          tabsRow.classList.toggle('seq-tabs-single', seqs.length < 2);
          seqs.forEach((unused, index) => {
            const input = document.createElement('input');
            input.type = 'radio';
            input.name = `seq-pick-${track}`;
            input.id = `seq-pick-${track}-${index}`;
            input.value = String(index);
            input.checked = index === active;
            const lab = document.createElement('label');
            lab.htmlFor = input.id;
            lab.textContent = String(index + 1);
            input.addEventListener('change', () => {
              if (!input.checked) return;
              active = index;
              render();
            });
            tabs.append(input, lab);
          });
          addButton.disabled = seqs.length >= SEQ_MAX;
          weightInput.value = String(seqs[0].weights[active] ?? 1);
          weightInput.setAttribute('aria-label', `Sequencer ${active + 1} weight`);
        }

        addButton.addEventListener('click', () => {
          const seqs = list();
          if (seqs.length >= SEQ_MAX) return;
          seqs.push(structuredClone(current()));
          normaliseSequencerList(settings.tracks[track], track);
          active = list().length - 1;
          render();
          commitSequencer(track);
        });

        weightInput.addEventListener('input', () => {
          const parsed = parseFloat(weightInput.value);
          if (!Number.isFinite(parsed)) return; // mid-edit blank keeps the stored value
          const w = clamp(parsed, 0, 100);
          // One number per sequencer: "how likely everyone is to hand over to
          // this one", written into every sequencer's transition row.
          for (const seq of list()) seq.weights[active] = w;
          commitSequencer(track);
        });

        function render() {
          const n = stepsPerBarFor(track);
          const pulseStarts = pulseStartsFor(track, n);
          const pulseSet = new Set(pulseStarts);
          root.style.setProperty('--seq-cols', String(n));
          beatsEl.innerHTML = '';
          gridEl.innerHTML = '';
          cellRefs = lanes.map(() => []);
          for (const radio of modeRadios) radio.checked = radio.value === current().mode;
          renderTabs();
          for (let i = 0; i < n; i++) {
            const b = document.createElement('span');
            const pulseIndex = pulseStarts.indexOf(i);
            if (pulseIndex !== -1) {
              b.textContent = String(pulseIndex + 1);
              b.className = 'seq-beat-mark';
            }
            beatsEl.append(b);
          }
          lanes.forEach((lane, li) => {
            // Probability-group dots sit ABOVE the lane's cells, one per
            // step, as their own grid row — row > gridcell > button, the
            // standard "gridcell owning a widget" shape, so the buttons stay
            // legitimate children of role="grid".
            const dotRow = document.createElement('div');
            dotRow.className = 'seq-lane seq-dot-row';
            dotRow.setAttribute('role', 'row');
            const row = document.createElement('div');
            row.className = 'seq-lane';
            row.setAttribute('role', 'row');
            if (lane.label) {
              const lh = document.createElement('span');
              lh.className = 'seq-lane-label';
              lh.setAttribute('role', 'rowheader');
              lh.textContent = lane.label;
              row.append(lh);
            }
            // The probability mini-bars sit on the grid line directly under
            // their cells (same columns, so each bar is tied to its step),
            // but a role="row" must only own gridcell children — so they
            // get their own row (role="row", cells aria-hidden) rather than
            // living inside the cell row above.
            const probRow = document.createElement('div');
            probRow.className = 'seq-lane seq-prob-row';
            probRow.setAttribute('role', 'row');
            for (let i = 0; i < n; i++) {
              const dotCell = document.createElement('div');
              dotCell.className = 'seq-dot-cell';
              dotCell.setAttribute('role', 'gridcell');
              const dot = document.createElement('button');
              dot.type = 'button';
              dot.className = 'seq-dot';
              dotCell.append(dot);
              dotRow.append(dotCell);
              const cell = document.createElement('div');
              cell.className = 'seq-cell';
              cell.setAttribute('role', 'gridcell');
              if (pulseSet.has(i)) cell.classList.add('seq-cell-beat');
              cell.tabIndex = -1;
              const band = document.createElement('span');
              band.className = 'seq-band';
              const bandTop = document.createElement('span');
              bandTop.className = 'seq-band-top';
              cell.append(band, bandTop);
              const prob = document.createElement('span');
              prob.className = 'seq-prob';
              prob.setAttribute('aria-hidden', 'true');
              const probFill = document.createElement('span');
              probFill.className = 'seq-prob-fill';
              prob.append(probFill);
              probRow.append(prob);
              cellRefs[li][i] = { cell, band, bandTop, probFill, dot };
              wireCell(li, i, cell, prob, bandTop, dot);
              row.append(cell);
            }
            gridEl.append(dotRow, row, probRow);
          });
          for (let li = 0; li < lanes.length; li++) {
            for (let i = 0; i < n; i++) updateCell(li, i);
          }
          focusPos = {
            lane: Math.min(focusPos.lane, lanes.length - 1),
            step: Math.min(focusPos.step, n - 1),
          };
          cellRefs[focusPos.lane][focusPos.step].cell.tabIndex = 0;
          setPlayhead(playhead);
        }

        /**
         * v14 playhead: the sounding step lights white. Driven from bar/note
         * events at step rate (see schedulePlayhead) — a class swap on two
         * DOM nodes, never a rAF loop.
         */
        function setPlayhead(index) {
          const n = stepsPerBarFor(track);
          for (let li = 0; li < cellRefs.length; li++) {
            const prev = cellRefs[li][playhead];
            if (prev) prev.cell.classList.remove('seq-cell-playing');
          }
          playhead = index >= 0 && index < n ? index : -1;
          if (playhead < 0) return;
          for (let li = 0; li < cellRefs.length; li++) {
            const ref = cellRefs[li][playhead];
            if (ref) ref.cell.classList.add('seq-cell-playing');
          }
        }

        render();
        return { refresh: render, setPlayhead };
      }

      // ---- v6: arpeggiator section (lives in the Arp track's Edit panel) --

      let arpUI = null; // control refs while the arp editor is open

      const ARP_PATTERNS = [
        ['up', 'Up'],
        ['down', 'Down'],
        ['updown', 'Up-down'],
        ['random', 'Random'],
      ];
      const ARP_RATES = [
        ['1/4', '1/4'],
        ['1/8', '1/8'],
        ['1/16', '1/16'],
        ['1/8T', '1/8 triplet'],
      ];

      function buildArpSection(container) {
        const panel = document.createElement('div');
        panel.className = 'arp-inline';
        const title = document.createElement('span');
        title.className = 'panel-label';
        title.textContent = 'Arpeggiator';
        panel.append(title);

        const modeGroup = document.createElement('div');
        modeGroup.className = 'segmented';
        modeGroup.setAttribute('role', 'radiogroup');
        modeGroup.setAttribute('aria-label', 'Arpeggiator mode');
        const modeRadios = [];
        for (const m of ['auto', 'manual']) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = 'arp-mode';
          input.id = `arp-mode-${m}`;
          input.value = m;
          const lab = document.createElement('label');
          lab.htmlFor = input.id;
          lab.textContent = m === 'auto' ? 'Auto' : 'Manual';
          input.addEventListener('change', () => {
            if (!input.checked) return;
            settings.arp.mode = m;
            manual.hidden = m !== 'manual';
            engine.setParams({ arp: { mode: m } });
            updateComplexityDisplay();
            persistSettings();
          });
          modeGroup.append(input, lab);
          modeRadios.push(input);
        }
        panel.append(modeGroup);

        const manual = document.createElement('div');
        manual.className = 'arp-manual';
        panel.append(manual);

        function arpSelect(labelText, options, value, onChange) {
          const wrap = document.createElement('div');
          wrap.className = 'control';
          const id = `arp-${labelText.toLowerCase()}`;
          const lab = document.createElement('label');
          lab.htmlFor = id;
          lab.textContent = labelText;
          const select = document.createElement('select');
          select.id = id;
          for (const [v, text] of options) {
            const opt = document.createElement('option');
            opt.value = v;
            opt.textContent = text;
            select.append(opt);
          }
          select.value = value;
          select.addEventListener('change', () => onChange(select.value));
          wrap.append(lab, select);
          manual.append(wrap);
          return select;
        }

        function arpRange(labelText, { min, max, step, value, onChange }) {
          const wrap = document.createElement('div');
          wrap.className = 'control';
          const id = `arp-${labelText.toLowerCase()}`;
          const row = document.createElement('div');
          row.className = 'control-label-row';
          const lab = document.createElement('label');
          lab.htmlFor = id;
          lab.textContent = labelText;
          const readout = document.createElement('span');
          readout.className = 'value-readout';
          readout.textContent = String(value);
          row.append(lab, readout);
          const input = document.createElement('input');
          input.type = 'range';
          input.min = String(min);
          input.max = String(max);
          input.step = String(step);
          input.value = String(value);
          input.id = id;
          input.addEventListener('input', () => {
            readout.textContent = input.value;
            onChange(input.value);
          });
          wrap.append(row, input);
          manual.append(wrap);
          return { input, readout };
        }

        const pattern = arpSelect('Pattern', ARP_PATTERNS, settings.arp.pattern, (v) => {
          settings.arp.pattern = v;
          engine.setParams({ arp: { pattern: v } });
          persistSettings();
        });
        const rate = arpSelect('Rate', ARP_RATES, settings.arp.rate, (v) => {
          settings.arp.rate = v;
          engine.setParams({ arp: { rate: v } });
          updateComplexityDisplay();
          persistSettings();
          // The arp lane's length/pulse-marks are rate-derived (v8 ruling):
          // re-render its sequencer grid, same as a time-signature change.
          try {
            openEditors.get('arp')?.seq?.refresh();
          } catch {}
        });
        const octaves = arpRange('Octaves', {
          min: 1,
          max: 3,
          step: 1,
          value: settings.arp.octaves,
          onChange: (v) => {
            settings.arp.octaves = parseInt(v, 10);
            engine.setParams({ arp: { octaves: settings.arp.octaves } });
            persistSettings();
          },
        });
        const gate = arpRange('Gate', {
          min: 0.1,
          max: 1,
          step: 0.01,
          value: settings.arp.gate,
          onChange: (v) => {
            settings.arp.gate = parseFloat(v);
            engine.setParams({ arp: { gate: settings.arp.gate } });
            persistSettings();
          },
        });

        container.append(panel);
        arpUI = {
          modeRadios,
          manual,
          pattern,
          rate,
          octaves: octaves.input,
          octavesOut: octaves.readout,
          gate: gate.input,
          gateOut: gate.readout,
        };
        syncArpUI();
      }

      // Per-open-editor scope + knob handles, so re-renders, close and
      // engine state changes can tear down rAF loops and swap OFFLINE/LIVE.
      const openEditors = new Map(); // track -> { scope|null, knobs: [] }

      function teardownEditor(track) {
        const ed = openEditors.get(track);
        if (!ed) return;
        unregisterExtras(track, ed.extras);
        stateControls.delete(track);
        if (track === 'arp') arpUI = null;
        if (ed.scope) {
          if (ed.scope.debounce !== null) clearTimeout(ed.scope.debounce);
          if (ed.scope.live) {
            try {
              ed.scope.live.destroy();
            } catch {}
          }
          ed.scope.analyser = null;
        }
        for (const k of ed.knobs) {
          try {
            k.destroy?.();
          } catch {}
        }
        openEditors.delete(track);
      }

      function scheduleScopeRender(track, immediate = false) {
        const ed = openEditors.get(track);
        if (!ed || !ed.scope || ed.scope.live) return;
        const s = ed.scope;
        if (s.debounce !== null) clearTimeout(s.debounce);
        s.debounce = setTimeout(
          () => {
            s.debounce = null;
            try {
              scopeApi.renderPatchWave(s.canvas, s.getPatch(), {
                freq: SCOPE_FREQ[track] || 220,
              });
            } catch {}
          },
          immediate ? 0 : 80
        );
      }

      function updateScopeMode(track) {
        const ed = openEditors.get(track);
        if (!ed || !ed.scope) return;
        const s = ed.scope;
        let analyser = null;
        // A power tier that withholds the live scope (eco) falls back to the
        // cheap static trace — no rAF loop attaches at all.
        const scopeAllowed = powerBudget ? powerBudget.scopeEnabled !== false : true;
        if (scopeAllowed && engine.running && typeof engine.getAnalysers === 'function') {
          try {
            analyser = (engine.getAnalysers() || {})[track] || null;
          } catch {
            analyser = null;
          }
        }
        if (analyser && typeof scopeApi.attachLiveScope === 'function') {
          // rebuildContext() (interruption/sample-rate recovery, iOS wake)
          // swaps the engine's whole graph — including analyser nodes —
          // while `running` stays true, so a same-track re-evaluation must
          // compare node IDENTITY rather than just "are we already live":
          // an early `if (s.live) return` here would keep tracing a dead
          // analyser off a closed context forever.
          if (s.live && s.analyser === analyser) return;
          if (s.live) {
            try {
              s.live.destroy();
            } catch {}
            s.live = null;
            s.analyser = null;
          }
          if (s.debounce !== null) {
            clearTimeout(s.debounce);
            s.debounce = null;
          }
          try {
            s.live = scopeApi.attachLiveScope(s.canvas, analyser);
            s.analyser = s.live ? analyser : null;
          } catch {
            s.live = null;
            s.analyser = null;
          }
          if (s.live) {
            s.indicator.textContent = 'LIVE';
            s.indicator.classList.add('scope-mode-live');
            return;
          }
        }
        if (s.live) {
          try {
            s.live.destroy();
          } catch {}
          s.live = null;
          s.analyser = null;
        }
        s.indicator.textContent = 'OFFLINE';
        s.indicator.classList.remove('scope-mode-live');
        scheduleScopeRender(track, true);
      }

      function updateAllScopeModes() {
        for (const track of openEditors.keys()) updateScopeMode(track);
      }

      let veControlId = 0;

      function veSection(parent, heading) {
        const section = document.createElement('div');
        section.className = 've-section';
        const h = document.createElement('span');
        h.className = 've-heading';
        h.textContent = heading;
        section.append(h);
        parent.append(section);
        return section;
      }

      function veRange(parent, labelText, { min, max, step, value, log = false, format, onChange }) {
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `ve-control-${++veControlId}`;
        const row = document.createElement('div');
        row.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = labelText;
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        row.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        if (log) {
          input.min = '0';
          input.max = '1';
          input.step = '0.001';
          input.value = String(valueToLog(clamp(value, min, max), min, max));
        } else {
          input.min = String(min);
          input.max = String(max);
          input.step = String(step);
          input.value = String(clamp(value, min, max));
        }
        const fmt = format || ((v) => String(Math.round(v * 100) / 100));
        const current = () =>
          log ? logToValue(parseFloat(input.value), min, max) : parseFloat(input.value);
        readout.textContent = fmt(clamp(value, min, max));
        input.addEventListener('input', () => {
          const v = clamp(current(), min, max);
          readout.textContent = fmt(v);
          onChange(v);
        });
        wrap.append(row, input);
        parent.append(wrap);
      }

      function veSelect(parent, labelText, { options, value, onChange }) {
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `ve-control-${++veControlId}`;
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = labelText;
        const select = document.createElement('select');
        select.id = id;
        for (const [v, text] of options) {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = text;
          if (v === String(value)) opt.selected = true;
          select.append(opt);
        }
        select.addEventListener('change', () => onChange(select.value));
        wrap.append(label, select);
        parent.append(wrap);
      }

      const OSC_TYPES = [
        ['sine', 'Sine'],
        ['triangle', 'Triangle'],
        ['sawtooth', 'Sawtooth'],
        ['square', 'Square'],
      ];
      const FILTER_TYPES = [
        ['lowpass', 'Low-pass'],
        ['highpass', 'High-pass'],
        ['bandpass', 'Band-pass'],
        ['notch', 'Notch'],
      ];

      const hzFormat = (v) => `${Math.round(v)} Hz`;
      const secFormat = (v) => (v < 0.1 ? `${Math.round(v * 1000)} ms` : `${Math.round(v * 100) / 100} s`);
      const plainFormat = (v) => String(Math.round(v * 100) / 100);

      const FILTER_ORDER = ['lowpass', 'highpass', 'bandpass', 'notch'];
      const FILTER_DIAL_LABELS = ['LP', 'HP', 'BP', 'Notch'];
      // knob.js marks are numeric tick positions; the shape/type names show
      // in the knob's value readout via `format`.
      const SHAPE_MARKS = [0, 1, 2, 3];
      const shapeFormat = (v) => {
        const r = Math.round(clamp(v, 0, 3));
        if (Math.abs(v - r) < 0.05) return SHAPE_LABELS[r];
        return `${SHAPE_LABELS[Math.floor(v)]}~${SHAPE_LABELS[Math.ceil(v)]}`;
      };

      // ---- v8: applicable-controls (voice metadata may hide sections) ----
      // `controls` (VOICES[track][voiceId].controls, may be absent) is
      // { source?, filter?, adsr?, sends? }, each true | false | string[] of
      // field names. Absent whole descriptor, or an absent section key,
      // means "applies" (render everything) — only an explicit false or a
      // field array narrows what's shown. Field names match the Patch
      // schema: source: shape1/shape2/mix/detune/octave; filter:
      // type/cutoff/q/envAmount; adsr: attack/decay/sustain/release;
      // sends: reverb/delay.
      function controlsSectionSpec(controls, section) {
        if (!isPlainObject(controls)) return true;
        const v = controls[section];
        return v === undefined ? true : v;
      }
      function controlsSectionVisible(spec) {
        if (spec === false) return false;
        if (Array.isArray(spec)) return spec.length > 0;
        return true;
      }
      function controlsFieldAllowed(spec, field) {
        if (spec === false) return false;
        if (Array.isArray(spec)) return spec.includes(field);
        return true;
      }

      // Fallback editor: the pre-v5 slider/select controls — the path when
      // knob.js is missing or its API throws. Writes the same
      // shape-normalised patch the knob editor writes.
      //
      // v7 RangeValue: a plain <input type=range> has one thumb, so this
      // editor stays a single-value editor for the fields the knob editor
      // now ranges (mix, detune, filter cutoff/q/envAmount, ADSR ×4, both
      // sends) — it reads a RangeValue's midpoint for display and always
      // writes back a plain number, collapsing any existing {min,max}.
      function buildSliderEditor(container, patch, commit, controls) {
        const sourceSpec = controlsSectionSpec(controls, 'source');
        const filterSpec = controlsSectionSpec(controls, 'filter');
        const adsrSpec = controlsSectionSpec(controls, 'adsr');
        const sendsSpec = controlsSectionSpec(controls, 'sends');

        const source = controlsSectionVisible(sourceSpec) ? veSection(container, 'Source') : null;
        if (source && controlsFieldAllowed(sourceSpec, 'shape1')) {
          veSelect(source, 'Osc 1', {
            options: OSC_TYPES,
            value: SHAPE_NAMES[Math.round(readShape(patch.source, 1) ?? 0)],
            onChange: (v) => {
              writeShape(patch.source, 1, SHAPE_FROM_STRING[v]);
              commit();
            },
          });
        }
        if (source && controlsFieldAllowed(sourceSpec, 'shape2')) {
          const initialShape2 = readShape(patch.source, 2);
          veSelect(source, 'Osc 2', {
            options: [['none', 'None'], ...OSC_TYPES],
            value: initialShape2 === null ? 'none' : SHAPE_NAMES[Math.round(initialShape2)],
            onChange: (v) => {
              writeShape(patch.source, 2, v === 'none' ? null : SHAPE_FROM_STRING[v]);
              commit();
            },
          });
        }
        if (source && controlsFieldAllowed(sourceSpec, 'mix')) {
          veRange(source, 'Mix', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.source.mix, 0, 1, 0.5)),
            onChange: (v) => {
              patch.source.mix = v;
              commit();
            },
          });
        }
        if (source && controlsFieldAllowed(sourceSpec, 'detune')) {
          veRange(source, 'Detune', {
            min: 0,
            max: 50,
            step: 1,
            value: rangeMid(sanitiseRangeValueIn(patch.source.detune, 0, 50, 4)),
            format: (v) => `${Math.round(v)} ct`,
            onChange: (v) => {
              patch.source.detune = Math.round(v);
              commit();
            },
          });
        }
        if (source && controlsFieldAllowed(sourceSpec, 'octave')) {
          veSelect(source, 'Octave', {
            options: [
              ['-1', '-1'],
              ['0', '0'],
              ['1', '+1'],
            ],
            value: String(patch.source.octave),
            onChange: (v) => {
              patch.source.octave = parseInt(v, 10);
              commit();
            },
          });
        }

        const filter = controlsSectionVisible(filterSpec) ? veSection(container, 'Filter') : null;
        if (filter && controlsFieldAllowed(filterSpec, 'type')) {
          veSelect(filter, 'Type', {
            options: FILTER_TYPES,
            value: patch.filter.type,
            onChange: (v) => {
              patch.filter.type = v;
              commit();
            },
          });
        }
        if (filter && controlsFieldAllowed(filterSpec, 'cutoff')) {
          veRange(filter, 'Cutoff', {
            min: 40,
            max: 12000,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.filter.cutoff, 40, 12000, 2000)),
            format: hzFormat,
            onChange: (v) => {
              patch.filter.cutoff = Math.round(v);
              commit();
            },
          });
        }
        if (filter && controlsFieldAllowed(filterSpec, 'q')) {
          veRange(filter, 'Resonance', {
            min: 0.1,
            max: 20,
            step: 0.1,
            value: rangeMid(sanitiseRangeValueIn(patch.filter.q, 0.1, 20, 0.7)),
            onChange: (v) => {
              patch.filter.q = v;
              commit();
            },
          });
        }
        if (filter && controlsFieldAllowed(filterSpec, 'envAmount')) {
          veRange(filter, 'Env amount', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.filter.envAmount, 0, 1, 0.3)),
            onChange: (v) => {
              patch.filter.envAmount = v;
              commit();
            },
          });
        }

        const adsr = controlsSectionVisible(adsrSpec) ? veSection(container, 'Envelope') : null;
        if (adsr && controlsFieldAllowed(adsrSpec, 'attack')) {
          veRange(adsr, 'Attack', {
            min: 0.001,
            max: 8,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.attack, 0.001, 8, 0.01)),
            format: secFormat,
            onChange: (v) => {
              patch.adsr.attack = v;
              commit();
            },
          });
        }
        if (adsr && controlsFieldAllowed(adsrSpec, 'decay')) {
          veRange(adsr, 'Decay', {
            min: 0.001,
            max: 8,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.decay, 0.001, 8, 0.2)),
            format: secFormat,
            onChange: (v) => {
              patch.adsr.decay = v;
              commit();
            },
          });
        }
        if (adsr && controlsFieldAllowed(adsrSpec, 'sustain')) {
          veRange(adsr, 'Sustain', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.sustain, 0, 1, 0.7)),
            onChange: (v) => {
              patch.adsr.sustain = v;
              commit();
            },
          });
        }
        if (adsr && controlsFieldAllowed(adsrSpec, 'release')) {
          veRange(adsr, 'Release', {
            min: 0.01,
            max: 12,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.release, 0.01, 12, 0.5)),
            format: secFormat,
            onChange: (v) => {
              patch.adsr.release = v;
              commit();
            },
          });
        }

        const sends = controlsSectionVisible(sendsSpec) ? veSection(container, 'Sends') : null;
        if (sends && controlsFieldAllowed(sendsSpec, 'reverb')) {
          veRange(sends, 'Reverb', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.sends.reverb, 0, 1, 0.3)),
            onChange: (v) => {
              patch.sends.reverb = v;
              commit();
            },
          });
        }
        if (sends && controlsFieldAllowed(sendsSpec, 'delay')) {
          veRange(sends, 'Delay', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.sends.delay, 0, 1, 0.15)),
            onChange: (v) => {
              patch.sends.delay = v;
              commit();
            },
          });
        }
      }

      // Knob-based editor (v5 module look). Throws only if createKnob does —
      // the caller catches and falls back to buildSliderEditor.
      // v12: `defaults` is the voice's own default Patch (base = deepMerge
      // (FALLBACK_PATCH, voice.defaults) in renderVoiceEditor) — every knob's
      // `defaultValue` comes from it, so double-click resets to what the
      // VOICE ships with, not just whatever the patch happened to load with.
      function buildKnobEditor(container, patch, commit, knobs, controls, defaults) {
        const sourceSpec = controlsSectionSpec(controls, 'source');
        const filterSpec = controlsSectionSpec(controls, 'filter');
        const adsrSpec = controlsSectionSpec(controls, 'adsr');
        const sendsSpec = controlsSectionSpec(controls, 'sends');
        const allowed = (spec, field) => controlsFieldAllowed(spec, field);

        const sections = document.createElement('div');
        sections.className = 'knob-sections';
        container.append(sections);

        function knobSection(heading) {
          const s = document.createElement('div');
          s.className = 'knob-section';
          const h = document.createElement('span');
          h.className = 'panel-label';
          h.textContent = heading;
          const row = document.createElement('div');
          row.className = 'knob-row';
          s.append(h, row);
          sections.append(s);
          return row;
        }

        function addKnob(row, options) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell';
          row.append(cell);
          const handle = knobApi.createKnob(cell, options);
          knobs.push(handle);
          return { cell, handle };
        }

        // The page owns the log transforms: the knob itself is linear, its
        // 0–1 position mapped onto the unit's range in format/onInput. v7:
        // `value`/the value onValue receives may be number|{min,max} — the
        // log map is monotonic over the (positive) domains this is used for,
        // so mapping each thumb independently preserves min ≤ max. `knobOpts`
        // carries allowRange/rangeDefault through to createKnob. v12:
        // `defaultLinear` (optional, same domain as `value`) is mapped through
        // the same toLog and passed on as the knob's `defaultValue`.
        function addLogKnob(row, label, min, max, value, format, onValue, knobOpts, defaultLinear) {
          const toLog = (v) => valueToLog(clamp(v, min, max), min, max);
          const fromLog = (t) => logToValue(clamp(t, 0, 1), min, max);
          return addKnob(row, {
            label,
            min: 0,
            max: 1,
            value: mapRV(value, toLog),
            format: (t) => format(fromLog(t)),
            onInput: (t) => onValue(mapRV(t, fromLog)),
            ...(defaultLinear != null ? { defaultValue: mapRV(defaultLinear, toLog) } : {}),
            ...knobOpts,
          });
        }

        // -- source --
        const source = controlsSectionVisible(sourceSpec) ? knobSection('Source') : null;
        if (source && allowed(sourceSpec, 'shape1')) {
          addKnob(source, {
            label: 'OSC 1',
            glyphOnly: true,
            min: 0,
            max: 3,
            value: readShape(patch.source, 1) ?? 0,
            marks: SHAPE_MARKS,
            markGlyphs: SHAPE_MARK_GLYPHS,
            glyph: shapeGlyph,
            format: shapeFormat,
            defaultValue: readShape(defaults.source, 1) ?? 0,
            onInput: (v) => {
              writeShape(patch.source, 1, v);
              commit();
            },
          });
        }

        // Osc 2's "off" affordance: a toggle beside its dial (shape2 null).
        if (source && allowed(sourceSpec, 'shape2')) {
          let lastShape2 = readShape(patch.source, 2);
          const shape2Default = readShape(defaults.source, 2);
          const osc2Cell = document.createElement('div');
          osc2Cell.className = 'knob-cell knob-cell-toggle';
          const osc2Toggle = document.createElement('button');
          osc2Toggle.type = 'button';
          osc2Toggle.className = 'secondary-button osc2-toggle';
          osc2Toggle.textContent = 'Osc 2';
          osc2Toggle.setAttribute('aria-pressed', String(lastShape2 !== null));
          osc2Toggle.setAttribute('aria-label', 'Oscillator 2 on');
          osc2Cell.append(osc2Toggle);
          source.append(osc2Cell);

          const shape2Knob = addKnob(source, {
            label: 'OSC 2',
            glyphOnly: true,
            min: 0,
            max: 3,
            value: lastShape2 ?? 0,
            marks: SHAPE_MARKS,
            markGlyphs: SHAPE_MARK_GLYPHS,
            glyph: shapeGlyph,
            format: shapeFormat,
            // Only a voice whose own default has osc2 ON declares a dial
            // default here — an off-by-default voice has no canonical "on"
            // shape to reset to, so the knob falls back to its own initial
            // (0) while the cell is reachable at all (i.e. toggled on).
            ...(shape2Default != null ? { defaultValue: shape2Default } : {}),
            onInput: (v) => {
              lastShape2 = clamp(v, 0, 3);
              writeShape(patch.source, 2, lastShape2);
              commit();
            },
          });
          shape2Knob.cell.hidden = lastShape2 === null;

          osc2Toggle.addEventListener('click', () => {
            const on = osc2Toggle.getAttribute('aria-pressed') !== 'true';
            osc2Toggle.setAttribute('aria-pressed', String(on));
            shape2Knob.cell.hidden = !on;
            if (on) {
              if (lastShape2 === null) lastShape2 = 0;
              writeShape(patch.source, 2, lastShape2);
              try {
                shape2Knob.handle.set?.(lastShape2);
              } catch {}
            } else {
              writeShape(patch.source, 2, null);
            }
            commit();
          });
        }

        if (source && allowed(sourceSpec, 'mix')) {
          addKnob(source, {
            label: 'Mix',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.source.mix, 0, 1, 0.5),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.source.mix,
            onInput: (v) => {
              patch.source.mix = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
        // v12: the engine sanitiser (ambient-engine.js PATCH_SCHEMA) clamps
        // detune to [0,50] — no negative cents accepted — so detune STAYS
        // unipolar here rather than the ±50 the addendum sketches; shipping
        // a bipolar dial would silently clamp away the negative half at the
        // engine. Flagged for the engine agent as a possible follow-up.
        if (source && allowed(sourceSpec, 'detune')) {
          addKnob(source, {
            label: 'Detune',
            min: 0,
            max: 50,
            step: 1,
            value: sanitiseRangeValueIn(patch.source.detune, 0, 50, 4),
            format: (v) => `${Math.round(v)} ct`,
            allowRange: true,
            defaultValue: defaults.source.detune,
            onInput: (v) => {
              patch.source.detune = mapRV(v, (x) => Math.round(clamp(x, 0, 50)));
              commit();
            },
          });
        }
        // v12: octave ships ±1, not the addendum's sketched ±2 — both the
        // engine sanitiser (patchNumber(v, -1, 1)) and every voice's own
        // OCTAVES = [-1, 0, 1] (engine-voices.js) clamp there; a ±2 dial
        // would silently round-trip through Math.round(clamp(v,-1,1)) and
        // never actually reach ±2.
        if (source && allowed(sourceSpec, 'octave')) {
          addKnob(source, {
            label: 'Octave',
            min: -1,
            max: 1,
            step: 1,
            value: clamp(patch.source.octave, -1, 1),
            marks: [-1, 0, 1],
            format: (v) => (v > 0 ? `+${Math.round(v)}` : String(Math.round(v))),
            defaultValue: defaults.source.octave,
            onInput: (v) => {
              patch.source.octave = Math.round(clamp(v, -1, 1));
              commit();
            },
          });
        }

        // -- filter --
        const filter = controlsSectionVisible(filterSpec) ? knobSection('Filter') : null;
        if (filter && allowed(filterSpec, 'type')) {
          addKnob(filter, {
            label: 'Type',
            min: 0,
            max: 3,
            step: 1,
            value: Math.max(0, FILTER_ORDER.indexOf(patch.filter.type)),
            marks: [0, 1, 2, 3],
            format: (v) => FILTER_DIAL_LABELS[Math.round(clamp(v, 0, 3))],
            defaultValue: Math.max(0, FILTER_ORDER.indexOf(defaults.filter.type)),
            onInput: (v) => {
              patch.filter.type = FILTER_ORDER[Math.round(clamp(v, 0, 3))];
              commit();
            },
          });
        }
        if (filter && allowed(filterSpec, 'cutoff')) {
          // v7: cutoff is on the default-RANGE list — rangeDefault starts a
          // freshly-opened (plain-number) patch already split into a
          // min=max=value range, ready for the second thumb.
          addLogKnob(
            filter,
            'Cutoff',
            40,
            12000,
            sanitiseRangeValueIn(patch.filter.cutoff, 40, 12000, 2000),
            hzFormat,
            (v) => {
              patch.filter.cutoff = mapRV(v, Math.round);
              commit();
            },
            { allowRange: true, rangeDefault: true },
            defaults.filter.cutoff
          );
        }
        if (filter && allowed(filterSpec, 'q')) {
          addKnob(filter, {
            label: 'Resonance',
            min: 0.1,
            max: 20,
            step: 0.1,
            value: sanitiseRangeValueIn(patch.filter.q, 0.1, 20, 0.7),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.filter.q,
            onInput: (v) => {
              patch.filter.q = mapRV(v, (x) => clamp(x, 0.1, 20));
              commit();
            },
          });
        }
        if (filter && allowed(filterSpec, 'envAmount')) {
          addKnob(filter, {
            label: 'Env amount',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.filter.envAmount, 0, 1, 0.3),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.filter.envAmount,
            onInput: (v) => {
              patch.filter.envAmount = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }

        // -- envelope --
        const env = controlsSectionVisible(adsrSpec) ? knobSection('Envelope') : null;
        if (env && allowed(adsrSpec, 'attack')) {
          addLogKnob(
            env,
            'Attack',
            0.001,
            8,
            sanitiseRangeValueIn(patch.adsr.attack, 0.001, 8, 0.01),
            secFormat,
            (v) => {
              patch.adsr.attack = v;
              commit();
            },
            { allowRange: true },
            defaults.adsr.attack
          );
        }
        if (env && allowed(adsrSpec, 'decay')) {
          addLogKnob(
            env,
            'Decay',
            0.001,
            8,
            sanitiseRangeValueIn(patch.adsr.decay, 0.001, 8, 0.2),
            secFormat,
            (v) => {
              patch.adsr.decay = v;
              commit();
            },
            { allowRange: true },
            defaults.adsr.decay
          );
        }
        if (env && allowed(adsrSpec, 'sustain')) {
          addKnob(env, {
            label: 'Sustain',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.adsr.sustain, 0, 1, 0.7),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.adsr.sustain,
            onInput: (v) => {
              patch.adsr.sustain = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
        if (env && allowed(adsrSpec, 'release')) {
          addLogKnob(
            env,
            'Release',
            0.01,
            12,
            sanitiseRangeValueIn(patch.adsr.release, 0.01, 12, 0.5),
            secFormat,
            (v) => {
              patch.adsr.release = v;
              commit();
            },
            { allowRange: true },
            defaults.adsr.release
          );
        }

        // -- sends --
        // Both sends are on the v7 default-RANGE list too (like Cutoff
        // above) — rangeDefault starts a plain-number patch pre-split.
        const sends = controlsSectionVisible(sendsSpec) ? knobSection('Sends') : null;
        if (sends && allowed(sendsSpec, 'reverb')) {
          addKnob(sends, {
            label: 'Reverb',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.sends.reverb, 0, 1, 0.3),
            format: plainFormat,
            allowRange: true,
            rangeDefault: true,
            defaultValue: defaults.sends.reverb,
            onInput: (v) => {
              patch.sends.reverb = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
        if (sends && allowed(sendsSpec, 'delay')) {
          addKnob(sends, {
            label: 'Delay',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.sends.delay, 0, 1, 0.15),
            format: plainFormat,
            allowRange: true,
            rangeDefault: true,
            defaultValue: defaults.sends.delay,
            onInput: (v) => {
              patch.sends.delay = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
      }

      /**
       * `opts.voiceId` overrides which voice the dial set edits — used when
       * the engine's voice wander has moved this track onto a different
       * voice (v14 "editor follows the sounding voice"). The row's <select>
       * is untouched: it keeps showing the user's own choice, because the
       * wander is ephemeral and getParams still reports the chosen voice.
       */
      async function renderVoiceEditor(track, opts = {}) {
        const container = document.getElementById(`voice-editor-${track}`);
        const voiceId = opts.voiceId || settings.tracks[track].voice;

        // Claim the editor slot BEFORE the await, not after: a quick row
        // switch closes this container (hiding it, tearing down whatever
        // was registered) while we're still awaiting the voices module, so
        // registering openEditors first lets that teardown actually find
        // and cancel us instead of racing a build onto a hidden container.
        teardownEditor(track);
        container.innerHTML = '';
        const ed = { scope: null, knobs: [], extras: null, seq: null };
        openEditors.set(track, ed);

        const voices = await getVoicesTable();
        if (container.hidden) return; // closed while awaiting — leave no live rAF scope loop behind
        const voiceEntry = voices && voices[track] && voices[track][voiceId] ? voices[track][voiceId] : null;
        // Feature-detect .defaults / .controls — absent on an older
        // engine-voices build; absent .controls = render every section/field
        // (the pre-v8 behaviour).
        const defaults = voiceEntry && voiceEntry.defaults ? voiceEntry.defaults : null;
        const controls = voiceEntry && voiceEntry.controls ? voiceEntry.controls : null;
        const base = deepMerge(FALLBACK_PATCH, defaults || {});
        const patch = deepMerge(base, (settings.patches[track] || {})[voiceId] || {});
        // Normalise once so the dials and the scope always see numeric
        // shapes, whatever vintage the stored patch or voice defaults were.
        writeShape(patch.source, 1, readShape(patch.source, 1) ?? 0);
        writeShape(patch.source, 2, readShape(patch.source, 2));

        function commit() {
          if (!settings.patches[track]) settings.patches[track] = {};
          settings.patches[track][voiceId] = patch;
          sendPatch(track, voiceId, patch);
          scheduleScopeRender(track);
          persistSettings();
        }

        // v14 header: track name + "sounding" note, the Off/Auto/On state
        // control (moved out of the single-line row), the dice re-roll and
        // the Randomness mirror.
        container.classList.add(`track-color-${track}`);
        const header = document.createElement('div');
        header.className = 've-header';
        const headerTitle = document.createElement('span');
        headerTitle.className = 'panel-label ve-title';
        headerTitle.textContent = TRACK_LABELS[track];
        const sounding = document.createElement('span');
        sounding.className = 'value-readout ve-sounding';
        sounding.hidden = true;
        const extrasBox = document.createElement('div');
        extrasBox.className = 'track-extras ve-extras';
        header.append(headerTitle, sounding, extrasBox);
        container.append(header);
        buildStateControl(extrasBox, track);
        ed.extras = buildTrackExtras(extrasBox, track, { knobs: ed.knobs, withDice: true });
        ed.sounding = sounding;
        ed.voiceId = voiceId;
        registerExtras(track, ed.extras);
        buildVaryRow(container, track, ed.knobs);
        buildDissonanceControl(container, track, ed.knobs);

        // v6 step sequencer at the top of the pulsed tracks' panels. Arp
        // always shows it (on/off degrades to the legacy boolean mask);
        // melody/bass/percussion need engine support or the grid is dead.
        const showSeq =
          track === 'arp' ||
          ((SEQ_SINGLE_TRACKS.includes(track) || track === 'percussion') &&
            engineCaps.sequencer[track]);
        if (showSeq) ed.seq = buildSequencer(container, track);

        // Arpeggiator controls live here now, above the voice sections.
        if (track === 'arp') buildArpSection(container);

        if (scopeApi) {
          const head = document.createElement('div');
          head.className = 'scope-head';
          const scopeCanvas = document.createElement('canvas');
          scopeCanvas.className = 'patch-scope';
          scopeCanvas.setAttribute('aria-label', `${track} voice waveform preview`);
          const indicator = document.createElement('span');
          indicator.className = 'scope-mode';
          indicator.textContent = 'OFFLINE';
          head.append(scopeCanvas, indicator);
          container.append(head);
          ed.scope = {
            canvas: scopeCanvas,
            indicator,
            live: null,
            analyser: null, // the analyser node s.live is currently attached to
            debounce: null,
            getPatch: () => patch,
          };
          updateScopeMode(track); // draws the static trace or attaches live
        }

        let knobsBuilt = false;
        if (knobApi) {
          try {
            buildKnobEditor(container, patch, commit, ed.knobs, controls, base);
            knobsBuilt = true;
          } catch {
            for (const k of ed.knobs) {
              try {
                k.destroy?.();
              } catch {}
            }
            ed.knobs = [];
            const partial = container.querySelector('.knob-sections');
            if (partial) partial.remove();
          }
        }
        if (!knobsBuilt) buildSliderEditor(container, patch, commit, controls);

        const resetButton = document.createElement('button');
        resetButton.type = 'button';
        resetButton.className = 'secondary-button';
        resetButton.textContent = 'Reset to default';
        resetButton.addEventListener('click', () => {
          if (settings.patches[track]) {
            delete settings.patches[track][voiceId];
            if (Object.keys(settings.patches[track]).length === 0) {
              delete settings.patches[track];
            }
          }
          // An empty patch merges over the voice defaults engine-side; when
          // the defaults are known, send them explicitly for robustness.
          sendPatch(track, voiceId, defaults ? structuredClone(defaults) : {});
          persistSettings();
          renderVoiceEditor(track);
        });
        container.append(resetButton);
      }

      // ---- v8: single-open voice-editor accordion ------------------------
      // A track row gaining focus/selection (click or keyboard, anywhere
      // except the Edit button, which has its own explicit toggle below)
      // opens that track's editor and collapses any other open one. Both
      // paths funnel through the same open/close pair so they can never
      // fight each other, and both compose with teardownEditor (scope
      // destroy, knob destroy, extras unregister).
      // v13: closing an editor with the Edit toggle disarms focus-driven
      // reopening for that track until Edit is pressed again — otherwise the
      // next Tab into the row instantly undoes the close the user just asked
      // for. Only the Edit toggle re-arms it.
      const focusOpenDisarmed = new Set();

      function closeTrackEditor(id) {
        const editor = document.getElementById(`voice-editor-${id}`);
        const toggle = document.getElementById(`voice-edit-toggle-${id}`);
        if (editor.hidden) return;
        editor.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        teardownEditor(id);
      }

      // restoreScroll: only click-initiated opens put the viewport back
      // where the user's eye was — a keyboard/focusin-driven open (Tab
      // landing in the row) already has the browser scrolling the newly
      // focused control into view, and overriding that with the old
      // scrollY would just scroll the focused control back out of sight.
      function openTrackEditor(id, { restoreScroll = false } = {}) {
        const editor = document.getElementById(`voice-editor-${id}`);
        if (!editor.hidden) return; // already the one open
        const scrollY = restoreScroll ? window.scrollY : null;
        for (const other of TRACK_IDS) {
          if (other !== id) closeTrackEditor(other);
        }
        const toggle = document.getElementById(`voice-edit-toggle-${id}`);
        editor.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        renderVoiceEditor(id);
        if (restoreScroll) {
          // The accordion swap changes page height above/below the fold;
          // put the viewport back where the user's eye was.
          requestAnimationFrame(() => window.scrollTo(0, scrollY));
        }
      }

      function isEditToggle(el) {
        return !!(el && el.closest && el.closest('.voice-edit-toggle'));
      }

      // v14: a lamp/state click is a MUSICAL action, never a navigation one —
      // turning a track off must not expand (or keep open) its editor.
      function isStateControl(el) {
        return !!(el && el.closest && el.closest('.track-lamp'));
      }

      for (const id of TRACK_IDS) {
        const toggle = document.getElementById(`voice-edit-toggle-${id}`);
        const editor = document.getElementById(`voice-editor-${id}`);
        const row = document.querySelector(`.track-row[data-track="${id}"]`);

        // Edit button: explicit, secondary affordance — still routes through
        // the same accordion open/close so it can never desync from focus-
        // driven opens. It is also the ONLY thing that re-arms focus-opening
        // after an explicit close.
        toggle.addEventListener('click', () => {
          if (editor.hidden) {
            focusOpenDisarmed.delete(id);
            openTrackEditor(id, { restoreScroll: true });
          } else {
            focusOpenDisarmed.add(id);
            closeTrackEditor(id);
          }
        });

        // Row focus/selection: click or keyboard-focus anywhere in the row
        // (voice select, level knob, randomness knob) opens it, EXCEPT the
        // Edit button itself (handled above, to avoid a focusin-then-click
        // race that would open-then-instantly-close it) and the lamp.
        if (row) {
          row.addEventListener('click', (event) => {
            if (isEditToggle(event.target) || isStateControl(event.target)) return;
            if (focusOpenDisarmed.has(id)) return;
            openTrackEditor(id, { restoreScroll: true });
          });
          row.addEventListener('focusin', (event) => {
            if (isEditToggle(event.target) || isStateControl(event.target)) return;
            if (focusOpenDisarmed.has(id)) return;
            openTrackEditor(id);
          });
        }
      }

      // Tracks-panel row instance of the Randomness knob (no dice: that lives
      // in the Edit panel header only).
      for (const id of TRACK_IDS) {
        const box = document.getElementById(`track-extras-${id}`);
        registerExtras(id, buildTrackExtras(box, id));
      }

      // The two busiest generative tracks; the power governor's
      // textureDensityScale is applied to what the engine is SENT for these
      // (see applyPowerBudget), never to the user's stored Level.
      const DENSITY_TRACKS = ['texture', 'arp'];

      function scaledLevel(track, value) {
        const scale = powerBudget ? powerBudget.textureDensityScale : 1;
        if (scale >= 1 || !DENSITY_TRACKS.includes(track)) return value;
        return mapRV(value, (v) => clamp(v * scale, 0, 1));
      }

      // ---- v8: per-track Level knob (RangeValue: number | {min,max}) -----
      // Lives in the main tracks-panel row (not just the Edit panel), so
      // level is reachable without opening the accordion. Feature-tolerant:
      // always sent, regardless of whether this engine build understands
      // `tracks[track].level` — an older sanitiser just drops the key.
      const levelControls = new Map(); // track -> { set(value) }

      function buildLevelControl(container, track) {
        const commitLevel = (value) => {
          settings.tracks[track].level = value;
          engine.setParams({ tracks: { [track]: { level: scaledLevel(track, value) } } });
          persistSettings();
        };
        const readMid = (v) => (typeof v === 'number' ? v : (v.min + v.max) / 2);
        if (knobApi) {
          try {
            const cell = document.createElement('div');
            cell.className = 'level-knob';
            container.append(cell);
            const handle = knobApi.createKnob(cell, {
              label: 'Level',
              min: 0,
              max: 1,
              value: settings.tracks[track].level,
              format: pctFormat,
              allowRange: true,
              defaultValue: DEFAULTS.tracks[track].level,
              onInput: commitLevel,
            });
            return {
              set: (v) => {
                try {
                  handle.set?.(v);
                } catch {}
              },
            };
          } catch {
            container.innerHTML = '';
          }
        }
        const wrap = document.createElement('label');
        wrap.className = 'level-slider';
        const name = document.createElement('span');
        name.className = 'visually-hidden';
        name.textContent = `${TRACK_LABELS[track]} level`;
        const input = document.createElement('input');
        input.type = 'range';
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(readMid(settings.tracks[track].level));
        input.addEventListener('input', () => commitLevel(parseFloat(input.value)));
        wrap.append(name, input);
        container.append(wrap);
        return { set: (v) => (input.value = String(readMid(v))) };
      }

      for (const id of TRACK_IDS) {
        const box = document.getElementById(`track-level-${id}`);
        if (box && engineCaps.level[id]) levelControls.set(id, buildLevelControl(box, id));
      }

      // ---- v9/v14 power governor + Processor dial --------------------------
      // The dial reads Eco / Low / Med / Full / Auto; power.js owns the tier
      // budgets and the auto sensing, the page applies the parts of the
      // budget that live up here (live scope on/off, texture/arp density).
      const PROCESSOR_TIERS = ['eco', 'low', 'med', 'full', 'auto'];
      const PROCESSOR_LABELS = ['Eco', 'Low', 'Med', 'Full', 'Auto'];
      const processorReadout = document.getElementById('processor-readout');

      function applyPowerBudget(budget) {
        powerBudget = budget;
        if (processorReadout) {
          const requested = governor ? governor.getTier() : settings.ui.processor;
          const auto = requested === 'auto' ? ` (${budget.tier})` : '';
          processorReadout.textContent =
            `${PROCESSOR_LABELS[PROCESSOR_TIERS.indexOf(requested)] || 'Auto'}${auto}` +
            ` · ${budget.maxNotes === Infinity ? 'no note cap' : `${budget.maxNotes} notes`}` +
            ` · ${budget.visualFps} fps`;
        }
        // scopeEnabled: the page owns the live scope, so this one is applied
        // directly — updateAllScopeModes falls back to the cheap static
        // trace whenever the budget withholds it.
        updateAllScopeModes();
        // textureDensityScale: the engine has no density hook, so this is
        // applied as a LEVEL scale on the two busiest tracks (texture, arp).
        // It trims how present they are at a low tier; it does NOT reduce
        // node count — the real CPU lever is maxNotes, which power.js hands
        // to engine.setPowerBudget() itself. The user's own Level values are
        // never overwritten: only what we send the engine is scaled.
        applyDensityScale();
        // visualFps: visualiser.js and scope.js expose no fps setter (they
        // self-cap at 30 fps, 2 fps hidden). Feature-detected below so the
        // budget lands the day either grows one; until then the figure is
        // reported in the readout only.
        try {
          visualiserHandle?.setFps?.(budget.visualFps);
        } catch {}
      }

      function applyDensityScale() {
        const tracks = {};
        for (const id of DENSITY_TRACKS) {
          if (!engineCaps.level[id]) continue;
          tracks[id] = { level: scaledLevel(id, settings.tracks[id].level) };
        }
        if (Object.keys(tracks).length) engine.setParams({ tracks });
      }

      function setProcessorTier(tier) {
        settings.ui.processor = tier;
        persistSettings();
        if (governor) governor.setTier(tier);
        else if (powerBudget) applyPowerBudget(powerBudget);
      }

      try {
      const { createGovernor } = await import('../scripts/power.js');
        if (typeof createGovernor === 'function') {
          governor = createGovernor({ engine, onTierChange: applyPowerBudget });
        }
      } catch {
        // No governor module: everything below simply never runs.
      }

      if (governor) {
        const tierIndex = Math.max(0, PROCESSOR_TIERS.indexOf(settings.ui.processor));
        processorDial = buildSimpleDial(
          'processor-dial',
          {
            id: 'processor',
            label: 'Processor',
            min: 0,
            max: 4,
            step: 1,
            marks: [0, 1, 2, 3, 4],
            value: tierIndex,
            format: (v) => PROCESSOR_LABELS[clamp(Math.round(v), 0, 4)],
            defaultValue: 4,
          },
          (v) => setProcessorTier(PROCESSOR_TIERS[clamp(Math.round(v), 0, 4)])
        );
        describe(
          processorDial.el,
          'How hard the generator may work. Auto watches CPU pressure and frame times and picks for you; Eco is the coolest, Full the busiest.'
        );
        setProcessorTier(settings.ui.processor);
      } else {
        document.querySelector('.processor-row')?.remove();
      }

      // ---- v14 sequencer playhead ----------------------------------------
      // The sounding step lights white. One 'bar' event schedules that bar's
      // step changes as plain timeouts (≤20 per bar, and only while an editor
      // with a grid is open) — a DOM class swap at step rate, never a rAF
      // loop and nothing at all while the grids are closed.
      let playheadTimers = [];

      function clearPlayheadTimers() {
        for (const timer of playheadTimers) clearTimeout(timer);
        playheadTimers = [];
      }

      function clearPlayhead() {
        clearPlayheadTimers();
        for (const ed of openEditors.values()) ed.seq?.setPlayhead(-1);
      }

      function schedulePlayhead(barTime, beatsPerBar) {
        clearPlayheadTimers();
        const barSeconds = (beatsPerBar || 4) * (60 / clamp(settings.bpm, 40, 120));
        for (const [track, ed] of openEditors) {
          if (!ed.seq) continue;
          const n = stepsPerBarFor(track);
          const stepSeconds = barSeconds / n;
          for (let i = 0; i < n; i++) {
            const delayMs = (barTime + i * stepSeconds - engine.now()) * 1000;
            if (delayMs < -stepSeconds * 1000) continue; // already past
            playheadTimers.push(
              setTimeout(() => {
                try {
                  ed.seq?.setPlayhead(i);
                } catch {}
              }, Math.max(0, delayMs))
            );
          }
        }
      }

      // ---- v9 per-track cost meters --------------------------------------
      // A thin bar in each row, tinted by that track's own colour, fed from
      // engine.getStats() at 1 Hz while running (and once on stop, to empty
      // them). Nothing polls while the engine is idle.
      const COST_METER_FULL = 12; // active notes that read as a full bar
      let costTimer = null;

      function updateCostMeters() {
        let stats = null;
        try {
          stats = engine.getStats();
        } catch {}
        const perTrack = stats && isPlainObject(stats.perTrack) ? stats.perTrack : null;
        for (const id of TRACK_IDS) {
          const meter = document.getElementById(`cost-meter-${id}`);
          if (!meter) continue;
          const entry = perTrack ? perTrack[id] : null;
          const share = entry ? clamp(entry.activeNotes / COST_METER_FULL, 0, 1) : 0;
          meter.hidden = !perTrack;
          meter.firstElementChild.style.width = `${Math.round(share * 100)}%`;
          meter.setAttribute(
            'aria-label',
            `${TRACK_LABELS[id]} load: ${entry ? entry.activeNotes : 0} notes sounding`
          );
        }
      }

      function setCostPolling(on) {
        if (!engineCaps.getStats) return;
        if (on) {
          if (costTimer === null) costTimer = setInterval(updateCostMeters, 1000);
          updateCostMeters();
        } else if (costTimer !== null) {
          clearInterval(costTimer);
          costTimer = null;
          updateCostMeters();
        }
      }

      // ---- v14 live readouts (resolved / drifting values) -----------------
      // engine.getResolved() reports what is ACTUALLY being played right now:
      // every RangeValue resolved through its walk, and the voice that is
      // really sounding (voice wander included). Polled at 4 Hz while
      // running; the numbers land as secondary text beside the row's dials,
      // and a wander to a different voice re-renders the open editor so the
      // dial set follows the voice you can hear.
      let resolvedTimer = null;

      function applyResolved(resolved) {
        const tracks = resolved && isPlainObject(resolved.tracks) ? resolved.tracks : null;
        for (const id of TRACK_IDS) {
          const readout = document.getElementById(`resolved-${id}`);
          if (!readout) continue;
          const entry = tracks ? tracks[id] : null;
          if (!entry) {
            readout.textContent = '';
            continue;
          }
          const bits = [`level ${pctFormat(entry.level ?? 0)}`];
          bits.push(entry.held ? 'held' : `random ${pctFormat(entry.randomness ?? 0)}`);
          readout.textContent = bits.join(' · ');
        }
        // The editor follows the SOUNDING voice: the row's <select> keeps
        // showing the user's choice (wander is ephemeral, per the contract),
        // the editor header says what is actually sounding, and the dial set
        // re-renders when that changes.
        // Snapshot the entries: a wander re-render replaces this track's
        // openEditors entry mid-loop, which a live Map iteration would trip
        // over.
        for (const [track, ed] of Array.from(openEditors)) {
          const entry = tracks ? tracks[track] : null;
          const voice = entry ? entry.voice : null;
          if (!voice || !ed.sounding) continue;
          const chosen = settings.tracks[track].voice;
          ed.sounding.hidden = voice === chosen;
          ed.sounding.textContent = voice === chosen ? '' : `sounding: ${voiceLabel(track, voice)}`;
          if (voice !== ed.voiceId) renderVoiceEditor(track, { voiceId: voice });
        }
      }

      function setResolvedPolling(on) {
        if (!engineCaps.getResolved) return;
        if (on) {
          if (resolvedTimer === null) {
            resolvedTimer = setInterval(() => {
              try {
                applyResolved(engine.getResolved());
              } catch {}
            }, 250);
          }
        } else if (resolvedTimer !== null) {
          clearInterval(resolvedTimer);
          resolvedTimer = null;
        }
      }

      function voiceLabel(track, voiceId) {
        const found = VOICE_LABELS[track]?.[voiceId];
        return found || voiceId;
      }

      // ---- structure + custom structure builder -------------------------

      const customBuilder = document.getElementById('custom-structure-builder');
      const structureBlocks = document.getElementById('structure-blocks');
      const addBlockButton = document.getElementById('add-structure-block');
      const blockLabels = ['A', 'B', 'C', 'D'];

      function renderStructureBlocks() {
        structureBlocks.innerHTML = '';
        settings.customStructure.forEach((block, index) => {
          const row = document.createElement('div');
          row.className = 'structure-block';

          const labelSelect = document.createElement('select');
          labelSelect.setAttribute('aria-label', `Block ${index + 1} label`);
          for (const l of blockLabels) {
            const opt = document.createElement('option');
            opt.value = l;
            opt.textContent = `Section ${l}`;
            if (l === block.label) opt.selected = true;
            labelSelect.append(opt);
          }
          labelSelect.addEventListener('change', () => {
            settings.customStructure[index].label = labelSelect.value;
            commitCustomStructure();
          });

          const barsInput = document.createElement('input');
          barsInput.type = 'number';
          barsInput.min = '1';
          barsInput.max = '32';
          barsInput.value = String(block.bars);
          barsInput.setAttribute('aria-label', `Block ${index + 1} bars`);
          barsInput.addEventListener('input', () => {
            const parsed = parseInt(barsInput.value, 10);
            if (!Number.isFinite(parsed)) return; // mid-edit blank; keep stored value
            const bars = Math.round(clamp(parsed, 1, 32));
            settings.customStructure[index].bars = bars;
            // Reflect the clamp so UI, stored state and engine can't diverge.
            if (barsInput.value !== String(bars)) barsInput.value = String(bars);
            commitCustomStructure();
          });

          const intensityInput = document.createElement('input');
          intensityInput.type = 'range';
          intensityInput.min = '0';
          intensityInput.max = '1';
          intensityInput.step = '0.01';
          intensityInput.value = String(block.intensity);
          intensityInput.setAttribute('aria-label', `Block ${index + 1} intensity`);
          intensityInput.addEventListener('input', () => {
            settings.customStructure[index].intensity = parseFloat(intensityInput.value);
            commitCustomStructure();
          });

          const upButton = document.createElement('button');
          upButton.type = 'button';
          upButton.className = 'block-move';
          upButton.textContent = '↑';
          upButton.setAttribute('aria-label', `Move block ${index + 1} up`);
          upButton.disabled = index === 0;
          upButton.addEventListener('click', () => {
            if (index === 0) return;
            const blocks = settings.customStructure;
            [blocks[index - 1], blocks[index]] = [blocks[index], blocks[index - 1]];
            commitCustomStructure();
            renderStructureBlocks();
          });

          const downButton = document.createElement('button');
          downButton.type = 'button';
          downButton.className = 'block-move';
          downButton.textContent = '↓';
          downButton.setAttribute('aria-label', `Move block ${index + 1} down`);
          downButton.disabled = index === settings.customStructure.length - 1;
          downButton.addEventListener('click', () => {
            const blocks = settings.customStructure;
            if (index === blocks.length - 1) return;
            [blocks[index + 1], blocks[index]] = [blocks[index], blocks[index + 1]];
            commitCustomStructure();
            renderStructureBlocks();
          });

          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.className = 'block-remove';
          removeButton.textContent = 'Remove';
          removeButton.setAttribute('aria-label', `Remove block ${index + 1}`);
          removeButton.disabled = settings.customStructure.length <= 1;
          removeButton.addEventListener('click', () => {
            if (settings.customStructure.length <= 1) return;
            settings.customStructure.splice(index, 1);
            commitCustomStructure();
            renderStructureBlocks();
          });

          row.append(labelSelect, barsInput, intensityInput, upButton, downButton, removeButton);
          structureBlocks.append(row);
        });

        addBlockButton.disabled = settings.customStructure.length >= 8;
      }

      function commitCustomStructure() {
        engine.setParams({ customStructure: settings.customStructure });
        updateComplexityDisplay();
        persistSettings();
      }

      addBlockButton.addEventListener('click', () => {
        if (settings.customStructure.length >= 8) return;
        settings.customStructure.push({ label: 'A', bars: 8, intensity: 0.4 });
        commitCustomStructure();
        renderStructureBlocks();
      });

      function syncStructureUI() {
        structureSelect.value = settings.structure;
        customBuilder.hidden = settings.structure !== 'custom';
        renderStructureBlocks();
        updateComplexityDisplay();
      }

      structureSelect.addEventListener('change', () => {
        settings.structure = structureSelect.value;
        customBuilder.hidden = settings.structure !== 'custom';
        const partial = { structure: settings.structure };
        if (settings.structure === 'custom') partial.customStructure = settings.customStructure;
        engine.setParams(partial);
        updateComplexityDisplay();
        persistSettings();
      });

      // ---- arpeggiator sync (controls live in the Arp Edit panel) -------

      function syncArpUI() {
        updateComplexityDisplay();
        if (!arpUI) return; // arp editor closed — nothing rendered to sync
        for (const radio of arpUI.modeRadios) {
          radio.checked = radio.value === settings.arp.mode;
        }
        arpUI.manual.hidden = settings.arp.mode !== 'manual';
        arpUI.pattern.value = settings.arp.pattern;
        arpUI.rate.value = settings.arp.rate;
        arpUI.octaves.value = String(settings.arp.octaves);
        arpUI.octavesOut.textContent = String(settings.arp.octaves);
        arpUI.gate.value = String(settings.arp.gate);
        arpUI.gateOut.textContent = String(settings.arp.gate);
      }

      // ---- transport (Play / Finish / Stop now) -------------------------

      let finishing = false;
      let playNotice = '';

      function setTransportUI() {
        const running = !!engine.running;
        toggleButton.setAttribute('aria-pressed', String(running));
        if (finishing) {
          playLabel.textContent = 'Finishing…';
          toggleButton.disabled = true;
        } else {
          playLabel.textContent = running ? 'Finish' : 'Play';
          toggleButton.disabled = false;
        }
        // v15: ▶ before "Play"; the final-barline 𝄂 after "Finish".
        playGlyph.hidden = running || finishing;
        finishGlyph.hidden = !(running || finishing);
        // v15: Stop is a permanent button in the strip (was a "Stop now"
        // link that only appeared mid-playback), disabled when idle.
        stopNowButton.disabled = !running && !finishing;
        setCostPolling(running);
        setResolvedPolling(running);
        refreshRecordAvailability();
        if (!running) clearPlayhead();
        try {
          if ('mediaSession' in navigator) {
            navigator.mediaSession.playbackState = running ? 'playing' : 'paused';
          }
        } catch {}
        // Every transport change re-evaluates open editors' scopes
        // (OFFLINE static trace ↔ LIVE analyser trace).
        updateAllScopeModes();
      }

      // Lock-screen / hardware-key transport. Full lock-screen support also
      // needs the engine's media-element routing; the handlers are correct
      // without it.
      let mediaSessionReady = false;
      function setupMediaSession() {
        if (mediaSessionReady) return;
        try {
          if (!('mediaSession' in navigator) || typeof MediaMetadata !== 'function') return;
          navigator.mediaSession.metadata = new MediaMetadata({
            title: 'Ambi4 generator',
            artist: 'Ambi4',
          });
          navigator.mediaSession.setActionHandler('play', () => {
            if (!engine.running) engine.start().catch(() => {});
          });
          navigator.mediaSession.setActionHandler('pause', () => {
            engine.stop();
          });
          navigator.mediaSession.setActionHandler('stop', () => {
            engine.stop();
          });
          mediaSessionReady = true;
        } catch {}
      }

      async function finishOrStop() {
        // Feature-detect finish() — an older engine only has stop().
        if (typeof engine.finish !== 'function') {
          engine.stop();
          setTransportUI();
          return;
        }
        if (finishing) return;
        finishing = true;
        setTransportUI();
        try {
          await engine.finish();
        } catch {
          engine.stop();
        } finally {
          finishing = false;
          setTransportUI();
        }
      }

      toggleButton.addEventListener('click', async () => {
        if (finishing) return;
        if (engine.running) {
          await finishOrStop();
          return;
        }
        if (alarmTarget !== null) cancelAlarm(); // starting now supersedes it
        toggleButton.disabled = true;
        playNotice = '';
        updateTimerUI();
        // start() can wedge (a context stuck pending resume never resolves);
        // don't leave the button dead — give the UI back after 3 s. A late
        // resolve still syncs the UI via the engine 'state' event.
        const outcome = await Promise.race([
          engine.start().then(
            () => 'started',
            () => 'failed'
          ),
          new Promise((resolve) => setTimeout(() => resolve('timeout'), 3000)),
        ]);
        toggleButton.disabled = false;
        if (outcome === 'started') {
          setupMediaSession();
        } else if (outcome === 'failed' || (outcome === 'timeout' && !engine.running)) {
          playNotice = 'Audio didn’t start — tap Play again.';
          updateTimerUI();
        }
        setTransportUI();
      });

      stopNowButton.addEventListener('click', () => {
        engine.stop();
        finishing = false;
        setTransportUI();
      });

      // ---- v15 record ------------------------------------------------------
      // MediaRecorder over the engine's own mixed output. The engine keeps
      // that MediaStream private (it lives on an internal <audio> element and
      // is not on the public API), so the page can only record once the
      // engine exposes it — every plausible accessor is probed here, and the
      // button ships disabled with an explanation when none answers. Summing
      // the per-track analysers would "work", but they tap pre-mix, pre-
      // effects and pre-master, so the file would not be what the listener
      // heard: a wrong recording is worse than none.
      function engineOutputStream() {
        for (const name of ['getOutputStream', 'getMediaStream', 'getStream']) {
          try {
            const stream = typeof engine[name] === 'function' ? engine[name]() : null;
            if (stream && typeof stream.getAudioTracks === 'function') return stream;
          } catch {}
        }
        try {
          const el = typeof engine.getOutputElement === 'function' ? engine.getOutputElement() : null;
          if (el && el.srcObject && typeof el.srcObject.getAudioTracks === 'function') {
            return el.srcObject;
          }
        } catch {}
        return null;
      }

      const canRecord = typeof window.MediaRecorder === 'function';
      let recorder = null;
      let recordChunks = [];
      let recordStartedAt = 0;
      let recordTimer = null;

      function updateRecordStatus() {
        if (!recorder) {
          recordStatus.hidden = true;
          recordStatus.textContent = '';
          return;
        }
        recordStatus.hidden = false;
        recordStatus.textContent = `Recording ${formatCountdown(Date.now() - recordStartedAt)}`;
      }

      function stopRecording() {
        if (!recorder) return;
        try {
          recorder.stop();
        } catch {
          recorder = null;
        }
      }

      function startRecording() {
        const stream = engineOutputStream();
        if (!stream) return;
        try {
          recorder = new MediaRecorder(stream);
        } catch {
          recorder = null;
          return;
        }
        recordChunks = [];
        recorder.addEventListener('dataavailable', (event) => {
          if (event.data && event.data.size) recordChunks.push(event.data);
        });
        recorder.addEventListener('stop', () => {
          const blob = new Blob(recordChunks, { type: recorder.mimeType || 'audio/webm' });
          recordChunks = [];
          recorder = null;
          if (recordTimer !== null) {
            clearInterval(recordTimer);
            recordTimer = null;
          }
          recordButton.setAttribute('aria-pressed', 'false');
          recordButton.classList.remove('recording');
          updateRecordStatus();
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `ambi4-${new Date().toISOString().replace(/[:.]/g, '-')}.webm`;
          link.click();
          setTimeout(() => URL.revokeObjectURL(url), 10000);
        });
        recorder.start();
        recordStartedAt = Date.now();
        recordButton.setAttribute('aria-pressed', 'true');
        recordButton.classList.add('recording');
        recordTimer = setInterval(updateRecordStatus, 1000);
        updateRecordStatus();
      }

      function refreshRecordAvailability() {
        if (recorder) return;
        const ready = canRecord && !!engineOutputStream();
        recordButton.disabled = !ready;
      }

      recordButton.disabled = true;
      describe(
        recordButton,
        canRecord
          ? 'Records the mix to a .webm file on this device. Needs the engine to publish its output stream — arriving with the next engine update.'
          : 'This browser has no MediaRecorder, so recording is unavailable here.'
      );
      if (canRecord) {
        recordButton.addEventListener('click', () => {
          if (recorder) stopRecording();
          else startRecording();
        });
        refreshRecordAvailability();
      }

      if (typeof engine.on === 'function') {
        engine.on('state', ({ running }) => {
          if (!running) finishing = false;
          if (running) {
            setupMediaSession();
            if (playNotice) {
              playNotice = '';
              updateTimerUI();
            }
          }
          setTransportUI();
        });
        engine.on('bar', ({ time, beatsPerBar }) => {
          schedulePlayhead(time, beatsPerBar);
        });
      }

      // ---- sleep timer + alarm (wall-clock re-check, drift-proof) -------

      const sleepIdle = document.getElementById('sleep-idle');
      const sleepActive = document.getElementById('sleep-active');
      const sleepCountdown = document.getElementById('sleep-countdown');
      const sleepCustom = document.getElementById('sleep-custom');
      const alarmIdle = document.getElementById('alarm-idle');
      const alarmActive = document.getElementById('alarm-active');
      const alarmCountdown = document.getElementById('alarm-countdown');
      const alarmTimeInput = document.getElementById('alarm-time');
      const sleepChip = document.getElementById('sleep-chip');
      const alarmChip = document.getElementById('alarm-chip');

      // ---- v6: sleep/alarm popovers (anchored, keyboard-operable dialogs) -
      // Esc and outside-click close; focus moves into the panel on open and
      // back to its button on close; Tab wraps within the panel while open.
      function setupPopover(toggleId, popoverId) {
        const toggle = document.getElementById(toggleId);
        const popover = document.getElementById(popoverId);
        const anchor = toggle.closest('.popover-anchor') || toggle.parentElement;

        function focusables() {
          return Array.from(
            popover.querySelectorAll(
              'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
            )
          ).filter((el) => !el.disabled && el.offsetParent !== null);
        }

        function open() {
          if (!popover.hidden) return;
          popover.hidden = false;
          toggle.setAttribute('aria-expanded', 'true');
          const first = focusables()[0];
          try {
            (first || popover).focus();
          } catch {}
        }

        function close({ refocus = true } = {}) {
          if (popover.hidden) return;
          popover.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
          if (refocus) toggle.focus();
        }

        toggle.addEventListener('click', () => {
          if (popover.hidden) open();
          else close();
        });

        popover.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            close();
            return;
          }
          if (event.key !== 'Tab') return;
          const els = focusables();
          if (els.length === 0) return;
          const first = els[0];
          const last = els[els.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        document.addEventListener('pointerdown', (event) => {
          if (popover.hidden) return;
          if (anchor.contains(event.target)) return;
          close({ refocus: false });
        });

        return { open, close };
      }

      setupPopover('sleep-toggle', 'sleep-popover');
      setupPopover('alarm-toggle', 'alarm-popover');

      let sleepTarget = null; // epoch ms
      let alarmTarget = null; // epoch ms
      let tickHandle = null;
      let alarmNotice = '';

      function formatCountdown(ms) {
        const total = Math.max(0, Math.round(ms / 1000));
        const h = Math.floor(total / 3600);
        const m = Math.floor((total % 3600) / 60);
        const s = total % 60;
        const pad = (n) => String(n).padStart(2, '0');
        return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
      }

      // Hiding the row that currently holds focus (e.g. clicking "Start" in
      // sleep-idle, which then hides sleep-idle for sleep-active) drops
      // focus to <body>, breaking Esc/Tab-wrap in the still-open popover.
      // If that happened, move focus into the newly-visible counterpart.
      function swapTimerRow(idleEl, activeEl, isActive) {
        const focusWasInside = idleEl.contains(document.activeElement) || activeEl.contains(document.activeElement);
        idleEl.hidden = isActive;
        activeEl.hidden = !isActive;
        if (focusWasInside && document.activeElement === document.body) {
          const visible = isActive ? activeEl : idleEl;
          const target = visible.querySelector(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          );
          if (target) {
            try {
              target.focus();
            } catch {}
          }
        }
      }

      function updateTimerUI() {
        const now = Date.now();
        swapTimerRow(sleepIdle, sleepActive, sleepTarget !== null);
        swapTimerRow(alarmIdle, alarmActive, alarmTarget !== null);
        sleepChip.hidden = sleepTarget === null;
        if (sleepTarget !== null) sleepChip.textContent = formatCountdown(sleepTarget - now);
        alarmChip.hidden = alarmTarget === null;
        if (alarmTarget !== null) alarmChip.textContent = formatCountdown(alarmTarget - now);
        const bits = [];
        if (sleepTarget !== null) {
          const text = `Fades out in ${formatCountdown(sleepTarget - now)}`;
          sleepCountdown.textContent = text;
          bits.push(`Sleep: ${formatCountdown(sleepTarget - now)}`);
        }
        if (alarmTarget !== null) {
          const at = new Date(alarmTarget);
          const pad = (n) => String(n).padStart(2, '0');
          const hhmm = `${pad(at.getHours())}:${pad(at.getMinutes())}`;
          alarmCountdown.textContent = `Starts at ${hhmm} (in ${formatCountdown(alarmTarget - now)})`;
          bits.push(`Alarm: ${hhmm}`);
        }
        if (alarmNotice) bits.push(alarmNotice);
        if (playNotice) bits.push(playNotice);
        transportStatus.textContent = bits.join(' · ');
      }

      // Re-check the wall clock every second rather than one long
      // setTimeout, so laptop sleep can't silently skip the target. The tick
      // runs in an inline-blob Web Worker: hidden silent tabs get main-thread
      // timers clamped to once a minute (Chrome intensive throttling), which
      // would fire the alarm up to a minute late — worker timers aren't
      // clamped that hard. Falls back to setInterval where workers fail.
      let tickWorkerURL = null;

      function ensureTicker() {
        if (sleepTarget === null && alarmTarget === null) return;
        if (tickHandle !== null) return;
        try {
          tickWorkerURL = URL.createObjectURL(
            new Blob(['setInterval(function () { postMessage(0); }, 1000);'], {
              type: 'text/javascript',
            })
          );
          const worker = new Worker(tickWorkerURL);
          worker.onmessage = () => tick();
          tickHandle = { worker };
        } catch {
          if (tickWorkerURL !== null) {
            URL.revokeObjectURL(tickWorkerURL);
            tickWorkerURL = null;
          }
          tickHandle = { interval: setInterval(tick, 1000) };
        }
      }

      function idleTickerIfDone() {
        if (tickHandle === null || sleepTarget !== null || alarmTarget !== null) return;
        if (tickHandle.worker) tickHandle.worker.terminate();
        if (tickHandle.interval) clearInterval(tickHandle.interval);
        tickHandle = null;
        if (tickWorkerURL !== null) {
          URL.revokeObjectURL(tickWorkerURL);
          tickWorkerURL = null;
        }
      }

      // Keep the screen on ONLY while an alarm is armed — a sleeping device
      // can't fire it. Ordinary playback takes no lock.
      let wakeLock = null;

      function acquireWakeLock() {
        if (alarmTarget === null || wakeLock !== null) return;
        if (!('wakeLock' in navigator) || typeof navigator.wakeLock.request !== 'function') return;
        navigator.wakeLock
          .request('screen')
          .then((lock) => {
            if (alarmTarget === null) {
              Promise.resolve(lock.release()).catch(() => {});
              return;
            }
            wakeLock = lock;
            // The OS can revoke it (tab hidden); we re-request on visible.
            lock.addEventListener('release', () => {
              if (wakeLock === lock) wakeLock = null;
            });
          })
          .catch(() => {});
      }

      function releaseWakeLock() {
        if (wakeLock === null) return;
        Promise.resolve(wakeLock.release()).catch(() => {});
        wakeLock = null;
      }

      function tick() {
        const now = Date.now();
        if (sleepTarget !== null && now >= sleepTarget) {
          sleepTarget = null;
          if (engine.running) finishOrStop();
        }
        if (alarmTarget !== null && now >= alarmTarget) {
          alarmTarget = null;
          releaseWakeLock();
          if (!engine.running) {
            engine
              .start()
              .then(() => {
                alarmNotice = '';
                setTransportUI();
                updateTimerUI();
                setupMediaSession();
                // A start() in a throttled background tab can resolve with
                // the context still effectively suspended; poke it once it
                // should be audible. resume() is an idempotent context-poke.
                setTimeout(() => {
                  if (engine.running && typeof engine.resume === 'function') {
                    try {
                      // resume() can silently rebuildContext() (fresh
                      // analyser nodes) without a 'state' event — re-check
                      // any open scope's live analyser once it settles.
                      Promise.resolve(engine.resume()).then(updateAllScopeModes).catch(() => {});
                    } catch {}
                  }
                }, 1500);
              })
              .catch(() => {
                alarmNotice = 'Couldn’t start automatically — press Play.';
                updateTimerUI();
              });
          }
        }
        updateTimerUI();
        idleTickerIfDone();
      }

      function startSleepTimer(minutes) {
        if (!Number.isFinite(minutes) || minutes <= 0) return;
        sleepTarget = Date.now() + minutes * 60000;
        ensureTicker();
        updateTimerUI();
      }

      function cancelAlarm() {
        alarmTarget = null;
        alarmNotice = '';
        releaseWakeLock();
        updateTimerUI();
        idleTickerIfDone();
      }

      for (const button of document.querySelectorAll('.sleep-preset')) {
        button.addEventListener('click', () => {
          startSleepTimer(parseInt(button.dataset.minutes, 10));
        });
      }

      document.getElementById('sleep-start').addEventListener('click', () => {
        startSleepTimer(parseInt(sleepCustom.value, 10));
      });

      document.getElementById('sleep-cancel').addEventListener('click', () => {
        sleepTarget = null;
        updateTimerUI();
        idleTickerIfDone();
      });

      document.getElementById('alarm-set').addEventListener('click', () => {
        const value = alarmTimeInput.value;
        if (!value) return;
        // arm() from this user gesture so start() can later succeed outside
        // one. Feature-detect: an older engine has no arm() — we still set
        // the timer and let start() try.
        if (typeof engine.arm === 'function') engine.arm();
        const [h, m] = value.split(':').map(Number);
        const target = new Date();
        target.setHours(h, m, 0, 0);
        if (target.getTime() <= Date.now()) target.setDate(target.getDate() + 1);
        alarmTarget = target.getTime();
        alarmNotice = '';
        acquireWakeLock();
        ensureTicker();
        updateTimerUI();
      });

      document.getElementById('alarm-cancel').addEventListener('click', cancelAlarm);

      // ---- lifecycle recovery (throttled tabs, bfcache, iOS interrupts) --

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState !== 'visible') return;
        // Timers may have been clamped while hidden — re-check immediately.
        if (sleepTarget !== null || alarmTarget !== null) tick();
        if (alarmTarget !== null) acquireWakeLock();
        if (engine.running) {
          // Recovers iOS 'interrupted' contexts once the engine ships
          // resume() — which can rebuildContext() (fresh analyser nodes)
          // without emitting a 'state' event, so re-evaluate any open
          // scope's live analyser once resume() settles.
          try {
            Promise.resolve(engine.resume?.()).then(updateAllScopeModes).catch(() => {});
          } catch {}
        }
      });

      window.addEventListener('focus', () => {
        if (engine.running) {
          try {
            Promise.resolve(engine.resume?.()).then(updateAllScopeModes).catch(() => {});
          } catch {}
        }
      });

      window.addEventListener('pagehide', () => {
        flushPersistSettings();
        try {
          engine.stop();
        } catch {}
      });

      window.addEventListener('pageshow', (event) => {
        // Restored from bfcache with the audio graph gone — show stopped UI.
        if (event.persisted) {
          finishing = false;
          setTransportUI();
        }
      });

      // ---- presets -------------------------------------------------------

      const presetName = document.getElementById('preset-name');
      const presetLoad = document.getElementById('preset-load');
      const presetSave = document.getElementById('preset-save');
      const presetDelete = document.getElementById('preset-delete');
      const presetSubmit = document.getElementById('preset-submit');
      const presetCopy = document.getElementById('preset-copy');

      let presets = [];
      try {
        const stored = prefs.get('presets');
        if (Array.isArray(stored)) presets = stored;
      } catch {}

      function paramsSnapshot() {
        const s = structuredClone(settings);
        delete s.ui;
        return s;
      }

      function persistPresets() {
        persistKey('presets', presets);
      }

      function refreshPresetSelect(selectedName) {
        presetLoad.innerHTML = '';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Load preset…';
        presetLoad.append(placeholder);
        presets.forEach((preset, index) => {
          const opt = document.createElement('option');
          opt.value = String(index);
          opt.textContent = preset.name;
          if (preset.name === selectedName) opt.selected = true;
          presetLoad.append(opt);
        });
      }

      presetSave.addEventListener('click', () => {
        const name = presetName.value.trim() || 'Untitled';
        const entry = { name, params: paramsSnapshot() };
        const existing = presets.findIndex((p) => p.name === name);
        if (existing >= 0) presets[existing] = entry;
        else presets.push(entry);
        persistPresets();
        refreshPresetSelect(name);
      });

      /**
       * Load a params snapshot (user preset or factory preset) as the live
       * settings. Same migration/normalisation order as the init load path: a
       * pre-v6 snapshot needs its arp mask mapped to a sequencer BEFORE the
       * deepMerge, and every lane needs padding to SEQ_SLOTS right after —
       * skipping either step leaves laneSteps()[i] undefined and throws
       * inside the un-awaited renderVoiceEditor triggered by syncUIFromSettings.
       */
      function loadParamsSnapshot(params) {
        const ui = settings.ui;
        const clone = structuredClone(params);
        migrateLegacyArpSteps(clone);
        settings = deepMerge(DEFAULTS, clone);
        normaliseV6Tracks(settings);
        settings.ui = ui;
        engine.setParams(engineParamsFrom(settings));
        syncUIFromSettings();
        applyDensityScale();
        persistSettings();
      }

      presetLoad.addEventListener('change', () => {
        const index = parseInt(presetLoad.value, 10);
        const preset = presets[index];
        if (!preset) return;
        loadParamsSnapshot(preset.params);
        presetName.value = preset.name;
      });

      // ---- factory preset gallery ----------------------------------------
      // A loaded factory preset is ordinary settings from that moment on:
      // every dial, track and editor behaves exactly as if the user had
      // dialled it in by hand.
      const factoryRow = document.getElementById('factory-preset-row');
      if (factoryRow) {
        for (const preset of FACTORY_PRESETS) {
          const card = document.createElement('button');
          card.type = 'button';
          card.className = 'secondary-button factory-preset';
          const name = document.createElement('span');
          name.className = 'factory-preset-name';
          name.textContent = preset.name;
          const blurb = document.createElement('span');
          blurb.className = 'factory-preset-blurb';
          blurb.textContent = preset.blurb;
          card.append(name, blurb);
          card.addEventListener('click', () => {
            loadParamsSnapshot(preset.params);
            presetName.value = preset.name;
          });
          factoryRow.append(card);
        }
      }

      presetDelete.addEventListener('click', () => {
        const index = parseInt(presetLoad.value, 10);
        if (!Number.isFinite(index) || !presets[index]) return;
        presets.splice(index, 1);
        persistPresets();
        refreshPresetSelect();
      });

      function presetJSON() {
        const name = presetName.value.trim() || 'Untitled';
        return JSON.stringify({ name, params: paramsSnapshot() }, null, 2);
      }

      presetSubmit.addEventListener('click', () => {
        const name = presetName.value.trim() || 'Untitled';
        const url =
          `${CONTACT_URL}?subject=${encodeURIComponent(`Ambi4 preset: ${name}`)}` +
          `&message=${encodeURIComponent(presetJSON())}`;
        window.open(url, '_blank', 'noopener');
      });

      presetCopy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(presetJSON());
          presetCopy.textContent = 'Copied';
        } catch {
          presetCopy.textContent = 'Copy failed';
        }
        setTimeout(() => {
          presetCopy.textContent = 'Copy JSON';
        }, 2000);
      });

      // ---- v13 tutorial panel (right-docked, stepped, no library) ---------
      // Each step names the control it is talking about; opening a step
      // switches to the tab that control lives on and rings it. Open state
      // and position persist through prefs like every other UI preference.
      const TUTORIAL_STEPS = [
        {
          tab: 'simple',
          target: '#toggle-play',
          text: 'Press Play. Sound starts within a second or so; the button becomes Finish, which ends the piece musically instead of cutting it off. Stop is the hard stop.',
        },
        {
          tab: 'simple',
          target: '.sliders-module',
          text: 'These five dials are the whole instrument for most people. Drag up and down, or click the number under a dial to type one. Double-click any dial to put it back to its default.',
        },
        {
          tab: 'simple',
          target: '#randomness-dial',
          text: 'Randomness at zero means hold: the generator keeps looping exactly what it is playing now. Turn it up and it re-rolls its material more and more often.',
        },
        {
          tab: 'advanced',
          target: '.track-rows',
          text: 'Six tracks, one line each. The coloured lamp beside the name cycles off, auto and on. The two dials are that track\'s level and its own randomness.',
        },
        {
          tab: 'advanced',
          target: '#voice-edit-toggle-percussion',
          text: 'Edit opens a track\'s panel: its step sequencer at the top, then the dials that build its sound. Drag sideways across sequencer cells to tie them into one long note.',
        },
        {
          tab: 'advanced',
          target: '.factory-presets',
          text: 'Factory presets are starting points, not presets in the locked sense — load one and change anything. Save your own just below.',
        },
        {
          tab: 'simple',
          target: '.processor-row',
          text: 'Processor decides how hard this runs. Auto watches the machine and backs off when it gets warm; Eco is the coolest setting.',
        },
      ];

      const tutorialPanel = document.getElementById('tutorial-panel');
      const tutorialToggle = document.getElementById('tutorial-toggle');
      const tutorialText = document.getElementById('tutorial-step-text');
      const tutorialProgress = document.getElementById('tutorial-progress');
      let tutorialHighlighted = null;

      function highlightTutorialTarget(selector) {
        if (tutorialHighlighted) tutorialHighlighted.classList.remove('tutorial-highlight');
        tutorialHighlighted = selector ? document.querySelector(selector) : null;
        if (tutorialHighlighted) tutorialHighlighted.classList.add('tutorial-highlight');
      }

      function renderTutorial() {
        const index = clamp(settings.ui.tutorialStep | 0, 0, TUTORIAL_STEPS.length - 1);
        settings.ui.tutorialStep = index;
        const step = TUTORIAL_STEPS[index];
        tutorialText.textContent = step.text;
        tutorialProgress.textContent = `${index + 1} / ${TUTORIAL_STEPS.length}`;
        document.getElementById('tutorial-prev').disabled = index === 0;
        document.getElementById('tutorial-next').disabled = index === TUTORIAL_STEPS.length - 1;
        if (step.tab) activateTab(step.tab);
        highlightTutorialTarget(step.target);
      }

      function setTutorialOpen(open) {
        settings.ui.tutorialOpen = open;
        tutorialPanel.hidden = !open;
        tutorialToggle.setAttribute('aria-expanded', String(open));
        if (open) renderTutorial();
        else highlightTutorialTarget(null);
        persistSettings();
      }

      tutorialToggle.addEventListener('click', () => setTutorialOpen(tutorialPanel.hidden));
      document.getElementById('tutorial-close').addEventListener('click', () => {
        setTutorialOpen(false);
        tutorialToggle.focus();
      });
      document.getElementById('tutorial-prev').addEventListener('click', () => {
        settings.ui.tutorialStep -= 1;
        renderTutorial();
        persistSettings();
      });
      document.getElementById('tutorial-next').addEventListener('click', () => {
        settings.ui.tutorialStep += 1;
        renderTutorial();
        persistSettings();
      });
      tutorialPanel.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        setTutorialOpen(false);
        tutorialToggle.focus();
      });

      // ---- initial sync ---------------------------------------------------

      function syncUIFromSettings() {
        bpmInput.value = String(settings.bpm);
        bpmTypable?.refresh();
        speedDial?.set(speedTFromBpm(settings.bpm));
        repetitionDial?.set(settings.repetition);
        volumeDial?.set(settings.volume);
        randomnessDial?.set(fusedRandomnessValue());
        swingDial?.set(settings.swing);
        rootSelect.value = settings.root;
        modeSelect.value = settings.mode;
        timeSignatureSelect.value = settings.timeSignature;
        syncStructureUI();
        syncArpUI();
        syncTrackStateUI();
        syncAllTrackExtras();
        for (const id of TRACK_IDS) {
          document.getElementById(`track-voice-${id}`).value = settings.tracks[id].voice;
          levelControls.get(id)?.set(settings.tracks[id].level);
          const editor = document.getElementById(`voice-editor-${id}`);
          if (!editor.hidden) renderVoiceEditor(id);
        }
        updateComplexityDisplay();
      }

      syncUIFromSettings();
      refreshPresetSelect();
      engine.setParams(engineParamsFrom(settings));
      activateTab(settings.ui.activeTab, { persist: false });
      applyDensityScale();
      setTransportUI();
      updateTimerUI();
      if (settings.ui.tutorialOpen) setTutorialOpen(true);

      app.hidden = false;
    }

    init().catch((err) => {
      // A dead init must never leave a blank page: show the fallback and say why.
      console.error('Ambi4 init failed:', err);
      const un = document.getElementById('generator-unavailable');
      if (un) {
        un.hidden = false;
        un.textContent = 'Something went wrong starting the generator (' + (err && err.message ? err.message : err) + '). Please hard-refresh; if it persists, this build is faulty.';
      }
    });
  </script>

