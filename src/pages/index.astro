---
import Base from '../layouts/Base.astro';
import { resolveFactoryPresets } from '../data/factory-presets-fallback.js';
import { getTracks } from '../scripts/ambient-engine.js';

// v16: the curated presets live in src/data/factory-presets.json when that file
// exists, and in the fallback module until it does — resolved at BUILD time so
// the gallery below and the /[slug] routes are always the same set. The list
// reaches the page script as a JSON payload element rather than a `define:vars`
// script, because define:vars forces an inline script and this page's one
// module script must stay bundled (dynamic imports, and the boot gate).
const FACTORY_PRESETS = resolveFactoryPresets();
const factoryPresetsJSON = JSON.stringify(FACTORY_PRESETS).replace(/</g, '\\u003c');

const modes: [string, string][] = [
  ['majorPentatonic', 'Major pentatonic'],
  ['minorPentatonic', 'Minor pentatonic'],
  ['dorian', 'Dorian'],
  ['lydian', 'Lydian'],
  ['aeolian', 'Aeolian'],
  ['wholeTone', 'Whole tone'],
];

const roots = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

const timeSignatures = ['3/4', '4/4', '5/4', '6/8', '7/8'];

const structures: [string, string][] = [
  ['auto', 'Auto'],
  ['drone', 'Drone'],
  ['waves', 'Waves'],
  ['build', 'Build'],
  ['abab', 'ABAB'],
  ['journey', 'Journey'],
  ['custom', 'Custom'],
];

// v21: the track rows are built from the ENGINE'S OWN registry, at BUILD time.
// ambient-engine.js is import-safe outside a browser (nothing touches Web Audio
// until createEngine() runs), so the frontmatter reads the module's static
// getTracks() export rather than standing up a live engine — the server render
// and the page script then agree on which tracks exist, their labels and their
// order without either holding a list of its own.
const TRACKS: [string, string][] = getTracks().map(
  (track) => [track.id, track.label] as [string, string]
);

// The four main dials. They render TWICE — once on Simple, once at the foot of
// Advanced — as two views of the same four values (page script mirrors them).
// [param id, label, low end-mark, mid end-mark, high end-mark]
const SIMPLE_DIALS: [string, string, string, string | null, string][] = [
  ['speed', 'Tempo', 'Slow', null, 'Fast'],
  ['complexity', 'Complexity', 'Calm', null, 'Complex'],
  ['randomness', 'Randomness', 'Repetitive', 'Evolving', 'Random'],
  ['volume', 'Volume', 'Quiet', null, 'Loud'],
];

// Hardcoded from the engine v2 contract's VOICES table. The UI never imports
// engine-voices.js into frontmatter — the voice implementations aren't
// relevant here, only the ids/labels the <select> options need. (The page
// script lazily dynamic-imports engine-voices.js for patch defaults only.)
const VOICES: Record<string, [string, string][]> = {
  pad: [
    ['warm', 'Warm'],
    ['glass', 'Glass'],
    ['strings', 'Strings'],
    ['choir', 'Choir'],
  ],
  bass: [
    ['sub', 'Sub'],
    ['round', 'Round'],
    ['breath', 'Breath'],
  ],
  melody: [
    ['pluck', 'Pluck'],
    ['bell', 'Bell'],
    ['flute', 'Flute'],
    ['keys', 'Keys'],
    ['call', 'Call'],
  ],
  texture: [
    ['sparkle', 'Sparkle'],
    ['grains', 'Grains'],
    ['chimes', 'Chimes'],
    ['wash', 'Wash'],
    ['colour', 'Coloured noise'],
    ['cloud', 'Grain cloud'],
    ['call', 'Call'],
  ],
  arp: [
    ['softPluck', 'Soft pluck'],
    ['crystal', 'Crystal'],
    ['marimba', 'Marimba'],
  ],
  percussion: [
    ['soft', 'Soft kit'],
    ['hand', 'Hand drum'],
    ['tick', 'Ticks'],
  ],
};
---
<Base title="Ambi4: Ambience for Work" description="An endless ambient music generator that runs entirely in your browser.">

  <div id="generator-app" hidden>
    <div class="module-panel transport-module">
      <div class="transport-head">
        <span class="panel-label transport-label" aria-hidden="true">Transport</span>
        <span class="panel-label processor-label" id="processor-label">Processor</span>
        <button
          type="button"
          id="tutorial-toggle"
          class="round-button"
          data-transport="tutorial"
          aria-label="Show the guided tour"
          aria-expanded="false"
          aria-controls="tutorial-panel"
        >?</button>
      </div>
      <div class="transport-main">
        <div class="transport-buttons">
          <button
            id="toggle-play"
            type="button"
            class="play-toggle"
            data-transport="play"
            aria-pressed="false"
          >
            <span class="transport-glyph play-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M7 4.5 19 12 7 19.5Z" /></svg>
            </span>
            <span class="play-toggle-label">Play</span>
            <span class="transport-glyph finish-glyph" aria-hidden="true" hidden>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><rect x="8" y="4" width="2" height="16" /><rect x="13" y="4" width="5" height="16" /></svg>
            </span>
          </button>
          <button id="pause-toggle" type="button" class="transport-button pause-button" data-transport="pause" aria-pressed="false" disabled>
            <span class="transport-glyph pause-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="7" y="5" width="4" height="14" rx="1" /><rect x="13" y="5" width="4" height="14" rx="1" /></svg>
            </span>
            <span class="transport-glyph resume-glyph" aria-hidden="true" hidden>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M7 4.5 19 12 7 19.5Z" /></svg>
            </span>
            <span class="pause-label">Pause</span>
          </button>
          <button id="stop-now" type="button" class="transport-button stop-button" data-transport="stop" disabled>
            <span class="transport-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="1" /></svg>
            </span>
            <span>Stop</span>
          </button>
          <button id="fast-forward" type="button" class="transport-button forward-button" data-transport="fastforward">
            <span class="transport-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M4 5.5 13 12 4 18.5Z" /><path d="M12 5.5 21 12 12 18.5Z" /></svg>
            </span>
            <span>Next</span>
          </button>
          <button id="record-toggle" type="button" class="transport-button record-button" data-transport="record" aria-pressed="false">
            <span class="transport-glyph record-dot" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><circle cx="12" cy="12" r="6" /></svg>
            </span>
            <span class="record-label">Record</span>
          </button>
        </div>
        <div class="transport-icons">
          <div class="popover-anchor">
            <button
              type="button"
              id="sleep-toggle"
              class="icon-button"
              data-transport="sleep"
              aria-label="Sleep timer"
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="sleep-popover"
            >
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3.5 2" />
              </svg>
            </button>
            <span id="sleep-chip" class="countdown-chip" aria-hidden="true" hidden></span>
            <div id="sleep-popover" class="popover module-panel" role="dialog" aria-labelledby="sleep-popover-title" hidden>
              <span class="panel-label popover-title" id="sleep-popover-title">Sleep timer</span>
              <div id="sleep-idle" class="timer-row">
                <button type="button" class="secondary-button sleep-preset" data-minutes="15">15 min</button>
                <button type="button" class="secondary-button sleep-preset" data-minutes="30">30 min</button>
                <button type="button" class="secondary-button sleep-preset" data-minutes="60">1 h</button>
                <button type="button" class="secondary-button sleep-preset" data-minutes="120">2 h</button>
                <span class="timer-custom">
                  <label for="sleep-custom" class="visually-hidden">Custom sleep timer minutes</label>
                  <input id="sleep-custom" type="number" min="1" max="720" inputmode="numeric" placeholder="min" />
                  <button type="button" id="sleep-start" class="secondary-button">Start</button>
                </span>
              </div>
              <div id="sleep-active" class="timer-row" hidden>
                <span id="sleep-countdown" class="timer-status"></span>
                <button type="button" id="sleep-cancel" class="link-button">Cancel</button>
              </div>
            </div>
          </div>
          <div class="popover-anchor">
            <button
              type="button"
              id="alarm-toggle"
              class="icon-button"
              data-transport="alarm"
              aria-label="Schedule start"
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="alarm-popover"
            >
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="13" r="8" />
                <path d="M12 9v4l2.5 2" />
                <path d="M5.2 3.2 2.8 5.4" />
                <path d="M18.8 3.2 21.2 5.4" />
              </svg>
            </button>
            <span id="alarm-chip" class="countdown-chip" aria-hidden="true" hidden></span>
            <div id="alarm-popover" class="popover module-panel" role="dialog" aria-labelledby="alarm-popover-title" hidden>
              <span class="panel-label popover-title" id="alarm-popover-title">Schedule start</span>
              <div id="alarm-idle" class="timer-row">
                <label for="alarm-time" class="visually-hidden">Alarm time</label>
                <input id="alarm-time" type="time" />
                <button type="button" id="alarm-set" class="secondary-button">Set alarm</button>
              </div>
              <div id="alarm-active" class="timer-row" hidden>
                <span id="alarm-countdown" class="timer-status"></span>
                <button type="button" id="alarm-cancel" class="link-button">Cancel</button>
              </div>
              <p class="hint">Only works while this tab stays open and the device is awake.</p>
            </div>
          </div>
        </div>
        <div class="processor-row">
          <div class="dial-slot dial-label-external" id="processor-dial"></div>
        </div>
      </div>

      <!-- v26 genre transport: the genre picker sits directly UNDER the
           Play/Finish button, because picking a genre is the second thing a
           listener does. Its list is built by the page script (the twelve
           genre files are a build-time glob import), and the favourites
           editor beside it is the same anchored-popover pattern the sleep and
           alarm dialogs use. -->
      <div class="genre-row popover-anchor">
        <label class="visually-hidden" for="genre-select">Genre</label>
        <select id="genre-select" class="genre-select"></select>
        <div
          id="genre-favourites"
          class="popover module-panel genre-favourites"
          role="dialog"
          aria-labelledby="genre-favourites-title"
          hidden
        >
          <span class="panel-label popover-title" id="genre-favourites-title">Favourite genres</span>
          <p class="hint">Tick the ones you come back to. Each mood you favourite also gets its own entry in the genre list.</p>
          <div id="genre-favourites-list" class="genre-fav-list"></div>
          <label class="genre-fav-hide">
            <input type="checkbox" id="genre-hide-others" />
            Hide the rest of the genres from the list
          </label>
          <div class="genre-fav-actions">
            <button type="button" id="genre-favourites-done" class="secondary-button">Done</button>
          </div>
        </div>
      </div>

      <div class="transport-row">
        <p id="transport-status" class="timer-status" role="status"></p>
        <span id="record-status" class="record-status" role="status"></span>
        <span id="processor-readout" class="value-readout processor-readout"></span>
      </div>

    </div>

    <p id="ios-silent-hint" class="hint" hidden>
      iPhone/iPad: if you hear nothing, check the silent switch.
    </p>

    <!-- v18: the oscilloscope and the piano roll are PERSISTENT — they sit
         above the tab strip, at the piano roll's own full width, and only the
         control surfaces below switch with Simple|Advanced. The module carries
         no title: the twisty at its top right is the only chrome, and the word
         "Oscilloscope" appears beside it just when the body is collapsed.
         v26: no faceplate either — the canvas is a bare display like the piano
         roll, and the whole chrome (note, legend, options, fullscreen, twisty)
         floats OVER its top edge rather than boxing it in. Collapsed, the
         overlay drops back into the flow so the word and twisty survive the
         display going away. -->
    <div class="scope-module" id="front-scope-module" hidden>
      <div class="scope-stage">
        <div id="front-scope-body" class="scope-body">
          <canvas id="front-scope" class="front-scope" aria-label="Live oscilloscope of the selected tracks"></canvas>
        </div>
        <div class="scope-overlay" id="front-scope-overlay">
          <span id="front-scope-note" class="value-readout scope-note"></span>
          <div id="front-scope-legend" class="scope-legend" role="group" aria-label="Tracks shown on the oscilloscope"></div>
          <div class="scope-controls">
            <button
              type="button"
              id="front-scope-spread"
              class="scope-option"
              aria-pressed="false"
              hidden
            >Spread</button>
            <button
              type="button"
              id="front-scope-total"
              class="scope-option scope-option-total"
              aria-pressed="false"
              hidden
            >Total</button>
            <button
              type="button"
              id="front-scope-fullscreen"
              class="stage-fs-button"
              aria-pressed="false"
              aria-label="Full screen oscilloscope"
            >&#9187;</button>
            <button
              type="button"
              id="front-scope-toggle"
              class="scope-collapse"
              aria-label="Oscilloscope"
              aria-expanded="true"
              aria-controls="front-scope-body"
            >
              <span class="scope-collapse-word" id="front-scope-word" aria-hidden="true" hidden>Oscilloscope</span>
              <span class="scope-twisty" aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="roll-stage" id="roll-stage">
      <canvas
        id="track-visualiser"
        aria-label="Live visualisation of each track's activity"
      ></canvas>
      <div class="roll-overlay">
        <button
          type="button"
          id="roll-fullscreen"
          class="stage-fs-button"
          aria-pressed="false"
          aria-label="Full screen piano roll"
        >&#9187;</button>
      </div>
    </div>

    <div id="consent-slot"></div>

    <p id="share-note" class="hint share-note" hidden></p>

    <div class="tabs" role="tablist" aria-label="Generator controls">
      <button type="button" role="tab" id="tab-simple" aria-selected="true" aria-controls="panel-simple">Simple</button>
      <button type="button" role="tab" id="tab-advanced" aria-selected="false" aria-controls="panel-advanced" tabindex="-1">Advanced</button>
    </div>

    <section id="panel-simple" role="tabpanel" aria-labelledby="tab-simple" tabindex="0">
      <div class="module-panel sliders-module">
        {SIMPLE_DIALS.map(([id, label, lowMark, midMark, highMark]) => (
          <div class="control simple-dial" id={`dial-${id}`}>
            <div class="control-label-row">
              <label for={id} class="panel-label">{label}</label>
            </div>
            <div class="dial-slot" id={`${id}-dial`}>
              {midMark && <span class="dial-mid" aria-hidden="true">{midMark}</span>}
              <span class="dial-ends" aria-hidden="true">
                <span class="dial-end dial-end-low">{lowMark}</span>
                <span class="dial-end dial-end-high">{highMark}</span>
              </span>
            </div>
          </div>
        ))}
      </div>

      <div class="module-panel factory-presets" id="factory-presets">
        <span class="panel-label">Factory presets</span>
        <div id="factory-preset-row" class="factory-preset-row"></div>
        <p class="hint">Load one and change anything you like &mdash; nothing is locked.</p>
      </div>
    </section>

    <section id="panel-advanced" role="tabpanel" aria-labelledby="tab-advanced" tabindex="0" hidden>
      <div class="tracks-section module-panel">
        <h2 class="tracks-heading panel-label">Tracks</h2>
        <div class="track-rows">
          {TRACKS.map(([id, label]) => (
            <div class={`track-item track-color-${id}`}>
              <div class="track-row" data-track={id}>
                <button
                  type="button"
                  class="track-name track-lamp"
                  id={`track-lamp-${id}`}
                  aria-label={`${label} state. Press to cycle Off, Auto, On.`}
                >
                  <span class="track-chip lamp-dot" aria-hidden="true"></span>
                  <span class="lamp-text">{label}</span>
                </button>
                <select id={`track-voice-${id}`} class="track-voice" aria-label={`${label} voice`}>
                  {VOICES[id].map(([value, voiceLabel]) => <option value={value}>{voiceLabel}</option>)}
                </select>
                <div class="track-level" id={`track-level-${id}`}></div>
                <div class="track-extras" id={`track-extras-${id}`}></div>
                <button
                  type="button"
                  class="secondary-button voice-edit-toggle"
                  id={`voice-edit-toggle-${id}`}
                  aria-expanded="false"
                  aria-controls={`voice-editor-${id}`}
                >Edit</button>
                <span class="track-foot">
                  <span class="resolved-readout" id={`resolved-${id}`} aria-hidden="true"></span>
                  <span class="cost-meter" id={`cost-meter-${id}`} hidden>
                    <span class="cost-meter-fill"></span>
                  </span>
                </span>
              </div>
              <div class="voice-editor module-panel" id={`voice-editor-${id}`} hidden></div>
            </div>
          ))}
        </div>
      </div>

      <!-- v26 layout rule: dials pack HORIZONTALLY. The four main dials and
           Repetition / Swing / Reverb tail are one wrapping row of identically
           sized cells, not seven controls on seven lines. Hidden members drop
           out of the grid, so an engine without swing or reverb tail simply
           gives a shorter row. -->
      <div class="module-panel sliders-module" id="advanced-dials">
        <span class="panel-label">Main dials</span>
        <div class="advanced-dial-row">
          {SIMPLE_DIALS.map(([id, label, lowMark, midMark, highMark]) => (
            <div class="control simple-dial" id={`dial-${id}-adv`}>
              <div class="control-label-row">
                <label for={`${id}-adv`} class="panel-label">{label}</label>
              </div>
              <div class="dial-slot" id={`${id}-dial-adv`}>
                {midMark && <span class="dial-mid" aria-hidden="true">{midMark}</span>}
                <span class="dial-ends" aria-hidden="true">
                  <span class="dial-end dial-end-low">{lowMark}</span>
                  <span class="dial-end dial-end-high">{highMark}</span>
                </span>
              </div>
            </div>
          ))}

          <div class="control simple-dial" id="dial-repetition">
            <div class="control-label-row">
              <label for="repetition" class="panel-label">Repetition</label>
            </div>
            <div class="dial-slot" id="repetition-dial">
              <span class="dial-mid" aria-hidden="true">Evolving</span>
              <span class="dial-ends" aria-hidden="true">
                <span class="dial-end dial-end-low">Random</span>
                <span class="dial-end dial-end-high">Repetitive</span>
              </span>
            </div>
          </div>

          <div class="control simple-dial" id="dial-swing" hidden>
            <div class="control-label-row">
              <label for="swing" class="panel-label">Swing</label>
            </div>
            <div class="dial-slot" id="swing-dial">
              <span class="dial-ends" aria-hidden="true">
                <span class="dial-end dial-end-low">Straight</span>
                <span class="dial-end dial-end-high">Swung</span>
              </span>
            </div>
          </div>

          <div class="control simple-dial" id="dial-reverb-tail" hidden>
            <div class="control-label-row">
              <label for="reverbTail" class="panel-label">Reverb tail</label>
            </div>
            <div class="dial-slot" id="reverb-tail-dial">
              <span class="dial-ends" aria-hidden="true">
                <span class="dial-end dial-end-low">Room</span>
                <span class="dial-end dial-end-high">Cathedral</span>
              </span>
            </div>
          </div>
        </div>
        <p class="hint">Tempo, Complexity, Randomness and Volume are the same four values as the Simple tab &mdash; two views, one setting.</p>
      </div>

      <div class="control">
        <label for="root">Root</label>
        <select id="root">
          {roots.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>

      <div class="control">
        <label for="mode">Scale</label>
        <select id="mode">
          {modes.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </div>

      <div class="control">
        <label for="timeSignature">Time signature</label>
        <select id="timeSignature">
          {timeSignatures.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>

      <div class="control">
        <div class="control-label-row">
          <label for="bpm">BPM</label>
          <span class="value-readout bpm-readout" id="bpm-readout"><output for="bpm" id="bpm-value">60</output></span>
        </div>
        <input type="range" id="bpm" min="20" max="220" step="1" value="60" />
      </div>

      <div class="control">
        <label for="structure">Structure</label>
        <select id="structure">
          {structures.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </div>

      <div class="control" id="control-chord-length" hidden>
        <label for="chordLength">Chord length</label>
        <select id="chordLength">
          <option value="auto">Auto</option>
          <option value="1">1 bar</option>
          <option value="2">2 bars</option>
          <option value="4">4 bars</option>
          <option value="8">8 bars</option>
        </select>
      </div>

      <div id="custom-structure-builder" class="custom-structure module-panel" hidden>
        <span class="panel-label">Structure blocks</span>
        <div id="structure-blocks" class="structure-blocks"></div>
        <button type="button" id="add-structure-block" class="secondary-button">Add block</button>
        <p class="hint">Loops forever, in order. Up to 8 blocks.</p>
      </div>

      <p class="hint factory-presets-link">
        Factory presets moved to the Simple tab &mdash;
        <button type="button" id="factory-presets-jump" class="link-button">show them</button>.
      </p>

      <fieldset class="presets-group">
        <legend>Your presets</legend>
        <div class="preset-row">
          <button type="button" id="blank-slate" class="secondary-button">Blank slate</button>
        </div>
        <div class="preset-row">
          <label for="preset-name" class="visually-hidden">Preset name</label>
          <input id="preset-name" type="text" placeholder="Preset name" />
          <button type="button" id="preset-save" class="secondary-button">Save</button>
        </div>
        <div class="preset-row">
          <label for="preset-load" class="visually-hidden">Load preset</label>
          <select id="preset-load">
            <option value="">Load preset&hellip;</option>
          </select>
          <button type="button" id="preset-delete" class="secondary-button">Delete</button>
        </div>
        <div class="preset-row">
          <button type="button" id="preset-share" class="secondary-button">Share</button>
          <button type="button" id="preset-submit" class="secondary-button">Submit preset</button>
          <button type="button" id="preset-copy" class="secondary-button">Copy JSON</button>
        </div>
        <p class="hint">Submitting opens our contact form prefilled with the preset; if that doesn&rsquo;t load, copy the JSON and send it however suits.</p>
      </fieldset>

    </section>
  </div>

  <aside id="tutorial-panel" class="tutorial-panel module-panel" aria-labelledby="tutorial-title" hidden>
    <div class="tutorial-head">
      <span class="panel-label" id="tutorial-title">Guided tour</span>
      <button type="button" id="tutorial-close" class="round-button" aria-label="Close the guided tour">&times;</button>
    </div>
    <p id="tutorial-step-text" class="tutorial-step-text"></p>
    <div class="tutorial-nav">
      <button type="button" id="tutorial-prev" class="secondary-button">Back</button>
      <span id="tutorial-progress" class="value-readout"></span>
      <button type="button" id="tutorial-next" class="secondary-button">Next</button>
    </div>
  </aside>

  <!-- v26 fullscreen host. The oscilloscope and the piano roll are MOVED in
       here (and back out on exit) rather than duplicated, so each keeps its
       canvas bitmap, its listeners and its module handle; the modules resize
       themselves off their own ResizeObserver. -->
  <div id="fullscreen-stage" class="fullscreen-stage" hidden>
    <div class="fullscreen-bar">
      <button type="button" id="fullscreen-add" class="secondary-button fullscreen-add" hidden></button>
      <button type="button" id="fullscreen-exit" class="secondary-button" aria-label="Leave full screen">Exit (Esc)</button>
    </div>
    <div id="fullscreen-slots" class="fullscreen-slots"></div>
  </div>

  <p id="generator-unavailable" hidden>
    Sorry &mdash; this browser can&rsquo;t run the generator (Web Audio isn&rsquo;t
    available, or the audio engine failed to load). Try a recent version of
    Chrome, Firefox, Safari or Edge.
  </p>

  <script id="factory-presets-data" type="application/json" is:inline set:html={factoryPresetsJSON}></script>

  <script>
    const app = document.getElementById('generator-app');
    const unavailable = document.getElementById('generator-unavailable');

    // ONE place for the preset-submission target (the domain may not exist
    // yet — the copy-JSON path is the reliable one).
    const CONTACT_URL = 'https://contact.andeye.com/';

    const LEGACY_STORAGE_KEY = 'ambi4-generator-settings-v2';

    /**
     * v21: THE TRACK LISTS ARE THE ENGINE'S, not the page's. Every list below
     * is a view over one registry — engine.getTracks() where the engine
     * publishes one, and this table where it does not. The literals are the
     * registry as it stood when this page was built, kept for exactly the
     * reason every other engineCaps probe has a fallback: an older engine
     * bundle must still boot, on the six tracks the page has always had.
     *
     * `sequenced` is the one field getTracks()'s public view doesn't carry
     * (it publishes identity and presentation only), so the fallback keeps
     * the engine's own ordering index: a NUMBER is that track's place in the
     * sequenced set, null means sustained, no step grid.
     */
    const FALLBACK_TRACKS = [
      { id: 'pad', label: 'Pad', family: 'melodic', sequenced: null },
      { id: 'arp', label: 'Arp', family: 'melodic', sequenced: 2 },
      { id: 'melody', label: 'Melody', family: 'melodic', sequenced: 0 },
      { id: 'bass', label: 'Bass', family: 'melodic', sequenced: 1 },
      { id: 'texture', label: 'Texture', family: 'melodic', sequenced: null },
      { id: 'percussion', label: 'Percussion', family: 'percussive', sequenced: 3 },
    ];

    /**
     * The five views the whole page builds from, derived from one track list.
     * `tracks` is either getTracks()'s public view or FALLBACK_TRACKS; the
     * engine's TUNED_TRACKS / SEQUENCED_TRACKS exports are taken where the
     * bundle has them, and where it doesn't the built-in semantics stand in:
     * a melodic track sounds a pitch (so it takes a Dissonance dial and a
     * Density dial), a percussive one is a kit, and the sequenced set keeps
     * the fallback table's order — load-bearing, since the engine draws one
     * rng() per sequenced track in exactly that order.
     */
    function trackListsFrom(tracks, engineExports = {}) {
      const ids = tracks.map((track) => track.id);
      const has = (id) => ids.includes(id);
      const familyOf = new Map(tracks.map((track) => [track.id, track.family]));
      const labelOf = new Map(FALLBACK_TRACKS.map((track) => [track.id, track.label]));
      const isMelodic = (id) => familyOf.get(id) === 'melodic';
      const exported = (list) => (Array.isArray(list) ? list.filter(has) : null);
      const sequenced =
        exported(engineExports.SEQUENCED_TRACKS) ||
        FALLBACK_TRACKS.filter((track) => track.sequenced !== null)
          .sort((a, b) => a.sequenced - b.sequenced)
          .map((track) => track.id)
          .filter(has);
      return {
        TRACK_IDS: ids,
        TRACK_LABELS: Object.fromEntries(
          tracks.map((track) => [track.id, track.label || labelOf.get(track.id) || track.id])
        ),
        // Tuned tracks take a Dissonance dial (v14); percussion has no chord
        // to stray from.
        TUNED_TRACKS: exported(engineExports.TUNED_TRACKS) || ids.filter(isMelodic),
        SEQ_TRACKS: sequenced,
        // The single-lane sequencers: percussion's grid is a kit of lanes.
        SEQ_SINGLE_TRACKS: sequenced.filter(isMelodic),
      };
    }

    // Seeded from the fallback so nothing depends on init() having run, then
    // re-derived from the engine's registry inside init (see engineCaps).
    let { TRACK_IDS, TRACK_LABELS, TUNED_TRACKS, SEQ_TRACKS, SEQ_SINGLE_TRACKS } =
      trackListsFrom(FALLBACK_TRACKS);

    // Voice ids → display names, mirroring the frontmatter's <option> labels
    // (the page never imports engine-voices.js just for names).
    const VOICE_LABELS = {
      pad: { warm: 'Warm', glass: 'Glass', strings: 'Strings', choir: 'Choir' },
      arp: { softPluck: 'Soft pluck', crystal: 'Crystal', marimba: 'Marimba' },
      melody: { pluck: 'Pluck', bell: 'Bell', flute: 'Flute', keys: 'Keys', call: 'Call' },
      bass: { sub: 'Sub', round: 'Round', breath: 'Breath' },
      texture: {
        sparkle: 'Sparkle',
        grains: 'Grains',
        chimes: 'Chimes',
        wash: 'Wash',
        colour: 'Coloured noise',
        cloud: 'Grain cloud',
        call: 'Call',
      },
      percussion: { soft: 'Soft kit', hand: 'Hand drum', tick: 'Ticks' },
    };

    // Transport controls hidden on the Simple tab. Deliberately EMPTY for this
    // build (every button ships visible on both tabs); adding e.g. 'record'
    // here is the whole change needed to demote a button to Advanced-only.
    const SIMPLE_HIDDEN = new Set([]);

    // ---- pre-launch: paid features are hidden, not teased ------------------
    // Nothing greyed, nothing captioned "coming soon" — an affordance the
    // visitor cannot use is simply not rendered. Every code path behind these
    // stays intact and dormant (MediaRecorder wiring, the sequencer's JS-editor
    // entry), so launch is this one flag going false.
    // Every paid-tier feature stays invisible until its tier can be bought
// (owner rule: never give-then-take). Dev unlock for the owner only:
// localStorage.setItem('ambi4:dev','1') then refresh.
const DEV_UNLOCK = (() => { try { return localStorage.getItem('ambi4:dev') === '1'; } catch { return false; } })();
const PAID_FEATURES_HIDDEN = !DEV_UNLOCK;

    // Hidden on BOTH tabs while PAID_FEATURES_HIDDEN — by data-transport id,
    // the same handle SIMPLE_HIDDEN uses.
    const HIDDEN_UNTIL_LAUNCH = new Set(['record']);

    // ---- v6 step sequencers (shared shape) ------------------------------
    // Steps-per-bar by metre; all 20 slots persist, the first N render/play.
    const STEPS_PER_BAR = { '3/4': 12, '4/4': 16, '5/4': 20, '6/8': 12, '7/8': 14 };
    const SEQ_SLOTS = 20;
    const SEQ_MAX = 8; // sequencers per track (Markov chain size ceiling)
    // SEQ_TRACKS / SEQ_SINGLE_TRACKS are registry views — see trackListsFrom.
    // v21 per-step gate: the fraction of its step a note is held for. 1 fills
    // the step exactly; above that it runs into the next one (legato).
    const SEQ_GATE_MIN = 0.1;
    const SEQ_GATE_MAX = 2;
    const SEQ_GATE_DEFAULT = 0.9;
    const SEQ_GATE_NUDGE = 0.05;
    // v21 per-track density: 1 is the complexity-derived rate, 2 twice it.
    const TRACK_DENSITY_MAX = 2;
    // v21 chord length (harmony.rhythm): 'auto' lets the hook pick, the rest
    // are a fixed bars-per-chord count.
    const CHORD_LENGTHS = ['auto', 1, 2, 4, 8];
    // Probability-group dot colours (v13/v14): group id → hue. Deliberately
    // distinct from the six track accents so a group never reads as a track.
    const GROUP_COLOURS = ['#d98324', '#3f8f6d', '#8a5cd6', '#c2456b', '#3f7fbf', '#9a8f2e'];
    // v14/v21: lanes render HIGH at the top, LOW at the bottom — the way a
    // drum grid is read everywhere else. The step object is KEYED by lane id,
    // so this list is what gives the lanes their order, their display names
    // and (v21) their voice-kind mapping. The three built-ins keep the ids the
    // engine has always used, so every stored pattern and every `perKind`
    // override still lands on the lane it was written for.
    const PERC_LANE_KINDS = [
      ['high', 'High'],
      ['mid', 'Mid'],
      ['low', 'Low'],
    ];
    const PERC_BUILTIN_LANES = ['high', 'mid', 'low'];
    const PERC_MAX_LANES = 8; // v21 cap
    const PERC_NEW_LANE_KIND = 'mid';

    function defaultPercLanes() {
      return PERC_LANE_KINDS.map(([id, label]) => ({ id, label, kind: id }));
    }

    /** Top-down rank: high lanes sort above mid, mid above low. */
    function laneKindRank(kind) {
      const index = PERC_LANE_KINDS.findIndex(([id]) => id === kind);
      return index === -1 ? PERC_LANE_KINDS.length : index;
    }

    /**
     * Where a lane of `kind` belongs in a top-down list: at the foot of its own
     * kind's group, which is what keeps HIGH kinds at the top however many
     * lanes a kit grows. The user may reorder freely afterwards — this only
     * decides where a NEW lane lands.
     */
    function laneInsertIndex(lanes, kind) {
      const rank = laneKindRank(kind);
      let index = 0;
      for (let i = 0; i < lanes.length; i++) {
        if (laneKindRank(lanes[i].kind) <= rank) index = i + 1;
      }
      return index;
    }

    function nextLaneId(lanes) {
      const taken = new Set(lanes.map((lane) => lane.id));
      for (let n = lanes.length + 1; ; n++) {
        const id = `lane${n}`;
        if (!taken.has(id)) return id;
      }
    }

    /**
     * Repair a stored lane list: known kinds, unique non-empty ids, a label
     * each, the cap enforced — and the three built-ins always present (they
     * are undeletable, so a save that lost one gets it back in its kind slot).
     * A built-in's kind is its id by definition (the lane called 'low' IS the
     * low voice), matching the engine's own sanitiser; only its NAME and its
     * place in the list are the user's.
     *
     * The engine numbers lanes with an `order` field and sorts by it; this
     * page uses array order (top-down, as rendered) and lets the engine derive
     * `order` from it. A list that arrived FROM the engine — a preset, a share
     * link — carries the field, so it is sorted by before being dropped.
     */
    function normalisePercLanes(raw) {
      const source = Array.isArray(raw) ? raw.filter(isPlainObject) : [];
      if (source.length && source.every((entry) => Number.isFinite(entry.order))) {
        source.sort((a, b) => a.order - b.order);
      }
      const lanes = [];
      const seen = new Set();
      for (const entry of source) {
        if (lanes.length >= PERC_MAX_LANES) break;
        const id = typeof entry.id === 'string' ? entry.id.trim().slice(0, 32) : '';
        if (!id || seen.has(id)) continue;
        const kind = PERC_BUILTIN_LANES.includes(id)
          ? id
          : PERC_LANE_KINDS.some(([k]) => k === entry.kind)
            ? entry.kind
            : PERC_NEW_LANE_KIND;
        const label =
          typeof entry.label === 'string' && entry.label.trim()
            ? entry.label.trim().slice(0, 32)
            : id;
        seen.add(id);
        lanes.push({ id, label, kind });
      }
      for (const [id, label] of PERC_LANE_KINDS) {
        if (seen.has(id)) continue;
        lanes.splice(laneInsertIndex(lanes, id), 0, { id, label, kind: id });
      }
      return lanes.slice(0, PERC_MAX_LANES);
    }

    /** A track's lane list, top-down; melodic tracks have exactly one. */
    function laneListFor(track, t) {
      if (track !== 'percussion') return [{ key: null, label: null, kind: null }];
      const lanes = Array.isArray(t && t.lanes) ? t.lanes : defaultPercLanes();
      return lanes.map((lane) => ({ key: lane.id, label: lane.label, kind: lane.kind }));
    }
    const VARY_KEYS = [
      ['voice', 'Voice'],
      ['volume', 'Volume'],
      ['pitch', 'Pitch'],
      ['timing', 'Timing'],
      ['pan', 'Pan'],
    ];

    // Melodic lanes default all-on (gates nothing out); percussion lanes get
    // a sparse, musical starting pattern for the first flip to Manual.
    const SEQ_LANE_DEFAULT_ON = {
      melody: () => true,
      bass: () => true,
      arp: () => true,
      low: (i) => i % 4 === 0,
      mid: (i) => i % 8 === 4,
      high: (i) => i % 2 === 0,
    };

    function defaultLane(kind) {
      const on = SEQ_LANE_DEFAULT_ON[kind] || (() => true);
      return Array.from({ length: SEQ_SLOTS }, (_, i) => ({
        on: !!on(i),
        prob: 1,
        vmin: 0.5,
        vmax: 0.9,
      }));
    }

    function defaultVary() {
      // null = "follow this track's randomness" (the Auto detent).
      return { voice: null, volume: null, pitch: null, timing: null, pan: null };
    }

    /**
     * v21 per-track feel. `swing` (pulsed tracks) overrides the global groove
     * for this track alone; `density` (tuned tracks) scales its event rate on
     * top of complexity. null is the Auto detent on both — "follow the global
     * swing" / "let complexity decide" — which is why they default to null
     * rather than to a number that would freeze the engine's own choice.
     */
    function defaultFeel(track) {
      return {
        ...(SEQ_TRACKS.includes(track) ? { swing: null } : {}),
        ...(TUNED_TRACKS.includes(track) ? { density: null } : {}),
      };
    }

    // v14 Sequencer 2.0: a track owns a LIST of sequencers and picks between
    // them at each loop end (Markov transition weights). `sequencer` stays as
    // an alias of sequencers[0] so a pre-v14 engine still sees the one it
    // knows about.
    function defaultSequencer(track) {
      const steps =
        track === 'percussion'
          ? Object.fromEntries(defaultPercLanes().map((lane) => [lane.id, defaultLane(lane.kind)]))
          : defaultLane(track);
      return { mode: 'auto', weights: [1], steps };
    }

    // DEFAULTS carry only the SINGULAR sequencer: deepMerge keeps keys that
    // exist solely in the saved object, so a stored `sequencers` list
    // survives a merge, while a default-shaped list here would shadow (and
    // silently discard) a pre-v14 save's singular sequencer.
    // normaliseSequencerList() builds the list from whichever is present.
    function withSequencers(track) {
      return { sequencer: defaultSequencer(track) };
    }

    /**
     * v9/v14/v16 factory presets: curated starting points, composed across the
     * whole param space (tempo, key/mode, metre, structure, swing, which
     * tracks play and with what voice/level/randomness/dissonance). Each is a
     * PARTIAL params object — deepMerge fills the rest from DEFAULTS — and
     * loading one is an ordinary settings load, so everything stays editable
     * afterwards. Nothing here is locked or re-applied behind the user.
     *
     * v16: the set itself is resolved at BUILD time (src/data/factory-presets
     * .json, or the fallback module until it lands) and handed to the page in
     * the #factory-presets-data JSON payload — the same list src/pages/
     * [preset].astro built its routes from, so /[slug] can never name a preset
     * this gallery doesn't have. { slug, name, oneLiner, rationale, params }.
     */
    function readFactoryPresets() {
      try {
        const el = document.getElementById('factory-presets-data');
        const parsed = el ? JSON.parse(el.textContent) : null;
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    const FACTORY_PRESETS = readFactoryPresets();

    function factoryPresetBySlug(slug) {
      return FACTORY_PRESETS.find((preset) => preset.slug === slug) || null;
    }

    // ---- v26 genre transport ---------------------------------------------

    /**
     * The twelve genre files, resolved at BUILD time — Vite expands the glob,
     * so the data is in the page bundle: there is no fetch to fail, and the
     * list the dropdown shows is by construction the list `setGenreTable()`
     * registers with the engine.
     *
     * A genre is RULES, not a preset: `compileGenre(genre, { rng })` draws one
     * setup out of it (metre, mode, tempo, swing, chord grammar, kit, voices),
     * so the same genre twice is two different pieces. That is what the
     * fast-forward button spends, and what the fresh-load pick uses to stop
     * every first visit sounding identical.
     */
    const GENRES = Object.values(
      import.meta.glob('../data/genres/*.json', { eager: true, import: 'default' })
    )
      .filter((genre) => genre && typeof genre.slug === 'string')
      .sort((a, b) => String(a.name).localeCompare(String(b.name)));

    const GENRE_BY_SLUG = new Map(GENRES.map((genre) => [genre.slug, genre]));

    /**
     * Favourites group by MOOD, and the genre files' own `cluster` — the three
     * groups the music director wrote to — is the only grouping the data
     * carries. The LABELS are a UI decision, so they live here rather than in
     * the files; a cluster with no entry falls into "Other" instead of
     * vanishing from the list.
     */
    const MOODS = [
      { id: 'calm', label: 'Calm', cluster: 1 },
      { id: 'groove', label: 'Groove', cluster: 2 },
      { id: 'drive', label: 'Drive', cluster: 3 },
    ];
    const OTHER_MOOD = { id: 'other', label: 'Other', cluster: null };

    function moodOf(genre) {
      return MOODS.find((mood) => mood.cluster === genre.cluster) || OTHER_MOOD;
    }

    /**
     * The genres a FRESH visit may open on, and the weight a favourite carries
     * inside that pool. Not every genre is a good thing to arrive to unasked —
     * peak-time techno and a neon synthwave chase are choices, not defaults —
     * so the opening draw is made from the work-music end of the set. A
     * favourite that is also in this pool is drawn ten times as often as a
     * genre the listener has never marked.
     */
    const BACKGROUND_GENRES = [
      'ambient',
      'cinematic',
      'downtempo',
      'lofi-beats',
      'minimalism',
      'new-age',
    ];
    const FAVOURITE_WEIGHT = 10;

    /**
     * mulberry32: the compiler takes an `rng`, and a seed the page holds is
     * what makes one setup reproducible — fast-forward is nothing more than
     * the same genre with the next seed.
     */
    function makeRng(seed) {
      let a = seed >>> 0;
      return function rng() {
        a = (a + 0x6d2b79f5) >>> 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function randomSeed() {
      return Math.floor(Math.random() * 0x100000000) >>> 0;
    }

    /** One weighted draw from a [{ value, weight }] pool; null when it's empty. */
    function weightedDraw(pool) {
      const total = pool.reduce((sum, entry) => sum + entry.weight, 0);
      if (!(total > 0)) return null;
      let roll = Math.random() * total;
      for (const entry of pool) {
        roll -= entry.weight;
        if (roll <= 0) return entry.value;
      }
      return pool[pool.length - 1].value;
    }

    // v12 mono/legato, mirroring the engine's own DEFAULT_TRACK_MONO/GLIDE:
    // the two melodic lines sound one note at a time and slur between them, a
    // chord and a kit do not. Held in settings so the pair is preset-captured
    // and persists — the engine would otherwise re-assert its defaults on a
    // reload and quietly undo the user's choice.
    const MONO_DEFAULTS = {
      pad: { mono: false, glide: 0 },
      arp: { mono: false, glide: 0 },
      melody: { mono: true, glide: 0.3 },
      bass: { mono: true, glide: 0.15 },
      texture: { mono: false, glide: 0 },
      percussion: { mono: false, glide: 0 },
    };

    const DEFAULTS = {
      swing: 0,
      complexity: 0.5,
      repetition: 0.5,
      volume: 0.8,
      root: 'C',
      mode: 'majorPentatonic',
      timeSignature: '4/4',
      bpm: 60,
      structure: 'auto',
      customStructure: [
        { label: 'A', bars: 8, intensity: 0.4 },
        { label: 'B', bars: 8, intensity: 0.7 },
      ],
      // v21 chord length: how many bars the hook holds a chord for. 'auto'
      // needs no engine-read shipped value (unlike reverbTail) — it's the
      // contract's own documented default, so it's safe to bake in here.
      harmony: { rhythm: 'auto' },
      arp: {
        mode: 'auto',
        pattern: 'up',
        rate: '1/8',
        octaves: 2,
        gate: 0.6,
        steps: new Array(16).fill(true),
      },
      tracks: {
        pad: {
          state: 'auto',
          voice: 'warm',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('pad'),
          ...MONO_DEFAULTS.pad,
        },
        arp: {
          state: 'auto',
          voice: 'softPluck',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('arp'),
          ...MONO_DEFAULTS.arp,
          ...withSequencers('arp'),
        },
        // v14 user verdict: melody joins the default mix ('auto'); bass stays
        // OFF until the groove rework passes the listener's own gate.
        melody: {
          state: 'auto',
          voice: 'pluck',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('melody'),
          ...MONO_DEFAULTS.melody,
          ...withSequencers('melody'),
        },
        bass: {
          state: 'off',
          voice: 'sub',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('bass'),
          ...MONO_DEFAULTS.bass,
          ...withSequencers('bass'),
        },
        texture: {
          state: 'auto',
          voice: 'sparkle',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('texture'),
          ...MONO_DEFAULTS.texture,
        },
        percussion: {
          state: 'auto',
          voice: 'soft',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          vary: defaultVary(),
          ...defaultFeel('percussion'),
          lanes: defaultPercLanes(),
          ...MONO_DEFAULTS.percussion,
          ...withSequencers('percussion'),
        },
      },
      patches: {},
      // `ui` is page-only state: stripped before anything reaches the engine
      // (engineParamsFrom) or a preset snapshot (paramsSnapshot).
      // scopeTracks null = "whichever tracks aren't off" (the live default);
      // an array is an explicit chip selection the user made.
      ui: {
        activeTab: 'simple',
        processor: 'auto',
        tutorialOpen: false,
        tutorialStep: 0,
        scopeOpen: true,
        scopeTracks: null,
        // v26 scope options; both only take effect where the scope module
        // and (for the total trace) the engine can honour them.
        scopeSpread: false,
        scopeTotal: false,
      },
    };

    // The v3 Patch schema's sections, in editor order. Anything else on a
    // patch object (v14 `perKind`) is state, not an editable section.
    const PATCH_SECTIONS = ['source', 'filter', 'adsr', 'sends'];

    // Used only when a voice doesn't export .defaults (older engine-voices).
    const FALLBACK_PATCH = {
      source: { osc1: 'sine', osc2: null, mix: 0.5, detune: 4, octave: 0 },
      filter: { type: 'lowpass', cutoff: 2000, q: 0.7, envAmount: 0.3 },
      adsr: { attack: 0.01, decay: 0.2, sustain: 0.7, release: 0.5 },
      sends: { reverb: 0.3, delay: 0.15 },
    };

    function isPlainObject(value) {
      return value !== null && typeof value === 'object' && !Array.isArray(value);
    }

    /**
     * Deep-merge `saved` over `defaults`; arrays are replaced wholesale.
     * Keys present only in `saved` are kept (needed for the sparse `patches`
     * map, whose keys aren't in DEFAULTS).
     */
    function deepMerge(defaults, saved) {
      if (Array.isArray(defaults)) {
        return Array.isArray(saved) ? saved : defaults;
      }
      if (isPlainObject(defaults)) {
        if (!isPlainObject(saved)) return structuredClone(defaults);
        const out = {};
        for (const key of Object.keys(defaults)) {
          out[key] = deepMerge(defaults[key], saved[key]);
        }
        for (const key of Object.keys(saved)) {
          if (!(key in out)) out[key] = structuredClone(saved[key]);
        }
        return out;
      }
      return saved === undefined ? defaults : saved;
    }

    // ---- v7 RangeValue (number | {min,max}) helpers ----------------------

    function isNumberOrRange(v) {
      return (
        (typeof v === 'number' && Number.isFinite(v)) ||
        (isPlainObject(v) && typeof v.min === 'number' && typeof v.max === 'number')
      );
    }

    /** Clamp/repair a RangeValue field over an arbitrary [lo,hi] domain;
     * falls back to `fallback` when `v` is neither a finite number nor a
     * valid {min,max} pair. The voice-patch fields (Hz, seconds, cents, Q)
     * that went rangeable in the v7 sweep live outside 0–1, hence the
     * explicit domain — normaliseRangeValue below is the 0–1 specialisation
     * used by the track-level fields (level, randomness, sequencer prob). */
    function sanitiseRangeValueIn(v, lo, hi, fallback) {
      if (typeof v === 'number' && Number.isFinite(v)) return clamp(v, lo, hi);
      if (isPlainObject(v) && Number.isFinite(v.min) && Number.isFinite(v.max)) {
        let min = clamp(v.min, lo, hi);
        let max = clamp(v.max, lo, hi);
        if (min > max) [min, max] = [max, min];
        return { min, max };
      }
      return fallback;
    }

    /** Clamp/repair a RangeValue field; falls back to `fallback` (a plain
     * number) when `v` is neither a finite number nor a {min,max} object. */
    function normaliseRangeValue(v, fallback) {
      return sanitiseRangeValueIn(v, 0, 1, fallback);
    }

    /** A v21 feel param: a number in [lo,hi], or null for the Auto detent
     * ("follow the global swing" / "let complexity decide the density"). */
    function nullableNumberIn(v, lo, hi) {
      return typeof v === 'number' && Number.isFinite(v) ? clamp(v, lo, hi) : null;
    }

    /** A representative plain number for a RangeValue field — used by
     * controls that stay single-value editors (sequencer prob keyboard
     * path, slider fallbacks) even though the field itself may hold a
     * drifting {min,max}. */
    function rangeMid(v) {
      return typeof v === 'number' ? v : (v.min + v.max) / 2;
    }

    /** Apply `fn` to a RangeValue's number(s), preserving its shape —
     * for rounding/clamping a knob's emitted number|{min,max} before it's
     * written into patch/settings state. */
    function mapRV(v, fn) {
      return isPlainObject(v) ? { min: fn(v.min), max: fn(v.max) } : fn(v);
    }

    // ---- sequencer step-prob range helpers (0–1 domain only) ------------
    // The step-prob keyboard/pointer editors stay single-value EDITORS (they
    // move one number: the midpoint), but must not silently collapse a
    // {min,max} loaded from a preset/older save — these keep the window's
    // width while sliding it, clamping/sliding at the 0–1 edges rather than
    // truncating the width there.

    function clampProbWindow(mid, width) {
      let min = mid - width / 2;
      let max = mid + width / 2;
      if (min < 0) {
        max -= min;
        min = 0;
      }
      if (max > 1) {
        min -= max - 1;
        max = 1;
      }
      return { min: clamp(min, 0, 1), max: clamp(max, 0, 1) };
    }

    /** Move a prob RangeValue's midpoint to `mid`, keeping its width; a
     * plain number just becomes `mid`. */
    function shiftRangeMid(v, mid) {
      mid = clamp(mid, 0, 1);
      if (!isPlainObject(v)) return mid;
      const width = clamp(v.max - v.min, 0, 1);
      return clampProbWindow(mid, width);
    }

    /** Widen/narrow a prob RangeValue by `delta` around its current
     * midpoint (splitting a plain number into a range on first widen);
     * narrowing to ~0 collapses back to a plain number. */
    function resizeRangeWidth(v, delta) {
      const isRange = isPlainObject(v);
      const width = isRange ? clamp(v.max - v.min, 0, 1) : 0;
      const mid = isRange ? clamp((v.min + v.max) / 2, 0, 1) : clamp(v, 0, 1);
      const nextWidth = clamp(width + delta, 0, 1);
      if (nextWidth <= 0.001) return mid;
      return clampProbWindow(mid, nextWidth);
    }

    // ---- v6 sequencer migration + normalisation -------------------------

    /**
     * Pre-v6 saves (and submitted presets) carry the arp step mask as 16
     * booleans in arp.steps with no tracks.arp.sequencer. Map them into the
     * new Step shape once, per the contract (on → prob 1, band 0.5–0.9);
     * slots 16–19 pad with "on" (the legacy default). Mutates `saved`.
     */
    function migrateLegacyArpSteps(saved) {
      if (!isPlainObject(saved)) return;
      const legacy =
        isPlainObject(saved.arp) && Array.isArray(saved.arp.steps) ? saved.arp.steps : null;
      if (!legacy) return;
      if (
        isPlainObject(saved.tracks) &&
        isPlainObject(saved.tracks.arp) &&
        isPlainObject(saved.tracks.arp.sequencer)
      ) {
        return; // already v6-shaped; the sequencer is the source of truth
      }
      const steps = Array.from({ length: SEQ_SLOTS }, (_, i) => ({
        on: i < legacy.length ? !!legacy[i] : true,
        prob: 1,
        vmin: 0.5,
        vmax: 0.9,
      }));
      if (!isPlainObject(saved.tracks)) saved.tracks = {};
      if (!isPlainObject(saved.tracks.arp)) saved.tracks.arp = {};
      saved.tracks.arp.sequencer = {
        mode: saved.arp.mode === 'manual' ? 'manual' : 'auto',
        steps,
      };
    }

    function normaliseLane(arr, kind) {
      const out = defaultLane(kind);
      if (!Array.isArray(arr)) return out;
      for (let i = 0; i < SEQ_SLOTS; i++) {
        const s = arr[i];
        if (typeof s === 'boolean') {
          out[i] = { on: s, prob: 1, vmin: 0.5, vmax: 0.9 };
          continue;
        }
        if (!isPlainObject(s)) continue;
        const num = (v, d) => (typeof v === 'number' && Number.isFinite(v) ? clamp(v, 0, 1) : d);
        // prob is rangeable (v7 addendum) — preserve a valid {min,max}
        // instead of collapsing it to the plain-number fallback. vmin/vmax
        // are NOT rangeable (a per-note velocity band already), so they
        // stay plain numbers via num().
        const step = { on: s.on === true, prob: normaliseRangeValue(s.prob, 1), vmin: num(s.vmin, 0.5), vmax: num(s.vmax, 0.9) };
        if (step.vmin > step.vmax) [step.vmin, step.vmax] = [step.vmax, step.vmin];
        // v14 tie/group are OPTIONAL: a step that never carried one keeps the
        // key absent, matching the engine's own sanitiser so a round-trip
        // through getParams() doesn't grow the payload.
        if (s.tie === true) step.tie = true;
        if (Number.isFinite(s.group) && s.group >= 0) step.group = Math.floor(s.group);
        // v21 gate is optional in the same way: absent means "however long the
        // engine plays this step by default", so an untouched step never grows
        // the key.
        if (Number.isFinite(s.gate)) step.gate = clamp(s.gate, SEQ_GATE_MIN, SEQ_GATE_MAX);
        out[i] = step;
      }
      return out;
    }

    /** One sequencer of a track's list: mode + Markov transition weights +
     * lane(s). `weights` is padded/truncated to the list length by the caller.
     * `lanes` (percussion only) is the track's lane list — the step map is
     * keyed by lane id, so a lane the user added carries its own pattern and a
     * lane they removed takes its pattern with it. */
    function normaliseSequencer(seq, track, lanes) {
      const src = isPlainObject(seq) ? seq : {};
      const steps =
        track === 'percussion'
          ? (() => {
              const raw = isPlainObject(src.steps) ? src.steps : {};
              const out = {};
              for (const lane of lanes) out[lane.id] = normaliseLane(raw[lane.id], lane.kind);
              return out;
            })()
          : normaliseLane(src.steps, track);
      const weights = Array.isArray(src.weights)
        ? src.weights.map((w) => (Number.isFinite(w) ? clamp(w, 0, 100) : 1))
        : [1];
      return { mode: src.mode === 'manual' ? 'manual' : 'auto', weights: weights.length ? weights : [1], steps };
    }

    /**
     * Rebuild a track's sequencer LIST. A pre-v14 save carries only the
     * singular `sequencer`; it becomes sequencers[0]. Afterwards `sequencer`
     * is re-pointed at sequencers[0] (the same object, as the engine does)
     * so every v6-era read/write path still works unchanged.
     */
    function normaliseSequencerList(t, track) {
      const list = Array.isArray(t.sequencers) && t.sequencers.length
        ? t.sequencers
        : [isPlainObject(t.sequencer) ? t.sequencer : {}];
      const lanes = track === 'percussion' ? t.lanes : null;
      t.sequencers = list.slice(0, SEQ_MAX).map((seq) => normaliseSequencer(seq, track, lanes));
      const n = t.sequencers.length;
      for (const seq of t.sequencers) {
        seq.weights = Array.from({ length: n }, (unused, i) =>
          i < seq.weights.length ? seq.weights[i] : 1
        );
      }
      t.sequencer = t.sequencers[0];
    }

    /**
     * Runs after every deepMerge over DEFAULTS: clamps the v6 track fields,
     * rebuilds step arrays as fresh 20-slot objects (also breaking any
     * aliasing of DEFAULTS' arrays), and re-derives the legacy arp.steps
     * boolean mirror from the arp sequencer's on-flags.
     */
    function normaliseV6Tracks(s) {
      s.swing = clamp(typeof s.swing === 'number' && Number.isFinite(s.swing) ? s.swing : 0, 0, 1);
      s.harmony = isPlainObject(s.harmony) ? s.harmony : {};
      s.harmony.rhythm = CHORD_LENGTHS.includes(s.harmony.rhythm) ? s.harmony.rhythm : 'auto';
      for (const id of TRACK_IDS) {
        const t = s.tracks[id];
        t.level = normaliseRangeValue(t.level, 0.8);
        t.hold = t.hold === true;
        // Mono is a plain boolean and glide a plain 0–1 number engine-side —
        // neither is rangeable, so a stored range is repaired to its midpoint.
        t.mono = t.mono === true;
        t.glide = clamp(
          typeof t.glide === 'number' && Number.isFinite(t.glide)
            ? t.glide
            : MONO_DEFAULTS[id].glide,
          0,
          1
        );
        // Rangeable (v7 addendum) — preserve a valid {min,max}; only a
        // genuinely invalid value falls back to the 0.5 default.
        t.randomness = normaliseRangeValue(t.randomness, 0.5);
        if (TUNED_TRACKS.includes(id)) t.dissonance = normaliseRangeValue(t.dissonance, 0);
        else delete t.dissonance;
        // v21 feel params: null is a value here (the Auto detent), so an
        // absent/invalid entry becomes null rather than a number.
        if (SEQ_TRACKS.includes(id)) t.swing = nullableNumberIn(t.swing, 0, 1);
        else delete t.swing;
        if (TUNED_TRACKS.includes(id)) t.density = nullableNumberIn(t.density, 0, TRACK_DENSITY_MAX);
        else delete t.density;
        // v21 pad breath: no Auto detent (a plain 0-1 depth), and no baked
        // default here — an absent/invalid value is deleted so the control
        // falls back to the engine's own shipped depth when it builds.
        if (id === 'pad' && typeof t.padBreath === 'number' && Number.isFinite(t.padBreath)) {
          t.padBreath = clamp(t.padBreath, 0, 1);
        } else {
          delete t.padBreath;
        }
        const vary = isPlainObject(t.vary) ? t.vary : {};
        t.vary = defaultVary();
        for (const [key] of VARY_KEYS) {
          // Rangeable since v7 (the engine resolves vary.* through the same
          // per-bar walk as randomness), so a {min,max} must survive the load —
          // null stays null, which is the "follow Randomness" detent.
          t.vary[key] = sanitiseRangeValueIn(vary[key], 0, 1, null);
        }
      }
      // Lanes first: the percussion step map is keyed by lane id, so the list
      // has to be repaired before the sequencers that follow it are.
      s.tracks.percussion.lanes = normalisePercLanes(s.tracks.percussion.lanes);
      for (const id of SEQ_TRACKS) normaliseSequencerList(s.tracks[id], id);
      // Legacy boolean mask follows the arp's FIRST sequencer (kept for older
      // engines and for the combined-complexity estimate).
      s.arp.steps = s.tracks.arp.sequencers[0].steps.slice(0, 16).map((st) => !!st.on);
    }

    // ---- tempo mapping (one tempo, two views) ---------------------------
    // The Simple "Speed" slider position t (0–1) is a log-mapped view of
    // bpm 40–120 with 60 bpm at the slider centre, using two log segments:
    //   t <= 0.5:  bpm = 40 * (60/40)^(t/0.5)
    //   t >  0.5:  bpm = 60 * (120/60)^((t-0.5)/0.5)
    // The engine always receives { bpm, speed: 1 } — `speed` is deprecated
    // at the UI level per the v3 contract addendum.
    // 20-220 bpm (commercially-proven extremes), 60 bpm at the dial centre.
    function bpmFromSpeedT(t) {
      return t <= 0.5
        ? 20 * Math.pow(3, t / 0.5)
        : 60 * Math.pow(220 / 60, (t - 0.5) / 0.5);
    }
    function speedTFromBpm(bpm) {
      return bpm <= 60
        ? 0.5 * (Math.log(bpm / 20) / Math.log(3))
        : 0.5 + 0.5 * (Math.log(bpm / 60) / Math.log(220 / 60));
    }

    function logToValue(t, min, max) {
      return min * Math.pow(max / min, t);
    }
    function valueToLog(v, min, max) {
      return Math.log(v / min) / Math.log(max / min);
    }

    function clamp(v, lo, hi) {
      return Math.min(hi, Math.max(lo, v));
    }

    // ---- oscillator shape model (v5 morph) ------------------------------
    // shape: 0 sine, 1 triangle, 2 sawtooth, 3 square; fractional = morph.
    // Legacy persisted patches (and older voice defaults) store strings in
    // osc1/osc2 — map them onto the dial.
    const SHAPE_NAMES = ['sine', 'triangle', 'sawtooth', 'square'];
    const SHAPE_LABELS = ['Sine', 'Tri', 'Saw', 'Sq'];
    const SHAPE_FROM_STRING = { sine: 0, triangle: 1, sawtooth: 2, square: 3 };

    // v12: mini waveform glyphs for the shape dials — inline SVG paths on a
    // 24×24 canvas, stroked in currentColor so they pick up the theme's
    // tick/text colour wherever they're placed (ring mark or readout).
    const SHAPE_GLYPH_PATHS = [
      // sine
      '<path d="M1 12 C4 3 8 3 12 12 C16 21 20 21 23 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
      // triangle
      '<path d="M1 12 L6.5 3 L12 12 L17.5 21 L23 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
      // sawtooth — one full cycle: two ramps, each ended by a truly vertical
      // drop (the old path trailed off mid-ramp with no closing edge).
      '<path d="M3 18 L12 6 L12 18 L21 6 L21 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
      // square — one full cycle: high half, drop, low half, rise. Exactly two
      // verticals (the old path opened on a third, at the left edge).
      '<path d="M3 6 L12 6 L12 18 L21 18 L21 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
    ];

    // v14: what each canonical mark sounds like, shown as an SVG <title> on
    // the mark glyph — a native tooltip that reaches AT as well, and needs no
    // knob.js change (markGlyphs markup is inserted verbatim).
    const SHAPE_MARK_HINTS = [
      'Sine — pure, no harmonics: the softest of the four.',
      'Triangle — odd harmonics, falling away fast: hollow and flute-like.',
      'Sawtooth — every harmonic: bright and brassy, the richest.',
      'Square — odd harmonics only: hollow but strong, clarinet-ish.',
    ];

    function shapeMarkGlyph(index) {
      return `<title>${SHAPE_MARK_HINTS[index]}</title>${SHAPE_GLYPH_PATHS[index]}`;
    }

    // Passed to knob.js's `markGlyphs`: one entry per canonical mark value.
    // The 24×24 paths are centred on the mark by the -12,-12 translate.
    const SHAPE_MARK_GLYPHS = Object.fromEntries(
      [0, 1, 2, 3].map((i) => [
        i,
        `<svg viewBox="0 0 24 24" width="12" height="12" x="-6" y="-6" overflow="visible">${shapeMarkGlyph(i)}</svg>`,
      ])
    );

    // ---- v14 live mini-waveform readout ---------------------------------
    // The shape dials used to print "Saw~Sq" and a pair of static icons. The
    // readout is now a tiny trace of the ACTUAL interpolated wave: the four
    // canonical shapes are crossfaded sample-by-sample, which is exactly
    // linear interpolation of their Fourier coefficients (the engine's own
    // morph), so what you see is the wave you get. Redrawn only when the
    // value changes — knob.js calls `glyph` from updateView, never on a timer.
    function canonicalWave(kind, phase) {
      switch (kind) {
        case 0:
          return Math.sin(2 * Math.PI * phase);
        case 1:
          // 0 at phase 0, +1 at a quarter, -1 at three quarters — in phase
          // with the sine above, so a morph between them never lurches.
          return 4 * Math.abs(phase - Math.floor(phase + 0.75) + 0.25) - 1;
        case 2:
          return 2 * (phase - Math.floor(phase + 0.5));
        default:
          return phase < 0.5 ? 1 : -1;
      }
    }

    function morphedWave(shape, phase) {
      const c = clamp(shape, 0, 3);
      const lo = Math.floor(c);
      const hi = Math.min(3, lo + 1);
      const t = c - lo;
      return canonicalWave(lo, phase) * (1 - t) + canonicalWave(hi, phase) * t;
    }

    const WAVE_W = 46;
    const WAVE_H = 18;
    const WAVE_SAMPLES = 64;

    function shapeGlyph(v) {
      const points = [];
      for (let i = 0; i <= WAVE_SAMPLES; i++) {
        const phase = i / WAVE_SAMPLES;
        const y = WAVE_H / 2 - morphedWave(v, phase) * (WAVE_H / 2 - 1.5);
        points.push(`${((phase * WAVE_W).toFixed(1))},${y.toFixed(1)}`);
      }
      return (
        `<svg class="wave-readout" viewBox="0 0 ${WAVE_W} ${WAVE_H}" width="${WAVE_W}" height="${WAVE_H}" aria-hidden="true">` +
        `<polyline points="${points.join(' ')}" fill="none" stroke="currentColor" stroke-width="1.5" ` +
        'stroke-linejoin="round" stroke-linecap="round"/></svg>'
      );
    }

    function readShape(source, n) {
      const shape = source[`shape${n}`];
      if (typeof shape === 'number' && Number.isFinite(shape)) return clamp(shape, 0, 3);
      if (typeof shape === 'string' && shape in SHAPE_FROM_STRING) {
        return SHAPE_FROM_STRING[shape];
      }
      const osc = source[`osc${n}`];
      if (typeof osc === 'string' && osc in SHAPE_FROM_STRING) return SHAPE_FROM_STRING[osc];
      return null;
    }

    // Write both key families: shape1/shape2 numbers are authoritative for a
    // v5 engine/voices build; nearest-string osc1/osc2 keeps an older build
    // (or a not-yet-updated sanitiser) honouring the edit.
    function writeShape(source, n, value) {
      if (value === null) {
        source[`shape${n}`] = null;
        source[`osc${n}`] = null;
        return;
      }
      const v = clamp(value, 0, 3);
      source[`shape${n}`] = v;
      source[`osc${n}`] = SHAPE_NAMES[Math.round(v)];
    }

    // ---- v12/v18 detune dial --------------------------------------------
    // Bipolar where the engine takes it (probed at boot): the same 50 cents
    // flat as sharp, with a centre detent so "in tune" is findable by feel.
    const DETUNE_MAX = 50;
    const DETUNE_DETENT = 1; // cents swallowed either side of zero

    function detuneFormat(v, bipolar) {
      const n = Math.round(v);
      if (!bipolar) return `${n} ct`;
      if (n === 0) return 'In tune';
      return `${n > 0 ? '+' : ''}${n} ct`;
    }

    // ---- v11 share links, tier 1 (fragment, no server) -------------------
    // A share link carries PARAMS ONLY — never user code (v10 hard rule). The
    // payload is JSON → UTF-8 → base64url in the URL fragment: fragments are
    // never sent to the server, so the preset only ever exists between the two
    // people holding the link. No compression: a full settings snapshot is a
    // few KB, which every browser and messaging app handles as a URL.
    const SHARE_BASE = 'https://ambi4.work/';
    const SHARE_PARAM = 'p';

    function encodeShareParams(params) {
      const bytes = new TextEncoder().encode(JSON.stringify(params));
      let binary = '';
      for (const b of bytes) binary += String.fromCharCode(b);
      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function decodeShareParams(value) {
      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
      const binary = atob(base64 + '='.repeat((4 - (base64.length % 4)) % 4));
      const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
      const parsed = JSON.parse(new TextDecoder().decode(bytes));
      return isPlainObject(parsed) ? parsed : null;
    }

    /**
     * Read a `#p=…` share fragment, then strip it from the URL either way
     * (history.replaceState — a reload must not re-apply a preset the user has
     * since edited). Anything malformed is ignored SILENTLY: a truncated link
     * pasted into a chat window is not an error worth shouting about, and the
     * page simply boots on the stored settings instead.
     */
    function takeSharedParams() {
      try {
        const hash = String(location.hash || '').replace(/^#/, '');
        if (!hash) return null;
        const value = new URLSearchParams(hash).get(SHARE_PARAM);
        try {
          history.replaceState(null, '', location.pathname + location.search);
        } catch {}
        if (!value) return null;
        return decodeShareParams(value);
      } catch {
        return null;
      }
    }

    // ---- v16 preset routes (/[slug]) -------------------------------------
    // src/pages/[preset].astro is a static shell per factory-preset slug: it
    // writes the slug into this sessionStorage key and location.replace('/')s
    // here. Only the SLUG travels — the params are looked up in the list this
    // page already holds, so the route can never carry a stale copy of a
    // preset. Taking it CONSUMES it (a later reload of / is the user's own
    // session, not the link's), and the lookup runs before any dial is built,
    // exactly like the #p= path above.
    const ROUTE_PRESET_KEY = 'ambi4:route-preset';

    function takeRoutePreset() {
      let slug = null;
      try {
        slug = sessionStorage.getItem(ROUTE_PRESET_KEY);
        sessionStorage.removeItem(ROUTE_PRESET_KEY);
      } catch {
        return null;
      }
      return slug ? factoryPresetBySlug(slug) : null;
    }

    async function loadPrefsModule() {
      try {
        const mod = await import('../scripts/prefs.js');
        if (mod && mod.prefs && typeof mod.prefs.get === 'function') {
          return { prefs: mod.prefs, consentPrompt: mod.consentPrompt };
        }
      } catch {
        // fall through to the session-memory shim
      }
      // prefs.js missing or broken: degrade to session-memory settings.
      const mem = new Map();
      return {
        prefs: {
          consent: () => 'denied',
          setConsent: () => {},
          get: (k) => (mem.has(k) ? structuredClone(mem.get(k)) : null),
          set: (k, v) => {
            mem.set(k, structuredClone(v));
            return false;
          },
          remove: (k) => {
            mem.delete(k);
          },
        },
        consentPrompt: async () => false,
      };
    }

    async function init() {
      if (typeof window.AudioContext === 'undefined' && typeof window.webkitAudioContext === 'undefined') {
        unavailable.hidden = false;
        return;
      }

      let createEngine;
      // v18: the page probes the engine's own patch sanitiser for the fields
      // it wants to offer dials for (percussion source.pitch / source.noise).
      // Absent on an older engine build, hence the separate binding.
      let sanitiseParams = null;
      // The whole module, because the track registry is read from its exports
      // (TUNED_TRACKS / SEQUENCED_TRACKS) as well as from the engine handle.
      let engineModule;
      try {
        engineModule = await import('../scripts/ambient-engine.js');
        ({ createEngine, sanitiseParams } = engineModule);
      } catch {
        unavailable.hidden = false;
        return;
      }

      const engine = createEngine();

      // ---- v21 track registry -------------------------------------------
      // Probed like every other capability, and for the same reason: an
      // engine bundle without getTracks() would otherwise leave every row,
      // editor and lane with nothing to build from. Where it answers, its
      // list wins outright — ids, order and labels; where it doesn't, the
      // FALLBACK_TRACKS views seeded at module scope stay in force.
      const registryTracks =
        typeof engine.getTracks === 'function' ? engine.getTracks() : null;
      const hasTrackRegistry = Array.isArray(registryTracks) && registryTracks.length > 0;
      if (hasTrackRegistry) {
        ({ TRACK_IDS, TRACK_LABELS, TUNED_TRACKS, SEQ_TRACKS, SEQ_SINGLE_TRACKS } =
          trackListsFrom(registryTracks, engineModule));
      }

      // ---- v6 capability detection --------------------------------------
      // Gating choice: the new params (hold / randomness / vary / sequencer)
      // are always SENT — the engine sanitiser drops unknown keys safely, so
      // a pre-v6 engine just ignores them and they still persist for later.
      // But controls the user could see doing nothing are only RENDERED when
      // the engine advertises support: getParams() exposing the field, and
      // randomise being a function. Exception: the arp step grid always
      // renders, because its on/off flags degrade gracefully to the legacy
      // arp.steps boolean mask that every v2+ engine honours.
      const engineCaps = {
        trackRegistry: hasTrackRegistry,
        randomise: typeof engine.randomise === 'function',
        getResolved: typeof engine.getResolved === 'function',
        getStats: typeof engine.getStats === 'function',
        setPowerBudget: typeof engine.setPowerBudget === 'function',
        swing: false,
        patchPitch: false,
        patchNoise: false,
        patchNoiseRange: false,
        patchSculpt: false,
        patchCall: false,
        patchV19Range: false,
        patchFold: false,
        // v21: a global reverb-tail length, and the setter the power governor
        // caps it through. Either one alone is enough to drive the dial.
        reverbTail: false,
        setReverbSeconds: typeof engine.setReverbSeconds === 'function',
        // v21: user-addable percussion lanes, per-step note length, and the
        // bipolar detune the v12 round had to leave unipolar. All three are
        // sanitiser probes (below), not version guesses.
        percussionLanes: false,
        stepGate: false,
        patchDetuneBipolar: false,
        randomness: {},
        dissonance: {},
        vary: {},
        sequencer: {},
        sequencers: {},
        level: {},
        mono: {},
        glide: {},
        driftRate: {},
        trackSwing: {},
        trackDensity: {},
      };
      // The engine's own starting reverb tail — the dial's default and its
      // opening value, so the page never invents a length the engine disagrees
      // with. Null until an engine ships the param.
      let engineReverbTail = null;
      try {
        const p = engine.getParams() || {};
        engineCaps.swing = typeof p.swing === 'number';
        engineCaps.reverbTail = typeof p.reverbTail === 'number';
        if (engineCaps.reverbTail) engineReverbTail = clamp(p.reverbTail, 0.5, 6);
        const t = isPlainObject(p.tracks) ? p.tracks : {};
        for (const id of TRACK_IDS) {
          const entry = isPlainObject(t[id]) ? t[id] : {};
          // Accept a plain {min,max} RangeValue too (v7), not just a bare
          // number — a range-shipping engine must not make the knob vanish.
          engineCaps.randomness[id] = isNumberOrRange(entry.randomness);
          engineCaps.dissonance[id] = isNumberOrRange(entry.dissonance);
          engineCaps.vary[id] = isPlainObject(entry.vary);
          engineCaps.sequencer[id] = isPlainObject(entry.sequencer);
          engineCaps.sequencers[id] = Array.isArray(entry.sequencers);
          engineCaps.level[id] = isNumberOrRange(entry.level);
          // v12 mono/legato and v21 driftRate: all three are plain scalars
          // engine-side (never RangeValues), so the probe is a type check.
          engineCaps.mono[id] = typeof entry.mono === 'boolean';
          engineCaps.glide[id] = typeof entry.glide === 'number';
          engineCaps.driftRate[id] = typeof entry.driftRate === 'number';
        }
      } catch {}

      // v18 patch-schema probe: percussion trades its 3-position Octave switch
      // for a continuous Pitch dial and gains a Noise dial, but ONLY once the
      // engine's PATCH_SCHEMA accepts those fields — a dial writing a key the
      // sanitiser drops is a dial that does nothing. sanitiseParams is a pure
      // function, so the probe runs a throwaway patch through the very code
      // path a real edit would take (rather than trusting a version number),
      // and asks the same question of the {min,max} form for rangeability.
      function probePatchSource(source) {
        if (typeof sanitiseParams !== 'function') return null;
        try {
          const probed = sanitiseParams({ patches: { percussion: { __probe: { source } } } });
          const bank = probed && isPlainObject(probed.patches) ? probed.patches.percussion : null;
          const patch = bank && isPlainObject(bank.__probe) ? bank.__probe : null;
          return patch && isPlainObject(patch.source) ? patch.source : null;
        } catch {
          return null;
        }
      }
      {
        const plain = probePatchSource({ pitch: 7, noise: 0.5 }) || {};
        const ranged = probePatchSource({ noise: { min: 0.2, max: 0.6 } }) || {};
        engineCaps.patchPitch = typeof plain.pitch === 'number';
        engineCaps.patchNoise = isNumberOrRange(plain.noise);
        engineCaps.patchNoiseRange = isPlainObject(ranged.noise);
        // v19 sculpting / call synthesis and the v20 wavefolder ride the same
        // schema probe: a voice may declare the dials in its `controls` before
        // the engine's sanitiser accepts them, and a dial whose value is
        // dropped on the way to play() is a dial that does nothing. One
        // representative field per family answers for the whole family — they
        // land in PATCH_SCHEMA as one block.
        const v19 = probePatchSource({ tilt: 0.25, cadence: 2, fold: 0.5 }) || {};
        const v19Ranged = probePatchSource({ tilt: { min: -0.5, max: 0.5 } }) || {};
        engineCaps.patchSculpt = typeof v19.tilt === 'number';
        engineCaps.patchCall = typeof v19.cadence === 'number';
        engineCaps.patchFold = isNumberOrRange(v19.fold);
        engineCaps.patchV19Range = isPlainObject(v19Ranged.tilt);
        // v12 left detune unipolar because the sanitiser clamped to [0,50];
        // it has taken -50..50 since v18, so the dial goes bipolar the moment
        // the probe says a negative value survives — and stays unipolar (no
        // silently-clamped half) where it doesn't.
        const bipolar = probePatchSource({ detune: -25 }) || {};
        engineCaps.patchDetuneBipolar = bipolar.detune === -25;
      }

      // v21 track-param probes. Same reasoning as the patch probe above: these
      // ship as UI in the same wave as the engine work, so nothing here may
      // trust a version — each control asks the sanitiser whether the value it
      // would write actually survives.
      function probeTracks(partial) {
        if (typeof sanitiseParams !== 'function') return null;
        try {
          const probed = sanitiseParams({ tracks: partial });
          return probed && isPlainObject(probed.tracks) ? probed.tracks : null;
        } catch {
          return null;
        }
      }
      {
        // Dynamic percussion lanes: the question is not "is there a lanes key"
        // but "does a lane I invented come back", since a lane the engine
        // discards is a lane whose steps never sound.
        const PROBE_LANE = '__probe';
        const lanesProbe = probeTracks({
          percussion: {
            lanes: [
              ...defaultPercLanes(),
              { id: PROBE_LANE, label: 'Lane 4', kind: PERC_NEW_LANE_KIND },
            ],
          },
        });
        const lanes = lanesProbe && isPlainObject(lanesProbe.percussion)
          ? lanesProbe.percussion.lanes
          : null;
        engineCaps.percussionLanes =
          Array.isArray(lanes) && lanes.some((lane) => isPlainObject(lane) && lane.id === PROBE_LANE);

        // Per-step note length, probed on a melodic lane (the only place the
        // page offers the third axis).
        const gateProbe = probeTracks({ melody: { sequencer: { steps: [{ on: true, gate: 1.5 }] } } });
        const probedStep =
          gateProbe && isPlainObject(gateProbe.melody) && isPlainObject(gateProbe.melody.sequencer)
            ? (gateProbe.melody.sequencer.steps || [])[0]
            : null;
        engineCaps.stepGate = isPlainObject(probedStep) && probedStep.gate === 1.5;

        // Per-track swing/density. Both carry an Auto detent that writes null,
        // so a build that takes the number but not the null would give the
        // detent nothing to mean — hence both halves are probed, and the
        // control ships only when the pair survives.
        const numbers = probeTracks(
          Object.fromEntries(TRACK_IDS.map((id) => [id, { swing: 0.5, density: 1.5 }]))
        );
        const nulls = probeTracks(
          Object.fromEntries(TRACK_IDS.map((id) => [id, { swing: null, density: null }]))
        );
        for (const id of TRACK_IDS) {
          const num = numbers && isPlainObject(numbers[id]) ? numbers[id] : {};
          const nul = nulls && isPlainObject(nulls[id]) ? nulls[id] : {};
          engineCaps.trackSwing[id] = num.swing === 0.5 && nul.swing === null;
          engineCaps.trackDensity[id] = num.density === 1.5 && nul.density === null;
        }
      }

      // Iteration 4: three more modes, harmony.rhythm (chord length) and the
      // pad's breath depth — all landing in the engine THIS iteration, so
      // none of the three trusts a version number. A mode name the sanitiser
      // doesn't recognise silently falls back to whatever mode it started
      // from, hence "does the candidate come back unchanged" rather than
      // "did the call not throw".
      const NEW_MODES = [
        ['ionian', 'Ionian (Major)'],
        ['mixolydian', 'Mixolydian'],
        ['phrygian', 'Phrygian'],
      ];
      engineCaps.modes = {};
      for (const [id] of NEW_MODES) {
        try {
          const probed = sanitiseParams({ mode: id });
          engineCaps.modes[id] = probed && probed.mode === id;
        } catch {
          engineCaps.modes[id] = false;
        }
      }

      // harmony.rhythm: 'auto'|1|2|4|8 bars-per-chord. 'auto' would also be
      // the sanitiser's own fallback for a field it doesn't know, so the
      // probe uses a non-default candidate — only a real echo proves it.
      engineCaps.harmonyRhythm = false;
      try {
        const probed = sanitiseParams({ harmony: { rhythm: 4 } });
        engineCaps.harmonyRhythm = isPlainObject(probed?.harmony) && probed.harmony.rhythm === 4;
      } catch {}

      // Pad breath depth (0-1): scoped to the pad track's own params, the
      // same shape as driftRate/mono/glide. The page never invents a
      // starting depth — like reverbTail, it reads the engine's own once the
      // probe confirms the field survives.
      engineCaps.padBreath = false;
      let enginePadBreath = null;
      {
        const probedTracks = probeTracks({ pad: { padBreath: 0.4 } });
        const padOut = probedTracks && isPlainObject(probedTracks.pad) ? probedTracks.pad : null;
        engineCaps.padBreath = isPlainObject(padOut) && padOut.padBreath === 0.4;
      }
      if (engineCaps.padBreath) {
        try {
          const p = engine.getParams() || {};
          const pad = isPlainObject(p.tracks) ? p.tracks.pad : null;
          if (isPlainObject(pad) && typeof pad.padBreath === 'number') {
            enginePadBreath = clamp(pad.padBreath, 0, 1);
          }
        } catch {}
      }

      const { prefs, consentPrompt } = await loadPrefsModule();

      // ---- v26 genre compiler + registry --------------------------------
      // The compiler runs PAGE-side (contract § v26 genre compiler): it turns
      // one genre file into a full params object the engine takes through its
      // ordinary setParams, so the engine ships no genre data and no genre
      // behaviour. Loaded like every other optional module — a build without
      // it simply has no genre picker, rather than no page.
      let genreCompiler = null;
      if (GENRES.length) {
        try {
          const mod = await import('../scripts/genre-compiler.js');
          if (typeof mod.compileGenre === 'function') genreCompiler = mod;
        } catch {
          // no compiler → the genre row hides itself below
        }
        // The engine's table is the page's list: with it registered, a slug
        // arriving from a share link is checked against the genres that
        // actually exist rather than kept as an opaque tag.
        if (typeof engine.setGenreTable === 'function') {
          try {
            engine.setGenreTable(GENRES);
          } catch {}
        }
      }

      /**
       * Favourites, their hide-the-rest toggle, and whether the listener has
       * been through the picker once (which is what turns "Choose favourites…"
       * into "Edit favourites…"). Persisted through prefs like the presets
       * list, so it survives a reload only where consent was granted.
       */
      let genrePrefs = { favourites: [], hideOthers: false, picked: false };
      try {
        const stored = prefs.get('genre');
        if (isPlainObject(stored)) {
          genrePrefs = {
            favourites: (Array.isArray(stored.favourites) ? stored.favourites : []).filter(
              (slug) => GENRE_BY_SLUG.has(slug)
            ),
            hideOthers: stored.hideOthers === true,
            picked: stored.picked === true,
          };
        }
      } catch {}

      /** The genres a fresh visit may open on, weighted (see BACKGROUND_GENRES). */
      function openingGenrePool() {
        const favourites = genrePrefs.favourites;
        const background = BACKGROUND_GENRES.map((slug) => GENRE_BY_SLUG.get(slug)).filter(Boolean);
        // Hide-non-favourites prunes the opening draw too — a listener who
        // asked not to see the rest of the set should not be opened on one.
        const pool = genrePrefs.hideOthers && favourites.length
          ? background.filter((genre) => favourites.includes(genre.slug))
          : background;
        // …unless that leaves nothing (every favourite is outside the
        // background list), in which case the favourites themselves are the
        // honest answer, and the background list is the last resort.
        const source = pool.length
          ? pool
          : genrePrefs.hideOthers && favourites.length
            ? favourites.map((slug) => GENRE_BY_SLUG.get(slug)).filter(Boolean)
            : background;
        return source.map((genre) => ({
          value: genre,
          weight: favourites.includes(genre.slug) ? FAVOURITE_WEIGHT : 1,
        }));
      }

      /** One compiled setup from a genre, or null if the compiler refuses it. */
      function compileGenreParams(genre, seed) {
        if (!genreCompiler || !genre) return null;
        try {
          return genreCompiler.compileGenre(genre, { rng: makeRng(seed) });
        } catch {
          return null;
        }
      }

      // ---- settings load + legacy migration -----------------------------

      let settings;
      let sharedParams = null;
      let routePreset = null;
      {
        let saved = null;
        try {
          saved = prefs.get('generator');
        } catch {
          saved = null;
        }
        let migratedFromLegacy = false;
        if (!saved) {
          try {
            const raw = localStorage.getItem(LEGACY_STORAGE_KEY);
            if (raw) {
              saved = JSON.parse(raw);
              // v2 had independent speed (0.25–2) and bpm; v3 has one tempo.
              // Fold the old multiplier into bpm on migration.
              if (typeof saved.speed === 'number' && typeof saved.bpm === 'number') {
                saved.bpm = Math.round(clamp(saved.bpm * saved.speed, 20, 220));
              }
              delete saved.speed;
              migratedFromLegacy = true;
            }
          } catch {
            saved = null;
          }
        }
        if (migratedFromLegacy) {
          // The data is in memory now — drop the stale key unconditionally
          // so later loads can never re-migrate over newer settings.
          try {
            localStorage.removeItem(LEGACY_STORAGE_KEY);
          } catch {}
        }
        migrateLegacyArpSteps(saved);
        settings = deepMerge(DEFAULTS, saved || {});
        normaliseV6Tracks(settings);
        if (migratedFromLegacy && prefs.consent() === 'granted') {
          prefs.set('generator', settings);
        }
        // A `#p=` share link (or a /[slug] factory-preset route, v16) wins over
        // the stored settings for THIS visit, and takes the same migrate →
        // merge → normalise path a preset load does (so a link made by an older
        // build still lands). Applied here, before any dial is built, so the
        // first render is already the shared preset. Nothing is persisted: the
        // note tells the user to Save to keep it.
        sharedParams = takeSharedParams();
        if (!sharedParams) {
          routePreset = takeRoutePreset();
          if (routePreset) sharedParams = routePreset.params;
        }
        if (sharedParams) {
          const ui = settings.ui;
          try {
            const clone = structuredClone(sharedParams);
            migrateLegacyArpSteps(clone);
            settings = deepMerge(DEFAULTS, clone);
            normaliseV6Tracks(settings);
            settings.ui = ui;
          } catch {
            sharedParams = null;
            routePreset = null;
          }
        } else if (!saved && genreCompiler) {
          // v26: a visit with NOTHING to restore opens on a genre rather than
          // on the bare defaults — the listener's own finding was that every
          // fresh load sounded the same piece. The draw is weighted (see
          // openingGenrePool) and seeded fresh, so two first visits an hour
          // apart are two different pieces even on the same genre. Not
          // persisted: touching any control saves the whole settings object,
          // which is the point at which this becomes the listener's setup.
          const genre = weightedDraw(openingGenrePool());
          const compiled = compileGenreParams(genre, randomSeed());
          if (compiled) {
            const ui = settings.ui;
            settings = deepMerge(DEFAULTS, settingsFromGenre(compiled, genre.slug));
            normaliseV6Tracks(settings);
            settings.ui = ui;
          }
        }
      }

      // ---- consent-gated persistence ------------------------------------

      const consentSlot = document.getElementById('consent-slot');
      let deniedThisSession = false;
      let consentAsking = null;

      function ensureConsent() {
        const c = prefs.consent();
        if (c === 'granted') return Promise.resolve(true);
        if (c === 'denied' || deniedThisSession) return Promise.resolve(false);
        if (!consentAsking) {
          consentAsking = Promise.resolve(
            consentPrompt(consentSlot, 'Remember your settings and presets on this device?')
          )
            .then((granted) => {
              if (!granted) deniedThisSession = true;
              consentAsking = null;
              return granted;
            })
            .catch(() => {
              deniedThisSession = true;
              consentAsking = null;
              return false;
            });
        }
        return consentAsking;
      }

      function persistKey(key, value) {
        // prefs.set without consent writes to session memory and returns
        // false — so the value survives in-session either way.
        prefs.set(key, value);
        if (prefs.consent() === 'granted') {
          try {
            localStorage.removeItem(LEGACY_STORAGE_KEY);
          } catch {}
          return;
        }
        if (prefs.consent() === null && !deniedThisSession) {
          ensureConsent().then((granted) => {
            if (granted) {
              prefs.set(key, value);
              try {
                localStorage.removeItem(LEGACY_STORAGE_KEY);
              } catch {}
            }
          });
        }
      }

      // Sliders fire an input event per pixel of drag; debounce the storage
      // write. pagehide flushes any pending write (see lifecycle handlers).
      let persistTimer = null;
      function persistSettings() {
        if (persistTimer !== null) clearTimeout(persistTimer);
        persistTimer = setTimeout(() => {
          persistTimer = null;
          persistKey('generator', settings);
        }, 250);
      }
      function flushPersistSettings() {
        if (persistTimer !== null) {
          clearTimeout(persistTimer);
          persistTimer = null;
          persistKey('generator', settings);
        }
      }

      // ---- visualiser (optional decoration) -----------------------------

      const canvas = document.getElementById('track-visualiser');
      let visualiserHandle = null;
      // Declared up here (not with the governor block below) because
      // updateScopeMode reads the budget and can run before it.
      let governor = null;
      let powerBudget = null;
      // Assigned by the front-scope block much further down. It must be
      // DECLARED here: activateTab / updateAllScopeModes / setTrackState all
      // call it and all of them can run before that block's line is reached —
      // a `let` declared later would be a temporal-dead-zone crash (the
      // shipped blank-page bug, 6105e0d).
      let updateFrontScope = () => {};
      try {
      const { initVisualiser } = await import('../scripts/visualiser.js');
        visualiserHandle = initVisualiser(canvas, engine);
      } catch {
        // The generator works without it.
      }

      // ---- element handles ----------------------------------------------

      const toggleButton = document.getElementById('toggle-play');
      const playLabel = toggleButton.querySelector('.play-toggle-label');
      const playGlyph = toggleButton.querySelector('.play-glyph');
      const finishGlyph = toggleButton.querySelector('.finish-glyph');
      const stopNowButton = document.getElementById('stop-now');
      const pauseButton = document.getElementById('pause-toggle');
      const pauseLabel = pauseButton.querySelector('.pause-label');
      const pauseGlyph = pauseButton.querySelector('.pause-glyph');
      const resumeGlyph = pauseButton.querySelector('.resume-glyph');
      const forwardButton = document.getElementById('fast-forward');
      const genreRow = document.getElementById('genre-select').closest('.genre-row');
      const genreSelect = document.getElementById('genre-select');
      const recordButton = document.getElementById('record-toggle');
      const recordStatus = document.getElementById('record-status');
      const transportStatus = document.getElementById('transport-status');

      // v15: a transport control can be demoted to Advanced-only by adding
      // its data-transport id to SIMPLE_HIDDEN — nothing else changes.
      // Pre-launch: HIDDEN_UNTIL_LAUNCH wins over both tabs.
      // v26: UNAVAILABLE_TRANSPORT is the capability tier — a button this
      // engine build cannot serve at all (filled in by the probes below) is
      // not rendered on either tab, and stays unrendered across tab switches.
      const UNAVAILABLE_TRANSPORT = new Set();

      function applyTransportVisibility(tabName) {
        for (const el of document.querySelectorAll('[data-transport]')) {
          const owner = el.closest('.popover-anchor') || el;
          const id = el.dataset.transport;
          owner.hidden =
            UNAVAILABLE_TRANSPORT.has(id) ||
            (PAID_FEATURES_HIDDEN && HIDDEN_UNTIL_LAUNCH.has(id)) ||
            (tabName === 'simple' && SIMPLE_HIDDEN.has(id));
        }
      }

      // iOS routes Web Audio through the ringer channel, so the hardware
      // silent switch mutes it — surface a hint only where it applies.
      const isIOS =
        /iP(hone|ad|od)/.test(navigator.platform || '') ||
        (navigator.maxTouchPoints > 1 && /Mac/.test(navigator.platform || ''));
      if (isIOS) document.getElementById('ios-silent-hint').hidden = false;

      // v12: the Simple tab's five dials (Speed/Complexity/Repetition/
      // Randomness/Volume) are built further down, once knobApi has loaded —
      // `.set(v)` normalises knob-vs-slider-fallback for every call site
      // above that point (setTempo, updateComplexityDisplay, syncUIFromSettings).
      let speedDial = null;
      let complexityDial = null;
      let repetitionDial = null;
      let randomnessDial = null;
      let volumeDial = null;
      let swingDial = null;
      let reverbTailDial = null;
      let processorDial = null;
      const rootSelect = document.getElementById('root');
      const modeSelect = document.getElementById('mode');
      const timeSignatureSelect = document.getElementById('timeSignature');
      const bpmInput = document.getElementById('bpm');
      const bpmReadout = document.getElementById('bpm-readout');
      let bpmTypable = null;
      const structureSelect = document.getElementById('structure');
      const chordLengthControl = document.getElementById('control-chord-length');
      const chordLengthSelect = document.getElementById('chordLength');

      // Only the modes the engine's own sanitiser just confirmed it accepts
      // get an <option> at all — an unaccepted value would sit in the list
      // doing nothing the moment it was picked.
      for (const [value, label] of NEW_MODES) {
        if (!engineCaps.modes[value]) continue;
        const opt = document.createElement('option');
        opt.value = value;
        opt.textContent = label;
        modeSelect.append(opt);
      }

      function engineParamsFrom(s) {
        const p = structuredClone(s);
        delete p.ui;
        p.speed = 1; // deprecated at UI level; back-compat pin
        // v26: the genre tag is stated on EVERY push. The sanitiser keeps the
        // stored tag when the key is missing and only an explicit null clears
        // it, so a settings object with no genre (a factory preset, a share
        // link made before genres existed) has to say so out loud or the old
        // tag rides along under a piece that is no longer that genre.
        p.genre = typeof p.genre === 'string' ? p.genre : null;
        // The stored tail is the USER's ask; the engine only ever sees it
        // through the governor's tier cap (same policy as the density scale
        // on track levels — never overwrite what the user chose).
        if (typeof p.reverbTail === 'number') p.reverbTail = cappedReverbTail();
        return p;
      }

      /** The reverb tail the engine may actually have, tier cap included. */
      function cappedReverbTail() {
        const asked = clamp(
          typeof settings?.reverbTail === 'number' && Number.isFinite(settings.reverbTail)
            ? settings.reverbTail
            : engineReverbTail ?? 2,
          0.5,
          6
        );
        const cap = powerBudget && typeof powerBudget.reverbSeconds === 'number'
          ? powerBudget.reverbSeconds
          : null;
        return cap === null ? asked : Math.min(asked, cap);
      }

      /** Push the capped tail through whichever hook this engine exposes. */
      function applyReverbTail() {
        if (!engineCaps.reverbTail && !engineCaps.setReverbSeconds) return;
        const seconds = cappedReverbTail();
        if (engineCaps.reverbTail) {
          try {
            engine.setParams({ reverbTail: seconds });
          } catch {}
        }
        if (engineCaps.setReverbSeconds) {
          try {
            engine.setReverbSeconds(seconds);
          } catch {}
        }
      }

      // ---- combined-complexity estimate (display only) ------------------
      // When the user hand-sets advanced choices, the complexity slider
      // becomes a read-out of a derived "combined complexity" estimate. It
      // moves ONLY the slider thumb — never engine params, never the stored
      // complexity, never the advanced choices. Components (each 0–1,
      // included only when hand-set):
      //   structure != auto → mean section intensity of the chosen preset:
      //     drone 0.35, waves 0.50, build 0.55, abab 0.55, journey 0.55,
      //     custom = mean of the custom blocks' intensities
      //   arp manual → (enabled-step fraction) × rate weight
      //     (1/4 → 0.4, 1/8 → 0.6, 1/8T → 0.7, 1/16 → 0.9)
      //   any track forced on → (tracks with state 'on') / 6
      // estimate = arithmetic mean of the included components. With nothing
      // hand-set the slider shows the stored complexity.
      const STRUCTURE_MEAN_INTENSITY = {
        drone: 0.35,
        waves: 0.5,
        build: 0.55,
        abab: 0.55,
        journey: 0.55,
      };
      const ARP_RATE_WEIGHT = { '1/4': 0.4, '1/8': 0.6, '1/8T': 0.7, '1/16': 0.9 };

      function updateComplexityDisplay() {
        const parts = [];
        if (settings.structure !== 'auto') {
          if (settings.structure === 'custom' && settings.customStructure.length) {
            parts.push(
              settings.customStructure.reduce((s, b) => s + b.intensity, 0) /
                settings.customStructure.length
            );
          } else {
            parts.push(STRUCTURE_MEAN_INTENSITY[settings.structure] ?? 0.5);
          }
        }
        if (settings.arp.mode === 'manual') {
          // Density against the true per-bar step count, not the fixed
          // 16-slot legacy mirror length — otherwise a slow arp rate (few
          // steps actually in play) reads as artificially sparse.
          const n = Math.min(16, arpStepsPerBar());
          const frac = n > 0 ? settings.arp.steps.slice(0, n).filter(Boolean).length / n : 0;
          parts.push(frac * (ARP_RATE_WEIGHT[settings.arp.rate] ?? 0.6));
        }
        const forcedOn = TRACK_IDS.filter((id) => settings.tracks[id].state === 'on').length;
        if (forcedOn > 0) parts.push(forcedOn / TRACK_IDS.length);
        const shown = parts.length
          ? parts.reduce((s, p) => s + p, 0) / parts.length
          : settings.complexity;
        complexityDial?.set(clamp(shown, 0, 1));
      }

      // ---- tempo (one value, two views) ---------------------------------

      function setTempo(bpm, { skipSpeedThumb = false } = {}) {
        bpm = Math.round(clamp(bpm, 20, 220));
        settings.bpm = bpm;
        bpmInput.value = String(bpm);
        bpmTypable?.refresh();
        if (!skipSpeedThumb) speedDial?.set(speedTFromBpm(bpm));
        engine.setParams({ bpm, speed: 1 });
        persistSettings();
      }

      bpmInput.addEventListener('input', () => {
        setTempo(parseInt(bpmInput.value, 10));
      });

      // ---- simple dials (built once knobApi has loaded, further down) ---
      // Commit bodies for Complexity/Repetition/Volume/Randomness live next
      // to buildSimpleDial(); this is the fan-out helper Randomness needs.

      function meanRandomness() {
        const vals = TRACK_IDS.map((id) =>
          rangeMid(sanitiseRangeValueIn(settings.tracks[id].randomness, 0, 1, 0.5))
        );
        return vals.reduce((a, b) => a + b, 0) / vals.length;
      }

      /**
       * What the Simple tab's fused Randomness dial should READ. Normally the
       * dial's own x, recovered exactly: every track carries the same
       * randomness and repetition is its mirror (1 - x), so the shared value —
       * range included — is handed straight back. Once the Advanced tab has
       * hand-set repetition or an individual track's randomness to something
       * no single x could produce, it falls back to the blended estimate
       * ((1 - repetition) + mean(randomness)) / 2: a display only, exactly
       * like the combined-complexity read-out, never written anywhere.
       */
      function fusedRandomnessValue() {
        const first = settings.tracks[TRACK_IDS[0]].randomness;
        const shape = JSON.stringify(first);
        const uniform = TRACK_IDS.every(
          (id) => JSON.stringify(settings.tracks[id].randomness) === shape
        );
        const mid = rangeMid(sanitiseRangeValueIn(first, 0, 1, 0.5));
        if (uniform && Math.abs(1 - settings.repetition - mid) < 0.02) return first;
        return clamp((1 - settings.repetition + meanRandomness()) / 2, 0, 1);
      }

      for (const [select, key] of [
        [rootSelect, 'root'],
        [modeSelect, 'mode'],
        [timeSignatureSelect, 'timeSignature'],
      ]) {
        select.addEventListener('change', () => {
          settings[key] = select.value;
          engine.setParams({ [key]: select.value });
          if (key === 'timeSignature') {
            // Metre drives steps-per-bar: re-render any open step grids.
            for (const ed of openEditors.values()) {
              try {
                ed.seq?.refresh();
              } catch {}
            }
          }
          persistSettings();
        });
      }

      // ---- tabs ----------------------------------------------------------

      const tabButtons = [
        document.getElementById('tab-simple'),
        document.getElementById('tab-advanced'),
      ];
      const tabPanels = {
        simple: document.getElementById('panel-simple'),
        advanced: document.getElementById('panel-advanced'),
      };
      const tabNames = ['simple', 'advanced'];

      function activateTab(name, { focus = false, persist = true } = {}) {
        if (!tabNames.includes(name)) name = 'simple';
        tabButtons.forEach((button, i) => {
          const active = tabNames[i] === name;
          button.setAttribute('aria-selected', String(active));
          button.tabIndex = active ? 0 : -1;
          tabPanels[tabNames[i]].hidden = !active;
          if (active && focus) button.focus();
        });
        applyTransportVisibility(name);
        // v18: the scope and the piano roll sit above the tab strip and are
        // never hidden by a tab change, so switching tabs no longer touches
        // the trace at all.
        if (settings.ui.activeTab !== name) {
          settings.ui.activeTab = name;
          if (persist) persistSettings();
        }
      }

      tabButtons.forEach((button, i) => {
        button.addEventListener('click', () => activateTab(tabNames[i]));
        button.addEventListener('keydown', (event) => {
          let target = null;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            target = (i + 1) % tabNames.length;
          } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            target = (i - 1 + tabNames.length) % tabNames.length;
          } else if (event.key === 'Home') {
            target = 0;
          } else if (event.key === 'End') {
            target = tabNames.length - 1;
          }
          if (target !== null) {
            event.preventDefault();
            activateTab(tabNames[target], { focus: true });
          }
        });
      });

      // ---- tracks section ------------------------------------------------

      // A default-off track (v8: melody/bass ship silent) needs its state
      // obvious at a glance, not just implied by which segmented pill is
      // lit — data-track-state drives a textual "— Off" cue in CSS so the
      // listener isn't left wondering why a track is silent. v12: the same
      // data-track-state attribute also drives the track-row lamp's dot
      // colour (off/auto/on), so the row's aria-label is refreshed here too.
      const TRACK_STATE_TEXT = { off: 'Off', auto: 'Auto', on: 'On' };

      function syncTrackOffIndicator(id) {
        const row = document.querySelector(`.track-row[data-track="${id}"]`);
        const state = settings.tracks[id].state;
        if (row) row.dataset.trackState = state;
        const lamp = document.getElementById(`track-lamp-${id}`);
        if (lamp) {
          lamp.setAttribute(
            'aria-label',
            `${TRACK_LABELS[id]} state: ${TRACK_STATE_TEXT[state] || state}. Press to cycle Off, Auto, On.`
          );
        }
      }

      // v14: the Off/Auto/On segmented control moved OUT of the row (which is
      // now a single line: lamp+name, voice, Level, Randomness, Edit) and
      // into the Edit panel header, so it exists only while that editor is
      // open. Instances register here; the row lamp is the always-present
      // state control.
      const stateControls = new Map(); // track -> { set(state) }

      function syncTrackStateUI() {
        for (const id of TRACK_IDS) {
          stateControls.get(id)?.set(settings.tracks[id].state);
          syncTrackOffIndicator(id);
        }
        updateComplexityDisplay();
      }

      function buildStateControl(container, track) {
        const group = document.createElement('div');
        group.className = 'segmented track-state';
        group.setAttribute('role', 'radiogroup');
        group.setAttribute('aria-label', `${TRACK_LABELS[track]} state`);
        const radios = [];
        for (const state of TRACK_STATE_CYCLE) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `track-state-${track}`;
          input.id = `track-${track}-${state}`;
          input.value = state;
          input.checked = settings.tracks[track].state === state;
          const label = document.createElement('label');
          label.htmlFor = input.id;
          label.textContent = TRACK_STATE_TEXT[state];
          input.addEventListener('change', () => {
            if (!input.checked) return;
            setTrackState(track, state);
          });
          group.append(input, label);
          radios.push(input);
        }
        container.append(group);
        const handle = {
          set: (state) => {
            for (const input of radios) input.checked = input.value === state;
          },
        };
        stateControls.set(track, handle);
        return handle;
      }

      // v12: single commit path for a track's state — the segmented radios
      // AND the track-row lamp button both funnel through this, so they can
      // never desync from one another.
      const TRACK_STATE_CYCLE = ['off', 'auto', 'on'];

      function setTrackState(id, state) {
        settings.tracks[id].state = state;
        engine.setParams({ tracks: { [id]: { state } } });
        updateComplexityDisplay();
        syncTrackOffIndicator(id);
        stateControls.get(id)?.set(state);
        // Off/on both move whether THIS track's own open editor may show the
        // live trace (updateScopeMode) — with no explicit chip selection the
        // scope also traces "everything that isn't off", so a state change
        // moves the front scope's default set too (updateFrontScope).
        updateScopeMode(id);
        updateFrontScope();
        persistSettings();
      }

      // Short "what does this one sound like" hints on the voice selects —
      // the kit hints the v13 round asked for, extended to every track.
      // Hoisted above the first describe() caller — `let` after the call
      // site is a temporal-dead-zone crash (shipped blank-page bug, 6105e0d).
      let tipSeq = 0;

      const VOICE_HINTS = {
        pad: 'The sustained chord bed. Warm is the default; Glass is brighter, Choir the most vocal.',
        arp: 'The broken-chord line. Soft pluck sits back, Crystal cuts through, Marimba is woody.',
        melody: 'The tune. Pluck and Keys are struck; Flute and Bell ring on.',
        bass: 'The bottom. Sub is pure weight, Round has body, Breath adds air.',
        texture: 'The atmosphere between the notes. Wash is the widest, Grains the grittiest.',
        percussion: 'The kit. Soft kit is brushed and quiet, Hand drum is warm and tuned, Ticks is a dry pulse.',
      };

      // ---- v18 voice-selector honesty ------------------------------------
      // What each track is ACTUALLY sounding, from the engine's voice wander.
      // Declared HERE, above every caller (the voices-module .then below can
      // resolve during a later await in init) — a `let`/`const` further down
      // would be a temporal-dead-zone crash, the shipped blank-page bug.
      const soundingVoice = new Map();
      const VOICE_LIVE_VALUE = '__live';

      for (const id of TRACK_IDS) {
        const voiceSelect = document.getElementById(`track-voice-${id}`);
        const lamp = document.getElementById(`track-lamp-${id}`);
        describe(voiceSelect, VOICE_HINTS[id]);
        if (lamp) describe(lamp, 'Off never plays · Auto lets the generator decide · On always plays.');

        if (lamp) {
          lamp.addEventListener('click', () => {
            const cur = settings.tracks[id].state;
            const next = TRACK_STATE_CYCLE[(TRACK_STATE_CYCLE.indexOf(cur) + 1) % TRACK_STATE_CYCLE.length];
            setTrackState(id, next);
          });
        }

        voiceSelect.addEventListener('change', () => {
          // The dynamic "what you're hearing" option is display-only and
          // disabled, so it can never be the user's pick — but a stray
          // programmatic change event must not store it as a voice id.
          if (voiceSelect.value === VOICE_LIVE_VALUE) return;
          settings.tracks[id].voice = voiceSelect.value;
          engine.setParams({ tracks: { [id]: { voice: voiceSelect.value } } });
          persistSettings();
          soundingVoice.delete(id);
          refreshVoiceSelect(id);
          const editor = document.getElementById(`voice-editor-${id}`);
          if (!editor.hidden) renderVoiceEditor(id);
        });
      }

      // ---- voice editors (v3 patch model, v5 module look) ---------------

      let voicesModulePromise = null;
      // The resolved table, kept for the synchronous readers (the v18 voice
      // selector needs .defaults / .engineType without awaiting anything).
      let voicesTable = null;
      function getVoicesTable() {
        if (!voicesModulePromise) {
          voicesModulePromise = import('../scripts/engine-voices.js')
            .then((m) => {
              voicesTable = m.VOICES || null;
              return voicesTable;
            })
            .catch(() => null);
        }
        return voicesModulePromise;
      }

      // The voice table carries the defaults and engineType the v18 selector
      // needs; it lands asynchronously, so the labels are redrawn on arrival.
      // Called BELOW getVoicesTable's own `let`s, not from the row-wiring loop
      // above them — the same temporal-dead-zone trap as everything else here.
      getVoicesTable().then(() => {
        for (const id of TRACK_IDS) refreshVoiceSelect(id);
      });

      function sendPatch(track, voiceId, patch) {
        engine.setParams({ patches: { [track]: { [voiceId]: structuredClone(patch) } } });
      }

      /**
       * A track's current effective patch (voice defaults + any stored user
       * override), the same resolution renderVoiceEditor uses to open on the
       * sound you can hear. Used outside an open editor too — the front
       * oscilloscope's stopped-state composite preview reads it per selected
       * track. Degrades to FALLBACK_PATCH + override alone if the voices
       * module hasn't landed yet (voicesTable still null).
       */
      function resolveTrackPatch(track, voiceId) {
        const voiceEntry =
          voicesTable && voicesTable[track] && voicesTable[track][voiceId]
            ? voicesTable[track][voiceId]
            : null;
        const defaults = voiceEntry && voiceEntry.defaults ? voiceEntry.defaults : null;
        const base = deepMerge(FALLBACK_PATCH, defaults || {});
        const patch = deepMerge(base, (settings.patches[track] || {})[voiceId] || {});
        writeShape(patch.source, 1, readShape(patch.source, 1) ?? 0);
        writeShape(patch.source, 2, readShape(patch.source, 2));
        return patch;
      }

      // Optional v5 modules. Either can be absent or broken — the editor
      // then degrades: no knob.js → the slider/select controls below; no
      // scope.js → no scope head, knobs still work.
      let knobApi = null;
      let scopeApi = null;
      try {
      const m = await import('../scripts/knob.js');
        if (m && typeof m.createKnob === 'function') knobApi = m;
      } catch {}
      try {
      const m = await import('../scripts/scope.js');
        if (m && typeof m.renderPatchWave === 'function') scopeApi = m;
      } catch {}

      // Representative pitch for the static scope trace, per track register.
      const SCOPE_FREQ = { pad: 220, bass: 55, melody: 330, texture: 440, arp: 330, percussion: 220 };

      // ---- v6: per-track Random / Hold / Randomness + vary targets ------

      const pctFormat = (v) => `${Math.round(v * 100)}%`;

      // ---- v13 tooltips + ⓘ info boxes -----------------------------------
      // Native `title` is unreachable by touch and unreliable by keyboard, so
      // compact labels get a themed tooltip shown on hover AND focus, plus a
      // visually-hidden description node the control points at with
      // aria-describedby (so the text reaches AT even when nothing is drawn).
      const tooltipEl = document.createElement('div');
      tooltipEl.className = 'ui-tooltip';
      tooltipEl.setAttribute('role', 'tooltip');
      tooltipEl.hidden = true;
      document.body.append(tooltipEl);

      function hideTooltip() {
        tooltipEl.hidden = true;
      }

      function showTooltip(el, text) {
        tooltipEl.textContent = text;
        tooltipEl.hidden = false;
        const r = el.getBoundingClientRect();
        const w = tooltipEl.offsetWidth;
        const left = clamp(r.left + r.width / 2 - w / 2, 8, Math.max(8, window.innerWidth - w - 8));
        tooltipEl.style.left = `${left + window.scrollX}px`;
        tooltipEl.style.top = `${r.bottom + window.scrollY + 6}px`;
      }

      /** Attach a hover/focus tooltip + an AT description. Returns `el`. */
      function describe(el, text) {
        if (!el || !text) return el;
        let descId = el.getAttribute('aria-describedby');
        if (!descId && el.parentNode) {
          const desc = document.createElement('span');
          desc.className = 'visually-hidden';
          desc.id = `ui-desc-${++tipSeq}`;
          desc.textContent = text;
          el.parentNode.insertBefore(desc, el.nextSibling);
          descId = desc.id;
          el.setAttribute('aria-describedby', descId);
        }
        el.addEventListener('pointerenter', () => showTooltip(el, text));
        el.addEventListener('pointerleave', hideTooltip);
        el.addEventListener('focus', () => showTooltip(el, text));
        el.addEventListener('blur', hideTooltip);
        return el;
      }

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hideTooltip();
      });

      // ---- v13 click-to-type on page-level numeric readouts ---------------
      // knob.js already does this for every dial readout. This is the same
      // gesture for the numbers the page owns outside a knob: the readout is
      // a button, clicking (or Enter/Space) swaps it for a text input, and
      // Enter/blur commits through the SAME clamp path as the control it
      // mirrors. Escape cancels. Zero cost while idle.
      function makeTypable(host, { read, commit, format, label }) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'typable';
        button.setAttribute('aria-label', label);
        const refresh = () => {
          button.textContent = format(read());
        };
        refresh();
        button.addEventListener('click', () => {
          const input = document.createElement('input');
          input.type = 'text';
          input.className = 'typable-input';
          input.setAttribute('aria-label', label);
          input.value = String(read());
          host.replaceChild(input, button);
          input.focus();
          input.select();
          const done = (save) => {
            if (input.parentNode !== host) return;
            host.replaceChild(button, input);
            const parsed = parseFloat(input.value);
            if (save && Number.isFinite(parsed)) commit(parsed);
            refresh();
            button.focus();
          };
          input.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
              event.preventDefault();
              done(true);
            } else if (event.key === 'Escape') {
              event.preventDefault();
              done(false);
            }
          });
          input.addEventListener('blur', () => done(true));
        });
        host.innerHTML = '';
        host.append(button);
        return { refresh };
      }

      /** A small ⓘ button that toggles a dismissable info box under it. */
      function infoButton(container, title, body) {
        const wrap = document.createElement('span');
        wrap.className = 'info-anchor';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'round-button info-button';
        btn.textContent = 'i';
        btn.setAttribute('aria-label', `About ${title}`);
        btn.setAttribute('aria-expanded', 'false');
        const box = document.createElement('div');
        box.className = 'info-box module-panel';
        box.hidden = true;
        box.textContent = body;
        btn.addEventListener('click', () => {
          const open = box.hidden;
          box.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        });
        box.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          box.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        });
        wrap.append(btn, box);
        container.append(wrap);
        return wrap;
      }

      // ---- v14 randomness = the hold control ------------------------------
      // The Random button and the Hold toggle are gone: this one dial does
      // both jobs. 0 means "hold" — the engine keeps looping the material it
      // is playing now — and re-rolls scale in as the dial rises.
      const HOLD_EPSILON = 0.0001;
      const RANDOMNESS_HINT = '0 = hold: loops the current bars exactly. Higher re-rolls more often.';

      function isHoldValue(v) {
        return rangeMid(sanitiseRangeValueIn(v, 0, 1, 0.5)) <= HOLD_EPSILON;
      }

      const randomnessFormat = (v) => (v <= HOLD_EPSILON ? 'Hold' : pctFormat(v));

      // ---- v12: Simple tab music-box dials --------------------------------
      // knob.js when available, native <input type=range> fallback when not
      // (per-dial: whichever built cleanly). Both paths funnel into the same
      // commit callback, so there's exactly one source of truth per dial —
      // no shadow/dual-wiring, no reentrancy to reason about.
      // v14 single labelling: knob.js draws the dial's own name under the
      // face, so the markup's <label> row (which exists for the no-knob
      // slider fallback) is hidden the moment a knob builds — the name then
      // appears exactly once. The end-marks (`.dial-ends`, "Slow"/"Fast" at
      // the tick extremes) live in the markup and are never removed, so a
      // failed knob build must not wipe the slot wholesale.
      function buildSimpleDial(dialId, opts, commit) {
        const box = document.getElementById(dialId);
        if (!box) return { set() {} };
        const control = box.closest('.control');
        const labelRow = control ? control.querySelector('.control-label-row') : null;
        if (knobApi) {
          try {
            const handle = knobApi.createKnob(box, { ...opts, onInput: commit });
            if (labelRow) labelRow.hidden = true;
            if (control) control.classList.add('dial-knob');
            return {
              el: handle.el,
              set: (v) => {
                try {
                  handle.set?.(v);
                } catch {}
              },
            };
          } catch {
            for (const stale of box.querySelectorAll('.knob')) stale.remove();
          }
        }
        if (control) control.classList.add('dial-fallback');
        const input = document.createElement('input');
        input.type = 'range';
        if (opts.id) input.id = opts.id;
        input.min = String(opts.min);
        input.max = String(opts.max);
        if (opts.step) input.step = String(opts.step);
        const initial = typeof opts.value === 'object' ? (opts.value.min + opts.value.max) / 2 : opts.value;
        input.value = String(initial);
        box.append(input);
        input.addEventListener('input', () => commit(parseFloat(input.value)));
        return {
          el: input,
          set: (v) => {
            input.value = String(typeof v === 'object' ? (v.min + v.max) / 2 : v);
          },
        };
      }

      /**
       * The same dial in two places (Simple, and the foot of Advanced) as two
       * VIEWS of one value — not two params. Each view commits through the one
       * shared callback and then pushes the new value into its sibling, so
       * either can be dragged and both stay honest. The dragged view is never
       * written back to mid-gesture (that fights the pointer), which is the
       * same rule `setTempo`'s skipSpeedThumb already followed.
       */
      function buildMirroredDial(slots, opts, commit) {
        const handles = [];
        const set = (value, except) => {
          for (const handle of handles) {
            if (handle !== except) handle.set(value);
          }
        };
        for (const [slotId, suffix] of slots) {
          let handle = null;
          handle = buildSimpleDial(
            slotId,
            { ...opts, ...(opts.id ? { id: opts.id + suffix } : {}) },
            (value) => {
              commit(value);
              set(value, handle);
            }
          );
          handles.push(handle);
        }
        return {
          el: handles.length ? handles[0].el : null,
          els: handles.map((handle) => handle.el).filter(Boolean),
          set: (value) => set(value, null),
        };
      }

      /** Attach the same tooltip/description to every view of a mirrored dial. */
      function describeDial(dial, text) {
        for (const el of dial.els || [dial.el]) describe(el, text);
        return dial;
      }

      // Slot pairs: the Simple tab's dial and its Advanced-tab twin.
      const MAIN_DIAL_SLOTS = (name) => [
        [`${name}-dial`, ''],
        [`${name}-dial-adv`, '-adv'],
      ];

      speedDial = buildMirroredDial(
        MAIN_DIAL_SLOTS('speed'),
        {
          id: 'speed',
          label: 'Tempo',
          min: 0,
          max: 1,
          step: 0.001,
          value: speedTFromBpm(settings.bpm),
          format: (t) => `${Math.round(bpmFromSpeedT(t))} bpm`,
          defaultValue: speedTFromBpm(DEFAULTS.bpm),
        },
        (t) => setTempo(bpmFromSpeedT(t), { skipSpeedThumb: true })
      );

      complexityDial = buildMirroredDial(
        MAIN_DIAL_SLOTS('complexity'),
        {
          id: 'complexity',
          label: 'Complexity',
          min: 0,
          max: 1,
          step: 0.01,
          value: settings.complexity,
          format: pctFormat,
          defaultValue: DEFAULTS.complexity,
        },
        (value) => {
          // Moving Complexity is an explicit "let the engine decide" gesture:
          // structure, arp mode and every track state return to Auto, then
          // the new complexity is sent.
          settings.complexity = value;
          settings.structure = 'auto';
          settings.arp.mode = 'auto';
          for (const id of TRACK_IDS) settings.tracks[id].state = 'auto';
          syncStructureUI();
          syncArpUI();
          syncTrackStateUI();
          const trackStates = {};
          for (const id of TRACK_IDS) trackStates[id] = { state: 'auto' };
          engine.setParams({
            complexity: value,
            structure: 'auto',
            arp: { mode: 'auto' },
            tracks: trackStates,
          });
          persistSettings();
        }
      );

      // Advanced keeps Repetition as its own dial (the Simple tab's fused
      // Randomness dial writes it, but hand-setting it here is what makes
      // that dial fall back to its blended read-out).
      repetitionDial = buildSimpleDial(
        'repetition-dial',
        {
          id: 'repetition',
          label: 'Repetition',
          min: 0,
          max: 1,
          step: 0.01,
          value: settings.repetition,
          format: pctFormat,
          defaultValue: DEFAULTS.repetition,
        },
        (value) => {
          settings.repetition = value;
          engine.setParams({ repetition: value });
          randomnessDial?.set(fusedRandomnessValue());
          persistSettings();
        }
      );

      // ONE dial for "how much does this thing change" (user decision, v15):
      // Repetitive ← Evolving → Random. It drives BOTH halves of that
      // question in a single setParams: repetition = 1 - x (tight hook at 0,
      // loose at 1) and every track's randomness = x (perfect-loop hold at 0,
      // maximal wander at 1). Advanced still exposes the two separately; when
      // they're hand-set to a pair no single x could produce, this dial just
      // shows the blended estimate (fusedRandomnessValue) without touching
      // them — the same interlink manners as Complexity.
      //
      // Range capability is asymmetric on purpose: tracks[t].randomness is a
      // genuine RangeValue, but repetition is a top-level engine param and
      // ambient-engine.js's NUMERIC_RANGES only accept plain numbers there.
      // So a range from this dial is written verbatim to every track's
      // randomness, and repetition takes 1 - (midpoint of that range).
      randomnessDial = buildMirroredDial(
        MAIN_DIAL_SLOTS('randomness'),
        {
          id: 'randomness',
          label: 'Randomness',
          min: 0,
          max: 1,
          step: 0.01,
          marks: [0, 0.5, 1],
          value: fusedRandomnessValue(),
          format: randomnessFormat,
          allowRange: true,
          defaultValue: DEFAULTS.tracks.pad.randomness,
        },
        (value) => {
          const repetition = clamp(1 - rangeMid(sanitiseRangeValueIn(value, 0, 1, 0.5)), 0, 1);
          settings.repetition = repetition;
          const trackStates = {};
          for (const id of TRACK_IDS) {
            settings.tracks[id].randomness = value;
            settings.tracks[id].hold = isHoldValue(value);
            trackStates[id] = { randomness: value, hold: settings.tracks[id].hold };
          }
          engine.setParams({ repetition, tracks: trackStates });
          repetitionDial?.set(repetition);
          syncAllTrackExtras();
          persistSettings();
        }
      );
      describeDial(
        randomnessDial,
        `${RANDOMNESS_HINT} It sets repetition and every track's randomness together.`
      );

      volumeDial = buildMirroredDial(
        MAIN_DIAL_SLOTS('volume'),
        {
          id: 'volume',
          label: 'Volume',
          min: 0,
          max: 1,
          step: 0.01,
          value: settings.volume,
          // Hi-fi attenuator convention: dB relative to full output.
          format: (v) => (v <= 0.001 ? '-\u221e dB' : `${(20 * Math.log10(v)).toFixed(v > 0.5 ? 1 : 0)} dB`),
          marks: [0, 0.1, 0.25, 0.5, 0.8, 1],
          defaultValue: DEFAULTS.volume,
        },
        (value) => {
          settings.volume = value;
          engine.setParams({ volume: value });
          persistSettings();
        }
      );

      bpmTypable = makeTypable(bpmReadout, {
        read: () => settings.bpm,
        commit: (v) => setTempo(v),
        format: (v) => String(v),
        label: 'Beats per minute — click to type a value',
      });

      // ---- v14 Swing (global; Advanced tab) -------------------------------
      // Only rendered when the engine advertises the param — a dial that
      // visibly does nothing is worse than no dial.
      if (engineCaps.swing) {
        const swingControl = document.getElementById('dial-swing');
        if (swingControl) swingControl.hidden = false;
        swingDial = buildSimpleDial(
          'swing-dial',
          {
            id: 'swing',
            label: 'Swing',
            min: 0,
            max: 1,
            step: 0.01,
            value: settings.swing,
            format: (v) => (v <= 0.005 ? 'Straight' : pctFormat(v)),
            defaultValue: DEFAULTS.swing,
          },
          (value) => {
            settings.swing = value;
            engine.setParams({ swing: value });
            persistSettings();
          }
        );
        describe(
          swingDial.el,
          'Delays every off-beat subdivision — straight at 0, a classic long-short shuffle at the top. Sequencers, arp and percussion all follow it.'
        );
      }

      // ---- v21 reverb tail (global; Advanced tab) --------------------------
      // 0.5–6 s of impulse response. The engine owns the initial value — the
      // page never invents one, so a build that has no reverbTail param yet
      // renders no dial rather than a dial that lies. The power governor caps
      // the tail on top (see applyPowerBudget): the USER's setting is what is
      // stored and shown, the capped value is only what the engine is sent.
      if (engineCaps.reverbTail || engineCaps.setReverbSeconds) {
        const control = document.getElementById('dial-reverb-tail');
        if (control) control.hidden = false;
        const shipped = engineReverbTail ?? 2;
        const stored = typeof settings.reverbTail === 'number' && Number.isFinite(settings.reverbTail)
          ? clamp(settings.reverbTail, 0.5, 6)
          : shipped;
        settings.reverbTail = stored;
        reverbTailDial = buildSimpleDial(
          'reverb-tail-dial',
          {
            id: 'reverbTail',
            label: 'Reverb tail',
            min: 0.5,
            max: 6,
            step: 0.1,
            value: stored,
            format: (v) => `${plainFormat(v)} s`,
            defaultValue: shipped,
          },
          (value) => {
            settings.reverbTail = clamp(rangeMid(value), 0.5, 6);
            applyReverbTail();
            persistSettings();
          }
        );
        describe(
          reverbTailDial.el,
          'How long the reverb rings on — a small room at the left, a cathedral at the right. Eco and Low processor settings shorten it whatever this says.'
        );
        applyReverbTail();
      }

      // ---- v21 chord length (harmony.rhythm; Advanced tab, near Structure) --
      if (engineCaps.harmonyRhythm) {
        if (chordLengthControl) chordLengthControl.hidden = false;
        chordLengthSelect.value = String(settings.harmony.rhythm);
        chordLengthSelect.addEventListener('change', () => {
          const raw = chordLengthSelect.value;
          const value = raw === 'auto' ? 'auto' : Number(raw);
          settings.harmony.rhythm = value;
          engine.setParams({ harmony: { rhythm: value } });
          persistSettings();
        });
        describe(
          chordLengthSelect,
          'How many bars the chord progression holds each chord for. Auto lets the hook decide.'
        );
      }

      const DICE_SVG =
        '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">' +
        '<rect x="3" y="3" width="18" height="18" rx="3"/>' +
        '<circle cx="8" cy="8" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="16" cy="8" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="8" cy="16" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="16" cy="16" r="1.4" fill="currentColor" stroke="none"/>' +
        '</svg>';

      // The same Random/Hold/Randomness cluster renders in the tracks-panel
      // row AND in the track's Edit panel header; instances register here so
      // a change through one mirror syncs the other.
      const extrasInstances = new Map(); // track -> Set of instances

      function registerExtras(track, inst) {
        if (!extrasInstances.has(track)) extrasInstances.set(track, new Set());
        extrasInstances.get(track).add(inst);
      }

      function unregisterExtras(track, inst) {
        if (inst) extrasInstances.get(track)?.delete(inst);
      }

      function syncTrackExtras(track, skip) {
        const set = extrasInstances.get(track);
        if (!set) return;
        for (const inst of set) {
          if (inst !== skip && inst.setRand) {
            inst.setRand(settings.tracks[track].randomness);
          }
        }
      }

      function syncAllTrackExtras() {
        for (const id of TRACK_IDS) syncTrackExtras(id);
      }

      // v14: the Random button and Hold toggle are GONE from the row — the
      // Randomness dial alone drives both (0 = hold). engine.randomise() is
      // kept for power use behind a small dice icon, and only inside the Edit
      // panel header (`withDice`), never in the row.
      function buildTrackExtras(container, track, { knobs = null, withDice = false } = {}) {
        const inst = { setRand: null };
        if (withDice && engineCaps.randomise) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'round-button track-random';
          btn.innerHTML = DICE_SVG;
          btn.setAttribute('aria-label', `Re-roll ${TRACK_LABELS[track]}`);
          btn.addEventListener('click', () => {
            try {
              engine.randomise(track);
            } catch {}
          });
          container.append(btn);
          describe(btn, `Re-roll ${TRACK_LABELS[track]}'s material from the next bar.`);
        }
        if (engineCaps.randomness[track]) {
          // v7/v8: the capability probe (engineCaps.randomness, built from
          // isNumberOrRange) already accepts a RangeValue reply from the
          // engine, so — per the v8 ruling ("randomness stays a number
          // default until the page probe widens") — this control can now
          // ship rangeDefault: true. onValue is fed straight from the knob
          // (number|{min,max}, already clamped/quantised by knob.js).
          const onValue = (v) => {
            v = sanitiseRangeValueIn(v, 0, 1, 0.5);
            settings.tracks[track].randomness = v;
            // One dial, both params: the engine keeps `hold` as its own
            // switch, the UI drives it off the dial's zero position.
            settings.tracks[track].hold = isHoldValue(v);
            engine.setParams({
              tracks: { [track]: { randomness: v, hold: settings.tracks[track].hold } },
            });
            syncTrackExtras(track, inst);
            // Keep the Simple tab's fused Randomness dial current when a
            // single track's own knob moves independently of the others —
            // it falls back to its blended read-out (display only).
            randomnessDial?.set(fusedRandomnessValue());
            persistSettings();
          };
          if (knobApi) {
            const cell = document.createElement('div');
            cell.className = 'rand-knob';
            container.append(cell);
            try {
              const handle = knobApi.createKnob(cell, {
                label: 'Randomness',
                min: 0,
                max: 1,
                value: sanitiseRangeValueIn(settings.tracks[track].randomness, 0, 1, 0.5),
                format: randomnessFormat,
                allowRange: true,
                rangeDefault: true,
                defaultValue: DEFAULTS.tracks[track].randomness,
                onInput: onValue,
              });
              describe(handle.el, RANDOMNESS_HINT);
              if (knobs) knobs.push(handle);
              inst.setRand = (v) => {
                try {
                  handle.set?.(v);
                } catch {}
              };
            } catch {
              cell.remove();
            }
          }
          if (!inst.setRand) {
            // Slider fallback (no knob.js): single-value only, same
            // midpoint-display / collapse-on-edit policy as the voice
            // editor's slider fallback.
            const wrap = document.createElement('label');
            wrap.className = 'rand-slider';
            const name = document.createElement('span');
            name.className = 'visually-hidden';
            name.textContent = `${TRACK_LABELS[track]} randomness. ${RANDOMNESS_HINT}`;
            const input = document.createElement('input');
            input.type = 'range';
            input.min = '0';
            input.max = '1';
            input.step = '0.01';
            input.value = String(rangeMid(sanitiseRangeValueIn(settings.tracks[track].randomness, 0, 1, 0.5)));
            input.addEventListener('input', () => onValue(parseFloat(input.value)));
            wrap.append(name, input);
            container.append(wrap);
            describe(input, RANDOMNESS_HINT);
            inst.setRand = (v) => {
              input.value = String(rangeMid(sanitiseRangeValueIn(v, 0, 1, 0.5)));
            };
          }
        }
        return inst;
      }

      // Vary knobs run on a 22-position scale: raw 0 is the Auto detent
      // (null — "follows Randomness"); raw 1–21 map to explicit 0–100%.
      // v16: vary aspects are rangeable (v7 list; the engine walks vary.* per
      // bar exactly as it walks randomness), so raw may arrive as {min,max}.
      // The Auto detent is a SINGLE-value state only — a range always spans
      // explicit percentages, so its min thumb floors at raw 1, and a range
      // that collapses onto the detent reads as Auto again.
      const varyPct = (raw) => clamp((Math.round(raw) - 1) / 20, 0, 1);
      const varyFormat = (raw) =>
        Math.round(raw) <= 0 ? 'Auto (follows Randomness)' : pctFormat(varyPct(raw));
      const varyRawNumber = (v) => (v === null ? 0 : 1 + Math.round(clamp(v, 0, 1) * 20));
      const varyRawFromValue = (v) => (isPlainObject(v) ? mapRV(v, varyRawNumber) : varyRawNumber(v));
      const varyValueFromRaw = (raw) => {
        if (isPlainObject(raw)) {
          if (Math.round(raw.max) <= 0) return null;
          return { min: varyPct(Math.max(1, raw.min)), max: varyPct(raw.max) };
        }
        return Math.round(raw) <= 0 ? null : varyPct(raw);
      };

      function buildVaryRow(container, track, knobs) {
        if (!engineCaps.vary[track]) return;
        const row = document.createElement('div');
        row.className = 'vary-row';
        const title = document.createElement('span');
        title.className = 'panel-label';
        title.textContent = 'Randomise';
        const cells = document.createElement('div');
        cells.className = 'vary-cells';
        row.append(title, cells);
        container.append(row);

        for (const [key, label] of VARY_KEYS) {
          const commitVary = (value) => {
            settings.tracks[track].vary[key] = value;
            engine.setParams({ tracks: { [track]: { vary: { [key]: value } } } });
            persistSettings();
          };
          const raw = varyRawFromValue(settings.tracks[track].vary[key]);
          // Which shape the value currently has, so the readout can tell the
          // Auto detent (single mode, raw 0) from a range whose min thumb
          // happens to be sitting at the bottom of the scale (0%).
          let ranged = isPlainObject(settings.tracks[track].vary[key]);
          let built = false;
          if (knobApi) {
            const cell = document.createElement('div');
            cell.className = 'vary-knob';
            cells.append(cell);
            try {
              const handle = knobApi.createKnob(cell, {
                label,
                min: 0,
                max: 21,
                step: 1,
                value: raw,
                marks: [0],
                format: (v) => (ranged ? pctFormat(varyPct(Math.max(1, v))) : varyFormat(v)),
                allowRange: true,
                // DEFAULTS.tracks[*].vary is all-null (the Auto detent, raw 0)
                // for every track/key — dblclick returns to "follows Randomness".
                defaultValue: 0,
                onInput: (v) => {
                  const value = varyValueFromRaw(v);
                  ranged = isPlainObject(value);
                  commitVary(value);
                },
              });
              describe(
                handle.el,
                `How much ${TRACK_LABELS[track]}'s ${label.toLowerCase()} varies. At the left detent it follows this track's Randomness dial; anywhere else overrides it.`
              );
              if (knobs) knobs.push(handle);
              built = true;
            } catch {
              cell.remove();
            }
          }
          if (!built) {
            // Slider fallback (no knob.js): single-value only — it shows the
            // midpoint of a loaded range and collapses it on the first edit,
            // the same policy the Level/Randomness fallbacks follow.
            const rawMid = Math.round(rangeMid(raw));
            const wrap = document.createElement('div');
            wrap.className = 'control vary-slider';
            const id = `vary-${track}-${key}`;
            const lrow = document.createElement('div');
            lrow.className = 'control-label-row';
            const lab = document.createElement('label');
            lab.htmlFor = id;
            lab.textContent = label;
            const readout = document.createElement('span');
            readout.className = 'value-readout';
            readout.textContent = varyFormat(rawMid);
            lrow.append(lab, readout);
            const input = document.createElement('input');
            input.type = 'range';
            input.id = id;
            input.min = '0';
            input.max = '21';
            input.step = '1';
            input.value = String(rawMid);
            input.setAttribute('aria-valuetext', varyFormat(rawMid));
            input.addEventListener('input', () => {
              const r = parseInt(input.value, 10) || 0;
              readout.textContent = varyFormat(r);
              input.setAttribute('aria-valuetext', varyFormat(r));
              commitVary(varyValueFromRaw(r));
            });
            wrap.append(lrow, input);
            cells.append(wrap);
          }
        }
      }

      // ---- v12 mono + glide (melodic tracks; engine params since v12) -----
      // A monophonic track sounds one note at a time and slurs between them,
      // which is what turns a generative line into something singable. Both
      // params existed engine-side without UI; the toggle and the dial sit in
      // the editor header beside the state lamp, because "one note at a time"
      // is a property of the LINE, not of the patch.
      const MONO_HINT =
        'One note at a time: each new note ends the one before it, the way a voice or a wind instrument plays.';
      const GLIDE_HINT =
        'How far each note slides into the next one. Off is a clean step; higher slurs between pitches. Mono only.';

      function buildMonoGlide(container, track, knobs) {
        if (!engineCaps.mono[track] && !engineCaps.glide[track]) return;
        if (engineCaps.mono[track]) {
          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'secondary-button mono-toggle';
          toggle.textContent = 'Mono';
          toggle.setAttribute('aria-pressed', String(settings.tracks[track].mono === true));
          toggle.setAttribute('aria-label', `${TRACK_LABELS[track]} monophonic`);
          toggle.addEventListener('click', () => {
            const on = toggle.getAttribute('aria-pressed') !== 'true';
            toggle.setAttribute('aria-pressed', String(on));
            settings.tracks[track].mono = on;
            engine.setParams({ tracks: { [track]: { mono: on } } });
            persistSettings();
          });
          container.append(toggle);
          describe(toggle, MONO_HINT);
        }
        if (!engineCaps.glide[track]) return;
        // Not rangeable: the engine reads glide with numberIn(), so a
        // {min,max} would be dropped on the floor.
        const commitGlide = (v) => {
          const value = clamp(rangeMid(v), 0, 1);
          settings.tracks[track].glide = value;
          engine.setParams({ tracks: { [track]: { glide: value } } });
          persistSettings();
        };
        const value = clamp(settings.tracks[track].glide ?? 0, 0, 1);
        const glideFormat = (v) => (v <= 0.005 ? 'Off' : pctFormat(v));
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = 'glide-knob';
          container.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label: 'Glide',
              min: 0,
              max: 1,
              value,
              format: glideFormat,
              defaultValue: MONO_DEFAULTS[track].glide,
              onInput: commitGlide,
            });
            describe(handle.el, GLIDE_HINT);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('label');
        wrap.className = 'glide-slider';
        const name = document.createElement('span');
        name.className = 'visually-hidden';
        name.textContent = `${TRACK_LABELS[track]} glide. ${GLIDE_HINT}`;
        const input = document.createElement('input');
        input.type = 'range';
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(value);
        input.addEventListener('input', () => commitGlide(parseFloat(input.value)));
        wrap.append(name, input);
        container.append(wrap);
        describe(input, GLIDE_HINT);
      }

      // ---- v21: per-track drift rate --------------------------------------
      // One dial over every RangeValue walk this track owns: at 1 a ranged
      // dial crosses its span at the engine's own ±0.15/bar, at the bottom it
      // creeps. Rendered only where the engine advertises the param.
      const DRIFT_HINT =
        'How fast this track’s min–max dials drift between their two ends. Low is a slow creep; 1 is the normal rate.';

      // v26: every feel dial this track owns lands in ONE row (the caller's),
      // so drift rate can never be stranded on a line of its own — the
      // percussion editor's drift/swing pair was the named offender.
      function buildDriftRateControl(container, track, knobs) {
        if (!engineCaps.driftRate[track]) return;
        const commitDrift = (v) => {
          const value = clamp(rangeMid(v), 0.02, 1);
          settings.tracks[track].driftRate = value;
          engine.setParams({ tracks: { [track]: { driftRate: value } } });
          persistSettings();
        };
        const stored = settings.tracks[track].driftRate;
        const value = clamp(typeof stored === 'number' && Number.isFinite(stored) ? stored : 1, 0.02, 1);
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell drift-knob';
          container.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label: 'Drift rate',
              min: 0.02,
              max: 1,
              step: 0.01,
              value,
              format: (v) => `${plainFormat(v)}×`,
              defaultValue: 1,
              onInput: commitDrift,
            });
            describe(handle.el, DRIFT_HINT);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `drift-rate-${track}`;
        const labelRow = document.createElement('div');
        labelRow.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = 'Drift rate';
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        readout.textContent = `${plainFormat(value)}×`;
        labelRow.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        input.min = '0.02';
        input.max = '1';
        input.step = '0.01';
        input.value = String(value);
        input.addEventListener('input', () => {
          const v = parseFloat(input.value);
          readout.textContent = `${plainFormat(v)}×`;
          commitDrift(v);
        });
        wrap.append(labelRow, input);
        container.append(wrap);
        describe(input, DRIFT_HINT);
      }

      // ---- v21: per-track Swing (pulsed tracks) + Density (tuned) ---------
      // Both carry an AUTO DETENT at the bottom of the sweep that writes null
      // — "follow the global Swing" / "let complexity set the rate" — so the
      // dial has to distinguish "explicitly zero" from "not set". Same 22-
      // position trick the Randomise mini-knobs use: raw 0 is the detent, raw
      // 1–21 map onto the param's own range. Neither is rangeable: the engine
      // reads both as plain scalars (or null), so a {min,max} would be dropped.
      const TRACK_SWING_HINT =
        'This track’s own swing. At the left detent it follows the global Swing dial; anywhere else overrides it for this track alone.';
      const TRACK_DENSITY_HINT =
        'How busy this track is, on top of Complexity. At the left detent Complexity decides; 1 is that same rate, 2 is twice it.';
      const FEEL_STEPS = 21;

      const feelRawFromValue = (v, max) =>
        v === null || v === undefined ? 0 : 1 + Math.round((clamp(v, 0, max) / max) * (FEEL_STEPS - 1));
      const feelValueFromRaw = (raw, max) => {
        const n = Math.round(rangeMid(raw));
        return n <= 0 ? null : clamp(((n - 1) / (FEEL_STEPS - 1)) * max, 0, max);
      };

      function buildFeelControl(parent, track, knobs, spec) {
        const { key, label, max, hint, format, className } = spec;
        const commitFeel = (raw) => {
          const value = feelValueFromRaw(raw, max);
          settings.tracks[track][key] = value;
          engine.setParams({ tracks: { [track]: { [key]: value } } });
          persistSettings();
        };
        const stored = settings.tracks[track][key];
        const raw = feelRawFromValue(typeof stored === 'number' ? stored : null, max);
        const rawFormat = (v) => (Math.round(v) <= 0 ? 'Auto' : format(feelValueFromRaw(v, max)));
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = `knob-cell ${className}`;
          parent.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label,
              min: 0,
              max: FEEL_STEPS,
              step: 1,
              value: raw,
              marks: [0],
              format: rawFormat,
              defaultValue: 0,
              onInput: commitFeel,
            });
            describe(handle.el, hint);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `${key}-${track}`;
        const labelRow = document.createElement('div');
        labelRow.className = 'control-label-row';
        const name = document.createElement('label');
        name.htmlFor = id;
        name.textContent = label;
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        readout.textContent = rawFormat(raw);
        labelRow.append(name, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        input.min = '0';
        input.max = String(FEEL_STEPS);
        input.step = '1';
        input.value = String(raw);
        input.setAttribute('aria-valuetext', rawFormat(raw));
        input.addEventListener('input', () => {
          const v = parseInt(input.value, 10) || 0;
          readout.textContent = rawFormat(v);
          input.setAttribute('aria-valuetext', rawFormat(v));
          commitFeel(v);
        });
        wrap.append(labelRow, input);
        parent.append(wrap);
        describe(input, hint);
      }

      function buildFeelRow(row, track, knobs) {
        const wantsSwing = SEQ_TRACKS.includes(track) && engineCaps.trackSwing[track];
        const wantsDensity = TUNED_TRACKS.includes(track) && engineCaps.trackDensity[track];
        if (!wantsSwing && !wantsDensity) return;
        if (wantsSwing) {
          buildFeelControl(row, track, knobs, {
            key: 'swing',
            label: 'Swing',
            max: 1,
            hint: TRACK_SWING_HINT,
            format: (v) => (v <= 0.005 ? 'Straight' : pctFormat(v)),
            className: 'track-swing-knob',
          });
        }
        if (wantsDensity) {
          buildFeelControl(row, track, knobs, {
            key: 'density',
            label: 'Density',
            max: TRACK_DENSITY_MAX,
            hint: TRACK_DENSITY_HINT,
            format: (v) => `${plainFormat(v)}×`,
            className: 'track-density-knob',
          });
        }
      }

      // ---- v14: per-track Dissonance (tuned tracks only) -----------------
      // How far this instrument may stray from the chord the group is
      // playing: 0 is strict, low values allow passing/neighbour tones,
      // high ones borrow from outside the mode. RangeValue-capable, so it
      // can drift between two bounds like every other v7 dial.
      const DISSONANCE_HINT =
        'How far this instrument may stray from the group chord. 0 keeps strictly to it.';

      function buildDissonanceControl(row, track, knobs) {
        if (!engineCaps.dissonance[track]) return;
        const commitDissonance = (v) => {
          v = sanitiseRangeValueIn(v, 0, 1, 0);
          settings.tracks[track].dissonance = v;
          engine.setParams({ tracks: { [track]: { dissonance: v } } });
          persistSettings();
        };
        const value = sanitiseRangeValueIn(settings.tracks[track].dissonance, 0, 1, 0);
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell dissonance-knob';
          row.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label: 'Dissonance',
              min: 0,
              max: 1,
              value,
              format: pctFormat,
              allowRange: true,
              defaultValue: 0,
              onInput: commitDissonance,
            });
            describe(handle.el, DISSONANCE_HINT);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `dissonance-${track}`;
        const labelRow = document.createElement('div');
        labelRow.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = 'Dissonance';
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        readout.textContent = pctFormat(rangeMid(value));
        labelRow.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(rangeMid(value));
        input.addEventListener('input', () => {
          const v = parseFloat(input.value);
          readout.textContent = pctFormat(v);
          commitDissonance(v);
        });
        wrap.append(labelRow, input);
        row.append(wrap);
        describe(input, DISSONANCE_HINT);
      }

      // ---- v21 pad breath (pad editor only) --------------------------------
      // How deep the pad's own bar-phased swell goes. Not RangeValue-capable
      // (a plain 0-1 depth) and pad-only — the engine already breathes on its
      // own bar clock, this just exposes how far.
      const PAD_BREATH_HINT = 'How much the pad swells with each bar.';

      function buildPadBreathControl(row, track, knobs) {
        if (track !== 'pad' || !engineCaps.padBreath) return;
        const shipped = typeof enginePadBreath === 'number' ? enginePadBreath : 0.5;
        const stored =
          typeof settings.tracks.pad.padBreath === 'number' && Number.isFinite(settings.tracks.pad.padBreath)
            ? clamp(settings.tracks.pad.padBreath, 0, 1)
            : shipped;
        settings.tracks.pad.padBreath = stored;
        const commitPadBreath = (v) => {
          v = clamp(rangeMid(v), 0, 1);
          settings.tracks.pad.padBreath = v;
          engine.setParams({ tracks: { pad: { padBreath: v } } });
          persistSettings();
        };
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell pad-breath-knob';
          row.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label: 'Breath',
              min: 0,
              max: 1,
              value: stored,
              format: pctFormat,
              defaultValue: shipped,
              onInput: commitPadBreath,
            });
            describe(handle.el, PAD_BREATH_HINT);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = 'pad-breath';
        const labelRow = document.createElement('div');
        labelRow.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = 'Breath';
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        readout.textContent = pctFormat(stored);
        labelRow.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(stored);
        input.addEventListener('input', () => {
          const v = parseFloat(input.value);
          readout.textContent = pctFormat(v);
          commitPadBreath(v);
        });
        wrap.append(labelRow, input);
        row.append(wrap);
        describe(input, PAD_BREATH_HINT);
      }

      // ---- v6: shared step sequencer ------------------------------------

      function currentStepsPerBar() {
        return STEPS_PER_BAR[settings.timeSignature] || 16;
      }

      // Pulse (beat) marks come from where the metre's pulses actually
      // start, not a naive "every 4th step" — that's only right for simple
      // meters. Compound x/8 meters group in dotted-quarter (6/8: two
      // groups of three eighths) or mixed (7/8: 2+2+3 eighths, the common
      // grouping) pulses, so their marks land at irregular step offsets.
      const SEQ_PULSE_STARTS = {
        '3/4': [0, 4, 8],
        '4/4': [0, 4, 8, 12],
        '5/4': [0, 4, 8, 12, 16],
        '6/8': [0, 6],
        '7/8': [0, 4, 8],
      };

      function currentPulseStarts() {
        return (
          SEQ_PULSE_STARTS[settings.timeSignature] ||
          // Unlisted signature: fall back to every-4th-step (the old,
          // simple-meter assumption) rather than showing nothing.
          Array.from({ length: Math.ceil(currentStepsPerBar() / 4) }, (_, i) => i * 4)
        );
      }

      // ---- v8 exception: the ARP lane is indexed by arp-step-within-bar at
      // the CURRENT rate, not the bar's metre — its length and pulse marks
      // must be re-derived from settings.arp.rate (and re-rendered when the
      // rate changes, same as a time-signature change re-renders the rest).
      const ARP_RATE_WHOLE_FRACTION = { '1/4': 1 / 4, '1/8': 1 / 8, '1/16': 1 / 16, '1/8T': 1 / 12 };

      function arpStepsPerBar() {
        const [num, den] = String(settings.timeSignature).split('/').map(Number);
        const barWhole = (num || 4) / (den || 4); // bar duration in whole notes
        const rateFraction = ARP_RATE_WHOLE_FRACTION[settings.arp.rate] || ARP_RATE_WHOLE_FRACTION['1/8'];
        // Nudge off an exact-integer float boundary before ceil (e.g.
        // 1/0.125 landing at 8.000000000000002) so it can't over-count.
        return clamp(Math.ceil(barWhole / rateFraction - 1e-6), 1, SEQ_SLOTS);
      }

      function arpPulseStarts(n) {
        // One mark per quarter-note-equivalent worth of arp steps, so the
        // grid still reads by the beat, just counted in the arp's own rate.
        const rateFraction = ARP_RATE_WHOLE_FRACTION[settings.arp.rate] || ARP_RATE_WHOLE_FRACTION['1/8'];
        const perBeat = Math.max(1, Math.round(0.25 / rateFraction));
        const marks = [];
        for (let i = 0; i < n; i += perBeat) marks.push(i);
        return marks;
      }

      function stepsPerBarFor(track) {
        return track === 'arp' ? arpStepsPerBar() : currentStepsPerBar();
      }

      function pulseStartsFor(track, n) {
        return track === 'arp' ? arpPulseStarts(n) : currentPulseStarts();
      }

      /**
       * Push a track's whole sequencer LIST. `sequencers` is authoritative
       * for a v14 engine; the singular `sequencer` (an alias of [0]) rides
       * along so a pre-v14 sanitiser still honours the first pattern. An
       * engine that understands neither simply drops both keys.
       */
      function commitSequencer(track) {
        const t = settings.tracks[track];
        t.sequencer = t.sequencers[0];
        const partial = {
          tracks: {
            [track]: {
              sequencers: structuredClone(t.sequencers),
              sequencer: structuredClone(t.sequencers[0]),
              // v21: the lane list travels WITH the patterns it keys, so a
              // lane and its steps can never reach the engine apart.
              ...(track === 'percussion' ? { lanes: structuredClone(t.lanes) } : {}),
            },
          },
        };
        if (track === 'arp') {
          // Mirror the on-flags into the legacy boolean mask so pre-v6
          // engines still honour the grid (and the complexity estimate
          // keeps working). The mirror is fixed at 16 slots, but only the
          // first arpStepsPerBar() of those actually sound this bar — pad
          // the rest with false so a pre-v6 engine can't play a step that
          // isn't really in the pattern (and the complexity estimate below
          // isn't skewed by stale "on" flags left over from a faster rate).
          const steps = t.sequencers[0].steps;
          const n = Math.min(16, arpStepsPerBar());
          settings.arp.steps = Array.from({ length: 16 }, (unused, i) => (i < n ? !!steps[i].on : false));
          partial.arp = { steps: settings.arp.steps.slice() };
          updateComplexityDisplay();
        }
        engine.setParams(partial);
        persistSettings();
      }

      // ---- v16 block editor (src/scripts/blocks.js) -----------------------
      // Optional module, and one this page must build WITHOUT: a bare
      // `import('../scripts/blocks.js')` is resolved by the bundler, so it
      // would fail the build outright while blocks.js is still being written.
      // import.meta.glob is the feature detection — an unmatched glob is an
      // empty object, and the icon simply never appears. When the module IS
      // present the loader below runs once, on the first click, and caches the
      // result (null once, never retried, if its export is missing).
      const BLOCKS_MODULE = (() => {
        try {
          const loaders = Object.values(import.meta.glob('../scripts/blocks.js'));
          return loaders.length ? loaders[0] : null;
        } catch {
          return null;
        }
      })();

      let blocksApi;
      // v21: blocks.js grew a lane SPEC — `lanes: [{id, label}]`, rendered in
      // exactly the order given, which is what lets a renamed/reordered kit
      // read the same in both editors. An older build takes bare id strings
      // and reverses them for display, and would turn an object into the
      // string "[object Object]" — so the shape is probed, not assumed, using
      // the module's own pure fromParams().
      let blocksLaneSpec = false;

      function probeBlocksLaneSpec(api) {
        if (typeof api.fromParams !== 'function') return false;
        try {
          const layout = api.fromParams(
            { mode: 'manual', weights: [1], steps: {} },
            {
              track: 'percussion',
              lanes: [
                { id: 'high', label: 'High' },
                { id: 'low', label: 'Low' },
              ],
            }
          );
          const ids = layout && Array.isArray(layout.lanes) ? layout.lanes.map((lane) => lane.id) : [];
          return ids[0] === 'high' && ids[1] === 'low';
        } catch {
          return false;
        }
      }

      async function loadBlocksModule() {
        if (blocksApi !== undefined) return blocksApi;
        if (!BLOCKS_MODULE) {
          blocksApi = null;
          return null;
        }
        try {
          const mod = await BLOCKS_MODULE();
          blocksApi = mod && typeof mod.createBlockEditor === 'function' ? mod : null;
          blocksLaneSpec = blocksApi ? probeBlocksLaneSpec(blocksApi) : false;
        } catch {
          blocksApi = null;
        }
        return blocksApi;
      }

      const BLOCKS_SVG =
        '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">' +
        '<rect x="3" y="4" width="18" height="6" rx="1.5"/>' +
        '<rect x="3" y="14" width="12" height="6" rx="1.5"/>' +
        '</svg>';

      /** Next free probability-group id in a lane (v14 conditional trigs). */
      function nextGroupId(lane, slots) {
        let top = -1;
        for (let i = 0; i < slots; i++) {
          const g = lane[i] && lane[i].group;
          if (Number.isFinite(g) && g > top) top = g;
        }
        return top + 1;
      }

      const SEQ_LEGEND_BASE =
        'Keys: arrows move · Enter/Space toggles a step · Shift+↑/↓ velocity top · ' +
        'Alt+↑/↓ velocity bottom · [ and ] (or , and .) probability, Shift+[ / Shift+] ' +
        '(or Shift+, / Shift+.) narrows/widens a drifting probability range · T ties a ' +
        'step to the next one · G joins or leaves the probability group above the step. ' +
        'Pointer: drag a cell vertically for the velocity band, grab the fat handle at ' +
        'the band top for its loudest edge, drag sideways across cells to tie them into ' +
        'one long note, and drag the thin bar under a step for its probability. The dots ' +
        'above the grid colour-code probability groups: inside a group a step only gets ' +
        'its chance if the previous step in that group actually sounded.';

      // v21: the third per-step axis only exists where the engine takes it, so
      // its keys are only documented there too.
      const SEQ_LEGEND_GATE =
        ' Note length: − and = (or + ) shorten and lengthen the note under the ' +
        'cursor, and dragging in the LOWER HALF of a cell does the same with the ' +
        'pointer (the upper half still shapes the velocity band). The bar fills ' +
        'the width of its step at length 1; past that the note runs into the next ' +
        'step and an arrow marks the overhang.';

      const SEQ_LEGEND_LANES =
        ' Lanes: “Add lane” copies the pattern of the lane it lands beside, its ' +
        'name is click-to-type, and Low/Mid/High says which of the kit’s sounds ' +
        'it plays. ▲/▼ move a lane (Alt+↑/↓ from its name does the same, and the ' +
        'grip can be dragged); the three built-in lanes cannot be removed.';

      /**
       * Shared metre-aware step grid: one lane for melody/bass/arp, and one per
       * kit lane (HIGH kinds at the top) for percussion. Per step: on/off,
       * velocity band (vertical drag, fat top handle), probability (mini-bar
       * under the cell), tie (sideways drag), probability group (dot row) and —
       * where the engine takes it — note length (lower-half drag).
       * A track may own SEVERAL sequencers (v14 Markov chain): the tab strip
       * picks which one this grid edits, "+" copies the current one, and each
       * carries a weight — how likely the others are to hand over to it at
       * loop end. Cells form a roving-tabindex ARIA grid; every value is
       * keyboard-adjustable and announced via aria-label.
       *
       * v21 lanes: percussion's lane list is user-editable (add/rename/re-kind/
       * remove/reorder, built-ins protected, cap 8). The lane id keys the step
       * map AND the kit editor's perKind overrides, so `onLanes` lets the voice
       * editor above rebuild its instrument tabs when the list changes.
       */
      function buildSequencer(container, track, { onLanes = null } = {}) {
        const label = TRACK_LABELS[track];
        const trackSettings = () => settings.tracks[track];
        const laneList = () => trackSettings().lanes;
        let lanes = laneListFor(track, trackSettings());
        const list = () => settings.tracks[track].sequencers;
        // The third axis is melodic-only: a kit hit has no length to shape.
        const gateAxis = engineCaps.stepGate && track !== 'percussion';
        const laneAxis = track === 'percussion' && engineCaps.percussionLanes;
        const SEQ_LEGEND =
          SEQ_LEGEND_BASE + (gateAxis ? SEQ_LEGEND_GATE : '') + (laneAxis ? SEQ_LEGEND_LANES : '');
        let active = 0;
        const current = () => list()[Math.min(active, list().length - 1)];
        const laneSteps = (lane) => (lane.key ? current().steps[lane.key] : current().steps);

        const root = document.createElement('div');
        root.className = 'seq';
        container.append(root);

        const head = document.createElement('div');
        head.className = 'seq-head';
        const titleBox = document.createElement('span');
        titleBox.className = 'seq-title';
        const title = document.createElement('span');
        title.className = 'panel-label';
        title.textContent = 'Step sequencer';
        titleBox.append(title);
        infoButton(titleBox, 'the step sequencer', SEQ_LEGEND);
        const modeGroup = document.createElement('div');
        modeGroup.className = 'segmented';
        modeGroup.setAttribute('role', 'radiogroup');
        modeGroup.setAttribute('aria-label', `${label} sequencer mode`);
        const modeRadios = [];
        for (const m of ['auto', 'manual']) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `seq-mode-${track}`;
          input.id = `seq-mode-${track}-${m}`;
          input.value = m;
          input.checked = current().mode === m;
          const lab = document.createElement('label');
          lab.htmlFor = input.id;
          lab.textContent = m === 'auto' ? 'Auto' : 'Manual';
          input.addEventListener('change', () => {
            if (!input.checked) return;
            current().mode = m;
            commitSequencer(track);
          });
          modeGroup.append(input, lab);
          modeRadios.push(input);
        }

        // -- v13/v16 editor entries: blocks now, JS later -------------------
        const editors = document.createElement('div');
        editors.className = 'seq-editors';
        const blockButton = document.createElement('button');
        blockButton.type = 'button';
        blockButton.className = 'round-button seq-editor-button seq-blocks-button';
        blockButton.innerHTML = BLOCKS_SVG;
        blockButton.setAttribute('aria-label', `Edit ${label}'s pattern as blocks`);
        blockButton.setAttribute('aria-expanded', 'false');
        // The block editor is a Plus-tier feature: hidden until the tier can
        // be bought (owner rule — never give-then-take). Dev unlock shows it.
        blockButton.hidden = !BLOCKS_MODULE || PAID_FEATURES_HIDDEN;
        editors.append(blockButton);
        // The v13 JS-editor entry (>_) is a paid feature and is not built at
        // all pre-launch — not greyed, not tooltipped. Flipping
        // PAID_FEATURES_HIDDEN brings it back as a disabled affordance until
        // the editor itself exists.
        if (!PAID_FEATURES_HIDDEN) {
          const codeButton = document.createElement('button');
          codeButton.type = 'button';
          codeButton.className = 'round-button seq-editor-button seq-code-button';
          codeButton.textContent = '>_';
          codeButton.disabled = true;
          codeButton.setAttribute('aria-label', 'JS editor');
          describe(codeButton, 'JS editor coming.');
          editors.append(codeButton);
        }
        head.append(titleBox, modeGroup, editors);

        // -- v14 multi-sequencer tab strip + per-sequencer weight -----------
        const tabsRow = document.createElement('div');
        tabsRow.className = 'seq-tabs';
        const tabs = document.createElement('div');
        tabs.className = 'segmented seq-tab-strip';
        tabs.setAttribute('role', 'tablist');
        tabs.setAttribute('aria-label', `${label} sequencers`);
        const addButton = document.createElement('button');
        addButton.type = 'button';
        addButton.className = 'secondary-button seq-add';
        addButton.textContent = '+';
        addButton.setAttribute('aria-label', 'Add a sequencer (copies the current one)');
        const weightWrap = document.createElement('label');
        weightWrap.className = 'seq-weight';
        const weightLabel = document.createElement('span');
        weightLabel.textContent = 'Weight';
        const weightInput = document.createElement('input');
        weightInput.type = 'number';
        weightInput.min = '0';
        weightInput.max = '100';
        weightInput.step = '0.5';
        weightInput.inputMode = 'decimal';
        weightWrap.append(weightLabel, weightInput);
        tabsRow.append(tabs, addButton, weightWrap);
        describe(
          weightInput,
          'How likely the other sequencers are to hand over to this one when a loop ends.'
        );
        describe(addButton, 'Add a sequencer — a copy of the one showing now.');

        // -- v21 kit lane management ---------------------------------------
        const laneBar = document.createElement('div');
        laneBar.className = 'seq-lane-bar';
        laneBar.hidden = !laneAxis;
        const addLaneButton = document.createElement('button');
        addLaneButton.type = 'button';
        addLaneButton.className = 'secondary-button seq-lane-add';
        addLaneButton.textContent = 'Add lane';
        laneBar.append(addLaneButton);
        describe(
          addLaneButton,
          'Add a kit lane — it copies the pattern of the lane it lands beside, and you can rename it and pick which of the kit’s sounds it plays.'
        );

        const scroll = document.createElement('div');
        scroll.className = 'seq-scroll';
        const beatsEl = document.createElement('div');
        beatsEl.className = 'seq-beats';
        beatsEl.setAttribute('aria-hidden', 'true');
        const gridEl = document.createElement('div');
        gridEl.className = 'seq-rows';
        gridEl.setAttribute('role', 'grid');
        gridEl.setAttribute('aria-label', `${label} step sequencer`);
        scroll.append(beatsEl, gridEl);

        const blocksHost = document.createElement('div');
        blocksHost.className = 'seq-blocks';
        blocksHost.hidden = true;

        root.append(head, tabsRow, laneBar, scroll, blocksHost);

        let cellRefs = []; // [lane][step] -> { cell, band, bandTop, probFill, dot }
        let focusPos = { lane: 0, step: 0 };
        let playhead = -1;

        function stepText(lane, i, s) {
          const lanePart = lane.label ? `${lane.label} lane, ` : '';
          const probPart = isPlainObject(s.prob)
            ? `probability ${Math.round(s.prob.min * 100)} to ${Math.round(s.prob.max * 100)}%, drifting`
            : `probability ${Math.round(s.prob * 100)}%`;
          const tiePart = s.tie === true ? ', tied to the next step' : '';
          const groupPart = Number.isFinite(s.group) ? `, group ${s.group + 1}` : '';
          const gatePart =
            gateAxis && Number.isFinite(s.gate) ? `, length ${s.gate.toFixed(2)} of a step` : '';
          return (
            `${lanePart}step ${i + 1}: ${s.on ? 'on' : 'off'}, ` +
            `velocity ${Math.round(s.vmin * 100)} to ${Math.round(s.vmax * 100)}%, ` +
            probPart +
            gatePart +
            tiePart +
            groupPart
          );
        }

        /** The step's note length, defaulted to whatever the engine plays an
         * unmarked step at — so the dial and the sound agree before the user
         * has ever touched the axis. */
        function stepGate(s) {
          return Number.isFinite(s.gate) ? s.gate : SEQ_GATE_DEFAULT;
        }

        function setStepGate(s, value) {
          s.gate = clamp(Math.round(value / SEQ_GATE_NUDGE) * SEQ_GATE_NUDGE, SEQ_GATE_MIN, SEQ_GATE_MAX);
        }

        function updateCell(li, i) {
          const lane = lanes[li];
          const s = laneSteps(lane)[i];
          const ref = cellRefs[li][i];
          ref.cell.classList.toggle('seq-cell-on', s.on);
          ref.cell.classList.toggle('seq-cell-tie', s.tie === true);
          // role=gridcell + a label stating on/off/velocity/probability is
          // the valid pattern here: aria-selected implies row/grid
          // *selection* (not toggle state) and aria-pressed is only valid
          // on button-role elements, so neither belongs on a gridcell —
          // the label alone carries the state. aria-valuetext is likewise
          // dropped: it's a range-widget attribute, inert on a gridcell.
          const text = stepText(lane, i, s);
          ref.cell.setAttribute('aria-label', text);
          ref.band.style.bottom = `${s.vmin * 100}%`;
          ref.band.style.height = `${Math.max(0, s.vmax - s.vmin) * 100}%`;
          // v21 third axis: the band stops where the note stops, so a short
          // gate reads as a short bar inside its step. Past 1 the note runs on
          // into the next step, which the legato arrow marks instead (the bar
          // itself cannot show width it hasn't got).
          if (gateAxis) {
            const gate = stepGate(s);
            ref.band.style.right = 'auto';
            ref.band.style.width = `calc((100% - 4px) * ${Math.min(gate, 1)})`;
            ref.cell.classList.toggle('seq-cell-legato', s.on && gate > 1);
          }
          // The fat grab handle rides the band's loud edge; ≥10 px tall (CSS)
          // so the velocity top is reachable without pixel-hunting.
          ref.bandTop.style.bottom = `${s.vmax * 100}%`;
          // A plain prob fills from 0 to the value (matches the on/off
          // cell's velocity band read); a ranged prob instead shows the
          // drifting window itself (left edge at min, width = max-min).
          if (isPlainObject(s.prob)) {
            ref.probFill.style.left = `${s.prob.min * 100}%`;
            ref.probFill.style.width = `${Math.max(0, s.prob.max - s.prob.min) * 100}%`;
            ref.probFill.classList.add('seq-prob-fill-range');
          } else {
            ref.probFill.style.left = '0';
            ref.probFill.style.width = `${s.prob * 100}%`;
            ref.probFill.classList.remove('seq-prob-fill-range');
          }
          const grouped = Number.isFinite(s.group);
          ref.dot.classList.toggle('seq-dot-on', grouped);
          ref.dot.style.background = grouped
            ? GROUP_COLOURS[s.group % GROUP_COLOURS.length]
            : '';
          ref.dot.setAttribute(
            'aria-label',
            grouped
              ? `Step ${i + 1} is in probability group ${s.group + 1}. Press to leave it.`
              : `Step ${i + 1} is ungrouped. Press to join the group above it, or start one.`
          );
        }

        function setFocus(li, i, focus = true) {
          const n = stepsPerBarFor(track);
          li = clamp(li, 0, lanes.length - 1);
          i = clamp(i, 0, n - 1);
          const prev = (cellRefs[focusPos.lane] || [])[focusPos.step];
          if (prev) prev.cell.tabIndex = -1;
          focusPos = { lane: li, step: i };
          const ref = cellRefs[li][i];
          ref.cell.tabIndex = 0;
          if (focus) ref.cell.focus();
        }

        /** Join the group above, or start a new one; a grouped step leaves. */
        function toggleGroup(li, i) {
          const lane = laneSteps(lanes[li]);
          const s = lane[i];
          if (Number.isFinite(s.group)) {
            delete s.group;
          } else {
            const prev = i > 0 ? lane[i - 1] : null;
            s.group = prev && Number.isFinite(prev.group)
              ? prev.group
              : nextGroupId(lane, stepsPerBarFor(track));
          }
          updateCell(li, i);
          commitSequencer(track);
        }

        function wireCell(li, i, cell, probEl, bandTop, dot) {
          const getStep = () => laneSteps(lanes[li])[i];
          const commit = () => {
            updateCell(li, i);
            commitSequencer(track);
          };

          dot.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleGroup(li, i);
          });

          // Fat handle: drags the band's TOP (loudest) edge on its own.
          bandTop.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            e.preventDefault();
            e.stopPropagation();
            setFocus(li, i);
            const rect = cell.getBoundingClientRect();
            const vAt = (clientY) => clamp(1 - (clientY - rect.top) / rect.height, 0, 1);
            const onMove = (ev) => {
              const s = getStep();
              s.on = true;
              s.vmax = Math.max(s.vmin, vAt(ev.clientY));
              updateCell(li, i);
            };
            const onUp = () => {
              bandTop.removeEventListener('pointermove', onMove);
              bandTop.removeEventListener('pointerup', onUp);
              bandTop.removeEventListener('pointercancel', onUp);
              commitSequencer(track);
            };
            try {
              bandTop.setPointerCapture(e.pointerId);
            } catch {}
            bandTop.addEventListener('pointermove', onMove);
            bandTop.addEventListener('pointerup', onUp);
            bandTop.addEventListener('pointercancel', onUp);
          });

          cell.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            e.preventDefault();
            setFocus(li, i);
            const rect = cell.getBoundingClientRect();
            const vAt = (clientY) => clamp(1 - (clientY - rect.top) / rect.height, 0, 1);
            const v0 = vAt(e.clientY);
            const slots = stepsPerBarFor(track);
            const columnWidth = rect.width + 3; // grid gap
            let gesture = null; // 'band' | 'tie' | 'gate'
            let tieEnd = i;
            // v21: which axis a vertical drag means is decided by where it
            // STARTED — lower half is the note's length, upper half the
            // velocity band it has always been. The fat top handle (its own
            // element) is unaffected either way.
            const gateZone = gateAxis && v0 <= 0.5;
            let gate0 = SEQ_GATE_DEFAULT;

            /** Sideways drag merges the crossed steps into one tied note. */
            const applyTie = (end) => {
              const lane = laneSteps(lanes[li]);
              const last = clamp(end, i, slots - 1);
              for (let k = i; k <= last; k++) {
                lane[k].on = true;
                if (k < last) lane[k].tie = true;
                else delete lane[k].tie;
                updateCell(li, k);
              }
              // Dragging back shortens the run: the steps beyond it lose the
              // tie they picked up on the way out.
              for (let k = last + 1; k <= tieEnd && k < slots; k++) {
                delete lane[k].tie;
                updateCell(li, k);
              }
              tieEnd = last;
            };

            const onMove = (ev) => {
              const dx = ev.clientX - e.clientX;
              const dy = ev.clientY - e.clientY;
              if (!gesture) {
                if (Math.abs(dx) < 6 && Math.abs(dy) < 4) return;
                gesture = Math.abs(dx) > Math.abs(dy) ? 'tie' : gateZone ? 'gate' : 'band';
                if (gesture === 'gate') gate0 = stepGate(getStep());
              }
              if (gesture === 'tie') {
                applyTie(i + Math.round(dx / Math.max(1, columnWidth)));
                return;
              }
              if (gesture === 'gate') {
                const s = getStep();
                s.on = true; // shaping a length implies the step should sound
                // A full cell height of travel covers the whole 0.1–2 span.
                setStepGate(s, gate0 + (vAt(ev.clientY) - v0) * (SEQ_GATE_MAX - SEQ_GATE_MIN));
                updateCell(li, i);
                return;
              }
              const v1 = vAt(ev.clientY);
              const s = getStep();
              s.on = true; // shaping a band implies the step should sound
              s.vmin = Math.min(v0, v1);
              s.vmax = Math.max(v0, v1);
              updateCell(li, i);
            };
            const finish = (toggleOnTap) => () => {
              cell.removeEventListener('pointermove', onMove);
              cell.removeEventListener('pointerup', up);
              cell.removeEventListener('pointercancel', cancel);
              if (!gesture && toggleOnTap) {
                const s = getStep();
                s.on = !s.on;
                updateCell(li, i);
              }
              commitSequencer(track);
            };
            const up = finish(true);
            const cancel = finish(false);
            try {
              cell.setPointerCapture(e.pointerId);
            } catch {}
            cell.addEventListener('pointermove', onMove);
            cell.addEventListener('pointerup', up);
            cell.addEventListener('pointercancel', cancel);
          });

          const probFromEvent = (ev) => {
            const r = probEl.getBoundingClientRect();
            const p = clamp((ev.clientX - r.left) / Math.max(1, r.width), 0, 1);
            const s = getStep();
            // The mini-bar drags the midpoint only — an existing {min,max}
            // shifts with it (width preserved) rather than collapsing.
            s.prob = shiftRangeMid(s.prob, Math.round(p * 20) / 20);
            updateCell(li, i);
          };
          probEl.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            e.preventDefault();
            setFocus(li, i);
            probFromEvent(e);
            const onMove = (ev) => probFromEvent(ev);
            const onUp = () => {
              probEl.removeEventListener('pointermove', onMove);
              probEl.removeEventListener('pointerup', onUp);
              probEl.removeEventListener('pointercancel', onUp);
              commitSequencer(track);
            };
            try {
              probEl.setPointerCapture(e.pointerId);
            } catch {}
            probEl.addEventListener('pointermove', onMove);
            probEl.addEventListener('pointerup', onUp);
            probEl.addEventListener('pointercancel', onUp);
          });

          cell.addEventListener('keydown', (e) => {
            const s = getStep();
            const nudge = 0.05;
            const snap = (v) => Math.round(v * 20) / 20;
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              s.on = !s.on;
              commit();
            } else if (e.key === 't' || e.key === 'T') {
              // Keyboard equivalent of the sideways tie drag.
              e.preventDefault();
              if (s.tie === true) delete s.tie;
              else if (i < stepsPerBarFor(track) - 1) s.tie = true;
              commit();
            } else if (e.key === 'g' || e.key === 'G') {
              e.preventDefault();
              toggleGroup(li, i);
            } else if (gateAxis && (e.key === '-' || e.key === '_')) {
              // Keyboard pair for the note-length axis. '+' arrives as
              // Shift+'=' on most layouts, so both characters are accepted.
              e.preventDefault();
              setStepGate(s, stepGate(s) - SEQ_GATE_NUDGE);
              commit();
            } else if (gateAxis && (e.key === '=' || e.key === '+')) {
              e.preventDefault();
              setStepGate(s, stepGate(s) + SEQ_GATE_NUDGE);
              commit();
            } else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
              const d = e.key === 'ArrowUp' ? nudge : -nudge;
              if (e.shiftKey) {
                e.preventDefault();
                s.vmax = clamp(snap(s.vmax + d), s.vmin, 1);
                commit();
              } else if (e.altKey) {
                e.preventDefault();
                s.vmin = clamp(snap(s.vmin + d), 0, s.vmax);
                commit();
              } else if (lanes.length > 1) {
                e.preventDefault();
                setFocus(li + (e.key === 'ArrowDown' ? 1 : -1), i);
              } else {
                // Single-lane track: there's no other lane for plain
                // Up/Down to move focus to, so nudge the whole velocity
                // band (vmin+vmax together) instead of silently eating
                // the key (which would otherwise block page scroll for
                // nothing).
                e.preventDefault();
                const width = s.vmax - s.vmin;
                const vmin = clamp(snap(s.vmin + d), 0, 1 - width);
                s.vmin = vmin;
                s.vmax = clamp(snap(vmin + width), 0, 1);
                commit();
              }
            } else if (e.key === 'ArrowRight') {
              e.preventDefault();
              setFocus(li, i + 1);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              setFocus(li, i - 1);
            } else if (e.key === 'Home') {
              e.preventDefault();
              setFocus(li, 0);
            } else if (e.key === 'End') {
              e.preventDefault();
              setFocus(li, stepsPerBarFor(track) - 1);
            } else if (e.key === '[' || e.key === ',') {
              e.preventDefault();
              // Moves the midpoint only — an existing {min,max} shifts with
              // it (width preserved), same policy as the pointer drag.
              s.prob = shiftRangeMid(s.prob, snap(rangeMid(s.prob) - nudge));
              commit();
            } else if (e.key === ']' || e.key === '.') {
              e.preventDefault();
              s.prob = shiftRangeMid(s.prob, snap(rangeMid(s.prob) + nudge));
              commit();
            } else if (e.key === '{' || e.key === '<') {
              // Shift+[ / Shift+, — narrow the drifting prob range around
              // its midpoint (narrowing to ~0 collapses back to a number).
              e.preventDefault();
              s.prob = resizeRangeWidth(s.prob, -nudge * 2);
              commit();
            } else if (e.key === '}' || e.key === '>') {
              // Shift+] / Shift+. — widen it (splitting a plain number into
              // a range on first widen).
              e.preventDefault();
              s.prob = resizeRangeWidth(s.prob, nudge * 2);
              commit();
            }
          });
        }

        // -- v21 lane operations (percussion) -------------------------------
        // Every one of these ends in commitLanes(), which repairs the list,
        // re-keys the step map to it, re-renders and pushes lanes+patterns to
        // the engine in one setParams — so a lane and its steps are never
        // briefly out of step with each other.

        function commitLanes(focusLaneId) {
          const t = trackSettings();
          t.lanes = normalisePercLanes(t.lanes);
          normaliseSequencerList(t, track);
          lanes = laneListFor(track, t);
          focusPos = { lane: Math.min(focusPos.lane, lanes.length - 1), step: focusPos.step };
          render();
          commitSequencer(track);
          if (onLanes) onLanes();
          if (focusLaneId) {
            const index = lanes.findIndex((lane) => lane.key === focusLaneId);
            const name = laneNameButtons[index];
            if (name) name.focus();
          }
        }

        function addLane() {
          const t = trackSettings();
          if (t.lanes.length >= PERC_MAX_LANES) return;
          const at = laneInsertIndex(t.lanes, PERC_NEW_LANE_KIND);
          const id = nextLaneId(t.lanes);
          // "Nearest" is the lane it lands beside — the one above it, or the
          // one below when it lands at the top. Copying that pattern is what
          // makes a new tom/cymbal lane immediately playable rather than an
          // empty row to fill in from scratch.
          const nearest = t.lanes[at - 1] || t.lanes[at] || null;
          t.lanes.splice(at, 0, {
            id,
            label: `Lane ${t.lanes.length + 1}`,
            kind: PERC_NEW_LANE_KIND,
          });
          for (const seq of list()) {
            const source = nearest && isPlainObject(seq.steps) ? seq.steps[nearest.id] : null;
            seq.steps[id] = source ? structuredClone(source) : defaultLane(PERC_NEW_LANE_KIND);
          }
          commitLanes(id);
        }

        function removeLane(index) {
          const t = trackSettings();
          const lane = t.lanes[index];
          if (!lane || PERC_BUILTIN_LANES.includes(lane.id)) return;
          t.lanes.splice(index, 1);
          for (const seq of list()) {
            if (isPlainObject(seq.steps)) delete seq.steps[lane.id];
          }
          // A removed lane takes its kit-editor overrides with it too — ids are
          // reused (lane4 removed, lane4 added), and inheriting the old lane's
          // sound would be a ghost the user never asked for.
          const bank = isPlainObject(settings.patches[track]) ? settings.patches[track] : null;
          for (const voiceId of Object.keys(bank || {})) {
            const patch = bank[voiceId];
            if (!isPlainObject(patch) || !isPlainObject(patch.perKind)) continue;
            if (!(lane.id in patch.perKind)) continue;
            delete patch.perKind[lane.id];
            if (!Object.keys(patch.perKind).length) delete patch.perKind;
            sendPatch(track, voiceId, patch);
          }
          commitLanes();
        }

        function renameLane(index, text) {
          const t = trackSettings();
          const lane = t.lanes[index];
          const name = String(text || '').trim().slice(0, 32);
          if (!lane || !name || name === lane.label) return;
          lane.label = name;
          commitLanes(lane.id);
        }

        function setLaneKind(index, kind) {
          const t = trackSettings();
          const lane = t.lanes[index];
          if (!lane || PERC_BUILTIN_LANES.includes(lane.id)) return;
          if (!PERC_LANE_KINDS.some(([k]) => k === kind)) return;
          lane.kind = kind;
          commitLanes(lane.id);
        }

        function moveLane(from, to) {
          const t = trackSettings();
          const target = clamp(to, 0, t.lanes.length - 1);
          if (from === target || !t.lanes[from]) return;
          const [lane] = t.lanes.splice(from, 1);
          t.lanes.splice(target, 0, lane);
          commitLanes(lane.id);
        }

        addLaneButton.addEventListener('click', addLane);

        let laneNameButtons = [];

        /**
         * One lane's header: a grip, the click-to-type name, the kind picker
         * (which of the kit's sounds it plays), the two move buttons and —
         * for a user lane — remove. Rendered as a row of its own so the grid
         * keeps to rows-of-cells; the built-in lanes get everything except
         * remove, which is what "built-ins protected" means here.
         */
        function buildLaneHead(lane, index) {
          const headRow = document.createElement('div');
          headRow.className = 'seq-lane seq-lane-head-row';
          headRow.setAttribute('role', 'row');
          const head = document.createElement('div');
          head.className = 'seq-lane-head';
          head.setAttribute('role', 'rowheader');
          headRow.append(head);
          if (!laneAxis) {
            const text = document.createElement('span');
            text.className = 'seq-lane-label';
            text.textContent = lane.label;
            head.append(text);
            return headRow;
          }

          const grip = document.createElement('button');
          grip.type = 'button';
          grip.className = 'seq-lane-grip';
          grip.textContent = '⠿';
          grip.setAttribute('aria-label', `Drag to move the ${lane.label} lane`);
          head.append(grip);

          const name = document.createElement('button');
          name.type = 'button';
          name.className = 'seq-lane-label seq-lane-name typable';
          name.textContent = lane.label;
          name.setAttribute('aria-label', `${lane.label} lane — click to rename`);
          name.addEventListener('click', () => {
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'typable-input seq-lane-input';
            input.value = lane.label;
            input.setAttribute('aria-label', `${lane.label} lane name`);
            head.replaceChild(input, name);
            input.focus();
            input.select();
            let done = false;
            const finish = (save) => {
              if (done) return;
              done = true;
              const value = input.value;
              if (input.parentNode === head) head.replaceChild(name, input);
              if (save) renameLane(index, value);
              else name.focus();
            };
            input.addEventListener('keydown', (event) => {
              if (event.key === 'Enter') {
                event.preventDefault();
                finish(true);
              } else if (event.key === 'Escape') {
                event.preventDefault();
                finish(false);
              }
            });
            input.addEventListener('blur', () => finish(true));
          });
          // Alt+↑/↓ from the name is the keyboard reorder — plain arrows stay
          // free for moving around the grid itself.
          name.addEventListener('keydown', (event) => {
            if (!event.altKey || (event.key !== 'ArrowUp' && event.key !== 'ArrowDown')) return;
            event.preventDefault();
            moveLane(index, index + (event.key === 'ArrowDown' ? 1 : -1));
          });
          head.append(name);

          const builtin = PERC_BUILTIN_LANES.includes(lane.key);
          const kind = document.createElement('select');
          kind.className = 'seq-lane-kind';
          kind.setAttribute('aria-label', `${lane.label} lane sound`);
          for (const [value, kindLabel] of PERC_LANE_KINDS) {
            const option = document.createElement('option');
            option.value = value;
            option.textContent = kindLabel;
            kind.append(option);
          }
          kind.value = lane.kind;
          // A built-in lane IS its kind — the engine fixes that pairing, so
          // the picker shows the mapping without offering to break it.
          kind.disabled = builtin;
          kind.addEventListener('change', () => setLaneKind(index, kind.value));
          describe(
            kind,
            builtin
              ? 'A built-in lane always plays its own sound; rename it or move it instead.'
              : 'Which of the kit’s sounds this lane plays.'
          );
          head.append(kind);

          const move = (delta, glyph, what) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'round-button seq-lane-move';
            button.textContent = glyph;
            button.setAttribute('aria-label', `Move the ${lane.label} lane ${what}`);
            button.disabled = delta < 0 ? index === 0 : index === lanes.length - 1;
            button.addEventListener('click', () => moveLane(index, index + delta));
            head.append(button);
          };
          move(-1, '▲', 'up');
          move(1, '▼', 'down');

          if (!builtin) {
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'round-button seq-lane-remove';
            remove.textContent = '×';
            remove.setAttribute('aria-label', `Remove the ${lane.label} lane`);
            remove.addEventListener('click', () => removeLane(index));
            describe(remove, 'Remove this lane and its pattern.');
            head.append(remove);
          }

          // Pointer reorder: the grip drags, and the lane lands on whichever
          // header its release is nearest. Nothing re-renders mid-drag, so the
          // element under the captured pointer stays put until the drop.
          grip.addEventListener('pointerdown', (event) => {
            if (event.pointerType === 'mouse' && event.button !== 0) return;
            event.preventDefault();
            const heads = Array.from(gridEl.querySelectorAll('.seq-lane-head'));
            const centres = heads.map((el) => {
              const rect = el.getBoundingClientRect();
              return rect.top + rect.height / 2;
            });
            const nearestTo = (clientY) => {
              let best = index;
              let bestDistance = Infinity;
              centres.forEach((centre, k) => {
                const distance = Math.abs(clientY - centre);
                if (distance < bestDistance) {
                  bestDistance = distance;
                  best = k;
                }
              });
              return best;
            };
            head.classList.add('seq-lane-dragging');
            const onMove = (ev) => {
              const target = nearestTo(ev.clientY);
              heads.forEach((el, k) => el.classList.toggle('seq-lane-drop', k === target && k !== index));
            };
            const onUp = (ev) => {
              grip.removeEventListener('pointermove', onMove);
              grip.removeEventListener('pointerup', onUp);
              grip.removeEventListener('pointercancel', onCancel);
              heads.forEach((el) => el.classList.remove('seq-lane-drop'));
              head.classList.remove('seq-lane-dragging');
              moveLane(index, nearestTo(ev.clientY));
            };
            const onCancel = () => {
              grip.removeEventListener('pointermove', onMove);
              grip.removeEventListener('pointerup', onUp);
              grip.removeEventListener('pointercancel', onCancel);
              heads.forEach((el) => el.classList.remove('seq-lane-drop'));
              head.classList.remove('seq-lane-dragging');
            };
            try {
              grip.setPointerCapture(event.pointerId);
            } catch {}
            grip.addEventListener('pointermove', onMove);
            grip.addEventListener('pointerup', onUp);
            grip.addEventListener('pointercancel', onCancel);
          });

          laneNameButtons[index] = name;
          return headRow;
        }

        function renderTabs() {
          const seqs = list();
          tabs.innerHTML = '';
          // A single sequencer needs no chooser and no transition weight —
          // the strip only earns its space once there's something to pick
          // between. "+" stays, so a second one is always one click away.
          tabsRow.classList.toggle('seq-tabs-single', seqs.length < 2);
          seqs.forEach((unused, index) => {
            const input = document.createElement('input');
            input.type = 'radio';
            input.name = `seq-pick-${track}`;
            input.id = `seq-pick-${track}-${index}`;
            input.value = String(index);
            input.checked = index === active;
            const lab = document.createElement('label');
            lab.htmlFor = input.id;
            lab.textContent = String(index + 1);
            input.addEventListener('change', () => {
              if (!input.checked) return;
              active = index;
              render();
            });
            tabs.append(input, lab);
          });
          addButton.disabled = seqs.length >= SEQ_MAX;
          weightInput.value = String(seqs[0].weights[active] ?? 1);
          weightInput.setAttribute('aria-label', `Sequencer ${active + 1} weight`);
        }

        addButton.addEventListener('click', () => {
          const seqs = list();
          if (seqs.length >= SEQ_MAX) return;
          seqs.push(structuredClone(current()));
          normaliseSequencerList(settings.tracks[track], track);
          active = list().length - 1;
          render();
          commitSequencer(track);
        });

        weightInput.addEventListener('input', () => {
          const parsed = parseFloat(weightInput.value);
          if (!Number.isFinite(parsed)) return; // mid-edit blank keeps the stored value
          const w = clamp(parsed, 0, 100);
          // One number per sequencer: "how likely everyone is to hand over to
          // this one", written into every sequencer's transition row.
          for (const seq of list()) seq.weights[active] = w;
          commitSequencer(track);
        });

        function render() {
          const n = stepsPerBarFor(track);
          const pulseStarts = pulseStartsFor(track, n);
          const pulseSet = new Set(pulseStarts);
          root.style.setProperty('--seq-cols', String(n));
          beatsEl.innerHTML = '';
          gridEl.innerHTML = '';
          cellRefs = lanes.map(() => []);
          laneNameButtons = [];
          addLaneButton.disabled = lanes.length >= PERC_MAX_LANES;
          for (const radio of modeRadios) radio.checked = radio.value === current().mode;
          renderTabs();
          for (let i = 0; i < n; i++) {
            const b = document.createElement('span');
            const pulseIndex = pulseStarts.indexOf(i);
            if (pulseIndex !== -1) {
              b.textContent = String(pulseIndex + 1);
              b.className = 'seq-beat-mark';
            }
            beatsEl.append(b);
          }
          lanes.forEach((lane, li) => {
            // Probability-group dots sit ABOVE the lane's cells, one per
            // step, as their own grid row — row > gridcell > button, the
            // standard "gridcell owning a widget" shape, so the buttons stay
            // legitimate children of role="grid".
            const dotRow = document.createElement('div');
            dotRow.className = 'seq-lane seq-dot-row';
            dotRow.setAttribute('role', 'row');
            const row = document.createElement('div');
            row.className = 'seq-lane';
            row.setAttribute('role', 'row');
            const headRow = lane.key ? buildLaneHead(lane, li) : null;
            // Per-lane tint, derived from the track's own colour so a kit of
            // eight lanes still reads as one instrument: the top lane wears
            // the accent at full strength and each one below it is mixed
            // further back towards the panel.
            if (lane.key) {
              const mix = lanes.length > 1 ? 100 - Math.round((li / (lanes.length - 1)) * 55) : 100;
              const tint = `color-mix(in srgb, var(--track-accent, var(--link)) ${mix}%, var(--panel))`;
              for (const el of [headRow, dotRow, row]) {
                el.classList.add('seq-lane-tinted');
                el.style.setProperty('--lane-tint', tint);
              }
            }
            // The probability mini-bars sit on the grid line directly under
            // their cells (same columns, so each bar is tied to its step),
            // but a role="row" must only own gridcell children — so they
            // get their own row (role="row", cells aria-hidden) rather than
            // living inside the cell row above.
            const probRow = document.createElement('div');
            probRow.className = 'seq-lane seq-prob-row';
            probRow.setAttribute('role', 'row');
            for (let i = 0; i < n; i++) {
              const dotCell = document.createElement('div');
              dotCell.className = 'seq-dot-cell';
              dotCell.setAttribute('role', 'gridcell');
              const dot = document.createElement('button');
              dot.type = 'button';
              dot.className = 'seq-dot';
              dotCell.append(dot);
              dotRow.append(dotCell);
              const cell = document.createElement('div');
              cell.className = 'seq-cell';
              cell.setAttribute('role', 'gridcell');
              if (pulseSet.has(i)) cell.classList.add('seq-cell-beat');
              cell.tabIndex = -1;
              const band = document.createElement('span');
              band.className = 'seq-band';
              const bandTop = document.createElement('span');
              bandTop.className = 'seq-band-top';
              cell.append(band, bandTop);
              const prob = document.createElement('span');
              prob.className = 'seq-prob';
              prob.setAttribute('aria-hidden', 'true');
              const probFill = document.createElement('span');
              probFill.className = 'seq-prob-fill';
              prob.append(probFill);
              probRow.append(prob);
              cellRefs[li][i] = { cell, band, bandTop, probFill, dot };
              wireCell(li, i, cell, prob, bandTop, dot);
              row.append(cell);
            }
            if (headRow) gridEl.append(headRow);
            gridEl.append(dotRow, row, probRow);
          });
          for (let li = 0; li < lanes.length; li++) {
            for (let i = 0; i < n; i++) updateCell(li, i);
          }
          focusPos = {
            lane: Math.min(focusPos.lane, lanes.length - 1),
            step: Math.min(focusPos.step, n - 1),
          };
          cellRefs[focusPos.lane][focusPos.step].cell.tabIndex = 0;
          setPlayhead(playhead);
        }

        /**
         * v14 playhead: the sounding step lights white. Driven from bar/note
         * events at step rate (see schedulePlayhead) — a class swap on two
         * DOM nodes, never a rAF loop.
         */
        function setPlayhead(index) {
          const n = stepsPerBarFor(track);
          for (let li = 0; li < cellRefs.length; li++) {
            const prev = cellRefs[li][playhead];
            if (prev) prev.cell.classList.remove('seq-cell-playing');
          }
          playhead = index >= 0 && index < n ? index : -1;
          if (playhead < 0) return;
          for (let li = 0; li < cellRefs.length; li++) {
            const ref = cellRefs[li][playhead];
            if (ref) ref.cell.classList.add('seq-cell-playing');
          }
        }

        // -- v16 block editor ----------------------------------------------
        // A second EDITOR for the same data, not a second copy of it: the
        // block surface compiles to this track's sequencer params and commits
        // through commitSequencer, exactly as the grid does. It stands in
        // place of the grid while open so the two can never show different
        // patterns, and setValue() re-reads the live params every time it
        // opens (the grid may have moved them meanwhile).
        //
        // It is handed the ACTIVE sequencer object, so blocks.js round-trips
        // in its 'sequencer' form and hands back the same shape — the multi-
        // sequencer list, and which of them is being edited, stay this page's
        // business.
        // Lane order: this page lists lanes TOP-DOWN (High first, the v14
        // rule). A v21 blocks.js takes that order verbatim as `[{id, label}]`;
        // an older one takes bare ids and renders them bottom-up, so it is
        // handed the REVERSE — which puts High at the top of both editors
        // either way. Read at OPEN time, not at build time: v21 lanes are
        // user-editable, so the list a block editor is given has to be the one
        // the grid is showing now.
        const laneIdsNow = () => lanes.map((lane) => lane.key).filter(Boolean);
        const laneSpecNow = () =>
          blocksLaneSpec
            ? lanes.filter((lane) => lane.key).map((lane) => ({ id: lane.key, label: lane.label }))
            : laneIdsNow().reverse();
        let blockEditor = null;
        let blockLaneKey = '';

        function blockParams() {
          return structuredClone(current());
        }

        /**
         * Take a compiled pattern back from the block editor. Accepts either a
         * sequencer object or a { sequencer } wrapper, and only touches the
         * keys it recognises; normaliseSequencerList then repairs anything
         * malformed (lane padding, clamping) before the engine sees it, so a
         * half-built compile can't corrupt the track.
         */
        function applyBlockParams(next) {
          const incoming = isPlainObject(next) && isPlainObject(next.sequencer) ? next.sequencer : next;
          if (!isPlainObject(incoming)) return;
          const seq = current();
          if (incoming.steps !== undefined) seq.steps = incoming.steps;
          if (typeof incoming.mode === 'string') seq.mode = incoming.mode;
          normaliseSequencerList(settings.tracks[track], track);
          render();
          commitSequencer(track);
        }

        function closeBlocks() {
          blocksHost.hidden = true;
          scroll.hidden = false;
          blockButton.setAttribute('aria-expanded', 'false');
        }

        async function openBlocks() {
          const api = await loadBlocksModule();
          if (!api) {
            // The module resolved but has no createBlockEditor (a build older
            // than the page): retire the affordance rather than leave a button
            // that does nothing.
            blockButton.hidden = true;
            return;
          }
          const laneSpec = laneSpecNow();
          // A lane added/removed/reordered/renamed since the editor was built
          // means a different canvas, which blocks.js takes at CONSTRUCTION —
          // so the editor is rebuilt rather than fed a list it cannot adopt.
          const laneKey = lanes.map((lane) => `${lane.key}:${lane.label}`).join('|');
          if (blockEditor && laneKey !== blockLaneKey) {
            try {
              blockEditor.destroy?.();
            } catch {}
            blockEditor = null;
            blocksHost.innerHTML = '';
          }
          if (!blockEditor) {
            try {
              blockEditor = api.createBlockEditor(blocksHost, {
                track,
                timeSignature: settings.timeSignature,
                // Percussion names its lanes; a single-lane track passes none
                // and lets blocks.js infer its own lane id from the steps.
                ...(laneSpec.length ? { lanes: laneSpec } : {}),
                value: blockParams(),
                onChange: applyBlockParams,
              });
              blockLaneKey = laneKey;
            } catch {
              blocksHost.innerHTML = '';
              blockButton.hidden = true;
              return;
            }
          }
          try {
            blockEditor.setValue?.(blockParams());
          } catch {}
          blocksHost.hidden = false;
          scroll.hidden = true;
          blockButton.setAttribute('aria-expanded', 'true');
        }

        blockButton.addEventListener('click', () => {
          if (blocksHost.hidden) openBlocks();
          else closeBlocks();
        });
        describe(blockButton, `Build ${label}'s pattern out of blocks instead of the grid.`);

        function destroy() {
          try {
            blockEditor?.destroy?.();
          } catch {}
          blockEditor = null;
        }

        render();
        return { refresh: render, setPlayhead, destroy };
      }

      // ---- v6: arpeggiator section (lives in the Arp track's Edit panel) --

      let arpUI = null; // control refs while the arp editor is open

      const ARP_PATTERNS = [
        ['up', 'Up'],
        ['down', 'Down'],
        ['updown', 'Up-down'],
        ['random', 'Random'],
      ];
      const ARP_RATES = [
        ['1/4', '1/4'],
        ['1/8', '1/8'],
        ['1/16', '1/16'],
        ['1/8T', '1/8 triplet'],
      ];

      function buildArpSection(container) {
        const panel = document.createElement('div');
        panel.className = 'arp-inline';
        const title = document.createElement('span');
        title.className = 'panel-label';
        title.textContent = 'Arpeggiator';
        panel.append(title);

        const modeGroup = document.createElement('div');
        modeGroup.className = 'segmented';
        modeGroup.setAttribute('role', 'radiogroup');
        modeGroup.setAttribute('aria-label', 'Arpeggiator mode');
        const modeRadios = [];
        for (const m of ['auto', 'manual']) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = 'arp-mode';
          input.id = `arp-mode-${m}`;
          input.value = m;
          const lab = document.createElement('label');
          lab.htmlFor = input.id;
          lab.textContent = m === 'auto' ? 'Auto' : 'Manual';
          input.addEventListener('change', () => {
            if (!input.checked) return;
            settings.arp.mode = m;
            manual.hidden = m !== 'manual';
            engine.setParams({ arp: { mode: m } });
            updateComplexityDisplay();
            persistSettings();
          });
          modeGroup.append(input, lab);
          modeRadios.push(input);
        }
        panel.append(modeGroup);

        const manual = document.createElement('div');
        manual.className = 'arp-manual';
        panel.append(manual);

        function arpSelect(labelText, options, value, onChange) {
          const wrap = document.createElement('div');
          wrap.className = 'control';
          const id = `arp-${labelText.toLowerCase()}`;
          const lab = document.createElement('label');
          lab.htmlFor = id;
          lab.textContent = labelText;
          const select = document.createElement('select');
          select.id = id;
          for (const [v, text] of options) {
            const opt = document.createElement('option');
            opt.value = v;
            opt.textContent = text;
            select.append(opt);
          }
          select.value = value;
          select.addEventListener('change', () => onChange(select.value));
          wrap.append(lab, select);
          manual.append(wrap);
          return select;
        }

        function arpRange(labelText, { min, max, step, value, onChange }) {
          const wrap = document.createElement('div');
          wrap.className = 'control';
          const id = `arp-${labelText.toLowerCase()}`;
          const row = document.createElement('div');
          row.className = 'control-label-row';
          const lab = document.createElement('label');
          lab.htmlFor = id;
          lab.textContent = labelText;
          const readout = document.createElement('span');
          readout.className = 'value-readout';
          readout.textContent = String(value);
          row.append(lab, readout);
          const input = document.createElement('input');
          input.type = 'range';
          input.min = String(min);
          input.max = String(max);
          input.step = String(step);
          input.value = String(value);
          input.id = id;
          input.addEventListener('input', () => {
            readout.textContent = input.value;
            onChange(input.value);
          });
          wrap.append(row, input);
          manual.append(wrap);
          return { input, readout };
        }

        const pattern = arpSelect('Pattern', ARP_PATTERNS, settings.arp.pattern, (v) => {
          settings.arp.pattern = v;
          engine.setParams({ arp: { pattern: v } });
          persistSettings();
        });
        const rate = arpSelect('Rate', ARP_RATES, settings.arp.rate, (v) => {
          settings.arp.rate = v;
          engine.setParams({ arp: { rate: v } });
          updateComplexityDisplay();
          persistSettings();
          // The arp lane's length/pulse-marks are rate-derived (v8 ruling):
          // re-render its sequencer grid, same as a time-signature change.
          try {
            openEditors.get('arp')?.seq?.refresh();
          } catch {}
        });
        const octaves = arpRange('Octaves', {
          min: 1,
          max: 3,
          step: 1,
          value: settings.arp.octaves,
          onChange: (v) => {
            settings.arp.octaves = parseInt(v, 10);
            engine.setParams({ arp: { octaves: settings.arp.octaves } });
            persistSettings();
          },
        });
        const gate = arpRange('Gate', {
          min: 0.1,
          max: 1,
          step: 0.01,
          value: settings.arp.gate,
          onChange: (v) => {
            settings.arp.gate = parseFloat(v);
            engine.setParams({ arp: { gate: settings.arp.gate } });
            persistSettings();
          },
        });

        container.append(panel);
        arpUI = {
          modeRadios,
          manual,
          pattern,
          rate,
          octaves: octaves.input,
          octavesOut: octaves.readout,
          gate: gate.input,
          gateOut: gate.readout,
        };
        syncArpUI();
      }

      // Per-open-editor scope + knob handles, so re-renders, close and
      // engine state changes can tear down rAF loops and swap OFFLINE/LIVE.
      const openEditors = new Map(); // track -> { scope|null, knobs: [] }

      function teardownEditor(track) {
        const ed = openEditors.get(track);
        if (!ed) return;
        unregisterExtras(track, ed.extras);
        stateControls.delete(track);
        if (track === 'arp') arpUI = null;
        if (ed.scope) {
          if (ed.scope.debounce !== null) clearTimeout(ed.scope.debounce);
          if (ed.scope.live) {
            try {
              ed.scope.live.destroy();
            } catch {}
          }
          ed.scope.analyser = null;
        }
        for (const k of ed.knobs) {
          try {
            k.destroy?.();
          } catch {}
        }
        ed.seq?.destroy?.();
        openEditors.delete(track);
      }

      function scheduleScopeRender(track, immediate = false) {
        const ed = openEditors.get(track);
        if (!ed || !ed.scope || ed.scope.live) return;
        const s = ed.scope;
        if (s.debounce !== null) clearTimeout(s.debounce);
        s.debounce = setTimeout(
          () => {
            s.debounce = null;
            try {
              scopeApi.renderPatchWave(s.canvas, s.getPatch(), {
                freq: SCOPE_FREQ[track] || 220,
              });
            } catch {}
          },
          immediate ? 0 : 80
        );
      }

      function updateScopeMode(track) {
        const ed = openEditors.get(track);
        if (!ed || !ed.scope) return;
        const s = ed.scope;
        let analyser = null;
        // A power tier that withholds the live scope (eco) falls back to the
        // cheap static trace — no rAF loop attaches at all. Same for a track
        // switched off: its analyser node keeps existing (silent) as long as
        // the engine graph runs, so "off" has to be checked explicitly here
        // rather than inferred from analyser presence — see docs/engine-v2-
        // contract.md v19 roadmap "Offline waveform rule".
        const scopeAllowed = powerBudget ? powerBudget.scopeEnabled !== false : true;
        const trackOff = settings.tracks[track] && settings.tracks[track].state === 'off';
        if (scopeAllowed && !trackOff && engine.running && typeof engine.getAnalysers === 'function') {
          try {
            analyser = (engine.getAnalysers() || {})[track] || null;
          } catch {
            analyser = null;
          }
        }
        if (analyser && typeof scopeApi.attachLiveScope === 'function') {
          // rebuildContext() (interruption/sample-rate recovery, iOS wake)
          // swaps the engine's whole graph — including analyser nodes —
          // while `running` stays true, so a same-track re-evaluation must
          // compare node IDENTITY rather than just "are we already live":
          // an early `if (s.live) return` here would keep tracing a dead
          // analyser off a closed context forever.
          if (s.live && s.analyser === analyser) return;
          if (s.live) {
            try {
              s.live.destroy();
            } catch {}
            s.live = null;
            s.analyser = null;
          }
          if (s.debounce !== null) {
            clearTimeout(s.debounce);
            s.debounce = null;
          }
          try {
            s.live = scopeApi.attachLiveScope(s.canvas, analyser);
            s.analyser = s.live ? analyser : null;
          } catch {
            s.live = null;
            s.analyser = null;
          }
          if (s.live) {
            s.indicator.textContent = 'LIVE';
            s.indicator.classList.add('scope-mode-live');
            return;
          }
        }
        if (s.live) {
          try {
            s.live.destroy();
          } catch {}
          s.live = null;
          s.analyser = null;
        }
        s.indicator.textContent = 'OFFLINE';
        s.indicator.classList.remove('scope-mode-live');
        scheduleScopeRender(track, true);
      }

      function updateAllScopeModes() {
        for (const track of openEditors.keys()) updateScopeMode(track);
        updateFrontScope();
      }

      let veControlId = 0;

      function veSection(parent, heading) {
        const section = document.createElement('div');
        section.className = 've-section';
        const h = document.createElement('span');
        h.className = 've-heading';
        h.textContent = heading;
        section.append(h);
        parent.append(section);
        return section;
      }

      function veRange(parent, labelText, { min, max, step, value, log = false, format, onChange }) {
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `ve-control-${++veControlId}`;
        const row = document.createElement('div');
        row.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = labelText;
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        row.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        if (log) {
          input.min = '0';
          input.max = '1';
          input.step = '0.001';
          input.value = String(valueToLog(clamp(value, min, max), min, max));
        } else {
          input.min = String(min);
          input.max = String(max);
          input.step = String(step);
          input.value = String(clamp(value, min, max));
        }
        const fmt = format || ((v) => String(Math.round(v * 100) / 100));
        const current = () =>
          log ? logToValue(parseFloat(input.value), min, max) : parseFloat(input.value);
        readout.textContent = fmt(clamp(value, min, max));
        input.addEventListener('input', () => {
          const v = clamp(current(), min, max);
          readout.textContent = fmt(v);
          onChange(v);
        });
        wrap.append(row, input);
        parent.append(wrap);
        return input;
      }

      function veSelect(parent, labelText, { options, value, onChange }) {
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `ve-control-${++veControlId}`;
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = labelText;
        const select = document.createElement('select');
        select.id = id;
        for (const [v, text] of options) {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = text;
          if (v === String(value)) opt.selected = true;
          select.append(opt);
        }
        select.addEventListener('change', () => onChange(select.value));
        wrap.append(label, select);
        parent.append(wrap);
        return select;
      }

      const OSC_TYPES = [
        ['sine', 'Sine'],
        ['triangle', 'Triangle'],
        ['sawtooth', 'Sawtooth'],
        ['square', 'Square'],
      ];
      const FILTER_TYPES = [
        ['lowpass', 'Low-pass'],
        ['highpass', 'High-pass'],
        ['bandpass', 'Band-pass'],
        ['notch', 'Notch'],
      ];

      const hzFormat = (v) => `${Math.round(v)} Hz`;
      const secFormat = (v) => (v < 0.1 ? `${Math.round(v * 1000)} ms` : `${Math.round(v * 100) / 100} s`);
      const plainFormat = (v) => String(Math.round(v * 100) / 100);

      const FILTER_ORDER = ['lowpass', 'highpass', 'bandpass', 'notch'];
      const FILTER_DIAL_LABELS = ['LP', 'HP', 'BP', 'Notch'];
      // knob.js marks are numeric tick positions; the shape/type names show
      // in the knob's value readout via `format`.
      const SHAPE_MARKS = [0, 1, 2, 3];
      const shapeFormat = (v) => {
        const r = Math.round(clamp(v, 0, 3));
        if (Math.abs(v - r) < 0.05) return SHAPE_LABELS[r];
        return `${SHAPE_LABELS[Math.floor(v)]}~${SHAPE_LABELS[Math.ceil(v)]}`;
      };

      // ---- v19 sculpting surface (noise voices) + call synthesis ----------
      // Sixteen source fields the engine and the voice library landed together;
      // both editors below build their dials straight off this table, so a
      // label, a unit or a range is stated exactly once. `fallback` is only
      // reached when neither the stored patch nor the voice's own defaults
      // carry the field (an older save opened on a newer voice).
      //
      // Only the Hz centres are log-mapped: sweep/gust rates run 0–0.5 Hz and
      // 0.02–0.5 Hz, where a linear dial already gives the slow end most of
      // its travel, and sweepRate reaches 0 (which no log map can express).
      // None takes rangeDefault — v7 puts filter cutoff and the sends on that
      // list, not these; they open as single values and split on a click.
      const rateHzFormat = (v) => (v < 0.005 ? 'Off' : `${(Math.round(v * 100) / 100).toFixed(2)} Hz`);
      const octaveSpanFormat = (v) => `${plainFormat(v)} oct`;
      const semitoneFormat = (v) => {
        const n = Math.round(v);
        return n > 0 ? `+${n} st` : `${n} st`;
      };
      const perBarFormat = (v) => `${plainFormat(v)}/bar`;

      const SCULPT_GROUPS = [
        ['Spectral', [
          {
            field: 'tilt',
            label: 'Tilt',
            min: -1,
            max: 1,
            marks: [-1, 0, 1],
            fallback: 0,
            format: (v) => (v <= -0.995 ? 'Brown' : v >= 0.995 ? 'White' : plainFormat(v)),
            hint: 'The colour of the noise bed: brown and rumbling at the left, flat white at the right.',
          },
          {
            field: 'bandCentre',
            label: 'Band',
            min: 60,
            max: 8000,
            log: true,
            fallback: 800,
            format: hzFormat,
            hint: 'Where the resonant band sits — the pitch you hear in the bed. Low is a rumble, high is a hiss.',
          },
          {
            field: 'bandWidth',
            label: 'Width',
            min: 0.1,
            max: 4,
            step: 0.05,
            fallback: 2,
            format: octaveSpanFormat,
            hint: 'How wide that band is, in octaves. Narrow whistles at one pitch; wide is closer to open weather.',
          },
        ]],
        ['Motion', [
          {
            field: 'sweepRate',
            label: 'Sweep',
            min: 0,
            max: 0.5,
            step: 0.005,
            fallback: 0.05,
            format: rateHzFormat,
            hint: 'How fast the band sweeps up and down. Off at the left; a slow breath a little way in.',
          },
          {
            field: 'sweepDepth',
            label: 'Depth',
            min: 0,
            max: 1,
            fallback: 0.15,
            format: pctFormat,
            hint: 'How far that sweep travels. At zero the band holds still whatever the sweep rate says.',
          },
          {
            field: 'gust',
            label: 'Gust',
            min: 0,
            max: 1,
            fallback: 0.2,
            format: pctFormat,
            hint: 'A slow random walk on level and brightness — the wind picking up and dying back.',
          },
          {
            field: 'gustRate',
            label: 'Gust rate',
            min: 0.02,
            max: 0.5,
            step: 0.005,
            fallback: 0.08,
            format: rateHzFormat,
            hint: 'How quickly those gusts come and go.',
          },
          {
            field: 'swell',
            label: 'Swell',
            min: 0,
            max: 1,
            fallback: 0,
            format: pctFormat,
            hint: 'Stretches the attack into a crescendo — small is a gentle rise, full is storm-scale.',
          },
        ]],
        ['Bursts', [
          {
            field: 'burst',
            label: 'Density',
            min: 0,
            max: 1,
            fallback: 0.2,
            format: pctFormat,
            hint: 'How many grains land per second: droplets at the bottom, a downpour at the top.',
          },
          {
            field: 'burstSharp',
            label: 'Sharpness',
            min: 0,
            max: 1,
            fallback: 0.5,
            format: pctFormat,
            hint: 'The character of each grain — soft damp drops at the left, dry bright crackle at the right.',
          },
        ]],
      ];

      const CALL_GROUPS = [
        ['Glide', [
          {
            field: 'glide',
            label: 'Sweep',
            min: -24,
            max: 24,
            step: 1,
            marks: [-24, -12, 0, 12, 24],
            fallback: 0,
            format: semitoneFormat,
            hint: 'How far each call slides in pitch, in semitones. Negative falls, positive rises.',
          },
          {
            field: 'glideCurve',
            label: 'Curve',
            min: 0,
            max: 1,
            fallback: 0.5,
            format: pctFormat,
            hint: 'The shape of that slide: even at the left, snapping to the target end at the right.',
          },
        ]],
        ['Formants', [
          {
            field: 'formant1',
            label: 'Formant 1',
            min: 60,
            max: 8000,
            log: true,
            fallback: 900,
            format: hzFormat,
            hint: 'The lower of the two resonances that give the call its vowel — its body.',
          },
          {
            field: 'formant2',
            label: 'Formant 2',
            min: 60,
            max: 8000,
            log: true,
            fallback: 2200,
            format: hzFormat,
            hint: 'The upper resonance. Far above the first reads as a whistle; close to it, as a hoot.',
          },
        ]],
        ['Phrasing', [
          {
            field: 'cadence',
            label: 'Cadence',
            min: 0.5,
            max: 8,
            step: 0.1,
            fallback: 2,
            format: perBarFormat,
            hint: 'Calls per bar — a single long note at the left, chattering at the right.',
          },
          {
            field: 'irregular',
            label: 'Irregular',
            min: 0,
            max: 1,
            fallback: 0.25,
            format: pctFormat,
            hint: 'How unevenly those calls are spaced. Zero is metronomic; higher sounds like a living thing.',
          },
        ]],
      ];

      /**
       * Which v19 group sets this voice actually asks for. A voice declares a
       * family by SHIPPING its fields in `defaults` — the same test the voice
       * library uses internally — because `controls: true` means "every field
       * in the schema applies", which was written long before these sixteen
       * existed and must not be read as a claim about them. `controls` then
       * gets the final say, so a voice can still hide a field it defaults.
       */
      function v19GroupsFor(sourceSpec, defaults) {
        const shipped = defaults && isPlainObject(defaults.source) ? defaults.source : null;
        if (!shipped) return [];
        const groups = [];
        if (engineCaps.patchSculpt && shipped.tilt !== undefined && controlsFieldAllowed(sourceSpec, 'tilt')) {
          groups.push(...SCULPT_GROUPS);
        }
        if (engineCaps.patchCall && shipped.cadence !== undefined && controlsFieldAllowed(sourceSpec, 'cadence')) {
          groups.push(...CALL_GROUPS);
        }
        return groups;
      }

      /** A v19 field's starting value: the patch's, else the voice's, else the table's. */
      function v19Value(patch, defaults, spec) {
        const stored = isPlainObject(patch.source) ? patch.source[spec.field] : undefined;
        const shipped = defaults && isPlainObject(defaults.source) ? defaults.source[spec.field] : undefined;
        const fallback = isNumberOrRange(shipped) ? shipped : spec.fallback;
        return sanitiseRangeValueIn(stored, spec.min, spec.max, fallback);
      }

      // ---- v8: applicable-controls (voice metadata may hide sections) ----
      // `controls` (VOICES[track][voiceId].controls, may be absent) is
      // { source?, filter?, adsr?, sends? }, each true | false | string[] of
      // field names. Absent whole descriptor, or an absent section key,
      // means "applies" (render everything) — only an explicit false or a
      // field array narrows what's shown. Field names match the Patch
      // schema: source: shape1/shape2/mix/detune/octave; filter:
      // type/cutoff/q/envAmount; adsr: attack/decay/sustain/release;
      // sends: reverb/delay.
      function controlsSectionSpec(controls, section) {
        if (!isPlainObject(controls)) return true;
        const v = controls[section];
        return v === undefined ? true : v;
      }
      function controlsSectionVisible(spec) {
        if (spec === false) return false;
        if (Array.isArray(spec)) return spec.length > 0;
        return true;
      }
      function controlsFieldAllowed(spec, field) {
        if (spec === false) return false;
        if (Array.isArray(spec)) return spec.includes(field);
        return true;
      }

      // Fallback editor: the pre-v5 slider/select controls — the path when
      // knob.js is missing or its API throws. Writes the same
      // shape-normalised patch the knob editor writes.
      //
      // v7 RangeValue: a plain <input type=range> has one thumb, so this
      // editor stays a single-value editor for the fields the knob editor
      // now ranges (mix, detune, filter cutoff/q/envAmount, ADSR ×4, both
      // sends) — it reads a RangeValue's midpoint for display and always
      // writes back a plain number, collapsing any existing {min,max}.
      function buildSliderEditor(container, patch, commit, controls, track = null, defaults = null) {
        const sourceSpec = controlsSectionSpec(controls, 'source');
        const filterSpec = controlsSectionSpec(controls, 'filter');
        const adsrSpec = controlsSectionSpec(controls, 'adsr');
        const sendsSpec = controlsSectionSpec(controls, 'sends');

        const source = controlsSectionVisible(sourceSpec) ? veSection(container, 'Source') : null;
        if (source && controlsFieldAllowed(sourceSpec, 'shape1')) {
          veSelect(source, 'Osc 1', {
            options: OSC_TYPES,
            value: SHAPE_NAMES[Math.round(readShape(patch.source, 1) ?? 0)],
            onChange: (v) => {
              writeShape(patch.source, 1, SHAPE_FROM_STRING[v]);
              commit();
            },
          });
        }
        // Same v26 linkage the knob editor makes: no second oscillator, no
        // balance to set between them.
        let osc2Enabled = null;
        let syncMixControl = () => {};
        if (source && controlsFieldAllowed(sourceSpec, 'shape2')) {
          const initialShape2 = readShape(patch.source, 2);
          osc2Enabled = initialShape2 !== null;
          const osc2Control = veSelect(source, 'Osc 2', {
            options: [['none', 'None'], ...OSC_TYPES],
            value: initialShape2 === null ? 'none' : SHAPE_NAMES[Math.round(initialShape2)],
            onChange: (v) => {
              writeShape(patch.source, 2, v === 'none' ? null : SHAPE_FROM_STRING[v]);
              osc2Enabled = v !== 'none';
              syncMixControl();
              commit();
            },
          });
          if (osc2Control) describe(osc2Control, 'Adds a second oscillator; Mix balances the two.');
        }
        if (source && controlsFieldAllowed(sourceSpec, 'mix')) {
          const mixControl = veRange(source, 'Mix', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.source.mix, 0, 1, 0.5)),
            onChange: (v) => {
              patch.source.mix = v;
              commit();
            },
          });
          const mixWrap = mixControl ? mixControl.closest('.control') : null;
          if (osc2Enabled !== null && mixWrap) {
            syncMixControl = () => {
              mixWrap.hidden = !osc2Enabled;
            };
            syncMixControl();
          }
        }
        if (source && controlsFieldAllowed(sourceSpec, 'detune')) {
          const bipolar = engineCaps.patchDetuneBipolar;
          const detuneMin = bipolar ? -DETUNE_MAX : 0;
          veRange(source, 'Detune', {
            min: detuneMin,
            max: DETUNE_MAX,
            step: 1,
            value: rangeMid(sanitiseRangeValueIn(patch.source.detune, detuneMin, DETUNE_MAX, 4)),
            format: (v) => detuneFormat(v, bipolar),
            onChange: (v) => {
              const n = Math.round(v);
              patch.source.detune = bipolar && Math.abs(n) <= DETUNE_DETENT ? 0 : n;
              commit();
            },
          });
        }
        // v18: the same percussion Pitch/Noise swap the knob editor makes,
        // gated on the same engine probe (see buildKnobEditor).
        const pitchInPlaceOfOctave = track === 'percussion' && engineCaps.patchPitch;
        const sourceEditable = (field) =>
          controlsFieldAllowed(sourceSpec, field) || controlsFieldAllowed(sourceSpec, 'octave');

        if (source && !pitchInPlaceOfOctave && controlsFieldAllowed(sourceSpec, 'octave')) {
          veSelect(source, 'Octave', {
            options: [
              ['-1', '-1'],
              ['0', '0'],
              ['1', '+1'],
            ],
            value: String(patch.source.octave),
            onChange: (v) => {
              patch.source.octave = parseInt(v, 10);
              commit();
            },
          });
        }
        if (source && pitchInPlaceOfOctave && sourceEditable('pitch')) {
          veRange(source, 'Pitch', {
            min: -24,
            max: 24,
            step: 1,
            value: clamp(
              typeof patch.source.pitch === 'number'
                ? patch.source.pitch
                : (patch.source.octave || 0) * 12,
              -24,
              24
            ),
            format: (v) => (v > 0 ? `+${Math.round(v)} st` : `${Math.round(v)} st`),
            onChange: (v) => {
              patch.source.pitch = Math.round(clamp(v, -24, 24));
              commit();
            },
          });
        }
        if (source && track === 'percussion' && engineCaps.patchNoise && sourceEditable('noise')) {
          veRange(source, 'Noise', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.source.noise, 0, 1, defaults?.source?.noise ?? 1)),
            format: pctFormat,
            onChange: (v) => {
              patch.source.noise = clamp(v, 0, 1);
              commit();
            },
          });
        }
        if (
          source &&
          engineCaps.patchFold &&
          (controlsFieldAllowed(sourceSpec, 'fold') || controlsFieldAllowed(sourceSpec, 'shape1'))
        ) {
          veRange(source, 'Fold', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.source.fold, 0, 1, defaults?.source?.fold ?? 0)),
            format: pctFormat,
            onChange: (v) => {
              patch.source.fold = clamp(v, 0, 1);
              commit();
            },
          });
        }
        // The v19 groups get their own sections here too — the fallback is the
        // no-knob.js path, not a cut-down instrument, and these sixteen dials
        // ARE the sculpting voices. Single-value only, like every other
        // rangeable field in this editor.
        for (const [heading, specs] of v19GroupsFor(sourceSpec, defaults)) {
          const groupSection = veSection(container, heading);
          for (const spec of specs) {
            veRange(groupSection, spec.label, {
              min: spec.min,
              max: spec.max,
              step: spec.step || 0.01,
              log: spec.log === true,
              value: rangeMid(v19Value(patch, defaults, spec)),
              format: spec.format,
              onChange: (v) => {
                patch.source[spec.field] = spec.step === 1 ? Math.round(v) : v;
                commit();
              },
            });
          }
        }

        const filter = controlsSectionVisible(filterSpec) ? veSection(container, 'Filter') : null;
        if (filter && controlsFieldAllowed(filterSpec, 'type')) {
          veSelect(filter, 'Type', {
            options: FILTER_TYPES,
            value: patch.filter.type,
            onChange: (v) => {
              patch.filter.type = v;
              commit();
            },
          });
        }
        if (filter && controlsFieldAllowed(filterSpec, 'cutoff')) {
          veRange(filter, 'Cutoff', {
            min: 40,
            max: 12000,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.filter.cutoff, 40, 12000, 2000)),
            format: hzFormat,
            onChange: (v) => {
              patch.filter.cutoff = Math.round(v);
              commit();
            },
          });
        }
        if (filter && controlsFieldAllowed(filterSpec, 'q')) {
          veRange(filter, 'Resonance', {
            min: 0.1,
            max: 20,
            step: 0.1,
            value: rangeMid(sanitiseRangeValueIn(patch.filter.q, 0.1, 20, 0.7)),
            onChange: (v) => {
              patch.filter.q = v;
              commit();
            },
          });
        }
        if (filter && controlsFieldAllowed(filterSpec, 'envAmount')) {
          veRange(filter, 'Env amount', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.filter.envAmount, 0, 1, 0.3)),
            onChange: (v) => {
              patch.filter.envAmount = v;
              commit();
            },
          });
        }

        const adsr = controlsSectionVisible(adsrSpec) ? veSection(container, 'Envelope') : null;
        if (adsr && controlsFieldAllowed(adsrSpec, 'attack')) {
          veRange(adsr, 'Attack', {
            min: 0.001,
            max: 8,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.attack, 0.001, 8, 0.01)),
            format: secFormat,
            onChange: (v) => {
              patch.adsr.attack = v;
              commit();
            },
          });
        }
        if (adsr && controlsFieldAllowed(adsrSpec, 'decay')) {
          veRange(adsr, 'Decay', {
            min: 0.001,
            max: 8,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.decay, 0.001, 8, 0.2)),
            format: secFormat,
            onChange: (v) => {
              patch.adsr.decay = v;
              commit();
            },
          });
        }
        if (adsr && controlsFieldAllowed(adsrSpec, 'sustain')) {
          veRange(adsr, 'Sustain', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.sustain, 0, 1, 0.7)),
            onChange: (v) => {
              patch.adsr.sustain = v;
              commit();
            },
          });
        }
        if (adsr && controlsFieldAllowed(adsrSpec, 'release')) {
          veRange(adsr, 'Release', {
            min: 0.01,
            max: 12,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.release, 0.01, 12, 0.5)),
            format: secFormat,
            onChange: (v) => {
              patch.adsr.release = v;
              commit();
            },
          });
        }

        const sends = controlsSectionVisible(sendsSpec) ? veSection(container, 'Sends') : null;
        if (sends && controlsFieldAllowed(sendsSpec, 'reverb')) {
          veRange(sends, 'Reverb', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.sends.reverb, 0, 1, 0.3)),
            onChange: (v) => {
              patch.sends.reverb = v;
              commit();
            },
          });
        }
        if (sends && controlsFieldAllowed(sendsSpec, 'delay')) {
          veRange(sends, 'Delay', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.sends.delay, 0, 1, 0.15)),
            onChange: (v) => {
              patch.sends.delay = v;
              commit();
            },
          });
        }
      }

      // Knob-based editor (v5 module look). Throws only if createKnob does —
      // the caller catches and falls back to buildSliderEditor.
      // v12: `defaults` is the voice's own default Patch (base = deepMerge
      // (FALLBACK_PATCH, voice.defaults) in renderVoiceEditor) — every knob's
      // `defaultValue` comes from it, so double-click resets to what the
      // VOICE ships with, not just whatever the patch happened to load with.
      /**
       * `ghost` (v14 kit editor, percussion only) is null on the Common tab and
       * otherwise describes the per-instrument override being edited:
       *   { get(field), isOverridden(field), follow(field), refreshers }
       * `field` on a knob's options is the dotted patch path it edits
       * ('filter.cutoff'); it is consumed here, never passed to createKnob.
       */
      function buildKnobEditor(container, patch, commit, knobs, controls, defaults, ghost = null, track = null) {
        const sourceSpec = controlsSectionSpec(controls, 'source');
        const filterSpec = controlsSectionSpec(controls, 'filter');
        const adsrSpec = controlsSectionSpec(controls, 'adsr');
        const sendsSpec = controlsSectionSpec(controls, 'sends');
        const allowed = (spec, field) => controlsFieldAllowed(spec, field);

        const sections = document.createElement('div');
        sections.className = 'knob-sections';
        container.append(sections);

        function knobSection(heading) {
          const s = document.createElement('div');
          s.className = 'knob-section';
          const h = document.createElement('span');
          h.className = 'panel-label';
          h.textContent = heading;
          const row = document.createElement('div');
          row.className = 'knob-row';
          s.append(h, row);
          sections.append(s);
          return row;
        }

        function addKnob(row, options) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell';
          row.append(cell);
          const { field, ghostMap, ...knobOptions } = options;
          // The kit editor's "common" value, in this dial's own domain (a log
          // dial's ghost has to be mapped exactly as its live value was).
          // Handed to createKnob up front so a ghost-capable knob.js draws the
          // muted pointer on its first paint, not one frame later.
          const common = ghost && field ? ghost.get(field) : undefined;
          const ghostValue =
            common === undefined || common === null
              ? null
              : ghostMap
                ? ghostMap(common)
                : common;
          const handle = knobApi.createKnob(
            cell,
            ghostValue === null ? knobOptions : { ...knobOptions, ghostValue }
          );
          knobs.push(handle);
          if (ghostValue !== null) addGhost(cell, handle, field, knobOptions.format, ghostValue);
          return { cell, handle };
        }

        /**
         * The kit editor's "what does Common say" affordance, in whichever
         * form knob.js supports: a real GHOST POINTER on the dial face when it
         * exposes setGhost(), and otherwise a secondary text readout under the
         * dial ("common 2.0 kHz") with a dot in the track colour. Either way an
         * overridden dial takes the track accent (a ring on the cell) plus a
         * "follow" button that clears the override.
         */
        function addGhost(cell, handle, field, format, shown) {
          const fmt = typeof format === 'function' ? format : (v) => String(v);
          const pointer = typeof handle.setGhost === 'function';
          const row = document.createElement('div');
          row.className = 'knob-ghost';
          const follow = document.createElement('button');
          follow.type = 'button';
          follow.className = 'link-button knob-follow';
          follow.textContent = 'follow';
          follow.addEventListener('click', () => ghost.follow(field));
          describe(follow, 'Drop this instrument’s own value and follow the Common dial again.');
          if (pointer) {
            row.append(follow);
          } else {
            const dot = document.createElement('span');
            dot.className = 'knob-ghost-dot';
            dot.setAttribute('aria-hidden', 'true');
            const text = document.createElement('span');
            text.className = 'knob-ghost-value';
            text.textContent = `common ${
              isPlainObject(shown) ? `${fmt(shown.min)}–${fmt(shown.max)}` : fmt(shown)
            }`;
            row.append(dot, text, follow);
          }
          cell.classList.add('knob-cell-ghosted');
          if (pointer) cell.classList.add('knob-cell-ghost-pointer');
          cell.append(row);
          const refresh = () => {
            const overridden = ghost.isOverridden(field);
            cell.classList.toggle('knob-cell-overridden', overridden);
            follow.hidden = !overridden;
            // Re-asserted rather than set once: a knob that rebuilt its face
            // (a range split, a value commit) must not lose the pointer.
            if (pointer) {
              try {
                handle.setGhost(shown);
              } catch {}
            }
          };
          refresh();
          ghost.refreshers.push(refresh);
        }

        // The page owns the log transforms: the knob itself is linear, its
        // 0–1 position mapped onto the unit's range in format/onInput. v7:
        // `value`/the value onValue receives may be number|{min,max} — the
        // log map is monotonic over the (positive) domains this is used for,
        // so mapping each thumb independently preserves min ≤ max. `knobOpts`
        // carries allowRange/rangeDefault through to createKnob. v12:
        // `defaultLinear` (optional, same domain as `value`) is mapped through
        // the same toLog and passed on as the knob's `defaultValue`.
        function addLogKnob(row, label, min, max, value, format, onValue, knobOpts, defaultLinear) {
          const toLog = (v) => valueToLog(clamp(v, min, max), min, max);
          const fromLog = (t) => logToValue(clamp(t, 0, 1), min, max);
          return addKnob(row, {
            label,
            min: 0,
            max: 1,
            value: mapRV(value, toLog),
            format: (t) => format(fromLog(t)),
            onInput: (t) => onValue(mapRV(t, fromLog)),
            // The ghost readout is handed the COMMON patch value in this
            // param's own units, so it needs the same linear→log mapping the
            // live value got before the (log-domain) format runs on it.
            ghostMap: (v) => mapRV(v, toLog),
            ...(defaultLinear != null ? { defaultValue: mapRV(defaultLinear, toLog) } : {}),
            ...knobOpts,
          });
        }

        // -- source --
        const source = controlsSectionVisible(sourceSpec) ? knobSection('Source') : null;
        if (source && allowed(sourceSpec, 'shape1')) {
          addKnob(source, {
            label: 'OSC 1',
            field: 'source.shape1',
            glyphOnly: true,
            min: 0,
            max: 3,
            value: readShape(patch.source, 1) ?? 0,
            marks: SHAPE_MARKS,
            markGlyphs: SHAPE_MARK_GLYPHS,
            glyph: shapeGlyph,
            format: shapeFormat,
            defaultValue: readShape(defaults.source, 1) ?? 0,
            onInput: (v) => {
              writeShape(patch.source, 1, v);
              commit();
            },
          });
        }

        // v26: Mix is the osc1↔osc2 BALANCE, so it means nothing with one
        // source — it hides and re-shows with the Osc 2 toggle. `null` here is
        // "this voice has no Osc 2 control at all", which leaves Mix alone.
        let osc2Enabled = null;
        let syncMixCell = () => {};

        // Osc 2's "off" affordance: a toggle beside its dial (shape2 null).
        if (source && allowed(sourceSpec, 'shape2')) {
          let lastShape2 = readShape(patch.source, 2);
          osc2Enabled = lastShape2 !== null;
          const shape2Default = readShape(defaults.source, 2);
          const osc2Cell = document.createElement('div');
          osc2Cell.className = 'knob-cell knob-cell-toggle';
          const osc2Toggle = document.createElement('button');
          osc2Toggle.type = 'button';
          osc2Toggle.className = 'secondary-button osc2-toggle';
          osc2Toggle.textContent = 'Osc 2';
          osc2Toggle.setAttribute('aria-pressed', String(lastShape2 !== null));
          osc2Toggle.setAttribute('aria-label', 'Oscillator 2 on');
          osc2Cell.append(osc2Toggle);
          source.append(osc2Cell);
          describe(osc2Toggle, 'Adds a second oscillator; Mix balances the two.');

          const shape2Knob = addKnob(source, {
            label: 'OSC 2',
            field: 'source.shape2',
            glyphOnly: true,
            min: 0,
            max: 3,
            value: lastShape2 ?? 0,
            marks: SHAPE_MARKS,
            markGlyphs: SHAPE_MARK_GLYPHS,
            glyph: shapeGlyph,
            format: shapeFormat,
            // Only a voice whose own default has osc2 ON declares a dial
            // default here — an off-by-default voice has no canonical "on"
            // shape to reset to, so the knob falls back to its own initial
            // (0) while the cell is reachable at all (i.e. toggled on).
            ...(shape2Default != null ? { defaultValue: shape2Default } : {}),
            onInput: (v) => {
              lastShape2 = clamp(v, 0, 3);
              writeShape(patch.source, 2, lastShape2);
              commit();
            },
          });
          shape2Knob.cell.hidden = lastShape2 === null;

          osc2Toggle.addEventListener('click', () => {
            const on = osc2Toggle.getAttribute('aria-pressed') !== 'true';
            osc2Toggle.setAttribute('aria-pressed', String(on));
            shape2Knob.cell.hidden = !on;
            osc2Enabled = on;
            syncMixCell();
            if (on) {
              if (lastShape2 === null) lastShape2 = 0;
              writeShape(patch.source, 2, lastShape2);
              try {
                shape2Knob.handle.set?.(lastShape2);
              } catch {}
            } else {
              writeShape(patch.source, 2, null);
            }
            commit();
          });
        }

        if (source && allowed(sourceSpec, 'mix')) {
          const mixKnob = addKnob(source, {
            label: 'Mix',
            field: 'source.mix',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.source.mix, 0, 1, 0.5),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.source.mix,
            onInput: (v) => {
              patch.source.mix = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
          // Visibility only — patch.source.mix is left exactly as it was, so
          // re-enabling Osc 2 brings the stored balance back untouched.
          if (osc2Enabled !== null && mixKnob) {
            syncMixCell = () => {
              mixKnob.cell.hidden = !osc2Enabled;
            };
            syncMixCell();
          }
        }
        // v12 shipped this unipolar because the sanitiser clamped detune to
        // [0,50]; it has taken -50..50 since v18, and the boot probe says so
        // rather than the version number. Bipolar gets a centre detent: the
        // ±1 ct either side of zero is inaudible, so swallowing it buys a
        // dial you can return to true by feel.
        if (source && allowed(sourceSpec, 'detune')) {
          const bipolar = engineCaps.patchDetuneBipolar;
          const detuneMin = bipolar ? -DETUNE_MAX : 0;
          const detent = (x) => {
            const n = Math.round(clamp(x, detuneMin, DETUNE_MAX));
            return bipolar && Math.abs(n) <= DETUNE_DETENT ? 0 : n;
          };
          addKnob(source, {
            label: 'Detune',
            field: 'source.detune',
            min: detuneMin,
            max: DETUNE_MAX,
            step: 1,
            ...(bipolar ? { marks: [-DETUNE_MAX, 0, DETUNE_MAX] } : {}),
            value: sanitiseRangeValueIn(patch.source.detune, detuneMin, DETUNE_MAX, 4),
            format: (v) => detuneFormat(v, bipolar),
            allowRange: true,
            defaultValue: defaults.source.detune,
            onInput: (v) => {
              patch.source.detune = mapRV(v, detent);
              commit();
            },
          });
        }
        // v18: percussion trades the 3-position Octave switch for a continuous
        // Pitch dial (±24 semitones) and gains a Noise dial — but only where
        // the engine's own PATCH_SCHEMA accepts those fields (probed at boot).
        // Without engine support the Octave switch stays exactly as it was.
        const pitchInPlaceOfOctave = track === 'percussion' && engineCaps.patchPitch;
        // The voice's `controls` may not name the new fields yet: a percussion
        // voice that lets you edit Octave is letting you edit the same thing.
        const sourceEditable = (field) =>
          allowed(sourceSpec, field) || allowed(sourceSpec, 'octave');

        // v12: octave ships ±1, not the addendum's sketched ±2 — both the
        // engine sanitiser (patchNumber(v, -1, 1)) and every voice's own
        // OCTAVES = [-1, 0, 1] (engine-voices.js) clamp there; a ±2 dial
        // would silently round-trip through Math.round(clamp(v,-1,1)) and
        // never actually reach ±2.
        if (source && !pitchInPlaceOfOctave && allowed(sourceSpec, 'octave')) {
          addKnob(source, {
            label: 'Octave',
            field: 'source.octave',
            min: -1,
            max: 1,
            step: 1,
            value: clamp(patch.source.octave, -1, 1),
            marks: [-1, 0, 1],
            format: (v) => (v > 0 ? `+${Math.round(v)}` : String(Math.round(v))),
            defaultValue: defaults.source.octave,
            onInput: (v) => {
              patch.source.octave = Math.round(clamp(v, -1, 1));
              commit();
            },
          });
        }

        if (source && pitchInPlaceOfOctave && sourceEditable('pitch')) {
          const semitones = (v) => {
            const n = Math.round(v);
            return n > 0 ? `+${n} st` : `${n} st`;
          };
          addKnob(source, {
            label: 'Pitch',
            field: 'source.pitch',
            min: -24,
            max: 24,
            step: 1,
            // An older stored patch carries the octave switch instead; ×12
            // reads it in the new dial's units so nothing jumps on upgrade.
            value: clamp(
              typeof patch.source.pitch === 'number'
                ? patch.source.pitch
                : (patch.source.octave || 0) * 12,
              -24,
              24
            ),
            marks: [-24, -12, 0, 12, 24],
            format: semitones,
            defaultValue: defaults.source.pitch ?? (defaults.source.octave || 0) * 12,
            onInput: (v) => {
              patch.source.pitch = Math.round(clamp(v, -24, 24));
              commit();
            },
          });
        }

        if (source && track === 'percussion' && engineCaps.patchNoise && sourceEditable('noise')) {
          addKnob(source, {
            label: 'Noise',
            field: 'source.noise',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.source.noise, 0, 1, defaults.source.noise ?? 0.5),
            format: pctFormat,
            allowRange: engineCaps.patchNoiseRange,
            ...(defaults.source.noise != null ? { defaultValue: defaults.source.noise } : {}),
            onInput: (v) => {
              patch.source.noise = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }

        // v20 wavefolder: a shape MODIFIER, so it belongs to whatever has an
        // oscillator to fold — a voice that lets you re-type shape1 has one.
        // Bypassed at 0 (no extra nodes), which is every voice's default until
        // the library starts shipping folded ones.
        if (
          source &&
          engineCaps.patchFold &&
          (allowed(sourceSpec, 'fold') || allowed(sourceSpec, 'shape1'))
        ) {
          addKnob(source, {
            label: 'Fold',
            field: 'source.fold',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.source.fold, 0, 1, defaults.source.fold ?? 0),
            format: pctFormat,
            allowRange: true,
            defaultValue: defaults.source.fold ?? 0,
            onInput: (v) => {
              patch.source.fold = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }

        // -- v19 sculpting / call groups --
        // Their own labelled sub-rows rather than more dials crowded into
        // Source: sixteen fields in one row would read as a wall, and the
        // group names (Spectral / Motion / Bursts, Glide / Formants /
        // Phrasing) are how the surface is taught.
        for (const [heading, specs] of v19GroupsFor(sourceSpec, defaults)) {
          const row = knobSection(heading);
          for (const spec of specs) {
            const write = (v) => {
              patch.source[spec.field] = mapRV(v, (x) =>
                spec.step === 1 ? Math.round(clamp(x, spec.min, spec.max)) : clamp(x, spec.min, spec.max)
              );
              commit();
            };
            const knobOpts = {
              allowRange: engineCaps.patchV19Range,
              field: `source.${spec.field}`,
              ...(spec.step ? { step: spec.step } : {}),
              ...(spec.marks ? { marks: spec.marks } : {}),
            };
            const shipped = isPlainObject(defaults.source) ? defaults.source[spec.field] : undefined;
            const fallbackDefault = isNumberOrRange(shipped) ? shipped : spec.fallback;
            const cell = spec.log
              ? addLogKnob(
                  row,
                  spec.label,
                  spec.min,
                  spec.max,
                  v19Value(patch, defaults, spec),
                  spec.format,
                  write,
                  knobOpts,
                  fallbackDefault
                )
              : addKnob(row, {
                  label: spec.label,
                  min: spec.min,
                  max: spec.max,
                  value: v19Value(patch, defaults, spec),
                  format: spec.format,
                  defaultValue: fallbackDefault,
                  onInput: write,
                  ...knobOpts,
                });
            describe(cell.handle.el, spec.hint);
          }
        }

        // -- filter --
        const filter = controlsSectionVisible(filterSpec) ? knobSection('Filter') : null;
        if (filter && allowed(filterSpec, 'type')) {
          addKnob(filter, {
            label: 'Type',
            field: 'filter.type',
            // The dial's domain is the index, the patch stores the name.
            ghostMap: (v) => Math.max(0, FILTER_ORDER.indexOf(v)),
            min: 0,
            max: 3,
            step: 1,
            value: Math.max(0, FILTER_ORDER.indexOf(patch.filter.type)),
            marks: [0, 1, 2, 3],
            format: (v) => FILTER_DIAL_LABELS[Math.round(clamp(v, 0, 3))],
            defaultValue: Math.max(0, FILTER_ORDER.indexOf(defaults.filter.type)),
            onInput: (v) => {
              patch.filter.type = FILTER_ORDER[Math.round(clamp(v, 0, 3))];
              commit();
            },
          });
        }
        if (filter && allowed(filterSpec, 'cutoff')) {
          // v7: cutoff is on the default-RANGE list — rangeDefault starts a
          // freshly-opened (plain-number) patch already split into a
          // min=max=value range, ready for the second thumb.
          addLogKnob(
            filter,
            'Cutoff',
            40,
            12000,
            sanitiseRangeValueIn(patch.filter.cutoff, 40, 12000, 2000),
            hzFormat,
            (v) => {
              patch.filter.cutoff = mapRV(v, Math.round);
              commit();
            },
            { allowRange: true, rangeDefault: true, field: 'filter.cutoff' },
            defaults.filter.cutoff
          );
        }
        if (filter && allowed(filterSpec, 'q')) {
          addKnob(filter, {
            label: 'Resonance',
            field: 'filter.q',
            min: 0.1,
            max: 20,
            step: 0.1,
            value: sanitiseRangeValueIn(patch.filter.q, 0.1, 20, 0.7),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.filter.q,
            onInput: (v) => {
              patch.filter.q = mapRV(v, (x) => clamp(x, 0.1, 20));
              commit();
            },
          });
        }
        if (filter && allowed(filterSpec, 'envAmount')) {
          addKnob(filter, {
            label: 'Env amount',
            field: 'filter.envAmount',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.filter.envAmount, 0, 1, 0.3),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.filter.envAmount,
            onInput: (v) => {
              patch.filter.envAmount = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }

        // -- envelope --
        const env = controlsSectionVisible(adsrSpec) ? knobSection('Envelope') : null;
        if (env && allowed(adsrSpec, 'attack')) {
          addLogKnob(
            env,
            'Attack',
            0.001,
            8,
            sanitiseRangeValueIn(patch.adsr.attack, 0.001, 8, 0.01),
            secFormat,
            (v) => {
              patch.adsr.attack = v;
              commit();
            },
            { allowRange: true, field: 'adsr.attack' },
            defaults.adsr.attack
          );
        }
        if (env && allowed(adsrSpec, 'decay')) {
          addLogKnob(
            env,
            'Decay',
            0.001,
            8,
            sanitiseRangeValueIn(patch.adsr.decay, 0.001, 8, 0.2),
            secFormat,
            (v) => {
              patch.adsr.decay = v;
              commit();
            },
            { allowRange: true, field: 'adsr.decay' },
            defaults.adsr.decay
          );
        }
        if (env && allowed(adsrSpec, 'sustain')) {
          addKnob(env, {
            label: 'Sustain',
            field: 'adsr.sustain',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.adsr.sustain, 0, 1, 0.7),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.adsr.sustain,
            onInput: (v) => {
              patch.adsr.sustain = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
        if (env && allowed(adsrSpec, 'release')) {
          addLogKnob(
            env,
            'Release',
            0.01,
            12,
            sanitiseRangeValueIn(patch.adsr.release, 0.01, 12, 0.5),
            secFormat,
            (v) => {
              patch.adsr.release = v;
              commit();
            },
            { allowRange: true, field: 'adsr.release' },
            defaults.adsr.release
          );
        }

        // -- sends --
        // Both sends are on the v7 default-RANGE list too (like Cutoff
        // above) — rangeDefault starts a plain-number patch pre-split.
        const sends = controlsSectionVisible(sendsSpec) ? knobSection('Sends') : null;
        if (sends && allowed(sendsSpec, 'reverb')) {
          addKnob(sends, {
            label: 'Reverb',
            field: 'sends.reverb',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.sends.reverb, 0, 1, 0.3),
            format: plainFormat,
            allowRange: true,
            rangeDefault: true,
            defaultValue: defaults.sends.reverb,
            onInput: (v) => {
              patch.sends.reverb = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
        if (sends && allowed(sendsSpec, 'delay')) {
          addKnob(sends, {
            label: 'Delay',
            field: 'sends.delay',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.sends.delay, 0, 1, 0.15),
            format: plainFormat,
            allowRange: true,
            rangeDefault: true,
            defaultValue: defaults.sends.delay,
            onInput: (v) => {
              patch.sends.delay = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
      }

      /**
       * `opts.voiceId` overrides which voice the dial set edits — used when
       * the engine's voice wander has moved this track onto a different
       * voice (v14 "editor follows the sounding voice"). The row's <select>
       * is untouched: it keeps showing the user's own choice, because the
       * wander is ephemeral and getParams still reports the chosen voice.
       */
      async function renderVoiceEditor(track, opts = {}) {
        const container = document.getElementById(`voice-editor-${track}`);
        const voiceId = opts.voiceId || settings.tracks[track].voice;

        // Claim the editor slot BEFORE the await, not after: a quick row
        // switch closes this container (hiding it, tearing down whatever
        // was registered) while we're still awaiting the voices module, so
        // registering openEditors first lets that teardown actually find
        // and cancel us instead of racing a build onto a hidden container.
        teardownEditor(track);
        container.innerHTML = '';
        const ed = { scope: null, knobs: [], extras: null, seq: null };
        openEditors.set(track, ed);

        const voices = await getVoicesTable();
        if (container.hidden) return; // closed while awaiting — leave no live rAF scope loop behind
        const voiceEntry = voices && voices[track] && voices[track][voiceId] ? voices[track][voiceId] : null;
        // Feature-detect .defaults / .controls — absent on an older
        // engine-voices build; absent .controls = render every section/field
        // (the pre-v8 behaviour).
        const defaults = voiceEntry && voiceEntry.defaults ? voiceEntry.defaults : null;
        const controls = voiceEntry && voiceEntry.controls ? voiceEntry.controls : null;
        // The voice's full default Patch — every knob's `defaultValue` (what a
        // double-click returns to) is read off it. Same expression
        // resolveTrackPatch merges the stored override onto, so the dials and
        // the sound they describe can never disagree.
        const base = deepMerge(FALLBACK_PATCH, defaults || {});
        // resolveTrackPatch reads voicesTable (set by the getVoicesTable()
        // await just above) + normalises shapes the same way this used to
        // inline — also feeds the front oscilloscope's stopped-state preview.
        const patch = resolveTrackPatch(track, voiceId);

        // ---- v14 kit editor: Common | High | Mid | Low -------------------
        // The percussion patch may carry sparse per-instrument overrides at
        // patch.perKind[kind]; `kitKind` is null on the Common tab and the
        // kind id on an instrument tab. The dials always edit ONE object:
        // `editView` — the patch itself on Common, or a merged
        // common+override view on an instrument tab, whose differences from
        // common are folded back into perKind on every commit (so an
        // override only ever exists for a dial the user actually moved).
        // The engine may not honour perKind yet; the overrides persist and
        // are preset-captured regardless, and an engine that ignores the key
        // simply plays the common patch.
        //
        // v21: the tabs are the LANE list, not a fixed low/mid/high triple —
        // perKind keys follow lane ids, so a lane the user added gets its own
        // tab and its own overrides. The three built-in lanes keep the ids the
        // v14 kit editor wrote, so every stored override still lands.
        const kitCapable = track === 'percussion';
        const kitTabList = () =>
          kitCapable
            ? laneListFor(track, settings.tracks[track]).map((lane) => [lane.key, lane.label])
            : [];
        let kitKind =
          kitCapable && kitTabList().some(([k]) => k === opts.kind) ? opts.kind : null;
        let editView = patch;
        let ghostRefreshers = [];

        function commonPatch() {
          const clone = structuredClone(patch);
          delete clone.perKind;
          return clone;
        }

        function kindOverride(kind) {
          const per = isPlainObject(patch.perKind) ? patch.perKind : null;
          return per && isPlainObject(per[kind]) ? per[kind] : {};
        }

        /** Fields of `view` that differ from `common`, section by section. */
        function sparseOverride(common, view) {
          const out = {};
          for (const section of PATCH_SECTIONS) {
            const from = isPlainObject(common[section]) ? common[section] : {};
            const to = isPlainObject(view[section]) ? view[section] : {};
            for (const field of Object.keys(to)) {
              if (JSON.stringify(to[field]) === JSON.stringify(from[field])) continue;
              if (!out[section]) out[section] = {};
              out[section][field] = structuredClone(to[field]);
            }
          }
          return out;
        }

        function storePatch() {
          if (!settings.patches[track]) settings.patches[track] = {};
          settings.patches[track][voiceId] = patch;
          sendPatch(track, voiceId, patch);
          scheduleScopeRender(track);
          persistSettings();
          // The row's selector reads "Custom (…)" from this comparison.
          refreshVoiceSelect(track);
        }

        function commit() {
          if (kitKind) {
            const over = sparseOverride(commonPatch(), editView);
            if (!isPlainObject(patch.perKind)) patch.perKind = {};
            if (Object.keys(over).length) patch.perKind[kitKind] = over;
            else delete patch.perKind[kitKind];
            if (!Object.keys(patch.perKind).length) delete patch.perKind;
            for (const refresh of ghostRefreshers) refresh();
          }
          storePatch();
        }

        // v14 header: track name + "sounding" note, the Off/Auto/On state
        // control (moved out of the single-line row), the dice re-roll and
        // the Randomness mirror.
        container.classList.add(`track-color-${track}`);
        const header = document.createElement('div');
        header.className = 've-header';
        const headerTitle = document.createElement('span');
        headerTitle.className = 'panel-label ve-title';
        headerTitle.textContent = TRACK_LABELS[track];
        const sounding = document.createElement('span');
        sounding.className = 'value-readout ve-sounding';
        sounding.hidden = true;
        const extrasBox = document.createElement('div');
        extrasBox.className = 'track-extras ve-extras';
        header.append(headerTitle, sounding, extrasBox);
        container.append(header);
        buildStateControl(extrasBox, track);
        ed.extras = buildTrackExtras(extrasBox, track, { knobs: ed.knobs, withDice: true });
        ed.sounding = sounding;
        ed.voiceId = voiceId;
        registerExtras(track, ed.extras);
        // Mono/glide belong to the LINE, so they sit in the header beside the
        // state lamp rather than among the patch dials — and only on the
        // melodic tracks: a kit has no pitch to slur between.
        if (TUNED_TRACKS.includes(track)) buildMonoGlide(extrasBox, track, ed.knobs);
        buildVaryRow(container, track, ed.knobs);
        // v26: ONE aligned row for this track's feel dials — Dissonance,
        // Drift rate, Swing, Density, Breath — however few of them this
        // track and this engine build actually have.
        const feelRow = document.createElement('div');
        feelRow.className = 'dissonance-row feel-row';
        container.append(feelRow);
        buildDissonanceControl(feelRow, track, ed.knobs);
        buildDriftRateControl(feelRow, track, ed.knobs);
        buildFeelRow(feelRow, track, ed.knobs);
        buildPadBreathControl(feelRow, track, ed.knobs);
        if (!feelRow.childElementCount) feelRow.remove();

        // v6 step sequencer at the top of the pulsed tracks' panels. Arp
        // always shows it (on/off degrades to the legacy boolean mask);
        // melody/bass/percussion need engine support or the grid is dead.
        const showSeq =
          track === 'arp' ||
          ((SEQ_SINGLE_TRACKS.includes(track) || track === 'percussion') &&
            engineCaps.sequencer[track]);
        // Editing the lane list re-keys perKind, so the kit tabs below have to
        // follow it. Assigned once they exist; a no-op until then.
        let syncKitTabs = () => {};
        if (showSeq) ed.seq = buildSequencer(container, track, { onLanes: () => syncKitTabs() });

        // Arpeggiator controls live here now, above the voice sections.
        if (track === 'arp') buildArpSection(container);

        if (scopeApi) {
          const head = document.createElement('div');
          head.className = 'scope-head';
          const scopeCanvas = document.createElement('canvas');
          scopeCanvas.className = 'patch-scope';
          scopeCanvas.setAttribute('aria-label', `${track} voice waveform preview`);
          const indicator = document.createElement('span');
          indicator.className = 'scope-mode';
          indicator.textContent = 'OFFLINE';
          head.append(scopeCanvas, indicator);
          container.append(head);
          ed.scope = {
            canvas: scopeCanvas,
            indicator,
            live: null,
            analyser: null, // the analyser node s.live is currently attached to
            debounce: null,
            // The scope traces whatever the dials are editing — the common
            // patch, or the instrument view on a kit tab.
            getPatch: () => editView,
          };
          updateScopeMode(track); // draws the static trace or attaches live
        }

        // Kit tabs (percussion only), directly above the dials they retarget.
        let kitTabs = null;
        if (kitCapable) {
          kitTabs = document.createElement('div');
          kitTabs.className = 'segmented kit-tabs';
          kitTabs.setAttribute('role', 'radiogroup');
          kitTabs.setAttribute('aria-label', 'Kit editor target');
          const renderKitTabs = () => {
            kitTabs.innerHTML = '';
            for (const [value, labelText] of [['common', 'Common'], ...kitTabList()]) {
              const input = document.createElement('input');
              input.type = 'radio';
              input.name = `kit-kind-${track}`;
              input.id = `kit-kind-${track}-${value}`;
              input.value = value;
              input.checked = (kitKind || 'common') === value;
              const label = document.createElement('label');
              label.htmlFor = input.id;
              label.textContent = labelText;
              input.addEventListener('change', () => {
                if (!input.checked) return;
                kitKind = value === 'common' ? null : value;
                opts.kind = kitKind;
                buildPatchControls();
                scheduleScopeRender(track, true);
              });
              kitTabs.append(input, label);
            }
          };
          renderKitTabs();
          syncKitTabs = () => {
            // A lane the tabs were pointing at may have gone (or been
            // renamed): fall back to Common rather than editing an override
            // nothing plays any more.
            if (kitKind && !kitTabList().some(([k]) => k === kitKind)) {
              kitKind = null;
              opts.kind = null;
              renderKitTabs();
              buildPatchControls();
              scheduleScopeRender(track, true);
              return;
            }
            renderKitTabs();
          };
          container.append(kitTabs);
          describe(
            kitTabs,
            'Common holds the whole kit’s sound. Pick an instrument to give it its own values for any dial — the rest keep following Common.'
          );
        }

        // The dial set is rebuilt in place whenever the kit tab changes; the
        // knobs it owns are tracked separately so a rebuild destroys exactly
        // those and leaves the header/vary/sequencer knobs alone.
        const patchBox = document.createElement('div');
        patchBox.className = 'patch-controls';
        container.append(patchBox);
        let patchKnobs = [];

        function buildPatchControls() {
          for (const knob of patchKnobs) {
            try {
              knob.destroy?.();
            } catch {}
          }
          ed.knobs = ed.knobs.filter((knob) => !patchKnobs.includes(knob));
          patchKnobs = [];
          ghostRefreshers = [];
          patchBox.innerHTML = '';

          let ghost = null;
          if (kitKind) {
            const common = commonPatch();
            editView = deepMerge(common, kindOverride(kitKind));
            const readPath = (source, field) => {
              const [section, key] = field.split('.');
              const box = isPlainObject(source[section]) ? source[section] : null;
              return box ? box[key] : undefined;
            };
            ghost = {
              refreshers: ghostRefreshers,
              get: (field) => readPath(common, field),
              isOverridden: (field) => readPath(kindOverride(kitKind), field) !== undefined,
              follow: (field) => {
                const [section, key] = field.split('.');
                const per = isPlainObject(patch.perKind) ? patch.perKind : null;
                if (per && isPlainObject(per[kitKind]) && isPlainObject(per[kitKind][section])) {
                  delete per[kitKind][section][key];
                  if (!Object.keys(per[kitKind][section]).length) delete per[kitKind][section];
                  if (!Object.keys(per[kitKind]).length) delete per[kitKind];
                  if (!Object.keys(per).length) delete patch.perKind;
                }
                storePatch();
                buildPatchControls();
                scheduleScopeRender(track, true);
              },
            };
          } else {
            editView = patch;
          }

          let knobsBuilt = false;
          if (knobApi) {
            try {
              buildKnobEditor(patchBox, editView, commit, patchKnobs, controls, base, ghost, track);
              knobsBuilt = true;
            } catch {
              for (const knob of patchKnobs) {
                try {
                  knob.destroy?.();
                } catch {}
              }
              patchKnobs = [];
              patchBox.innerHTML = '';
            }
          }
          // Slider fallback: no knob.js, so no ghost pointers either — the
          // instrument tabs still edit the override, just without the
          // "common" read-out.
          if (!knobsBuilt) buildSliderEditor(patchBox, editView, commit, controls, track, base);
          ed.knobs.push(...patchKnobs);
          if (resetButton) resetButton.textContent = resetLabel();
        }

        function resetLabel() {
          if (!kitKind) return 'Reset to default';
          const found = kitTabList().find(([k]) => k === kitKind);
          return `Clear ${found ? found[1] : kitKind} overrides`;
        }

        const resetButton = document.createElement('button');
        resetButton.type = 'button';
        resetButton.className = 'secondary-button';
        resetButton.addEventListener('click', () => {
          if (kitKind) {
            // On an instrument tab, reset means "drop THIS instrument's
            // overrides" — the common patch the whole kit shares is not the
            // thing the user is looking at.
            const per = isPlainObject(patch.perKind) ? patch.perKind : null;
            if (per) {
              delete per[kitKind];
              if (!Object.keys(per).length) delete patch.perKind;
            }
            storePatch();
            buildPatchControls();
            scheduleScopeRender(track, true);
            return;
          }
          if (settings.patches[track]) {
            delete settings.patches[track][voiceId];
            if (Object.keys(settings.patches[track]).length === 0) {
              delete settings.patches[track];
            }
          }
          // An empty patch merges over the voice defaults engine-side; when
          // the defaults are known, send them explicitly for robustness.
          sendPatch(track, voiceId, defaults ? structuredClone(defaults) : {});
          persistSettings();
          refreshVoiceSelect(track);
          renderVoiceEditor(track);
        });

        buildPatchControls(); // also sets the reset button's label
        container.append(resetButton);
      }

      // ---- v8: single-open voice-editor accordion ------------------------
      // A track row gaining focus/selection (click or keyboard, anywhere
      // except the Edit button, which has its own explicit toggle below)
      // opens that track's editor and collapses any other open one. Both
      // paths funnel through the same open/close pair so they can never
      // fight each other, and both compose with teardownEditor (scope
      // destroy, knob destroy, extras unregister).
      // v13: closing an editor with the Edit toggle disarms focus-driven
      // reopening for that track until Edit is pressed again — otherwise the
      // next Tab into the row instantly undoes the close the user just asked
      // for. Only the Edit toggle re-arms it.
      const focusOpenDisarmed = new Set();

      function closeTrackEditor(id) {
        const editor = document.getElementById(`voice-editor-${id}`);
        const toggle = document.getElementById(`voice-edit-toggle-${id}`);
        if (editor.hidden) return;
        editor.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        teardownEditor(id);
      }

      // restoreScroll: only click-initiated opens put the viewport back
      // where the user's eye was — a keyboard/focusin-driven open (Tab
      // landing in the row) already has the browser scrolling the newly
      // focused control into view, and overriding that with the old
      // scrollY would just scroll the focused control back out of sight.
      function openTrackEditor(id, { restoreScroll = false } = {}) {
        const editor = document.getElementById(`voice-editor-${id}`);
        if (!editor.hidden) return; // already the one open
        const scrollY = restoreScroll ? window.scrollY : null;
        for (const other of TRACK_IDS) {
          if (other !== id) closeTrackEditor(other);
        }
        const toggle = document.getElementById(`voice-edit-toggle-${id}`);
        editor.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        renderVoiceEditor(id);
        if (restoreScroll) {
          // The accordion swap changes page height above/below the fold;
          // put the viewport back where the user's eye was.
          requestAnimationFrame(() => window.scrollTo(0, scrollY));
        }
      }

      function isEditToggle(el) {
        return !!(el && el.closest && el.closest('.voice-edit-toggle'));
      }

      // v14: a lamp/state click is a MUSICAL action, never a navigation one —
      // turning a track off must not expand (or keep open) its editor.
      function isStateControl(el) {
        return !!(el && el.closest && el.closest('.track-lamp'));
      }

      for (const id of TRACK_IDS) {
        const toggle = document.getElementById(`voice-edit-toggle-${id}`);
        const editor = document.getElementById(`voice-editor-${id}`);
        const row = document.querySelector(`.track-row[data-track="${id}"]`);

        // Edit button: explicit, secondary affordance — still routes through
        // the same accordion open/close so it can never desync from focus-
        // driven opens. It is also the ONLY thing that re-arms focus-opening
        // after an explicit close.
        toggle.addEventListener('click', () => {
          if (editor.hidden) {
            focusOpenDisarmed.delete(id);
            openTrackEditor(id, { restoreScroll: true });
          } else {
            focusOpenDisarmed.add(id);
            closeTrackEditor(id);
          }
        });

        // Row focus/selection: click or keyboard-focus anywhere in the row
        // (voice select, level knob, randomness knob) opens it, EXCEPT the
        // Edit button itself (handled above, to avoid a focusin-then-click
        // race that would open-then-instantly-close it) and the lamp.
        if (row) {
          row.addEventListener('click', (event) => {
            if (isEditToggle(event.target) || isStateControl(event.target)) return;
            if (focusOpenDisarmed.has(id)) return;
            openTrackEditor(id, { restoreScroll: true });
          });
          row.addEventListener('focusin', (event) => {
            if (isEditToggle(event.target) || isStateControl(event.target)) return;
            if (focusOpenDisarmed.has(id)) return;
            openTrackEditor(id);
          });
        }
      }

      // Tracks-panel row instance of the Randomness knob (no dice: that lives
      // in the Edit panel header only).
      for (const id of TRACK_IDS) {
        const box = document.getElementById(`track-extras-${id}`);
        registerExtras(id, buildTrackExtras(box, id));
      }

      // The two busiest generative tracks; the power governor's
      // textureDensityScale is applied to what the engine is SENT for these
      // (see applyPowerBudget), never to the user's stored Level. This is
      // page POLICY, not a registry view — the registry publishes identity
      // and presentation, nothing about how many notes a track spends — so
      // the ids stay named here, filtered against the live list so a track
      // this engine doesn't have can never be scaled.
      const POWER_SCALED_TRACKS = ['texture', 'arp'].filter((id) => TRACK_IDS.includes(id));

      function scaledLevel(track, value) {
        const scale = powerBudget ? powerBudget.textureDensityScale : 1;
        if (scale >= 1 || !POWER_SCALED_TRACKS.includes(track)) return value;
        return mapRV(value, (v) => clamp(v * scale, 0, 1));
      }

      // ---- v8: per-track Level knob (RangeValue: number | {min,max}) -----
      // Lives in the main tracks-panel row (not just the Edit panel), so
      // level is reachable without opening the accordion. Feature-tolerant:
      // always sent, regardless of whether this engine build understands
      // `tracks[track].level` — an older sanitiser just drops the key.
      const levelControls = new Map(); // track -> { set(value) }

      function buildLevelControl(container, track) {
        const commitLevel = (value) => {
          settings.tracks[track].level = value;
          engine.setParams({ tracks: { [track]: { level: scaledLevel(track, value) } } });
          persistSettings();
        };
        const readMid = (v) => (typeof v === 'number' ? v : (v.min + v.max) / 2);
        if (knobApi) {
          try {
            const cell = document.createElement('div');
            cell.className = 'level-knob';
            container.append(cell);
            const handle = knobApi.createKnob(cell, {
              label: 'Level',
              min: 0,
              max: 1,
              value: settings.tracks[track].level,
              format: pctFormat,
              allowRange: true,
              defaultValue: DEFAULTS.tracks[track].level,
              onInput: commitLevel,
            });
            return {
              set: (v) => {
                try {
                  handle.set?.(v);
                } catch {}
              },
            };
          } catch {
            container.innerHTML = '';
          }
        }
        const wrap = document.createElement('label');
        wrap.className = 'level-slider';
        const name = document.createElement('span');
        name.className = 'visually-hidden';
        name.textContent = `${TRACK_LABELS[track]} level`;
        const input = document.createElement('input');
        input.type = 'range';
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(readMid(settings.tracks[track].level));
        input.addEventListener('input', () => commitLevel(parseFloat(input.value)));
        wrap.append(name, input);
        container.append(wrap);
        return { set: (v) => (input.value = String(readMid(v))) };
      }

      for (const id of TRACK_IDS) {
        const box = document.getElementById(`track-level-${id}`);
        if (box && engineCaps.level[id]) levelControls.set(id, buildLevelControl(box, id));
      }

      // ---- v9/v14 power governor + Processor dial --------------------------
      // The dial reads Eco / Low / Med / Full / Auto; power.js owns the tier
      // budgets and the auto sensing, the page applies the parts of the
      // budget that live up here (live scope on/off, texture/arp density).
      const PROCESSOR_TIERS = ['eco', 'low', 'med', 'full', 'auto'];
      const PROCESSOR_LABELS = ['Eco', 'Low', 'Med', 'Full', 'Auto'];
      const processorReadout = document.getElementById('processor-readout');

      function applyPowerBudget(budget) {
        powerBudget = budget;
        if (processorReadout) {
          const requested = governor ? governor.getTier() : settings.ui.processor;
          const auto = requested === 'auto' ? ` (${budget.tier})` : '';
          processorReadout.textContent =
            `${PROCESSOR_LABELS[PROCESSOR_TIERS.indexOf(requested)] || 'Auto'}${auto}` +
            ` · ${budget.maxNotes === Infinity ? 'no note cap' : `${budget.maxNotes} notes`}` +
            ` · ${budget.visualFps} fps`;
        }
        // scopeEnabled: the page owns the live scope, so this one is applied
        // directly — updateAllScopeModes falls back to the cheap static
        // trace whenever the budget withholds it.
        updateAllScopeModes();
        // textureDensityScale: the engine has no density hook, so this is
        // applied as a LEVEL scale on the two busiest tracks (texture, arp).
        // It trims how present they are at a low tier; it does NOT reduce
        // node count — the real CPU lever is maxNotes, which power.js hands
        // to engine.setPowerBudget() itself. The user's own Level values are
        // never overwritten: only what we send the engine is scaled.
        applyDensityScale();
        // visualFps: visualiser.js grew setFps() (it clamps 1–60 and re-caps
        // its existing timestamp gate, so the reduced-motion 2 fps floor still
        // wins where it applies). Still feature-detected — scope.js has no
        // equivalent yet and self-caps instead.
        try {
          visualiserHandle?.setFps?.(budget.visualFps);
        } catch {}
        // reverbSeconds: the tier's ceiling on IR length. The user's own
        // Reverb tail setting is untouched; only what the engine is sent is
        // capped, so raising the tier restores the full tail.
        applyReverbTail();
      }

      function applyDensityScale() {
        const tracks = {};
        for (const id of POWER_SCALED_TRACKS) {
          if (!engineCaps.level[id]) continue;
          tracks[id] = { level: scaledLevel(id, settings.tracks[id].level) };
        }
        if (Object.keys(tracks).length) engine.setParams({ tracks });
      }

      function setProcessorTier(tier) {
        settings.ui.processor = tier;
        persistSettings();
        if (governor) governor.setTier(tier);
        else if (powerBudget) applyPowerBudget(powerBudget);
      }

      try {
      const { createGovernor } = await import('../scripts/power.js');
        if (typeof createGovernor === 'function') {
          governor = createGovernor({ engine, onTierChange: applyPowerBudget });
        }
      } catch {
        // No governor module: everything below simply never runs.
      }

      if (governor) {
        const tierIndex = Math.max(0, PROCESSOR_TIERS.indexOf(settings.ui.processor));
        processorDial = buildSimpleDial(
          'processor-dial',
          {
            id: 'processor',
            label: 'Processor',
            min: 0,
            max: 4,
            step: 1,
            marks: [0, 1, 2, 3, 4],
            value: tierIndex,
            format: (v) => PROCESSOR_LABELS[clamp(Math.round(v), 0, 4)],
            defaultValue: 4,
          },
          (v) => setProcessorTier(PROCESSOR_TIERS[clamp(Math.round(v), 0, 4)])
        );
        describe(
          processorDial.el,
          'How hard the generator may work. Auto watches CPU pressure and frame times and picks for you; Eco is the coolest, Full the busiest.'
        );
        setProcessorTier(settings.ui.processor);
      } else {
        document.querySelector('.processor-row')?.remove();
        // The dial's title lives in the transport panel's header row now, so
        // it has to go with it or the header names a control that isn't there.
        document.getElementById('processor-label')?.remove();
        document.getElementById('processor-readout')?.remove();
      }

      // ---- v13/v18 front-page oscilloscope (above the tabs) ---------------
      // One canvas, one coloured trace per selected track, between the
      // transport strip and the piano roll and persistent across both tabs.
      // scope.js owns the drawing, the colours (--track-<id> read off the
      // canvas), the analyser re-fetch and the fps/IntersectionObserver
      // gating; this block owns WHICH tracks are traced and whether the trace
      // may run at all (governor budget, collapsed panel, engine stopped),
      // plus the persisted panel state.
      //
      // attachMultiScope(canvas, engine, { tracks }) is feature-detected — the
      // page can deploy ahead of the scope.js that exports it, and then the
      // whole module stays hidden rather than showing a dead canvas. So is
      // setTracks(ids): without it, a selection change re-attaches instead.
      //
      // v18 legend: scope.js may own it (opts.legendContainer + the
      // onSelectionChange callback). That is detected by RESULT, not by
      // version — the opts go in on every attach, and if the container comes
      // back empty this block renders its own legend with the same markup,
      // colours and click/double-click gestures. The legend is also the
      // control surface while the trace is detached (stopped, collapsed,
      // budget-paused, or nothing selected), which is exactly when scope.js
      // is not there to draw it, so the fallback is a live path rather than
      // an old-build contingency.
      {
        const scopeModule = document.getElementById('front-scope-module');
        const scopeCanvas = document.getElementById('front-scope');
        const scopeBody = document.getElementById('front-scope-body');
        const scopeLegend = document.getElementById('front-scope-legend');
        const scopeToggle = document.getElementById('front-scope-toggle');
        const scopeWord = document.getElementById('front-scope-word');
        const scopeNote = document.getElementById('front-scope-note');
        const scopeOverlay = document.getElementById('front-scope-overlay');
        const scopeSpreadButton = document.getElementById('front-scope-spread');
        const scopeTotalButton = document.getElementById('front-scope-total');
        const scopeFullscreenButton = document.getElementById('front-scope-fullscreen');
        const available =
          !!scopeModule &&
          !!scopeCanvas &&
          !!scopeApi &&
          typeof scopeApi.attachMultiScope === 'function';

        if (!available) {
          if (scopeModule) scopeModule.hidden = true;
        } else {
          scopeModule.hidden = false;
          let handle = null;
          let attachedKey = '';
          // v26 scope options. Both are HANDLE capabilities the scope module
          // may not have landed yet, so neither button shows until an attach
          // has proved the method is there — a toggle that does nothing is
          // worse than no toggle.
          let spreadSupported = false;
          let totalSupported = false;
          const spreadOn = () => settings.ui.scopeSpread === true;
          const totalOn = () => settings.ui.scopeTotal === true;

          /**
           * The white "total" trace taps the POST-EFFECTS master output. The
           * engine currently publishes per-track analysers only, so this asks
           * getAnalysers() for a master key and then the accessor that would
           * carry one; with neither, the Total toggle never renders.
           *
           * Owed by the engine's next pass: a master/compressor-output
           * analyser, as `getMasterAnalyser()` or a 'master' key on
           * getAnalysers(). Nothing here changes when it lands.
           */
          function masterAnalyser() {
            try {
              const map = typeof engine.getAnalysers === 'function' ? engine.getAnalysers() : null;
              if (map) {
                for (const key of ['master', 'total', 'output']) {
                  if (map[key]) return map[key];
                }
              }
            } catch {}
            try {
              const node = engine.getMasterAnalyser?.();
              if (node) return node;
            } catch {}
            return null;
          }

          const applyScopeOptions = () => {
            if (!handle) return;
            try {
              handle.setSpread?.(spreadOn());
            } catch {}
            try {
              handle.setTotalVisible?.(totalSupported && totalOn());
            } catch {}
          };

          const syncScopeOptions = () => {
            const open = settings.ui.scopeOpen !== false;
            if (scopeSpreadButton) {
              scopeSpreadButton.hidden = !spreadSupported || !open;
              scopeSpreadButton.setAttribute('aria-pressed', String(spreadOn()));
            }
            if (scopeTotalButton) {
              scopeTotalButton.hidden = !totalSupported || !open;
              scopeTotalButton.setAttribute('aria-pressed', String(totalOn()));
            }
            if (scopeFullscreenButton && !scopeFullscreenButton.dataset.unsupported) {
              scopeFullscreenButton.hidden = !open;
            }
          };

          /**
           * The overlay sits ON the display. Where the scope module can say how
           * much of its own top edge it draws into (getLayout), the overlay is
           * pushed clear of it rather than guessing; an older module reports
           * nothing and the overlay stays flush with the top.
           */
          const applyOverlayLayout = () => {
            if (!scopeOverlay) return;
            let top = 0;
            try {
              const layout =
                handle && typeof handle.getLayout === 'function' ? handle.getLayout() : null;
              const reported = layout ? (layout.insetTop ?? layout.padTop ?? layout.top) : null;
              if (Number.isFinite(reported) && reported > 0) top = reported;
            } catch {}
            scopeOverlay.style.top = top ? `${Math.round(top)}px` : '';
          };

          if (scopeSpreadButton) {
            scopeSpreadButton.addEventListener('click', () => {
              settings.ui.scopeSpread = !spreadOn();
              persistSettings();
              applyScopeOptions();
              syncScopeOptions();
            });
            describe(
              scopeSpreadButton,
              'Give each track its own flat line to wobble on, stacked up the display.'
            );
          }
          if (scopeTotalButton) {
            scopeTotalButton.addEventListener('click', () => {
              settings.ui.scopeTotal = !totalOn();
              persistSettings();
              applyScopeOptions();
              syncScopeOptions();
            });
            describe(scopeTotalButton, 'Add a white trace of the finished mix, effects and all.');
          }
          // Set while a legend gesture is being applied, so the persist +
          // re-render it triggers can never be mistaken for a fresh gesture.
          let applyingSelection = false;
          const LEGEND_CLICK_DELAY_MS = 250;
          let pendingClickTimer = null;
          let pendingClickId = null;

          const selectedTracks = () => {
            const stored = settings.ui.scopeTracks;
            if (Array.isArray(stored)) return TRACK_IDS.filter((id) => stored.includes(id));
            // The live default: every track that isn't switched off.
            return TRACK_IDS.filter((id) => settings.tracks[id].state !== 'off');
          };

          const applySelection = (ids) => {
            if (applyingSelection) return;
            applyingSelection = true;
            try {
              settings.ui.scopeTracks = TRACK_IDS.filter((id) => ids.includes(id));
              persistSettings();
              updateFrontScope();
            } finally {
              applyingSelection = false;
            }
          };

          const detach = () => {
            if (!handle) return;
            try {
              handle.destroy?.();
            } catch {}
            handle = null;
            attachedKey = '';
          };

          // -- the page's own legend (scope.js's is preferred; see above) --
          const legendButtons = new Map();

          const clearPendingClick = () => {
            if (pendingClickTimer !== null) clearTimeout(pendingClickTimer);
            pendingClickTimer = null;
            pendingClickId = null;
          };

          const toggleTrack = (id) => {
            const current = selectedTracks();
            applySelection(current.includes(id) ? current.filter((t) => t !== id) : [...current, id]);
          };

          function buildPageLegend() {
            clearPendingClick();
            legendButtons.clear();
            scopeLegend.textContent = '';
            for (const id of TRACK_IDS) {
              const button = document.createElement('button');
              button.type = 'button';
              button.className = `scope-legend-track track-color-${id}`;
              const dot = document.createElement('span');
              dot.className = 'scope-legend-dot';
              dot.setAttribute('aria-hidden', 'true');
              const label = document.createElement('span');
              label.className = 'scope-legend-label';
              label.textContent = TRACK_LABELS[id];
              button.append(dot, label);
              // A single click toggles, a double click solos: the toggle waits
              // out the double-click window so a solo never flickers through
              // an off state first.
              button.addEventListener('click', () => {
                if (pendingClickTimer !== null && pendingClickId === id) {
                  clearPendingClick();
                  return;
                }
                clearPendingClick();
                pendingClickId = id;
                pendingClickTimer = setTimeout(() => {
                  pendingClickTimer = null;
                  pendingClickId = null;
                  toggleTrack(id);
                }, LEGEND_CLICK_DELAY_MS);
              });
              button.addEventListener('dblclick', () => {
                clearPendingClick();
                applySelection([id]);
              });
              describe(button, `Show ${TRACK_LABELS[id]} on the oscilloscope. Double-click to solo it.`);
              legendButtons.set(id, button);
              scopeLegend.append(button);
            }
          }

          const syncPageLegend = (ids) => {
            for (const [id, button] of legendButtons) {
              button.setAttribute('aria-pressed', String(ids.includes(id)));
            }
          };

          /** scope.js empties the container on destroy, so this re-checks every pass. */
          const ensureLegend = (ids) => {
            if (scopeLegend.querySelector('.scope-legend-track:not([data-page-legend])')) {
              // scope.js's own legend is in place and syncs itself.
              legendButtons.clear();
              return;
            }
            if (!legendButtons.size || !scopeLegend.firstElementChild) {
              buildPageLegend();
              for (const button of legendButtons.values()) button.dataset.pageLegend = '';
            }
            syncPageLegend(ids);
          };

          scopeToggle.addEventListener('click', () => {
            settings.ui.scopeOpen = !settings.ui.scopeOpen;
            persistSettings();
            updateFrontScope();
          });
          describe(scopeToggle, 'Show or hide the oscilloscope.');

          updateFrontScope = function updateFrontScopeImpl() {
            const open = settings.ui.scopeOpen !== false;
            scopeBody.hidden = !open;
            scopeToggle.setAttribute('aria-expanded', String(open));
            // Collapsed is the one state that shows the module's name — and
            // the one state where the overlay drops back into the flow,
            // because there is no display left underneath it.
            if (scopeWord) scopeWord.hidden = open;
            scopeModule.classList.toggle('scope-collapsed', !open);
            syncScopeOptions();
            const ids = selectedTracks();

            const allowed = powerBudget ? powerBudget.scopeEnabled !== false : true;
            if (!allowed || !open || !ids.length) {
              detach();
              scopeNote.textContent = !allowed
                ? 'paused — Processor tier'
                : !ids.length
                  ? 'no tracks selected'
                  : '';
              ensureLegend(ids);
              return;
            }
            if (!engine.running) {
              // v19 roadmap "Offline waveform rule": stopped shows a
              // composite static preview of every selected track's current
              // patch, overlaid on the shared graticule, rather than the
              // blank/detached canvas this used to leave behind.
              // Owner ruling (fromMartin 22, supersedes the v19 stopped-state
              // composite here): the front scope stays DARK until Play — the
              // live trace is kept as a surprise. Editor scopes keep their
              // static previews; only this front composite is retired.
              detach();
              try {
                const c2d = scopeCanvas.getContext('2d');
                c2d && c2d.clearRect(0, 0, scopeCanvas.width, scopeCanvas.height);
              } catch { /* cosmetic */ }
              scopeNote.textContent = 'press Play';
              ensureLegend(ids);
              return;
            }
            scopeNote.textContent = '';

            const key = ids.join(',');
            if (handle && key === attachedKey) {
              ensureLegend(ids);
              return;
            }
            if (handle && typeof handle.setTracks === 'function') {
              try {
                handle.setTracks(ids);
                attachedKey = key;
                ensureLegend(ids);
                return;
              } catch {
                // fall through to a clean re-attach
              }
            }
            detach();
            const total = masterAnalyser();
            try {
              handle = scopeApi.attachMultiScope(scopeCanvas, engine, {
                tracks: ids,
                legendContainer: scopeLegend,
                onSelectionChange: (next) => {
                  if (Array.isArray(next)) applySelection(next);
                },
                // v26 options. A scope build that predates them ignores the
                // extra keys; the setters below are what actually prove it
                // can honour either one.
                spread: spreadOn(),
                totalVisible: totalOn(),
                ...(total ? { totalAnalyser: total } : {}),
              });
            } catch {
              handle = null;
            }
            if (handle) {
              attachedKey = key;
              spreadSupported = typeof handle.setSpread === 'function';
              totalSupported = typeof handle.setTotalVisible === 'function' && !!total;
              applyScopeOptions();
              applyOverlayLayout();
            } else {
              scopeNote.textContent = 'unavailable';
            }
            syncScopeOptions();
            ensureLegend(ids);
          };
        }
      }

      // ---- v26 fullscreen for the two displays ---------------------------
      // Both the oscilloscope and the piano roll carry a ⛶. Whichever one is
      // pressed goes fullscreen alone, and a "+ the other" control then
      // stacks the second below it. The modules are MOVED into the fullscreen
      // host and put back on exit rather than duplicated, so each keeps its
      // canvas bitmap, its listeners and its live handle; both redraw at the
      // new size (and dpr) off their own ResizeObserver. Esc, the browser's
      // own exit affordance and the Exit button all land in one place.
      {
        const stage = document.getElementById('fullscreen-stage');
        const slots = document.getElementById('fullscreen-slots');
        const addButton = document.getElementById('fullscreen-add');
        const exitButton = document.getElementById('fullscreen-exit');
        const DISPLAYS = [
          {
            id: 'scope',
            label: 'oscilloscope',
            el: document.getElementById('front-scope-module'),
            button: document.getElementById('front-scope-fullscreen'),
          },
          {
            id: 'roll',
            label: 'piano roll',
            el: document.getElementById('roll-stage'),
            button: document.getElementById('roll-fullscreen'),
          },
        ].filter((display) => display.el && display.button);

        const supported =
          !!stage &&
          !!slots &&
          !!addButton &&
          !!exitButton &&
          typeof stage.requestFullscreen === 'function' &&
          typeof document.exitFullscreen === 'function';

        if (!supported) {
          for (const display of DISPLAYS) {
            display.button.hidden = true;
            display.button.dataset.unsupported = '';
          }
        } else {
          // A comment node marks where each borrowed module came from, so the
          // order they were taken in cannot affect where they go back.
          const markers = new Map();
          let shown = [];

          const moveIn = (display) => {
            if (shown.includes(display.id) || !display.el.parentNode) return;
            const marker = document.createComment(`fullscreen:${display.id}`);
            display.el.parentNode.insertBefore(marker, display.el);
            markers.set(display.id, marker);
            slots.append(display.el);
            shown.push(display.id);
          };

          const restoreAll = () => {
            for (const [id, marker] of markers) {
              const display = DISPLAYS.find((entry) => entry.id === id);
              if (display && marker.parentNode) marker.parentNode.replaceChild(display.el, marker);
            }
            markers.clear();
            shown = [];
          };

          const missingDisplay = () => DISPLAYS.find((display) => !shown.includes(display.id));

          const syncChrome = () => {
            const active = document.fullscreenElement === stage;
            stage.hidden = !active;
            const missing = missingDisplay();
            addButton.hidden = !active || !missing;
            if (missing) addButton.textContent = `+ ${missing.label}`;
            for (const display of DISPLAYS) {
              display.button.setAttribute('aria-pressed', String(active && shown[0] === display.id));
            }
          };

          for (const display of DISPLAYS) {
            display.button.addEventListener('click', () => {
              if (document.fullscreenElement === stage) {
                Promise.resolve(document.exitFullscreen()).catch(() => {});
                return;
              }
              stage.hidden = false;
              moveIn(display);
              syncChrome();
              Promise.resolve(stage.requestFullscreen()).catch(() => {
                restoreAll();
                syncChrome();
              });
            });
            describe(display.button, `Show the ${display.label} full screen.`);
          }

          addButton.addEventListener('click', () => {
            const missing = missingDisplay();
            if (missing) moveIn(missing);
            syncChrome();
          });
          exitButton.addEventListener('click', () => {
            Promise.resolve(document.exitFullscreen()).catch(() => {});
          });
          document.addEventListener('fullscreenchange', () => {
            if (document.fullscreenElement !== stage) restoreAll();
            syncChrome();
          });
          syncChrome();
        }
      }

      // ---- v14 sequencer playhead ----------------------------------------
      // The sounding step lights white. One 'bar' event schedules that bar's
      // step changes as plain timeouts (≤20 per bar, and only while an editor
      // with a grid is open) — a DOM class swap at step rate, never a rAF
      // loop and nothing at all while the grids are closed.
      let playheadTimers = [];

      function clearPlayheadTimers() {
        for (const timer of playheadTimers) clearTimeout(timer);
        playheadTimers = [];
      }

      function clearPlayhead() {
        clearPlayheadTimers();
        for (const ed of openEditors.values()) ed.seq?.setPlayhead(-1);
      }

      function schedulePlayhead(barTime, beatsPerBar) {
        clearPlayheadTimers();
        const barSeconds = (beatsPerBar || 4) * (60 / clamp(settings.bpm, 40, 120));
        for (const [track, ed] of openEditors) {
          if (!ed.seq) continue;
          const n = stepsPerBarFor(track);
          const stepSeconds = barSeconds / n;
          for (let i = 0; i < n; i++) {
            const delayMs = (barTime + i * stepSeconds - engine.now()) * 1000;
            if (delayMs < -stepSeconds * 1000) continue; // already past
            playheadTimers.push(
              setTimeout(() => {
                try {
                  ed.seq?.setPlayhead(i);
                } catch {}
              }, Math.max(0, delayMs))
            );
          }
        }
      }

      // ---- v9 per-track cost meters --------------------------------------
      // A thin bar in each row, tinted by that track's own colour, fed from
      // engine.getStats() at 1 Hz while running (and once on stop, to empty
      // them). Nothing polls while the engine is idle.
      const COST_METER_FULL = 12; // active notes that read as a full bar
      let costTimer = null;

      function updateCostMeters() {
        let stats = null;
        try {
          stats = engine.getStats();
        } catch {}
        const perTrack = stats && isPlainObject(stats.perTrack) ? stats.perTrack : null;
        for (const id of TRACK_IDS) {
          const meter = document.getElementById(`cost-meter-${id}`);
          if (!meter) continue;
          const entry = perTrack ? perTrack[id] : null;
          const share = entry ? clamp(entry.activeNotes / COST_METER_FULL, 0, 1) : 0;
          meter.hidden = !perTrack;
          meter.firstElementChild.style.width = `${Math.round(share * 100)}%`;
          meter.setAttribute(
            'aria-label',
            `${TRACK_LABELS[id]} load: ${entry ? entry.activeNotes : 0} notes sounding`
          );
        }
      }

      function setCostPolling(on) {
        if (!engineCaps.getStats) return;
        if (on) {
          if (costTimer === null) costTimer = setInterval(updateCostMeters, 1000);
          updateCostMeters();
        } else if (costTimer !== null) {
          clearInterval(costTimer);
          costTimer = null;
          updateCostMeters();
        }
      }

      // ---- v14 live readouts (resolved / drifting values) -----------------
      // engine.getResolved() reports what is ACTUALLY being played right now:
      // every RangeValue resolved through its walk, and the voice that is
      // really sounding (voice wander included). Polled at 4 Hz while
      // running; the numbers land as secondary text beside the row's dials,
      // and a wander to a different voice re-renders the open editor so the
      // dial set follows the voice you can hear.
      let resolvedTimer = null;

      function applyResolved(resolved) {
        const tracks = resolved && isPlainObject(resolved.tracks) ? resolved.tracks : null;
        for (const id of TRACK_IDS) {
          const readout = document.getElementById(`resolved-${id}`);
          if (!readout) continue;
          const entry = tracks ? tracks[id] : null;
          if (!entry) {
            readout.textContent = '';
            continue;
          }
          const bits = [`level ${pctFormat(entry.level ?? 0)}`];
          bits.push(entry.held ? 'held' : `random ${pctFormat(entry.randomness ?? 0)}`);
          // Iteration 4: swing/density resolved values, feature-detected on
          // the live payload itself — this engine may report them on some
          // tracks and not others (swing on the pulsed ones, density on the
          // tuned ones), exactly like `dissonance` above already does.
          if (typeof entry.swing === 'number') bits.push(`swing ${pctFormat(entry.swing)}`);
          if (typeof entry.density === 'number') bits.push(`density ${plainFormat(entry.density)}×`);
          readout.textContent = bits.join(' · ');
        }
        // v18: the row's <select> follows the SOUNDING voice too (through its
        // display-only first option — the stored choice is never overwritten).
        // Only a CHANGE redraws it: this runs at 4 Hz.
        for (const id of TRACK_IDS) {
          const entry = tracks ? tracks[id] : null;
          const voice = entry && typeof entry.voice === 'string' ? entry.voice : null;
          if (!voice || soundingVoice.get(id) === voice) continue;
          soundingVoice.set(id, voice);
          refreshVoiceSelect(id);
        }
        // The editor follows the SOUNDING voice as well: its header says what
        // is actually sounding, and the dial set re-renders when that changes.
        // Snapshot the entries: a wander re-render replaces this track's
        // openEditors entry mid-loop, which a live Map iteration would trip
        // over.
        for (const [track, ed] of Array.from(openEditors)) {
          const entry = tracks ? tracks[track] : null;
          const voice = entry ? entry.voice : null;
          if (!voice || !ed.sounding) continue;
          const chosen = settings.tracks[track].voice;
          ed.sounding.hidden = voice === chosen;
          ed.sounding.textContent = voice === chosen ? '' : `sounding: ${voiceLabel(track, voice)}`;
          if (voice !== ed.voiceId) renderVoiceEditor(track, { voiceId: voice });
        }
      }

      function setResolvedPolling(on) {
        if (!engineCaps.getResolved) return;
        if (on) {
          if (resolvedTimer === null) {
            resolvedTimer = setInterval(() => {
              try {
                applyResolved(engine.getResolved());
              } catch {}
            }, 250);
          }
        } else if (resolvedTimer !== null) {
          clearInterval(resolvedTimer);
          resolvedTimer = null;
        }
      }

      function voiceLabel(track, voiceId) {
        const found = VOICE_LABELS[track]?.[voiceId];
        return found || voiceId;
      }

      /** A voice's synthesis class, when engine-voices exports one (v18). */
      function voiceEngineType(track, voiceId) {
        const entry = voicesTable?.[track]?.[voiceId];
        const type = entry && typeof entry.engineType === 'string' ? entry.engineType.trim() : '';
        return type ? type[0].toUpperCase() + type.slice(1) : null;
      }

      /** Shape-normalised copy, so an osc1/shape1 spelling never reads as an edit. */
      function normalisedPatch(patch) {
        const copy = structuredClone(patch);
        if (!isPlainObject(copy.source)) copy.source = {};
        writeShape(copy.source, 1, readShape(copy.source, 1) ?? 0);
        writeShape(copy.source, 2, readShape(copy.source, 2));
        return copy;
      }

      /** Does the stored patch for this voice differ from the voice's own defaults? */
      function patchIsEdited(track, voiceId) {
        const stored = (settings.patches[track] || {})[voiceId];
        if (!isPlainObject(stored)) return false;
        const entry = voicesTable?.[track]?.[voiceId];
        const base = normalisedPatch(deepMerge(FALLBACK_PATCH, (entry && entry.defaults) || {}));
        const live = normalisedPatch(deepMerge(base, stored));
        if (isPlainObject(live.perKind) && Object.keys(live.perKind).length) return true;
        for (const section of PATCH_SECTIONS) {
          const from = isPlainObject(base[section]) ? base[section] : {};
          const to = isPlainObject(live[section]) ? live[section] : {};
          for (const field of new Set([...Object.keys(from), ...Object.keys(to)])) {
            if (JSON.stringify(from[field]) !== JSON.stringify(to[field])) return true;
          }
        }
        return false;
      }

      /**
       * v18: the row's <select> shows what you are HEARING — the sounding
       * voice once wander has moved it, and "Custom (Subtractive)" when that
       * voice's patch has been edited away from its defaults. Both are a
       * dynamic, disabled first option: settings.tracks[t].voice keeps the
       * user's own selection untouched whatever the engine is doing, and the
       * option disappears again the moment the two agree. Called on wander
       * (applyResolved) and on every patch commit, never on a timer.
       */
      function refreshVoiceSelect(track) {
        const select = document.getElementById(`track-voice-${track}`);
        if (!select) return;
        const chosen = settings.tracks[track].voice;
        const sounding = soundingVoice.get(track) || chosen;
        const edited = patchIsEdited(track, sounding);
        let live = select.querySelector('.voice-live-option');
        if (!edited && sounding === chosen) {
          if (live) live.remove();
          select.value = chosen;
          return;
        }
        if (!live) {
          live = document.createElement('option');
          live.className = 'voice-live-option';
          live.value = VOICE_LIVE_VALUE;
          live.disabled = true;
          select.prepend(live);
        }
        const engineType = edited ? voiceEngineType(track, sounding) : null;
        const text = edited
          ? engineType
            ? `Custom (${engineType})`
            : 'Custom'
          : voiceLabel(track, sounding);
        if (live.textContent !== text) live.textContent = text;
        live.selected = true;
      }

      // ---- structure + custom structure builder -------------------------

      const customBuilder = document.getElementById('custom-structure-builder');
      const structureBlocks = document.getElementById('structure-blocks');
      const addBlockButton = document.getElementById('add-structure-block');
      const blockLabels = ['A', 'B', 'C', 'D'];

      function renderStructureBlocks() {
        structureBlocks.innerHTML = '';
        settings.customStructure.forEach((block, index) => {
          const row = document.createElement('div');
          row.className = 'structure-block';

          const labelSelect = document.createElement('select');
          labelSelect.setAttribute('aria-label', `Block ${index + 1} label`);
          for (const l of blockLabels) {
            const opt = document.createElement('option');
            opt.value = l;
            opt.textContent = `Section ${l}`;
            if (l === block.label) opt.selected = true;
            labelSelect.append(opt);
          }
          labelSelect.addEventListener('change', () => {
            settings.customStructure[index].label = labelSelect.value;
            commitCustomStructure();
          });

          const barsInput = document.createElement('input');
          barsInput.type = 'number';
          barsInput.min = '1';
          barsInput.max = '32';
          barsInput.value = String(block.bars);
          barsInput.setAttribute('aria-label', `Block ${index + 1} bars`);
          barsInput.addEventListener('input', () => {
            const parsed = parseInt(barsInput.value, 10);
            if (!Number.isFinite(parsed)) return; // mid-edit blank; keep stored value
            const bars = Math.round(clamp(parsed, 1, 32));
            settings.customStructure[index].bars = bars;
            // Reflect the clamp so UI, stored state and engine can't diverge.
            if (barsInput.value !== String(bars)) barsInput.value = String(bars);
            commitCustomStructure();
          });

          const intensityInput = document.createElement('input');
          intensityInput.type = 'range';
          intensityInput.min = '0';
          intensityInput.max = '1';
          intensityInput.step = '0.01';
          intensityInput.value = String(block.intensity);
          intensityInput.setAttribute('aria-label', `Block ${index + 1} intensity`);
          intensityInput.addEventListener('input', () => {
            settings.customStructure[index].intensity = parseFloat(intensityInput.value);
            commitCustomStructure();
          });

          const upButton = document.createElement('button');
          upButton.type = 'button';
          upButton.className = 'block-move';
          upButton.textContent = '↑';
          upButton.setAttribute('aria-label', `Move block ${index + 1} up`);
          upButton.disabled = index === 0;
          upButton.addEventListener('click', () => {
            if (index === 0) return;
            const blocks = settings.customStructure;
            [blocks[index - 1], blocks[index]] = [blocks[index], blocks[index - 1]];
            commitCustomStructure();
            renderStructureBlocks();
          });

          const downButton = document.createElement('button');
          downButton.type = 'button';
          downButton.className = 'block-move';
          downButton.textContent = '↓';
          downButton.setAttribute('aria-label', `Move block ${index + 1} down`);
          downButton.disabled = index === settings.customStructure.length - 1;
          downButton.addEventListener('click', () => {
            const blocks = settings.customStructure;
            if (index === blocks.length - 1) return;
            [blocks[index + 1], blocks[index]] = [blocks[index], blocks[index + 1]];
            commitCustomStructure();
            renderStructureBlocks();
          });

          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.className = 'block-remove';
          removeButton.textContent = 'Remove';
          removeButton.setAttribute('aria-label', `Remove block ${index + 1}`);
          removeButton.disabled = settings.customStructure.length <= 1;
          removeButton.addEventListener('click', () => {
            if (settings.customStructure.length <= 1) return;
            settings.customStructure.splice(index, 1);
            commitCustomStructure();
            renderStructureBlocks();
          });

          row.append(labelSelect, barsInput, intensityInput, upButton, downButton, removeButton);
          structureBlocks.append(row);
        });

        addBlockButton.disabled = settings.customStructure.length >= 8;
      }

      function commitCustomStructure() {
        engine.setParams({ customStructure: settings.customStructure });
        updateComplexityDisplay();
        persistSettings();
      }

      addBlockButton.addEventListener('click', () => {
        if (settings.customStructure.length >= 8) return;
        settings.customStructure.push({ label: 'A', bars: 8, intensity: 0.4 });
        commitCustomStructure();
        renderStructureBlocks();
      });

      function syncStructureUI() {
        structureSelect.value = settings.structure;
        customBuilder.hidden = settings.structure !== 'custom';
        renderStructureBlocks();
        updateComplexityDisplay();
      }

      structureSelect.addEventListener('change', () => {
        settings.structure = structureSelect.value;
        customBuilder.hidden = settings.structure !== 'custom';
        const partial = { structure: settings.structure };
        if (settings.structure === 'custom') partial.customStructure = settings.customStructure;
        engine.setParams(partial);
        updateComplexityDisplay();
        persistSettings();
      });

      // ---- arpeggiator sync (controls live in the Arp Edit panel) -------

      function syncArpUI() {
        updateComplexityDisplay();
        if (!arpUI) return; // arp editor closed — nothing rendered to sync
        for (const radio of arpUI.modeRadios) {
          radio.checked = radio.value === settings.arp.mode;
        }
        arpUI.manual.hidden = settings.arp.mode !== 'manual';
        arpUI.pattern.value = settings.arp.pattern;
        arpUI.rate.value = settings.arp.rate;
        arpUI.octaves.value = String(settings.arp.octaves);
        arpUI.octavesOut.textContent = String(settings.arp.octaves);
        arpUI.gate.value = String(settings.arp.gate);
        arpUI.gateOut.textContent = String(settings.arp.gate);
      }

      // ---- transport (Play / Finish / Stop now) -------------------------

      let finishing = false;
      let playNotice = '';

      // v26 pause. `engine.pause()` holds the piece where it stands and
      // `engine.resume()` picks it up at that exact position; without it the
      // page can only stop and start again, which loses the position and
      // rebuilds the piece. Both are real pauses to the listener, so the
      // button ships either way — what the probe decides is which one runs
      // (and what the button's own explanation says it will do).
      const exactPause = typeof engine.pause === 'function';
      let paused = false;

      function clearPaused() {
        paused = false;
      }

      function setTransportUI() {
        const running = !!engine.running;
        // A paused piece is still a piece: the main key stays on Finish and
        // Stop stays live, whether or not this engine keeps `running` true
        // while it holds.
        const active = running || paused;
        toggleButton.setAttribute('aria-pressed', String(active));
        if (finishing) {
          playLabel.textContent = 'Finishing…';
          toggleButton.disabled = true;
        } else {
          playLabel.textContent = active ? 'Finish' : 'Play';
          toggleButton.disabled = false;
        }
        // v15: ▶ before "Play"; the final-barline 𝄂 after "Finish".
        playGlyph.hidden = active || finishing;
        finishGlyph.hidden = !(active || finishing);
        // v15: Stop is a permanent button in the strip (was a "Stop now"
        // link that only appeared mid-playback), disabled when idle.
        stopNowButton.disabled = !active && !finishing;
        pauseButton.disabled = !active || finishing;
        pauseButton.setAttribute('aria-pressed', String(paused));
        pauseLabel.textContent = paused ? 'Resume' : 'Pause';
        pauseGlyph.hidden = paused;
        resumeGlyph.hidden = !paused;
        setCostPolling(running);
        setResolvedPolling(running);
        refreshRecordAvailability();
        if (!running) clearPlayhead();
        try {
          if ('mediaSession' in navigator) {
            navigator.mediaSession.playbackState = running && !paused ? 'playing' : 'paused';
          }
        } catch {}
        // Every transport change re-evaluates open editors' scopes
        // (OFFLINE static trace ↔ LIVE analyser trace).
        updateAllScopeModes();
      }

      // Lock-screen / hardware-key transport. Full lock-screen support also
      // needs the engine's media-element routing; the handlers are correct
      // without it.
      let mediaSessionReady = false;
      function setupMediaSession() {
        if (mediaSessionReady) return;
        try {
          if (!('mediaSession' in navigator) || typeof MediaMetadata !== 'function') return;
          navigator.mediaSession.metadata = new MediaMetadata({
            title: 'Ambi4 generator',
            artist: 'Ambi4',
          });
          navigator.mediaSession.setActionHandler('play', () => {
            // A lock-screen play on a HELD piece resumes it; otherwise it is
            // an ordinary start.
            if (paused) pauseButton.click();
            else if (!engine.running) engine.start().catch(() => {});
          });
          navigator.mediaSession.setActionHandler('pause', () => {
            // v26: the hardware pause key holds the piece where a real pause
            // exists, and stops it where one does not — which is what the
            // page's own Pause button does either way.
            if (engine.running && !paused) pauseButton.click();
            else engine.stop();
          });
          navigator.mediaSession.setActionHandler('stop', () => {
            clearPaused();
            engine.stop();
          });
          mediaSessionReady = true;
        } catch {}
      }

      async function finishOrStop() {
        // A held piece has no bar left to play its outro in — ending it here
        // is the honest reading of Finish while paused.
        if (paused) {
          clearPaused();
          engine.stop();
          setTransportUI();
          return;
        }
        // Feature-detect finish() — an older engine only has stop().
        if (typeof engine.finish !== 'function') {
          engine.stop();
          setTransportUI();
          return;
        }
        if (finishing) return;
        finishing = true;
        setTransportUI();
        try {
          await engine.finish();
        } catch {
          engine.stop();
        } finally {
          finishing = false;
          setTransportUI();
        }
      }

      /**
       * The Play path, shared with the fallback resume (which is a start by
       * definition — no engine.pause() means no position to pick up).
       */
      async function startPlayback() {
        if (alarmTarget !== null) cancelAlarm(); // starting now supersedes it
        clearPaused();
        toggleButton.disabled = true;
        playNotice = '';
        updateTimerUI();
        // start() can wedge (a context stuck pending resume never resolves);
        // don't leave the button dead — give the UI back after 3 s. A late
        // resolve still syncs the UI via the engine 'state' event.
        const outcome = await Promise.race([
          engine.start().then(
            () => 'started',
            () => 'failed'
          ),
          new Promise((resolve) => setTimeout(() => resolve('timeout'), 3000)),
        ]);
        toggleButton.disabled = false;
        if (outcome === 'started') {
          setupMediaSession();
        } else if (outcome === 'failed' || (outcome === 'timeout' && !engine.running)) {
          playNotice = 'Audio didn’t start — tap Play again.';
          updateTimerUI();
        }
        setTransportUI();
      }

      toggleButton.addEventListener('click', async () => {
        if (finishing) return;
        if (engine.running || paused) {
          await finishOrStop();
          return;
        }
        await startPlayback();
      });

      stopNowButton.addEventListener('click', () => {
        clearPaused();
        engine.stop();
        finishing = false;
        setTransportUI();
      });

      pauseButton.addEventListener('click', async () => {
        if (finishing) return;
        if (paused) {
          paused = false;
          if (exactPause) {
            setTransportUI();
            try {
              await engine.resume();
            } catch {}
            setTransportUI();
          } else {
            await startPlayback();
          }
          return;
        }
        if (!engine.running) return;
        paused = true;
        if (exactPause) {
          try {
            engine.pause();
          } catch {
            paused = false;
          }
        } else {
          // No exact pause: hold by stopping. The resume above starts a fresh
          // build rather than pretending to pick up where this left off.
          engine.stop();
        }
        setTransportUI();
      });

      describe(
        pauseButton,
        exactPause
          ? 'Hold the piece where it is. Resume picks it up at the same point.'
          : 'Hold the piece. This engine can’t resume mid-bar, so Resume starts it building again.'
      );

      // ---- v26 genre transport (picker, favourites, fast-forward) ---------
      // A genre is compiled into ordinary params and loaded like any other
      // snapshot, so everything stays editable afterwards and the piece is
      // shareable without the compiler being present to read it back. The
      // `genre` field is only a TAG saying where the params came from.

      /**
       * Compiled genre params as a settings object. Two carve-outs, both
       * deliberate: the tempo is rounded, because the page's tempo control is
       * whole bpm and a stored 71.903 would show as one, and the master volume
       * is the LISTENER's — a genre is a piece of music, not a listening
       * level, and having the volume jump on every pick is the kind of thing
       * that makes someone stop pressing the button.
       */
      function settingsFromGenre(compiled, slug) {
        const next = structuredClone(compiled);
        next.genre = typeof slug === 'string' ? slug : null;
        if (typeof next.bpm === 'number') next.bpm = Math.round(clamp(next.bpm, 20, 220));
        if (typeof settings?.volume === 'number') next.volume = settings.volume;
        // No genre declares a kit LANE LIST — the one in a compiled object is
        // only there because the compiler sanitises through the engine, and it
        // carries the engine's own low→high `order`, which this page renders
        // top-down (high first). Dropping it keeps the kit rows the right way
        // up; the genre's actual patterns are the sequencer steps, keyed by
        // lane id, and they are untouched.
        if (isPlainObject(next.tracks) && isPlainObject(next.tracks.percussion)) {
          delete next.tracks.percussion.lanes;
        }
        return next;
      }

      /** The genre the current params were compiled from, or null. */
      function currentGenre() {
        return typeof settings.genre === 'string'
          ? GENRE_BY_SLUG.get(settings.genre) || null
          : null;
      }

      /**
       * Compile `genre` at `seed` and load it as the live settings — the same
       * path a preset takes, so the dials, the editors and the persistence all
       * behave exactly as they do for any other load. setParams is bar-
       * quantised engine-side, so a pick while playing lands on the next bar
       * rather than cutting the current one off.
       */
      function applyGenre(genre, seed = randomSeed()) {
        const compiled = compileGenreParams(genre, seed);
        if (!compiled) return false;
        loadParamsSnapshot(settingsFromGenre(compiled, genre.slug));
        return true;
      }

      function clearGenreTag() {
        settings.genre = null;
        engine.setParams({ genre: null });
        persistSettings();
        syncGenreUI();
      }

      /** The genres the list offers: favourites only where the listener asked. */
      function listedGenres() {
        const favourites = genrePrefs.favourites;
        if (!genrePrefs.hideOthers || !favourites.length) return GENRES;
        const current = settings.genre;
        // The genre in play is always listed, favourite or not — a select
        // cannot show a value it has no option for.
        return GENRES.filter(
          (genre) => favourites.includes(genre.slug) || genre.slug === current
        );
      }

      /** Favourites grouped by mood, in MOODS order, empty groups dropped. */
      function favouriteMoodGroups() {
        const groups = [];
        for (const mood of [...MOODS, OTHER_MOOD]) {
          const members = GENRES.filter(
            (genre) => genrePrefs.favourites.includes(genre.slug) && moodOf(genre).id === mood.id
          );
          if (members.length) groups.push({ mood, members });
        }
        return groups;
      }

      /** A random genre from `pool`, never the one already playing. */
      function drawGenre(pool) {
        const choices = pool.filter((genre) => genre.slug !== settings.genre);
        const source = choices.length ? choices : pool;
        return source.length ? source[Math.floor(Math.random() * source.length)] : null;
      }

      function genreOption(value, label) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = label;
        return option;
      }

      function renderGenreSelect() {
        genreSelect.innerHTML = '';
        genreSelect.append(genreOption('', 'No genre'));

        const genres = document.createElement('optgroup');
        genres.label = 'Genres';
        for (const genre of listedGenres()) {
          genres.append(genreOption(`g:${genre.slug}`, genre.name));
        }
        genreSelect.append(genres);

        const groups = favouriteMoodGroups();
        if (groups.length) {
          const moods = document.createElement('optgroup');
          moods.label = 'Favourite moods';
          for (const { mood, members } of groups) {
            moods.append(genreOption(`mood:${mood.id}`, `${mood.label} (${members.length})`));
          }
          genreSelect.append(moods);
        }

        const extras = document.createElement('optgroup');
        extras.label = 'More';
        extras.append(genreOption('surprise', 'Surprise me'));
        extras.append(
          genreOption('favourites', genrePrefs.picked ? 'Edit favourites…' : 'Favourites…')
        );
        genreSelect.append(extras);

        genreSelect.value = settings.genre ? `g:${settings.genre}` : '';
      }

      function syncGenreUI() {
        // Nothing to sync where the row is hidden: a build with no compiler
        // has no genre to offer, and a list of entries that cannot act is
        // worse than no list.
        if (genreRow.hidden) return;
        renderGenreSelect();
      }

      genreSelect.addEventListener('change', () => {
        const value = genreSelect.value;
        if (value === 'favourites') {
          syncGenreUI(); // the entry is an action, not a selection
          openFavourites();
          return;
        }
        if (value === 'surprise') {
          const genre = drawGenre(listedGenres());
          if (!genre || !applyGenre(genre)) syncGenreUI();
          return;
        }
        if (value.startsWith('mood:')) {
          const group = favouriteMoodGroups().find(
            (entry) => entry.mood.id === value.slice('mood:'.length)
          );
          const genre = group ? drawGenre(group.members) : null;
          if (!genre || !applyGenre(genre)) syncGenreUI();
          return;
        }
        if (value.startsWith('g:')) {
          const genre = GENRE_BY_SLUG.get(value.slice(2));
          if (!genre || !applyGenre(genre)) syncGenreUI();
          return;
        }
        clearGenreTag();
      });

      describe(
        genreSelect,
        'Pick a genre and the whole setup is drawn from its rules — a different piece each time. ' +
          'Loading a factory preset clears the genre, because a preset is a fixed snapshot.'
      );

      // ---- favourites editor ----------------------------------------------

      const favouritesPopover = setupPopover(null, 'genre-favourites', {
        focusReturn: genreSelect,
      });
      const favouritesList = document.getElementById('genre-favourites-list');
      const hideOthersToggle = document.getElementById('genre-hide-others');

      function persistGenrePrefs() {
        persistKey('genre', genrePrefs);
      }

      function renderFavourites() {
        favouritesList.innerHTML = '';
        for (const mood of [...MOODS, OTHER_MOOD]) {
          const members = GENRES.filter((genre) => moodOf(genre).id === mood.id);
          if (!members.length) continue;
          const group = document.createElement('div');
          group.className = 'genre-fav-group';
          const heading = document.createElement('span');
          heading.className = 'panel-label';
          heading.textContent = mood.label;
          group.append(heading);
          for (const genre of members) {
            const row = document.createElement('label');
            row.className = 'genre-fav-item';
            const box = document.createElement('input');
            box.type = 'checkbox';
            box.value = genre.slug;
            box.checked = genrePrefs.favourites.includes(genre.slug);
            box.addEventListener('change', () => {
              const favourites = genrePrefs.favourites.filter((slug) => slug !== genre.slug);
              if (box.checked) favourites.push(genre.slug);
              genrePrefs.favourites = favourites;
              persistGenrePrefs();
              syncGenreUI();
            });
            const name = document.createElement('span');
            name.textContent = genre.name;
            row.append(box, name);
            group.append(row);
          }
          favouritesList.append(group);
        }
        hideOthersToggle.checked = genrePrefs.hideOthers;
      }

      hideOthersToggle.addEventListener('change', () => {
        genrePrefs.hideOthers = hideOthersToggle.checked;
        persistGenrePrefs();
        syncGenreUI();
      });

      document.getElementById('genre-favourites-done').addEventListener('click', () => {
        favouritesPopover.close();
      });

      function openFavourites() {
        // First use is what "picked" records: from here on the entry reads
        // "Edit favourites…" rather than offering the choice again.
        genrePrefs.picked = true;
        persistGenrePrefs();
        renderFavourites();
        favouritesPopover.open();
        syncGenreUI();
      }

      // ---- fast-forward -----------------------------------------------------
      // "Something else, now." With a genre in play that is the same genre
      // compiled at a fresh seed — a genuinely different setup (metre, mode,
      // tempo, chord loop, kit), still recognisably the genre. With no genre
      // there is nothing to recompile, so it re-rolls the material the current
      // params describe: the engine's randomise() drops every track's frozen
      // plan, hook and groove, and the next bar is built afresh.
      if (!genreCompiler && !engineCaps.randomise) UNAVAILABLE_TRANSPORT.add('fastforward');

      function reseedCurrentParams() {
        if (!engineCaps.randomise) return;
        try {
          engine.randomise();
        } catch {}
      }

      forwardButton.addEventListener('click', () => {
        const genre = currentGenre();
        if (genre && genreCompiler && applyGenre(genre)) return;
        reseedCurrentParams();
      });

      describe(
        forwardButton,
        'Skip to a completely different setup — the same genre rebuilt from scratch, ' +
          'or a fresh roll of the current one with no genre set.'
      );

      // The picker's own list is built by the first syncUIFromSettings below.
      genreRow.hidden = !genreCompiler || !GENRES.length;

      // ---- v15 record ------------------------------------------------------
      // MediaRecorder over the engine's own mixed output. The engine keeps
      // that MediaStream private (it lives on an internal <audio> element and
      // is not on the public API), so the page can only record once the
      // engine exposes it — every plausible accessor is probed here, and the
      // button ships disabled with an explanation when none answers. Summing
      // the per-track analysers would "work", but they tap pre-mix, pre-
      // effects and pre-master, so the file would not be what the listener
      // heard: a wrong recording is worse than none.
      function engineOutputStream() {
        for (const name of ['getOutputStream', 'getMediaStream', 'getStream']) {
          try {
            const stream = typeof engine[name] === 'function' ? engine[name]() : null;
            if (stream && typeof stream.getAudioTracks === 'function') return stream;
          } catch {}
        }
        try {
          const el = typeof engine.getOutputElement === 'function' ? engine.getOutputElement() : null;
          if (el && el.srcObject && typeof el.srcObject.getAudioTracks === 'function') {
            return el.srcObject;
          }
        } catch {}
        return null;
      }

      const canRecord = typeof window.MediaRecorder === 'function';
      let recorder = null;
      let recordChunks = [];
      let recordStartedAt = 0;
      let recordTimer = null;

      // v18 hardware-panel rule: the elapsed time swaps INSIDE a box that is
      // always there (see .record-status) — hiding the element would let the
      // status line re-flow every time recording starts and stops.
      function updateRecordStatus() {
        recordStatus.textContent = recorder
          ? `Recording ${formatCountdown(Date.now() - recordStartedAt)}`
          : '';
      }

      function stopRecording() {
        if (!recorder) return;
        try {
          recorder.stop();
        } catch {
          recorder = null;
        }
      }

      function startRecording() {
        const stream = engineOutputStream();
        if (!stream) return;
        try {
          recorder = new MediaRecorder(stream);
        } catch {
          recorder = null;
          return;
        }
        recordChunks = [];
        recorder.addEventListener('dataavailable', (event) => {
          if (event.data && event.data.size) recordChunks.push(event.data);
        });
        recorder.addEventListener('stop', () => {
          const blob = new Blob(recordChunks, { type: recorder.mimeType || 'audio/webm' });
          recordChunks = [];
          recorder = null;
          if (recordTimer !== null) {
            clearInterval(recordTimer);
            recordTimer = null;
          }
          recordButton.setAttribute('aria-pressed', 'false');
          recordButton.classList.remove('recording');
          updateRecordStatus();
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `ambi4-${new Date().toISOString().replace(/[:.]/g, '-')}.webm`;
          link.click();
          setTimeout(() => URL.revokeObjectURL(url), 10000);
        });
        recorder.start();
        recordStartedAt = Date.now();
        recordButton.setAttribute('aria-pressed', 'true');
        recordButton.classList.add('recording');
        recordTimer = setInterval(updateRecordStatus, 1000);
        updateRecordStatus();
      }

      function refreshRecordAvailability() {
        if (recorder) return;
        const ready = canRecord && !!engineOutputStream();
        recordButton.disabled = !ready;
      }

      recordButton.disabled = true;
      // Pre-launch the button is hidden outright (applyTransportVisibility), so
      // it gets no tooltip either — a description node beside a control nobody
      // can use still reaches a screen reader, which is the same tease. The
      // whole MediaRecorder path above stays live for the flag going false.
      if (!PAID_FEATURES_HIDDEN) {
        describe(
          recordButton,
          canRecord
            ? 'Records the mix to a .webm file on this device. Needs the engine to publish its output stream — arriving with the next engine update.'
            : 'This browser has no MediaRecorder, so recording is unavailable here.'
        );
        if (canRecord) {
          recordButton.addEventListener('click', () => {
            if (recorder) stopRecording();
            else startRecording();
          });
          refreshRecordAvailability();
        }
      }

      if (typeof engine.on === 'function') {
        engine.on('state', ({ running, paused: enginePaused }) => {
          if (!running) {
            finishing = false;
            // Where the engine really pauses, a stop is a stop and the hold is
            // over. In the stop-and-rebuild fallback the engine IS stopped
            // while held, so the page's own flag is the only record of it and
            // clearing it here would lose the Resume affordance.
            if (exactPause) clearPaused();
          } else if (typeof enginePaused === 'boolean') {
            paused = enginePaused;
          }
          if (running) {
            setupMediaSession();
            if (playNotice) {
              playNotice = '';
              updateTimerUI();
            }
          }
          setTransportUI();
        });
        engine.on('bar', ({ time, beatsPerBar }) => {
          schedulePlayhead(time, beatsPerBar);
        });
      }

      // ---- sleep timer + alarm (wall-clock re-check, drift-proof) -------

      const sleepIdle = document.getElementById('sleep-idle');
      const sleepActive = document.getElementById('sleep-active');
      const sleepCountdown = document.getElementById('sleep-countdown');
      const sleepCustom = document.getElementById('sleep-custom');
      const alarmIdle = document.getElementById('alarm-idle');
      const alarmActive = document.getElementById('alarm-active');
      const alarmCountdown = document.getElementById('alarm-countdown');
      const alarmTimeInput = document.getElementById('alarm-time');
      const sleepChip = document.getElementById('sleep-chip');
      const alarmChip = document.getElementById('alarm-chip');

      // ---- v6: sleep/alarm popovers (anchored, keyboard-operable dialogs) -
      // Esc and outside-click close; focus moves into the panel on open and
      // back to its button on close; Tab wraps within the panel while open.
      // v26: `toggleId` may be null for a dialog with no button of its own
      // (the genre favourites editor is opened from an entry in the genre
      // list), in which case `focusReturn` says where focus goes on close.
      function setupPopover(toggleId, popoverId, { focusReturn = null } = {}) {
        const toggle = toggleId ? document.getElementById(toggleId) : null;
        const popover = document.getElementById(popoverId);
        const anchor =
          (toggle && toggle.closest('.popover-anchor')) ||
          popover.closest('.popover-anchor') ||
          (toggle ? toggle.parentElement : popover.parentElement);

        function focusables() {
          return Array.from(
            popover.querySelectorAll(
              'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
            )
          ).filter((el) => !el.disabled && el.offsetParent !== null);
        }

        function open() {
          if (!popover.hidden) return;
          popover.hidden = false;
          toggle?.setAttribute('aria-expanded', 'true');
          const first = focusables()[0];
          try {
            (first || popover).focus();
          } catch {}
        }

        function close({ refocus = true } = {}) {
          if (popover.hidden) return;
          popover.hidden = true;
          toggle?.setAttribute('aria-expanded', 'false');
          if (refocus) (toggle || focusReturn)?.focus();
        }

        toggle?.addEventListener('click', () => {
          if (popover.hidden) open();
          else close();
        });

        popover.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            close();
            return;
          }
          if (event.key !== 'Tab') return;
          const els = focusables();
          if (els.length === 0) return;
          const first = els[0];
          const last = els[els.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        document.addEventListener('pointerdown', (event) => {
          if (popover.hidden) return;
          if (anchor.contains(event.target)) return;
          close({ refocus: false });
        });

        return { open, close };
      }

      setupPopover('sleep-toggle', 'sleep-popover');
      setupPopover('alarm-toggle', 'alarm-popover');

      let sleepTarget = null; // epoch ms
      let alarmTarget = null; // epoch ms
      let tickHandle = null;
      let alarmNotice = '';

      function formatCountdown(ms) {
        const total = Math.max(0, Math.round(ms / 1000));
        const h = Math.floor(total / 3600);
        const m = Math.floor((total % 3600) / 60);
        const s = total % 60;
        const pad = (n) => String(n).padStart(2, '0');
        return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
      }

      // Hiding the row that currently holds focus (e.g. clicking "Start" in
      // sleep-idle, which then hides sleep-idle for sleep-active) drops
      // focus to <body>, breaking Esc/Tab-wrap in the still-open popover.
      // If that happened, move focus into the newly-visible counterpart.
      function swapTimerRow(idleEl, activeEl, isActive) {
        const focusWasInside = idleEl.contains(document.activeElement) || activeEl.contains(document.activeElement);
        idleEl.hidden = isActive;
        activeEl.hidden = !isActive;
        if (focusWasInside && document.activeElement === document.body) {
          const visible = isActive ? activeEl : idleEl;
          const target = visible.querySelector(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          );
          if (target) {
            try {
              target.focus();
            } catch {}
          }
        }
      }

      function updateTimerUI() {
        const now = Date.now();
        swapTimerRow(sleepIdle, sleepActive, sleepTarget !== null);
        swapTimerRow(alarmIdle, alarmActive, alarmTarget !== null);
        sleepChip.hidden = sleepTarget === null;
        if (sleepTarget !== null) sleepChip.textContent = formatCountdown(sleepTarget - now);
        alarmChip.hidden = alarmTarget === null;
        if (alarmTarget !== null) alarmChip.textContent = formatCountdown(alarmTarget - now);
        const bits = [];
        if (sleepTarget !== null) {
          const text = `Fades out in ${formatCountdown(sleepTarget - now)}`;
          sleepCountdown.textContent = text;
          bits.push(`Sleep: ${formatCountdown(sleepTarget - now)}`);
        }
        if (alarmTarget !== null) {
          const at = new Date(alarmTarget);
          const pad = (n) => String(n).padStart(2, '0');
          const hhmm = `${pad(at.getHours())}:${pad(at.getMinutes())}`;
          alarmCountdown.textContent = `Starts at ${hhmm} (in ${formatCountdown(alarmTarget - now)})`;
          bits.push(`Alarm: ${hhmm}`);
        }
        if (alarmNotice) bits.push(alarmNotice);
        if (playNotice) bits.push(playNotice);
        transportStatus.textContent = bits.join(' · ');
      }

      // Re-check the wall clock every second rather than one long
      // setTimeout, so laptop sleep can't silently skip the target. The tick
      // runs in an inline-blob Web Worker: hidden silent tabs get main-thread
      // timers clamped to once a minute (Chrome intensive throttling), which
      // would fire the alarm up to a minute late — worker timers aren't
      // clamped that hard. Falls back to setInterval where workers fail.
      let tickWorkerURL = null;

      function ensureTicker() {
        if (sleepTarget === null && alarmTarget === null) return;
        if (tickHandle !== null) return;
        try {
          tickWorkerURL = URL.createObjectURL(
            new Blob(['setInterval(function () { postMessage(0); }, 1000);'], {
              type: 'text/javascript',
            })
          );
          const worker = new Worker(tickWorkerURL);
          worker.onmessage = () => tick();
          tickHandle = { worker };
        } catch {
          if (tickWorkerURL !== null) {
            URL.revokeObjectURL(tickWorkerURL);
            tickWorkerURL = null;
          }
          tickHandle = { interval: setInterval(tick, 1000) };
        }
      }

      function idleTickerIfDone() {
        if (tickHandle === null || sleepTarget !== null || alarmTarget !== null) return;
        if (tickHandle.worker) tickHandle.worker.terminate();
        if (tickHandle.interval) clearInterval(tickHandle.interval);
        tickHandle = null;
        if (tickWorkerURL !== null) {
          URL.revokeObjectURL(tickWorkerURL);
          tickWorkerURL = null;
        }
      }

      // Keep the screen on ONLY while an alarm is armed — a sleeping device
      // can't fire it. Ordinary playback takes no lock.
      let wakeLock = null;

      function acquireWakeLock() {
        if (alarmTarget === null || wakeLock !== null) return;
        if (!('wakeLock' in navigator) || typeof navigator.wakeLock.request !== 'function') return;
        navigator.wakeLock
          .request('screen')
          .then((lock) => {
            if (alarmTarget === null) {
              Promise.resolve(lock.release()).catch(() => {});
              return;
            }
            wakeLock = lock;
            // The OS can revoke it (tab hidden); we re-request on visible.
            lock.addEventListener('release', () => {
              if (wakeLock === lock) wakeLock = null;
            });
          })
          .catch(() => {});
      }

      function releaseWakeLock() {
        if (wakeLock === null) return;
        Promise.resolve(wakeLock.release()).catch(() => {});
        wakeLock = null;
      }

      function tick() {
        const now = Date.now();
        if (sleepTarget !== null && now >= sleepTarget) {
          sleepTarget = null;
          if (engine.running) finishOrStop();
        }
        if (alarmTarget !== null && now >= alarmTarget) {
          alarmTarget = null;
          releaseWakeLock();
          if (!engine.running) {
            clearPaused(); // an alarm start is a new piece, never a resume
            engine
              .start()
              .then(() => {
                alarmNotice = '';
                setTransportUI();
                updateTimerUI();
                setupMediaSession();
                // A start() in a throttled background tab can resolve with
                // the context still effectively suspended; poke it once it
                // should be audible. resume() is an idempotent context-poke.
                setTimeout(() => {
                  if (engine.running && typeof engine.resume === 'function') {
                    try {
                      // resume() can silently rebuildContext() (fresh
                      // analyser nodes) without a 'state' event — re-check
                      // any open scope's live analyser once it settles.
                      Promise.resolve(engine.resume()).then(updateAllScopeModes).catch(() => {});
                    } catch {}
                  }
                }, 1500);
              })
              .catch(() => {
                alarmNotice = 'Couldn’t start automatically — press Play.';
                updateTimerUI();
              });
          }
        }
        updateTimerUI();
        idleTickerIfDone();
      }

      function startSleepTimer(minutes) {
        if (!Number.isFinite(minutes) || minutes <= 0) return;
        sleepTarget = Date.now() + minutes * 60000;
        ensureTicker();
        updateTimerUI();
      }

      function cancelAlarm() {
        alarmTarget = null;
        alarmNotice = '';
        releaseWakeLock();
        updateTimerUI();
        idleTickerIfDone();
      }

      for (const button of document.querySelectorAll('.sleep-preset')) {
        button.addEventListener('click', () => {
          startSleepTimer(parseInt(button.dataset.minutes, 10));
        });
      }

      document.getElementById('sleep-start').addEventListener('click', () => {
        startSleepTimer(parseInt(sleepCustom.value, 10));
      });

      document.getElementById('sleep-cancel').addEventListener('click', () => {
        sleepTarget = null;
        updateTimerUI();
        idleTickerIfDone();
      });

      document.getElementById('alarm-set').addEventListener('click', () => {
        const value = alarmTimeInput.value;
        if (!value) return;
        // arm() from this user gesture so start() can later succeed outside
        // one. Feature-detect: an older engine has no arm() — we still set
        // the timer and let start() try.
        if (typeof engine.arm === 'function') engine.arm();
        const [h, m] = value.split(':').map(Number);
        const target = new Date();
        target.setHours(h, m, 0, 0);
        if (target.getTime() <= Date.now()) target.setDate(target.getDate() + 1);
        alarmTarget = target.getTime();
        alarmNotice = '';
        acquireWakeLock();
        ensureTicker();
        updateTimerUI();
      });

      document.getElementById('alarm-cancel').addEventListener('click', cancelAlarm);

      // ---- lifecycle recovery (throttled tabs, bfcache, iOS interrupts) --

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState !== 'visible') return;
        // Timers may have been clamped while hidden — re-check immediately.
        if (sleepTarget !== null || alarmTarget !== null) tick();
        if (alarmTarget !== null) acquireWakeLock();
        // v26: never while PAUSED — resume() is also the un-pause call, so an
        // unattended context-poke would restart a piece the listener held.
        if (engine.running && !paused) {
          // Recovers iOS 'interrupted' contexts once the engine ships
          // resume() — which can rebuildContext() (fresh analyser nodes)
          // without emitting a 'state' event, so re-evaluate any open
          // scope's live analyser once resume() settles.
          try {
            Promise.resolve(engine.resume?.()).then(updateAllScopeModes).catch(() => {});
          } catch {}
        }
      });

      window.addEventListener('focus', () => {
        if (engine.running && !paused) {
          try {
            Promise.resolve(engine.resume?.()).then(updateAllScopeModes).catch(() => {});
          } catch {}
        }
      });

      window.addEventListener('pagehide', () => {
        flushPersistSettings();
        try {
          engine.stop();
        } catch {}
      });

      window.addEventListener('pageshow', (event) => {
        // Restored from bfcache with the audio graph gone — show stopped UI.
        if (event.persisted) {
          clearPaused();
          finishing = false;
          setTransportUI();
        }
      });

      // ---- presets -------------------------------------------------------

      const presetName = document.getElementById('preset-name');
      const presetLoad = document.getElementById('preset-load');
      const presetSave = document.getElementById('preset-save');
      const presetDelete = document.getElementById('preset-delete');
      const presetSubmit = document.getElementById('preset-submit');
      const presetCopy = document.getElementById('preset-copy');
      const presetShare = document.getElementById('preset-share');
      const shareNote = document.getElementById('share-note');

      let presets = [];
      try {
        const stored = prefs.get('presets');
        if (Array.isArray(stored)) presets = stored;
      } catch {}

      function paramsSnapshot() {
        const s = structuredClone(settings);
        delete s.ui;
        return s;
      }

      /**
       * The same snapshot, minus the two REDUNDANT mirrors the normaliser
       * rebuilds on load: `tracks[t].sequencers` when it holds a single
       * sequencer (identical to `tracks[t].sequencer`), and the legacy
       * `arp.steps` boolean mask (re-derived from the arp sequencer). Both are
       * long arrays, and a share link is a URL somebody has to paste — this
       * roughly halves it, losslessly.
       */
      function shareSnapshot() {
        const s = paramsSnapshot();
        for (const id of SEQ_TRACKS) {
          const track = s.tracks[id];
          if (Array.isArray(track.sequencers) && track.sequencers.length <= 1) {
            delete track.sequencers;
          }
        }
        delete s.arp.steps;
        return s;
      }

      function persistPresets() {
        persistKey('presets', presets);
      }

      function refreshPresetSelect(selectedName) {
        presetLoad.innerHTML = '';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Load preset…';
        presetLoad.append(placeholder);
        presets.forEach((preset, index) => {
          const opt = document.createElement('option');
          opt.value = String(index);
          opt.textContent = preset.name;
          if (preset.name === selectedName) opt.selected = true;
          presetLoad.append(opt);
        });
      }

      presetSave.addEventListener('click', () => {
        const name = presetName.value.trim() || 'Untitled';
        const entry = { name, params: paramsSnapshot() };
        const existing = presets.findIndex((p) => p.name === name);
        if (existing >= 0) presets[existing] = entry;
        else presets.push(entry);
        persistPresets();
        refreshPresetSelect(name);
      });

      /**
       * Load a params snapshot (user preset or factory preset) as the live
       * settings. Same migration/normalisation order as the init load path: a
       * pre-v6 snapshot needs its arp mask mapped to a sequencer BEFORE the
       * deepMerge, and every lane needs padding to SEQ_SLOTS right after —
       * skipping either step leaves laneSteps()[i] undefined and throws
       * inside the un-awaited renderVoiceEditor triggered by syncUIFromSettings.
       */
      function loadParamsSnapshot(params) {
        const ui = settings.ui;
        const clone = structuredClone(params);
        migrateLegacyArpSteps(clone);
        settings = deepMerge(DEFAULTS, clone);
        normaliseV6Tracks(settings);
        settings.ui = ui;
        engine.setParams(engineParamsFrom(settings));
        syncUIFromSettings();
        applyDensityScale();
        persistSettings();
      }

      presetLoad.addEventListener('change', () => {
        const index = parseInt(presetLoad.value, 10);
        const preset = presets[index];
        if (!preset) return;
        loadParamsSnapshot(preset.params);
        presetName.value = preset.name;
      });

      // ---- blank slate (owner request, fromMartin 25) ---------------------
      // Everything silent and empty: every track off, every sequencer lane
      // cleared and pinned to Manual (so nothing auto-composes back in), no
      // arp steps, no genre, zero swing/complexity/repetition. What plays
      // after this is only what the user builds. Groundwork for the AI-free
      // pledge on listed presets/albums.
      function buildBlankParams() {
        const blank = structuredClone(DEFAULTS);
        blank.swing = 0;
        blank.complexity = 0;
        blank.repetition = 0;
        blank.arp.steps = new Array(16).fill(false);
        for (const track of Object.keys(blank.tracks)) {
          const t = blank.tracks[track];
          t.state = 'off';
          t.randomness = 0;
          if (t.sequencer) {
            t.sequencer.mode = 'manual';
            const clearLane = (lane) => lane.forEach((step) => { step.on = false; });
            if (Array.isArray(t.sequencer.steps)) clearLane(t.sequencer.steps);
            else Object.values(t.sequencer.steps).forEach(clearLane);
          }
        }
        return blank;
      }
      const blankSlate = document.getElementById('blank-slate');
      if (blankSlate) {
        describe(
          blankSlate,
          'Silence everything: all tracks off, all sequencers cleared and set to Manual, no genre. ' +
            'Whatever plays after this is entirely yours.'
        );
        blankSlate.addEventListener('click', () => {
          loadParamsSnapshot(buildBlankParams());
          clearGenreTag();
          presetName.value = '';
        });
      }

      // ---- factory preset gallery ----------------------------------------
      // A loaded factory preset is ordinary settings from that moment on:
      // every dial, track and editor behaves exactly as if the user had
      // dialled it in by hand.
      const factoryRow = document.getElementById('factory-preset-row');
      if (factoryRow) {
        for (const preset of FACTORY_PRESETS) {
          const card = document.createElement('button');
          card.type = 'button';
          card.className = 'secondary-button factory-preset';
          const name = document.createElement('span');
          name.className = 'factory-preset-name';
          name.textContent = preset.name;
          const blurb = document.createElement('span');
          blurb.className = 'factory-preset-blurb';
          blurb.textContent = preset.oneLiner ?? '';
          card.append(name, blurb);
          // v16: the rationale — WHY this preset is shaped the way it is — is
          // the card's tooltip rather than more text on the card itself.
          // v26: and the genre consequence, because a preset is a fixed
          // params snapshot — loading one leaves the params it carries, so
          // the genre tag it did not come from is cleared rather than left
          // claiming a piece it no longer describes.
          const rationale = [preset.rationale, 'Loading a preset clears the genre.']
            .filter(Boolean)
            .join(' ');
          describe(card, rationale);
          card.addEventListener('click', () => {
            loadParamsSnapshot(preset.params);
            presetName.value = preset.name;
          });
          factoryRow.append(card);
        }
      }

      // Advanced keeps its way in: the gallery itself lives on Simple now
      // (v16), so this jumps tabs and puts the focus on the first card.
      document.getElementById('factory-presets-jump')?.addEventListener('click', () => {
        activateTab('simple');
        const panel = document.getElementById('factory-presets');
        const first = factoryRow?.querySelector('.factory-preset');
        (first || panel)?.focus?.();
        panel?.scrollIntoView?.({ block: 'nearest' });
      });

      presetDelete.addEventListener('click', () => {
        const index = parseInt(presetLoad.value, 10);
        if (!Number.isFinite(index) || !presets[index]) return;
        presets.splice(index, 1);
        persistPresets();
        refreshPresetSelect();
      });

      function presetJSON() {
        const name = presetName.value.trim() || 'Untitled';
        return JSON.stringify({ name, params: paramsSnapshot() }, null, 2);
      }

      presetSubmit.addEventListener('click', () => {
        const name = presetName.value.trim() || 'Untitled';
        const url =
          `${CONTACT_URL}?subject=${encodeURIComponent(`Ambi4 preset: ${name}`)}` +
          `&message=${encodeURIComponent(presetJSON())}`;
        window.open(url, '_blank', 'noopener');
      });

      // Share: params only, in the fragment, straight to the clipboard. If the
      // clipboard is refused (Safari without a user-gesture-bound permission,
      // an insecure context), the link is printed in the note instead so it
      // can still be copied by hand — a failed copy must not lose the link.
      presetShare?.addEventListener('click', async () => {
        let url = '';
        try {
          url = `${SHARE_BASE}#${SHARE_PARAM}=${encodeShareParams(shareSnapshot())}`;
        } catch {
          presetShare.textContent = 'Share failed';
          setTimeout(() => {
            presetShare.textContent = 'Share';
          }, 2000);
          return;
        }
        try {
          await navigator.clipboard.writeText(url);
          presetShare.textContent = 'Link copied';
          if (shareNote) {
            shareNote.textContent = 'Share link copied — it carries your settings, never any code.';
            shareNote.hidden = false;
          }
        } catch {
          presetShare.textContent = 'Copy failed';
          if (shareNote) {
            shareNote.textContent = `Copy this link: ${url}`;
            shareNote.hidden = false;
          }
        }
        setTimeout(() => {
          presetShare.textContent = 'Share';
        }, 2000);
      });

      presetCopy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(presetJSON());
          presetCopy.textContent = 'Copied';
        } catch {
          presetCopy.textContent = 'Copy failed';
        }
        setTimeout(() => {
          presetCopy.textContent = 'Copy JSON';
        }, 2000);
      });

      // ---- v13 tutorial panel (right-docked, stepped, no library) ---------
      // Each step names the control it is talking about; opening a step
      // switches to the tab that control lives on and rings it. Open state
      // and position persist through prefs like every other UI preference.
      const TUTORIAL_STEPS = [
        {
          tab: 'simple',
          target: '#toggle-play',
          text: 'Press Play. Sound starts within a second or so; the button becomes Finish, which ends the piece musically instead of cutting it off. Stop is the hard stop.',
        },
        {
          tab: 'simple',
          target: '.sliders-module',
          text: 'These four dials are the whole instrument for most people: Tempo, Complexity, Randomness, Volume. Drag up and down, or click the number under a dial to type one. Double-click any dial to put it back to its default. The same four sit at the foot of the Advanced tab.',
        },
        {
          tab: 'simple',
          target: '#randomness-dial',
          text: 'Randomness at zero means hold: the generator keeps looping exactly what it is playing now. Turn it up and it re-rolls its material more and more often.',
        },
        {
          tab: 'advanced',
          target: '.track-rows',
          text: 'Six tracks, one line each. The coloured lamp beside the name cycles off, auto and on. The two dials are that track\'s level and its own randomness.',
        },
        {
          tab: 'advanced',
          target: '#voice-edit-toggle-percussion',
          text: 'Edit opens a track\'s panel: its step sequencer at the top, then the dials that build its sound. Drag sideways across sequencer cells to tie them into one long note.',
        },
        {
          tab: 'advanced',
          target: '#voice-edit-toggle-texture',
          text: 'Give Texture the Coloured noise or Grain cloud voice and its panel grows Spectral, Motion and Burst rows. Wind, rain and surf all live in there — you sculpt them with the dials rather than picking a sample. The Call voice does the same for birdsong: a pitch sweep, two formants and a cadence.',
        },
        {
          target: '#front-scope-module',
          text: 'The oscilloscope and the piano roll sit above the tabs, so they stay put while you work. In the legend on the right, a click hides one instrument\'s trace and a double-click solos it. The twisty at the top right folds the whole thing away.',
        },
        {
          tab: 'simple',
          target: '.factory-presets',
          text: 'Factory presets sit under the Simple dials: starting points, not presets in the locked sense — load one and change anything. Hover one to read why it is built the way it is. Each has its own web address, so you can link straight to it. Save your own under Your presets on Advanced.',
        },
        {
          tab: 'simple',
          target: '.processor-row',
          text: 'Processor decides how hard this runs. Auto watches the machine and backs off when it gets warm; Eco is the coolest setting.',
        },
        {
          target: null,
          text: 'Nothing here is AI and nothing is a recording. Every note is worked out as you listen by a few hundred lines of ordinary code running in this tab — the same rules you can see and change on the Advanced tab. Nothing you do is uploaded anywhere.',
        },
      ];

      const tutorialPanel = document.getElementById('tutorial-panel');
      const tutorialToggle = document.getElementById('tutorial-toggle');
      const tutorialText = document.getElementById('tutorial-step-text');
      const tutorialProgress = document.getElementById('tutorial-progress');
      let tutorialHighlighted = null;

      function highlightTutorialTarget(selector) {
        if (tutorialHighlighted) tutorialHighlighted.classList.remove('tutorial-highlight');
        tutorialHighlighted = selector ? document.querySelector(selector) : null;
        if (tutorialHighlighted) tutorialHighlighted.classList.add('tutorial-highlight');
      }

      function renderTutorial() {
        const index = clamp(settings.ui.tutorialStep | 0, 0, TUTORIAL_STEPS.length - 1);
        settings.ui.tutorialStep = index;
        const step = TUTORIAL_STEPS[index];
        tutorialText.textContent = step.text;
        tutorialProgress.textContent = `${index + 1} / ${TUTORIAL_STEPS.length}`;
        document.getElementById('tutorial-prev').disabled = index === 0;
        document.getElementById('tutorial-next').disabled = index === TUTORIAL_STEPS.length - 1;
        if (step.tab) activateTab(step.tab);
        highlightTutorialTarget(step.target);
      }

      function setTutorialOpen(open) {
        settings.ui.tutorialOpen = open;
        tutorialPanel.hidden = !open;
        tutorialToggle.setAttribute('aria-expanded', String(open));
        if (open) renderTutorial();
        else highlightTutorialTarget(null);
        persistSettings();
      }

      tutorialToggle.addEventListener('click', () => setTutorialOpen(tutorialPanel.hidden));
      document.getElementById('tutorial-close').addEventListener('click', () => {
        setTutorialOpen(false);
        tutorialToggle.focus();
      });
      document.getElementById('tutorial-prev').addEventListener('click', () => {
        settings.ui.tutorialStep -= 1;
        renderTutorial();
        persistSettings();
      });
      document.getElementById('tutorial-next').addEventListener('click', () => {
        settings.ui.tutorialStep += 1;
        renderTutorial();
        persistSettings();
      });
      tutorialPanel.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        setTutorialOpen(false);
        tutorialToggle.focus();
      });

      // ---- initial sync ---------------------------------------------------

      function syncUIFromSettings() {
        bpmInput.value = String(settings.bpm);
        bpmTypable?.refresh();
        speedDial?.set(speedTFromBpm(settings.bpm));
        repetitionDial?.set(settings.repetition);
        volumeDial?.set(settings.volume);
        randomnessDial?.set(fusedRandomnessValue());
        swingDial?.set(settings.swing);
        if (reverbTailDial && typeof settings.reverbTail === 'number') {
          reverbTailDial.set(settings.reverbTail);
          applyReverbTail();
        }
        rootSelect.value = settings.root;
        modeSelect.value = settings.mode;
        timeSignatureSelect.value = settings.timeSignature;
        syncGenreUI();
        if (engineCaps.harmonyRhythm) chordLengthSelect.value = String(settings.harmony.rhythm);
        syncStructureUI();
        syncArpUI();
        syncTrackStateUI();
        syncAllTrackExtras();
        for (const id of TRACK_IDS) {
          document.getElementById(`track-voice-${id}`).value = settings.tracks[id].voice;
          // A loaded preset brings its own patches, so the "Custom (…)"
          // display has to be recomputed, not just the stored selection.
          soundingVoice.delete(id);
          refreshVoiceSelect(id);
          levelControls.get(id)?.set(settings.tracks[id].level);
          const editor = document.getElementById(`voice-editor-${id}`);
          if (!editor.hidden) renderVoiceEditor(id);
        }
        updateComplexityDisplay();
        updateFrontScope();
      }

      syncUIFromSettings();
      refreshPresetSelect();
      engine.setParams(engineParamsFrom(settings));
      activateTab(settings.ui.activeTab, { persist: false });
      applyDensityScale();
      setTransportUI();
      updateTimerUI();
      if (settings.ui.tutorialOpen) setTutorialOpen(true);
      if (sharedParams && shareNote) {
        shareNote.textContent = routePreset
          ? `Loaded the ${routePreset.name} preset — Save to keep it.`
          : 'Loaded shared preset — Save to keep it.';
        shareNote.hidden = false;
      }
      if (routePreset) presetName.value = routePreset.name;

      app.hidden = false;
    }

    init().catch((err) => {
      // A dead init must never leave a blank page: show the fallback and say why.
      console.error('Ambi4 init failed:', err);
      const un = document.getElementById('generator-unavailable');
      if (un) {
        un.hidden = false;
        un.textContent = 'Something went wrong starting the generator (' + (err && err.message ? err.message : err) + '). Please hard-refresh; if it persists, this build is faulty.';
      }
    });
  </script>

  <!-- Global on purpose: most of these controls are built by the page
       script, so Astro's scoped-style attribute would never reach them.
       Class names are page-unique (checked against the other pages). -->
  <style is:global>
    /* `hidden` is only a UA `display: none` rule, so ANY author display
       declaration beats it — and nearly every panel/row/cell below sets one.
       That silently defeated `el.hidden = true` in the page script: the dial
       label rows buildSimpleDial hides stayed visible (every dial showed its
       name twice, once above and once under the knob), the switched-off Osc 2
       cell still drew, the empty cost meters still drew. One rule fixes the
       whole class of bug; `!important` is what makes it beat the class rules. */
    [hidden] {
      display: none !important;
    }

    #generator-app {
      max-width: 640px;

      /* -- v18 dial alignment contract --------------------------------------
         Every dial on the page is the same three stacked zones, in this order
         and at these fixed heights, so faces line up on one baseline in ANY
         row and the text under them can never push a face up or down:

           face  — the knob's own square SVG, exactly --knob-size tall
           label — its name (knob.js's .knob-label)
           value — its read-out (.knob-value), tall enough for the wave glyph

         The zones are fixed HEIGHTS with visible overflow rather than min-
         heights: a long read-out ("2.0 kHz–8.0 kHz") bleeds into the gutter
         instead of wrapping the box taller and dragging its neighbours out of
         line. Nothing is reserved ABOVE a face — the end-marks and the centre
         mark hang below the read-out (.dial-ends / .dial-mid), which is what
         let the old `.simple-dial { padding-top }` compensation hack go. */
      --dial-label-h: 15px;
      --dial-value-h: 20px;
      --dial-ends-h: 15px;
    }

    .knob > svg {
      height: var(--knob-size, 72px);
    }

    .knob-label {
      height: var(--dial-label-h);
      line-height: var(--dial-label-h);
      white-space: nowrap;
      overflow: visible;
    }

    .knob-value {
      display: block;
      height: var(--dial-value-h);
      line-height: var(--dial-value-h);
      white-space: nowrap;
      overflow: visible;
    }

    /* -- 70s module furniture (theme owns the .module-panel appearance /
          tokens) -- */

    .module-panel {
      position: relative;
    }

    .transport-module,
    .sliders-module {
      margin-bottom: 20px;
    }

    .transport-module .transport-row {
      margin-bottom: 0;
    }

    /* Pushes the right-hand group (PROCESSOR + the `?`) to the far end, and
       keeps doing so if the Processor title is removed with its dial. */
    .transport-label {
      display: block;
      margin-right: auto;
    }

    /* -- v15 transport strip: [▶ Play/Finish] [■ Stop] [● Record] ... and,
          far right, the sleep + schedule icons stacked at half height -- */

    /* v18: TRANSPORT and PROCESSOR are one header row — both engraved titles
       on a single baseline, the panel's `?` last. The Processor title sits at
       the right end, over the dial it names. */
    .transport-head {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 8px;
    }

    /* ONE transport row: Play/Stop/Record, the sleep+schedule icons and the
       Processor dial all live on the same line. `wrap` is the narrow-screen
       escape hatch — at ~360 px the dial drops to a second line rather than
       squashing the buttons. `center` (not `stretch`) keeps the buttons at
       their own height now that the tallest item in the row is a dial. Every
       item in it is a FIXED size: the processor's status text (whose length
       changes as the tier and the note count change) lives in the row BELOW,
       where it cannot resize the transport buttons. */
    .transport-main {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 8px;
    }

    .transport-buttons {
      display: flex;
      flex: 1 1 auto;
      flex-wrap: wrap;
      align-items: stretch;
      gap: 8px;
    }

    /* v18 hardware-panel rule: the key is sized to its WIDEST caption
       ("Finishing…"), so Play → Finish → Finishing… only ever swaps text
       inside a box that never changes size. Reserving it in `ch` (the label
       span, not the button) keeps the reservation honest when the font
       stack, the letter-spacing or the caption changes. */
    .play-toggle {
      display: inline-flex;
      flex: 2 1 200px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 56px;
      padding: 16px;
      font-size: 18px;
      font-weight: 700;
      color: var(--bg);
      background: var(--link);
      border: none;
      border-radius: var(--radius);
      cursor: pointer;
    }

    .play-toggle-label {
      display: inline-block;
      min-width: 11ch;
      text-align: center;
    }

    /* Both glyphs are the same 18px box, so swapping ▶ for 𝄂 moves nothing. */
    .transport-glyph {
      display: inline-flex;
      align-items: center;
    }

    /* `hidden` must beat the display rule above, or both glyphs show at once
       (shipped bug: Play carried the barline icon too). */
    .transport-glyph[hidden] {
      display: none !important;
    }

    .transport-button {
      display: inline-flex;
      flex: 0 0 56px;
      width: 56px;
      height: 56px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 6px 4px;
      font-size: 10px;
      font-weight: 600;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .transport-button:focus-visible,
    .round-button:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .transport-button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    /* -- v26 genre row: directly under the Play key, full width -- */

    /* The picker is the second control on the panel, so it gets the whole
       line rather than competing for space in the button strip. 44px is the
       touch-target floor; the select carries its own font-size 16 so iOS
       does not zoom the page when it opens. */
    .genre-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .genre-select {
      flex: 1 1 auto;
      min-height: 44px;
      padding: 8px 10px;
      font-size: 16px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .genre-select:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    /* The favourites editor hangs off the row itself, not off a button of its
       own — the genre list is where it is opened from. */
    .genre-favourites {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: min(320px, 88vw);
    }

    .genre-fav-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: 46vh;
      overflow-y: auto;
    }

    .genre-fav-group {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .genre-fav-item,
    .genre-fav-hide {
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: 32px;
      font-size: 14px;
      cursor: pointer;
    }

    .genre-fav-hide {
      min-height: 44px;
      border-top: 1px solid var(--border);
    }

    .genre-fav-actions {
      display: flex;
      justify-content: flex-end;
    }

    .record-button .record-dot {
      color: #c8302f;
    }

    .record-button:disabled .record-dot {
      color: var(--secondary);
    }

    .record-button.recording {
      border-color: #c8302f;
      box-shadow: inset 0 0 0 1px #c8302f;
    }

    /* Reserved box: present (and empty) while idle, so "Recording 0:07"
       appearing never re-flows the line it shares. */
    .record-status {
      flex: 0 0 auto;
      min-width: 15ch;
      text-align: right;
      color: #c8302f;
      font-size: 14px;
      font-weight: 600;
    }

    /* Small round utility button: the "?" tour opener, the ⓘ info buttons
       and the per-track dice re-roll. */
    .round-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      font-size: 14px;
      font-weight: 700;
      font-family: var(--label-font, inherit);
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 50%;
      cursor: pointer;
    }

    .round-button:hover {
      border-color: var(--accent-warm, var(--link));
    }

    .play-toggle:hover {
      background: var(--link-hover);
    }

    .play-toggle:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 3px;
    }

    .play-toggle[aria-pressed='true'] {
      background: var(--secondary);
    }

    .play-toggle:disabled {
      opacity: 0.7;
      cursor: wait;
    }

    /* The status line under the transport row. Two visual lines in one box:
       transport status and record elapsed on the first, the processor's own
       status on a full-width second line. Both lines reserve their height
       whether or not they have anything to say, so text arriving or leaving
       can never move a control above them. */
    .transport-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 4px 12px;
      min-height: 22px;
      margin-bottom: 12px;
    }

    .timer-status {
      color: var(--secondary);
      font-size: 14px;
    }

    /* Takes the slack on the status line so the record box beside it keeps
       its reserved width. It is the one element allowed to grow to a second
       line — a warning ("Audio didn't start…") must not be truncated — and it
       sits below every control in the panel, so nothing above it can move. */
    .transport-row .timer-status {
      flex: 1 1 auto;
      min-width: 0;
    }

    .link-button {
      padding: 0;
      font-size: 14px;
      color: var(--link);
      background: none;
      border: none;
      text-decoration: underline;
      cursor: pointer;
    }

    .link-button:hover {
      color: var(--link-hover);
    }

    .link-button:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    /* -- transport icon buttons + sleep/alarm popovers (v6) -- */

    /* Far right of the strip: the two popover icons stacked, each about half
       the Play button's height. Width is generous so the pair still offers
       comfortable targets at half height. */
    .transport-icons {
      display: flex;
      flex: 0 0 auto;
      flex-direction: column;
      gap: 4px;
    }

    .transport-icons {
      flex-direction: row;
    }

    .transport-icons .icon-button {
      width: 56px;
      height: 56px;
    }

    .popover-anchor {
      position: relative;
    }

    .icon-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      min-width: 44px;
      padding: 0;
      color: var(--text);
      background: linear-gradient(rgba(255, 255, 255, 0.06), rgba(0, 0, 0, 0.03)), var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .icon-button:hover {
      border-color: var(--accent-warm, var(--link));
    }

    .icon-button[aria-expanded='true'] {
      color: var(--bg);
      background: var(--link);
      border-color: var(--link);
    }

    .icon-button:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .countdown-chip {
      position: absolute;
      top: -6px;
      right: -6px;
      padding: 2px 6px;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.4;
      color: var(--on-amber, var(--bg));
      background: var(--accent-warm, var(--link));
      border-radius: 999px;
      white-space: nowrap;
      pointer-events: none;
    }

    .popover {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      z-index: 20;
      width: max-content;
      min-width: 240px;
      max-width: calc(100vw - 32px);
    }

    .popover-title {
      display: block;
      margin-bottom: 10px;
    }

    .popover input[type='number'],
    .popover input[type='time'] {
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .popover input[type='number'] {
      width: 72px;
    }

    #track-visualiser {
      display: block;
      width: 100%;
      height: 200px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg);
    }

    /* v26: the piano roll's own stage, so it has something to hang a
       fullscreen button off and something to hand to requestFullscreen.
       visualiser.js inserts its lamp host between this and the canvas. */
    .roll-stage {
      position: relative;
      margin-bottom: 20px;
    }

    .roll-overlay {
      position: absolute;
      top: 6px;
      right: 8px;
      display: flex;
      gap: 6px;
    }

    .stage-fs-button {
      background: none;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--secondary);
      padding: 0 7px;
      min-height: 24px;
      line-height: 1;
      font-size: 13px;
      cursor: pointer;
    }

    .stage-fs-button:hover {
      color: var(--text);
      border-color: var(--link);
    }

    /* The fullscreen host. Off-screen duty only: everything inside it is
       borrowed from the page and put back on exit. */
    .fullscreen-stage {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 100%;
      height: 100%;
      padding: 8px;
      background: var(--bg);
    }

    .fullscreen-stage[hidden] {
      display: none;
    }

    .fullscreen-bar {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      flex: none;
    }

    .fullscreen-slots {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1 1 auto;
      min-height: 0;
    }

    /* Each borrowed module takes an equal share of the height, and its canvas
       fills that share — the modules redraw off their own ResizeObserver. */
    .fullscreen-slots > * {
      flex: 1 1 0;
      min-height: 0;
      margin-bottom: 0;
    }

    /* Down through whatever nesting each module keeps (the scope's collapse
       body; the lamp host visualiser.js wraps its canvas in) to the canvas. */
    .fullscreen-slots .scope-stage,
    .fullscreen-slots .scope-body,
    .fullscreen-slots .front-scope,
    .fullscreen-slots .roll-stage > :not(.roll-overlay),
    .fullscreen-slots #track-visualiser {
      height: 100%;
    }

    /* -- tabs -- */

    .tabs {
      display: flex;
      gap: 4px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .tabs [role='tab'] {
      padding: 10px 18px;
      font-size: 16px;
      font-weight: 600;
      color: var(--secondary);
      background: none;
      border: none;
      border-bottom: 3px solid transparent;
      cursor: pointer;
    }

    .tabs [role='tab'][aria-selected='true'] {
      color: var(--link);
      border-bottom-color: var(--link);
    }

    .tabs [role='tab']:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: -3px;
    }

    [role='tabpanel']:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 4px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .control {
      margin-bottom: 20px;
    }

    .control-label-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 6px;
    }

    .control label {
      font-weight: 700;
    }

    .value-readout {
      color: var(--secondary);
      font-size: 14px;
    }

    /* v14 single labelling: knob.js draws each dial's name under its face, so
       the markup label row is hidden once a knob builds (the .dial-knob
       class) and the end-marks sit at the tick extremes instead of a second
       label row above. The slider fallback (.dial-fallback) keeps the label
       row and lays the end-marks out as an ordinary row beneath. */
    .dial-ends {
      display: flex;
      justify-content: space-between;
      color: var(--secondary);
      font-size: 11px;
      font-family: var(--label-font, inherit);
      letter-spacing: 0.04em;
      pointer-events: none;
    }

    /* v18: the scale marks are ONE caption line under the whole dial — low
       left, centre mark in the middle, high right — clear of the name and the
       read-out above them. The line is absolutely positioned (so an unequal
       mark set can't shift a face) and the space it needs is reserved in flow
       by the slot's own padding-bottom, so it never overlaps what follows. */
    .dial-knob .dial-slot {
      position: relative;
      /* the caption line's own height plus the 4px it hangs below the read-out */
      padding-bottom: calc(var(--dial-ends-h) + 4px);
    }

    .dial-knob .dial-ends {
      position: absolute;
      left: 50%;
      top: calc(
        var(--knob-size, 96px) + var(--dial-label-h) + var(--dial-value-h) + 4px
      );
      width: calc(var(--knob-size, 96px) + 52px);
      height: var(--dial-ends-h);
      transform: translateX(-50%);
    }

    .dial-knob .dial-mid {
      position: absolute;
      left: 50%;
      top: calc(
        var(--knob-size, 96px) + var(--dial-label-h) + var(--dial-value-h) + 4px
      );
      height: var(--dial-ends-h);
      transform: translateX(-50%);
      color: var(--secondary);
      font-size: 11px;
      font-family: var(--label-font, inherit);
      letter-spacing: 0.04em;
      pointer-events: none;
    }

    .dial-fallback .dial-slot {
      flex-wrap: wrap;
    }

    .dial-fallback .dial-mid {
      width: 100%;
      text-align: center;
      color: var(--secondary);
      font-size: 11px;
    }

    .dial-fallback .dial-ends {
      width: 100%;
      margin-top: 2px;
    }

    /* v12: Simple tab — five music-box dials in a row (knob.js path), each
       a generously-sized knob per the theme's --knob-size token; the
       slider fallback (knob.js absent) keeps the pre-v12 vertical stack
       look via the shared .control/input[type=range] rules above. */
    .sliders-module {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-around;
      align-items: flex-start;
      gap: 24px 16px;
    }

    .simple-dial {
      flex: 1 1 130px;
      max-width: 220px;
      margin-bottom: 0;
      --knob-size: 96px;
    }

    .dial-slot {
      display: flex;
      justify-content: center;
    }

    /* -- processor dial (transport panel) -- */

    /* v18: the title is up in the panel header (one baseline with TRANSPORT)
       and the status text is down in the transport status row, so what sits
       in the button row is the dial and nothing else — a fixed-size item. */
    .processor-row {
      display: flex;
      flex: 0 0 auto;
      justify-content: center;
      --knob-size: 56px;
    }

    .processor-label {
      display: block;
    }

    /* Its own full-width line at the foot of the transport panel, right
       aligned under the dial's column, with its height always reserved: the
       tier/notes/fps text changes length constantly and must never be able to
       resize or re-flow the button row above it. */
    .processor-readout {
      flex: 1 0 100%;
      min-height: 14px;
      font-size: 10px;
      line-height: 1.3;
      text-align: right;
      color: var(--secondary);
    }

    /* The page has already named this dial above it, so knob.js's own caption
       is suppressed — the same string stays on the knob as its aria-label
       (knob.js sets role="slider" + aria-label from `label`), so nothing is
       lost to assistive tech and the name is drawn exactly once. */
    .dial-label-external .knob-label {
      display: none;
    }

    /* -- v13 tooltips + ⓘ info boxes -- */

    .ui-tooltip {
      position: absolute;
      z-index: 40;
      max-width: 260px;
      padding: 6px 9px;
      font-size: 13px;
      line-height: 1.4;
      color: var(--text);
      background: var(--panel, var(--bg));
      border: 1px solid var(--panel-edge, var(--border));
      border-radius: var(--radius);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      pointer-events: none;
    }

    .info-anchor {
      position: relative;
      display: inline-flex;
    }

    .info-button {
      width: 22px;
      height: 22px;
      font-size: 12px;
      font-style: italic;
    }

    .info-box {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 30;
      width: max-content;
      max-width: min(360px, calc(100vw - 32px));
      padding: 10px 12px;
      font-size: 13px;
      line-height: 1.5;
      color: var(--text);
      background: var(--panel, var(--bg));
      border: 1px solid var(--panel-edge, var(--border));
      border-radius: var(--radius);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    }

    /* -- v13 click-to-type readouts -- */

    .typable {
      padding: 1px 4px;
      font: inherit;
      color: inherit;
      background: none;
      border: 1px dashed transparent;
      border-radius: 4px;
      cursor: text;
    }

    .typable:hover,
    .typable:focus-visible {
      border-color: var(--border);
    }

    .typable-input {
      width: 5em;
      padding: 1px 4px;
      font: inherit;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--link);
      border-radius: 4px;
    }

    .control input[type='range'] {
      width: 100%;
    }

    .control select {
      width: 100%;
      padding: 8px;
      font-size: 16px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .control input:focus-visible,
    .control select:focus-visible,
    .presets-group input:focus-visible,
    .presets-group select:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .hint {
      margin-top: 6px;
      color: var(--secondary);
      font-size: 14px;
    }

    /* -- presets fieldset (the old sleep/alarm fieldset was replaced by the
          transport popovers below) -- */

    .presets-group {
      margin-bottom: 20px;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .presets-group legend {
      padding: 0 6px;
      font-weight: 700;
    }

    .timer-row,
    .preset-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .timer-custom {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .presets-group input[type='text'] {
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      flex: 1 1 160px;
    }

    .presets-group select {
      flex: 1 1 160px;
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* -- segmented control (3-state track state / 2-state arp mode) -- */

    .segmented {
      display: inline-flex;
      flex-wrap: wrap;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .segmented input[type='radio'] {
      position: absolute;
      opacity: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }

    .segmented label {
      padding: 6px 12px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      color: var(--text);
      border-right: 1px solid var(--border);
    }

    .segmented label:last-of-type {
      border-right: none;
    }

    .segmented input[type='radio']:checked + label {
      background: var(--link);
      color: var(--bg);
    }

    .segmented input[type='radio']:focus-visible + label {
      outline: 3px solid var(--link);
      outline-offset: -3px;
    }

    /* -- tracks section -- */

    .tracks-section {
      margin-bottom: 24px;
    }

    .tracks-heading {
      font-size: 16px;
      margin-top: 0;
      margin-bottom: 12px;
    }

    .track-rows {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* v18: every dial that belongs to a track — the row's Level/Randomness
       and everything in its editor — wears that track's colour on its ring,
       so which track you are adjusting is glanceable from the dial alone.
       Only the ring is re-tinted: the pointer keeps the brass token, because
       the track colours are contrast-checked against --panel/--bg (where the
       ring is drawn) and NOT against the dark --knob-face the pointer crosses.
       Dials that belong to no track (the four main dials, Processor) are left
       on the theme's brass default. */
    .track-row,
    .voice-editor {
      --knob-ring: var(--track-accent, var(--knob-ring-default));
    }

    /* v14: ONE line per track — lamp+name, voice, Level, Randomness, Edit —
       with the track's own colour as a left accent bar. */
    .track-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      padding-left: 8px;
      border-left: 3px solid var(--track-accent, var(--border));
    }

    /* v9 cost meter: a thin bar showing how many notes this track has
       sounding, tinted with the track colour. Populated at 1 Hz while the
       engine runs, hidden when there are no stats to show. */
    .cost-meter {
      display: block;
      width: 100%;
      height: 3px;
      margin-top: 2px;
      background: var(--panel-inset, var(--border));
      border-radius: 2px;
      overflow: hidden;
    }

    .cost-meter-fill {
      display: block;
      width: 0;
      height: 100%;
      background: var(--track-accent, var(--link));
      transition: width 0.4s linear;
    }

    /* Status strip under the row's controls: what the engine is actually
       resolving to right now, plus the cost meter. Its height covers both
       (14px read-out + a 5px meter) at all times — the meter only exists
       while the engine reports stats, and a row that grew when Play was
       pressed would move every row below it. */
    .track-foot {
      display: block;
      flex-basis: 100%;
      min-height: 19px;
    }

    .resolved-readout {
      display: block;
      color: var(--secondary);
      font-size: 12px;
      font-family: var(--label-font, inherit);
      letter-spacing: 0.04em;
      min-height: 14px;
    }

    .track-name {
      width: 84px;
      flex-shrink: 0;
      font-weight: 600;
    }

    /* v12: track-name is now a lamp button — off/auto/on lamp dot (black/
       grey/white) + the track name, cycling state on click, native <button>
       so it's keyboard-operable for free. */
    .track-lamp {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      width: 84px;
      border: none;
      background: none;
      padding: 3px 4px;
      margin: -3px -4px;
      border-radius: var(--radius);
      cursor: pointer;
      font: inherit;
      color: inherit;
      text-align: left;
    }

    .track-lamp:hover {
      background: var(--panel-inset, rgba(255, 255, 255, 0.08));
    }

    .track-lamp:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    /* The lamp dot is the shared .track-chip, so it carries the track's own
       identity colour; state modulates how lit it reads. */
    .track-row[data-track-state='off'] .lamp-dot {
      background: var(--knob-face);
      opacity: 0.5;
    }

    .track-row[data-track-state='auto'] .lamp-dot {
      opacity: 0.65;
    }

    .track-row[data-track-state='on'] .lamp-dot {
      opacity: 1;
      box-shadow: 0 0 5px var(--track-accent, var(--knob-pointer));
    }

    /* v8: melody/bass ship state 'off' — a textual cue (not colour alone)
       so a silent track is obviously wake-able, not just quietly missing. */
    .track-row[data-track-state='off'] .track-name {
      color: var(--secondary);
      font-weight: 400;
      font-style: italic;
    }

    .track-row[data-track-state='off'] .track-name::after {
      content: ' — off';
    }

    .track-voice {
      flex: 1 1 140px;
      min-width: 120px;
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* v8: per-track Level knob/slider, in the main tracks-panel row */
    .track-level {
      display: flex;
      align-items: center;
    }

    .level-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .level-slider {
      display: inline-flex;
      align-items: center;
    }

    .level-slider input[type='range'] {
      width: 120px;
    }

    .voice-edit-toggle[aria-expanded='true'] {
      background: var(--link);
      color: var(--bg);
      border-color: var(--link);
    }

    /* -- track-extras: Random / Hold / Randomness cluster (main row AND the
          voice editor header mirror share this class) -- */

    .track-extras {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }

    .rand-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .rand-slider {
      display: inline-flex;
      align-items: center;
    }

    .rand-slider input[type='range'] {
      width: 120px;
    }

    /* -- voice editor module (faceplate look comes from .module-panel) -- */

    .voice-editor {
      margin-top: 10px;
    }

    .scope-head {
      position: relative;
      max-width: 420px;
      margin: 0 auto 16px;
    }

    .patch-scope {
      display: block;
      width: 100%;
      height: 130px;
      background: var(--scope-bg, #10140f);
      border: 1px solid var(--panel-edge, var(--border));
      border-radius: var(--radius);
    }

    .scope-mode {
      position: absolute;
      top: 8px;
      right: 10px;
      font-family: var(--label-font, inherit);
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--secondary);
    }

    .scope-mode-live {
      color: var(--accent-warm, #d98324);
    }

    /* -- v13/v18/v26 front-page oscilloscope (above the tabs, full width) --
          No title and, since v26, no faceplate: the display is bare, exactly
          like the piano roll below it, and every piece of chrome (note,
          legend, options, fullscreen, twisty) floats over the display's top
          edge. Collapsed, the overlay returns to the flow — otherwise the
          twisty would vanish with the canvas it was sitting on. */

    .scope-module {
      margin-bottom: 20px;
    }

    .scope-stage {
      position: relative;
    }

    .scope-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      display: flex;
      align-items: flex-start;
      gap: 8px;
      padding: 6px 8px;
      /* A scrim, so a trace running along the top edge can't make the legend
         unreadable; it fades out well above the middle of the display. */
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--scope-bg, #10140f) 85%, transparent),
        transparent
      );
      border-radius: var(--radius) var(--radius) 0 0;
      pointer-events: none;
    }

    .scope-overlay > * {
      pointer-events: auto;
    }

    .scope-module.scope-collapsed .scope-overlay {
      position: static;
      padding: 0;
      background: none;
    }

    /* Collapsed there is no trace to key, so the legend goes with the display
       (it stays in the DOM — it is still the selection state). */
    .scope-module.scope-collapsed .scope-legend {
      display: none;
    }

    .scope-controls {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-left: auto;
      flex: none;
    }

    .scope-option {
      background: none;
      border: 1px solid var(--border);
      border-radius: 999px;
      color: var(--secondary);
      padding: 2px 9px;
      font-family: var(--label-font, inherit);
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      min-height: 24px;
    }

    .scope-option[aria-pressed='true'] {
      border-color: var(--link);
      color: var(--text);
    }

    .scope-option-total[aria-pressed='true'] {
      border-color: #fff;
      color: #fff;
    }

    .scope-option:focus-visible,
    .stage-fs-button:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 2px;
    }

    .scope-note {
      flex: 0 1 auto;
      font-size: 11px;
    }

    .scope-collapse {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: none;
      border: 0;
      padding: 0;
      cursor: pointer;
      color: inherit;
      font: inherit;
    }

    .scope-collapse-word {
      font-family: var(--label-font, inherit);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text);
    }

    .scope-twisty::before {
      content: '▾';
      color: var(--secondary);
    }

    .scope-collapse[aria-expanded='false'] .scope-twisty::before {
      content: '▸';
    }

    .scope-collapse:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 3px;
    }

    /* v26: same treatment as #track-visualiser — a bare display, one hairline
       edge and nothing else around it. */
    .front-scope {
      display: block;
      width: 100%;
      height: 160px;
      background: var(--scope-bg, #10140f);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* v18 legend: one key per track in that track's own colour. Single click
       toggles a trace, double click solos. Styled here for BOTH legends —
       scope.js's DOM legend and the page's own fallback build the same three
       class names. v26: it rides the display's top edge instead of sitting
       under it, so it right-aligns into the space the note leaves. */
    .scope-legend {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      align-content: flex-start;
      gap: 4px 6px;
      flex: 1 1 auto;
      min-width: 0;
    }

    .scope-legend-track {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid transparent;
      border-radius: 999px;
      background: none;
      color: var(--secondary);
      padding: 3px 8px;
      font-family: var(--label-font, inherit);
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      min-height: 26px;
    }

    .scope-legend-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--track-accent, var(--scope-trace));
      opacity: 0.35;
      flex: none;
    }

    .scope-legend-track[aria-pressed='true'] {
      border-color: var(--track-accent, var(--border));
      color: var(--text);
    }

    .scope-legend-track[aria-pressed='true'] .scope-legend-dot {
      opacity: 1;
    }

    .scope-legend-track:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 2px;
    }

    /* -- share links -- */

    .share-note {
      overflow-wrap: anywhere;
    }

    /* -- the Advanced tab's copy of the four main dials -- */

    /* v18: START, not END — every dial in the row hangs from one baseline at
       the top, and the reserved label/read-out zones below keep the bottoms
       level too. Bottom-aligning made any dial with an extra line of text
       (a ghost read-out, a wrapped name) ride up above its neighbours. */
    .advanced-dial-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 12px;
      align-items: start;
    }

    .knob-sections {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 14px;
    }

    .knob-section > .panel-label {
      display: block;
      margin-bottom: 8px;
    }

    /* Knobs wrap into a grid; still usable at 360 px viewport width. */
    .knob-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
      gap: 12px 8px;
      align-items: start;
      justify-items: center;
    }

    .knob-cell {
      display: flex;
      justify-content: center;
      width: 100%;
    }

    /* Not a dial: the Osc 2 key centres against the faces beside it. */
    .knob-cell-toggle {
      align-self: center;
    }

    /* -- v14 kit editor (percussion): Common | High | Mid | Low -- */

    .kit-tabs {
      margin: 0 0 14px;
    }

    .knob-cell-ghosted {
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    /* The common-value affordance. knob.js draws a real muted ghost pointer
       on the dial face when it supports one — then this row holds only the
       "follow" button. On an older knob.js the same row carries the text
       fallback instead: a secondary read-out with a dot in the track colour. */
    .knob-ghost {
      display: flex;
      align-items: center;
      gap: 4px;
      font-family: var(--label-font, inherit);
      font-size: 10px;
      letter-spacing: 0.04em;
      color: var(--secondary);
    }

    .knob-ghost-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--track-accent, var(--secondary));
      opacity: 0.55;
      flex: none;
    }

    .knob-follow {
      font-size: 10px;
    }

    /* An overridden dial takes the track accent so the kit's exceptions are
       visible at a glance. */
    /* No padding: a ring drawn INSIDE the cell tints an overridden dial
       without nudging its face out of the row's shared baseline. */
    .knob-cell-overridden {
      border-radius: var(--radius);
      box-shadow: inset 0 0 0 1px var(--track-accent, var(--link));
    }

    .knob-cell-overridden .knob-ghost-dot {
      opacity: 1;
    }

    /* v12: shape-dial glyph readout (knob.js's `glyph` option) — icon(s)
       inline before the text, coloured with the readout's own text colour. */
    .knob-value-glyph {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      margin-right: 4px;
      vertical-align: middle;
      color: var(--text);
    }

    .osc2-toggle[aria-pressed='true'] {
      background: var(--link);
      color: var(--bg);
      border-color: var(--link);
    }

    .voice-editor .ve-section {
      margin-bottom: 12px;
    }

    .voice-editor .ve-heading {
      display: block;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--secondary);
    }

    .voice-editor .ve-control {
      margin-bottom: 10px;
    }

    .voice-editor .ve-control label {
      font-size: 14px;
    }

    .voice-editor select {
      width: 100%;
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* -- v6/v8: voice-editor header (track name + Random/Hold/Randomness) -- */

    .ve-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
    }

    .ve-extras {
      flex: 1 1 auto;
      justify-content: flex-end;
    }

    /* -- v6: per-track randomisation-target mini knobs -- */

    .vary-row {
      margin-bottom: 16px;
    }

    .vary-row > .panel-label {
      display: block;
      margin-bottom: 8px;
    }

    .vary-cells {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 10px 8px;
    }

    .vary-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .vary-slider {
      flex: 1 1 160px;
      margin-bottom: 0;
    }

    /* -- v6: arpeggiator section (relocated into the Arp track's editor) -- */

    .arp-inline {
      margin-bottom: 20px;
    }

    .arp-inline > .panel-label {
      display: block;
      margin-bottom: 8px;
    }

    .arp-manual {
      margin-top: 10px;
    }

    /* -- v6: shared step sequencer (melody/bass/arp single-lane,
          percussion three-lane) — grid width driven by --seq-cols, set by
          the page script per track/metre/arp-rate -- */

    .seq {
      margin-bottom: 20px;
    }

    .seq-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
    }

    .seq-editors {
      display: flex;
      gap: 6px;
    }

    .seq-editor-button {
      font-size: 12px;
      letter-spacing: 0;
    }

    .seq-editor-button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .seq-blocks {
      margin-bottom: 8px;
    }

    .seq-scroll {
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .seq-beats,
    .seq-lane {
      display: grid;
      grid-template-columns: repeat(var(--seq-cols, 16), minmax(22px, 1fr));
      gap: 3px;
    }

    .seq-beats {
      margin-bottom: 2px;
    }

    /* Pulls the (now separate role="row") probability strip back up
       against its own cell row rather than sitting a full flex gap away. */
    .seq-prob-row {
      margin-top: -3px;
    }

    .seq-beat-mark {
      font-size: 10px;
      text-align: center;
      color: var(--secondary);
    }

    .seq-rows {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .seq-lane-label {
      grid-column: 1 / -1;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--secondary);
    }

    /* -- v21 kit lanes: add / rename / re-kind / reorder / remove -------- */

    .seq-lane-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .seq-lane-add {
      padding: 4px 12px;
      line-height: 1;
    }

    .seq-lane-head {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      min-height: 26px;
    }

    /* The lane's own tint, mixed from the track accent — one instrument, its
       lanes told apart by shade rather than by six unrelated colours. */
    .seq-lane-tinted .seq-lane-label {
      color: var(--lane-tint, var(--secondary));
    }

    .seq-lane-tinted .seq-cell-on .seq-band {
      background: var(--lane-tint, var(--accent-warm, var(--link)));
    }

    .seq-lane-name {
      max-width: 12ch;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .seq-lane-input {
      width: 12ch;
    }

    .seq-lane-grip {
      padding: 0 2px;
      font-size: 13px;
      line-height: 1;
      color: var(--secondary);
      background: none;
      border: 0;
      cursor: grab;
      touch-action: none;
    }

    .seq-lane-dragging {
      opacity: 0.6;
    }

    .seq-lane-drop {
      box-shadow: inset 0 -2px 0 var(--link);
    }

    .seq-lane-kind {
      padding: 2px 4px;
      font-size: 11px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .seq-lane-move,
    .seq-lane-remove {
      width: 22px;
      height: 22px;
      min-width: 0;
      padding: 0;
      font-size: 11px;
      line-height: 1;
    }

    .seq-lane-move:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    /* v14 multi-sequencer strip: tab per sequencer, "+" copies the current
       one, and one weight number ("how likely the others hand over to me"). */
    .seq-tabs {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .seq-tabs-single .seq-tab-strip,
    .seq-tabs-single .seq-weight {
      display: none;
    }

    .seq-title {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .seq-add {
      padding: 4px 12px;
      line-height: 1;
    }

    .seq-weight {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--secondary);
    }

    .seq-weight input {
      width: 68px;
      padding: 4px 6px;
      font-size: 13px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* v14 probability groups: a dot per step above its lane, coloured by
       group. Inside a group a step only gets its chance if the group's
       previous step actually sounded. */
    .seq-dot-row {
      margin-bottom: 2px;
    }

    .seq-dot-cell {
      display: flex;
      justify-content: center;
    }

    .seq-dot {
      width: 10px;
      height: 10px;
      padding: 0;
      background: none;
      border: 1px solid var(--border);
      border-radius: 50%;
      cursor: pointer;
    }

    .seq-dot-on {
      border-color: transparent;
    }

    .seq-dot:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 2px;
    }

    .seq-cell {
      position: relative;
      min-height: 48px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      cursor: pointer;
      overflow: hidden;
    }

    .seq-cell-beat {
      border-left: 2px solid var(--accent-warm, var(--link));
    }

    .seq-cell-on {
      border-color: var(--link);
    }

    .seq-cell:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .seq-band {
      position: absolute;
      display: block;
      left: 2px;
      right: 2px;
      bottom: 0;
      height: 0;
      background: var(--accent-warm, var(--link));
      opacity: 0.55;
      border-radius: 2px;
      pointer-events: none;
    }

    .seq-cell-on .seq-band {
      opacity: 0.85;
    }

    /* Fat grab handle riding the band's loud edge — ≥10 px tall so the
       velocity top is grabbable without pixel-hunting (v13 correction). */
    .seq-band-top {
      position: absolute;
      display: block;
      left: 0;
      right: 0;
      height: 12px;
      margin-bottom: -6px;
      cursor: ns-resize;
      touch-action: none;
    }

    .seq-band-top::after {
      content: '';
      position: absolute;
      left: 2px;
      right: 2px;
      top: 5px;
      height: 2px;
      border-radius: 2px;
      background: var(--knob-pointer, var(--text));
      opacity: 0.7;
    }

    /* A tied step bridges visually into the next one: one long note. */
    .seq-cell-tie {
      border-right-color: transparent;
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
    }

    .seq-cell-tie::after {
      content: '';
      position: absolute;
      right: -4px;
      top: 45%;
      width: 5px;
      height: 3px;
      background: var(--accent-warm, var(--link));
    }

    /* v21 note length past the step it starts in: the band cannot show width
       it hasn't got, so the overhang is marked with an arrow into the next
       step (distinct from the tie bridge, which joins two struck steps). */
    .seq-cell-legato::before {
      content: '›';
      position: absolute;
      right: 2px;
      top: 1px;
      font-size: 12px;
      line-height: 1;
      color: var(--accent-warm, var(--link));
      pointer-events: none;
    }

    /* v14 playhead: the sounding step lights up. The cream --knob-pointer
       reads as the asked-for white on the dark theme; --text carries the
       mark on the light theme, where a literal white would vanish. */
    .seq-cell-playing {
      border-color: var(--text);
      box-shadow: inset 0 0 0 2px var(--knob-pointer);
    }

    .seq-prob {
      position: relative;
      display: block;
      height: 5px;
      margin-top: 2px;
      background: var(--border);
      border-radius: 3px;
      cursor: pointer;
      overflow: hidden;
    }

    .seq-prob-fill {
      position: absolute;
      display: block;
      top: 0;
      left: 0;
      bottom: 0;
      width: 0;
      background: var(--link);
    }

    /* A ranged (drifting) step prob shows its min–max window instead of a
       from-zero fill, tinted like the knob's own range arc. */
    .seq-prob-fill-range {
      background: var(--accent-warm, var(--link));
      opacity: 0.85;
    }

    /* -- v14: dissonance dial, factory presets, tutorial panel -- */

    /* v26: the ONE feel row per editor. Fixed-width cells on a wrapping flex
       line, aligned at the top so every face hangs from the same baseline and
       the text under it stays below (v18 dial contract) — a long read-out can
       never shove its neighbour up. */
    .dissonance-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 12px 8px;
      margin-bottom: 16px;
      --knob-size: 72px;
    }

    .dissonance-row > .knob-cell {
      width: calc(var(--knob-size, 72px) + 12px);
    }

    /* The slider fallback has no square face to align, so it takes a readable
       width and wraps onto the next line rather than squeezing the dials. */
    .dissonance-row > .ve-control {
      flex: 1 1 200px;
      margin-bottom: 0;
    }

    .dissonance-knob {
      width: 84px;
    }

    /* v12 mono/glide, in the voice-editor header beside the state lamp. The
       toggle takes the same pressed treatment as the Osc 2 switch, and the
       dial the same 84px cell every other knob in a row uses, so the header's
       faces stay on one baseline (v18 layout contract). */
    .mono-toggle[aria-pressed='true'] {
      background: var(--link);
      color: var(--bg);
      border-color: var(--link);
    }

    .glide-knob,
    .drift-knob {
      display: flex;
      justify-content: center;
      width: 84px;
