---
import Base from '../layouts/Base.astro';
import { resolveFactoryPresets } from '../data/factory-presets-fallback.js';
import { getTracks } from '../scripts/ambient-engine.js';

// v16: the curated presets live in src/data/factory-presets.json when that file
// exists, and in the fallback module until it does — resolved at BUILD time so
// the gallery below and the /[slug] routes are always the same set. The list
// reaches the page script as a JSON payload element rather than a `define:vars`
// script, because define:vars forces an inline script and this page's one
// module script must stay bundled (dynamic imports, and the boot gate).
const FACTORY_PRESETS = resolveFactoryPresets();
const factoryPresetsJSON = JSON.stringify(FACTORY_PRESETS).replace(/</g, '\\u003c');

// v0.0.57: a short primary set plus Other, as two <optgroup>s — the real HTML
// convention for exactly this, rather than an invented two-step reveal. The
// primary eight are the ones a musician reaches for without thinking; the rest
// are there and out of the way. Every VALUE is a wire key and is frozen: the
// labels are free to change, these are not.
//
// The label stays "Scale", not "Mode", because the list is mixed — Dorian,
// Lydian, Aeolian, Ionian, Mixolydian, Phrygian and Locrian are modes, but the
// pentatonics, blues, whole tone, diminished and chromatic are not.
const modeGroups: [string, [string, string][]][] = [
  ['Common', [
    ['ionian', 'Major (Ionian)'],
    ['aeolian', 'Natural minor (Aeolian)'],
    ['majorPentatonic', 'Major pentatonic'],
    ['minorPentatonic', 'Minor pentatonic'],
    ['blues', 'Blues'],
    ['dorian', 'Dorian'],
    ['mixolydian', 'Mixolydian'],
    ['harmonicMinor', 'Harmonic minor'],
  ]],
  ['Other', [
    ['melodicMinor', 'Melodic minor'],
    ['lydian', 'Lydian'],
    ['phrygian', 'Phrygian'],
    ['locrian', 'Locrian'],
    ['wholeTone', 'Whole tone'],
    ['diminished', 'Diminished'],
    ['chromatic', 'Chromatic'],
  ]],
];

const roots = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

const timeSignatures = ['3/4', '4/4', '5/4', '6/8', '7/8'];

const structures: [string, string][] = [
  ['auto', 'Auto'],
  ['drone', 'Drone'],
  ['waves', 'Waves'],
  ['build', 'Build'],
  ['abab', 'ABAB'],
  ['journey', 'Journey'],
  ['custom', 'Custom'],
];

// v21: the track rows are built from the ENGINE'S OWN registry, at BUILD time.
// ambient-engine.js is import-safe outside a browser (nothing touches Web Audio
// until createEngine() runs), so the frontmatter reads the module's static
// getTracks() export rather than standing up a live engine — the server render
// and the page script then agree on which tracks exist, their labels and their
// order without either holding a list of its own.
const TRACKS: [string, string][] = getTracks().map(
  (track) => [track.id, track.label] as [string, string]
);

// v0.0.50 (psychologist consult, docs-private/psychologist-consult-2026-07-28.md):
// Simple asks three plain questions — how much energy, how much change, how
// loud — so it gets exactly three dials. Energy is a genuine macro over tempo
// AND complexity (tempo is the dominant arousal cue; an Energy dial that
// didn't own it would be the weakest control wearing the strongest name).
// Advanced keeps the component views; moving Energy visibly moves them, which
// is how a macro teaches itself.
// [param id, label, low end-mark, mid end-mark, high end-mark]
const SIMPLE_PANEL_DIALS: [string, string, string, string | null, string][] = [
  // v0.0.83 (his item 90): Simple lost every tempo control when v0.0.71
  // separated Energy from tempo — three dials remained and none moved bpm.
  ['speed', 'Tempo', 'Slow', null, 'Fast'],
  ['energy', 'Energy', 'Calm', null, 'Lively'],
  ['randomness', 'Change', 'Never', 'Now and then', 'Often'],
  ['volume', 'Volume', 'Quiet', null, 'Loud'],
];

// The Advanced foot row: the component views (Tempo, Complexity), the
// de-fused Variation, and Volume. [param id, label, low, mid, high]
const MAIN_DIALS: [string, string, string, string | null, string][] = [
  ['speed', 'Tempo', 'Slow', null, 'Fast'],
  ['complexity', 'Complexity', 'Calm', null, 'Complex'],
  ['randomness', 'Randomness', 'Repetitive', 'Evolving', 'Random'],
  ['volume', 'Volume', 'Quiet', null, 'Loud'],
];

// v0.0.35 de-fuse: on Advanced, the randomness slot is no longer the Simple
// tab's fused macro. It is Variation — this track set's own randomness, with
// repetition split out beside it as Recall — so it needs its own label and
// end-marks rather than inheriting the fused dial's, whose words were a mirror
// image of Recall's and made the pair read as one control.
const ADVANCED_DIAL_OVERRIDES: Record<
  string,
  { label: string; low: string; mid: string | null; high: string }
> = {
  randomness: { label: 'Variation', low: 'Hold', mid: null, high: 'Vary' },
};

// Hardcoded from the engine v2 contract's VOICES table. The UI never imports
// engine-voices.js into frontmatter — the voice implementations aren't
// relevant here, only the ids/labels the <select> options need. (The page
// script lazily dynamic-imports engine-voices.js for patch defaults only.)
const VOICES: Record<string, [string, string][]> = {
  pad: [
    ['warm', 'Warm'],
    ['glass', 'Glass'],
    ['strings', 'Strings'],
    ['choir', 'Choir'],
    ['polysaw', 'Poly saw'],
  ],
  bass: [
    ['sub', 'Sub'],
    ['round', 'Round'],
    ['breath', 'Breath'],
    ['fingered', 'Fingered'],
    ['sawbass', 'Saw bass'],
    ['acid', 'Squelch'],
    ['upright', 'Upright'],
  ],
  melody: [
    ['pluck', 'Pluck'],
    ['bell', 'Bell'],
    ['flute', 'Flute'],
    ['keys', 'Keys'],
    ['call', 'Call'],
    ['tines', 'Tines'],
    ['nylon', 'Nylon guitar'],
    ['tape', 'Worn keys'],
    ['stab', 'Organ stab'],
  ],
  texture: [
    ['sparkle', 'Sparkle'],
    ['grains', 'Grains'],
    ['chimes', 'Chimes'],
    ['wash', 'Wash'],
    ['colour', 'Coloured noise'],
    ['cloud', 'Grain cloud'],
    ['call', 'Call'],
  ],
  arp: [
    ['softPluck', 'Soft pluck'],
    ['crystal', 'Crystal'],
    ['marimba', 'Marimba'],
    ['muted', 'Muted comp'],
  ],
  percussion: [
    ['soft', 'Soft kit'],
    ['hand', 'Hand drum'],
    ['tick', 'Ticks'],
    ['dust', 'Worn kit'],
  ],
};
---
<Base title="Ambi4: Ambience for Work" description="An endless ambient music generator that runs entirely in your browser.">

  <button
    slot="header-actions"
    type="button"
    id="tutorial-toggle"
    class="round-button"
    data-transport="tutorial"
    aria-label="Show the guided tour"
    aria-expanded="false"
    aria-controls="tutorial-panel"
  >?</button>

  <div id="generator-app" hidden>
    <!-- v0.0.41: two columns. TRANSPORT and PROCESSOR share the heading row,
         the play buttons and the processor dial share the row below it, and the
         genre picker sits left of the processor readout on the last. Everything
         in the right column is right-aligned to the panel edge, so the label,
         the dial and the numbers it produces line up with each other and stay
         lined up as the panel narrows. -->
    <div class="module-panel transport-module">
      <div class="transport-head">
        <span class="panel-label transport-label" aria-hidden="true">Transport</span>
      </div>
      <div class="transport-main">
        <div class="transport-buttons">
          <button
            id="toggle-play"
            type="button"
            class="play-toggle"
            data-transport="play"
            aria-pressed="false"
          >
            <span class="transport-glyph play-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M7 4.5 19 12 7 19.5Z" /></svg>
            </span>
            <span class="play-toggle-label">Play</span>
            <span class="transport-glyph finish-glyph" aria-hidden="true" hidden>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><rect x="8" y="4" width="2" height="16" /><rect x="13" y="4" width="5" height="16" /></svg>
            </span>
            <!-- v0.0.55: the third state of the one transport key. Play shows
                 ▶, Finish shows the final barline 𝄂, and Stop shows the
                 square — the caption said "Stop" from v0.0.41 while the glyph
                 beside it still said "finish", which is the owner's "supposed
                 to swap the Finish icon for the Stop icon". -->
            <span class="transport-glyph stop-glyph" aria-hidden="true" hidden>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="1" /></svg>
            </span>
          </button>
          <button id="pause-toggle" type="button" class="transport-button pause-button" data-transport="pause" aria-pressed="false" disabled>
            <span class="transport-glyph pause-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="7" y="5" width="4" height="14" rx="1" /><rect x="13" y="5" width="4" height="14" rx="1" /></svg>
            </span>
            <span class="transport-glyph resume-glyph" aria-hidden="true" hidden>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M7 4.5 19 12 7 19.5Z" /></svg>
            </span>
            <span class="pause-label">Pause</span>
          </button>
          <button id="rewind" type="button" class="transport-button forward-button" data-transport="rewind">
            <span class="transport-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20 5.5 11 12l9 6.5Z" /><path d="M12 5.5 3 12l9 6.5Z" /></svg>
            </span>
            <span>Back</span>
          </button>
          <button id="fast-forward" type="button" class="transport-button forward-button" data-transport="fastforward">
            <span class="transport-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M4 5.5 13 12 4 18.5Z" /><path d="M12 5.5 21 12 12 18.5Z" /></svg>
            </span>
            <span>Next</span>
          </button>
          <button id="record-toggle" type="button" class="transport-button record-button" data-transport="record" aria-pressed="false">
            <span class="transport-glyph record-dot" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><circle cx="12" cy="12" r="6" /></svg>
            </span>
            <span class="record-label">Record</span>
          </button>
        </div>
        <!-- v0.0.40: one clock for both timers, and the play-along keyboard
             joins them as a peer icon instead of a strip below the genre
             picker. Sleep and Schedule-start are the same kind of thing (when
             does the music happen) and were two identical clock faces side by
             side; merged, the row reads as three distinct jobs rather than
             five ambiguous glyphs. -->
        <div class="transport-icons">
          <div class="popover-anchor">
            <!-- v0.0.89 (his 103): icon-only, back in the icon row, CREATE
                 in the tooltip — the wide in-row button forced the transport
                 onto two lines. The id stays play-along-open (wired
                 everywhere); the orange colour marks it as the second main
                 door without costing a single pixel of row space. -->
            <button
              type="button"
              id="play-along-open"
              class="icon-button create-button"
              data-transport="playalong"
              aria-label="Create"
              title="Create"
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="play-along"
            >
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="6" width="19" height="12" rx="1.5" />
                <path d="M7 6v7M11 6v7M15 6v7M19 6v7" />
              </svg>
            </button>
        <!-- v0.0.40: the panel is a POPOVER hanging off the keyboard icon up in
             the transport icon row, beside the clock — it is the same kind of
             thing as the timers (an occasional tool), not a permanent strip
             below the genre picker. The comment above about no control ever
             moving still holds INSIDE the panel: once open, nothing shifts under
             the user's hand. -->
        <div class="play-along popover module-panel" id="play-along" role="dialog" aria-labelledby="play-along-title" hidden>
          <div class="control-label-row">
            <span class="panel-label popover-title" id="play-along-title">Create</span>
            <span id="create-info"></span>
          </div>
          <!-- v0.0.89 (his 103): one title, buttons not paragraphs, the
               instructions in the ⓘ. Blank slate is the real one; the Zero
               buttons strip one layer at a time so ANY preset can be the
               source. -->
          <div class="create-row">
            <button type="button" id="create-blank" class="secondary-button">Blank slate</button>
            <button type="button" id="zero-voices" class="secondary-button">Zero voices</button>
            <button type="button" id="zero-chords" class="secondary-button">Zero chords</button>
            <button type="button" id="zero-notes" class="secondary-button">Zero notes</button>
            <button type="button" id="zero-rhythms" class="secondary-button">Zero rhythms</button>
            <button type="button" id="zero-fx" class="secondary-button">Zero FX</button>
          </div>
          <div class="create-row">
            <button type="button" id="guided-start" class="secondary-button">Help me start</button>
            <button type="button" id="create-tap" class="secondary-button" aria-pressed="false">Tap a rhythm (Space)</button>
            <button type="button" id="create-refit" class="secondary-button" hidden>Re-fit the last take</button>
            <label class="visually-hidden" for="create-seed">Seed the instrument voices from a genre</label>
            <select id="create-seed" class="genre-select create-seed">
              <option value="">Seed voices from…</option>
            </select>
            <button type="button" id="compose-chords" class="secondary-button">Type the chords</button>
          </div>
          <div class="create-row create-midi-row">
            <label class="secondary-button create-midi-label" for="compose-midi">
              Import a MIDI file
              <input type="file" id="compose-midi" accept=".mid,.midi,audio/midi,audio/x-midi" class="visually-hidden" />
            </label>
            <label class="visually-hidden" for="compose-midi-track">Import onto which instrument</label>
            <select id="compose-midi-track" class="genre-select create-midi-track"></select>
          </div>
          <div class="create-row create-melody-row">
            <label class="visually-hidden" for="compose-melody-text">Type a melody, one note per beat</label>
            <input
              type="text"
              id="compose-melody-text"
              class="create-melody-input"
              placeholder="Type a melody: C4 E4 G4 - . B3 (dash holds, dot rests)"
              autocomplete="off"
              spellcheck="false"
            />
            <button type="button" id="compose-melody-write" class="secondary-button">Write it</button>
          </div>
          <div id="guided-tree" class="create-row create-guided-tree" hidden>
            <p class="hint guided-question" id="guided-question"></p>
            <div class="create-row guided-choices" id="guided-choices"></div>
          </div>
          <p class="hint" id="guided-tip" aria-live="polite"></p>
          <div class="control-label-row">
            <span class="panel-label timer-section" id="play-along-section-title">Musical typing</span>
            <span id="musical-typing-info"></span>
          </div>
          <div class="play-along-row" id="play-along-row">
            <button
              type="button"
              id="play-along-toggle"
              class="transport-button play-along-button"
              aria-pressed="false"
              aria-describedby="play-along-note"
            >
              <span class="transport-glyph" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="3" y="6" width="18" height="12" rx="1" />
                  <path d="M8 6v7M12 6v7M16 6v7" />
                </svg>
              </span>
              <span>Keys</span>
            </button>
            <label class="visually-hidden" for="play-along-track">Track the keys play</label>
            <select id="play-along-track" class="genre-select play-along-select"></select>
            <span id="play-along-readout" class="value-readout play-along-readout" role="status"></span>
            <button
              type="button"
              id="play-along-capture"
              class="transport-button play-along-capture"
              aria-pressed="false"
              aria-describedby="play-along-note"
              disabled
            >
              <span class="transport-glyph record-dot" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><circle cx="12" cy="12" r="6" /></svg>
              </span>
              <span>Capture</span>
            </button>
            <button
              type="button"
              id="play-along-undo"
              class="transport-button"
              aria-describedby="play-along-note"
              disabled
            >
              <span>Undo</span>
            </button>
          </div>
          <p id="play-along-note" class="visually-hidden">
            Keys z x c v b n m play one octave and q w e r t y u the next; minus and
            equals change octave; a MIDI instrument plays the same track. Capture
            records the rhythm, velocity and note length you play into the track's
            step grid — the pitch comes from the piece's own harmony — and Undo puts
            the old grid back.
          </p>
        </div>
          </div>
          <div class="popover-anchor">
            <button
              type="button"
              id="timers-toggle"
              class="icon-button"
              data-transport="sleep"
              aria-label="Timers — sleep and schedule start"
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="timers-popover"
            >
              <!-- A plain clock. It was the alarm-clock glyph, bells and all,
                   which is only one of the two things behind it. -->
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3.5 2" />
              </svg>
            </button>
            <span id="sleep-chip" class="countdown-chip" aria-hidden="true" hidden></span>
            <span id="alarm-chip" class="countdown-chip countdown-chip-alarm" aria-hidden="true" hidden></span>
            <div id="timers-popover" class="popover module-panel" role="dialog" aria-labelledby="timers-popover-title" hidden>
              <span class="panel-label popover-title" id="timers-popover-title">Timers</span>

              <span class="panel-label timer-section" id="sleep-popover-title">Sleep timer</span>
              <div id="sleep-idle" class="timer-row">
                <button type="button" class="secondary-button sleep-preset" data-minutes="15">15 min</button>
                <button type="button" class="secondary-button sleep-preset" data-minutes="30">30 min</button>
                <button type="button" class="secondary-button sleep-preset" data-minutes="60">1 h</button>
                <button type="button" class="secondary-button sleep-preset" data-minutes="120">2 h</button>
                <span class="timer-custom">
                  <label for="sleep-custom" class="visually-hidden">Custom sleep timer minutes</label>
                  <input id="sleep-custom" type="number" min="1" max="720" inputmode="numeric" placeholder="min" />
                  <button type="button" id="sleep-start" class="secondary-button">Start</button>
                </span>
              </div>
              <div id="sleep-active" class="timer-row" hidden>
                <span id="sleep-countdown" class="timer-status"></span>
                <button type="button" id="sleep-cancel" class="link-button">Cancel</button>
              </div>

              <span class="panel-label timer-section" id="alarm-popover-title">Schedule start</span>
              <div id="alarm-idle" class="timer-row">
                <label for="alarm-time" class="visually-hidden">Alarm time</label>
                <input id="alarm-time" type="time" />
                <button type="button" id="alarm-set" class="secondary-button">Set alarm</button>
              </div>
              <div id="alarm-active" class="timer-row" hidden>
                <span id="alarm-countdown" class="timer-status"></span>
                <button type="button" id="alarm-cancel" class="link-button">Cancel</button>
              </div>
              <p class="hint">Only works while this tab stays open and the device is awake.</p>
            </div>
          </div>

        </div>
        <!-- v0.0.96: label, dial and readout are ONE block. They were split
             across three containers (header, transport row, genre row) — the
             no-orphan rule's worst offender, recorded as deliberate at the
             time and reversed now. -->
        <div class="processor-row">
          <span class="panel-label processor-label" id="processor-label">Processor</span>
          <div class="dial-slot dial-label-external" id="processor-dial"></div>
          <span id="processor-readout" class="value-readout processor-readout" role="status"></span>
        </div>
      </div>

      <!-- v26 genre transport: the genre picker sits directly UNDER the
           Play/Finish button, because picking a genre is the second thing a
           listener does. Its list is built by the page script (the twelve
           genre files are a build-time glob import), and the favourites
           editor beside it is the same anchored-popover pattern the sleep and
           alarm dialogs use. -->
      <div class="genre-row popover-anchor">
        <label class="visually-hidden" for="genre-select">Genre</label>
        <select id="genre-select" class="genre-select"></select>
        <div
          id="genre-favourites"
          class="popover module-panel genre-favourites"
          role="dialog"
          aria-labelledby="genre-favourites-title"
          hidden
        >
          <span class="panel-label popover-title" id="genre-favourites-title">Favourite genres</span>
          <p class="hint">Tick the ones you come back to. Each mood you favourite also gets its own entry in the genre list.</p>
          <div id="genre-favourites-list" class="genre-fav-list"></div>
          <label class="genre-fav-hide">
            <input type="checkbox" id="genre-hide-others" />
            Hide the rest of the genres from the list
          </label>
          <div class="genre-fav-actions">
            <button type="button" id="genre-favourites-done" class="secondary-button">Done</button>
          </div>
        </div>
        <!-- v0.0.104: the genre's RULES, on screen and editable — the owner's
             ruling on where the everything-editable build starts. The genre
             files are generative rules and the compiler is pure and seed-
             deterministic, so an edit recompiles the SAME seed under new
             rules: same dice, only what you change, changes. -->
        <button
          type="button"
          id="genre-rules-toggle"
          class="secondary-button genre-rules-toggle"
          aria-haspopup="dialog"
          aria-expanded="false"
          hidden
        >Rules</button>
        <div
          id="genre-rules"
          class="popover module-panel genre-rules"
          role="dialog"
          aria-labelledby="genre-rules-title"
          hidden
        >
          <span class="panel-label popover-title" id="genre-rules-title">Genre rules</span>
          <p class="hint">
            The rules this genre draws every bar from. Edit them and Apply: the
            piece is re-drawn from YOUR rules with the same dice, so only what
            you change, changes. One entry per line; empty a box to fall back
            to the genre's own rules.
          </p>
          <label class="genre-rules-label" for="genre-rules-progressions">Chord progressions (roman numerals — the app seeds its loop from one)</label>
          <textarea id="genre-rules-progressions" class="genre-rules-text" rows="5" spellcheck="false" autocomplete="off"></textarea>
          <label class="genre-rules-label" for="genre-rules-anchors" id="genre-rules-anchors-label">Kit patterns (x is a hit, - a rest, sixteenths)</label>
          <textarea id="genre-rules-anchors" class="genre-rules-text" rows="4" spellcheck="false" autocomplete="off"></textarea>
          <label class="genre-rules-label" for="genre-rules-cells">Syncopation cells (short x/- fragments the bass leans on)</label>
          <textarea id="genre-rules-cells" class="genre-rules-text" rows="2" spellcheck="false" autocomplete="off"></textarea>
          <p id="genre-rules-error" class="hint genre-rules-error" role="alert" hidden></p>
          <div class="genre-fav-actions">
            <button type="button" id="genre-rules-apply" class="secondary-button">Apply</button>
            <button type="button" id="genre-rules-reset" class="secondary-button" hidden>Back to the genre's rules</button>
          </div>
        </div>
      </div>

      <div class="transport-row">
        <p id="transport-status" class="timer-status" role="status"></p>
        <span id="record-status" class="record-status" role="status"></span>
      </div>

    </div>

    <p id="ios-silent-hint" class="hint" hidden>
      iPhone/iPad: if you hear nothing, check the silent switch.
    </p>

    <!-- v18: the oscilloscope and the piano roll are PERSISTENT — they sit
