  <p id="generator-unavailable" hidden>
    Sorry &mdash; this browser can&rsquo;t run the generator (Web Audio isn&rsquo;t
    available, or the audio engine failed to load). Try a recent version of
    Chrome, Firefox, Safari or Edge.
  </p>

  <script id="factory-presets-data" type="application/json" is:inline set:html={factoryPresetsJSON}></script>

  <script>
    // The page's own modules are loaded dynamically, below, so a browser that
    // cannot run one of them still boots. These two are the exception: pure
    // data and pure arithmetic, no feature to detect, and both are needed the
    // instant a shared link lands (see § v29 share names).
    import WORDLIST from '../data/wordlist.json';
    import { shareNameFor, wordPoolFrom } from '../scripts/share-name.js';

    const app = document.getElementById('generator-app');
    const unavailable = document.getElementById('generator-unavailable');

    // ONE place for the preset-submission target (the domain may not exist
    // yet — the copy-JSON path is the reliable one).
    const CONTACT_URL = 'https://contact.andeye.com/';

    const LEGACY_STORAGE_KEY = 'ambi4-generator-settings-v2';

    /**
     * v21: THE TRACK LISTS ARE THE ENGINE'S, not the page's. Every list below
     * is a view over one registry — engine.getTracks() where the engine
     * publishes one, and this table where it does not. The literals are the
     * registry as it stood when this page was built, kept for exactly the
     * reason every other engineCaps probe has a fallback: an older engine
     * bundle must still boot, on the six tracks the page has always had.
     *
     * `sequenced` is the one field getTracks()'s public view doesn't carry
     * (it publishes identity and presentation only), so the fallback keeps
     * the engine's own ordering index: a NUMBER is that track's place in the
     * sequenced set, null means sustained, no step grid.
     */
    const FALLBACK_TRACKS = [
      { id: 'pad', label: 'Pad', family: 'melodic', sequenced: null },
      { id: 'arp', label: 'Arp', family: 'melodic', sequenced: 2 },
      { id: 'melody', label: 'Melody', family: 'melodic', sequenced: 0 },
      { id: 'bass', label: 'Bass', family: 'melodic', sequenced: 1 },
      { id: 'texture', label: 'Texture', family: 'melodic', sequenced: null },
      { id: 'percussion', label: 'Percussion', family: 'percussive', sequenced: 3 },
    ];

    /**
     * The five views the whole page builds from, derived from one track list.
     * `tracks` is either getTracks()'s public view or FALLBACK_TRACKS; the
     * engine's TUNED_TRACKS / SEQUENCED_TRACKS exports are taken where the
     * bundle has them, and where it doesn't the built-in semantics stand in:
     * a melodic track sounds a pitch (so it takes a Dissonance dial and a
     * Density dial), a percussive one is a kit, and the sequenced set keeps
     * the fallback table's order — load-bearing, since the engine draws one
     * rng() per sequenced track in exactly that order.
     */
    function trackListsFrom(tracks, engineExports = {}) {
      const ids = tracks.map((track) => track.id);
      const has = (id) => ids.includes(id);
      const familyOf = new Map(tracks.map((track) => [track.id, track.family]));
      const labelOf = new Map(FALLBACK_TRACKS.map((track) => [track.id, track.label]));
      const isMelodic = (id) => familyOf.get(id) === 'melodic';
      const exported = (list) => (Array.isArray(list) ? list.filter(has) : null);
      // v23: the engine's exported lists are the FLOOR — six built-ins, frozen
      // at import, and a server render cannot know a user's tracks. Anything in
      // the live list that the floor does not name is a user track, and it
      // appends AFTER every built-in: sequenced (every user track is — it has
      // no bespoke generative pass, so its material comes from its step grid)
      // and tuned when melodic.
      const builtin = new Set(FALLBACK_TRACKS.map((track) => track.id));
      const userIds = ids.filter((id) => !builtin.has(id));
      const withUsers = (list, keep) => [
        ...list.filter((id) => !userIds.includes(id)),
        ...userIds.filter(keep),
      ];
      const sequenced = withUsers(
        exported(engineExports.SEQUENCED_TRACKS) ||
          FALLBACK_TRACKS.filter((track) => track.sequenced !== null)
            .sort((a, b) => a.sequenced - b.sequenced)
            .map((track) => track.id)
            .filter(has),
        () => true
      );
      return {
        TRACK_IDS: ids,
        TRACK_LABELS: Object.fromEntries(
          tracks.map((track) => [track.id, track.label || labelOf.get(track.id) || track.id])
        ),
        TRACK_FAMILY: Object.fromEntries(
          tracks.map((track) => [track.id, track.family === 'percussive' ? 'percussive' : 'melodic'])
        ),
        // Tuned tracks take a Dissonance dial (v14); percussion has no chord
        // to stray from.
        TUNED_TRACKS: withUsers(
          exported(engineExports.TUNED_TRACKS) || ids.filter(isMelodic),
          isMelodic
        ),
        SEQ_TRACKS: sequenced,
        // The single-lane sequencers: a kit's grid is lanes, melodic or not.
        SEQ_SINGLE_TRACKS: sequenced.filter(isMelodic),
      };
    }

    // Seeded from the fallback so nothing depends on init() having run, then
    // re-derived from the engine's registry inside init (see engineCaps).
    let { TRACK_IDS, TRACK_LABELS, TRACK_FAMILY, TUNED_TRACKS, SEQ_TRACKS, SEQ_SINGLE_TRACKS } =
      trackListsFrom(FALLBACK_TRACKS);

    // ---- v23 user tracks (page view) ------------------------------------
    // The engine's instance registry is the authority on WHICH tracks exist;
    // `settings.userTracks` is the page's copy of it, which is what persists,
    // travels in a preset and rides a share link. Both are kept in step by
    // syncUserTracks() below — never by two separate derivations.
    let USER_TRACKS = [];
    let USER_TRACK_BY_ID = new Map();

    // The engine's own grammar and caps, restated (not imported: the page reads
    // the ENGINE's answer through canAddTrack before it ever commits, and these
    // exist so the form can say no before the engine has to).
    const USER_TRACK_MAX = 6;
    const USER_TRACK_LABEL_MAX = 24;
    const USER_TRACK_ID_RE = /^[a-z][a-z0-9-]{1,23}$/;
    const RESERVED_TRACK_IDS = [
      ...FALLBACK_TRACKS.map((track) => track.id),
      'off', 'auto', 'on', 'master', 'global', 'all', 'none',
    ];

    const isUserTrack = (id) => USER_TRACK_BY_ID.has(id);

    /**
     * A track's family, asked of the live registry rather than of its id. Every
     * `track === 'percussion'` test in a track-shaped path became this: the
     * percussion kit is a FAMILY, and since v23 a user track can join it.
     */
    const isPercussiveTrack = (id) =>
      (USER_TRACK_BY_ID.get(id)?.family ?? TRACK_FAMILY[id]) === 'percussive';

    /**
     * A MIDI number as a note anyone can read. Sharps rather than flats,
     * because the app writes its scales that way and one spelling everywhere
     * beats a clever one in half the places. Middle C is C4, which is the
     * convention every DAW on the owner's machine uses.
     */
    const PITCH_LETTERS = ['C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯', 'A', 'A♯', 'B'];
    const pitchName = (midi) => {
      const n = Math.round(midi);
      return `${PITCH_LETTERS[((n % 12) + 12) % 12]}${Math.floor(n / 12) - 1}`;
    };

    /**
     * The voice BANK a track plays from. A built-in plays its own — the bank is
     * named for the track — and a user track plays the stock bank it was made
     * with (the v10 boundary: no new voice code ships for a user track). Every
     * table keyed by voice bank (VOICE_LABELS, VOICE_HINTS, the voices module,
     * SCOPE_FREQ) is read through this rather than by track id.
     */
    const voiceSetOf = (id) => USER_TRACK_BY_ID.get(id)?.voiceSet ?? id;

    /**
     * The class that carries a track's accent colour. Derived from the
     * registry's own `colourToken` (`--track-pad` → `track-color-pad`,
     * `--track-user-2` → `track-color-user-2`), so a user track theming itself
     * and a built-in theming itself are one mechanism, not two.
     */
    function trackColourClass(id) {
      const token = USER_TRACK_BY_ID.get(id)?.colourToken;
      const name = typeof token === 'string' && /^--track-[a-z0-9-]+$/.test(token)
        ? token.slice('--track-'.length)
        : id;
      return `track-color-${name}`;
    }

    // Voice ids → display names, mirroring the frontmatter's <option> labels
    // (the page never imports engine-voices.js just for names).
    const VOICE_LABELS = {
      pad: { warm: 'Warm', glass: 'Glass', strings: 'Strings', choir: 'Choir', polysaw: 'Poly saw' },
      arp: { softPluck: 'Soft pluck', crystal: 'Crystal', marimba: 'Marimba', muted: 'Muted comp' },
      melody: { pluck: 'Pluck', bell: 'Bell', flute: 'Flute', keys: 'Keys', call: 'Call', tines: 'Tines', nylon: 'Nylon guitar', tape: 'Worn keys', stab: 'Organ stab' },
      bass: { sub: 'Sub', round: 'Round', breath: 'Breath', fingered: 'Fingered', sawbass: 'Saw bass', acid: 'Squelch', upright: 'Upright' },
      texture: {
        sparkle: 'Sparkle',
        grains: 'Grains',
        chimes: 'Chimes',
        wash: 'Wash',
        colour: 'Coloured noise',
        cloud: 'Grain cloud',
        call: 'Call',
      },
      percussion: { soft: 'Soft kit', hand: 'Hand drum', tick: 'Ticks', dust: 'Worn kit' },
    };

    // Transport controls hidden on the Simple tab. Deliberately EMPTY for this
    // build (every button ships visible on both tabs); adding e.g. 'record'
    // here is the whole change needed to demote a button to Advanced-only.
    const SIMPLE_HIDDEN = new Set([]);

    // ---- pre-launch: paid features are hidden, not teased ------------------
    // Nothing greyed, nothing captioned "coming soon" — an affordance the
    // visitor cannot use is simply not rendered. Every code path behind these
    // stays intact and dormant (MediaRecorder wiring, the sequencer's JS-editor
    // entry), so launch is this one flag going false.
    // Every paid-tier feature stays invisible until its tier can be bought
// (owner rule: never give-then-take). Dev unlock for the owner only:
// localStorage.setItem('ambi4:dev','1') then refresh.
const DEV_UNLOCK = (() => { try { return localStorage.getItem('ambi4:dev') === '1'; } catch { return false; } })();
const PAID_FEATURES_HIDDEN = !DEV_UNLOCK;

    // Hidden on BOTH tabs while PAID_FEATURES_HIDDEN — by data-transport id,
    // the same handle SIMPLE_HIDDEN uses.
    const HIDDEN_UNTIL_LAUNCH = new Set(['record']);

    // ---- v6 step sequencers (shared shape) ------------------------------
    // Steps-per-bar by metre; all 20 slots persist, the first N render/play.
    const STEPS_PER_BAR = { '3/4': 12, '4/4': 16, '5/4': 20, '6/8': 12, '7/8': 14 };
    const SEQ_SLOTS = 20;
    const SEQ_MAX = 8; // sequencers per track (Markov chain size ceiling)
    // SEQ_TRACKS / SEQ_SINGLE_TRACKS are registry views — see trackListsFrom.
    // v21 per-step gate: the fraction of its step a note is held for. 1 fills
    // the step exactly; above that it runs into the next one (legato).
    const SEQ_GATE_MIN = 0.1;
    const SEQ_GATE_MAX = 2;
    const SEQ_GATE_DEFAULT = 0.9;
    const SEQ_GATE_NUDGE = 0.05;
    // v21 per-track density: 1 is the complexity-derived rate, 2 twice it.
    const TRACK_DENSITY_MAX = 2;
    // v21 chord length (harmony.rhythm): 'auto' lets the hook pick, the rest
    // are a fixed bars-per-chord count.
    const CHORD_LENGTHS = ['auto', 1, 2, 4, 8];
    // Probability-group dot colours (v13/v14): group id → hue. Deliberately
    // distinct from the six track accents so a group never reads as a track.
    const GROUP_COLOURS = ['#d98324', '#3f8f6d', '#8a5cd6', '#c2456b', '#3f7fbf', '#9a8f2e'];
    // v14/v21: lanes render HIGH at the top, LOW at the bottom — the way a
    // drum grid is read everywhere else. The step object is KEYED by lane id,
    // so this list is what gives the lanes their order, their display names
    // and (v21) their voice-kind mapping. The three built-ins keep the ids the
    // engine has always used, so every stored pattern and every `perKind`
    // override still lands on the lane it was written for.
    const PERC_LANE_KINDS = [
      ['high', 'High'],
      ['mid', 'Mid'],
      ['low', 'Low'],
    ];
    const PERC_BUILTIN_LANES = ['high', 'mid', 'low'];
    const PERC_MAX_LANES = 8; // v21 cap
    const PERC_NEW_LANE_KIND = 'mid';

    function defaultPercLanes() {
      return PERC_LANE_KINDS.map(([id, label]) => ({ id, label, kind: id }));
    }

    /** Top-down rank: high lanes sort above mid, mid above low. */
    function laneKindRank(kind) {
      const index = PERC_LANE_KINDS.findIndex(([id]) => id === kind);
      return index === -1 ? PERC_LANE_KINDS.length : index;
    }

    /**
     * Where a lane of `kind` belongs in a top-down list: at the foot of its own
     * kind's group, which is what keeps HIGH kinds at the top however many
     * lanes a kit grows. The user may reorder freely afterwards — this only
     * decides where a NEW lane lands.
     */
    function laneInsertIndex(lanes, kind) {
      const rank = laneKindRank(kind);
      let index = 0;
      for (let i = 0; i < lanes.length; i++) {
        if (laneKindRank(lanes[i].kind) <= rank) index = i + 1;
      }
      return index;
    }

    function nextLaneId(lanes) {
      const taken = new Set(lanes.map((lane) => lane.id));
      for (let n = lanes.length + 1; ; n++) {
        const id = `lane${n}`;
        if (!taken.has(id)) return id;
      }
    }

    /**
     * Repair a stored lane list: known kinds, unique non-empty ids, a label
     * each, the cap enforced — and the three built-ins always present (they
     * are undeletable, so a save that lost one gets it back in its kind slot).
     * A built-in's kind is its id by definition (the lane called 'low' IS the
     * low voice), matching the engine's own sanitiser; only its NAME and its
     * place in the list are the user's.
     *
     * The engine numbers lanes with an `order` field and sorts by it; this
     * page uses array order (top-down, as rendered) and lets the engine derive
     * `order` from it. A list that arrived FROM the engine — a preset, a share
     * link — carries the field, so it is sorted by before being dropped.
     */
    function normalisePercLanes(raw) {
      const source = Array.isArray(raw) ? raw.filter(isPlainObject) : [];
      if (source.length && source.every((entry) => Number.isFinite(entry.order))) {
        source.sort((a, b) => a.order - b.order);
      }
      const lanes = [];
      const seen = new Set();
      for (const entry of source) {
        if (lanes.length >= PERC_MAX_LANES) break;
        const id = typeof entry.id === 'string' ? entry.id.trim().slice(0, 32) : '';
        if (!id || seen.has(id)) continue;
        const kind = PERC_BUILTIN_LANES.includes(id)
          ? id
          : PERC_LANE_KINDS.some(([k]) => k === entry.kind)
            ? entry.kind
            : PERC_NEW_LANE_KIND;
        const label =
          typeof entry.label === 'string' && entry.label.trim()
            ? entry.label.trim().slice(0, 32)
            : id;
        seen.add(id);
        lanes.push({ id, label, kind });
      }
      for (const [id, label] of PERC_LANE_KINDS) {
        if (seen.has(id)) continue;
        lanes.splice(laneInsertIndex(lanes, id), 0, { id, label, kind: id });
      }
      return lanes.slice(0, PERC_MAX_LANES);
    }

    /** A track's lane list, top-down; melodic tracks have exactly one. */
    function laneListFor(track, t) {
      if (!isPercussiveTrack(track)) return [{ key: null, label: null, kind: null }];
      const lanes = Array.isArray(t && t.lanes) ? t.lanes : defaultPercLanes();
      return lanes.map((lane) => ({ key: lane.id, label: lane.label, kind: lane.kind }));
    }
    const VARY_KEYS = [
      ['voice', 'Voice'],
      ['volume', 'Volume'],
      ['pitch', 'Pitch'],
      ['timing', 'Timing'],
      ['pan', 'Pan'],
    ];

    // Melodic lanes default all-on (gates nothing out); percussion lanes get
    // a sparse, musical starting pattern for the first flip to Manual.
    const SEQ_LANE_DEFAULT_ON = {
      melody: () => true,
      bass: () => true,
      arp: () => true,
      low: (i) => i % 4 === 0,
      mid: (i) => i % 8 === 4,
      high: (i) => i % 2 === 0,
    };

    function defaultLane(kind) {
      const on = SEQ_LANE_DEFAULT_ON[kind] || (() => true);
      return Array.from({ length: SEQ_SLOTS }, (_, i) => ({
        on: !!on(i),
        prob: 1,
        vmin: 0.5,
        vmax: 0.9,
      }));
    }

    function defaultVary() {
      // null = "follow this track's randomness" (the Auto detent).
      return { voice: null, volume: null, pitch: null, timing: null, pan: null };
    }

    /**
     * v21 per-track feel. `swing` (pulsed tracks) overrides the global groove
     * for this track alone; `density` (tuned tracks) scales its event rate on
     * top of complexity. null is the Auto detent on both — "follow the global
     * swing" / "let complexity decide" — which is why they default to null
     * rather than to a number that would freeze the engine's own choice.
     */
    function defaultFeel(track) {
      return {
        ...(SEQ_TRACKS.includes(track) ? { swing: null } : {}),
        ...(TUNED_TRACKS.includes(track) ? { density: null } : {}),
      };
    }

    // v14 Sequencer 2.0: a track owns a LIST of sequencers and picks between
    // them at each loop end (Markov transition weights). `sequencer` stays as
    // an alias of sequencers[0] so a pre-v14 engine still sees the one it
    // knows about.
    function defaultSequencer(track) {
      const steps = isPercussiveTrack(track)
        ? Object.fromEntries(defaultPercLanes().map((lane) => [lane.id, defaultLane(lane.kind)]))
        : defaultLane(track);
      return { mode: 'auto', weights: [1], steps };
    }

    // DEFAULTS carry only the SINGULAR sequencer: deepMerge keeps keys that
    // exist solely in the saved object, so a stored `sequencers` list
    // survives a merge, while a default-shaped list here would shadow (and
    // silently discard) a pre-v14 save's singular sequencer.
    // normaliseSequencerList() builds the list from whichever is present.
    function withSequencers(track) {
      return { sequencer: defaultSequencer(track) };
    }

    /**
     * v9/v14/v16 factory presets: curated starting points, composed across the
     * whole param space (tempo, key/mode, metre, structure, swing, which
     * tracks play and with what voice/level/randomness/dissonance). Each is a
     * PARTIAL params object — deepMerge fills the rest from DEFAULTS — and
     * loading one is an ordinary settings load, so everything stays editable
     * afterwards. Nothing here is locked or re-applied behind the user.
     *
     * v16: the set itself is resolved at BUILD time (src/data/factory-presets
     * .json, or the fallback module until it lands) and handed to the page in
     * the #factory-presets-data JSON payload — the same list src/pages/
     * [preset].astro built its routes from, so /[slug] can never name a preset
     * this gallery doesn't have. { slug, name, oneLiner, rationale, params }.
     */
    function readFactoryPresets() {
      try {
        const el = document.getElementById('factory-presets-data');
        const parsed = el ? JSON.parse(el.textContent) : null;
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    const FACTORY_PRESETS = readFactoryPresets();

    function factoryPresetBySlug(slug) {
      return FACTORY_PRESETS.find((preset) => preset.slug === slug) || null;
    }

    // ---- v26 genre transport ---------------------------------------------

    /**
     * The twelve genre files, resolved at BUILD time — Vite expands the glob,
     * so the data is in the page bundle: there is no fetch to fail, and the
     * list the dropdown shows is by construction the list `setGenreTable()`
     * registers with the engine.
     *
     * A genre is RULES, not a preset: `compileGenre(genre, { rng })` draws one
     * setup out of it (metre, mode, tempo, swing, chord grammar, kit, voices),
     * so the same genre twice is two different pieces. That is what the
     * fast-forward button spends, and what the fresh-load pick uses to stop
     * every first visit sounding identical.
     */
    const GENRES = Object.values(
      import.meta.glob('../data/genres/*.json', { eager: true, import: 'default' })
    )
      .filter((genre) => genre && typeof genre.slug === 'string')
      .sort((a, b) => String(a.name).localeCompare(String(b.name)));

    const GENRE_BY_SLUG = new Map(GENRES.map((genre) => [genre.slug, genre]));

    /**
     * The genres offered publicly. Everything else still EXISTS and still
     * compiles — a share link or a stored preset naming one plays exactly what
     * it always played — it simply is not on the menu.
     *
     * Owner, 2026-07-29: "Only keep ones that work now. I don't want to waste
     * time and tokens now on your fixing genre. Were there any I didn't insult
     * other than Synthwave? If not, just keep Synthwave on the list."
     *
     * Two survive that test, not one. Synthwave: "Good job with Synthwave [...]
     * I can listen to it for hours." Techno Tools: "I do actually quite like it
     * — the second most musical of your set", where the only reservation was
     * that its bass is repetitive, which he then said may simply be the genre.
     * Every other genre drew a criticism in his listening notes, so every other
     * genre is off the list until its own note is answered.
     */
    const PUBLIC_GENRE_SLUGS = new Set(['synthwave', 'techno-tools']);

    const HIDDEN_GENRES = new Set(
      GENRES.map((genre) => genre.slug).filter((slug) => !PUBLIC_GENRE_SLUGS.has(slug))
    );

    const PUBLIC_GENRES = GENRES.filter((genre) => !HIDDEN_GENRES.has(genre.slug));

    /**
     * Favourites group by MOOD, and the genre files' own `cluster` — the three
     * groups the music director wrote to — is the only grouping the data
     * carries. The LABELS are a UI decision, so they live here rather than in
     * the files; a cluster with no entry falls into "Other" instead of
     * vanishing from the list.
     */
    const MOODS = [
      { id: 'calm', label: 'Calm', cluster: 1 },
      { id: 'groove', label: 'Groove', cluster: 2 },
      { id: 'drive', label: 'Drive', cluster: 3 },
    ];
    const OTHER_MOOD = { id: 'other', label: 'Other', cluster: null };

    function moodOf(genre) {
      return MOODS.find((mood) => mood.cluster === genre.cluster) || OTHER_MOOD;
    }

    /**
     * The genres a FRESH visit may open on, and the weight a favourite carries
     * inside that pool. Not every genre is a good thing to arrive to unasked —
     * peak-time techno and a neon synthwave chase are choices, not defaults —
     * so the opening draw is made from the work-music end of the set. A
     * favourite that is also in this pool is drawn ten times as often as a
     * genre the listener has never marked.
     */
    // The genres a fresh visit may open on. Drawn from the public set — a
    // listener cannot be opened on a genre they cannot then find in the picker.
    const BACKGROUND_GENRES = ['synthwave', 'techno-tools'];
    const FAVOURITE_WEIGHT = 10;

    /**
     * mulberry32: the compiler takes an `rng`, and a seed the page holds is
     * what makes one setup reproducible — fast-forward is nothing more than
     * the same genre with the next seed.
     */
    function makeRng(seed) {
      let a = seed >>> 0;
      return function rng() {
        a = (a + 0x6d2b79f5) >>> 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function randomSeed() {
      return Math.floor(Math.random() * 0x100000000) >>> 0;
    }

    /** One weighted draw from a [{ value, weight }] pool; null when it's empty. */
    function weightedDraw(pool) {
      const total = pool.reduce((sum, entry) => sum + entry.weight, 0);
      if (!(total > 0)) return null;
      let roll = Math.random() * total;
      for (const entry of pool) {
        roll -= entry.weight;
        if (roll <= 0) return entry.value;
      }
      return pool[pool.length - 1].value;
    }

    // v12 mono/legato, mirroring the engine's own DEFAULT_TRACK_MONO/GLIDE:
    // the two melodic lines sound one note at a time and slur between them, a
    // chord and a kit do not. Held in settings so the pair is preset-captured
    // and persists — the engine would otherwise re-assert its defaults on a
    // reload and quietly undo the user's choice.
    const MONO_DEFAULTS = {
      pad: { mono: false, glide: 0 },
      arp: { mono: false, glide: 0 },
      melody: { mono: true, glide: 0.3 },
      bass: { mono: true, glide: 0.15 },
      texture: { mono: false, glide: 0 },
      percussion: { mono: false, glide: 0 },
    };

    /**
     * v23: what a track the page has never heard of starts at. A user track is
     * polyphonic and unslurred whatever its family — the mono/glide pairs above
     * are a per-built-in ruling about two specific lines, not a family rule.
     */
    const USER_MONO_DEFAULT = { mono: false, glide: 0 };
    const monoDefaultsFor = (id) => MONO_DEFAULTS[id] || USER_MONO_DEFAULT;

    /**
     * The settings entry a freshly made user track ships with, matching the
     * engine's own defaults for one (v23): it sounds at once (the user just
     * made it), at the built-in starting level, with no voice wander — the
     * pad/texture 0.15 is a built-in-specific ruling — and with the family's
     * grid, which for a kit is the three built-in lanes.
     */
    function defaultUserTrackSettings(entry) {
      const percussive = entry.family === 'percussive';
      return {
        state: 'on',
        voice: USER_VOICE_DEFAULTS[entry.voiceSet] || 'warm',
        level: 0.8,
        hold: false,
        randomness: 0.5,
        vary: defaultVary(),
        ...(percussive ? {} : { dissonance: 0 }),
        ...(percussive ? { lanes: defaultPercLanes() } : {}),
        ...USER_MONO_DEFAULT,
        swing: null,
        ...(percussive ? {} : { density: null }),
        sequencer: {
          mode: 'auto',
          weights: [1],
          steps: percussive
            ? Object.fromEntries(defaultPercLanes().map((lane) => [lane.id, defaultLane(lane.kind)]))
            : defaultLane(entry.id),
        },
      };
    }

    /** The voice each stock bank opens on — the engine's DEFAULT_TRACK_VOICES. */
    const USER_VOICE_DEFAULTS = {
      pad: 'warm',
      bass: 'sub',
      melody: 'pluck',
      texture: 'sparkle',
      arp: 'softPluck',
      percussion: 'soft',
    };

    const DEFAULTS = {
      swing: 0,
      complexity: 0.5,
      repetition: 0.5,
      volume: 0.8,
      root: 'C',
      mode: 'majorPentatonic',
      timeSignature: '4/4',
      bpm: 60,
      // v0.0.62: what this setup grew from — {kind:'genre', id, seed} or
      // {kind:'blank'}. A genre compile is deterministic in (id, seed), so
      // these two values rebuild the base exactly without carrying any of it.
      origin: { kind: 'blank' },
      structure: 'auto',
      customStructure: [
        { label: 'A', bars: 8, intensity: 0.4 },
        { label: 'B', bars: 8, intensity: 0.7 },
      ],
      // v21 chord length: how many bars the hook holds a chord for. 'auto'
      // needs no engine-read shipped value (unlike reverbTail) — it's the
      // contract's own documented default, so it's safe to bake in here.
      harmony: { rhythm: 'auto' },
      // v23: the ordered identity list of the user's own tracks. Absent/empty
      // means the built-in six and nothing else, which is every settings blob
      // written before this window.
      userTracks: [],
      arp: {
        mode: 'auto',
        pattern: 'up',
        rate: '1/8',
        octaves: 2,
        gate: 0.6,
        steps: new Array(16).fill(true),
      },
      tracks: {
        pad: {
          state: 'auto',
          voice: 'warm',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('pad'),
          ...MONO_DEFAULTS.pad,
        },
        arp: {
          state: 'auto',
          voice: 'softPluck',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('arp'),
          ...MONO_DEFAULTS.arp,
          ...withSequencers('arp'),
        },
        // v14 user verdict: melody joins the default mix ('auto'); bass stays
        // OFF until the groove rework passes the listener's own gate.
        melody: {
          state: 'auto',
          voice: 'pluck',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('melody'),
          ...MONO_DEFAULTS.melody,
          ...withSequencers('melody'),
        },
        bass: {
          state: 'off',
          voice: 'sub',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('bass'),
          ...MONO_DEFAULTS.bass,
          ...withSequencers('bass'),
        },
        texture: {
          state: 'auto',
          voice: 'sparkle',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          dissonance: 0,
          vary: defaultVary(),
          ...defaultFeel('texture'),
          ...MONO_DEFAULTS.texture,
        },
        percussion: {
          state: 'auto',
          voice: 'soft',
          level: 0.8,
          hold: false,
          randomness: 0.5,
          vary: defaultVary(),
          ...defaultFeel('percussion'),
          lanes: defaultPercLanes(),
          ...MONO_DEFAULTS.percussion,
          ...withSequencers('percussion'),
        },
      },
      patches: {},
      // `ui` is page-only state: stripped before anything reaches the engine
      // (engineParamsFrom) or a preset snapshot (paramsSnapshot).
      // scopeTracks null = "whichever tracks aren't off" (the live default);
      // an array is an explicit chip selection the user made.
      ui: {
        activeTab: 'simple',
        processor: 'auto',
        tutorialOpen: false,
        tutorialStep: 0,
        scopeOpen: true,
        scopeTracks: null,
        // v26 scope options; both only take effect where the scope module
        // and (for the total trace) the engine can honour them.
        scopeSpread: false,
        scopeTotal: false,
      },
    };

    // The v3 Patch schema's sections, in editor order. Anything else on a
    // patch object (v14 `perKind`) is state, not an editable section.
    const PATCH_SECTIONS = ['source', 'filter', 'adsr', 'sends'];

    // Used only when a voice doesn't export .defaults (older engine-voices).
    const FALLBACK_PATCH = {
      source: { osc1: 'sine', osc2: null, mix: 0.5, detune: 4, octave: 0 },
      filter: { type: 'lowpass', cutoff: 2000, q: 0.7, envAmount: 0.3 },
      adsr: { attack: 0.01, decay: 0.2, sustain: 0.7, release: 0.5 },
      sends: { reverb: 0.3, delay: 0.15 },
    };

    function isPlainObject(value) {
      return value !== null && typeof value === 'object' && !Array.isArray(value);
    }

    /**
     * Deep-merge `saved` over `defaults`; arrays are replaced wholesale.
     * Keys present only in `saved` are kept (needed for the sparse `patches`
     * map, whose keys aren't in DEFAULTS).
     */
    function deepMerge(defaults, saved) {
      if (Array.isArray(defaults)) {
        return Array.isArray(saved) ? saved : defaults;
      }
      if (isPlainObject(defaults)) {
        if (!isPlainObject(saved)) return structuredClone(defaults);
        const out = {};
        for (const key of Object.keys(defaults)) {
          out[key] = deepMerge(defaults[key], saved[key]);
        }
        for (const key of Object.keys(saved)) {
          if (!(key in out)) out[key] = structuredClone(saved[key]);
        }
        return out;
      }
      return saved === undefined ? defaults : saved;
    }

    // ---- v7 RangeValue (number | {min,max}) helpers ----------------------

    function isNumberOrRange(v) {
      return (
        (typeof v === 'number' && Number.isFinite(v)) ||
        (isPlainObject(v) && typeof v.min === 'number' && typeof v.max === 'number')
      );
    }

    /** Clamp/repair a RangeValue field over an arbitrary [lo,hi] domain;
     * falls back to `fallback` when `v` is neither a finite number nor a
     * valid {min,max} pair. The voice-patch fields (Hz, seconds, cents, Q)
     * that went rangeable in the v7 sweep live outside 0–1, hence the
     * explicit domain — normaliseRangeValue below is the 0–1 specialisation
     * used by the track-level fields (level, randomness, sequencer prob). */
    function sanitiseRangeValueIn(v, lo, hi, fallback) {
      if (typeof v === 'number' && Number.isFinite(v)) return clamp(v, lo, hi);
      if (isPlainObject(v) && Number.isFinite(v.min) && Number.isFinite(v.max)) {
        let min = clamp(v.min, lo, hi);
        let max = clamp(v.max, lo, hi);
        if (min > max) [min, max] = [max, min];
        return { min, max };
      }
      return fallback;
    }

    /** Clamp/repair a RangeValue field; falls back to `fallback` (a plain
     * number) when `v` is neither a finite number nor a {min,max} object. */
    function normaliseRangeValue(v, fallback) {
      return sanitiseRangeValueIn(v, 0, 1, fallback);
    }

    /** A v21 feel param: a number OR a drifting {min,max} in [lo,hi], or
     * null for the Auto detent ("follow the global swing" / "let complexity
     * decide the density"). AUDIT FIX: these have been rangeable since
     * v0.0.74 — the old number-only repair silently collapsed a saved
     * swing/density span back to the Auto detent on every load. */
    function nullableNumberIn(v, lo, hi) {
      return sanitiseRangeValueIn(v, lo, hi, null);
    }

    /** A representative plain number for a RangeValue field — used by
     * controls that stay single-value editors (sequencer prob keyboard
     * path, slider fallbacks) even though the field itself may hold a
     * drifting {min,max}. */
    function rangeMid(v) {
      return typeof v === 'number' ? v : (v.min + v.max) / 2;
    }

    /** Apply `fn` to a RangeValue's number(s), preserving its shape —
     * for rounding/clamping a knob's emitted number|{min,max} before it's
     * written into patch/settings state. */
    function mapRV(v, fn) {
      return isPlainObject(v) ? { min: fn(v.min), max: fn(v.max) } : fn(v);
    }

    // ---- sequencer step-prob range helpers (0–1 domain only) ------------
    // The step-prob keyboard/pointer editors stay single-value EDITORS (they
    // move one number: the midpoint), but must not silently collapse a
    // {min,max} loaded from a preset/older save — these keep the window's
    // width while sliding it, clamping/sliding at the 0–1 edges rather than
    // truncating the width there.

    function clampProbWindow(mid, width) {
      let min = mid - width / 2;
      let max = mid + width / 2;
      if (min < 0) {
        max -= min;
        min = 0;
      }
      if (max > 1) {
        min -= max - 1;
        max = 1;
      }
      return { min: clamp(min, 0, 1), max: clamp(max, 0, 1) };
    }

    /** Move a prob RangeValue's midpoint to `mid`, keeping its width; a
     * plain number just becomes `mid`. */
    function shiftRangeMid(v, mid) {
      mid = clamp(mid, 0, 1);
      if (!isPlainObject(v)) return mid;
      const width = clamp(v.max - v.min, 0, 1);
      return clampProbWindow(mid, width);
    }

    /** Widen/narrow a prob RangeValue by `delta` around its current
     * midpoint (splitting a plain number into a range on first widen);
     * narrowing to ~0 collapses back to a plain number. */
    function resizeRangeWidth(v, delta) {
      const isRange = isPlainObject(v);
      const width = isRange ? clamp(v.max - v.min, 0, 1) : 0;
      const mid = isRange ? clamp((v.min + v.max) / 2, 0, 1) : clamp(v, 0, 1);
      const nextWidth = clamp(width + delta, 0, 1);
      if (nextWidth <= 0.001) return mid;
      return clampProbWindow(mid, nextWidth);
    }

    // ---- v6 sequencer migration + normalisation -------------------------

    /**
     * Pre-v6 saves (and submitted presets) carry the arp step mask as 16
     * booleans in arp.steps with no tracks.arp.sequencer. Map them into the
     * new Step shape once, per the contract (on → prob 1, band 0.5–0.9);
     * slots 16–19 pad with "on" (the legacy default). Mutates `saved`.
     */
    function migrateLegacyArpSteps(saved) {
      if (!isPlainObject(saved)) return;
      const legacy =
        isPlainObject(saved.arp) && Array.isArray(saved.arp.steps) ? saved.arp.steps : null;
      if (!legacy) return;
      if (
        isPlainObject(saved.tracks) &&
        isPlainObject(saved.tracks.arp) &&
        isPlainObject(saved.tracks.arp.sequencer)
      ) {
        return; // already v6-shaped; the sequencer is the source of truth
      }
      const steps = Array.from({ length: SEQ_SLOTS }, (_, i) => ({
        on: i < legacy.length ? !!legacy[i] : true,
        prob: 1,
        vmin: 0.5,
        vmax: 0.9,
      }));
      if (!isPlainObject(saved.tracks)) saved.tracks = {};
      if (!isPlainObject(saved.tracks.arp)) saved.tracks.arp = {};
      saved.tracks.arp.sequencer = {
        mode: saved.arp.mode === 'manual' ? 'manual' : 'auto',
        steps,
      };
    }

    function normaliseLane(arr, kind) {
      const out = defaultLane(kind);
      if (!Array.isArray(arr)) return out;
      for (let i = 0; i < SEQ_SLOTS; i++) {
        const s = arr[i];
        if (typeof s === 'boolean') {
          out[i] = { on: s, prob: 1, vmin: 0.5, vmax: 0.9 };
          continue;
        }
        if (!isPlainObject(s)) continue;
        const num = (v, d) => (typeof v === 'number' && Number.isFinite(v) ? clamp(v, 0, 1) : d);
        // prob is rangeable (v7 addendum) — preserve a valid {min,max}
        // instead of collapsing it to the plain-number fallback. vmin/vmax
        // are NOT rangeable (a per-note velocity band already), so they
        // stay plain numbers via num().
        const step = { on: s.on === true, prob: normaliseRangeValue(s.prob, 1), vmin: num(s.vmin, 0.5), vmax: num(s.vmax, 0.9) };
        if (step.vmin > step.vmax) [step.vmin, step.vmax] = [step.vmax, step.vmin];
        // v14 tie/group are OPTIONAL: a step that never carried one keeps the
        // key absent, matching the engine's own sanitiser so a round-trip
        // through getParams() doesn't grow the payload.
        if (s.tie === true) step.tie = true;
        if (Number.isFinite(s.group) && s.group >= 0) step.group = Math.floor(s.group);
        // v21 gate is optional in the same way: absent means "however long the
        // engine plays this step by default", so an untouched step never grows
        // the key.
        if (Number.isFinite(s.gate)) step.gate = clamp(s.gate, SEQ_GATE_MIN, SEQ_GATE_MAX);
        // v0.0.109: a pinned pitch is the user's stated note — it round-trips.
        if (Number.isFinite(s.midi) && s.midi >= 0 && s.midi <= 127) step.midi = Math.round(s.midi);
        out[i] = step;
      }
      return out;
    }

    /** One sequencer of a track's list: mode + Markov transition weights +
     * lane(s). `weights` is padded/truncated to the list length by the caller.
     * `lanes` (percussion only) is the track's lane list — the step map is
     * keyed by lane id, so a lane the user added carries its own pattern and a
     * lane they removed takes its pattern with it. */
    function normaliseSequencer(seq, track, lanes) {
      const src = isPlainObject(seq) ? seq : {};
      const steps =
        lanes
          ? (() => {
              const raw = isPlainObject(src.steps) ? src.steps : {};
              const out = {};
              for (const lane of lanes) out[lane.id] = normaliseLane(raw[lane.id], lane.kind);
              return out;
            })()
          : normaliseLane(src.steps, track);
      const weights = Array.isArray(src.weights)
        ? src.weights.map((w) => (Number.isFinite(w) ? clamp(w, 0, 100) : 1))
        : [1];
      return { mode: src.mode === 'manual' ? 'manual' : 'auto', weights: weights.length ? weights : [1], steps };
    }

    /**
     * Rebuild a track's sequencer LIST. A pre-v14 save carries only the
     * singular `sequencer`; it becomes sequencers[0]. Afterwards `sequencer`
     * is re-pointed at sequencers[0] (the same object, as the engine does)
     * so every v6-era read/write path still works unchanged.
     */
    function normaliseSequencerList(t, track, percussive = isPercussiveTrack(track)) {
      const list = Array.isArray(t.sequencers) && t.sequencers.length
        ? t.sequencers
        : [isPlainObject(t.sequencer) ? t.sequencer : {}];
      // Passed in by the load path, which settles a track's family from the
      // settings object it is repairing — the live registry is not yet in step
      // with a preset that has only just arrived.
      const lanes = percussive ? (Array.isArray(t.lanes) ? t.lanes : defaultPercLanes()) : null;
      t.sequencers = list.slice(0, SEQ_MAX).map((seq) => normaliseSequencer(seq, track, lanes));
      const n = t.sequencers.length;
      for (const seq of t.sequencers) {
        seq.weights = Array.from({ length: n }, (unused, i) =>
          i < seq.weights.length ? seq.weights[i] : 1
        );
      }
      t.sequencer = t.sequencers[0];
    }

    /**
     * v23: repair `settings.userTracks` and make sure every surviving entry has
     * a track to go with it. The engine's own sanitiser is the authority — this
     * is the page's mirror of it, and it is deliberately the same shape and the
     * same tolerances, because a settings object that disagrees with the params
     * the engine accepts is a row with no track behind it.
     *
     * An entry that fails is dropped WHOLE, never coerced: its `tracks` entry
     * then orphans and goes with it, exactly as the engine drops the pair.
     */
    function normaliseUserTracks(s) {
      const source = Array.isArray(s.userTracks) ? s.userTracks : [];
      const taken = new Set();
      const out = [];
      for (const raw of source) {
        if (out.length >= USER_TRACK_MAX) break;
        if (!isPlainObject(raw)) continue;
        const id = typeof raw.id === 'string' ? raw.id : '';
        if (!USER_TRACK_ID_RE.test(id) || RESERVED_TRACK_IDS.includes(id) || taken.has(id)) continue;
        const family = raw.family === 'percussive' ? 'percussive' : raw.family === 'melodic' ? 'melodic' : null;
        const voiceSet = Object.prototype.hasOwnProperty.call(USER_VOICE_DEFAULTS, raw.voiceSet)
          ? raw.voiceSet : null;
        if (!family || !voiceSet) continue;
        if ((family === 'percussive') !== (voiceSet === 'percussion')) continue;
        const label = typeof raw.label === 'string' ? raw.label.trim().slice(0, USER_TRACK_LABEL_MAX) : '';
        if (!label) continue;
        taken.add(id);
        const entry = { id, label, family, voiceSet };
        entry.colourToken = typeof raw.colourToken === 'string' && /^--[a-z][a-z0-9-]{1,31}$/.test(raw.colourToken)
          ? raw.colourToken
          : `--track-user-${out.length + 1}`;
        // The manifest is JSON DATA the ENGINE owns the schema for. The page
        // carries it through untouched rather than re-validating it: two
        // sanitisers with one schema between them drift, and the engine's is
        // the one that decides what a manifest means.
        if (isPlainObject(raw.manifest)) entry.manifest = structuredClone(raw.manifest);
        out.push(entry);
      }
      s.userTracks = out;
      // Seed first, then drop: an entry with no track gets one built by the
      // same code path a built-in's is, and a `tracks` key naming no track at
      // all is an orphan and goes.
      const wanted = new Set([...TRACK_IDS, ...out.map((entry) => entry.id)]);
      for (const entry of out) {
        if (!isPlainObject(s.tracks[entry.id])) s.tracks[entry.id] = defaultUserTrackSettings(entry);
      }
      for (const key of Object.keys(s.tracks)) {
        if (!wanted.has(key)) delete s.tracks[key];
      }
      for (const key of Object.keys(s.patches || {})) {
        if (!wanted.has(key)) delete s.patches[key];
      }
      return out;
    }

    /**
     * Runs after every deepMerge over DEFAULTS: clamps the v6 track fields,
     * rebuilds step arrays as fresh 20-slot objects (also breaking any
     * aliasing of DEFAULTS' arrays), and re-derives the legacy arp.steps
     * boolean mirror from the arp sequencer's on-flags.
     */
    function normaliseV6Tracks(s) {
      s.swing = clamp(typeof s.swing === 'number' && Number.isFinite(s.swing) ? s.swing : 0, 0, 1);
      s.harmony = isPlainObject(s.harmony) ? s.harmony : {};
      s.harmony.rhythm = CHORD_LENGTHS.includes(s.harmony.rhythm) ? s.harmony.rhythm : 'auto';
      // v23: identity before anything keyed by it, exactly as the engine's own
      // sanitiser orders it — the surviving user tracks define the id set the
      // per-track repair below then runs over, and each one is seeded with a
      // full entry so no later reader meets a half-built track.
      const users = normaliseUserTracks(s);
      const userById = new Map(users.map((entry) => [entry.id, entry]));
      // Built-ins, then this SETTINGS OBJECT's user tracks — never the live
      // registry's. A preset that names none is a preset that removes them, and
      // repairing a track the incoming object does not have is how the load
      // path used to throw on `s.tracks[id].level`.
      const ids = [
        ...TRACK_IDS.filter((id) => !userById.has(id) && !isUserTrack(id)),
        ...users.map((entry) => entry.id),
      ];
      // Family, not id: a user track's dial set follows what it IS, and the
      // module lists seeded at build time cannot name a track made at runtime.
      const isPerc = (id) => (userById.has(id)
        ? userById.get(id).family === 'percussive'
        : isPercussiveTrack(id));
      const isTuned = (id) => (userById.has(id) ? !isPerc(id) : TUNED_TRACKS.includes(id));
      const isSequenced = (id) => (userById.has(id) ? true : SEQ_TRACKS.includes(id));
      for (const id of ids) {
        const t = s.tracks[id];
        // Belt and braces behind the id list above: repairing a track that is
        // not in this object at all is not something to do half of.
        if (!isPlainObject(t)) continue;
        t.level = normaliseRangeValue(t.level, 0.8);
        t.hold = t.hold === true;
        t.mono = t.mono === true;
        // AUDIT FIX (finding 38): glide has been RANGEABLE since v0.0.74 —
        // the old plain-number repair reset a saved glide span to the track
        // default on every single load.
        t.glide = normaliseRangeValue(t.glide, monoDefaultsFor(id).glide);
        // Rangeable (v7 addendum) — preserve a valid {min,max}; only a
        // genuinely invalid value falls back to the 0.5 default.
        t.randomness = normaliseRangeValue(t.randomness, 0.5);
        if (isTuned(id)) t.dissonance = normaliseRangeValue(t.dissonance, 0);
        else delete t.dissonance;
        // v21 feel params: null is a value here (the Auto detent), so an
        // absent/invalid entry becomes null rather than a number.
        if (isSequenced(id)) t.swing = nullableNumberIn(t.swing, 0, 1);
        else delete t.swing;
        // AUDIT FIX (critical 4): density follows the ENGINE's rule — every
        // track with an event rate takes one, and only the pad has none. The
        // old tuned-only predicate deleted the genre compiler's PERCUSSION
        // density here on every load, so a genre's kit density never reached
        // the engine at all.
        if (id !== 'pad') t.density = nullableNumberIn(t.density, 0, TRACK_DENSITY_MAX);
        else delete t.density;
        // v21 pad breath: no Auto detent (a plain 0-1 depth), and no baked
        // default here — an absent/invalid value is deleted so the control
        // falls back to the engine's own shipped depth when it builds.
        if (id === 'pad' && typeof t.padBreath === 'number' && Number.isFinite(t.padBreath)) {
          t.padBreath = clamp(t.padBreath, 0, 1);
        } else {
          delete t.padBreath;
        }
        const vary = isPlainObject(t.vary) ? t.vary : {};
        t.vary = defaultVary();
        for (const [key] of VARY_KEYS) {
          // Rangeable since v7 (the engine resolves vary.* through the same
          // per-bar walk as randomness), so a {min,max} must survive the load —
          // null stays null, which is the "follow Randomness" detent.
          t.vary[key] = sanitiseRangeValueIn(vary[key], 0, 1, null);
        }
      }
      // Lanes first: a kit's step map is keyed by lane id, so the list has to
      // be repaired before the sequencers that follow it are. Every percussive
      // track has its own set — nothing is shared with the built-in kit.
      for (const id of ids) {
        if (!isPlainObject(s.tracks[id])) continue;
        if (isPerc(id)) s.tracks[id].lanes = normalisePercLanes(s.tracks[id].lanes);
        else delete s.tracks[id].lanes;
      }
      for (const id of ids) {
        if (isSequenced(id) && isPlainObject(s.tracks[id])) {
          normaliseSequencerList(s.tracks[id], id, isPerc(id));
        }
      }
      // Legacy boolean mask follows the arp's FIRST sequencer (kept for older
      // engines and for the combined-complexity estimate).
      s.arp.steps = s.tracks.arp.sequencers[0].steps.slice(0, 16).map((st) => !!st.on);
    }

    // ---- tempo mapping (one tempo, two views) ---------------------------
    // Dial position t (0–1) is a log-mapped view of bpm 20–220
    // (commercially-proven extremes), 60 bpm at the dial centre, two log
    // segments hinged at the centre:
    //   t <= 0.5:  bpm = 20 * 3^(t/0.5)
    //   t >  0.5:  bpm = 60 * (220/60)^((t-0.5)/0.5)
    // The engine always receives { bpm, speed: 1 } — `speed` is deprecated
    // at the UI level per the v3 contract addendum.
    function bpmFromSpeedT(t) {
      return t <= 0.5
        ? 20 * Math.pow(3, t / 0.5)
        : 60 * Math.pow(220 / 60, (t - 0.5) / 0.5);
    }
    function speedTFromBpm(bpm) {
      return bpm <= 60
        ? 0.5 * (Math.log(bpm / 20) / Math.log(3))
        : 0.5 + 0.5 * (Math.log(bpm / 60) / Math.log(220 / 60));
    }

    function logToValue(t, min, max) {
      return min * Math.pow(max / min, t);
    }
    function valueToLog(v, min, max) {
      return Math.log(v / min) / Math.log(max / min);
    }

    function clamp(v, lo, hi) {
      return Math.min(hi, Math.max(lo, v));
    }

    // ---- oscillator shape model (v5 morph) ------------------------------
    // shape: 0 sine, 1 triangle, 2 sawtooth, 3 square; fractional = morph.
    // Legacy persisted patches (and older voice defaults) store strings in
    // osc1/osc2 — map them onto the dial.
    const SHAPE_NAMES = ['sine', 'triangle', 'sawtooth', 'square'];
    const SHAPE_LABELS = ['Sine', 'Tri', 'Saw', 'Sq'];
    const SHAPE_FROM_STRING = { sine: 0, triangle: 1, sawtooth: 2, square: 3 };

    // v12: mini waveform glyphs for the shape dials — inline SVG paths on a
    // 24×24 canvas, stroked in currentColor so they pick up the theme's
    // tick/text colour wherever they're placed (ring mark or readout).
    const SHAPE_GLYPH_PATHS = [
      // sine
      '<path d="M1 12 C4 3 8 3 12 12 C16 21 20 21 23 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
      // triangle
      '<path d="M1 12 L6.5 3 L12 12 L17.5 21 L23 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
      // sawtooth — one full cycle: two ramps, each ended by a truly vertical
      // drop (the old path trailed off mid-ramp with no closing edge).
      '<path d="M3 18 L12 6 L12 18 L21 6 L21 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
      // square — one full cycle: high half, drop, low half, rise. Exactly two
      // verticals (the old path opened on a third, at the left edge).
      '<path d="M3 6 L12 6 L12 18 L21 18 L21 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
    ];

    // v14: what each canonical mark sounds like, shown as an SVG <title> on
    // the mark glyph — a native tooltip that reaches AT as well, and needs no
    // knob.js change (markGlyphs markup is inserted verbatim).
    const SHAPE_MARK_HINTS = [
      'Sine — pure, no harmonics: the softest of the four.',
      'Triangle — odd harmonics, falling away fast: hollow and flute-like.',
      'Sawtooth — every harmonic: bright and brassy, the richest.',
      'Square — odd harmonics only: hollow but strong, clarinet-ish.',
    ];

    function shapeMarkGlyph(index) {
      return `<title>${SHAPE_MARK_HINTS[index]}</title>${SHAPE_GLYPH_PATHS[index]}`;
    }

    // Passed to knob.js's `markGlyphs`: one entry per canonical mark value.
    // The 24×24 paths are centred on the mark by the -12,-12 translate.
    const SHAPE_MARK_GLYPHS = Object.fromEntries(
      [0, 1, 2, 3].map((i) => [
        i,
        `<svg viewBox="0 0 24 24" width="12" height="12" x="-6" y="-6" overflow="visible">${shapeMarkGlyph(i)}</svg>`,
      ])
    );

    // ---- v14 live mini-waveform readout ---------------------------------
    // The shape dials used to print "Saw~Sq" and a pair of static icons. The
    // readout is now a tiny trace of the ACTUAL interpolated wave: the four
    // canonical shapes are crossfaded sample-by-sample, which is exactly
    // linear interpolation of their Fourier coefficients (the engine's own
    // morph), so what you see is the wave you get. Redrawn only when the
    // value changes — knob.js calls `glyph` from updateView, never on a timer.
    function canonicalWave(kind, phase) {
      switch (kind) {
        case 0:
          return Math.sin(2 * Math.PI * phase);
        case 1:
          // 0 at phase 0, +1 at a quarter, -1 at three quarters — in phase
          // with the sine above, so a morph between them never lurches.
          return 4 * Math.abs(phase - Math.floor(phase + 0.75) + 0.25) - 1;
        case 2:
          return 2 * (phase - Math.floor(phase + 0.5));
        default:
          return phase < 0.5 ? 1 : -1;
      }
    }

    function morphedWave(shape, phase) {
      const c = clamp(shape, 0, 3);
      const lo = Math.floor(c);
      const hi = Math.min(3, lo + 1);
      const t = c - lo;
      return canonicalWave(lo, phase) * (1 - t) + canonicalWave(hi, phase) * t;
    }

    const WAVE_W = 46;
    const WAVE_H = 18;
    const WAVE_SAMPLES = 64;

    function shapeGlyph(v) {
      const points = [];
      for (let i = 0; i <= WAVE_SAMPLES; i++) {
        const phase = i / WAVE_SAMPLES;
        const y = WAVE_H / 2 - morphedWave(v, phase) * (WAVE_H / 2 - 1.5);
        points.push(`${((phase * WAVE_W).toFixed(1))},${y.toFixed(1)}`);
      }
      return (
        `<svg class="wave-readout" viewBox="0 0 ${WAVE_W} ${WAVE_H}" width="${WAVE_W}" height="${WAVE_H}" aria-hidden="true">` +
        `<polyline points="${points.join(' ')}" fill="none" stroke="currentColor" stroke-width="1.5" ` +
        'stroke-linejoin="round" stroke-linecap="round"/></svg>'
      );
    }

    function readShape(source, n) {
      const shape = source[`shape${n}`];
      // v0.0.74: the morph is rangeable, so a stored {min,max} comes back as
      // one — collapsing it here is exactly the silent drop that made the
      // dial draw a span the engine had never been given.
      if (isPlainObject(shape) && Number.isFinite(shape.min) && Number.isFinite(shape.max)) {
        return { min: clamp(shape.min, 0, 3), max: clamp(shape.max, 0, 3) };
      }
      if (typeof shape === 'number' && Number.isFinite(shape)) return clamp(shape, 0, 3);
      if (typeof shape === 'string' && shape in SHAPE_FROM_STRING) {
        return SHAPE_FROM_STRING[shape];
      }
      const osc = source[`osc${n}`];
      if (typeof osc === 'string' && osc in SHAPE_FROM_STRING) return SHAPE_FROM_STRING[osc];
      return null;
    }

    // Write both key families: shape1/shape2 numbers are authoritative for a
    // v5 engine/voices build; nearest-string osc1/osc2 keeps an older build
    // (or a not-yet-updated sanitiser) honouring the edit.
    function writeShape(source, n, value) {
      if (value === null) {
        source[`shape${n}`] = null;
        source[`osc${n}`] = null;
        return;
      }
      const v = mapRV(value, (x) => clamp(x, 0, 3));
      source[`shape${n}`] = v;
      // The legacy osc name is a single enum and cannot hold a span, so it
      // takes the middle of one. shape1/shape2 stay authoritative on any
      // build that understands them; this only matters to an older engine.
      source[`osc${n}`] = SHAPE_NAMES[Math.round(rangeMid(v))];
    }

    // ---- v12/v18 detune dial --------------------------------------------
    // Bipolar where the engine takes it (probed at boot): the same 50 cents
    // flat as sharp, with a centre detent so "in tune" is findable by feel.
    const DETUNE_MAX = 50;
    const DETUNE_DETENT = 1; // cents swallowed either side of zero

    function detuneFormat(v, bipolar) {
      const n = Math.round(v);
      if (!bipolar) return `${n} ct`;
      if (n === 0) return 'In tune';
      return `${n > 0 ? '+' : ''}${n} ct`;
    }

    // ---- v11 share links, tier 1 (fragment, no server) -------------------
    // A share link carries PARAMS ONLY — never user code (v10 hard rule). The
    // payload is JSON → UTF-8 → base64url in the URL fragment: fragments are
    // never sent to the server, so the preset only ever exists between the two
    // people holding the link. No compression: a full settings snapshot is a
    // few KB, which every browser and messaging app handles as a URL.
    const SHARE_BASE = 'https://ambi4.work/';
    const SHARE_PARAM = 'p';

    // v29: every link also gets a three-word name — a handle for a wall of
    // base64, computed from the fragment itself so both ends of the link read
    // the same three words without anything being registered anywhere. The
    // arithmetic is a module (src/scripts/share-name.js) so a test can prove
    // the determinism; the wordlist is the vetted one, bundled at build time
    // because the name has to be on screen the moment a link is copied.
    // DISPLAY ONLY: ambi4.work/[name] is the paid ladder, not this.
    const SHARE_WORDS = wordPoolFrom(WORDLIST);

    /**
     * The fragment payload the current visit arrived on (empty on an ordinary
     * visit). Recorded by takeSharedParams as it strips the fragment, because
     * by the time the page has settings to show a note about, the URL it came
     * in on is gone.
     */
    let arrivedSharePayload = '';

    /**
     * Share-payload schema version (v0.0.35).
     *
     * Links shipped from v0.0.33 onward carry the raw settings tree with NO
     * version field, so an old client meeting a newer link silently drops the
     * keys it does not know and plays a different piece — under the right
     * three-word name, because the name is a hash of the payload bytes. Silent
     * divergence with a matching identity is the worst failure a serverless
     * share scheme can have, and every day of links minted without a version
     * makes it costlier to fix.
     *
     * Absent `v` means a pre-v0.0.35 link and is read as version 0: the shape
     * is identical, so those links keep working untouched. A HIGHER `v` than
     * this build knows means the link came from a newer Ambi4 — we still load
     * it best-effort, but the arrival note says so rather than pretending.
     *
     * Adding the field changes the payload bytes, so the same settings now
     * produce different words than they did before this version. That churn is
     * one-time and unavoidable; taking it now is the cheapest it will ever be.
     */
    const SHARE_SCHEMA = 1;
    const SHARE_VERSION_KEY = 'v';

    /** True when the link this visit arrived on was minted by a newer build. */
    let arrivedFromNewerBuild = false;

    /**
     * v0.0.79 — a share link is a base plus a diff, exactly as a submission
     * has been since v0.0.62.
     *
     * His note: "share links should use the same base-and-diff. They still
     * base64 the whole tree into the fragment, which is the same fault in a
     * place that has not bitten yet — a fragment is not sent to a server, so
     * it fails later and quieter (a link too long to paste into a chat
     * window)."
     *
     * The compact payload is `{ o: origin, d: diff }`. Everything else — the
     * schema version, the word-name hashing, the arrival note — is unchanged,
     * and a payload WITHOUT `o`/`d` is still read as a whole tree. That last
     * clause is permanent, not transitional: every link already in the wild
     * carries the full tree and must keep working forever.
     */
    const SHARE_ORIGIN_KEY = 'o';
    const SHARE_DIFF_KEY = 'd';

    const isCompactShare = (parsed) =>
      isPlainObject(parsed) && isPlainObject(parsed[SHARE_ORIGIN_KEY]) && SHARE_DIFF_KEY in parsed;

    function encodeShareParams(params) {
      const payload = { ...params, [SHARE_VERSION_KEY]: SHARE_SCHEMA };
      const bytes = new TextEncoder().encode(JSON.stringify(payload));
      let binary = '';
      for (const b of bytes) binary += String.fromCharCode(b);
      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function decodeShareParams(value) {
      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
      const binary = atob(base64 + '='.repeat((4 - (base64.length % 4)) % 4));
      const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
      const parsed = JSON.parse(new TextDecoder().decode(bytes));
      if (!isPlainObject(parsed)) return null;
      // The version is metadata about the link, not a setting — read it, then
      // take it out so it can never reach the settings tree or the sanitiser.
      const raw = parsed[SHARE_VERSION_KEY];
      const version = Number.isFinite(Number(raw)) ? Number(raw) : 0;
      delete parsed[SHARE_VERSION_KEY];
      arrivedFromNewerBuild = version > SHARE_SCHEMA;
      return parsed;
    }

    /**
     * Read a `#p=…` share fragment, then strip it from the URL either way
     * (history.replaceState — a reload must not re-apply a preset the user has
     * since edited). Anything malformed is ignored SILENTLY: a truncated link
     * pasted into a chat window is not an error worth shouting about, and the
     * page simply boots on the stored settings instead.
     */
    function takeSharedParams() {
      try {
        const hash = String(location.hash || '').replace(/^#/, '');
        if (!hash) return null;
        const value = new URLSearchParams(hash).get(SHARE_PARAM);
        try {
          history.replaceState(null, '', location.pathname + location.search);
        } catch {}
        if (!value) return null;
        const params = decodeShareParams(value);
        if (params) arrivedSharePayload = value;
        return params;
      } catch {
        return null;
      }
    }

    // ---- v16 preset routes (/[slug]) -------------------------------------
    // src/pages/[preset].astro is a static shell per factory-preset slug: it
    // writes the slug into this sessionStorage key and location.replace('/')s
    // here. Only the SLUG travels — the params are looked up in the list this
    // page already holds, so the route can never carry a stale copy of a
    // preset. Taking it CONSUMES it (a later reload of / is the user's own
    // session, not the link's), and the lookup runs before any dial is built,
    // exactly like the #p= path above.
    const ROUTE_PRESET_KEY = 'ambi4:route-preset';

    function takeRoutePreset() {
      let slug = null;
      try {
        slug = sessionStorage.getItem(ROUTE_PRESET_KEY);
        sessionStorage.removeItem(ROUTE_PRESET_KEY);
      } catch {
        return null;
      }
      return slug ? factoryPresetBySlug(slug) : null;
    }

    async function loadPrefsModule() {
      try {
        const mod = await import('../scripts/prefs.js');
        if (mod && mod.prefs && typeof mod.prefs.get === 'function') {
          return { prefs: mod.prefs, consentPrompt: mod.consentPrompt };
        }
      } catch {
        // fall through to the session-memory shim
      }
      // prefs.js missing or broken: degrade to session-memory settings.
      const mem = new Map();
      return {
        prefs: {
          consent: () => 'denied',
          setConsent: () => {},
          get: (k) => (mem.has(k) ? structuredClone(mem.get(k)) : null),
          set: (k, v) => {
            mem.set(k, structuredClone(v));
            return false;
          },
          remove: (k) => {
            mem.delete(k);
          },
        },
        consentPrompt: async () => false,
      };
    }

    async function init() {
      if (typeof window.AudioContext === 'undefined' && typeof window.webkitAudioContext === 'undefined') {
        unavailable.hidden = false;
        return;
      }

      let createEngine;
      // v18: the page probes the engine's own patch sanitiser for the fields
      // it wants to offer dials for (percussion source.pitch / source.noise).
      // Absent on an older engine build, hence the separate binding.
      let sanitiseParams = null;
      // The whole module, because the track registry is read from its exports
      // (TUNED_TRACKS / SEQUENCED_TRACKS) as well as from the engine handle.
      let engineModule;
      try {
        engineModule = await import('../scripts/ambient-engine.js');
        ({ createEngine, sanitiseParams } = engineModule);
      } catch {
        unavailable.hidden = false;
        return;
      }

      const engine = createEngine();
      // v0.0.69: a deliberate test seam, not a leak. The engine is AGPL and
      // runs entirely in the reader's own browser, so nothing here is hidden
      // from anyone who opens the source — and without it the OUTPUT LEVEL is
      // unmeasurable from outside, which is precisely how the mix came to sit
      // thirty decibels below every other thing a listener plays without
      // anyone noticing. tests/loudness-drive.mjs is the reason it exists.
      if (typeof window !== 'undefined') window.__ambi4Engine = engine;

      // ---- v21 track registry -------------------------------------------
      // Probed like every other capability, and for the same reason: an
      // engine bundle without getTracks() would otherwise leave every row,
      // editor and lane with nothing to build from. Where it answers, its
      // list wins outright — ids, order and labels; where it doesn't, the
      // FALLBACK_TRACKS views seeded at module scope stay in force.
      const registryTracks =
        typeof engine.getTracks === 'function' ? engine.getTracks() : null;
      const hasTrackRegistry = Array.isArray(registryTracks) && registryTracks.length > 0;
      if (hasTrackRegistry) {
        ({ TRACK_IDS, TRACK_LABELS, TRACK_FAMILY, TUNED_TRACKS, SEQ_TRACKS, SEQ_SINGLE_TRACKS } =
          trackListsFrom(registryTracks, engineModule));
      }

      /**
       * Re-derive every track view from the engine's live registry, and with it
       * the page's own user-track list. ONE derivation: the registry answers
       * which tracks exist and in what order, and `settings.userTracks` (the
       * thing that persists and travels) is read only for the fields the public
       * five-key view deliberately does not carry. It is passed IN rather than
       * read from the closure: `settings` is a `let` assigned further down, and
       * a temporal-dead-zone read is the shipped blank-page bug.
       */
      function syncTrackViews(storedUserTracks) {
        const live = typeof engine.getTracks === 'function' ? engine.getTracks() : null;
        if (!Array.isArray(live) || !live.length) return;
        ({ TRACK_IDS, TRACK_LABELS, TRACK_FAMILY, TUNED_TRACKS, SEQ_TRACKS, SEQ_SINGLE_TRACKS } =
          trackListsFrom(live, engineModule));
        const stored = new Map(
          (Array.isArray(storedUserTracks) ? storedUserTracks : []).map((e) => [e.id, e])
        );
        USER_TRACKS = live
          .filter((track) => track.builtin === false)
          .map((track) => ({
            id: track.id,
            label: track.label,
            family: track.family === 'percussive' ? 'percussive' : 'melodic',
            // The bank is not in the public view (identity and presentation
            // only), so it comes from the stored entry, and from the family
            // when there is none — a kit plays the kit.
            voiceSet: stored.get(track.id)?.voiceSet
              ?? (track.family === 'percussive' ? 'percussion' : 'pad'),
            colourToken: track.colourToken,
          }));
        USER_TRACK_BY_ID = new Map(USER_TRACKS.map((entry) => [entry.id, entry]));
      }

      // ---- v6 capability detection --------------------------------------
      // Gating choice: the new params (hold / randomness / vary / sequencer)
      // are always SENT — the engine sanitiser drops unknown keys safely, so
      // a pre-v6 engine just ignores them and they still persist for later.
      // But controls the user could see doing nothing are only RENDERED when
      // the engine advertises support: getParams() exposing the field, and
      // randomise being a function. Exception: the arp step grid always
      // renders, because its on/off flags degrade gracefully to the legacy
      // arp.steps boolean mask that every v2+ engine honours.
      const engineCaps = {
        trackRegistry: hasTrackRegistry,
        randomise: typeof engine.randomise === 'function',
        getResolved: typeof engine.getResolved === 'function',
        getStats: typeof engine.getStats === 'function',
        setPowerBudget: typeof engine.setPowerBudget === 'function',
        // v23: the Add Track surface renders only where the engine can answer
        // BOTH questions — may I, and do it. A control that is present but does
        // nothing is the bug the probe exists to prevent.
        addTrack: typeof engine.canAddTrack === 'function' && typeof engine.addTrack === 'function',
        // v28: the listener's own hands. Two probes, because the two halves
        // ship independently — an engine can sound live notes without being
        // able to record them into a lane.
        playAlong: typeof engine.noteOn === 'function' && typeof engine.noteOff === 'function',
        capture: typeof engine.armCapture === 'function'
          && typeof engine.stopCapture === 'function'
          && typeof engine.undoCapture === 'function'
          && typeof engine.getCapture === 'function',
        removeTrack: typeof engine.removeTrack === 'function',
        trackManifest: typeof engine.getTrackManifest === 'function',
        swing: false,
        patchPitch: false,
        patchNoise: false,
        patchNoiseRange: false,
        patchSculpt: false,
        patchCall: false,
        patchV19Range: false,
        patchFold: false,
        // v21: a global reverb-tail length, and the setter the power governor
        // caps it through. Either one alone is enough to drive the dial.
        reverbTail: false,
        setReverbSeconds: typeof engine.setReverbSeconds === 'function',
        // v21: user-addable percussion lanes, per-step note length, and the
        // bipolar detune the v12 round had to leave unipolar. All three are
        // sanitiser probes (below), not version guesses.
        percussionLanes: false,
        stepGate: false,
        stepPitch: false,
        patchDetuneBipolar: false,
        randomness: {},
        dissonance: {},
        vary: {},
        sequencer: {},
        sequencers: {},
        level: {},
        mono: {},
        glide: {},
        driftRate: {},
        driftShape: {},
        trackSwing: {},
        trackDensity: {},
      };
      // The engine's own starting reverb tail — the dial's default and its
      // opening value, so the page never invents a length the engine disagrees
      // with. Null until an engine ships the param.
      let engineReverbTail = null;
      try {
        const p = engine.getParams() || {};
        engineCaps.swing = typeof p.swing === 'number';
        engineCaps.reverbTail = typeof p.reverbTail === 'number';
        if (engineCaps.reverbTail) engineReverbTail = clamp(p.reverbTail, 0.5, 6);
        for (const id of TRACK_IDS) probeTrackCaps(id, p);
      } catch {}

      /**
       * Fill in one track's per-field capability entries from what the engine's
       * own params actually carry for it. Extracted from the boot loop so a
       * track made at RUNTIME is probed by the identical code — a user track
       * whose caps were never filled in is a row with no level knob and no
       * sequencer, which looks exactly like an engine that cannot do either.
       */
      function probeTrackCaps(id, params = null) {
        let p = params;
        if (!p) {
          try {
            p = engine.getParams() || {};
          } catch {
            return;
          }
        }
        const t = isPlainObject(p.tracks) ? p.tracks : {};
        const entry = isPlainObject(t[id]) ? t[id] : {};
        // Accept a plain {min,max} RangeValue too (v7), not just a bare
        // number — a range-shipping engine must not make the knob vanish.
        engineCaps.randomness[id] = isNumberOrRange(entry.randomness);
        engineCaps.dissonance[id] = isNumberOrRange(entry.dissonance);
        engineCaps.vary[id] = isPlainObject(entry.vary);
        engineCaps.sequencer[id] = isPlainObject(entry.sequencer);
        engineCaps.sequencers[id] = Array.isArray(entry.sequencers);
        engineCaps.level[id] = isNumberOrRange(entry.level);
        // v12 mono/legato and v21 driftRate: all three are plain scalars
        // engine-side (never RangeValues), so the probe is a type check.
        engineCaps.mono[id] = typeof entry.mono === 'boolean';
        engineCaps.glide[id] = typeof entry.glide === 'number';
        engineCaps.driftRate[id] = typeof entry.driftRate === 'number';
        // v0.0.72: does this engine know what a spread should DO between its
        // ends? Probed by round-trip, not by presence — an engine that ignores
        // the key returns its own default, which reads as acceptance.
        engineCaps.driftShape[id] = (() => {
          try {
            const probed = sanitiseParams({ tracks: { [id]: { driftShape: 'rise' } } });
            return probed?.tracks?.[id]?.driftShape === 'rise';
            // (the per-shape check below decides which OPTIONS are offered)
          } catch {
            return false;
          }
        })();
      }

      // v18 patch-schema probe: percussion trades its 3-position Octave switch
      // for a continuous Pitch dial and gains a Noise dial, but ONLY once the
      // engine's PATCH_SCHEMA accepts those fields — a dial writing a key the
      // sanitiser drops is a dial that does nothing. sanitiseParams is a pure
      // function, so the probe runs a throwaway patch through the very code
      // path a real edit would take (rather than trusting a version number),
      // and asks the same question of the {min,max} form for rangeability.
      function probePatchSource(source) {
        if (typeof sanitiseParams !== 'function') return null;
        try {
          const probed = sanitiseParams({ patches: { percussion: { __probe: { source } } } });
          const bank = probed && isPlainObject(probed.patches) ? probed.patches.percussion : null;
          const patch = bank && isPlainObject(bank.__probe) ? bank.__probe : null;
          return patch && isPlainObject(patch.source) ? patch.source : null;
        } catch {
          return null;
        }
      }
      {
        const plain = probePatchSource({ pitch: 7, noise: 0.5 }) || {};
        const ranged = probePatchSource({ noise: { min: 0.2, max: 0.6 } }) || {};
        engineCaps.patchPitch = typeof plain.pitch === 'number';
        engineCaps.patchNoise = isNumberOrRange(plain.noise);
        engineCaps.patchNoiseRange = isPlainObject(ranged.noise);
        // v19 sculpting / call synthesis and the v20 wavefolder ride the same
        // schema probe: a voice may declare the dials in its `controls` before
        // the engine's sanitiser accepts them, and a dial whose value is
        // dropped on the way to play() is a dial that does nothing. One
        // representative field per family answers for the whole family — they
        // land in PATCH_SCHEMA as one block.
        const v19 = probePatchSource({ tilt: 0.25, cadence: 2, fold: 0.5 }) || {};
        const v19Ranged = probePatchSource({ tilt: { min: -0.5, max: 0.5 } }) || {};
        engineCaps.patchSculpt = typeof v19.tilt === 'number';
        engineCaps.patchCall = typeof v19.cadence === 'number';
        engineCaps.patchFold = isNumberOrRange(v19.fold);
        engineCaps.patchV19Range = isPlainObject(v19Ranged.tilt);
        // v12 left detune unipolar because the sanitiser clamped to [0,50];
        // it has taken -50..50 since v18, so the dial goes bipolar the moment
        // the probe says a negative value survives — and stays unipolar (no
        // silently-clamped half) where it doesn't.
        const bipolar = probePatchSource({ detune: -25 }) || {};
        engineCaps.patchDetuneBipolar = bipolar.detune === -25;
      }

      // v21 track-param probes. Same reasoning as the patch probe above: these
      // ship as UI in the same wave as the engine work, so nothing here may
      // trust a version — each control asks the sanitiser whether the value it
      // would write actually survives.
      function probeTracks(partial) {
        if (typeof sanitiseParams !== 'function') return null;
        try {
          const probed = sanitiseParams({ tracks: partial });
          return probed && isPlainObject(probed.tracks) ? probed.tracks : null;
        } catch {
          return null;
        }
      }

      /** The same question at the TOP level, for a global param. */
      function probeParams(partial) {
        if (typeof sanitiseParams !== 'function') return null;
        try {
          const probed = sanitiseParams(partial);
          return isPlainObject(probed) ? probed : null;
        } catch {
          return null;
        }
      }
      {
        // Dynamic percussion lanes: the question is not "is there a lanes key"
        // but "does a lane I invented come back", since a lane the engine
        // discards is a lane whose steps never sound.
        const PROBE_LANE = '__probe';
        const lanesProbe = probeTracks({
          percussion: {
            lanes: [
              ...defaultPercLanes(),
              { id: PROBE_LANE, label: 'Lane 4', kind: PERC_NEW_LANE_KIND },
            ],
          },
        });
        const lanes = lanesProbe && isPlainObject(lanesProbe.percussion)
          ? lanesProbe.percussion.lanes
          : null;
        engineCaps.percussionLanes =
          Array.isArray(lanes) && lanes.some((lane) => isPlainObject(lane) && lane.id === PROBE_LANE);

        // Per-step note length, probed on a melodic lane (the only place the
        // page offers the third axis).
        const gateProbe = probeTracks({ melody: { sequencer: { steps: [{ on: true, gate: 1.5 }] } } });
        const probedStep =
          gateProbe && isPlainObject(gateProbe.melody) && isPlainObject(gateProbe.melody.sequencer)
            ? (gateProbe.melody.sequencer.steps || [])[0]
            : null;
        engineCaps.stepGate = isPlainObject(probedStep) && probedStep.gate === 1.5;

        // v0.0.111: the per-step pitch pin (v0.0.109 schema), probed the same way.
        const pitchProbe = probeTracks({ melody: { sequencer: { steps: [{ on: true, midi: 72 }] } } });
        const probedPitch =
          pitchProbe && isPlainObject(pitchProbe.melody) && isPlainObject(pitchProbe.melody.sequencer)
            ? (pitchProbe.melody.sequencer.steps || [])[0]
            : null;
        engineCaps.stepPitch = isPlainObject(probedPitch) && probedPitch.midi === 72;

        // v0.0.131: the per-track editing resolution (his ×2/÷2 ladder). The
        // control ships only where the sanitiser really keeps the value AND
        // sizes the lane to it — a resolution the engine drops would be a
        // control that redraws the grid over steps that never sound.
        engineCaps.stepResolution = false;
        {
          const probed = probeTracks({ melody: { stepBeats: 0.125 } });
          const lane = probed && isPlainObject(probed.melody) && probed.melody.sequencer
            ? probed.melody.sequencer.steps
            : null;
          engineCaps.stepResolution = !!probed
            && isPlainObject(probed.melody)
            && probed.melody.stepBeats === 0.125
            && Array.isArray(lane)
            && lane.length === 40;
        }

        // v0.0.137: the triplet ladder (the one division his ×2/÷2 pair cannot
        // reach). Probed separately from the straight ladder, so a build whose
        // engine knows only halving still ships the ×2/÷2 pair and simply hides
        // the Triplets button rather than offering a feel it cannot store.
        engineCaps.stepTriplets = false;
        {
          const probed = probeTracks({ melody: { stepBeats: 1 / 3 } });
          const lane = probed && isPlainObject(probed.melody) && probed.melody.sequencer
            ? probed.melody.sequencer.steps
            : null;
          engineCaps.stepTriplets = !!probed
            && isPlainObject(probed.melody)
            && Math.abs(probed.melody.stepBeats - 1 / 3) < 1e-9
            && Array.isArray(lane)
            && lane.length === 15;
        }

        // v0.0.116: chain advance for the sequencer list.
        const chainProbe = probeTracks({ melody: { sequencerAdvance: 'chain' } });
        engineCaps.chainMode =
          chainProbe && isPlainObject(chainProbe.melody) && chainProbe.melody.sequencerAdvance === 'chain';

        // Per-track swing/density. Both carry an Auto detent that writes null,
        // so a build that takes the number but not the null would give the
        // detent nothing to mean — hence both halves are probed, and the
        // control ships only when the pair survives.
        const numbers = probeTracks(
          Object.fromEntries(TRACK_IDS.map((id) => [id, { swing: 0.5, density: 1.5 }]))
        );
        const nulls = probeTracks(
          Object.fromEntries(TRACK_IDS.map((id) => [id, { swing: null, density: null }]))
        );
        for (const id of TRACK_IDS) {
          const num = numbers && isPlainObject(numbers[id]) ? numbers[id] : {};
          const nul = nulls && isPlainObject(nulls[id]) ? nulls[id] : {};
          engineCaps.trackSwing[id] = num.swing === 0.5 && nul.swing === null;
          engineCaps.trackDensity[id] = num.density === 1.5 && nul.density === null;
        }
      }

      // Iteration 4: three more modes, harmony.rhythm (chord length) and the
      // pad's breath depth — all landing in the engine THIS iteration, so
      // none of the three trusts a version number. A mode name the sanitiser
      // doesn't recognise silently falls back to whatever mode it started
      // from, hence "does the candidate come back unchanged" rather than
      // "did the call not throw".
      // v0.0.57: probe EVERY scale the markup offers, not a hand-kept list of
      // "the new ones". The build-time list is now the source of truth and the
      // probe prunes it, which is the only arrangement that cannot drift —
      // the old shape (markup holds some, a literal appends others) had
      // already started duplicating options as soon as the markup grew.
      engineCaps.modes = {};
      for (const option of document.querySelectorAll('#mode option')) {
        const id = option.value;
        try {
          const probed = sanitiseParams({ mode: id });
          engineCaps.modes[id] = !!probed && probed.mode === id;
        } catch {
          engineCaps.modes[id] = false;
        }
      }

      // harmony.rhythm: 'auto'|1|2|4|8 bars-per-chord. 'auto' would also be
      // the sanitiser's own fallback for a field it doesn't know, so the
      // probe uses a non-default candidate — only a real echo proves it.
      engineCaps.harmonyRhythm = false;
      try {
        const probed = sanitiseParams({ harmony: { rhythm: 4 } });
        engineCaps.harmonyRhythm = isPlainObject(probed?.harmony) && probed.harmony.rhythm === 4;
      } catch {}

      // v0.0.68: does this engine accept a hand-written chord loop? Probed the
      // same way as everything else — a candidate that comes back UNCHANGED,
      // never "the call did not throw", because the seed law keeps the stored
      // value for anything it cannot use, which is indistinguishable from
      // acceptance if you only check for an exception.
      engineCaps.harmonySeed = false;
      try {
        const probed = sanitiseParams({ mode: 'aeolian', harmony: { seed: ['i', 'VI', 'III', 'VII'] } });
        const seed = probed?.harmony?.seed;
        engineCaps.harmonySeed = Array.isArray(seed) && seed.length === 4
          && seed[0] && seed[0].degree === 0 && seed[1].degree === 5;
      } catch {}

      // Pad breath depth (0-1): scoped to the pad track's own params, the
      // same shape as driftRate/mono/glide. The page never invents a
      // starting depth — like reverbTail, it reads the engine's own once the
      // probe confirms the field survives.
      // AUDIT FIX (major): padBreath is a GLOBAL param in the engine, not a
      // per-track one — the page had probed `tracks.pad.padBreath` since
      // v0.0.23, so the probe was permanently false and the Breath dial never
      // rendered at all (and page-boot's assertion about it was dead code
      // behind the same false gate).
      engineCaps.padBreath = false;
      let enginePadBreath = null;
      {
        const probed = probeParams({ padBreath: 0.4 });
        engineCaps.padBreath = isPlainObject(probed) && probed.padBreath === 0.4;
      }
      if (engineCaps.padBreath) {
        try {
          const p = engine.getParams() || {};
          if (typeof p.padBreath === 'number') {
            enginePadBreath = clamp(p.padBreath, 0, 1);
          }
        } catch {}
      }

      const { prefs, consentPrompt } = await loadPrefsModule();

      // ---- v26 genre compiler + registry --------------------------------
      // The compiler runs PAGE-side (contract § v26 genre compiler): it turns
      // one genre file into a full params object the engine takes through its
      // ordinary setParams, so the engine ships no genre data and no genre
      // behaviour. Loaded like every other optional module — a build without
      // it simply has no genre picker, rather than no page.
      let genreCompiler = null;
      if (GENRES.length) {
        try {
          const mod = await import('../scripts/genre-compiler.js');
          if (typeof mod.compileGenre === 'function') genreCompiler = mod;
        } catch {
          // no compiler → the genre row hides itself below
        }
        // The engine's table is the page's list: with it registered, a slug
        // arriving from a share link is checked against the genres that
        // actually exist rather than kept as an opaque tag.
        if (typeof engine.setGenreTable === 'function') {
          try {
            engine.setGenreTable(GENRES);
          } catch {}
        }
      }

      /**
       * Favourites, their hide-the-rest toggle, and whether the listener has
       * been through the picker once (which is what turns "Choose favourites…"
       * into "Edit favourites…"). Persisted through prefs like the presets
       * list, so it survives a reload only where consent was granted.
       */
      let genrePrefs = { favourites: [], hideOthers: false, picked: false };
      try {
        const stored = prefs.get('genre');
        if (isPlainObject(stored)) {
          genrePrefs = {
            favourites: (Array.isArray(stored.favourites) ? stored.favourites : []).filter(
              (slug) => GENRE_BY_SLUG.has(slug)
            ),
            hideOthers: stored.hideOthers === true,
            picked: stored.picked === true,
          };
        }
      } catch {}

      /** The genres a fresh visit may open on, weighted (see BACKGROUND_GENRES). */
      function openingGenrePool() {
        const favourites = genrePrefs.favourites;
        const background = BACKGROUND_GENRES.map((slug) => GENRE_BY_SLUG.get(slug)).filter(Boolean);
        // Hide-non-favourites prunes the opening draw too — a listener who
        // asked not to see the rest of the set should not be opened on one.
        const pool = genrePrefs.hideOthers && favourites.length
          ? background.filter((genre) => favourites.includes(genre.slug))
          : background;
        // …unless that leaves nothing (every favourite is outside the
        // background list), in which case the favourites themselves are the
        // honest answer, and the background list is the last resort.
        const source = pool.length
          ? pool
          : genrePrefs.hideOthers && favourites.length
            ? favourites.map((slug) => GENRE_BY_SLUG.get(slug)).filter(Boolean)
            : background;
        return source.map((genre) => ({
          value: genre,
          weight: favourites.includes(genre.slug) ? FAVOURITE_WEIGHT : 1,
        }));
      }

      /** One compiled setup from a genre, or null if the compiler refuses it. */
      function compileGenreParams(genre, seed, opts = {}) {
        if (!genreCompiler || !genre) return null;
        try {
          return genreCompiler.compileGenre(genre, { rng: makeRng(seed), ...opts });
        } catch {
          return null;
        }
      }

      /**
       * AUDIT FIX (findings 70/71): a fresh pick plays the kit AS AUTHORED.
       * The one-day shaped-pick experiment fed the genre's absolute
       * chord-colour complexity into the kit ladder, which mangled both
       * public genres on every pick (synthwave compiles 0.275 forever — its
       * grammar is triads — so its straight-eighth hats grew holes). The
       * authored kit IS the genre's sound at its own Energy; the ladder now
       * shapes only the DIAL'S DEVIATION from that anchor (kitComplexityFor
       * below, used by followGenreKit). This two-pass ABSOLUTE compile is
       * kept solely so share links minted during the experiment (origin
       * `kit: 1`) still rebuild byte-faithfully.
       */
      function compileGenreShapedLegacy(genre, seed) {
        const first = compileGenreParams(genre, seed);
        if (!first) return null;
        const kc = clamp(rangeMid(first.complexity ?? 0.5), 0, 1);
        return compileGenreParams(genre, seed, { kitComplexity: kc }) || first;
      }

      /**
       * The kit ladder's input, anchored to the genre's OWN Energy: at the
       * anchor the kit is exactly as authored (0.5, the ladder's identity
       * window), the dial's travel below the anchor spends the whole
       * softness ladder, and the travel above it spends the whole
       * doubling/fill ladder.
       */
      function kitComplexityFor(userComplexity, anchor) {
        const a = clamp(Number.isFinite(anchor) ? anchor : 0.5, 0.05, 0.95);
        const c = clamp(rangeMid(userComplexity), 0, 1);
        return c <= a ? 0.5 * (c / a) : 0.5 + 0.5 * ((c - a) / (1 - a));
      }

      /**
       * v0.0.79 — a compact share payload back into a whole settings tree.
       *
       * A payload with no `o`/`d` is a WHOLE TREE and is returned untouched.
       * That branch is permanent: every link minted before this version
       * carries the full tree, and links live in other people's chat logs
       * forever.
       *
       * If the origin cannot be rebuilt — an unknown genre slug, a compiler
       * that refused, a link from a build whose genre files we do not have —
       * the diff is applied to the plain defaults instead. That is a worse
       * reproduction than the sender heard and the arrival note says so; it is
       * still better than a blank page, because the diff carries every field
       * the sender actually changed.
       */
      function expandSharedParams(payload) {
        if (!isCompactShare(payload)) return payload;
        let base = null;
        try { base = baseFromOrigin(payload[SHARE_ORIGIN_KEY]); } catch { base = null; }
        if (!base) {
          shareBaseMissing = true;
          base = deepMerge(DEFAULTS, {});
          normaliseV6Tracks(base);
          delete base.ui;
          base.origin = { ...payload[SHARE_ORIGIN_KEY] };
        }
        return applyShareDiff(base, payload[SHARE_DIFF_KEY]);
      }

      /**
       * A diff written by diffTree, applied back onto its base. `null` at a
       * key means the key was REMOVED — diffTree writes that deliberately, and
       * treating it as the value null instead would restore a track the sender
       * had deleted.
       */
      function applyShareDiff(base, diff) {
        if (!isPlainObject(diff)) return base;
        const out = isPlainObject(base) ? { ...base } : {};
        for (const [key, value] of Object.entries(diff)) {
          if (value === null) { delete out[key]; continue; }
          out[key] = isPlainObject(value) && isPlainObject(out[key])
            ? applyShareDiff(out[key], value)
            : value;
        }
        return out;
      }

      // ---- settings load + legacy migration -----------------------------

      let shareBaseMissing = false;
      let settings;
      let sharedParams = null;
      let routePreset = null;
      // The three-word name of the link this visit arrived on — the same name
      // the sender saw when they copied it (both ends hash the same payload).
      // A /[slug] factory route has a real name of its own and gets none.
      let arrivedShareName = '';
      {
        let saved = null;
        try {
          saved = prefs.get('generator');
        } catch {
          saved = null;
        }
        let migratedFromLegacy = false;
        if (!saved) {
          try {
            const raw = localStorage.getItem(LEGACY_STORAGE_KEY);
            if (raw) {
              saved = JSON.parse(raw);
              // v2 had independent speed (0.25–2) and bpm; v3 has one tempo.
              // Fold the old multiplier into bpm on migration.
              if (typeof saved.speed === 'number' && typeof saved.bpm === 'number') {
                saved.bpm = Math.round(clamp(saved.bpm * saved.speed, 20, 220));
              }
              delete saved.speed;
              migratedFromLegacy = true;
            }
          } catch {
            saved = null;
          }
        }
        // AUDIT FIX (critical 2): the legacy key is only dropped once its
        // data has somewhere durable to live. Deleting it unconditionally
        // destroyed a returning user's whole setup on any PRE-CONSENT visit:
        // migrated to memory, key gone, nothing persisted, tab closed —
        // years of settings deleted by a page they never said yes to.
        // Re-migration cannot clobber newer settings either way, because the
        // legacy path only runs when no v3 save exists.
        if (saved && !migratedFromLegacy) {
          // A real v3 save exists: the legacy key is dead weight — clean it.
          try {
            localStorage.removeItem(LEGACY_STORAGE_KEY);
          } catch {}
        }
        migrateLegacyArpSteps(saved);
        settings = deepMerge(DEFAULTS, saved || {});
        normaliseV6Tracks(settings);
        if (migratedFromLegacy && prefs.consent() === 'granted') {
          prefs.set('generator', settings);
          // Persisted for real — NOW the legacy key can go.
          try {
            localStorage.removeItem(LEGACY_STORAGE_KEY);
          } catch {}
        }
        // A `#p=` share link (or a /[slug] factory-preset route, v16) wins over
        // the stored settings for THIS visit, and takes the same migrate →
        // merge → normalise path a preset load does (so a link made by an older
        // build still lands). Applied here, before any dial is built, so the
        // first render is already the shared preset. Nothing is persisted: the
        // note tells the user to Save to keep it.
        sharedParams = takeSharedParams();
        if (!sharedParams) {
          routePreset = takeRoutePreset();
          if (routePreset) sharedParams = routePreset.params;
        }
        if (sharedParams) {
          const ui = settings.ui;
          try {
            const clone = structuredClone(expandSharedParams(sharedParams));
            migrateLegacyArpSteps(clone);
            settings = deepMerge(DEFAULTS, clone);
            normaliseV6Tracks(settings);
            settings.ui = ui;
            if (!routePreset) arrivedShareName = shareNameFor(arrivedSharePayload, SHARE_WORDS);
          } catch {
            sharedParams = null;
            routePreset = null;
          }
        } else if (!saved && genreCompiler) {
          // v26: a visit with NOTHING to restore opens on a genre rather than
          // on the bare defaults — the listener's own finding was that every
          // fresh load sounded the same piece. The draw is weighted (see
          // openingGenrePool) and seeded fresh, so two first visits an hour
          // apart are two different pieces even on the same genre. Not
          // persisted: touching any control saves the whole settings object,
          // which is the point at which this becomes the listener's setup.
          const genre = weightedDraw(openingGenrePool());
          // v0.0.62: the seed is held, not thrown away. This is the one place
          // a setup is built without going through applyGenre, and it is the
          // setup MOST people submit from — so leaving its provenance blank
          // made the diff a full settings tree for exactly the common case.
          const openingSeed = randomSeed();
          const compiled = compileGenreParams(genre, openingSeed);
          if (compiled) {
            const ui = settings.ui;
            settings = deepMerge(DEFAULTS, settingsFromGenre(compiled, genre.slug));
            normaliseV6Tracks(settings);
            settings.origin = { kind: 'genre', id: genre.slug, seed: openingSeed };
            settings.ui = ui;
            // The opening draw is the one setup built without applyGenre, so
            // it has to bless its own kit as genre-clean or the Energy dial
            // never follows the kit at all on the app's entry path.
            recordCleanGenreKit();
          }
        }
      }

      // ---- v23 user tracks: settings → engine, before anything is built ----
      // `params.userTracks` is the engine's authority on which tracks exist, so
      // a stored setup (or a share link) that carries one has to reach it BEFORE
      // the rows, the wiring loops and the editors are built — every one of them
      // reads TRACK_IDS, and TRACK_IDS is the engine's live list.
      function pushUserTracks() {
        if (!engineCaps.trackRegistry) return;
        try {
          engine.setParams({ userTracks: structuredClone(settings.userTracks) });
        } catch {
          // An engine that predates user tracks drops the key; the page then
          // has the six it always had, which is the correct degradation.
        }
        syncTrackViews(settings.userTracks);
        // An entry the engine refused (a grammar the page's mirror was more
        // generous about, the cap) is not this page's track: the settings list
        // follows the engine's answer, never the other way round.
        if (settings.userTracks.length !== USER_TRACKS.length) {
          settings.userTracks = settings.userTracks.filter((entry) => USER_TRACK_BY_ID.has(entry.id));
        }
        for (const entry of USER_TRACKS) probeTrackCaps(entry.id);
      }
      pushUserTracks();

      // ---- v23 track rows: the SSR six, plus the user's own ----------------
      // index.astro renders one `.track-item` per BUILT-IN at build time, from
      // the module registry — a server render cannot know a user's tracks. User
      // rows are therefore appended CLIENT-side, into the same container and
      // BELOW the six, so no existing control moves (v18 hardware-panel rule:
      // an insertion below is not a layout shift of anything above).
      const trackRowsBox = document.querySelector('.track-rows');

      /**
       * Build one user track's row, structurally identical to the markup the
       * build emits for a built-in — same classes, same id patterns, same
       * order — so every listener, sync pass and query selector on the page
       * finds exactly what it finds on a built-in row. It carries ONE thing a
       * built-in row does not: a Remove button, because a built-in cannot go.
       */
      function buildTrackRow(track) {
        if (!trackRowsBox || document.querySelector(`.track-row[data-track="${track.id}"]`)) return;
        const label = track.label;
        const item = document.createElement('div');
        item.className = `track-item ${trackColourClass(track.id)}`;
        item.dataset.trackItem = track.id;

        const row = document.createElement('div');
        row.className = 'track-row';
        row.dataset.track = track.id;

        const lamp = document.createElement('button');
        lamp.type = 'button';
        lamp.className = 'track-name track-lamp';
        lamp.id = `track-lamp-${track.id}`;
        lamp.setAttribute('aria-label', `${label} state. Press to cycle Off, Auto, On.`);
        const chip = document.createElement('span');
        chip.className = 'track-chip lamp-dot';
        chip.setAttribute('aria-hidden', 'true');
        const lampText = document.createElement('span');
        lampText.className = 'lamp-text';
        lampText.textContent = label;
        lamp.append(chip, lampText);

        const select = document.createElement('select');
        select.id = `track-voice-${track.id}`;
        select.className = 'track-voice';
        select.setAttribute('aria-label', `${label} voice`);
        // A user track plays a STOCK bank (the v10 boundary), so its options are
        // that bank's, named exactly as the built-in that owns it names them.
        for (const [value, voiceName] of Object.entries(VOICE_LABELS[track.voiceSet] || {})) {
          const option = document.createElement('option');
          option.value = value;
          option.textContent = voiceName;
          select.append(option);
        }

        const level = document.createElement('div');
        level.className = 'track-level';
        level.id = `track-level-${track.id}`;

        const extras = document.createElement('div');
        extras.className = 'track-extras';
        extras.id = `track-extras-${track.id}`;

        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'secondary-button voice-edit-toggle';
        edit.id = `voice-edit-toggle-${track.id}`;
        edit.setAttribute('aria-expanded', 'false');
        edit.setAttribute('aria-controls', `voice-editor-${track.id}`);
        edit.textContent = 'Edit';

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'round-button track-remove';
        remove.id = `track-remove-${track.id}`;
        remove.textContent = '×';
        remove.setAttribute('aria-label', `Remove ${label}`);

        const foot = document.createElement('span');
        foot.className = 'track-foot';
        const resolved = document.createElement('span');
        resolved.className = 'resolved-readout';
        resolved.id = `resolved-${track.id}`;
        resolved.setAttribute('aria-hidden', 'true');
        const meter = document.createElement('span');
        meter.className = 'cost-meter';
        meter.id = `cost-meter-${track.id}`;
        meter.hidden = true;
        const fill = document.createElement('span');
        fill.className = 'cost-meter-fill';
        meter.append(fill);
        foot.append(resolved, meter);

        row.append(lamp, select, level, extras, edit, remove, foot);

        const editor = document.createElement('div');
        editor.className = 'voice-editor module-panel';
        editor.id = `voice-editor-${track.id}`;
        editor.hidden = true;

        item.append(row, editor);
        // Always last: user tracks append after every built-in, in creation
        // order, which is the order the engine itself keeps them in.
        trackRowsBox.append(item);
      }

      /** Drop a user track's row and everything registered against it. */
      function removeTrackRow(id) {
        const item = document.querySelector(`[data-track-item="${id}"]`);
        if (!item) return;
        // Tear the editor down BEFORE the markup goes: its knob handles, its
        // scope loop and its extras registration all outlive a bare .remove().
        try {
          closeTrackEditor(id);
        } catch {
          // A row whose editor was never opened has nothing to close.
        }
        item.remove();
        levelControls.delete(id);
        extrasInstances.delete(id);
        focusOpenDisarmed.delete(id);
        soundingVoice.delete(id);
      }

      for (const entry of USER_TRACKS) buildTrackRow(entry);

      // ---- consent-gated persistence ------------------------------------

      const consentSlot = document.getElementById('consent-slot');
      let deniedThisSession = false;
      let consentAsking = null;

      function ensureConsent() {
        const c = prefs.consent();
        if (c === 'granted') return Promise.resolve(true);
        if (c === 'denied' || deniedThisSession) return Promise.resolve(false);
        if (!consentAsking) {
          consentAsking = Promise.resolve(
            consentPrompt(consentSlot, {
              message: 'Remember your settings and presets on this device?',
              // Consent has to be informed: name the mechanism, say what goes
              // in it, and disclose the one cookie that records the answer —
              // which is set either way, and is the strictly-necessary kind
              // that needs no consent of its own.
              detail:
                'Choosing Save keeps your dials, tracks and saved presets in this browser’s ' +
                'local storage. Either way we set one small cookie so we remember your answer ' +
                'and stop asking. Nothing is uploaded, and there is no tracking or advertising ' +
                'in this — see',
              privacyUrl: 'https://andeye.com/privacy',
            })
          )
            .then((granted) => {
              if (!granted) deniedThisSession = true;
              consentAsking = null;
              return granted;
            })
            .catch(() => {
              deniedThisSession = true;
              consentAsking = null;
              return false;
            });
        }
        return consentAsking;
      }

      function persistKey(key, value) {
        // prefs.set without consent writes to session memory and returns
        // false — so the value survives in-session either way.
        prefs.set(key, value);
        if (prefs.consent() === 'granted') {
          try {
            localStorage.removeItem(LEGACY_STORAGE_KEY);
          } catch {}
          return;
        }
        if (prefs.consent() === null && !deniedThisSession) {
          ensureConsent().then((granted) => {
            if (granted) {
              prefs.set(key, value);
              try {
                localStorage.removeItem(LEGACY_STORAGE_KEY);
              } catch {}
            }
          });
        }
      }

      // Sliders fire an input event per pixel of drag; debounce the storage
      // write. pagehide flushes any pending write (see lifecycle handlers).
      let persistTimer = null;
      // v0.0.78: the universal undo watches this funnel rather than
      // instrumenting every commit path. An explicit hook rather than calling
      // the function by name: the undo's own state is declared much further
      // down, and persistSettings runs during boot — naming the function
      // directly would read it before its `let`s exist and take the whole page
      // down, which is exactly what the first cut of this did.
      let onSettingsCommitted = null;

      function persistSettings() {
        if (onSettingsCommitted) onSettingsCommitted();
        if (persistTimer !== null) clearTimeout(persistTimer);
        persistTimer = setTimeout(() => {
          persistTimer = null;
          persistKey('generator', settings);
        }, 250);
      }
      function flushPersistSettings() {
        if (persistTimer !== null) {
          clearTimeout(persistTimer);
          persistTimer = null;
          persistKey('generator', settings);
        }
      }

      // ---- visualiser (optional decoration) -----------------------------

      const canvas = document.getElementById('track-visualiser');
      let visualiserHandle = null;
      // Declared up here (not with the governor block below) because
      // updateScopeMode reads the budget and can run before it.
      let governor = null;
      let powerBudget = null;
      // Assigned by the front-scope block much further down. It must be
      // DECLARED here: activateTab / updateAllScopeModes / setTrackState all
      // call it and all of them can run before that block's line is reached —
      // a `let` declared later would be a temporal-dead-zone crash (the
      // shipped blank-page bug, 6105e0d).
      let updateFrontScope = () => {};
      // v23: scope.js reads the registry ONCE, at attach — a track added after
      // that is not traced and its legend entry never appears. Assigned by the
      // front-scope block below; a no-op where that block never runs.
      let refreshScopeRegistry = () => {};
      try {
      const { initVisualiser } = await import('../scripts/visualiser.js');
        visualiserHandle = initVisualiser(canvas, engine);
      } catch {
        // The generator works without it.
      }

      // ---- element handles ----------------------------------------------

      const toggleButton = document.getElementById('toggle-play');
      const playLabel = toggleButton.querySelector('.play-toggle-label');
      const playGlyph = toggleButton.querySelector('.play-glyph');
      const finishGlyph = toggleButton.querySelector('.finish-glyph');
      const stopGlyph = toggleButton.querySelector('.stop-glyph');
      const pauseButton = document.getElementById('pause-toggle');
      const pauseLabel = pauseButton.querySelector('.pause-label');
      const pauseGlyph = pauseButton.querySelector('.pause-glyph');
      const resumeGlyph = pauseButton.querySelector('.resume-glyph');
      const forwardButton = document.getElementById('fast-forward');
      const genreRow = document.getElementById('genre-select').closest('.genre-row');
      const genreSelect = document.getElementById('genre-select');
      const recordButton = document.getElementById('record-toggle');
      const recordStatus = document.getElementById('record-status');
      const transportStatus = document.getElementById('transport-status');

      // v15: a transport control can be demoted to Advanced-only by adding
      // its data-transport id to SIMPLE_HIDDEN — nothing else changes.
      // Pre-launch: HIDDEN_UNTIL_LAUNCH wins over both tabs.
      // v26: UNAVAILABLE_TRANSPORT is the capability tier — a button this
      // engine build cannot serve at all (filled in by the probes below) is
      // not rendered on either tab, and stays unrendered across tab switches.
      const UNAVAILABLE_TRANSPORT = new Set();

      function applyTransportVisibility(tabName) {
        for (const el of document.querySelectorAll('[data-transport]')) {
          const owner = el.closest('.popover-anchor') || el;
          const id = el.dataset.transport;
          owner.hidden =
            UNAVAILABLE_TRANSPORT.has(id) ||
            (PAID_FEATURES_HIDDEN && HIDDEN_UNTIL_LAUNCH.has(id)) ||
            (tabName === 'simple' && SIMPLE_HIDDEN.has(id));
        }
      }

      // iOS routes Web Audio through the ringer channel, so the hardware
      // silent switch mutes it — surface a hint only where it applies.
      const isIOS =
        /iP(hone|ad|od)/.test(navigator.platform || '') ||
        (navigator.maxTouchPoints > 1 && /Mac/.test(navigator.platform || ''));
      if (isIOS) document.getElementById('ios-silent-hint').hidden = false;

      // v12: the Simple tab's five dials (Speed/Complexity/Repetition/
      // Randomness/Volume) are built further down, once knobApi has loaded —
      // `.set(v)` normalises knob-vs-slider-fallback for every call site
      // above that point (setTempo, updateComplexityDisplay, syncUIFromSettings).
      let speedDial = null;
      let simpleSpeedDial = null;   // v0.0.83: the Simple tab's own Tempo view
      let energyDial = null;
      let complexityDial = null;
      let repetitionDial = null;
      let randomnessDial = null;
      let variationDial = null;
      let volumeDial = null;
      let swingDial = null;
      let reverbTailDial = null;
      let processorDial = null;
      const rootSelect = document.getElementById('root');
      const modeSelect = document.getElementById('mode');
      const timeSignatureSelect = document.getElementById('timeSignature');
      // v0.0.46: the BPM slider is gone — the Tempo dial owns the value and
      // setTempo drove all three views. The readout it fed lives on.
      const bpmInput = document.getElementById('bpm');
      const bpmReadout = document.getElementById('bpm-readout');
      let bpmTypable = null;
      const structureSelect = document.getElementById('structure');
      const chordLengthControl = document.getElementById('control-chord-length');
      const chordLengthSelect = document.getElementById('chordLength');

      // Only the scales the engine's own sanitiser confirmed it accepts stay
      // in the list — an unaccepted value would sit there doing nothing the
      // moment it was picked. A group emptied by the pruning goes with them,
      // so an older engine never shows a heading over nothing.
      for (const option of [...modeSelect.querySelectorAll('option')]) {
        if (!engineCaps.modes[option.value]) option.remove();
      }
      for (const group of [...modeSelect.querySelectorAll('optgroup')]) {
        if (!group.querySelector('option')) group.remove();
      }

      function engineParamsFrom(s) {
        const p = structuredClone(s);
        delete p.ui;
        p.speed = 1; // deprecated at UI level; back-compat pin
        // v26: the genre tag is stated on EVERY push. The sanitiser keeps the
        // stored tag when the key is missing and only an explicit null clears
        // it, so a settings object with no genre (a factory preset, a share
        // link made before genres existed) has to say so out loud or the old
        // tag rides along under a piece that is no longer that genre.
        p.genre = typeof p.genre === 'string' ? p.genre : null;
        // v0.0.117: sequencerAdvance is stated on EVERY push for the same
        // reason as the genre tag just above — the sanitiser keeps the stored
        // mode when the key is missing and only an explicit null clears it.
        // Without this, loading a preset or share link after typing a
        // multi-bar melody left the ENGINE in chain mode under a UI reading
        // Shuffle, silently ignoring every weight the user then edited.
        if (p.tracks && typeof p.tracks === 'object') {
          for (const t of Object.values(p.tracks)) {
            if (!t || typeof t !== 'object') continue;
            t.sequencerAdvance = t.sequencerAdvance === 'chain' ? 'chain' : null;
          }
        }
        // The stored tail is the USER's ask; the engine only ever sees it
        // through the governor's tier cap (same policy as the density scale
        // on track levels — never overwrite what the user chose).
        if (typeof p.reverbTail === 'number') p.reverbTail = cappedReverbTail();
        return p;
      }

      /** The reverb tail the engine may actually have, tier cap included. */
      /**
       * v0.0.56: the tail may be a {min,max} span. The power cap applies to
       * BOTH ends — the governor's job is to stop the tail exceeding what the
       * device can carry, and a span whose top end escaped that would defeat
       * it on the loudest bar rather than never.
       */
      function cappedReverbTail() {
        const stored = settings?.reverbTail;
        const usable = (typeof stored === 'number' && Number.isFinite(stored))
          || (stored && typeof stored === 'object'
            && Number.isFinite(stored.min) && Number.isFinite(stored.max));
        const asked = mapRangeValue(usable ? stored : (engineReverbTail ?? 2),
          (v) => clamp(v, 0.5, 6));
        const cap = powerBudget && typeof powerBudget.reverbSeconds === 'number'
          ? powerBudget.reverbSeconds
          : null;
        if (cap === null) return asked;
        return mapRangeValue(asked, (v) => Math.min(v, cap));
      }

      /** Push the capped tail through whichever hook this engine exposes. */
      function applyReverbTail() {
        if (!engineCaps.reverbTail && !engineCaps.setReverbSeconds) return;
        const seconds = cappedReverbTail();
        if (engineCaps.reverbTail) {
          try {
            engine.setParams({ reverbTail: seconds });
          } catch {}
        }
        if (engineCaps.setReverbSeconds) {
          try {
            engine.setReverbSeconds(seconds);
          } catch {}
        }
      }

      // ---- combined-complexity estimate (display only) ------------------
      // When the user hand-sets advanced choices, the complexity slider
      // becomes a read-out of a derived "combined complexity" estimate. It
      // moves ONLY the slider thumb — never engine params, never the stored
      // complexity, never the advanced choices. Components (each 0–1,
      // included only when hand-set):
      //   structure != auto → mean section intensity of the chosen preset:
      //     drone 0.35, waves 0.50, build 0.55, abab 0.55, journey 0.55,
      //     custom = mean of the custom blocks' intensities
      //   arp manual → (enabled-step fraction) × rate weight
      //     (1/4 → 0.4, 1/8 → 0.6, 1/8T → 0.7, 1/16 → 0.9)
      //   any track forced on → (tracks with state 'on') / 6
      // estimate = arithmetic mean of the included components. With nothing
      // hand-set the slider shows the stored complexity.
      const STRUCTURE_MEAN_INTENSITY = {
        drone: 0.35,
        waves: 0.5,
        build: 0.55,
        abab: 0.55,
        journey: 0.55,
      };
      const ARP_RATE_WEIGHT = { '1/4': 0.4, '1/8': 0.6, '1/8T': 0.7, '1/16': 0.9 };

      /** Is this dial's pointer down right now? Writing a face mid-gesture
       * fights the pointer — the same law setTempo's skip flags encode. */
      const dialDragging = (dial) => dial?.el?.getAttribute?.('data-dragging') === 'true';

      function updateComplexityDisplay() {
        // AUDIT FIX: the debounced complexity commit fires DURING a paused
        // drag, and this write-back teleported the held thumb mid-gesture.
        if (dialDragging(complexityDial)) return;
        const parts = [];
        if (settings.structure !== 'auto') {
          if (settings.structure === 'custom' && settings.customStructure.length) {
            parts.push(
              settings.customStructure.reduce((s, b) => s + b.intensity, 0) /
                settings.customStructure.length
            );
          } else {
            parts.push(STRUCTURE_MEAN_INTENSITY[settings.structure] ?? 0.5);
          }
        }
        if (settings.arp.mode === 'manual') {
          // Density against the true per-bar step count, not the fixed
          // 16-slot legacy mirror length — otherwise a slow arp rate (few
          // steps actually in play) reads as artificially sparse.
          const n = Math.min(16, arpStepsPerBar());
          const frac = n > 0 ? settings.arp.steps.slice(0, n).filter(Boolean).length / n : 0;
          parts.push(frac * (ARP_RATE_WEIGHT[settings.arp.rate] ?? 0.6));
        }
        const forcedOn = TRACK_IDS.filter((id) => settings.tracks[id].state === 'on').length;
        if (forcedOn > 0) parts.push(forcedOn / TRACK_IDS.length);
        // v0.0.56: with nothing hand-set there is no estimate to show, so the
        // stored value passes through UNCHANGED — including a {min,max} span.
        // Collapsing it here was silently undoing a horizontal drag on
        // Complexity a frame after it landed: the drag's own commit sets
        // structure and every track back to Auto, which calls this, which put
        // a single number back on the face. `clamp` on an object is NaN, so
        // the dial was being handed junk as well as being overwritten.
        if (!parts.length) {
          complexityDial?.set(mapRangeValue(settings.complexity, (v) => clamp(v, 0, 1)));
          return;
        }
        const shown = parts.reduce((s, p) => s + p, 0) / parts.length;
        complexityDial?.set(clamp(shown, 0, 1));
      }

      // ---- tempo (one value, two views) ---------------------------------

      /**
       * v0.0.56: `bpm` may arrive as a number OR as a {min,max} span, because
       * the Tempo dial spreads like every other dial now. The span goes
       * straight to the engine, which walks it once a bar; everything that
       * needs ONE number to show (the typable readout, the other dials'
       * positions) takes the midpoint, which is where the walk sits on
       * average and where the piece starts.
       */
      function setTempo(bpm, { skipSpeedThumb = false, skipSimpleThumb = false, landing = null } = {}) {
        const clampBpm = (v) => Math.round(clamp(v, 20, 220));
        bpm = mapRangeValue(bpm, clampBpm);
        const mid = rangeMid(bpm);
        settings.bpm = bpm;
        if (bpmInput) bpmInput.value = String(mid);
        bpmTypable?.refresh();
        if (!skipSpeedThumb) speedDial?.set(mapRangeValue(bpm, speedTFromBpm));
        if (!skipSimpleThumb) simpleSpeedDial?.set(mapRangeValue(bpm, speedTFromBpm));
        // Energy's read-back is tempo-anchored (tempo is the dominant cue the
        // macro owns), so any tempo write moves the Energy dial too — except
        // the one Energy itself is making mid-gesture.
        // v0.0.71: tempo no longer moves the Energy dial. They are separate
        // controls now, and a tempo edit that dragged Energy with it would be
        // the same conflation wearing a different hat.
        // v0.0.57: WHERE the change lands is decided by which control moved,
        // per the owner's 2026-07-28 question. Simple's Energy macro lands on
        // the next beat, because a beginner needs to hear that the thing they
        // just dragged did something. The Advanced Tempo dial lands on the
        // barline, which is musically tidier and is what every build before
        // v0.0.48 did. Turning the two dials against each other is the A/B he
        // asked for, and it needs no switch to run.
        engine.setParams({ bpm, speed: 1, ...(landing ? { tempoLanding: landing } : {}) });
        persistSettings();
      }

      // ---- Energy: the Simple macro over tempo + complexity (v0.0.50) -----
      // Log law over a BOUNDED sweep: 42 bpm at 0, 72 at 0.5, 124 at 1 — not
      // the full 20–220, because Energy moves tempo under someone working and
      // the extremes are Advanced territory. Default 0.35 lands on 61 bpm,
      // within a hair of the shipped 60, so nothing about the default sound
      // changes.
      // v0.0.71: ENERGY_BPM_LOW/HIGH and bpmFromEnergy are gone with the
      // tempo coupling. Energy drives complexity and nothing else.
      const ENERGY_DEFAULT = 0.35;
      // v0.0.71: Energy no longer touches tempo.
      //
      // Owner: "Personally I don't think Tempo and Energy should be conflated.
      // [...] in most modern western genres you don't want to vary the tempo,
      // but you definitely do want to vary the energy." That is right, and it
      // is the stronger reading of what the dial is FOR: energy is how much is
      // going on, and tempo is a property of the piece you chose.
      //
      // Tempo was doing most of the work, though, so removing it without
      // widening what remains would leave a dial that barely does anything.
      // The knots now span 0.04 to 1.00 rather than 0.10 to 0.95, and the
      // lower half is steeper — the structure thresholds and the auto-track
      // ladder are what Energy has left, and it has to cross more of them.
      //
      // This CHANGES THE SHIPPED SOUND at any Energy setting away from the
      // default, which is why the frozen audio reference is regenerated in the
      // same commit rather than being worked around.
      const ENERGY_COMPLEXITY_KNOTS = [
        [0.0, 0.04], [0.2, 0.28], [0.35, 0.42], [0.55, 0.62], [0.8, 0.85], [1.0, 1.0],
      ];
      function complexityFromEnergy(e) {
        const x = clamp(e, 0, 1);
        for (let i = 1; i < ENERGY_COMPLEXITY_KNOTS.length; i++) {
          const [x1, y1] = ENERGY_COMPLEXITY_KNOTS[i - 1];
          const [x2, y2] = ENERGY_COMPLEXITY_KNOTS[i];
          if (x <= x2) return y1 + ((x - x1) / (x2 - x1)) * (y2 - y1);
        }
        return ENERGY_COMPLEXITY_KNOTS[ENERGY_COMPLEXITY_KNOTS.length - 1][1];
      }

      /**
       * The inverse, so the Energy dial can read back from the thing it now
       * drives. Before v0.0.71 it read back from TEMPO, which is exactly the
       * conflation the owner objected to — and would have left the dial
       * jumping whenever the Advanced tempo dial moved.
       */
      function energyFromComplexity(c) {
        const y = clamp(rangeMid(c), 0, 1);
        const knots = ENERGY_COMPLEXITY_KNOTS;
        if (y <= knots[0][1]) return knots[0][0];
        for (let i = 1; i < knots.length; i++) {
          const [x1, y1] = knots[i - 1];
          const [x2, y2] = knots[i];
          if (y <= y2) return y2 === y1 ? x1 : x1 + ((y - y1) / (y2 - y1)) * (x2 - x1);
        }
        return knots[knots.length - 1][0];
      }

      /** Trailing debounce for structural commits — dragging a dial across its
       * range must not clear the motif and percussion banks dozens of times
       * (the plan is redrawn on every complexity write). 120 ms after the last
       * move, one commit lands — which includes the release. */
      function trailingDebounce(fn, ms) {
        let timer = null;
        return (...args) => {
          if (timer !== null) clearTimeout(timer);
          timer = setTimeout(() => {
            timer = null;
            fn(...args);
          }, ms);
        };
      }

      bpmInput?.addEventListener('input', () => {
        setTempo(parseInt(bpmInput.value, 10));
      });

      // ---- simple dials (built once knobApi has loaded, further down) ---
      // Commit bodies for Complexity/Repetition/Volume/Randomness live next
      // to buildSimpleDial(); this is the fan-out helper Randomness needs.

      function meanRandomness() {
        const vals = TRACK_IDS.map((id) =>
          rangeMid(sanitiseRangeValueIn(settings.tracks[id].randomness, 0, 1, 0.5))
        );
        return vals.reduce((a, b) => a + b, 0) / vals.length;
      }

      /**
       * What the Simple tab's fused Randomness dial should READ. Normally the
       * dial's own x, recovered exactly: every track carries the same
       * randomness and repetition is its mirror (1 - x), so the shared value —
       * range included — is handed straight back. Once the Advanced tab has
       * hand-set repetition or an individual track's randomness to something
       * no single x could produce, it falls back to the blended estimate
       * ((1 - repetition) + mean(randomness)) / 2: a display only, exactly
       * like the combined-complexity read-out, never written anywhere.
       */
      function fusedRandomnessValue() {
        const first = settings.tracks[TRACK_IDS[0]].randomness;
        const shape = JSON.stringify(first);
        const uniform = TRACK_IDS.every(
          (id) => JSON.stringify(settings.tracks[id].randomness) === shape
        );
        const mid = rangeMid(sanitiseRangeValueIn(first, 0, 1, 0.5));
        // v0.0.50: "consistent" now means consistent with the Change dial's
        // own mapping (repetition is no longer a strict 1 − randomness).
        const expected = changeRepetitionFromT(changeTFromRandomness(mid));
        if (uniform && Math.abs(expected - settings.repetition) < 0.02) return first;
        return clamp(meanRandomness(), 0, 1);
      }

      /** The Change dial's position for the current settings — the fused
       * randomness estimate pushed through the dial's own inverse map. */
      function changeDialValueFromState() {
        return mapRangeValue(fusedRandomnessValue(), changeTFromRandomness);
      }

      /**
       * What the ADVANCED tab's Variation dial reads: the tracks' own randomness
       * and nothing else. Repetition is not in it.
       *
       * v0.0.35 de-fuse. Advanced used to mirror the Simple tab's fused dial, so
       * cranking Repetition visibly dragged Randomness with it — with every track
       * at 96% and repetition taken to 100%, the fused read-out lands on
       * (1 - 1 + 0.96) / 2 = 48%, and moving Randomness wrote repetition = 1 - x
       * straight back. Two engine params that share no code path read as one
       * control. Simple keeps the fused macro on purpose; Advanced is where the
       * two axes have to be separable, which is the whole point of the tab.
       */
      function trackRandomnessValue() {
        const first = settings.tracks[TRACK_IDS[0]].randomness;
        const shape = JSON.stringify(first);
        const uniform = TRACK_IDS.every(
          (id) => JSON.stringify(settings.tracks[id].randomness) === shape
        );
        return uniform ? first : clamp(meanRandomness(), 0, 1);
      }

      // v0.0.98: custom metre — the select's Custom… entry reveals an N/D
      // pair; anything metrePulses() can grid is legal (N/4 up to 5, N/8 up
      // to 10 — the sequencer's own twenty-step bound), and the engine is the
      // judge: commit re-reads getParams and the readout shows what stuck.
      {
        const wrap = document.getElementById('custom-metre');
        const nInput = document.getElementById('custom-metre-n');
        const dSelect = document.getElementById('custom-metre-d');
        const showCustom = (show) => { if (wrap) wrap.hidden = !show; };
        const commitCustom = () => {
          const n = clamp(Math.round(Number(nInput.value) || 4), 2, 10);
          const d = dSelect.value === '8' ? '8' : '4';
          const sig = `${n}/${d}`;
          engine.setParams({ timeSignature: sig });
          const accepted = engine.getParams().timeSignature;
          settings.timeSignature = accepted;
          nInput.value = String(Number(accepted.split('/')[0]) || n);
          dSelect.value = accepted.split('/')[1] === '8' ? '8' : '4';
          for (const ed of openEditors.values()) {
            try { ed.seq?.refresh(); } catch {}
          }
          persistSettings();
        };
        timeSignatureSelect?.addEventListener('change', () => {
          if (timeSignatureSelect.value === 'custom') {
            showCustom(true);
            commitCustom();
            return;
          }
          showCustom(false);
        });
        nInput?.addEventListener('change', commitCustom);
        dSelect?.addEventListener('change', commitCustom);
        // NOT describe() here: this code runs before tipSeq's declaration,
        // and a describe() call this early is the recorded blank-page TDZ
        // bug (6105e0d). A plain title carries the bounds instead.
        if (nInput) nInput.title = 'Beats per bar — up to 5 over 4, up to 10 over 8 (the step grid\u2019s own bound).';
      }

      for (const [select, key] of [
        [rootSelect, 'root'],
        [modeSelect, 'mode'],
        [timeSignatureSelect, 'timeSignature'],
      ]) {
        select.addEventListener('change', () => {
          if (key === 'timeSignature' && select.value === 'custom') return;
          settings[key] = select.value;
          engine.setParams({ [key]: select.value });
          if (key === 'timeSignature') {
            // Metre drives steps-per-bar: re-render any open step grids.
            for (const ed of openEditors.values()) {
              try {
                ed.seq?.refresh();
              } catch {}
            }
          }
          // v0.0.76: the chord chips name the NOTES a degree sounds, so a
          // change of key or scale re-colours every one of them. The stored
          // loop is untouched — this is the re-colouring the hint has always
          // warned about, now visible instead of only described.
          if (key === 'root' || key === 'mode') {
            try { renderProgression(); } catch {}
          }
          persistSettings();
        });
      }

      // ---- tabs ----------------------------------------------------------

      const tabButtons = [
        document.getElementById('tab-simple'),
        document.getElementById('tab-advanced'),
      ];
      const tabPanels = {
        simple: document.getElementById('panel-simple'),
        advanced: document.getElementById('panel-advanced'),
      };
      const tabNames = ['simple', 'advanced'];

      function activateTab(name, { focus = false, persist = true } = {}) {
        if (!tabNames.includes(name)) name = 'simple';
        tabButtons.forEach((button, i) => {
          const active = tabNames[i] === name;
          button.setAttribute('aria-selected', String(active));
          button.tabIndex = active ? 0 : -1;
          tabPanels[tabNames[i]].hidden = !active;
          if (active && focus) button.focus();
        });
        applyTransportVisibility(name);
        // v18: the scope and the piano roll sit above the tab strip and are
        // never hidden by a tab change, so switching tabs no longer touches
        // the trace at all.
        if (settings.ui.activeTab !== name) {
          settings.ui.activeTab = name;
          if (persist) persistSettings();
        }
      }

      tabButtons.forEach((button, i) => {
        button.addEventListener('click', () => activateTab(tabNames[i]));
        button.addEventListener('keydown', (event) => {
          let target = null;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            target = (i + 1) % tabNames.length;
          } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            target = (i - 1 + tabNames.length) % tabNames.length;
          } else if (event.key === 'Home') {
            target = 0;
          } else if (event.key === 'End') {
            target = tabNames.length - 1;
          }
          if (target !== null) {
            event.preventDefault();
            activateTab(tabNames[target], { focus: true });
          }
        });
      });

      // ---- tracks section ------------------------------------------------

      // A default-off track (v8: melody/bass ship silent) needs its state
      // obvious at a glance, not just implied by which segmented pill is
      // lit — data-track-state drives a textual "— Off" cue in CSS so the
      // listener isn't left wondering why a track is silent. v12: the same
      // data-track-state attribute also drives the track-row lamp's dot
      // colour (off/auto/on), so the row's aria-label is refreshed here too.
      const TRACK_STATE_TEXT = { off: 'Off', auto: 'Auto', on: 'On' };

      function syncTrackOffIndicator(id) {
        const row = document.querySelector(`.track-row[data-track="${id}"]`);
        const state = settings.tracks[id].state;
        if (row) row.dataset.trackState = state;
        const lamp = document.getElementById(`track-lamp-${id}`);
        if (lamp) {
          lamp.setAttribute(
            'aria-label',
            `${TRACK_LABELS[id]} state: ${TRACK_STATE_TEXT[state] || state}. Press to cycle Off, Auto, On.`
          );
        }
      }

      // v14: the Off/Auto/On segmented control moved OUT of the row (which is
      // now a single line: lamp+name, voice, Level, Randomness, Edit) and
      // into the Edit panel header, so it exists only while that editor is
      // open. Instances register here; the row lamp is the always-present
      // state control.
      const stateControls = new Map(); // track -> { set(state) }

      function syncTrackStateUI() {
        for (const id of TRACK_IDS) {
          stateControls.get(id)?.set(settings.tracks[id].state);
          syncTrackOffIndicator(id);
        }
        updateComplexityDisplay();
      }

      function buildStateControl(container, track) {
        const group = document.createElement('div');
        group.className = 'segmented track-state';
        group.setAttribute('role', 'radiogroup');
        group.setAttribute('aria-label', `${TRACK_LABELS[track]} state`);
        const radios = [];
        for (const state of TRACK_STATE_CYCLE) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `track-state-${track}`;
          input.id = `track-${track}-${state}`;
          input.value = state;
          input.checked = settings.tracks[track].state === state;
          const label = document.createElement('label');
          label.htmlFor = input.id;
          label.textContent = TRACK_STATE_TEXT[state];
          input.addEventListener('change', () => {
            if (!input.checked) return;
            setTrackState(track, state);
          });
          group.append(input, label);
          radios.push(input);
        }
        container.append(group);
        const handle = {
          set: (state) => {
            for (const input of radios) input.checked = input.value === state;
          },
        };
        stateControls.set(track, handle);
        return handle;
      }

      // v12: single commit path for a track's state — the segmented radios
      // AND the track-row lamp button both funnel through this, so they can
      // never desync from one another.
      const TRACK_STATE_CYCLE = ['off', 'auto', 'on'];

      function setTrackState(id, state) {
        settings.tracks[id].state = state;
        engine.setParams({ tracks: { [id]: { state } } });
        updateComplexityDisplay();
        syncTrackOffIndicator(id);
        stateControls.get(id)?.set(state);
        // Off/on both move whether THIS track's own open editor may show the
        // live trace (updateScopeMode) — with no explicit chip selection the
        // scope also traces "everything that isn't off", so a state change
        // moves the front scope's default set too (updateFrontScope).
        updateScopeMode(id);
        updateFrontScope();
        persistSettings();
      }

      // Short "what does this one sound like" hints on the voice selects —
      // the kit hints the v13 round asked for, extended to every track.
      // Hoisted above the first describe() caller — `let` after the call
      // site is a temporal-dead-zone crash (shipped blank-page bug, 6105e0d).
      let tipSeq = 0;

      const VOICE_HINTS = {
        pad: 'The sustained chord bed. Warm is the default; Glass is brighter, Choir the most vocal.',
        arp: 'The broken-chord line. Soft pluck sits back, Crystal cuts through, Marimba is woody.',
        melody: 'The tune. Pluck and Keys are struck; Flute and Bell ring on.',
        bass: 'The bottom. Sub is pure weight, Round has body, Breath adds air.',
        texture: 'The atmosphere between the notes. Wash is the widest, Grains the grittiest.',
        percussion: 'The kit. Soft kit is brushed and quiet, Hand drum is warm and tuned, Ticks is a dry pulse.',
      };

      // ---- v18 voice-selector honesty ------------------------------------
      // What each track is ACTUALLY sounding, from the engine's voice wander.
      // Declared HERE, above every caller (the voices-module .then below can
      // resolve during a later await in init) — a `let`/`const` further down
      // would be a temporal-dead-zone crash, the shipped blank-page bug.
      const soundingVoice = new Map();
      const VOICE_LIVE_VALUE = '__live';

      /**
       * Wire one track row's lamp and voice selector. Extracted from the boot
       * loop below so a row appended at RUNTIME goes through the identical
       * path — the pre-mortem's fourth blocker is a user row that looks like a
       * built-in row and answers to nothing, and the only defence against it is
       * that there is one construction path, not two.
       */
      function wireTrackRowControls(id) {
        const voiceSelect = document.getElementById(`track-voice-${id}`);
        const lamp = document.getElementById(`track-lamp-${id}`);
        describe(voiceSelect, VOICE_HINTS[voiceSetOf(id)]);
        if (lamp) describe(lamp, 'Off never plays · Auto lets the generator decide · On always plays.');

        if (lamp) {
          lamp.addEventListener('click', () => {
            const cur = settings.tracks[id].state;
            const next = TRACK_STATE_CYCLE[(TRACK_STATE_CYCLE.indexOf(cur) + 1) % TRACK_STATE_CYCLE.length];
            setTrackState(id, next);
          });
        }

        // Only a user track can go: removing a built-in is a programming fault
        // engine-side, so the page never offers it as an outcome.
        const remove = document.getElementById(`track-remove-${id}`);
        if (remove) {
          remove.addEventListener('click', (event) => {
            event.stopPropagation();
            if (!engineCaps.removeTrack) return;
            try {
              engine.removeTrack(id);
            } catch {
              // A built-in, or an id this engine no longer has. Either way the
              // row goes on standing and nothing is lost.
            }
          });
          describe(remove, `Remove ${TRACK_LABELS[id] || id}. Its notes ring out first.`);
        }

        // Null-guarded since v23: TRACK_IDS is the ENGINE's live list, and a
        // preset carrying a user track this build never rendered a row for used
        // to throw here — inside init(), which is a blank page.
        if (!voiceSelect) return;
        voiceSelect.addEventListener('change', () => {
          // The dynamic "what you're hearing" option is display-only and
          // disabled, so it can never be the user's pick — but a stray
          // programmatic change event must not store it as a voice id.
          if (voiceSelect.value === VOICE_LIVE_VALUE) return;
          settings.tracks[id].voice = voiceSelect.value;
          engine.setParams({ tracks: { [id]: { voice: voiceSelect.value } } });
          persistSettings();
          soundingVoice.delete(id);
          refreshVoiceSelect(id);
          const editor = document.getElementById(`voice-editor-${id}`);
          if (editor && !editor.hidden) renderVoiceEditor(id);
        });
      }

      for (const id of TRACK_IDS) wireTrackRowControls(id);

      // ---- voice editors (v3 patch model, v5 module look) ---------------

      let voicesModulePromise = null;
      // The resolved table, kept for the synchronous readers (the v18 voice
      // selector needs .defaults / .engineType without awaiting anything).
      let voicesTable = null;
      function getVoicesTable() {
        if (!voicesModulePromise) {
          voicesModulePromise = import('../scripts/engine-voices.js')
            .then((m) => {
              voicesTable = m.VOICES || null;
              return voicesTable;
            })
            .catch(() => null);
        }
        return voicesModulePromise;
      }

      // The voice table carries the defaults and engineType the v18 selector
      // needs; it lands asynchronously, so the labels are redrawn on arrival.
      // Called BELOW getVoicesTable's own `let`s, not from the row-wiring loop
      // above them — the same temporal-dead-zone trap as everything else here.
      getVoicesTable().then(() => {
        for (const id of TRACK_IDS) refreshVoiceSelect(id);
      });

      function sendPatch(track, voiceId, patch) {
        engine.setParams({ patches: { [track]: { [voiceId]: structuredClone(patch) } } });
      }

      /**
       * A track's current effective patch (voice defaults + any stored user
       * override), the same resolution renderVoiceEditor uses to open on the
       * sound you can hear. Used outside an open editor too — the front
       * oscilloscope's stopped-state composite preview reads it per selected
       * track. Degrades to FALLBACK_PATCH + override alone if the voices
       * module hasn't landed yet (voicesTable still null).
       */
      function resolveTrackPatch(track, voiceId) {
        const voiceEntry =
          voicesTable && voicesTable[voiceSetOf(track)] && voicesTable[voiceSetOf(track)][voiceId]
            ? voicesTable[voiceSetOf(track)][voiceId]
            : null;
        const defaults = voiceEntry && voiceEntry.defaults ? voiceEntry.defaults : null;
        const base = deepMerge(FALLBACK_PATCH, defaults || {});
        const patch = deepMerge(base, (settings.patches[track] || {})[voiceId] || {});
        writeShape(patch.source, 1, readShape(patch.source, 1) ?? 0);
        writeShape(patch.source, 2, readShape(patch.source, 2));
        return patch;
      }

      // Optional v5 modules. Either can be absent or broken — the editor
      // then degrades: no knob.js → the slider/select controls below; no
      // scope.js → no scope head, knobs still work.
      let knobApi = null;
      let scopeApi = null;
      try {
      const m = await import('../scripts/knob.js');
        if (m && typeof m.createKnob === 'function') knobApi = m;
      } catch {}
      try {
      const m = await import('../scripts/scope.js');
        if (m && typeof m.renderPatchWave === 'function') scopeApi = m;
      } catch {}

      // Representative pitch for the static scope trace, per track register.
      const SCOPE_FREQ = { pad: 220, bass: 55, melody: 330, texture: 440, arp: 330, percussion: 220 };

      // ---- v6: per-track Random / Hold / Randomness + vary targets ------

      const pctFormat = (v) => `${Math.round(v * 100)}%`;
      // Typed entry on a percent dial arrives as the number the readout
      // shows ("62" for 62%); a bare fraction still works for the pedants.
      const pctParse = (n) => (n > 1 ? n / 100 : n);

      // ---- v13 tooltips + ⓘ info boxes -----------------------------------
      // Native `title` is unreachable by touch and unreliable by keyboard, so
      // compact labels get a themed tooltip shown on hover AND focus, plus a
      // visually-hidden description node the control points at with
      // aria-describedby (so the text reaches AT even when nothing is drawn).
      const tooltipEl = document.createElement('div');
      tooltipEl.className = 'ui-tooltip';
      tooltipEl.setAttribute('role', 'tooltip');
      tooltipEl.hidden = true;
      document.body.append(tooltipEl);

      function hideTooltip() {
        tooltipEl.hidden = true;
      }

      function showTooltip(el, text) {
        tooltipEl.textContent = text;
        tooltipEl.hidden = false;
        const r = el.getBoundingClientRect();
        const w = tooltipEl.offsetWidth;
        const left = clamp(r.left + r.width / 2 - w / 2, 8, Math.max(8, window.innerWidth - w - 8));
        tooltipEl.style.left = `${left + window.scrollX}px`;
        tooltipEl.style.top = `${r.bottom + window.scrollY + 6}px`;
      }

      /** Attach a hover/focus tooltip + an AT description. Returns `el`. */
      function describe(el, text) {
        if (!el || !text) return el;
        let descId = el.getAttribute('aria-describedby');
        if (!descId && el.parentNode) {
          const desc = document.createElement('span');
          desc.className = 'visually-hidden';
          desc.id = `ui-desc-${++tipSeq}`;
          desc.textContent = text;
          el.parentNode.insertBefore(desc, el.nextSibling);
          descId = desc.id;
          el.setAttribute('aria-describedby', descId);
        }
        el.addEventListener('pointerenter', () => showTooltip(el, text));
        el.addEventListener('pointerleave', hideTooltip);
        el.addEventListener('focus', () => showTooltip(el, text));
        el.addEventListener('blur', hideTooltip);
        return el;
      }

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hideTooltip();
      });

      // ---- v13 click-to-type on page-level numeric readouts ---------------
      // knob.js already does this for every dial readout. This is the same
      // gesture for the numbers the page owns outside a knob: the readout is
      // a button, clicking (or Enter/Space) swaps it for a text input, and
      // Enter/blur commits through the SAME clamp path as the control it
      // mirrors. Escape cancels. Zero cost while idle.
      function makeTypable(host, { read, commit, format, label }) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'typable';
        button.setAttribute('aria-label', label);
        const refresh = () => {
          button.textContent = format(read());
        };
        refresh();
        button.addEventListener('click', () => {
          const input = document.createElement('input');
          input.type = 'text';
          input.className = 'typable-input';
          input.setAttribute('aria-label', label);
          input.value = String(read());
          host.replaceChild(input, button);
          input.focus();
          input.select();
          const done = (save) => {
            if (input.parentNode !== host) return;
            host.replaceChild(button, input);
            const parsed = parseFloat(input.value);
            if (save && Number.isFinite(parsed)) commit(parsed);
            refresh();
            button.focus();
          };
          input.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
              event.preventDefault();
              done(true);
            } else if (event.key === 'Escape') {
              event.preventDefault();
              done(false);
            }
          });
          input.addEventListener('blur', () => done(true));
        });
        host.innerHTML = '';
        host.append(button);
        return { refresh };
      }

      /** A small ⓘ button that toggles a dismissable info box under it. */
      function infoButton(container, title, body) {
        const wrap = document.createElement('span');
        wrap.className = 'info-anchor';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'round-button info-button';
        btn.textContent = 'i';
        btn.setAttribute('aria-label', `About ${title}`);
        btn.setAttribute('aria-expanded', 'false');
        const box = document.createElement('div');
        box.className = 'info-box module-panel';
        box.hidden = true;
        box.textContent = body;
        btn.addEventListener('click', () => {
          const open = box.hidden;
          box.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        });
        box.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          box.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        });
        wrap.append(btn, box);
        container.append(wrap);
        return wrap;
      }

      /**
       * v0.0.57: the two explanations that answer a question you only ask
       * once, so neither belongs in permanent prose taking a row of height on
       * every visit. Both go behind an ⓘ beside the thing they explain.
       */
      /**
       * Preset-submission terms. The wording is the OWNER'S OWN, from the
       * 2026-07-25 rulings, and is reproduced here verbatim — it is marked
       * "do not rewrite without asking" in TODO.md, so it has been broken into
       * sentences and nothing else. It has NOT had a legal-tone read yet; that
       * gate is still open and is recorded against the v0.1.0 release.
       *
       * The anonymous checkbox beside this button exists because the terms
       * refer to it. Publishing terms that describe a control the page does
       * not have would be worse than publishing none.
       */
      const SUBMIT_TERMS = [
        'What happens to a preset you submit:',
        '',
        'During beta we may publish presets with creator credits at our discretion, unless the anonymous box is checked.',
        '',
        'We may compile presets or genres from several creators\u2019 submissions, and credit all who wish to be credited.',
        '',
        'We cannot take responsibility for similarity between such compilations and non-credited submissions, since submissions may be similar and we have no way to assess similarity for non-paying creators.',
        '',
        'Paid tiers should later allow similarity assessment, and crediting of the original submitter where the sign-up email matches the submission.',
      ].join('\n');

      const STRUCTURE_INFO = [
        'How the piece is shaped over time — which sections it moves through and how busy each one is.',
        '',
        'Auto — the piece picks its own shape, and re-picks it when you move Energy or Complexity.',
        'Drone — one continuous stretch. Nothing arrives, nothing leaves.',
        'Waves — long swells up and back down again.',
        'Build — starts sparse and adds layers as it goes.',
        'ABAB — two moods alternating, so each one returns.',
        'Journey — a longer arc that does not repeat itself.',
        'Custom — your own blocks, below: how many bars each lasts and how busy it is. They loop in order, forever.',
      ].join('\n');

      const SHARE_NAME_INFO = [
        'A preset can be called anything you like. The three words are separate: they are worked out from the settings themselves, so anyone who types them gets exactly this piece with no account and nothing stored on a server.',
        '',
        'That means two things worth knowing. Renaming a preset does not change the words. Changing any setting does — even slightly — so the words you say out loud are the words for the piece as it was when you read them.',
      ].join('\n');

      // ---- v14 randomness = the hold control ------------------------------
      // The Random button and the Hold toggle are gone: this one dial does
      // both jobs. 0 means "hold" — the engine keeps looping the material it
      // is playing now — and re-rolls scale in as the dial rises.
      const HOLD_EPSILON = 0.0001;
      const RANDOMNESS_HINT = '0 = hold: loops the current bars exactly. Higher re-rolls more often.';
      const VARIATION_HINT =
        'How much each track changes its own material. 0 holds — the bars loop exactly and nothing re-rolls or drifts. Higher re-draws plans, patches and voices more often.';
      const REPRISE_HINT =
        'How much the piece returns to what it has already played. Low gives long chord loops, fresh motifs and frequent mutation; high gives short loops, recalled motifs and reused patterns. It never stops returning entirely \u2014 the loop is eight chords at the low end, not endless.';

      function isHoldValue(v) {
        return rangeMid(sanitiseRangeValueIn(v, 0, 1, 0.5)) <= HOLD_EPSILON;
      }

      const randomnessFormat = (v) => (v <= HOLD_EPSILON ? 'Hold' : pctFormat(v));

      // ---- the Change dial's mapping (v0.0.50, consult C7) -----------------
      // The old identity map had a cliff at the bottom (0 is a literal hold —
      // an enormous audible jump) with flat, indistinguishable regions either
      // side of it. The bottom 8% of travel is now a snapped detent for the
      // hold (reachable only deliberately, aligned to the "Never" end-mark);
      // above it, randomness sweeps 0.15–0.85 and repetition 0.85–0.15 —
      // decoupled from a strict 1−x so every hook length (4–8 chords) stays
      // reachable across the useful travel instead of stacking at the ends.
      const CHANGE_DETENT = 0.08;
      function changeRandomnessFromT(t) {
        const x = clamp(t, 0, 1);
        if (x <= CHANGE_DETENT) return 0;
        return 0.15 + 0.70 * ((x - CHANGE_DETENT) / (1 - CHANGE_DETENT));
      }
      function changeRepetitionFromT(t) {
        const x = clamp(t, 0, 1);
        if (x <= CHANGE_DETENT) return 0.90; // the hold keeps a mid-length hook, not an endless loop
        return clamp(0.85 - 0.70 * ((x - CHANGE_DETENT) / (1 - CHANGE_DETENT)), 0, 1);
      }
      function changeTFromRandomness(r) {
        if (r <= HOLD_EPSILON) return 0;
        // Only a true hold may land in the detent: randomness below the
        // sweep's 0.15 floor (a genre can set any value) reads as
        // just-above-Never, not as Never — the bars there still move.
        return clamp(
          CHANGE_DETENT + (1 - CHANGE_DETENT) * ((r - 0.15) / 0.70),
          CHANGE_DETENT + 0.005,
          1
        );
      }
      // AUDIT FIX (cleanup): `mapRangeValue` WAS a second copy of `mapRV`
      // above, with a looser object test (an array would have been treated as
      // a range). One helper now, aliased so the twenty existing call sites
      // keep reading naturally at their own altitude.
      const mapRangeValue = mapRV;
      const changeFormat = (t) =>
        t <= CHANGE_DETENT ? 'Never' : pctFormat((t - CHANGE_DETENT) / (1 - CHANGE_DETENT));

      // ---- v12: Simple tab music-box dials --------------------------------
      // knob.js when available, native <input type=range> fallback when not
      // (per-dial: whichever built cleanly). Both paths funnel into the same
      // commit callback, so there's exactly one source of truth per dial —
      // no shadow/dual-wiring, no reentrancy to reason about.
      // v14 single labelling: knob.js draws the dial's own name under the
      // face, so the markup's <label> row (which exists for the no-knob
      // slider fallback) is hidden the moment a knob builds — the name then
      // appears exactly once. The end-marks (`.dial-ends`, "Slow"/"Fast" at
      // the tick extremes) live in the markup and are never removed, so a
      // failed knob build must not wipe the slot wholesale.
      /**
       * `dialId` doubles as the tab this dial lives on: the Simple slots are
       * the three without an `-adv` suffix that Simple actually renders. Only
       * those teach the spread gesture, per the note on noticeSimpleSpread.
       */
      const SIMPLE_DIAL_SLOTS = new Set(['speed-dial', 'energy-dial', 'randomness-dial', 'volume-dial']);

      function buildSimpleDial(dialId, opts, commit) {
        const box = document.getElementById(dialId);
        if (!box) return { set() {} };
        const control = box.closest('.control');
        const labelRow = control ? control.querySelector('.control-label-row') : null;
        const teaches = SIMPLE_DIAL_SLOTS.has(dialId);
        const onInput = teaches
          ? (v) => { noticeSimpleSpread(v); commit(v); }
          : commit;
        if (knobApi) {
          try {
            const handle = knobApi.createKnob(box, { ...opts, onInput });
            if (labelRow) labelRow.hidden = true;
            if (control) control.classList.add('dial-knob');
            return {
              el: handle.el,
              set: (v) => {
                try {
                  handle.set?.(v);
                } catch {}
              },
              // v0.0.56: where inside a spread the engine actually is this
              // bar. Optional on the handle because the <input type=range>
              // fallback below has nowhere to draw it.
              setLive: (v) => {
                try {
                  handle.setLive?.(v);
                } catch {}
              },
            };
          } catch {
            for (const stale of box.querySelectorAll('.knob')) stale.remove();
          }
        }
        if (control) control.classList.add('dial-fallback');
        const input = document.createElement('input');
        input.type = 'range';
        if (opts.id) input.id = opts.id;
        input.min = String(opts.min);
        input.max = String(opts.max);
        if (opts.step) input.step = String(opts.step);
        const initial = typeof opts.value === 'object' ? (opts.value.min + opts.value.max) / 2 : opts.value;
        input.value = String(initial);
        box.append(input);
        input.addEventListener('input', () => onInput(parseFloat(input.value)));
        return {
          el: input,
          set: (v) => {
            input.value = String(typeof v === 'object' ? (v.min + v.max) / 2 : v);
          },
          setLive: () => {}, // a native slider has one thumb and nowhere to mark the drift
        };
      }

      /**
       * The same dial in two places (Simple, and the foot of Advanced) as two
       * VIEWS of one value — not two params. Each view commits through the one
       * shared callback and then pushes the new value into its sibling, so
       * either can be dragged and both stay honest. The dragged view is never
       * written back to mid-gesture (that fights the pointer), which is the
       * same rule `setTempo`'s skipSpeedThumb already followed.
       */
      function buildMirroredDial(slots, opts, commit) {
        const handles = [];
        const set = (value, except) => {
          for (const handle of handles) {
            if (handle !== except) handle.set(value);
          }
        };
        for (const [slotId, suffix] of slots) {
          let handle = null;
          handle = buildSimpleDial(
            slotId,
            { ...opts, ...(opts.id ? { id: opts.id + suffix } : {}) },
            (value) => {
              commit(value);
              set(value, handle);
            }
          );
          handles.push(handle);
        }
        return {
          el: handles.length ? handles[0].el : null,
          els: handles.map((handle) => handle.el).filter(Boolean),
          set: (value) => set(value, null),
          setLive: (value) => {
            for (const handle of handles) handle.setLive?.(value);
          },
        };
      }

      /**
       * v0.0.45: the end-marks moved off the faceplate and into the tooltip.
       *
       * They used to hang under each dial as `.dial-ends`, in a caption box a
       * fixed 148px wide (--knob-size 96 + 52) centred over grid cells that
       * floor at 120px — so on the Advanced row of seven they overlapped into
       * each other and read as one run-on line: "Fast Calm Complex Hold Vary
       * Quiet". Three words on Randomness made it worse.
       *
       * Vertically with arrows, per the owner: the dial is dragged up and down,
       * so the labels should read up and down too. `\n` survives because
       * `.ui-tooltip` is `white-space: pre-line`.
       */
      function rangeHint(high, low, mid, spread) {
        const lines = [`↑ ${high}`];
        if (mid) lines.push(`  ${mid}`);
        lines.push(`↓ ${low}`);
        // v0.0.56: the third direction the dial answers to. It ships WITH the
        // horizontal-drag gesture and not a version before it — a tooltip
        // advertising a left-right drag on a dial that ignores one teaches the
        // user the control is broken, which is the exact failure the owner's
        // consistency principle is about.
        if (spread) lines.push(`↔ ${spread}`);
        return lines.join('\n');
      }

      /**
       * Tooltip for a dial: the directions it answers to first, then whatever
       * else it needs said. `spread` names what a left-right drag varies —
       * omit it only for a dial that genuinely cannot spread (an enumeration),
       * so the absence of the line means something.
       */
      function dialHint(high, low, mid, detail, spread) {
        const head = rangeHint(high, low, mid, spread);
        return detail ? `${head}\n\n${detail}` : head;
      }

      /** Attach the same tooltip/description to every view of a mirrored dial. */
      function describeDial(dial, text) {
        for (const el of dial.els || [dial.el]) describe(el, text);
        return dial;
      }

      // v0.0.50: Tempo and Complexity are Advanced-only component views now —
      // Simple drives them through Energy. Same params, same commits; one
      // slot each instead of a mirrored pair.
      speedDial = buildSimpleDial(
        'speed-dial-adv',
        {
          id: 'speed-adv',
          label: 'Tempo',
          min: 0,
          max: 1,
          step: 0.001,
          value: speedTFromBpm(settings.bpm),
          format: (t) => `${Math.round(bpmFromSpeedT(t))} bpm`,
          parse: (n) => speedTFromBpm(clamp(n, 20, 220)),
          defaultValue: speedTFromBpm(DEFAULTS.bpm),
        },
        (t) => setTempo(mapRangeValue(t, bpmFromSpeedT), { skipSpeedThumb: true, landing: 'bar' })
      );

      describeDial(speedDial, dialHint('Fast', 'Slow', null, null, 'Vary the tempo'));

      // v0.0.83 (his item 90): the Simple tab gets Tempo back. Two views of
      // the one bpm; this one lands its change on the next BEAT (v0.0.57's
      // rule: a beginner needs to hear that the thing they just dragged did
      // something), where the Advanced view lands on the barline.
      //
      // v0.0.102 — his Tempo ruling: "it's the one dial that shouldn't be
      // variable." Simple's view refuses the spread gesture and SAYS why
      // (his words asked for exactly this message), pointing at the Advanced
      // view, which keeps the sideways drag for the rare piece that wants a
      // drifting tempo. A span created in Advanced still DISPLAYS here —
      // refusing to draw state that exists would be the readout lying.
      simpleSpeedDial = buildSimpleDial(
        'speed-dial',
        {
          id: 'speed',
          label: 'Tempo',
          min: 0,
          max: 1,
          step: 0.001,
          value: speedTFromBpm(settings.bpm),
          format: (t) => `${Math.round(bpmFromSpeedT(t))} bpm`,
          parse: (n) => speedTFromBpm(clamp(n, 20, 220)),
          defaultValue: speedTFromBpm(DEFAULTS.bpm),
          allowRange: false,
          onRangeRefused: () =>
            sayUnderDials(
              'Drag the Tempo dial up or down to set the speed. Tempo holds one steady value here — ' +
                'a randomly varying tempo is rarely a good thing. If you do want it to vary, ' +
                'drag the Tempo dial sideways in the Advanced tab.',
              7000,
              { hold: true }
            ),
        },
        (t) => setTempo(mapRangeValue(t, bpmFromSpeedT), { skipSimpleThumb: true, landing: 'beat' })
      );
      describeDial(
        simpleSpeedDial,
        dialHint('Fast', 'Slow', null, 'Steady by design — vary tempo from the Advanced tab if you must.', null)
      );

      /**
       * Moving Complexity is an explicit "let the engine decide" gesture:
       * structure, arp mode and every track state return to Auto, then the
       * new complexity is sent. Shared by the Advanced dial and Energy.
       * `syncDial` pushes the value into the Complexity dial's face (Energy
       * does this; the dial's own gesture must not — that fights the pointer).
       */
      // ---- v0.0.51 (consult C5): say what the dial just did ---------------
      // The moments hardest to attribute are the discontinuities — a track
      // joining or dropping, the structure switching family. Both deciders
      // are pure engine exports, so the page can compare before/after and
      // name the difference in plain words for three seconds. The intensity
      // argument is held at 0.5 for both sides: the comparison is what the
      // GESTURE changed, not where the piece happens to be in its arc.
      const dialConfirmEl = document.getElementById('dial-confirm');
      let dialConfirmTimer = null;
      const STRUCTURE_PHRASES = {
        drone: 'Now one continuous drift',
        waves: 'Now moving in longer waves',
        build: 'Now building as it goes',
        abab: 'Now alternating two moods',
        journey: 'Now on a longer journey',
        custom: 'Now following your structure',
      };
      function dialEffectSnapshot(complexity) {
        try {
          return {
            tracks: engineModule?.autoActiveTracks?.(0.5, complexity) ?? [],
            structure: engineModule?.resolveStructure?.('auto', complexity, settings.customStructure) ?? 'auto',
          };
        } catch {
          return { tracks: [], structure: 'auto' };
        }
      }
      function flashTrackLamp(id) {
        const dot = document.querySelector(`#track-lamp-${id} .lamp-dot`);
        if (!dot) return;
        dot.classList.remove('lamp-flash');
        // Restart the animation even when the class is already gone mid-flash.
        void dot.offsetWidth;
        dot.classList.add('lamp-flash');
        setTimeout(() => dot.classList.remove('lamp-flash'), 1000);
      }
      function announceDialEffect(before, after) {
        const parts = [];
        for (const id of TRACK_IDS) {
          const was = before.tracks.includes(id);
          const is = after.tracks.includes(id);
          if (was === is) continue;
          parts.push(`${TRACK_LABELS[id]} ${is ? 'joined' : 'dropped out'}`);
          flashTrackLamp(id);
        }
        if (before.structure !== after.structure) {
          parts.push(STRUCTURE_PHRASES[after.structure] || 'New shape');
        }
        if (!parts.length) return;
        sayUnderDials(parts.join(' · '));
      }

      /**
       * The line under the Simple dials. One surface, one timer.
       *
       * `hold` marks a message that must not be overwritten while it is up.
       * Without it the teaching line loses a race it should win: opening a
       * spread on Energy also moves complexity, whose own 120 ms-debounced
       * commit announces "Arp joined" — so the explanation of a gesture the
       * user may not have meant to make was replaced, a tenth of a second
       * later, by a side effect of it.
       */
      let dialConfirmHeldUntil = 0;
      function sayUnderDials(text, ms = 3000, { hold = false } = {}) {
        if (!dialConfirmEl) return;
        if (!hold && Date.now() < dialConfirmHeldUntil) return;
        dialConfirmHeldUntil = hold ? Date.now() + ms : 0;
        dialConfirmEl.textContent = text;
        dialConfirmEl.classList.add('shown');
        if (dialConfirmTimer !== null) clearTimeout(dialConfirmTimer);
        dialConfirmTimer = setTimeout(() => {
          dialConfirmTimer = null;
          dialConfirmHeldUntil = 0;
          dialConfirmEl.classList.remove('shown');
          dialConfirmEl.textContent = '';
        }, ms);
      }

      /**
       * v0.0.57: the first time a spread is opened on the SIMPLE tab, say what
       * just happened.
       *
       * Two owner instructions had to be reconciled here. On 2026-07-27 he was
       * "worried that horizontal drag to open the min-max interface would
       * confuse new players" and asked for a message instead of an action on
       * Simple. On 2026-07-28 he asked for the opposite in stronger terms —
       * "everything should be spreadable with horizontal drag" — which is the
       * consistency principle, and a dial that refuses the gesture on one tab
       * teaches that the gesture does nothing anywhere.
       *
       * So the gesture works everywhere and Simple explains it, once, at the
       * moment it first happens. That satisfies the later instruction and
       * still answers the worry behind the earlier one: a new player who did
       * not mean to do it is told what they did and how to undo it, rather
       * than being silently refused.
       */
      let spreadTaught = false;
      function noticeSimpleSpread(value) {
        if (spreadTaught || !isPlainObject(value)) return;
        spreadTaught = true;
        sayUnderDials(
          'Dragging sideways gives that dial a range to drift between. Drag back the other way to settle it on one value, or tap the middle to start again.',
          7000,
          { hold: true }
        );
      }

      function commitComplexityAuto(value, { syncDial = false } = {}) {
        // v0.0.56: `value` may be a {min,max} span. The engine takes it whole
        // and walks it; the "what did that just do" announcement needs a
        // single number to compare two snapshots with, and the midpoint is
        // where the span sits on average.
        const effectBefore = dialEffectSnapshot(rangeMid(settings.complexity));
        settings.complexity = value;
        settings.structure = 'auto';
        settings.arp.mode = 'auto';
        for (const id of TRACK_IDS) settings.tracks[id].state = 'auto';
        syncStructureUI();
        syncArpUI();
        syncTrackStateUI();
        const trackStates = {};
        for (const id of TRACK_IDS) trackStates[id] = { state: 'auto' };
        engine.setParams({
          complexity: value,
          structure: 'auto',
          arp: { mode: 'auto' },
          tracks: trackStates,
        });
        if (syncDial) complexityDial?.set(value);
        // AUDIT FIX: the Energy dial is the OTHER view of this value — an
        // Advanced Complexity edit left it stale, so the next Energy touch
        // jumped the sound to wherever the dial had been left. Mid-gesture
        // writes are skipped (that would fight the pointer that is causing
        // this very commit).
        if (!dialDragging(energyDial)) {
          energyDial?.set(mapRangeValue(value, energyFromComplexity));
        }
        // Energy stage 1c: while the kit is still the genre's own, the dial
        // re-shapes it VISIBLY (recompiled, written to the grid) — soft kicks
        // and thinned hats below the midpoint, the genre's identity lane kept.
        followGenreKit(value);
        announceDialEffect(effectBefore, dialEffectSnapshot(rangeMid(value)));
        persistSettings();
      }
      const commitComplexityDebounced = trailingDebounce(commitComplexityAuto, 120);

      complexityDial = buildSimpleDial(
        'complexity-dial-adv',
        {
          id: 'complexity-adv',
          label: 'Complexity',
          min: 0,
          max: 1,
          step: 0.01,
          value: settings.complexity,
          format: pctFormat,
            parse: pctParse,
          defaultValue: DEFAULTS.complexity,
        },
        // Debounced (C8): the commit redraws the plan and resets the banks,
        // so a drag must land once, not once per pointer move.
        (value) => commitComplexityDebounced(value)
      );

      describeDial(complexityDial, dialHint('Complex', 'Calm', null, null, 'Vary how much is going on'));

      // ---- Energy (Simple tab): the macro itself --------------------------
      energyDial = buildSimpleDial(
        'energy-dial',
        {
          id: 'energy',
          label: 'Energy',
          min: 0,
          max: 1,
          step: 0.001,
          value: mapRangeValue(settings.complexity, energyFromComplexity),
          format: pctFormat,
            parse: pctParse,
          defaultValue: ENERGY_DEFAULT,
        },
        (e) => {
          // v0.0.71: no tempo. Energy is how much is going on; the tempo is a
          // property of the piece, and moving it under someone who did not ask
          // is what the owner objected to.
          // v0.0.57: `e` may be a span, and BOTH halves of the macro have to
          // map through it. Missing this on the complexity half fed NaN into
          // commitComplexityAuto, which is why a sideways drag on Energy came
          // out as a value change: the dial got written back from a poisoned
          // settings tree a frame later.
          commitComplexityDebounced(mapRangeValue(e, complexityFromEnergy), { syncDial: true });
        }
      );
      describeDial(
        energyDial,
        dialHint(
          'Lively',
          'Calm',
          null,
          'One dial for how much is going on: it moves Tempo and Complexity together — watch them follow on Advanced. Moving it also lets the engine choose the structure and tracks again, so hand-set track switches return to Auto.',
          'Vary the energy'
        )
      );

      // Advanced's Reprise dial owns `repetition` alone (v0.0.35). It updates the
      // Simple tab's fused read-out, because that dial genuinely blends both —
      // but it no longer touches the Advanced Variation dial, which is the
      // coupling that made the two read as one control.
      repetitionDial = buildSimpleDial(
        'repetition-dial',
        {
          id: 'repetition',
          label: 'Reprise',
          min: 0,
          max: 1,
          step: 0.01,
          value: settings.repetition,
          format: pctFormat,
            parse: pctParse,
          defaultValue: DEFAULTS.repetition,
        },
        (value) => {
          settings.repetition = value;
          engine.setParams({ repetition: value });
          randomnessDial?.set(changeDialValueFromState());
          persistSettings();
        }
      );
      describeDial(repetitionDial, dialHint('Always', 'Rarely', null, REPRISE_HINT, 'Vary how much it reprises'));

      // ONE dial for "how much does this thing change" (user decision, v15):
      // Repetitive ← Evolving → Random. It drives BOTH halves of that
      // question in a single setParams: repetition = 1 - x (tight hook at 0,
      // loose at 1) and every track's randomness = x (perfect-loop hold at 0,
      // maximal wander at 1). Advanced still exposes the two separately; when
      // they're hand-set to a pair no single x could produce, this dial just
      // shows the blended estimate (fusedRandomnessValue) without touching
      // them — the same interlink manners as Complexity.
      //
      // Range capability is asymmetric on purpose: tracks[t].randomness is a
      // genuine RangeValue, but repetition is a top-level engine param and
      // ambient-engine.js's NUMERIC_RANGES only accept plain numbers there.
      // So a range from this dial is written verbatim to every track's
      // randomness, and repetition takes 1 - (midpoint of that range).
      /** Write one randomness value to every track. Shared by both dials below. */
      function writeAllTrackRandomness(value) {
        const trackStates = {};
        for (const id of TRACK_IDS) {
          settings.tracks[id].randomness = value;
          settings.tracks[id].hold = isHoldValue(value);
          trackStates[id] = { randomness: value, hold: settings.tracks[id].hold };
        }
        return trackStates;
      }

      // SIMPLE tab: the fused macro, renamed Change (v0.0.50 — people do not
      // think in terms of "randomness", but they absolutely think in terms of
      // "does it stay the same or keep moving on"). One dial for "how much
      // does this change", deliberately driving both halves at once — that is
      // what makes the Simple tab simple. The dial position runs through the
      // C7 mapping above; the engine params it writes are what they were.
      randomnessDial = buildSimpleDial(
        'randomness-dial',
        {
          id: 'randomness',
          label: 'Change',
          min: 0,
          max: 1,
          step: 0.01,
          marks: [CHANGE_DETENT, 0.5, 1],
          value: changeDialValueFromState(),
          format: changeFormat,
          allowRange: true,
          defaultValue: changeTFromRandomness(
            rangeMid(sanitiseRangeValueIn(DEFAULTS.tracks.pad.randomness, 0, 1, 0.5))
          ),
        },
        (t) => {
          const tMid = rangeMid(sanitiseRangeValueIn(t, 0, 1, 0.5));
          const repetition = changeRepetitionFromT(tMid);
          const randomness = mapRangeValue(t, changeRandomnessFromT);
          settings.repetition = repetition;
          const trackStates = writeAllTrackRandomness(randomness);
          engine.setParams({ repetition, tracks: trackStates });
          repetitionDial?.set(repetition);
          variationDial?.set(randomness);
          syncAllTrackExtras();
          persistSettings();
        }
      );
      describeDial(
        randomnessDial,
          dialHint('Often', 'Never', 'Now and then', 'How much the music moves on rather than staying the same. At the very bottom it never changes — the bars loop exactly. On this tab it sets reprise and every track’s variation together; Advanced separates them.', 'Vary how much it changes')
      );

      // ADVANCED tab: Variation owns the tracks' randomness and NOTHING else
      // (v0.0.35 de-fuse). It no longer writes repetition, and it reads the
      // tracks' own value rather than a blend that repetition can move.
      variationDial = buildSimpleDial(
        'randomness-dial-adv',
        {
          id: 'randomness-adv',
          label: 'Variation',
          min: 0,
          max: 1,
          step: 0.01,
          marks: [0, 0.5, 1],
          value: trackRandomnessValue(),
          format: randomnessFormat,
          allowRange: true,
          defaultValue: DEFAULTS.tracks.pad.randomness,
        },
        (value) => {
          const trackStates = writeAllTrackRandomness(value);
          engine.setParams({ tracks: trackStates });
          randomnessDial?.set(changeDialValueFromState());
          syncAllTrackExtras();
          persistSettings();
        }
      );
      describeDial(variationDial, dialHint('Vary', 'Hold', null, VARIATION_HINT, 'Vary how much it varies'));

      // v0.0.39: the line that used to sit under the dial grid as permanent
      // prose. It answers a question you only ask once — why some of these
      // dials also appear on Simple — so it belongs behind an ⓘ, not in the
      // panel taking a row of height on every visit.
      {
        const infoHost = document.getElementById('advanced-dials-info');
        if (infoHost) {
          infoButton(
            infoHost,
            'these dials',
            "Tempo and Volume are the same values as the Simple tab — two views, one setting (Simple's Tempo lands on the next beat, this one on the barline). Energy on Simple drives Complexity here. Variation and Reprise are separate here: Simple fuses them into its one Change dial."
          );
        }
      }

      /**
       * v0.0.47 volume taper. Loudness roughly doubles per +10 dB, so perceived
       * loudness goes as gain^0.6 — which means a LINEAR fader is compressive:
       * the top half of its travel barely changes anything, and all the useful
       * resolution is squashed into the bottom. Position^1.7 undoes that, so
       * half travel is about half as loud.
       *
       * This is a UI mapping only. `params.volume` is stored and sent exactly as
       * before, so every share link and saved preset sounds identical — only
       * where the pointer sits for a given loudness changes.
       */
      /**
       * v0.0.58 — the volume fader law, replacing `param = t^1.7`.
       *
       * The consult measured the top of the old taper as inaudible: the last
       * three 10% steps gave 1.97, 1.74 and 1.56 dB against a 2 dB floor, so
       * moving a nearly-full dial did nothing anyone could hear. That is
       * inherent to a power law rather than a tuning error — dB = 20n·log₁₀(t),
       * so a step near the top is a small RATIO and therefore few dB however
       * the exponent is set.
       *
       * The TODO's own suggestion, an exponent nearer 1.5, would have made it
       * worse: the top step is 0.916·n dB, so 1.7 → 1.56 dB and 1.5 → 1.37 dB.
       * Lowering the exponent lowers exactly the thing that was too small.
       *
       * So this is a fader law instead: dB linear in dial travel, in two
       * segments, which is what a real console fader does and for this reason.
       * The top half spends 20 dB over its travel (4 dB per 10%), the bottom
       * half spends the remaining 40 (8.3 dB per 10%), and below 2% the dial
       * is off. Every step is comfortably above the audible floor, and the
       * useful listening range gets half the travel instead of the top sliver.
       *
       * `params.volume` is untouched by any of this — it is a dial-position
       * mapping only, so a stored preset plays at exactly the loudness it
       * always did. Only where the thumb SITS for that loudness changes.
       *
       * tests/energy-measure.mjs keeps its own copy of this function (it
       * cannot import an Astro component). If these numbers move, that copy
       * must move with them or the suite measures a mapping nobody ships.
       */
      const VOL_MUTE_T = 0.02;   // below this the dial reads as off
      const VOL_KNEE_T = 0.5;    // where the law changes slope
      const VOL_KNEE_DB = -20;   // dB at the knee
      const VOL_FLOOR_DB = -60;  // dB at the bottom of the usable travel

      const volumeParamFromDial = (t) => {
        const x = clamp(Number(t) || 0, 0, 1);
        if (x < VOL_MUTE_T) return 0;
        const db = x >= VOL_KNEE_T
          ? (VOL_KNEE_DB * (1 - x)) / (1 - VOL_KNEE_T)
          : VOL_KNEE_DB + ((VOL_FLOOR_DB - VOL_KNEE_DB) * (VOL_KNEE_T - x)) / (VOL_KNEE_T - VOL_MUTE_T);
        return clamp(Math.pow(10, db / 20), 0, 1);
      };

      const volumeDialFromParam = (v) => {
        const amp = clamp(Number(v) || 0, 0, 1);
        if (amp <= 0) return 0;
        const db = 20 * Math.log10(amp);
        if (db >= VOL_KNEE_DB) {
          return clamp(1 - (db * (1 - VOL_KNEE_T)) / VOL_KNEE_DB, 0, 1);
        }
        if (db <= VOL_FLOOR_DB) return 0;
        return clamp(
          VOL_KNEE_T - ((db - VOL_KNEE_DB) * (VOL_KNEE_T - VOL_MUTE_T)) / (VOL_FLOOR_DB - VOL_KNEE_DB),
          0,
          1
        );
      };

      // v0.0.50: still one value with two views, but the views READ
      // differently \u2014 dB is jargon, so Simple prints a plain percentage of
      // dial travel while Advanced keeps the hi-fi attenuator convention.
      // Mirroring is by hand here because buildMirroredDial gives both views
      // the same format.
      {
        const volumeOpts = {
          min: 0,
          max: 1,
          step: 0.01,
          value: volumeDialFromParam(settings.volume),
          marks: [0, 0.5, 1],
          defaultValue: volumeDialFromParam(DEFAULTS.volume),
        };
        const commitVolume = (t) => {
          // The dial position is tapered, and the taper is monotonic, so
          // mapping each end of a span independently keeps min ≤ max.
          const value = mapRangeValue(t, volumeParamFromDial);
          settings.volume = value;
          engine.setParams({ volume: value });
          persistSettings();
        };
        let volumeSimple = null;
        let volumeAdv = null;
        volumeSimple = buildSimpleDial(
          'volume-dial',
          { ...volumeOpts, id: 'volume', label: 'Volume', format: pctFormat, parse: pctParse },
          (t) => {
            commitVolume(t);
            volumeAdv?.set(t);
          }
        );
        volumeAdv = buildSimpleDial(
          'volume-dial-adv',
          {
            ...volumeOpts,
            id: 'volume-adv',
            label: 'Volume',
            // dB relative to full output; the dial position is tapered, so
            // the readout converts back first.
            // v0.0.69: the top of the dial reads −0.0 dB, not 0.0 dB. A fader
            // attenuates and never boosts, and the minus sign is what says so
            // — at unity the reading is "no attenuation", which is a different
            // statement from "zero decibels of gain".
            // Typed entry mirrors the readout's unit: decibels of
            // attenuation ("-6" or "6" both mean 6 dB down), mapped back
            // through the taper.
            parse: (n) => volumeDialFromParam(Math.pow(10, -Math.abs(n) / 20)),
            format: (t) => {
              const v = volumeParamFromDial(t);
              if (v <= 0.001) return '-\u221e dB';
              const db = 20 * Math.log10(v);
              const text = Math.abs(db).toFixed(v > 0.5 ? 1 : 0);
              return `-${text} dB`;
            },
          },
          (t) => {
            commitVolume(t);
            volumeSimple?.set(t);
          }
        );
        volumeDial = {
          el: volumeSimple.el || volumeAdv.el,
          els: [volumeSimple.el, volumeAdv.el].filter(Boolean),
          set: (t) => {
            volumeSimple.set(t);
            volumeAdv.set(t);
          },
        };
      }

      // v0.0.46: the BPM readout went with the slider it belonged to — the Tempo
      // dial already prints "52 bpm" under its own face and is click-to-type in
      // its own right, so a second editable number for the same value was one
      // too many. Guarded rather than deleted because a future layout may want
      // the standalone readout back.
      bpmTypable = bpmReadout
        ? makeTypable(bpmReadout, {
            read: () => settings.bpm,
            commit: (v) => setTempo(v),
            format: (v) => String(v),
            label: 'Beats per minute — click to type a value',
          })
        : null;

      describeDial(volumeDial, dialHint('Loud', 'Quiet', null, null, 'Vary the level'));

      // ---- v14 Swing (global; Advanced tab) -------------------------------
      // Only rendered when the engine advertises the param — a dial that
      // visibly does nothing is worse than no dial.
      if (engineCaps.swing) {
        const swingControl = document.getElementById('dial-swing');
        if (swingControl) swingControl.hidden = false;
        swingDial = buildSimpleDial(
          'swing-dial',
          {
            id: 'swing',
            label: 'Swing',
            min: 0,
            max: 1,
            step: 0.01,
            value: settings.swing,
            format: (v) => (v <= 0.005 ? 'Straight' : pctFormat(v)),
            defaultValue: DEFAULTS.swing,
          },
          (value) => {
            settings.swing = value;
            engine.setParams({ swing: value });
            persistSettings();
          }
        );
        describe(
          swingDial.el,
          dialHint('Swung', 'Straight', null,
            'Delays every off-beat subdivision — straight at 0, a classic long-short shuffle at the top. Sequencers, arp and percussion all follow it.',
            'Vary the swing')
        );
      }

      // ---- v21 reverb tail (global; Advanced tab) --------------------------
      // 0.5–6 s of impulse response. The engine owns the initial value — the
      // page never invents one, so a build that has no reverbTail param yet
      // renders no dial rather than a dial that lies. The power governor caps
      // the tail on top (see applyPowerBudget): the USER's setting is what is
      // stored and shown, the capped value is only what the engine is sent.
      if (engineCaps.reverbTail || engineCaps.setReverbSeconds) {
        const control = document.getElementById('dial-reverb-tail');
        if (control) control.hidden = false;
        const shipped = engineReverbTail ?? 2;
        const stored = typeof settings.reverbTail === 'number' && Number.isFinite(settings.reverbTail)
          ? clamp(settings.reverbTail, 0.5, 6)
          : shipped;
        settings.reverbTail = stored;
        reverbTailDial = buildSimpleDial(
          'reverb-tail-dial',
          {
            id: 'reverbTail',
            label: 'Reverb tail',
            min: 0.5,
            max: 6,
            step: 0.1,
            value: stored,
            format: (v) => `${plainFormat(v)} s`,
            defaultValue: shipped,
          },
          (value) => {
            settings.reverbTail = mapRangeValue(value, (v) => clamp(v, 0.5, 6));
            applyReverbTail();
            persistSettings();
          }
        );
        describe(
          reverbTailDial.el,
          dialHint('Cathedral', 'Room', null,
            'How long the reverb rings on. Eco and Low processor settings shorten it whatever this says.',
            'Vary the tail')
        );
        applyReverbTail();
      }

      // ---- v21 chord length (harmony.rhythm; Advanced tab, near Structure) --
      /**
       * v0.0.68 — the chord progression, visible and editable.
       *
       * Step two of the agreed plan and the biggest thing a user could not
       * touch: the app chose the chords and showed them nowhere you could
       * change them. The engine has taken a hand-written loop since v26
       * (`harmony.seed`) and nothing in the page ever wrote one.
       *
       * The vocabulary is roman numerals, which is deliberate rather than
       * convenient: it is the same language the genre files are written in, so
       * a user editing chords here is speaking exactly what I wrote the twelve
       * genres in. Lower case is a minor degree, upper case major, and a 7 or
       * a 9 on the end widens the chord.
       *
       * Empty means the app is choosing, which is the state everything ships
       * in — so this control has to READ as "nothing set" rather than as an
       * empty box someone has to fill before the app works.
       *
       * KNOWN GAP, stated rather than hidden: the degree is what the engine
       * stores, so what a numeral SOUNDS like depends on the scale. Change the
       * scale and the same loop is re-coloured. That is the engine's model and
       * this control does not paper over it — the hint says so.
       */
      const PROGRESSION_INFO = [
        'The chord loop the piece keeps coming back to. Leave it empty and the app writes one for you, which is what it does today.',
        '',
        'Every chord in the loop has a card of its own. Press one to hear it, and the notes it plays are printed on it — you never have to be able to imagine a chord from its name.',
        '',
        'The arrows move a chord through the scale and the button beside them makes it wider (a triad, a 7th, a 9th). Hear the loop plays them all in order.',
        '',
        'Chords are written as numbers of the scale, in roman numerals — the same way the built-in styles are written. I is the home chord, IV and V are the two it leans on most.',
        '',
        'Small letters are minor, capitals are major: i is a minor home chord, I a major one. Add a 7 or a 9 for a wider, jazzier chord.',
        '',
        'So "i VI III VII" is a common minor loop, and "I IV V IV" is about as ordinary as music gets.',
      ].join('\n');

      const PROGRESSION_MAX = 8;
      const progressionControl = document.getElementById('control-progression');
      const progressionRow = document.getElementById('progression-row');
      const progressionChords = document.getElementById('progression-chords');
      const progressionHint = document.getElementById('progression-hint');

      /**
       * v0.0.76 — the audible half of chord editing.
       *
       * His amendment to step 2, verbatim: "that only works for people who can
       * hear chords in their head when they see the names, we need an audible
       * version of this with a nice visual manipulator for those who can't."
       *
       * v0.0.68 shipped the names, which was his own instruction and the right
       * first move — it is the vocabulary the twelve genres are written in. But
       * a numeral is a name for a sound, and naming a sound to someone who
       * cannot summon it is not showing it to them. So each chord in the loop
       * is now a chip you can PRESS TO HEAR, showing the notes it actually
       * contains in the current key, with the degree and the colour moved by
       * buttons rather than by typing.
       *
       * The text field stays. It is faster for anyone fluent in numerals, and
       * deleting the expert route to serve the beginner is the trade this
       * project keeps refusing to make.
       *
       * Everything here is DERIVED. The stored loop is degrees, exactly as
       * before; the notes shown are what those degrees mean in the scale and
       * root currently set, recomputed whenever either changes. Nothing new is
       * persisted, so a share link written before this version reads the same.
       */
      const CHORD_PREVIEW_TRACK = 'pad';
      const CHORD_PREVIEW_SECONDS = 1.1;
      const CHORD_PREVIEW_GAP = 0.42;
      let chordPreviewTimer = null;
      let chordPreviewHeld = [];

      /** The scale the engine is actually playing, as a degree array. */
      function currentScale() {
        const scales = engineModule && engineModule.SCALES;
        if (!scales) return null;
        return scales[settings.mode] || scales.minor || null;
      }

      /**
       * One seed slot as the MIDI notes it sounds, voiced upward from a low
       * pad octave with no crossings — the same shape the engine's own
       * chordMidis builds, because a preview that voiced it differently would
       * be teaching the wrong sound.
       */
      function slotMidis(slot) {
        const scale = currentScale();
        const voice = engineModule && engineModule.voiceHookChord;
        const toMidi = engineModule && engineModule.scaleDegreeToMidi;
        const pc = engineModule && engineModule.pitchClass;
        if (!scale || !voice || !toMidi || !pc) return [];
        const degrees = voice(slot.degree, clamp(rangeMid(settings.complexity), 0, 1), {
          extension: slot.extension,
          scaleLength: scale.length,
        }).slice(0, 4);
        const rootPc = pc(settings.root) ?? 0;
        const midis = [];
        let previous = -Infinity;
        for (const degree of degrees) {
          let midi = toMidi(degree, scale, rootPc, 3);
          while (midi <= previous) midi += 12;
          previous = midi;
          midis.push(midi);
        }
        return midis;
      }

      /** The chord's honest name, from the semitones it actually contains. */
      function slotChordName(midis) {
        const name = engineModule && engineModule.nameChord;
        if (!name || !midis.length) return '';
        // The engine spells accidentals with an ASCII #, which is right for a
        // wire format and wrong beside a note list that uses ♯. One spelling
        // on screen.
        return name(midis[0] % 12, midis.map((m) => m - midis[0])).replace(/#/g, '♯');
      }

      function stopChordPreview() {
        if (chordPreviewTimer) {
          clearTimeout(chordPreviewTimer);
          chordPreviewTimer = null;
        }
        for (const midi of chordPreviewHeld) {
          try { engine.noteOff(CHORD_PREVIEW_TRACK, midi); } catch {}
        }
        chordPreviewHeld = [];
        if (progressionChords) {
          for (const chip of progressionChords.querySelectorAll('.chord-chip-sounding')) {
            chip.classList.remove('chord-chip-sounding');
          }
        }
      }

      /**
       * Sound one chord. Uses the SAME live-note path a played key uses, so
       * the preview is the piece's own pad voice rather than a second synth
       * that would drift out of agreement with it.
       */
      function playChord(midis, chip) {
        stopChordPreview();
        if (!midis.length) return;
        try { if (typeof engine.arm === 'function') engine.arm(); } catch {}
        let sounded = 0;
        for (const midi of midis) {
          try {
            if (engine.noteOn(CHORD_PREVIEW_TRACK, midi, 0.7) === true) {
              chordPreviewHeld.push(midi);
              sounded += 1;
            }
          } catch {}
        }
        if (!sounded) {
          // The audio graph is not up yet and nothing was heard. Say so rather
          // than leave a button that looks like it worked.
          if (progressionHint) {
            progressionHint.textContent =
              'Press Play once and the chord buttons will sound — the audio has not started yet.';
          }
          return;
        }
        if (chip) chip.classList.add('chord-chip-sounding');
        chordPreviewTimer = setTimeout(stopChordPreview, CHORD_PREVIEW_SECONDS * 1000);
      }

      /** The whole loop, in order, one chord after another. */
      function playProgression(slots, chips) {
        stopChordPreview();
        let i = 0;
        const step = () => {
          if (i >= slots.length) return;
          const index = i;
          i += 1;
          playChord(slotMidis(slots[index]), chips[index]);
          chordPreviewTimer = setTimeout(() => {
            stopChordPreview();
            chordPreviewTimer = setTimeout(step, CHORD_PREVIEW_GAP * 250);
          }, CHORD_PREVIEW_SECONDS * 1000);
        };
        step();
      }

      /** The stored loop as slots, or null when the app is choosing. */
      function progressionSlots() {
        const seed = settings.harmony && settings.harmony.seed;
        if (!Array.isArray(seed) || !seed.length) return null;
        const scale = currentScale();
        const length = scale ? scale.length : 7;
        return seed.map((entry) => {
          if (entry && typeof entry === 'object') {
            return {
              degree: clamp(Math.round(entry.degree ?? 0), 0, length - 1),
              extension: clamp(Math.round(entry.extension ?? 0), -1, 1),
            };
          }
          const text = String(entry);
          const match = /^([ivIV]+)(.*)$/.exec(text.trim());
          const degree = match ? NUMERALS.indexOf(match[1].toLowerCase()) : -1;
          const suffix = match ? match[2] : '';
          return {
            degree: degree === -1 ? 0 : clamp(degree, 0, length - 1),
            extension: /9|11|13/.test(suffix) ? 1 : /7/.test(suffix) ? 0 : -1,
          };
        });
      }

      /** Write a whole loop of slots back, in the form the engine stores. */
      function commitSlots(slots) {
        commitProgression(slots.map(slotToNumeral).join(' '));
      }

      /** The stored loop as display text, or '' when the app is choosing. */
      function progressionText() {
        const seed = settings.harmony && settings.harmony.seed;
        if (!Array.isArray(seed) || !seed.length) return '';
        return seed.map(slotToNumeral).join(' ');
      }

      const NUMERALS = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii'];

      /** A stored slot back into the numeral a person reads. */
      function slotToNumeral(slot) {
        if (typeof slot === 'string') return slot;
        if (!slot || typeof slot !== 'object') return 'i';
        const base = NUMERALS[clamp(Math.round(slot.degree ?? 0), 0, 6)];
        const ext = Math.round(slot.extension ?? 0);
        return ext >= 1 ? `${base}9` : ext === 0 ? `${base}7` : base;
      }

      function commitProgression(text) {
        const tokens = String(text || '').trim().split(/[\s,]+/).filter(Boolean).slice(0, PROGRESSION_MAX);
        const seed = tokens.length ? tokens : null;
        settings.harmony = { ...settings.harmony, seed };
        engine.setParams({ harmony: { seed } });
        persistSettings();
        // Re-read from the engine rather than trusting the typing: the seed law
        // silently keeps the stored loop for anything the current scale cannot
        // play, and a control that showed the rejected text would be lying.
        try {
          const live = engine.getParams()?.harmony?.seed;
          settings.harmony.seed = Array.isArray(live) && live.length ? live : null;
        } catch {}
        renderProgression();
      }

      /**
       * The visual manipulator: one chip per chord, showing what it sounds
       * like rather than only what it is called.
       */
      function renderChordChips() {
        if (!progressionChords) return;
        stopChordPreview();
        progressionChords.replaceChildren();
        const slots = progressionSlots();
        const scale = currentScale();
        progressionChords.hidden = !slots || !scale;
        if (!slots || !scale) return;

        const chips = [];
        slots.forEach((slot, index) => {
          const midis = slotMidis(slot);
          const chip = document.createElement('div');
          chip.className = 'chord-chip';
          chips.push(chip);

          // Pressing the chord itself is the primary act, so it is the whole
          // face of the chip rather than a small icon on it.
          const hear = document.createElement('button');
          hear.type = 'button';
          hear.className = 'chord-chip-hear';
          const numeral = document.createElement('span');
          numeral.className = 'chord-chip-numeral';
          numeral.textContent = slotToNumeral(slot);
          const named = document.createElement('span');
          named.className = 'chord-chip-name';
          named.textContent = slotChordName(midis);
          const notes = document.createElement('span');
          notes.className = 'chord-chip-notes';
          notes.textContent = midis.map(pitchName).join(' ');
          hear.append(numeral, named, notes);
          hear.setAttribute(
            'aria-label',
            `Hear chord ${index + 1} of ${slots.length}: ${slotToNumeral(slot)}, ` +
            `${slotChordName(midis)}, the notes ${midis.map(pitchName).join(', ')}`
          );
          hear.addEventListener('click', () => playChord(slotMidis(slot), chip));
          chip.append(hear);

          const tools = document.createElement('div');
          tools.className = 'chord-chip-tools';

          // Up and down move the chord through the scale. Wrapping rather than
          // stopping: a loop of degrees has no top or bottom, and a button
          // that goes dead at the ends reads as broken.
          const stepDegree = (delta) => {
            const next = slots.map((s, i) => (i === index
              ? { ...s, degree: ((s.degree + delta) % scale.length + scale.length) % scale.length }
              : s));
            commitSlots(next);
            const chipsAfter = progressionChords.querySelectorAll('.chord-chip');
            playChord(slotMidis(next[index]), chipsAfter[index] || null);
          };
          for (const [glyph, delta, what] of [['▲', 1, 'up'], ['▼', -1, 'down']]) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'chord-chip-step';
            button.textContent = glyph;
            button.setAttribute('aria-label', `Move chord ${index + 1} one step ${what} the scale`);
            button.addEventListener('click', () => stepDegree(delta));
            tools.append(button);
          }

          // The colour cycle. Three states, in the order they widen, and the
          // button says which one it is IN rather than which it will go to —
          // a control that names its own next state is a control you have to
          // press to find out where you are.
          const colour = document.createElement('button');
          colour.type = 'button';
          colour.className = 'chord-chip-colour';
          const COLOURS = [[-1, 'triad'], [0, '7th'], [1, '9th']];
          const at = COLOURS.findIndex(([value]) => value === slot.extension);
          colour.textContent = COLOURS[at === -1 ? 0 : at][1];
          colour.setAttribute(
            'aria-label',
            `Chord ${index + 1} is a ${COLOURS[at === -1 ? 0 : at][1]}. Press to widen it.`
          );
          colour.addEventListener('click', () => {
            const next = slots.map((s, i) => (i === index
              ? { ...s, extension: COLOURS[((at === -1 ? 0 : at) + 1) % COLOURS.length][0] }
              : s));
            // The extension is a NUDGE relative to complexity, not an absolute
            // width — the engine's own design, and it means a widen can land
            // on the chord you already had. Say so when it does. A button that
            // silently changes nothing is the exact thing this app keeps
            // ruling against, and the honest fix is to name the reason rather
            // than to hide the button.
            const wasNotes = midis.join(',');
            const nowNotes = slotMidis(next[index]).join(',');
            commitSlots(next);
            const chipsAfter = progressionChords.querySelectorAll('.chord-chip');
            playChord(slotMidis(next[index]), chipsAfter[index] || null);
            if (wasNotes === nowNotes && progressionHint) {
              progressionHint.textContent =
                'That chord is written wider, but it sounds the same here: how wide chords actually get is decided by Complexity, and this one is already as wide as Complexity allows. Raise Complexity to hear the difference.';
            }
          });
          tools.append(colour);

          // Removing a chord is deliberately last and deliberately quiet.
          const drop = document.createElement('button');
          drop.type = 'button';
          drop.className = 'chord-chip-drop';
          drop.textContent = '×';
          drop.setAttribute('aria-label', `Remove chord ${index + 1}`);
          drop.disabled = slots.length <= 1;
          drop.addEventListener('click', () => commitSlots(slots.filter((_, i) => i !== index)));
          tools.append(drop);

          chip.append(tools);
          progressionChords.append(chip);
        });

        const trailing = document.createElement('div');
        trailing.className = 'chord-chip-trailing';

        const add = document.createElement('button');
        add.type = 'button';
        add.className = 'secondary-button chord-chip-add';
        add.textContent = 'Add a chord';
        add.disabled = slots.length >= PROGRESSION_MAX;
        // A new chord copies the last one rather than arriving as the tonic:
        // it is the note you were just listening to, so what you hear when it
        // appears is what you were already hearing.
        add.addEventListener('click', () => commitSlots([...slots, { ...slots[slots.length - 1] }]));
        trailing.append(add);

        const hearAll = document.createElement('button');
        hearAll.type = 'button';
        hearAll.className = 'secondary-button chord-chip-all';
        hearAll.textContent = 'Hear the loop';
        hearAll.addEventListener('click', () => playProgression(slots, chips));
        trailing.append(hearAll);

        progressionChords.append(trailing);
      }

      function renderProgression() {
        renderChordChips();
        if (!progressionRow) return;
        progressionRow.innerHTML = '';
        const text = progressionText();
        const field = document.createElement('input');
        field.type = 'text';
        field.className = 'progression-input';
        field.value = text;
        field.placeholder = 'the app is choosing';
        field.setAttribute('aria-labelledby', 'progression-label');
        field.setAttribute('spellcheck', 'false');
        field.addEventListener('change', () => commitProgression(field.value));
        field.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') { event.preventDefault(); commitProgression(field.value); }
          if (event.key === 'Escape') { field.value = progressionText(); field.blur(); }
        });
        progressionRow.append(field);

        const clear = document.createElement('button');
        clear.type = 'button';
        clear.className = 'secondary-button progression-clear';
        clear.textContent = 'Let the app choose';
        clear.disabled = !text;
        clear.addEventListener('click', () => commitProgression(''));
        progressionRow.append(clear);

        if (progressionHint) {
          // Deliberately does NOT claim the loop is yours. A genre supplies one,
          // so what is usually in this box on arrival is the app's own choice
          // being shown for the first time — which is the point of the control —
          // and calling that "your loop" would be a small lie on every load.
          progressionHint.textContent = text
            ? 'The loop being played. Edit it, or hand it back to the app. Written as scale numbers, so changing the scale re-colours it rather than moving it.'
            : 'The app is writing its own loop. Type something like i VI III VII to set one yourself.';
        }
      }

      if (engineCaps.harmonySeed && progressionControl) {
        progressionControl.hidden = false;
        {
          const slot = document.getElementById('progression-info');
          if (slot) infoButton(slot, 'the chord loop', PROGRESSION_INFO);
        }
        renderProgression();
      }

      if (engineCaps.harmonyRhythm) {
        if (chordLengthControl) chordLengthControl.hidden = false;
        // Built from the engine's own list rather than written out here: a
        // hand-kept copy is exactly how a control comes to offer a value the
        // engine then silently drops.
        {
          const rhythms = (engineModule && engineModule.HARMONY_RHYTHMS) || ['auto', 1, 2, 4, 8];
          const label = (value) => {
            if (value === 'auto') return 'Auto';
            if (value === 'section') return 'One per section';
            return value === 1 ? '1 bar' : `${value} bars`;
          };
          chordLengthSelect.replaceChildren(...rhythms.map((value) => {
            const option = document.createElement('option');
            option.value = String(value);
            option.textContent = label(value);
            return option;
          }));
        }
        chordLengthSelect.value = String(settings.harmony.rhythm);
        chordLengthSelect.addEventListener('change', () => {
          const raw = chordLengthSelect.value;
          const value = raw === 'auto' || raw === 'section' ? raw : Number(raw);
          settings.harmony.rhythm = value;
          engine.setParams({ harmony: { rhythm: value } });
          persistSettings();
        });
        describe(
          chordLengthSelect,
          'How many bars the chord progression holds each chord for. Auto lets the hook decide, and One per section gives each part of the piece a single chord of its own length. Beats are not offered: chords change on the bar here, and every instrument plans a whole bar against one chord.'
        );
      }

      const DICE_SVG =
        '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">' +
        '<rect x="3" y="3" width="18" height="18" rx="3"/>' +
        '<circle cx="8" cy="8" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="16" cy="8" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="8" cy="16" r="1.4" fill="currentColor" stroke="none"/>' +
        '<circle cx="16" cy="16" r="1.4" fill="currentColor" stroke="none"/>' +
        '</svg>';

      // The same Random/Hold/Randomness cluster renders in the tracks-panel
      // row AND in the track's Edit panel header; instances register here so
      // a change through one mirror syncs the other.
      const extrasInstances = new Map(); // track -> Set of instances

      function registerExtras(track, inst) {
        if (!extrasInstances.has(track)) extrasInstances.set(track, new Set());
        extrasInstances.get(track).add(inst);
      }

      function unregisterExtras(track, inst) {
        if (inst) extrasInstances.get(track)?.delete(inst);
      }

      function syncTrackExtras(track, skip) {
        const set = extrasInstances.get(track);
        if (!set) return;
        for (const inst of set) {
          if (inst !== skip && inst.setRand) {
            inst.setRand(settings.tracks[track].randomness);
          }
        }
      }

      function syncAllTrackExtras() {
        for (const id of TRACK_IDS) syncTrackExtras(id);
      }

      // v14: the Random button and Hold toggle are GONE from the row — the
      // Randomness dial alone drives both (0 = hold). engine.randomise() is
      // kept for power use behind a small dice icon, and only inside the Edit
      // panel header (`withDice`), never in the row.
      function buildTrackExtras(container, track, { knobs = null, withDice = false } = {}) {
        const inst = { setRand: null };
        if (withDice && engineCaps.randomise) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'round-button track-random';
          btn.innerHTML = DICE_SVG;
          btn.setAttribute('aria-label', `Re-roll ${TRACK_LABELS[track]}`);
          btn.addEventListener('click', () => {
            try {
              engine.randomise(track);
            } catch {}
          });
          container.append(btn);
          describe(btn, `Re-roll ${TRACK_LABELS[track]}'s material from the next bar.`);
        }
        if (engineCaps.randomness[track]) {
          // v7/v8: the capability probe (engineCaps.randomness, built from
          // isNumberOrRange) already accepts a RangeValue reply from the
          // engine, so — per the v8 ruling ("randomness stays a number
          // default until the page probe widens") — this control can now
          // ship rangeDefault: true. onValue is fed straight from the knob
          // (number|{min,max}, already clamped/quantised by knob.js).
          const onValue = (v) => {
            v = sanitiseRangeValueIn(v, 0, 1, 0.5);
            settings.tracks[track].randomness = v;
            // One dial, both params: the engine keeps `hold` as its own
            // switch, the UI drives it off the dial's zero position.
            settings.tracks[track].hold = isHoldValue(v);
            engine.setParams({
              tracks: { [track]: { randomness: v, hold: settings.tracks[track].hold } },
            });
            syncTrackExtras(track, inst);
            // Keep both main read-outs current when a single track's own knob
            // moves independently of the others: Simple falls back to its
            // blended estimate, Advanced shows the tracks' own mean. Both are
            // display only.
            randomnessDial?.set(changeDialValueFromState());
            variationDial?.set(trackRandomnessValue());
            persistSettings();
          };
          if (knobApi) {
            const cell = document.createElement('div');
            cell.className = 'rand-knob';
            container.append(cell);
            try {
              const handle = knobApi.createKnob(cell, {
                label: 'Randomness',
                min: 0,
                max: 1,
                value: sanitiseRangeValueIn(settings.tracks[track].randomness, 0, 1, 0.5),
                format: randomnessFormat,
                allowRange: true,
                rangeDefault: true,
                defaultValue: DEFAULTS.tracks[track].randomness,
                onInput: onValue,
              });
              describe(handle.el, RANDOMNESS_HINT);
              // v0.0.70: names the field in getResolved().tracks that this dial
              // is a view of, so the live mark can be fed without the poller
              // having to know what any given dial is.
              handle.liveField = 'randomness';
              if (knobs) knobs.push(handle);
              inst.setRand = (v) => {
                try {
                  handle.set?.(v);
                } catch {}
              };
            } catch {
              cell.remove();
            }
          }
          if (!inst.setRand) {
            // Slider fallback (no knob.js): single-value only, same
            // midpoint-display / collapse-on-edit policy as the voice
            // editor's slider fallback.
            const wrap = document.createElement('label');
            wrap.className = 'rand-slider';
            const name = document.createElement('span');
            name.className = 'visually-hidden';
            name.textContent = `${TRACK_LABELS[track]} randomness. ${RANDOMNESS_HINT}`;
            const input = document.createElement('input');
            input.type = 'range';
            input.min = '0';
            input.max = '1';
            input.step = '0.01';
            input.value = String(rangeMid(sanitiseRangeValueIn(settings.tracks[track].randomness, 0, 1, 0.5)));
            input.addEventListener('input', () => onValue(parseFloat(input.value)));
            wrap.append(name, input);
            container.append(wrap);
            describe(input, RANDOMNESS_HINT);
            inst.setRand = (v) => {
              input.value = String(rangeMid(sanitiseRangeValueIn(v, 0, 1, 0.5)));
            };
          }
        }
        return inst;
      }

      // Vary knobs run on a 22-position scale: raw 0 is the Auto detent
      // (null — "follows Randomness"); raw 1–21 map to explicit 0–100%.
      // v16: vary aspects are rangeable (v7 list; the engine walks vary.* per
      // bar exactly as it walks randomness), so raw may arrive as {min,max}.
      // The Auto detent is a SINGLE-value state only — a range always spans
      // explicit percentages, so its min thumb floors at raw 1, and a range
      // that collapses onto the detent reads as Auto again.
      const varyPct = (raw) => clamp((Math.round(raw) - 1) / 20, 0, 1);
      // v0.0.55: the detent reads "Auto", not "Auto (follows Randomness)".
      // Measured collision, not a judgement call: the readout box is centred
      // on its cell with `overflow: visible` (the deliberate v18 rule that
      // lets a long value bleed into a gutter instead of pushing the faces out
      // of line), the parenthetical rendered 148px wide, and `.vary-knob`
      // cells are 84px on a 92px pitch — so each of the four captions was
      // painted 56px over both neighbours and the row read as one smear. What
      // it follows is already the first thing the dial's own tooltip says.
      const varyFormat = (raw) =>
        Math.round(raw) <= 0 ? 'Auto' : pctFormat(varyPct(raw));
      const varyRawNumber = (v) => (v === null ? 0 : 1 + Math.round(clamp(v, 0, 1) * 20));
      const varyRawFromValue = (v) => (isPlainObject(v) ? mapRV(v, varyRawNumber) : varyRawNumber(v));
      const varyValueFromRaw = (raw) => {
        if (isPlainObject(raw)) {
          if (Math.round(raw.max) <= 0) return null;
          return { min: varyPct(Math.max(1, raw.min)), max: varyPct(raw.max) };
        }
        return Math.round(raw) <= 0 ? null : varyPct(raw);
      };

      function buildVaryRow(container, track, knobs) {
        if (!engineCaps.vary[track]) return;
        const row = document.createElement('div');
        row.className = 'vary-row';
        const title = document.createElement('span');
        title.className = 'panel-label';
        title.textContent = 'Randomise';
        const cells = document.createElement('div');
        cells.className = 'vary-cells';
        row.append(title, cells);
        container.append(row);

        for (const [key, label] of VARY_KEYS) {
          const commitVary = (value) => {
            settings.tracks[track].vary[key] = value;
            engine.setParams({ tracks: { [track]: { vary: { [key]: value } } } });
            persistSettings();
          };
          const raw = varyRawFromValue(settings.tracks[track].vary[key]);
          // Which shape the value currently has, so the readout can tell the
          // Auto detent (single mode, raw 0) from a range whose min thumb
          // happens to be sitting at the bottom of the scale (0%).
          let ranged = isPlainObject(settings.tracks[track].vary[key]);
          let built = false;
          if (knobApi) {
            const cell = document.createElement('div');
            cell.className = 'vary-knob';
            cells.append(cell);
            try {
              const handle = knobApi.createKnob(cell, {
                label,
                min: 0,
                max: 21,
                step: 1,
                value: raw,
                marks: [0],
                format: (v) => (ranged ? pctFormat(varyPct(Math.max(1, v))) : varyFormat(v)),
                allowRange: true,
                // DEFAULTS.tracks[*].vary is all-null (the Auto detent, raw 0)
                // for every track/key — dblclick returns to "follows Randomness".
                defaultValue: 0,
                onInput: (v) => {
                  const value = varyValueFromRaw(v);
                  ranged = isPlainObject(value);
                  commitVary(value);
                },
              });
              describe(
                handle.el,
                `How much ${TRACK_LABELS[track]}'s ${label.toLowerCase()} varies. At the left detent it follows this track's Randomness dial; anywhere else overrides it.`
              );
              if (knobs) knobs.push(handle);
              built = true;
            } catch {
              cell.remove();
            }
          }
          if (!built) {
            // Slider fallback (no knob.js): single-value only — it shows the
            // midpoint of a loaded range and collapses it on the first edit,
            // the same policy the Level/Randomness fallbacks follow.
            const rawMid = Math.round(rangeMid(raw));
            const wrap = document.createElement('div');
            wrap.className = 'control vary-slider';
            const id = `vary-${track}-${key}`;
            const lrow = document.createElement('div');
            lrow.className = 'control-label-row';
            const lab = document.createElement('label');
            lab.htmlFor = id;
            lab.textContent = label;
            const readout = document.createElement('span');
            readout.className = 'value-readout';
            readout.textContent = varyFormat(rawMid);
            lrow.append(lab, readout);
            const input = document.createElement('input');
            input.type = 'range';
            input.id = id;
            input.min = '0';
            input.max = '21';
            input.step = '1';
            input.value = String(rawMid);
            input.setAttribute('aria-valuetext', varyFormat(rawMid));
            input.addEventListener('input', () => {
              const r = parseInt(input.value, 10) || 0;
              readout.textContent = varyFormat(r);
              input.setAttribute('aria-valuetext', varyFormat(r));
              commitVary(varyValueFromRaw(r));
            });
            wrap.append(lrow, input);
            cells.append(wrap);
          }
        }
      }

      // ---- v12 mono + glide (melodic tracks; engine params since v12) -----
      // A monophonic track sounds one note at a time and slurs between them,
      // which is what turns a generative line into something singable. Both
      // params existed engine-side without UI; the toggle and the dial sit in
      // the editor header beside the state lamp, because "one note at a time"
      // is a property of the LINE, not of the patch.
      const MONO_HINT =
        'Poly plays as many notes at once as the part asks for. Mono plays one at a time — each new note ends the one before it, the way a voice or a wind instrument does, which is what turns a generative line into something singable.';
      const GLIDE_HINT =
        'How far each note slides into the next one. Off is a clean step; higher slurs between pitches. Mono only.';

      function buildMonoGlide(container, track, knobs) {
        if (!engineCaps.mono[track] && !engineCaps.glide[track]) return;
        if (engineCaps.mono[track]) {
          // v0.0.58: Poly | Mono as a segmented pair, replacing a single
          // button captioned "Mono" and distinguished only by fill-versus-
          // outline. That control could not be read: fill-versus-outline says
          // nothing about which state it is IN as opposed to which state it
          // would put you in, and the caption never changed either way. The
          // same rule as the Universal | Per instrument control — show both
          // options with the current one selected, never one button that
          // states its state and swaps label.
          const group = document.createElement('div');
          group.className = 'segmented voice-mode';
          group.setAttribute('role', 'radiogroup');
          group.setAttribute('aria-label', `${TRACK_LABELS[track]} voicing`);
          const radios = [];
          for (const [value, text] of [['poly', 'Poly'], ['mono', 'Mono']]) {
            const input = document.createElement('input');
            input.type = 'radio';
            input.name = `voice-mode-${track}`;
            input.id = `voice-mode-${track}-${value}`;
            input.value = value;
            input.checked = (settings.tracks[track].mono === true) === (value === 'mono');
            const label = document.createElement('label');
            label.htmlFor = input.id;
            label.textContent = text;
            input.addEventListener('change', () => {
              if (!input.checked) return;
              const on = value === 'mono';
              settings.tracks[track].mono = on;
              engine.setParams({ tracks: { [track]: { mono: on } } });
              persistSettings();
            });
            group.append(input, label);
            radios.push(input);
          }
          container.append(group);
          describe(group, MONO_HINT);
        }
        if (!engineCaps.glide[track]) return;
        // v0.0.74: rangeable. Until this version the engine read glide with
        // numberIn(), so the dial collapsed a span to its midpoint before
        // writing — the engine now walks it, so the span travels whole.
        const commitGlide = (v) => {
          const value = isPlainObject(v)
            ? { min: clamp(v.min, 0, 1), max: clamp(v.max, 0, 1) }
            : clamp(v, 0, 1);
          settings.tracks[track].glide = value;
          engine.setParams({ tracks: { [track]: { glide: value } } });
          persistSettings();
        };
        const stored = settings.tracks[track].glide ?? 0;
        const value = isPlainObject(stored)
          ? { min: clamp(stored.min, 0, 1), max: clamp(stored.max, 0, 1) }
          : clamp(stored, 0, 1);
        const glideFormat = (v) => (v <= 0.005 ? 'Off' : pctFormat(v));
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = 'glide-knob';
          container.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label: 'Glide',
              // v0.0.74: the engine walks it now, so the spread is real. The
              // v0.0.56 opt-out named the engine gap as the reason and the gap
              // is closed — track glide takes a {min,max} exactly as the
              // patch-level glide always did.
              min: 0,
              max: 1,
              value,
              format: glideFormat,
              defaultValue: MONO_DEFAULTS[track].glide,
              onInput: commitGlide,
            });
            describe(handle.el, GLIDE_HINT);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('label');
        wrap.className = 'glide-slider';
        const name = document.createElement('span');
        name.className = 'visually-hidden';
        name.textContent = `${TRACK_LABELS[track]} glide. ${GLIDE_HINT}`;
        const input = document.createElement('input');
        input.type = 'range';
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(value);
        input.addEventListener('input', () => commitGlide(parseFloat(input.value)));
        wrap.append(name, input);
        container.append(wrap);
        describe(input, GLIDE_HINT);
      }

      // ---- v21: per-track drift rate --------------------------------------
      // One dial over every RangeValue walk this track owns: at 1 a ranged
      // dial crosses its span at the engine's own ±0.15/bar, at the bottom it
      // creeps. Rendered only where the engine advertises the param.
      const DRIFT_HINT =
        'How fast this track’s min–max dials drift between their two ends. Low is a slow creep; 1 is the normal rate.';

      // v26: every feel dial this track owns lands in ONE row (the caller's),
      // so drift rate can never be stranded on a line of its own — the
      // percussion editor's drift/swing pair was the named offender.
      /**
       * v0.0.72 — what a spread DOES between its ends.
       *
       * Owner, asking for the patching system: "so you can have a voice
       * crescendo when you want it to rather than just setting it to be a
       * random volume between min and max." Until now a spread meant exactly
       * one thing — somewhere in here, unpredictably — so a crescendo, one of
       * the most ordinary things a musician asks for, was unreachable.
       *
       * Four words rather than four icons, because the difference between
       * these is a sentence and not a picture, and a row of glyphs for
       * rise/fall/swell would be guessed wrong by everyone.
       */
      const DRIFT_SHAPES = [
        ['drift', 'Drift'],
        ['rise', 'Rise'],
        ['fall', 'Fall'],
        ['swell', 'Swell'],
        // v0.0.136: the modulation graph's first two sources, on every
        // spreadable dial at once.
        ['cycle', 'Cycle (LFO)'],
        ['step', 'Step (hold)'],
      ];
      const DRIFT_SHAPE_HINT =
        'What this track’s min–max dials do between their two ends. Drift wanders between them at random, which is what they have always done. Rise climbs from the bottom to the top and starts again — a crescendo. Fall is the same going down. Swell goes up and comes back. Cycle is an LFO: a smooth sine between the two ends, over and over, at the rate and length the two dials beside this one set — vibrato, tremolo, a filter breathing. Step holds one random value per pass and jumps to the next, which is a sample-and-hold.';

      function buildDriftShapeControl(container, track) {
        if (!engineCaps.driftShape || !engineCaps.driftShape[track]) return;
        const wrap = document.createElement('label');
        wrap.className = 'drift-shape';
        const name = document.createElement('span');
        name.className = 'block-field-name';
        name.textContent = 'between';
        const select = document.createElement('select');
        select.setAttribute('aria-label', `${TRACK_LABELS[track]} spread shape`);
        // Each shape is offered only if the ENGINE keeps it: this list grew in
        // v0.0.136 and an engine bundle that predates a value would silently
        // drop it, leaving an option that does nothing — the dead-control
        // failure this project keeps catching.
        const engineShapes = engineModule && Array.isArray(engineModule.DRIFT_SHAPES)
          ? engineModule.DRIFT_SHAPES
          : null;
        for (const [value, label] of DRIFT_SHAPES) {
          if (engineShapes && !engineShapes.includes(value)) continue;
          if (!engineShapes && (value === 'cycle' || value === 'step')) continue;
          const option = document.createElement('option');
          option.value = value;
          option.textContent = label;
          select.append(option);
        }
        select.value = settings.tracks[track].driftShape || 'drift';
        select.addEventListener('change', () => {
          settings.tracks[track].driftShape = select.value;
          engine.setParams({ tracks: { [track]: { driftShape: select.value } } });
          persistSettings();
        });
        wrap.append(name, select);
        container.append(wrap);
        describe(select, DRIFT_SHAPE_HINT);
      }

      function buildDriftRateControl(container, track, knobs) {
        if (!engineCaps.driftRate[track]) return;
        const commitDrift = (v) => {
          const value = clamp(rangeMid(v), 0.02, 1);
          settings.tracks[track].driftRate = value;
          engine.setParams({ tracks: { [track]: { driftRate: value } } });
          persistSettings();
        };
        const stored = settings.tracks[track].driftRate;
        const value = clamp(typeof stored === 'number' && Number.isFinite(stored) ? stored : 1, 0.02, 1);
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell drift-knob';
          container.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label: 'Drift rate',
              // v0.0.56 opt-out: a plain number in the engine, and the one
              // dial where a spread is also circular — drift rate is how fast
              // every OTHER spread walks.
              allowRange: false,
              min: 0.02,
              max: 1,
              step: 0.01,
              value,
              format: (v) => `${plainFormat(v)}×`,
              defaultValue: 1,
              onInput: commitDrift,
            });
            describe(handle.el, DRIFT_HINT);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `drift-rate-${track}`;
        const labelRow = document.createElement('div');
        labelRow.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = 'Drift rate';
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        readout.textContent = `${plainFormat(value)}×`;
        labelRow.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        input.min = '0.02';
        input.max = '1';
        input.step = '0.01';
        input.value = String(value);
        input.addEventListener('input', () => {
          const v = parseFloat(input.value);
          readout.textContent = `${plainFormat(v)}×`;
          commitDrift(v);
        });
        wrap.append(labelRow, input);
        container.append(wrap);
        describe(input, DRIFT_HINT);
      }

      // ---- v21: per-track Swing (pulsed tracks) + Density (tuned) ---------
      // Both carry an AUTO DETENT at the bottom of the sweep that writes null
      // — "follow the global Swing" / "let complexity set the rate" — so the
      // dial has to distinguish "explicitly zero" from "not set". Same 22-
      // position trick the Randomise mini-knobs use: raw 0 is the detent, raw
      // 1–21 map onto the param's own range. Neither is rangeable: the engine
      // reads both as plain scalars (or null), so a {min,max} would be dropped.
      const TRACK_SWING_HINT =
        'This track’s own swing. At the left detent it follows the global Swing dial; anywhere else overrides it for this track alone.';
      const TRACK_DENSITY_HINT =
        'How busy this track is, on top of Complexity. At the left detent Complexity decides; 1 is that same rate, 2 is twice it.';
      const FEEL_STEPS = 21;

      const feelRawFromValue = (v, max) =>
        v === null || v === undefined ? 0 : 1 + Math.round((clamp(v, 0, max) / max) * (FEEL_STEPS - 1));
      const feelStepValue = (n, max) =>
        (n <= 0 ? null : clamp(((n - 1) / (FEEL_STEPS - 1)) * max, 0, max));
      /**
       * v0.0.74: this dial spreads, with one rule the others do not need.
       * Its bottom stop is AUTO, which is not a smaller amount of swing — it
       * is "follow the global dial", a different KIND of answer. So a span is
       * pushed up off that stop rather than allowed to include it: a range
       * reading "Auto to heavy" would be claiming the track alternates
       * between following and leading, which the engine has no way to do.
       */
      const feelValueFromRaw = (raw, max) => {
        if (isPlainObject(raw)) {
          const lo = Math.max(1, Math.round(raw.min));
          const hi = Math.max(lo, Math.round(raw.max));
          if (hi <= 0) return null;
          return hi === lo
            ? feelStepValue(lo, max)
            : { min: feelStepValue(lo, max), max: feelStepValue(hi, max) };
        }
        return feelStepValue(Math.round(raw), max);
      };
      const feelRawFromStored = (stored, max) =>
        (isPlainObject(stored)
          ? { min: feelRawFromValue(stored.min, max), max: feelRawFromValue(stored.max, max) }
          : feelRawFromValue(typeof stored === 'number' ? stored : null, max));

      function buildFeelControl(parent, track, knobs, spec) {
        const { key, label, max, hint, format, className } = spec;
        const commitFeel = (raw) => {
          const value = feelValueFromRaw(raw, max);
          settings.tracks[track][key] = value;
          engine.setParams({ tracks: { [track]: { [key]: value } } });
          // v0.0.57: moving ONE track off its auto detent is what makes the
          // global dial per-instrument, so the Universal | Per instrument
          // control re-reads rather than being told.
          syncScopeControls();
          persistSettings();
        };
        const stored = settings.tracks[track][key];
        const raw = feelRawFromStored(stored, max);
        const rawFormat = (v) => (Math.round(v) <= 0 ? 'Auto' : format(feelStepValue(Math.round(v), max)));
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = `knob-cell ${className}`;
          parent.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label,
              // v0.0.74: it spreads. The v0.0.56 note called this "an
              // enumeration of named grooves", which it is not — the steps are
              // a quantised view of a continuous 0–max amount, and the engine
              // walks a span between two of them. See feelValueFromRaw for the
              // one stop a span may not include.
              min: 0,
              max: FEEL_STEPS,
              step: 1,
              value: raw,
              marks: [0],
              format: rawFormat,
              defaultValue: 0,
              onInput: commitFeel,
            });
            describe(handle.el, hint);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `${key}-${track}`;
        const labelRow = document.createElement('div');
        labelRow.className = 'control-label-row';
        const name = document.createElement('label');
        name.htmlFor = id;
        name.textContent = label;
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        readout.textContent = rawFormat(raw);
        labelRow.append(name, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        input.min = '0';
        input.max = String(FEEL_STEPS);
        input.step = '1';
        input.value = String(raw);
        input.setAttribute('aria-valuetext', rawFormat(raw));
        input.addEventListener('input', () => {
          const v = parseInt(input.value, 10) || 0;
          readout.textContent = rawFormat(v);
          input.setAttribute('aria-valuetext', rawFormat(v));
          commitFeel(v);
        });
        wrap.append(labelRow, input);
        parent.append(wrap);
        describe(input, hint);
      }

      function buildFeelRow(row, track, knobs) {
        const wantsSwing = SEQ_TRACKS.includes(track) && engineCaps.trackSwing[track];
        const wantsDensity = TUNED_TRACKS.includes(track) && engineCaps.trackDensity[track];
        if (!wantsSwing && !wantsDensity) return;
        if (wantsSwing) {
          buildFeelControl(row, track, knobs, {
            key: 'swing',
            label: 'Swing',
            max: 1,
            hint: TRACK_SWING_HINT,
            format: (v) => (v <= 0.005 ? 'Straight' : pctFormat(v)),
            className: 'track-swing-knob',
          });
        }
        if (wantsDensity) {
          buildFeelControl(row, track, knobs, {
            key: 'density',
            label: 'Density',
            max: TRACK_DENSITY_MAX,
            hint: TRACK_DENSITY_HINT,
            format: (v) => `${plainFormat(v)}×`,
            className: 'track-density-knob',
          });
        }
      }

      /**
       * v0.0.57 — Universal | Per instrument.
       *
       * The owner asked for this on 2026-07-27 and it sat unbuilt through five
       * versions because the TODO line listed five dials, three of which cannot
       * have it. Stated plainly: `repetition` drives ONE hook and ONE motif
       * bank per piece, and `reverbTail` drives ONE shared convolver, so a
       * per-instrument version of either is a new engine feature (per-track
       * sends, per-track convolvers) and not a toggle. Randomness has been
       * per-track since v21. That leaves the two the engine can already do, and
       * those two are built here.
       *
       * The mechanism was mostly present and simply invisible: each track's
       * editor has carried its own Swing and Density dial since v21, with an
       * auto detent at the bottom writing `null`, and the engine reads null as
       * "follow the global dial". What was missing was any way to SEE from the
       * global dial whether it was being followed, and any way to switch every
       * track at once. So this control is a readout as much as an input —
       * flipping a single track's own dial off the detent moves it to Per
       * instrument by itself, because that is what has become true.
       *
       * Switching to Per instrument seeds every applicable track with the value
       * it is sounding right now, so nothing changes audibly at the moment of
       * the switch — it only becomes editable. Switching back to Universal
       * writes null everywhere, which does change the sound, and is the reason
       * the two directions are not symmetrical.
       */
      const SCOPE_SPECS = {
        swing: {
          slot: 'scope-swing',
          label: 'Swing',
          cellClass: 'track-swing-knob',
          tracks: () => SEQ_TRACKS.filter((id) => engineCaps.trackSwing[id]),
          // The global Swing dial's own value: what each track adopts when the
          // user asks for per-instrument control.
          seed: () => rangeMid(sanitiseRangeValueIn(settings.swing, 0, 1, 0)),
        },
        complexity: {
          slot: 'scope-complexity',
          label: 'Complexity',
          cellClass: 'track-density-knob',
          tracks: () => TUNED_TRACKS.filter((id) => engineCaps.trackDensity[id]),
          // Density is a MULTIPLIER on the rate complexity sets, so 1 is "the
          // rate you already had" — the honest seed for a switch that must not
          // change the sound.
          key: 'density',
          seed: () => 1,
        },
      };

      const scopeControls = new Map(); // dial id -> { refresh() }

      /** Every applicable track sitting on its auto detent = the dial is universal. */
      function scopeIsUniversal(spec) {
        const key = spec.key || 'swing';
        return spec.tracks().every((id) => {
          const value = settings.tracks[id]?.[key];
          return value === null || value === undefined;
        });
      }

      function buildScopeControl(dialId) {
        const spec = SCOPE_SPECS[dialId];
        if (!spec) return;
        const slot = document.getElementById(spec.slot);
        if (!slot) return;
        const tracks = spec.tracks();
        // Nothing to scope to. A control offering a choice between one thing
        // and the same thing is worse than no control.
        if (tracks.length < 2) return;
        const key = spec.key || 'swing';

        const group = document.createElement('div');
        group.className = 'segmented dial-scope';
        group.setAttribute('role', 'radiogroup');
        group.setAttribute('aria-label', `${spec.label} applies to`);
        const radios = [];
        for (const [value, text] of [['universal', 'Universal'], ['per', 'Per instrument']]) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `scope-${dialId}`;
          input.id = `scope-${dialId}-${value}`;
          input.value = value;
          const label = document.createElement('label');
          label.htmlFor = input.id;
          label.textContent = text;
          input.addEventListener('change', () => {
            if (!input.checked) return;
            const trackStates = {};
            for (const id of spec.tracks()) {
              const next = value === 'universal' ? null : spec.seed();
              settings.tracks[id][key] = next;
              trackStates[id] = { [key]: next };
            }
            engine.setParams({ tracks: trackStates });
            syncAllTrackExtras();
            persistSettings();
            // syncScopeControls, not refresh: the switch has to re-apply
            // VISIBILITY as well as re-read its own state, and calling only
            // refresh left the per-track dials hidden after switching TO Per
            // instrument — the one direction the control exists for.
            syncScopeControls();
          });
          group.append(input, label);
          radios.push(input);
        }
        slot.append(group);
        describe(
          group,
          `Whether ${spec.label} sets one value for the whole piece, or each instrument keeps its own. Switching to Per instrument gives every instrument the value it is playing now, so nothing changes until you move one.`
        );

        function refresh() {
          const universal = scopeIsUniversal(spec);
          for (const input of radios) {
            input.checked = input.value === (universal ? 'universal' : 'per');
          }
        }
        refresh();
        scopeControls.set(dialId, { refresh });
      }

      /** Re-read every scope control from the settings tree. */
      function syncScopeControls() {
        for (const control of scopeControls.values()) control.refresh();
        applyScopeVisibility();
      }

      /**
       * v0.0.70 (owner): "Universal | Per Instrument was supposed to clear up
       * the interface — with Swing set to Universal, the Swing dial can
       * disappear from each track."
       *
       * He is right and this is the half I missed. The point of the control was
       * never to add a switch; it was to REMOVE the per-track dials whenever
       * they are all following the global one, which is most of the time. A
       * dial sitting on its auto detent in every track editor is six copies of
       * "not set" taking up the room where the things you are actually editing
       * live.
       *
       * `hidden` rather than removal: the dials are real controls with live
       * handles, and rebuilding them on every switch would drop their state and
       * their tooltips. Hidden takes them out of the layout AND out of the
       * accessibility tree, which is the correct pairing here — a control that
       * cannot apply should not be announced either.
       */
      function applyScopeVisibility() {
        for (const [dialId, spec] of Object.entries(SCOPE_SPECS)) {
          if (!scopeControls.has(dialId)) continue;
          const universal = scopeIsUniversal(spec);
          for (const cell of document.querySelectorAll(`.${spec.cellClass}`)) {
            cell.hidden = universal;
          }
        }
      }

      // Built HERE and not beside the dials they sit under: `buildScopeControl`
      // is hoisted but SCOPE_SPECS above it is a const, so calling it earlier
      // in the init reaches the table before it is initialised — which is
      // exactly the blank-page class of failure page-boot.mjs exists to catch,
      // and did. The dials themselves are long built by this point.
      buildScopeControl('swing');
      buildScopeControl('complexity');

      // ---- v14: per-track Dissonance (tuned tracks only) -----------------
      // How far this instrument may stray from the chord the group is
      // playing: 0 is strict, low values allow passing/neighbour tones,
      // high ones borrow from outside the mode. RangeValue-capable, so it
      // can drift between two bounds like every other v7 dial.
      const DISSONANCE_HINT =
        'How far this instrument may stray from the group chord. 0 keeps strictly to it.';

      function buildDissonanceControl(row, track, knobs) {
        if (!engineCaps.dissonance[track]) return;
        const commitDissonance = (v) => {
          v = sanitiseRangeValueIn(v, 0, 1, 0);
          settings.tracks[track].dissonance = v;
          engine.setParams({ tracks: { [track]: { dissonance: v } } });
          persistSettings();
        };
        const value = sanitiseRangeValueIn(settings.tracks[track].dissonance, 0, 1, 0);
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell dissonance-knob';
          row.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label: 'Dissonance',
              min: 0,
              max: 1,
              value,
              format: pctFormat,
            parse: pctParse,
              allowRange: true,
              defaultValue: 0,
              onInput: commitDissonance,
            });
            describe(handle.el, DISSONANCE_HINT);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `dissonance-${track}`;
        const labelRow = document.createElement('div');
        labelRow.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = 'Dissonance';
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        readout.textContent = pctFormat(rangeMid(value));
        labelRow.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(rangeMid(value));
        input.addEventListener('input', () => {
          const v = parseFloat(input.value);
          readout.textContent = pctFormat(v);
          commitDissonance(v);
        });
        wrap.append(labelRow, input);
        row.append(wrap);
        describe(input, DISSONANCE_HINT);
      }

      // ---- v21 pad breath (pad editor only) --------------------------------
      // How deep the pad's own bar-phased swell goes. Not RangeValue-capable
      // (a plain 0-1 depth) and pad-only — the engine already breathes on its
      // own bar clock, this just exposes how far.
      const PAD_BREATH_HINT = 'How much the pad swells with each bar.';

      function buildPadBreathControl(row, track, knobs) {
        if (track !== 'pad' || !engineCaps.padBreath) return;
        const shipped = typeof enginePadBreath === 'number' ? enginePadBreath : 0.5;
        const stored =
          typeof settings.tracks.pad.padBreath === 'number' && Number.isFinite(settings.tracks.pad.padBreath)
            ? clamp(settings.tracks.pad.padBreath, 0, 1)
            : shipped;
        settings.tracks.pad.padBreath = stored;
        engine.setParams({ padBreath: stored });
        const commitPadBreath = (v) => {
          v = clamp(rangeMid(v), 0, 1);
          settings.tracks.pad.padBreath = v;
          engine.setParams({ padBreath: v });
          persistSettings();
        };
        if (knobApi) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell pad-breath-knob';
          row.append(cell);
          try {
            const handle = knobApi.createKnob(cell, {
              label: 'Breath',
              min: 0,
              max: 1,
              value: stored,
              format: pctFormat,
            parse: pctParse,
              defaultValue: shipped,
              onInput: commitPadBreath,
            });
            describe(handle.el, PAD_BREATH_HINT);
            if (knobs) knobs.push(handle);
            return;
          } catch {
            cell.remove();
          }
        }
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = 'pad-breath';
        const labelRow = document.createElement('div');
        labelRow.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = 'Breath';
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        readout.textContent = pctFormat(stored);
        labelRow.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(stored);
        input.addEventListener('input', () => {
          const v = parseFloat(input.value);
          readout.textContent = pctFormat(v);
          commitPadBreath(v);
        });
        wrap.append(labelRow, input);
        row.append(wrap);
        describe(input, PAD_BREATH_HINT);
      }

      // ---- v6: shared step sequencer ------------------------------------

      function currentStepsPerBar() {
        // The engine is the metre authority: since v0.0.98 it accepts custom
        // N/4 and N/8 signatures the literal table has never heard of, and
        // the grid must draw the number of slots the engine actually plays —
        // a 16-slot fallback in 3/8 is ten editable steps that never sound,
        // and in 9/8 two sounding steps with no cell. The table remains only
        // for the moment before the engine module has loaded.
        const fromEngine = engineModule && typeof engineModule.sequencerStepsPerBar === 'function'
          ? engineModule.sequencerStepsPerBar(settings.timeSignature)
          : null;
        if (Number.isFinite(fromEngine) && fromEngine > 0) return Math.min(fromEngine, SEQ_SLOTS);
        return STEPS_PER_BAR[settings.timeSignature] || 16;
      }

      // Pulse (beat) marks come from where the metre's pulses actually
      // start, not a naive "every 4th step" — that's only right for simple
      // meters. Compound x/8 meters group in dotted-quarter (6/8: two
      // groups of three eighths) or mixed (7/8: 2+2+3 eighths, the common
      // grouping) pulses, so their marks land at irregular step offsets.
      const SEQ_PULSE_STARTS = {
        '3/4': [0, 4, 8],
        '4/4': [0, 4, 8, 12],
        '5/4': [0, 4, 8, 12, 16],
        '6/8': [0, 6],
        '7/8': [0, 4, 8],
      };

      function currentPulseStarts() {
        const named = SEQ_PULSE_STARTS[settings.timeSignature];
        if (named) return named;
        // Unlisted (custom) signature: the marks come from the engine's own
        // pulse map — each pulse starts where the beats before it ended, a
        // beat being 4 slots — so 9/8 marks 0/6/12, not every 4th step.
        const pulses = engineModule && typeof engineModule.metrePulses === 'function'
          ? engineModule.metrePulses(settings.timeSignature)
          : null;
        if (Array.isArray(pulses) && pulses.length) {
          const starts = [];
          let beat = 0;
          for (const p of pulses) { starts.push(Math.round(beat * 4)); beat += p; }
          return starts;
        }
        // Engine not loaded yet: every-4th-step (the old, simple-meter
        // assumption) rather than showing nothing.
        return Array.from({ length: Math.ceil(currentStepsPerBar() / 4) }, (_, i) => i * 4);
      }

      // ---- v8 exception: the ARP lane is indexed by arp-step-within-bar at
      // the CURRENT rate, not the bar's metre — its length and pulse marks
      // must be re-derived from settings.arp.rate (and re-rendered when the
      // rate changes, same as a time-signature change re-renders the rest).
      const ARP_RATE_WHOLE_FRACTION = { '1/4': 1 / 4, '1/8': 1 / 8, '1/16': 1 / 16, '1/8T': 1 / 12 };

      function arpStepsPerBar() {
        const [num, den] = String(settings.timeSignature).split('/').map(Number);
        const barWhole = (num || 4) / (den || 4); // bar duration in whole notes
        const rateFraction = ARP_RATE_WHOLE_FRACTION[settings.arp.rate] || ARP_RATE_WHOLE_FRACTION['1/8'];
        // Nudge off an exact-integer float boundary before ceil (e.g.
        // 1/0.125 landing at 8.000000000000002) so it can't over-count.
        return clamp(Math.ceil(barWhole / rateFraction - 1e-6), 1, SEQ_SLOTS);
      }

      function arpPulseStarts(n) {
        // One mark per quarter-note-equivalent worth of arp steps, so the
        // grid still reads by the beat, just counted in the arp's own rate.
        const rateFraction = ARP_RATE_WHOLE_FRACTION[settings.arp.rate] || ARP_RATE_WHOLE_FRACTION['1/8'];
        const perBeat = Math.max(1, Math.round(0.25 / rateFraction));
        const marks = [];
        for (let i = 0; i < n; i += perBeat) marks.push(i);
        return marks;
      }

      /** "C#4" / "eb3" / "A" (octave 4 assumed) → MIDI 0–127, or null. */
      function parseNoteNameToMidi(token) {
        const m = /^([A-Ga-g])([#b\u266F\u266D]?)(-?\d)?$/.exec(String(token || '').trim());
        if (!m) return null;
        const base = { c: 0, d: 2, e: 4, f: 5, g: 7, a: 9, b: 11 }[m[1].toLowerCase()];
        const acc = m[2] === '#' || m[2] === '\u266F' ? 1 : m[2] === 'b' || m[2] === '\u266D' ? -1 : 0;
        const octave = m[3] === undefined ? 4 : parseInt(m[3], 10);
        const midi = 12 * (octave + 1) + base + acc;
        return midi >= 0 && midi <= 127 ? midi : null;
      }

      // AUDIT FIX (cleanup): ONE spelling of a note name on screen. This had
      // its own ASCII table, so a pinned step read "C#5" while the piano roll
      // and the pitch readout — which use PITCH_LETTERS — said "C♯5" for the
      // same note. The typographic sharp wins (it is what the rest of the app
      // shows); parseNoteNameToMidi accepts either when TYPING. The scale
      // ROOT list stays ASCII: those strings are engine param values, not
      // display text.
      const midiToNoteName = (midi) => pitchName(midi);

      /** A track's slot length in beats — its rung of the ×2/÷2 ladder. */
      function trackStepBeats(track) {
        // v0.0.137: BOTH ladders, and matched with a tolerance rather than
        // `includes` — a triplet rung that has been through JSON can differ
        // from 1/3 in its last bit, and reading it as "not on the ladder" would
        // draw a semiquaver grid over a track the engine plays in triplets.
        const ladder = engineModule && Array.isArray(engineModule.ALL_STEP_RESOLUTIONS)
          ? engineModule.ALL_STEP_RESOLUTIONS
          : [1, 0.5, 0.25, 0.125, 0.0625, 2 / 3, 1 / 3, 1 / 6, 1 / 12];
        const asked = settings.tracks[track] && settings.tracks[track].stepBeats;
        if (!Number.isFinite(asked)) return 0.25;
        const found = ladder.find((rung) => Math.abs(rung - asked) < 1e-9);
        return found === undefined ? 0.25 : found;
      }

      function stepsPerBarFor(track) {
        if (track === 'arp') return arpStepsPerBar();
        // v0.0.131: the TRACK's own resolution, through the engine's own
        // arithmetic — the grid must draw exactly the slots the engine plays.
        const beats = trackStepBeats(track);
        if (beats !== 0.25 && engineModule && typeof engineModule.stepsPerBarAt === 'function') {
          const n = engineModule.stepsPerBarAt(settings.timeSignature, beats);
          if (Number.isFinite(n) && n > 0) return n;
        }
        return currentStepsPerBar();
      }

      function pulseStartsFor(track, n) {
        if (track === 'arp') return arpPulseStarts(n);
        const beats = trackStepBeats(track);
        if (beats === 0.25) return currentPulseStarts();
        // v0.0.131: a beat is 1/beats slots at this track's resolution, so the
        // pulse marks move with the rung — otherwise a 32nd-note grid would
        // mark its beats every four slots, i.e. every half beat.
        const pulses = engineModule && typeof engineModule.metrePulses === 'function'
          ? engineModule.metrePulses(settings.timeSignature)
          : null;
        const perBeat = 1 / beats;
        // v0.0.137: a beat that lands BETWEEN two slots gets no mark. At a
        // crotchet-triplet rung a 3/4 beat starts one and a half slots in, and
        // a mark rounded onto slot 2 would be pointing at the wrong step —
        // exactly the "readout that lies about the grid" failure this project
        // keeps hitting. Every straight rung divides a beat exactly, so this
        // only ever removes marks that were never true.
        const onSlot = (at) => Math.abs(at - Math.round(at)) < 1e-9;
        if (Array.isArray(pulses) && pulses.length) {
          const starts = [];
          let beat = 0;
          for (const p of pulses) {
            const at = beat * perBeat;
            if (onSlot(at)) starts.push(Math.round(at));
            beat += p;
          }
          return starts.filter((slot) => slot < n);
        }
        return Array.from({ length: Math.ceil(n / perBeat) }, (unused, i) => i * perBeat)
          .filter(onSlot)
          .map((at) => Math.round(at));
      }

      /**
       * Push a track's whole sequencer LIST. `sequencers` is authoritative
       * for a v14 engine; the singular `sequencer` (an alias of [0]) rides
       * along so a pre-v14 sanitiser still honours the first pattern. An
       * engine that understands neither simply drops both keys.
       */
      function commitSequencer(track) {
        const t = settings.tracks[track];
        t.sequencer = t.sequencers[0];
        const partial = {
          tracks: {
            [track]: {
              sequencers: structuredClone(t.sequencers),
              sequencer: structuredClone(t.sequencers[0]),
              // v21: the lane list travels WITH the patterns it keys, so a
              // lane and its steps can never reach the engine apart.
              ...(track === 'percussion' ? { lanes: structuredClone(t.lanes) } : {}),
            },
          },
        };
        if (track === 'arp') {
          // Mirror the on-flags into the legacy boolean mask so pre-v6
          // engines still honour the grid (and the complexity estimate
          // keeps working). The mirror is fixed at 16 slots, but only the
          // first arpStepsPerBar() of those actually sound this bar — pad
          // the rest with false so a pre-v6 engine can't play a step that
          // isn't really in the pattern (and the complexity estimate below
          // isn't skewed by stale "on" flags left over from a faster rate).
          const steps = t.sequencers[0].steps;
          const n = Math.min(16, arpStepsPerBar());
          settings.arp.steps = Array.from({ length: 16 }, (unused, i) => (i < n ? !!steps[i].on : false));
          partial.arp = { steps: settings.arp.steps.slice() };
          updateComplexityDisplay();
        }
        engine.setParams(partial);
        persistSettings();
      }

      // ---- block editor: REMOVED FROM THIS REPOSITORY (2026-07-29) --------
      // The block editor is a paid-tier feature and was being built in a
      // public repository behind a flag, which the owner ruled out: a feature
      // that is present and switched off is still published. Its source and
      // tests were moved out and purged from this repository's history.
      //
      // The seam is deliberately left here rather than deleted, so that a
      // build with the private module present picks it up with no change to
      // this file: `import.meta.glob` resolves to nothing when the file is
      // absent, which is exactly the null the code below already handles.
      const BLOCKS_MODULE = (() => {
        try {
          const loaders = Object.values(import.meta.glob('../scripts/blocks.js'));
          return loaders.length ? loaders[0] : null;
        } catch {
          return null;
        }
      })();

      let blocksApi;
      // v21: blocks.js grew a lane SPEC — `lanes: [{id, label}]`, rendered in
      // exactly the order given, which is what lets a renamed/reordered kit
      // read the same in both editors. An older build takes bare id strings
      // and reverses them for display, and would turn an object into the
      // string "[object Object]" — so the shape is probed, not assumed, using
      // the module's own pure fromParams().
      let blocksLaneSpec = false;

      function probeBlocksLaneSpec(api) {
        if (typeof api.fromParams !== 'function') return false;
        try {
          const layout = api.fromParams(
            { mode: 'manual', weights: [1], steps: {} },
            {
              track: 'percussion',
              lanes: [
                { id: 'high', label: 'High' },
                { id: 'low', label: 'Low' },
              ],
            }
          );
          const ids = layout && Array.isArray(layout.lanes) ? layout.lanes.map((lane) => lane.id) : [];
          return ids[0] === 'high' && ids[1] === 'low';
        } catch {
          return false;
        }
      }

      async function loadBlocksModule() {
        if (blocksApi !== undefined) return blocksApi;
        if (!BLOCKS_MODULE) {
          blocksApi = null;
          return null;
        }
        try {
          const mod = await BLOCKS_MODULE();
          blocksApi = mod && typeof mod.createBlockEditor === 'function' ? mod : null;
          blocksLaneSpec = blocksApi ? probeBlocksLaneSpec(blocksApi) : false;
        } catch {
          blocksApi = null;
        }
        return blocksApi;
      }

      const BLOCKS_SVG =
        '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">' +
        '<rect x="3" y="4" width="18" height="6" rx="1.5"/>' +
        '<rect x="3" y="14" width="12" height="6" rx="1.5"/>' +
        '</svg>';

      /** Next free probability-group id in a lane (v14 conditional trigs). */
      function nextGroupId(lane, slots) {
        let top = -1;
        for (let i = 0; i < slots; i++) {
          const g = lane[i] && lane[i].group;
          if (Number.isFinite(g) && g > top) top = g;
        }
        return top + 1;
      }

      const SEQ_LEGEND_BASE =
        'Keys: arrows move · Enter/Space toggles a step · Shift+↑/↓ velocity top · ' +
        'Alt+↑/↓ velocity bottom · [ and ] (or , and .) probability, Shift+[ / Shift+] ' +
        '(or Shift+, / Shift+.) narrows/widens a drifting probability range · T ties a ' +
        'step to the next one · G paints the step into the selected probability group ' +
        '(Esc drops the selection). ' +
        'Pointer: drag a cell vertically for the velocity band, grab the fat handle at ' +
        'the band top for its loudest edge, drag sideways across cells to tie them into ' +
        'one long note, and drag the thin bar under a step for its probability. The dots ' +
        'along the bottom colour-code probability groups: press any dot to start a group ' +
        'or select an existing one (its dots ring), press more dots to paint them in — ' +
        'gaps are fine — and press a selected member again to remove it. Inside a group ' +
        'each step in turn only gets its chance if the previous member actually sounded.';

      // v21: the third per-step axis only exists where the engine takes it, so
      // its keys are only documented there too.
      const SEQ_LEGEND_GATE =
        ' Note length: − and = (or + ) shorten and lengthen the note under the ' +
        'cursor, and dragging in the LOWER HALF of a cell does the same with the ' +
        'pointer (the upper half still shapes the velocity band). The bar fills ' +
        'the width of its step at length 1; past that the note runs into the next ' +
        'step and an arrow marks the overhang.';

      const SEQ_LEGEND_PITCH =
        ' Pitch: P types the step\u2019s own note (C#4 or a MIDI number; empty clears it) \u2014 ' +
        'a pinned step plays exactly that note, never re-pitched; Alt+drag a cell up or ' +
        'down nudges the pin by semitones.';

      const SEQ_LEGEND_RESOLUTION =
        ' Resolution: the \u00d72 / \u00f72 pair under the grid chooses the note value a '
        + 'step covers \u2014 crotchets down to hemi-demi-semiquavers. A finer grid draws '
        + 'more cells for the same bar and the engine plays exactly those. Triplets puts '
        + 'three steps in the time of two at whatever note value you are on, and \u00d72 / '
        + '\u00f72 then walk the triplet note values; press it again for straight time.';

      const SEQ_LEGEND_LANES =
        ' Lanes: “Add lane” copies the pattern of the lane it lands beside, its ' +
        'name is click-to-type, and Low/Mid/High says which of the kit’s sounds ' +
        'it plays. ▲/▼ move a lane (Alt+↑/↓ from its name does the same, and the ' +
        'grip can be dragged); the three built-in lanes cannot be removed.';

      /**
       * Shared metre-aware step grid: one lane for melody/bass/arp, and one per
       * kit lane (HIGH kinds at the top) for percussion. Per step: on/off,
       * velocity band (vertical drag, fat top handle), probability (mini-bar
       * under the cell), tie (sideways drag), probability group (dot row) and —
       * where the engine takes it — note length (lower-half drag).
       * A track may own SEVERAL sequencers (v14 Markov chain): the tab strip
       * picks which one this grid edits, "+" copies the current one, and each
       * carries a weight — how likely the others are to hand over to it at
       * loop end. Cells form a roving-tabindex ARIA grid; every value is
       * keyboard-adjustable and announced via aria-label.
       *
       * v21 lanes: percussion's lane list is user-editable (add/rename/re-kind/
       * remove/reorder, built-ins protected, cap 8). The lane id keys the step
       * map AND the kit editor's perKind overrides, so `onLanes` lets the voice
       * editor above rebuild its instrument tabs when the list changes.
       */
      function buildSequencer(container, track, { onLanes = null } = {}) {
        const label = TRACK_LABELS[track];
        const trackSettings = () => settings.tracks[track];
        const laneList = () => trackSettings().lanes;
        let lanes = laneListFor(track, trackSettings());
        const list = () => settings.tracks[track].sequencers;
        // The third axis is melodic-only: a kit hit has no length to shape.
        const gateAxis = engineCaps.stepGate && track !== 'percussion';
        const laneAxis = track === 'percussion' && engineCaps.percussionLanes;
        // v0.0.111: the pitch pin is offered where the engine honours it —
        // melody, bass and user melodic lines; the arp's pitches are
        // sequence-derived and pinning one there would be a dial the engine
        // ignores, the exact failure this repo tests against.
        const pitchAxis = engineCaps.stepPitch && ['melody', 'bass'].includes(track)
          || (engineCaps.stepPitch && !['percussion', 'arp', 'melody', 'bass'].includes(track)
              && TUNED_TRACKS.includes(track));
        const SEQ_LEGEND =
          SEQ_LEGEND_BASE + (gateAxis ? SEQ_LEGEND_GATE : '')
          + (pitchAxis ? SEQ_LEGEND_PITCH : '')
          + (engineCaps.stepResolution && track !== 'arp' ? SEQ_LEGEND_RESOLUTION : '')
          + (laneAxis ? SEQ_LEGEND_LANES : '');
        let active = 0;
        const current = () => list()[Math.min(active, list().length - 1)];
        const laneSteps = (lane) => (lane.key ? current().steps[lane.key] : current().steps);

        const root = document.createElement('div');
        root.className = 'seq';
        container.append(root);

        const head = document.createElement('div');
        head.className = 'seq-head';
        const titleBox = document.createElement('span');
        titleBox.className = 'seq-title';
        const title = document.createElement('span');
        title.className = 'panel-label';
        title.textContent = 'Step sequencer';
        titleBox.append(title);
        infoButton(titleBox, 'the step sequencer', SEQ_LEGEND);
        const modeGroup = document.createElement('div');
        modeGroup.className = 'segmented';
        modeGroup.setAttribute('role', 'radiogroup');
        modeGroup.setAttribute('aria-label', `${label} sequencer mode`);
        const modeRadios = [];
        for (const m of ['auto', 'manual']) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `seq-mode-${track}`;
          input.id = `seq-mode-${track}-${m}`;
          input.value = m;
          input.checked = current().mode === m;
          const lab = document.createElement('label');
          lab.htmlFor = input.id;
          lab.textContent = m === 'auto' ? 'Auto' : 'Manual';
          input.addEventListener('change', () => {
            if (!input.checked) return;
            current().mode = m;
            commitSequencer(track);
          });
          modeGroup.append(input, lab);
          modeRadios.push(input);
        }

        // -- v13/v16 editor entries: blocks now, JS later -------------------
        const editors = document.createElement('div');
        editors.className = 'seq-editors';
        const blockButton = document.createElement('button');
        blockButton.type = 'button';
        blockButton.className = 'round-button seq-editor-button seq-blocks-button';
        blockButton.innerHTML = BLOCKS_SVG;
        blockButton.setAttribute('aria-label', `Edit ${label}'s pattern as blocks`);
        blockButton.setAttribute('aria-expanded', 'false');
        // The block editor is a Plus-tier feature: hidden until the tier can
        // be bought (owner rule — never give-then-take). Dev unlock shows it.
        blockButton.hidden = !BLOCKS_MODULE || PAID_FEATURES_HIDDEN;
        editors.append(blockButton);
        // The v13 JS-editor entry (>_) is a paid feature and is not built at
        // all pre-launch — not greyed, not tooltipped. Flipping
        // PAID_FEATURES_HIDDEN brings it back as a disabled affordance until
        // the editor itself exists.
        if (!PAID_FEATURES_HIDDEN) {
          const codeButton = document.createElement('button');
          codeButton.type = 'button';
          codeButton.className = 'round-button seq-editor-button seq-code-button';
          codeButton.textContent = '>_';
          codeButton.disabled = true;
          codeButton.setAttribute('aria-label', 'JS editor');
          describe(codeButton, 'JS editor coming.');
          editors.append(codeButton);
        }
        head.append(titleBox, modeGroup, editors);

        // -- v14 multi-sequencer tab strip + per-sequencer weight -----------
        const tabsRow = document.createElement('div');
        tabsRow.className = 'seq-tabs';
        const tabs = document.createElement('div');
        tabs.className = 'segmented seq-tab-strip';
        tabs.setAttribute('role', 'tablist');
        tabs.setAttribute('aria-label', `${label} sequencers`);
        const addButton = document.createElement('button');
        addButton.type = 'button';
        addButton.className = 'secondary-button seq-add';
        addButton.textContent = '+';
        addButton.setAttribute('aria-label', 'Add a sequencer (copies the current one)');
        const weightWrap = document.createElement('label');
        weightWrap.className = 'seq-weight';
        const weightLabel = document.createElement('span');
        weightLabel.textContent = 'Weight';
        const weightInput = document.createElement('input');
        weightInput.type = 'number';
        weightInput.min = '0';
        weightInput.max = '100';
        weightInput.step = '0.5';
        weightInput.inputMode = 'decimal';
        weightWrap.append(weightLabel, weightInput);
        // v0.0.116: HOW the tabs advance. Shuffle is the Markov pick the
        // weights drive; In order plays the tabs as a composed sequence —
        // and then the weight box hides, because a control the engine
        // ignores must not be on screen.
        const orderWrap = document.createElement('div');
        orderWrap.className = 'segmented seq-order';
        const orderRadios = [];
        for (const [value, text] of [['weights', 'Shuffle'], ['chain', 'In order']]) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `seq-order-${track}`;
          input.id = `seq-order-${track}-${value}`;
          input.value = value;
          const lab = document.createElement('label');
          lab.htmlFor = input.id;
          lab.textContent = text;
          input.addEventListener('change', () => {
            if (!input.checked) return;
            if (value === 'chain') settings.tracks[track].sequencerAdvance = 'chain';
            else delete settings.tracks[track].sequencerAdvance;
            engine.setParams({
              tracks: { [track]: { sequencerAdvance: value === 'chain' ? 'chain' : null } },
            });
            persistSettings();
            renderTabs();
          });
          orderWrap.append(input, lab);
          orderRadios.push(input);
        }
        tabsRow.append(tabs, addButton, orderWrap, weightWrap);
        describe(
          orderWrap,
          'Shuffle picks the next sequencer by the weights; In order plays the tabs as a composed sequence, 1 then 2 then 3, and wraps.'
        );
        describe(
          weightInput,
          'How likely the other sequencers are to hand over to this one when a loop ends.'
        );
        describe(addButton, 'Add a sequencer — a copy of the one showing now.');

        // -- v21 kit lane management ---------------------------------------
        const laneBar = document.createElement('div');
        laneBar.className = 'seq-lane-bar';
        laneBar.hidden = !laneAxis;
        const addLaneButton = document.createElement('button');
        addLaneButton.type = 'button';
        addLaneButton.className = 'secondary-button seq-lane-add';
        addLaneButton.textContent = 'Add lane';
        laneBar.append(addLaneButton);
        describe(
          addLaneButton,
          'Add a kit lane — it copies the pattern of the lane it lands beside, and you can rename it and pick which of the kit’s sounds it plays.'
        );

        // v0.0.94 (his 89): mass edit — "fill a whole row, or every second
        // note". Three actions on the focused lane (single-lane tracks have
        // only lane 0, so focus is moot there). Wired after the grid exists;
        // handlers resolve the lane at click time.
        const massBar = document.createElement('div');
        massBar.className = 'seq-lane-bar seq-mass-bar';
        const massActions = ['Fill', 'Every 2nd', 'Clear'].map((text) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'secondary-button seq-mass-action';
          b.textContent = text;
          massBar.append(b);
          return b;
        });
        describe(massActions[0], 'Turn every step in this lane on.');
        describe(massActions[1], 'Every second step on, the rest off — the quickest pulse.');
        describe(massActions[2], 'Turn every step in this lane off.');

        // v0.0.131 (his item 89): the editing resolution, as the ×2 / ÷2
        // controller he asked for — "whole notes, semi-brieves, quavers,
        // semi-quavers, demi-semi-quavers". ÷2 halves the slot (finer grid),
        // ×2 doubles it. The readout names the note value, because that is
        // what a musician is choosing; triplets are NOT on this ladder, by
        // his own reading, and say so in the tooltip rather than pretending.
        // v0.0.137 finishes item 89: triplets, which he named as the one thing
        // ×2/÷2 cannot reach, get their own ladder and their own button.
        const NOTE_VALUE_NAMES = new Map([
          [1, 'crotchets'],
          [0.5, 'quavers'],
          [0.25, 'semiquavers'],
          [0.125, 'demi-semiquavers'],
          [0.0625, 'hemi-demi-semiquavers'],
          [2 / 3, 'crotchet triplets'],
          [1 / 3, 'quaver triplets'],
          [1 / 6, 'semiquaver triplets'],
          [1 / 12, 'demi-semiquaver triplets'],
        ]);
        // Looked up with a tolerance, never by ===: a rung that has been through
        // JSON (a share link, a saved setup) can differ from 1/3 in its last
        // bit, and a readout that fell back to "0.3333333333333333 beats"
        // would be this project's readout-lying failure in a new costume.
        const noteValueName = (beats) => {
          for (const [rung, name] of NOTE_VALUE_NAMES) {
            if (Math.abs(rung - beats) < 1e-9) return name;
          }
          return `${beats} beats`;
        };
        const resBar = document.createElement('div');
        resBar.className = 'seq-lane-bar seq-res-bar';
        resBar.hidden = !engineCaps.stepResolution || track === 'arp';
        const resCoarser = document.createElement('button');
        resCoarser.type = 'button';
        resCoarser.className = 'secondary-button seq-res-step';
        resCoarser.textContent = '×2';
        const resLabel = document.createElement('span');
        resLabel.className = 'value-readout seq-res-readout';
        const resFiner = document.createElement('button');
        resFiner.type = 'button';
        resFiner.className = 'secondary-button seq-res-step';
        resFiner.textContent = '÷2';
        const resTriplet = document.createElement('button');
        resTriplet.type = 'button';
        resTriplet.className = 'secondary-button seq-res-step seq-res-triplet';
        resTriplet.textContent = 'Triplets';
        resTriplet.hidden = !engineCaps.stepTriplets;
        resBar.append(resCoarser, resLabel, resFiner, resTriplet);
        describe(resCoarser, 'Coarser grid: each step covers twice the time (fewer, longer steps).');
        describe(resFiner, 'Finer grid: each step covers half the time.');
        describe(resTriplet, 'Triplets: three steps in the time of two, at the note value you are on. Press again for straight time.');

        const RES_STRAIGHT = engineModule && Array.isArray(engineModule.STEP_RESOLUTIONS)
          ? [...engineModule.STEP_RESOLUTIONS].sort((a, b) => b - a)
          : [1, 0.5, 0.25, 0.125, 0.0625];
        const RES_TRIPLET = engineModule && Array.isArray(engineModule.STEP_RESOLUTIONS_TRIPLET)
          ? [...engineModule.STEP_RESOLUTIONS_TRIPLET].sort((a, b) => b - a)
          : [2 / 3, 1 / 3, 1 / 6, 1 / 12];
        const sameRung = (a, b) => Math.abs(a - b) < 1e-9;
        const onTripletLadder = (beats) => RES_TRIPLET.some((rung) => sameRung(rung, beats));
        // ×2/÷2 walks WITHIN the feel you are in: halving a quaver triplet
        // gives a semiquaver triplet, and never silently straightens the grid.
        const ladderFor = (beats) => (onTripletLadder(beats) ? RES_TRIPLET : RES_STRAIGHT);
        const rungIndex = (ladder, beats) => ladder.findIndex((rung) => sameRung(rung, beats));

        function syncResolutionUI() {
          if (resBar.hidden) return;
          const beats = trackStepBeats(track);
          const ladder = ladderFor(beats);
          const at = rungIndex(ladder, beats);
          resLabel.textContent = noteValueName(beats);
          resCoarser.disabled = at <= 0;
          resFiner.disabled = at < 0 || at >= ladder.length - 1;
          resLabel.setAttribute('aria-label', `Editing resolution: ${resLabel.textContent}`);
          const triplet = onTripletLadder(beats);
          resTriplet.setAttribute('aria-pressed', triplet ? 'true' : 'false');
        }

        // The ENGINE resizes the lanes: it owns how many slots a resolution
        // stores, so the page asks and then adopts the answer rather than
        // guessing at a length (the readout-lying failure class).
        function applyResolution(next, beats) {
          if (!Number.isFinite(next) || sameRung(next, beats)) return;
          settings.tracks[track].stepBeats = next;
          engine.setParams({ tracks: { [track]: { stepBeats: next } } });
          try {
            const live = engine.getParams()?.tracks?.[track];
            if (live && Array.isArray(live.sequencers)) {
              settings.tracks[track].sequencers = structuredClone(live.sequencers);
              settings.tracks[track].sequencer = settings.tracks[track].sequencers[0];
              if (live.stepBeats !== undefined) settings.tracks[track].stepBeats = live.stepBeats;
              else delete settings.tracks[track].stepBeats;
            }
          } catch {}
          persistSettings();
          render();
        }

        function stepResolution(direction) {
          const beats = trackStepBeats(track);
          const ladder = ladderFor(beats);
          const at = rungIndex(ladder, beats);
          applyResolution(ladder[clamp(at + direction, 0, ladder.length - 1)], beats);
        }

        // Switching feel keeps the NOTE VALUE — quavers become quaver triplets,
        // not whichever number happens to be nearest. The engine owns that
        // mapping so the page and a share link agree on it.
        function toggleTriplet() {
          const beats = trackStepBeats(track);
          const triplet = !onTripletLadder(beats);
          let next = null;
          if (engineModule && typeof engineModule.nearestResolution === 'function') {
            next = engineModule.nearestResolution(beats, { triplet });
          } else {
            const from = triplet ? RES_STRAIGHT : RES_TRIPLET;
            const to = triplet ? RES_TRIPLET : RES_STRAIGHT;
            const at = rungIndex(from, beats);
            next = to[clamp(at < 0 ? 2 : at, 0, to.length - 1)];
          }
          applyResolution(next, beats);
        }

        resCoarser.addEventListener('click', () => stepResolution(-1));
        resFiner.addEventListener('click', () => stepResolution(1));
        resTriplet.addEventListener('click', toggleTriplet);

        const scroll = document.createElement('div');
        scroll.className = 'seq-scroll';
        const beatsEl = document.createElement('div');
        beatsEl.className = 'seq-beats';
        beatsEl.setAttribute('aria-hidden', 'true');
        const gridEl = document.createElement('div');
        gridEl.className = 'seq-rows';
        gridEl.setAttribute('role', 'grid');
        gridEl.setAttribute('aria-label', `${label} step sequencer`);
        scroll.append(beatsEl, gridEl);

        const blocksHost = document.createElement('div');
        blocksHost.className = 'seq-blocks';
        blocksHost.hidden = true;

        // v0.0.75: the scale the pitch ticks are drawn against. A contour with
        // no scale beside it is a picture rather than a readout, and the
        // window widens as the piece uses more of its range — so it has to say
        // what it currently is rather than be inferred.
        const pitchLegend = document.createElement('p');
        pitchLegend.className = 'seq-pitch-legend';
        pitchLegend.hidden = true;

        root.append(head, tabsRow, laneBar, massBar, resBar, scroll, pitchLegend, blocksHost);

        let cellRefs = []; // [lane][step] -> { cell, band, bandTop, probFill, dot }
        let focusPos = { lane: 0, step: 0 };
        let playhead = -1;

        function stepText(lane, i, s) {
          const lanePart = lane.label ? `${lane.label} lane, ` : '';
          const probPart = isPlainObject(s.prob)
            ? `probability ${Math.round(s.prob.min * 100)} to ${Math.round(s.prob.max * 100)}%, drifting`
            : `probability ${Math.round(s.prob * 100)}%`;
          const tiePart = s.tie === true ? ', tied to the next step' : '';
          const groupPart = Number.isFinite(s.group) ? `, group ${s.group + 1}` : '';
          const gatePart =
            gateAxis && Number.isFinite(s.gate) ? `, length ${s.gate.toFixed(2)} of a step` : '';
          const pinPart = Number.isFinite(s.midi)
            ? `, pinned to ${midiToNoteName(s.midi)} \u2014 plays exactly that note`
            : '';
          // v0.0.75: the app's own notes belong in the label too. A tick
          // drawn on the face is invisible to a screen reader, and "show what
          // the app is doing" is not a sighted-only promise.
          const notes = chosenNotesAt(lane, i);
          const notePart = notes ? `, the app plays ${notes}` : '';
          return (
            `${lanePart}step ${i + 1}: ${s.on ? 'on' : 'off'}, ` +
            `velocity ${Math.round(s.vmin * 100)} to ${Math.round(s.vmax * 100)}%, ` +
            probPart +
            gatePart +
            pinPart +
            tiePart +
            groupPart +
            notePart
          );
        }

        /** The step's note length, defaulted to whatever the engine plays an
         * unmarked step at — so the dial and the sound agree before the user
         * has ever touched the axis. */
        function stepGate(s) {
          return Number.isFinite(s.gate) ? s.gate : SEQ_GATE_DEFAULT;
        }

        function setStepGate(s, value) {
          s.gate = clamp(Math.round(value / SEQ_GATE_NUDGE) * SEQ_GATE_NUDGE, SEQ_GATE_MIN, SEQ_GATE_MAX);
        }

        function updateCell(li, i) {
          const lane = lanes[li];
          const s = laneSteps(lane)[i];
          const ref = cellRefs[li][i];
          ref.cell.classList.toggle('seq-cell-on', s.on);
          ref.cell.classList.toggle('seq-cell-tie', s.tie === true);
          // role=gridcell + a label stating on/off/velocity/probability is
          // the valid pattern here: aria-selected implies row/grid
          // *selection* (not toggle state) and aria-pressed is only valid
          // on button-role elements, so neither belongs on a gridcell —
          // the label alone carries the state. aria-valuetext is likewise
          // dropped: it's a range-widget attribute, inert on a gridcell.
          const text = stepText(lane, i, s);
          ref.cell.setAttribute('aria-label', text);
          ref.band.style.bottom = `${s.vmin * 100}%`;
          ref.band.style.height = `${Math.max(0, s.vmax - s.vmin) * 100}%`;
          // v21 third axis: the band stops where the note stops, so a short
          // gate reads as a short bar inside its step. Past 1 the note runs on
          // into the next step, which the legato arrow marks instead (the bar
          // itself cannot show width it hasn't got).
          if (gateAxis) {
            const gate = stepGate(s);
            ref.band.style.right = 'auto';
            ref.band.style.width = `calc((100% - 4px) * ${Math.min(gate, 1)})`;
            ref.cell.classList.toggle('seq-cell-legato', s.on && gate > 1);
          }
          // The fat grab handle rides the band's loud edge; ≥10 px tall (CSS)
          // so the velocity top is reachable without pixel-hunting.
          ref.bandTop.style.bottom = `${s.vmax * 100}%`;
          // A plain prob fills from 0 to the value (matches the on/off
          // cell's velocity band read); a ranged prob instead shows the
          // drifting window itself (left edge at min, width = max-min).
          if (isPlainObject(s.prob)) {
            ref.probFill.style.left = `${s.prob.min * 100}%`;
            ref.probFill.style.width = `${Math.max(0, s.prob.max - s.prob.min) * 100}%`;
            ref.probFill.classList.add('seq-prob-fill-range');
          } else {
            ref.probFill.style.left = '0';
            ref.probFill.style.width = `${s.prob * 100}%`;
            ref.probFill.classList.remove('seq-prob-fill-range');
          }
          const grouped = Number.isFinite(s.group);
          const selected = grouped && activeGroup && activeGroup.lane === li && activeGroup.id === s.group;
          ref.dot.classList.toggle('seq-dot-on', grouped);
          ref.dot.classList.toggle('seq-dot-active', !!selected);
          ref.dot.style.background = grouped
            ? GROUP_COLOURS[s.group % GROUP_COLOURS.length]
            : '';
          ref.dot.setAttribute(
            'aria-label',
            selected
              ? `Step ${i + 1} is in the selected probability group ${s.group + 1}. Press to remove it.`
              : grouped
                ? `Step ${i + 1} is in probability group ${s.group + 1}. Press to select that group for painting.`
                : activeGroup && activeGroup.lane === li
                  ? `Step ${i + 1} is ungrouped. Press to paint it into the selected group.`
                  : `Step ${i + 1} is ungrouped. Press to start a new probability group.`
          );
          drawPin(li, i);
        }

        function setFocus(li, i, focus = true) {
          const n = stepsPerBarFor(track);
          li = clamp(li, 0, lanes.length - 1);
          i = clamp(i, 0, n - 1);
          // v0.0.92: a step absorbed into a tied note has no box of its own —
          // walk on in the direction of travel rather than focusing nothing.
          // AUDIT FIX: the old pair of walks could still land on a hidden
          // cell — slot 0 absorbed into a tie (or a hidden run reaching the
          // last slot) left `i` exactly where it started, so focus went to a
          // box nobody can see and the keyboard edited an invisible step.
          // The search now sweeps OUTWARD from the wanted slot and only
          // gives up if the whole lane is absorbed, which cannot happen.
          const hidden = (idx) => cellRefs[li][idx]?.cell.style.display === 'none';
          if (hidden(i)) {
            const dir = i >= focusPos.step ? 1 : -1;
            let found = -1;
            for (let step = 0; step < n && found < 0; step++) {
              const ahead = i + step * dir;
              const behind = i - step * dir;
              if (ahead >= 0 && ahead < n && !hidden(ahead)) found = ahead;
              else if (behind >= 0 && behind < n && !hidden(behind)) found = behind;
            }
            if (found >= 0) i = found;
          }
          const prev = (cellRefs[focusPos.lane] || [])[focusPos.step];
          if (prev) prev.cell.tabIndex = -1;
          focusPos = { lane: li, step: i };
          const ref = cellRefs[li][i];
          ref.cell.tabIndex = 0;
          if (focus) ref.cell.focus();
        }

        // v0.0.94 (his 89): the mass actions land on the focused lane —
        // which is lane 0 everywhere but the kit, where the last-touched
        // lane is the one under the hand.
        {
          const massFns = [
            (st) => { st.on = true; },
            (st, i) => { st.on = i % 2 === 0; },
            (st) => { st.on = false; },
          ];
          massActions.forEach((btn, idx) => {
            btn.addEventListener('click', () => {
              const li = clamp(focusPos.lane, 0, lanes.length - 1);
              const steps = laneSteps(lanes[li]);
              // The stored lane can be longer than the bar being shown (the
              // engine keeps a fixed-length lane; the metre decides how many
              // steps are in play) — mass edit acts on the VISIBLE bar.
              const n = Math.min(stepsPerBarFor(track), steps.length, cellRefs[li].length);
              for (let i = 0; i < n; i++) massFns[idx](steps[i], i);
              for (let i = 0; i < n; i++) updateCell(li, i);
              applyTieSpans(li);
              commitSequencer(track);
            });
          });
        }

        /** Join the group above, or start a new one; a grouped step leaves. */
        /**
         * v0.0.92 (his 105): a tie MERGES the boxes — one double-width box
         * for two tied steps, triple for three — instead of a marker nobody
         * could see. The head cell spans the run in all three rows (cells,
         * group dots, probability bars); absorbed steps lose their boxes,
         * which is honest, because the engine drops them from the bar.
         */
        function applyTieSpans(li) {
          const lane = laneSteps(lanes[li]);
          const refs = cellRefs[li];
          const rowsOf = (r) => [r.cell, r.probFill?.parentElement, r.dot?.parentElement];
          // AUDIT FIX: bounded by the VISIBLE bar, not the stored lane. The
          // stored lane is a fixed twenty slots while the metre decides how
          // many are in play, so a tie stored past the bar's end (switch 5/4
          // → 3/4 with ties near the old end) made a head span more columns
          // than the grid has — the box overran its own row.
          const visible = Math.min(stepsPerBarFor(track), lane.length, refs.length);
          let i = 0;
          while (i < visible) {
            let span = 1;
            while (i + span < visible && lane[i + span - 1].tie === true) span += 1;
            const head = refs[i];
            if (head) {
              for (const el of rowsOf(head)) {
                if (!el) continue;
                el.style.display = '';
                el.style.gridColumn = span > 1 ? `span ${span}` : '';
              }
            }
            for (let k = 1; k < span; k++) {
              const r = refs[i + k];
              if (!r) continue;
              for (const el of rowsOf(r)) {
                if (el) el.style.display = 'none';
              }
            }
            i += span;
          }
        }

        /**
         * v0.0.103 (his ruling on the groups question): "the probability
         * group is not always contiguous … I want to be able to select a
         * bunch of items, and have them in one probability group", and "a
         * gap is NOT a probability group boundary". So the join-my-left-
         * neighbour rule is gone, replaced by painting into a SELECTED
         * group: touch any group's dot to select it (its dots ring), touch
         * ungrouped dots to paint them in — gaps and all — touch a selected
         * member again to remove it, Esc drops the selection, and touching
         * an ungrouped dot with nothing selected starts a fresh group.
         * Groups stay within one lane: the engine rolls each lane's chain
         * on its own, so a cross-lane paint starts a new group there.
         */
        let activeGroup = null; // { lane, id } — the group selected for painting

        function repaintDots() {
          const n = stepsPerBarFor(track);
          for (let l = 0; l < lanes.length; l++) {
            for (let k = 0; k < Math.min(n, cellRefs[l].length); k++) updateCell(l, k);
          }
        }

        function toggleGroup(li, i) {
          const lane = laneSteps(lanes[li]);
          const s = lane[i];
          if (Number.isFinite(s.group)) {
            if (activeGroup && activeGroup.lane === li && activeGroup.id === s.group) {
              // null, not delete: the engine's step sanitiser merges against
              // the stored step, so an ABSENT field keeps the old value —
              // null is the explicit "clear it" the merge law understands.
              s.group = null; // a selected member touched again leaves the group
            } else {
              activeGroup = { lane: li, id: s.group }; // select for painting, change nothing
              repaintDots();
              return;
            }
          } else {
            if (!activeGroup || activeGroup.lane !== li) {
              activeGroup = { lane: li, id: nextGroupId(lane, stepsPerBarFor(track)) };
            }
            s.group = activeGroup.id;
          }
          repaintDots();
          commitSequencer(track);
        }

        /** The pin, visible on the cell: a tiny note-name label. */
        function drawPin(li, i) {
          const ref = cellRefs[li][i];
          if (!ref) return;
          const s = laneSteps(lanes[li])[i];
          let label = ref.cell.querySelector('.seq-pin');
          if (Number.isFinite(s.midi)) {
            if (!label) {
              label = document.createElement('span');
              label.className = 'seq-pin';
              label.setAttribute('aria-hidden', 'true');
              ref.cell.append(label);
            }
            label.textContent = midiToNoteName(s.midi);
          } else if (label) {
            label.remove();
          }
        }

        /** P on a focused cell: type the step's own note in place. */
        function openPitchEditor(li, i, cell) {
          if (cell.querySelector('.seq-pitch-input')) return;
          const s = laneSteps(lanes[li])[i];
          const input = document.createElement('input');
          input.type = 'text';
          input.className = 'seq-pitch-input';
          // AUDIT FIX: the input sits INSIDE the cell, so clicking into it
          // (to place the caret) reached the cell's own pointerdown — which
          // closed the editor on blur and toggled the step off.
          for (const type of ['pointerdown', 'pointerup', 'click', 'dblclick']) {
            input.addEventListener(type, (event) => event.stopPropagation());
          }
          input.value = Number.isFinite(s.midi) ? midiToNoteName(s.midi) : '';
          input.placeholder = 'C#4';
          input.setAttribute('aria-label', 'This step\u2019s own note \u2014 empty clears the pin');
          cell.append(input);
          input.focus();
          input.select();
          let closed = false;
          const done = (commitIt) => {
            if (closed) return;
            closed = true;
            input.remove();
            cell.focus();
            if (!commitIt) return;
            const text = input.value.trim();
            if (!text) {
              s.midi = null; // null, not delete — the engine's merge law
            } else {
              const named = parseNoteNameToMidi(text);
              const numbered = Number.isFinite(Number(text))
                ? clamp(Math.round(Number(text)), 0, 127)
                : null;
              const midi = named ?? numbered;
              if (midi === null) return; // not understood: change nothing
              s.midi = midi;
              s.on = true; // naming a pitch implies the step should sound
            }
            updateCell(li, i);
            commitSequencer(track);
          };
          input.addEventListener('keydown', (event) => {
            event.stopPropagation();
            if (event.key === 'Enter') {
              event.preventDefault();
              done(true);
            } else if (event.key === 'Escape') {
              event.preventDefault();
              done(false);
            }
          });
          input.addEventListener('blur', () => done(true));
        }

        function wireCell(li, i, cell, probEl, bandTop, dot) {
          const getStep = () => laneSteps(lanes[li])[i];
          const commit = () => {
            updateCell(li, i);
            applyTieSpans(li);
            commitSequencer(track);
          };

          dot.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleGroup(li, i);
          });

          // Fat handle: drags the band's TOP (loudest) edge on its own.
          bandTop.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            e.preventDefault();
            e.stopPropagation();
            setFocus(li, i);
            const rect = cell.getBoundingClientRect();
            const vAt = (clientY) => clamp(1 - (clientY - rect.top) / rect.height, 0, 1);
            const onMove = (ev) => {
              const s = getStep();
              s.on = true;
              s.vmax = Math.max(s.vmin, vAt(ev.clientY));
              updateCell(li, i);
            };
            const onUp = () => {
              bandTop.removeEventListener('pointermove', onMove);
              bandTop.removeEventListener('pointerup', onUp);
              bandTop.removeEventListener('pointercancel', onUp);
              commitSequencer(track);
            };
            try {
              bandTop.setPointerCapture(e.pointerId);
            } catch {}
            bandTop.addEventListener('pointermove', onMove);
            bandTop.addEventListener('pointerup', onUp);
            bandTop.addEventListener('pointercancel', onUp);
          });

          cell.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            e.preventDefault();
            setFocus(li, i);
            const rect = cell.getBoundingClientRect();
            const vAt = (clientY) => clamp(1 - (clientY - rect.top) / rect.height, 0, 1);
            const v0 = vAt(e.clientY);
            const slots = stepsPerBarFor(track);
            // AUDIT FIX: measured from a PLAIN cell, not from `rect` — the
            // head of a merged tie is span× wider, so re-dragging a tie moved
            // by span columns per column of travel.
            const columnWidth = (() => {
              const plain = [...gridEl.querySelectorAll('.seq-cell')]
                .find((el) => el.style.display !== 'none' && el.style.gridColumn === '');
              const w = plain ? plain.getBoundingClientRect().width : rect.width;
              return (w > 0 ? w : rect.width) + 3; // grid gap
            })();
            let gesture = null; // 'band' | 'tie' | 'gate'
            let tieEnd = i;
            // v21: which axis a vertical drag means is decided by where it
            // STARTED — lower half is the note's length, upper half the
            // velocity band it has always been. The fat top handle (its own
            // element) is unaffected either way.
            const gateZone = gateAxis && v0 <= 0.5;
            const pitchZone = pitchAxis && e.altKey;
            let pitch0 = null;
            let gate0 = SEQ_GATE_DEFAULT;

            /** Sideways drag merges the crossed steps into one tied note. */
            const applyTie = (end) => {
              const lane = laneSteps(lanes[li]);
              const last = clamp(end, i, slots - 1);
              for (let k = i; k <= last; k++) {
                lane[k].on = true;
                // null, not delete: an absent field survives the engine's
                // step merge — null is what actually unties there.
                if (k < last) lane[k].tie = true;
                else lane[k].tie = null;
                updateCell(li, k);
              }
              // Dragging back shortens the run: the steps beyond it lose the
              // tie they picked up on the way out.
              for (let k = last + 1; k <= tieEnd && k < slots; k++) {
                lane[k].tie = null;
                updateCell(li, k);
              }
              tieEnd = last;
            };

            const onMove = (ev) => {
              const dx = ev.clientX - e.clientX;
              const dy = ev.clientY - e.clientY;
              if (!gesture) {
                if (Math.abs(dx) < 6 && Math.abs(dy) < 4) return;
                gesture = pitchZone ? 'pitch'
                  : Math.abs(dx) > Math.abs(dy) ? 'tie' : gateZone ? 'gate' : 'band';
                if (gesture === 'gate') gate0 = stepGate(getStep());
                if (gesture === 'pitch') {
                  const s = getStep();
                  pitch0 = Number.isFinite(s.midi) ? s.midi : 60;
                }
              }
              if (gesture === 'pitch') {
                const s = getStep();
                s.on = true;
                s.midi = clamp(pitch0 + Math.round(-dy / 8), 0, 127);
                updateCell(li, i);
                return;
              }
              if (gesture === 'tie') {
                applyTie(i + Math.round(dx / Math.max(1, columnWidth)));
                return;
              }
              if (gesture === 'gate') {
                const s = getStep();
                s.on = true; // shaping a length implies the step should sound
                // A full cell height of travel covers the whole 0.1–2 span.
                setStepGate(s, gate0 + (vAt(ev.clientY) - v0) * (SEQ_GATE_MAX - SEQ_GATE_MIN));
                updateCell(li, i);
                return;
              }
              const v1 = vAt(ev.clientY);
              const s = getStep();
              s.on = true; // shaping a band implies the step should sound
              s.vmin = Math.min(v0, v1);
              s.vmax = Math.max(v0, v1);
              updateCell(li, i);
            };
            const finish = (toggleOnTap) => () => {
              cell.removeEventListener('pointermove', onMove);
              cell.removeEventListener('pointerup', up);
              cell.removeEventListener('pointercancel', cancel);
              if (!gesture && toggleOnTap) {
                const s = getStep();
                s.on = !s.on;
                updateCell(li, i);
              }
              commitSequencer(track);
            };
            const up = finish(true);
            const cancel = finish(false);
            try {
              cell.setPointerCapture(e.pointerId);
            } catch {}
            cell.addEventListener('pointermove', onMove);
            cell.addEventListener('pointerup', up);
            cell.addEventListener('pointercancel', cancel);
          });

          const probFromEvent = (ev) => {
            const r = probEl.getBoundingClientRect();
            const p = clamp((ev.clientX - r.left) / Math.max(1, r.width), 0, 1);
            const s = getStep();
            // The mini-bar drags the midpoint only — an existing {min,max}
            // shifts with it (width preserved) rather than collapsing.
            s.prob = shiftRangeMid(s.prob, Math.round(p * 20) / 20);
            updateCell(li, i);
          };
          probEl.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            e.preventDefault();
            setFocus(li, i);
            probFromEvent(e);
            const onMove = (ev) => probFromEvent(ev);
            const onUp = () => {
              probEl.removeEventListener('pointermove', onMove);
              probEl.removeEventListener('pointerup', onUp);
              probEl.removeEventListener('pointercancel', onUp);
              commitSequencer(track);
            };
            try {
              probEl.setPointerCapture(e.pointerId);
            } catch {}
            probEl.addEventListener('pointermove', onMove);
            probEl.addEventListener('pointerup', onUp);
            probEl.addEventListener('pointercancel', onUp);
          });

          cell.addEventListener('keydown', (e) => {
            const s = getStep();
            const nudge = 0.05;
            const snap = (v) => Math.round(v * 20) / 20;
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              s.on = !s.on;
              commit();
            } else if (e.key === 't' || e.key === 'T') {
              // Keyboard equivalent of the sideways tie drag.
              e.preventDefault();
              if (s.tie === true) s.tie = null; // null unties at the ENGINE too — a deleted key would survive its step merge
              else if (i < stepsPerBarFor(track) - 1) s.tie = true;
              commit();
            } else if (e.key === 'g' || e.key === 'G') {
              e.preventDefault();
              toggleGroup(li, i);
            } else if (e.ctrlKey || e.metaKey) {
              // AUDIT FIX: a browser/OS chord is not a grid edit — ⌘T, ⌘G,
              // ⌘[ and friends were silently tying, grouping and re-probing
              // steps on their way past.
              return;
            } else if (pitchAxis && (e.key === 'p' || e.key === 'P')) {
              e.preventDefault();
              openPitchEditor(li, i, cellRefs[li][i].cell);
            } else if (e.key === 'Escape' && activeGroup) {
              // Drop the group selection so the next dot press starts fresh.
              e.preventDefault();
              activeGroup = null;
              repaintDots();
            } else if (gateAxis && (e.key === '-' || e.key === '_')) {
              // Keyboard pair for the note-length axis. '+' arrives as
              // Shift+'=' on most layouts, so both characters are accepted.
              e.preventDefault();
              setStepGate(s, stepGate(s) - SEQ_GATE_NUDGE);
              commit();
            } else if (gateAxis && (e.key === '=' || e.key === '+')) {
              e.preventDefault();
              setStepGate(s, stepGate(s) + SEQ_GATE_NUDGE);
              commit();
            } else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
              const d = e.key === 'ArrowUp' ? nudge : -nudge;
              if (e.shiftKey) {
                e.preventDefault();
                s.vmax = clamp(snap(s.vmax + d), s.vmin, 1);
                commit();
              } else if (e.altKey) {
                e.preventDefault();
                s.vmin = clamp(snap(s.vmin + d), 0, s.vmax);
                commit();
              } else if (lanes.length > 1) {
                e.preventDefault();
                setFocus(li + (e.key === 'ArrowDown' ? 1 : -1), i);
              } else {
                // Single-lane track: there's no other lane for plain
                // Up/Down to move focus to, so nudge the whole velocity
                // band (vmin+vmax together) instead of silently eating
                // the key (which would otherwise block page scroll for
                // nothing).
                e.preventDefault();
                const width = s.vmax - s.vmin;
                const vmin = clamp(snap(s.vmin + d), 0, 1 - width);
                s.vmin = vmin;
                s.vmax = clamp(snap(vmin + width), 0, 1);
                commit();
              }
            } else if (e.key === 'ArrowRight') {
              e.preventDefault();
              setFocus(li, i + 1);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              setFocus(li, i - 1);
            } else if (e.key === 'Home') {
              e.preventDefault();
              setFocus(li, 0);
            } else if (e.key === 'End') {
              e.preventDefault();
              setFocus(li, stepsPerBarFor(track) - 1);
            } else if (e.key === '[' || e.key === ',') {
              e.preventDefault();
              // Moves the midpoint only — an existing {min,max} shifts with
              // it (width preserved), same policy as the pointer drag.
              s.prob = shiftRangeMid(s.prob, snap(rangeMid(s.prob) - nudge));
              commit();
            } else if (e.key === ']' || e.key === '.') {
              e.preventDefault();
              s.prob = shiftRangeMid(s.prob, snap(rangeMid(s.prob) + nudge));
              commit();
            } else if (e.key === '{' || e.key === '<') {
              // Shift+[ / Shift+, — narrow the drifting prob range around
              // its midpoint (narrowing to ~0 collapses back to a number).
              e.preventDefault();
              s.prob = resizeRangeWidth(s.prob, -nudge * 2);
              commit();
            } else if (e.key === '}' || e.key === '>') {
              // Shift+] / Shift+. — widen it (splitting a plain number into
              // a range on first widen).
              e.preventDefault();
              s.prob = resizeRangeWidth(s.prob, nudge * 2);
              commit();
            }
          });
        }

        // -- v21 lane operations (percussion) -------------------------------
        // Every one of these ends in commitLanes(), which repairs the list,
        // re-keys the step map to it, re-renders and pushes lanes+patterns to
        // the engine in one setParams — so a lane and its steps are never
        // briefly out of step with each other.

        function commitLanes(focusLaneId) {
          const t = trackSettings();
          t.lanes = normalisePercLanes(t.lanes);
          normaliseSequencerList(t, track);
          lanes = laneListFor(track, t);
          focusPos = { lane: Math.min(focusPos.lane, lanes.length - 1), step: focusPos.step };
          render();
          commitSequencer(track);
          if (onLanes) onLanes();
          if (focusLaneId) {
            const index = lanes.findIndex((lane) => lane.key === focusLaneId);
            const name = laneNameButtons[index];
            if (name) name.focus();
          }
        }

        function addLane() {
          const t = trackSettings();
          if (t.lanes.length >= PERC_MAX_LANES) return;
          const at = laneInsertIndex(t.lanes, PERC_NEW_LANE_KIND);
          const id = nextLaneId(t.lanes);
          // "Nearest" is the lane it lands beside — the one above it, or the
          // one below when it lands at the top. Copying that pattern is what
          // makes a new tom/cymbal lane immediately playable rather than an
          // empty row to fill in from scratch.
          const nearest = t.lanes[at - 1] || t.lanes[at] || null;
          t.lanes.splice(at, 0, {
            id,
            label: `Lane ${t.lanes.length + 1}`,
            kind: PERC_NEW_LANE_KIND,
          });
          for (const seq of list()) {
            const source = nearest && isPlainObject(seq.steps) ? seq.steps[nearest.id] : null;
            seq.steps[id] = source ? structuredClone(source) : defaultLane(PERC_NEW_LANE_KIND);
          }
          commitLanes(id);
        }

        function removeLane(index) {
          const t = trackSettings();
          const lane = t.lanes[index];
          if (!lane || PERC_BUILTIN_LANES.includes(lane.id)) return;
          t.lanes.splice(index, 1);
          for (const seq of list()) {
            if (isPlainObject(seq.steps)) delete seq.steps[lane.id];
          }
          // A removed lane takes its kit-editor overrides with it too — ids are
          // reused (lane4 removed, lane4 added), and inheriting the old lane's
          // sound would be a ghost the user never asked for.
          const bank = isPlainObject(settings.patches[track]) ? settings.patches[track] : null;
          for (const voiceId of Object.keys(bank || {})) {
            const patch = bank[voiceId];
            if (!isPlainObject(patch) || !isPlainObject(patch.perKind)) continue;
            if (!(lane.id in patch.perKind)) continue;
            delete patch.perKind[lane.id];
            if (!Object.keys(patch.perKind).length) delete patch.perKind;
            sendPatch(track, voiceId, patch);
          }
          commitLanes();
        }

        function renameLane(index, text) {
          const t = trackSettings();
          const lane = t.lanes[index];
          const name = String(text || '').trim().slice(0, 32);
          if (!lane || !name || name === lane.label) return;
          lane.label = name;
          commitLanes(lane.id);
        }

        function setLaneKind(index, kind) {
          const t = trackSettings();
          const lane = t.lanes[index];
          if (!lane || PERC_BUILTIN_LANES.includes(lane.id)) return;
          if (!PERC_LANE_KINDS.some(([k]) => k === kind)) return;
          lane.kind = kind;
          commitLanes(lane.id);
        }

        function moveLane(from, to) {
          const t = trackSettings();
          const target = clamp(to, 0, t.lanes.length - 1);
          if (from === target || !t.lanes[from]) return;
          const [lane] = t.lanes.splice(from, 1);
          t.lanes.splice(target, 0, lane);
          commitLanes(lane.id);
        }

        addLaneButton.addEventListener('click', addLane);

        let laneNameButtons = [];

        /**
         * One lane's header: a grip, the click-to-type name, the kind picker
         * (which of the kit's sounds it plays), the two move buttons and —
         * for a user lane — remove. Rendered as a row of its own so the grid
         * keeps to rows-of-cells; the built-in lanes get everything except
         * remove, which is what "built-ins protected" means here.
         */
        function buildLaneHead(lane, index) {
          const headRow = document.createElement('div');
          headRow.className = 'seq-lane seq-lane-head-row';
          headRow.setAttribute('role', 'row');
          const head = document.createElement('div');
          head.className = 'seq-lane-head';
          head.setAttribute('role', 'rowheader');
          headRow.append(head);
          if (!laneAxis) {
            const text = document.createElement('span');
            text.className = 'seq-lane-label';
            text.textContent = lane.label;
            head.append(text);
            return headRow;
          }

          const grip = document.createElement('button');
          grip.type = 'button';
          grip.className = 'seq-lane-grip';
          grip.textContent = '⠿';
          grip.setAttribute('aria-label', `Drag to move the ${lane.label} lane`);
          head.append(grip);

          const name = document.createElement('button');
          name.type = 'button';
          name.className = 'seq-lane-label seq-lane-name typable';
          name.textContent = lane.label;
          name.setAttribute('aria-label', `${lane.label} lane — click to rename`);
          name.addEventListener('click', () => {
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'typable-input seq-lane-input';
            input.value = lane.label;
            input.setAttribute('aria-label', `${lane.label} lane name`);
            head.replaceChild(input, name);
            input.focus();
            input.select();
            let done = false;
            const finish = (save) => {
              if (done) return;
              done = true;
              const value = input.value;
              if (input.parentNode === head) head.replaceChild(name, input);
              if (save) renameLane(index, value);
              else name.focus();
            };
            input.addEventListener('keydown', (event) => {
              if (event.key === 'Enter') {
                event.preventDefault();
                finish(true);
              } else if (event.key === 'Escape') {
                event.preventDefault();
                finish(false);
              }
            });
            input.addEventListener('blur', () => finish(true));
          });
          // Alt+↑/↓ from the name is the keyboard reorder — plain arrows stay
          // free for moving around the grid itself.
          name.addEventListener('keydown', (event) => {
            if (!event.altKey || (event.key !== 'ArrowUp' && event.key !== 'ArrowDown')) return;
            event.preventDefault();
            moveLane(index, index + (event.key === 'ArrowDown' ? 1 : -1));
          });
          head.append(name);

          const kindNote = () => document.createElement('span');
          const builtin = PERC_BUILTIN_LANES.includes(lane.key);
          // v0.0.65: a built-in lane gets NO sound picker. It used to get a
          // DISABLED one whose only option was the lane's own name, so the
          // editor showed three greyed dropdowns each repeating the row label
          // beside them — the owner's "unusable dropdowns between drum
          // instruments". A control that cannot be used and says nothing new
          // is worse than no control. A user-added lane still gets one,
          // because there it is a real choice.
          if (builtin) {
            head.append(kindNote(lane));
          } else {
          const kind = document.createElement('select');
          kind.className = 'seq-lane-kind';
          kind.setAttribute('aria-label', `${lane.label} lane sound`);
          for (const [value, kindLabel] of PERC_LANE_KINDS) {
            const option = document.createElement('option');
            option.value = value;
            option.textContent = kindLabel;
            kind.append(option);
          }
          kind.value = lane.kind;
          // A built-in lane IS its kind — the engine fixes that pairing, so
          // the picker shows the mapping without offering to break it.
          kind.disabled = builtin;
          kind.addEventListener('change', () => setLaneKind(index, kind.value));
          describe(
            kind,
            builtin
              ? 'A built-in lane always plays its own sound; rename it or move it instead.'
              : 'Which of the kit’s sounds this lane plays.'
          );
          head.append(kind);
          }

          // v0.0.66 (owner, item 77): "don't let minor things like title
          // editing and ordering take up a tonne of UI space, when people will
          // mainly be editing normally."
          //
          // Reordering and removing are rare; playing with the pattern is the
          // whole point of the panel. So the ▲ ▼ × controls no longer sit in
          // every lane header permanently — they appear on hover or focus, and
          // are always present to a screen reader and to the keyboard, which
          // is what stops "tidier" meaning "unreachable". The grip still drags
          // at any time and Alt+↑/↓ from the name still reorders, so nothing
          // that worked before stopped working.
          const tools = document.createElement('span');
          tools.className = 'seq-lane-tools';
          const move = (delta, glyph, what) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'round-button seq-lane-move';
            button.textContent = glyph;
            button.setAttribute('aria-label', `Move the ${lane.label} lane ${what}`);
            button.disabled = delta < 0 ? index === 0 : index === lanes.length - 1;
            button.addEventListener('click', () => moveLane(index, index + delta));
            tools.append(button);
          };
          move(-1, '▲', 'up');
          move(1, '▼', 'down');
          head.append(tools);

          if (!builtin) {
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'round-button seq-lane-remove';
            remove.textContent = '×';
            remove.setAttribute('aria-label', `Remove the ${lane.label} lane`);
            remove.addEventListener('click', () => removeLane(index));
            describe(remove, 'Remove this lane and its pattern.');
            tools.append(remove);
          }

          // Pointer reorder: the grip drags, and the lane lands on whichever
          // header its release is nearest. Nothing re-renders mid-drag, so the
          // element under the captured pointer stays put until the drop.
          grip.addEventListener('pointerdown', (event) => {
            if (event.pointerType === 'mouse' && event.button !== 0) return;
            event.preventDefault();
            const heads = Array.from(gridEl.querySelectorAll('.seq-lane-head'));
            const centres = heads.map((el) => {
              const rect = el.getBoundingClientRect();
              return rect.top + rect.height / 2;
            });
            const nearestTo = (clientY) => {
              let best = index;
              let bestDistance = Infinity;
              centres.forEach((centre, k) => {
                const distance = Math.abs(clientY - centre);
                if (distance < bestDistance) {
                  bestDistance = distance;
                  best = k;
                }
              });
              return best;
            };
            head.classList.add('seq-lane-dragging');
            const onMove = (ev) => {
              const target = nearestTo(ev.clientY);
              heads.forEach((el, k) => el.classList.toggle('seq-lane-drop', k === target && k !== index));
            };
            const onUp = (ev) => {
              grip.removeEventListener('pointermove', onMove);
              grip.removeEventListener('pointerup', onUp);
              grip.removeEventListener('pointercancel', onCancel);
              heads.forEach((el) => el.classList.remove('seq-lane-drop'));
              head.classList.remove('seq-lane-dragging');
              moveLane(index, nearestTo(ev.clientY));
            };
            const onCancel = () => {
              grip.removeEventListener('pointermove', onMove);
              grip.removeEventListener('pointerup', onUp);
              grip.removeEventListener('pointercancel', onCancel);
              heads.forEach((el) => el.classList.remove('seq-lane-drop'));
              head.classList.remove('seq-lane-dragging');
            };
            try {
              grip.setPointerCapture(event.pointerId);
            } catch {}
            grip.addEventListener('pointermove', onMove);
            grip.addEventListener('pointerup', onUp);
            grip.addEventListener('pointercancel', onCancel);
          });

          laneNameButtons[index] = name;
          return headRow;
        }

        function renderTabs() {
          const seqs = list();
          tabs.innerHTML = '';
          // A single sequencer needs no chooser and no transition weight —
          // the strip only earns its space once there's something to pick
          // between. "+" stays, so a second one is always one click away.
          tabsRow.classList.toggle('seq-tabs-single', seqs.length < 2);
          seqs.forEach((unused, index) => {
            const input = document.createElement('input');
            input.type = 'radio';
            input.name = `seq-pick-${track}`;
            input.id = `seq-pick-${track}-${index}`;
            input.value = String(index);
            input.checked = index === active;
            const lab = document.createElement('label');
            lab.htmlFor = input.id;
            lab.textContent = String(index + 1);
            input.addEventListener('change', () => {
              if (!input.checked) return;
              active = index;
              render();
            });
            tabs.append(input, lab);
          });
          addButton.disabled = seqs.length >= SEQ_MAX;
          const chained = settings.tracks[track].sequencerAdvance === 'chain';
          orderWrap.hidden = seqs.length < 2 || !engineCaps.chainMode;
          for (const radio of orderRadios) {
            radio.checked = radio.value === (chained ? 'chain' : 'weights');
          }
          // A chained list ignores its weights: hiding the box is the honest
          // rendering of that, not a convenience.
          weightWrap.hidden = chained || seqs.length < 2;
          weightInput.value = String(seqs[0].weights[active] ?? 1);
          weightInput.setAttribute('aria-label', `Sequencer ${active + 1} weight`);
        }

        addButton.addEventListener('click', () => {
          const seqs = list();
          if (seqs.length >= SEQ_MAX) return;
          seqs.push(structuredClone(current()));
          normaliseSequencerList(settings.tracks[track], track);
          active = list().length - 1;
          render();
          commitSequencer(track);
        });

        weightInput.addEventListener('input', () => {
          const parsed = parseFloat(weightInput.value);
          if (!Number.isFinite(parsed)) return; // mid-edit blank keeps the stored value
          const w = clamp(parsed, 0, 100);
          // One number per sequencer: "how likely everyone is to hand over to
          // this one", written into every sequencer's transition row.
          for (const seq of list()) seq.weights[active] = w;
          commitSequencer(track);
        });

        function render() {
          // A structural redraw — tab switch, metre change, lane add/remove —
          // invalidates the paint selection: activeGroup is keyed by lane
          // INDEX against the lane list being rebuilt, and group ids restart
          // from 0 on every sequencer, so a selection carried across a redraw
          // painted steps into an unrelated group on whatever lane now holds
          // that index. Escape drops it mid-grid; this drops it on rebuild.
          activeGroup = null;
          const n = stepsPerBarFor(track);
          const pulseStarts = pulseStartsFor(track, n);
          const pulseSet = new Set(pulseStarts);
          root.style.setProperty('--seq-cols', String(n));
          beatsEl.innerHTML = '';
          gridEl.innerHTML = '';
          cellRefs = lanes.map(() => []);
          laneNameButtons = [];
          addLaneButton.disabled = lanes.length >= PERC_MAX_LANES;
          for (const radio of modeRadios) radio.checked = radio.value === current().mode;
          renderTabs();
          syncResolutionUI();
          for (let i = 0; i < n; i++) {
            const b = document.createElement('span');
            const pulseIndex = pulseStarts.indexOf(i);
            if (pulseIndex !== -1) {
              b.textContent = String(pulseIndex + 1);
              b.className = 'seq-beat-mark';
            }
            beatsEl.append(b);
          }
          lanes.forEach((lane, li) => {
            // v0.0.93 (his 89/105): probability-group dots sit BELOW the
            // lane's cells, beside the probability bars — notes and pitch at
            // the top, chance and grouping together at the bottom, which is
            // his reading order. Still their own grid row — row > gridcell >
            // button, the standard "gridcell owning a widget" shape.
            const dotRow = document.createElement('div');
            dotRow.className = 'seq-lane seq-dot-row';
            dotRow.setAttribute('role', 'row');
            const row = document.createElement('div');
            row.className = 'seq-lane';
            row.setAttribute('role', 'row');
            const headRow = lane.key ? buildLaneHead(lane, li) : null;
            // Per-lane tint, derived from the track's own colour so a kit of
            // eight lanes still reads as one instrument: the top lane wears
            // the accent at full strength and each one below it is mixed
            // further back towards the panel.
            if (lane.key) {
              const mix = lanes.length > 1 ? 100 - Math.round((li / (lanes.length - 1)) * 55) : 100;
              const tint = `color-mix(in srgb, var(--track-accent, var(--link)) ${mix}%, var(--panel))`;
              for (const el of [headRow, dotRow, row]) {
                el.classList.add('seq-lane-tinted');
                el.style.setProperty('--lane-tint', tint);
              }
            }
            // The probability mini-bars sit on the grid line directly under
            // their cells (same columns, so each bar is tied to its step),
            // but a role="row" must only own gridcell children — so they
            // get their own row (role="row", cells aria-hidden) rather than
            // living inside the cell row above.
            const probRow = document.createElement('div');
            probRow.className = 'seq-lane seq-prob-row';
            probRow.setAttribute('role', 'row');
            for (let i = 0; i < n; i++) {
              const dotCell = document.createElement('div');
              dotCell.className = 'seq-dot-cell';
              dotCell.setAttribute('role', 'gridcell');
              const dot = document.createElement('button');
              dot.type = 'button';
              dot.className = 'seq-dot';
              dotCell.append(dot);
              dotRow.append(dotCell);
              const cell = document.createElement('div');
              cell.className = 'seq-cell';
              cell.setAttribute('role', 'gridcell');
              if (pulseSet.has(i)) cell.classList.add('seq-cell-beat');
              cell.tabIndex = -1;
              const band = document.createElement('span');
              band.className = 'seq-band';
              const bandTop = document.createElement('span');
              bandTop.className = 'seq-band-top';
              // v0.0.75: where the app's chosen notes sit in pitch. Empty and
              // invisible until a note actually lands here, so a percussion
              // grid (whose midi numbers are kit slots, not pitches) and a
              // silent track both look exactly as they did.
              const pitch = document.createElement('span');
              pitch.className = 'seq-pitch';
              pitch.setAttribute('aria-hidden', 'true');
              cell.append(band, bandTop, pitch);
              const prob = document.createElement('span');
              prob.className = 'seq-prob';
              prob.setAttribute('aria-hidden', 'true');
              const probFill = document.createElement('span');
              probFill.className = 'seq-prob-fill';
              prob.append(probFill);
              probRow.append(prob);
              cellRefs[li][i] = { cell, band, bandTop, probFill, dot, pitch };
              wireCell(li, i, cell, prob, bandTop, dot);
              row.append(cell);
            }
            if (headRow) gridEl.append(headRow);
            gridEl.append(row, probRow, dotRow);
            applyTieSpans(li);
          });
          for (let li = 0; li < lanes.length; li++) {
            for (let i = 0; i < n; i++) updateCell(li, i);
          }
          // A rebuild throws the cells away; the app's own notes survive it,
          // so repaint them onto the new ones rather than waiting for the next
          // bar to arrive.
          paintChosen();
          paintPitch();
          focusPos = {
            lane: Math.min(focusPos.lane, lanes.length - 1),
            step: Math.min(focusPos.step, n - 1),
          };
          cellRefs[focusPos.lane][focusPos.step].cell.tabIndex = 0;
          setPlayhead(playhead);
        }

        /**
         * v14 playhead: the sounding step lights white. Driven from bar/note
         * events at step rate (see schedulePlayhead) — a class swap on two
         * DOM nodes, never a rAF loop.
         */
        /**
         * v0.0.67 — the grid shows what the app actually chose.
         *
         * The first thing on the agreed plan, and the thing everything else
         * depends on: "Right now the app decides the chords, the rhythm and
         * which notes get played, and shows you none of it." In Auto the grid
         * rendered only steps a user had typed, so the panel was blank while
         * the engine played a full pattern through it — undimmed, unannotated,
         * with a playhead sweeping across nothing.
         *
         * The engine already emits every scheduled note (track, lane, time,
         * velocity). This turns that stream into the grid's own coordinates
         * and paints it as a layer BENEATH the user's steps: a chosen step is
         * outlined, a step the user typed is filled. The two are deliberately
         * different marks, because the difference between "the app decided
         * this" and "I decided this" is the whole point of showing it.
         *
         * It is a READOUT and holds no state the engine reads back. Editing a
         * step still writes the sequencer exactly as before.
         */
        const chosen = new Map(); // laneKey -> Set of step indices
        let chosenBar = -1;

        /**
         * v0.0.75 — the other half of step 1: the app's chosen PITCHES.
         *
         * v0.0.67 made the rhythm visible and the owner's next line was the
         * obvious one: "a bass line's rhythm is now visible and its notes are
         * not." The engine's note event has always carried `midi`; nothing was
         * reading it here, so the grid could show you WHEN the app plays and
         * never WHICH NOTE.
         *
         * Drawn as a tick inside the step, positioned by pitch, so a line's
         * SHAPE is readable across a bar without reading a single name — which
         * is what a grid is for. The names are on the cell itself (title and
         * aria-label) and the range being drawn is stated under the grid,
         * because a contour with no scale beside it is a picture, not a
         * readout.
         *
         * Percussion is excluded on purpose: a kit lane's midi number is a
         * slot in a kit, not a pitch, and drawing it as one would be inventing
         * a melody out of an implementation detail.
         */
        const chosenPitch = new Map(); // laneKey -> Map(step -> Set of midi)
        const tunedGrid = !isPercussiveTrack(track);
        // The window the ticks are drawn in. It only ever widens while an
        // editor is open: a range that re-fitted itself every bar would move
        // every tick whenever one new note arrived, and a contour you cannot
        // compare with the bar before it is not a contour.
        let pitchLo = Infinity;
        let pitchHi = -Infinity;
        const PITCH_MIN_SPAN = 12; // one octave, so a one-note track is not full-scale

        function pitchWindow() {
          if (!(pitchLo <= pitchHi)) return null;
          const mid = (pitchLo + pitchHi) / 2;
          const half = Math.max(PITCH_MIN_SPAN, pitchHi - pitchLo) / 2;
          return { lo: mid - half, hi: mid + half };
        }

        /** The app's notes on one step, named, or null if it chose none. */
        function chosenNotesAt(lane, i) {
          if (!tunedGrid) return null;
          const perStep = chosenPitch.get(lane?.key ?? '') || chosenPitch.get(null) || null;
          const notes = perStep ? perStep.get(i) : null;
          if (!notes || !notes.size) return null;
          return [...notes].sort((a, b) => a - b).map(pitchName).join(', ');
        }

        function paintPitch() {
          const win = tunedGrid ? pitchWindow() : null;
          for (let li = 0; li < cellRefs.length; li++) {
            const key = lanes[li] ? lanes[li].key : null;
            const perStep = chosenPitch.get(key ?? '') || chosenPitch.get(null) || null;
            for (let i = 0; i < cellRefs[li].length; i++) {
              const ref = cellRefs[li][i];
              if (!ref || !ref.pitch) continue;
              const notes = win && perStep ? perStep.get(i) : null;
              if (!notes || !notes.size) {
                if (ref.pitch.childElementCount) ref.pitch.replaceChildren();
                ref.cell.removeAttribute('title');
                continue;
              }
              const sorted = [...notes].sort((a, b) => a - b);
              ref.pitch.replaceChildren(...sorted.map((midi) => {
                const mark = document.createElement('i');
                mark.className = 'seq-pitch-mark';
                const at = (midi - win.lo) / (win.hi - win.lo);
                mark.style.bottom = `${clamp(at, 0, 1) * 100}%`;
                return mark;
              }));
              ref.cell.title = sorted.map(pitchName).join(' ');
              // Re-label rather than wait for the next updateCell: the notes
              // arrive from the engine, not from an edit, so nothing else
              // would touch this cell.
              const lane = lanes[li];
              if (lane) ref.cell.setAttribute('aria-label', stepText(lane, i, laneSteps(lane)[i]));
            }
          }
          if (pitchLegend) {
            pitchLegend.hidden = !win;
            if (win) {
              pitchLegend.textContent =
                `The app’s notes are drawn between ${pitchName(win.lo)} and ${pitchName(win.hi)}.`;
            }
          }
        }

        function laneIndexFor(laneKey) {
          if (!laneKey) return 0;
          const i = lanes.findIndex((lane) => lane.key === laneKey);
          return i === -1 ? 0 : i;
        }

        function paintChosen() {
          for (let li = 0; li < cellRefs.length; li++) {
            const key = lanes[li] ? lanes[li].key : null;
            const set = chosen.get(key ?? '') || chosen.get(null) || null;
            for (let i = 0; i < cellRefs[li].length; i++) {
              const ref = cellRefs[li][i];
              if (!ref) continue;
              ref.cell.classList.toggle('seq-cell-chosen', !!set && set.has(i));
            }
          }
        }

        /** One scheduled note, in this grid's coordinates. */
        function noteChosen(step, laneKey, bar, midi) {
          if (bar !== chosenBar) {
            chosen.clear();
            chosenPitch.clear();
            chosenBar = bar;
          }
          const key = laneKey ?? '';
          if (!chosen.has(key)) chosen.set(key, new Set());
          chosen.get(key).add(step);
          if (tunedGrid && Number.isFinite(midi)) {
            if (!chosenPitch.has(key)) chosenPitch.set(key, new Map());
            const perStep = chosenPitch.get(key);
            if (!perStep.has(step)) perStep.set(step, new Set());
            perStep.get(step).add(midi);
            if (midi < pitchLo) pitchLo = midi;
            if (midi > pitchHi) pitchHi = midi;
          }
          paintChosen();
          paintPitch();
        }

        function clearChosen() {
          if (!chosen.size && !chosenPitch.size) return;
          chosen.clear();
          chosenPitch.clear();
          chosenBar = -1;
          // The window is NOT reset with the notes: it is what makes two bars
          // comparable, and re-fitting it on every stop would redraw the same
          // line at a different height the moment play resumed.
          paintChosen();
          paintPitch();
        }

        function setPlayhead(index) {
          const n = stepsPerBarFor(track);
          for (let li = 0; li < cellRefs.length; li++) {
            const prev = cellRefs[li][playhead];
            if (prev) prev.cell.classList.remove('seq-cell-playing');
          }
          playhead = index >= 0 && index < n ? index : -1;
          if (playhead < 0) return;
          for (let li = 0; li < cellRefs.length; li++) {
            const ref = cellRefs[li][playhead];
            if (ref) ref.cell.classList.add('seq-cell-playing');
          }
        }

        // -- v16 block editor ----------------------------------------------
        // A second EDITOR for the same data, not a second copy of it: the
        // block surface compiles to this track's sequencer params and commits
        // through commitSequencer, exactly as the grid does. It stands in
        // place of the grid while open so the two can never show different
        // patterns, and setValue() re-reads the live params every time it
        // opens (the grid may have moved them meanwhile).
        //
        // It is handed the ACTIVE sequencer object, so blocks.js round-trips
        // in its 'sequencer' form and hands back the same shape — the multi-
        // sequencer list, and which of them is being edited, stay this page's
        // business.
        // Lane order: this page lists lanes TOP-DOWN (High first, the v14
        // rule). A v21 blocks.js takes that order verbatim as `[{id, label}]`;
        // an older one takes bare ids and renders them bottom-up, so it is
        // handed the REVERSE — which puts High at the top of both editors
        // either way. Read at OPEN time, not at build time: v21 lanes are
        // user-editable, so the list a block editor is given has to be the one
        // the grid is showing now.
        const laneIdsNow = () => lanes.map((lane) => lane.key).filter(Boolean);
        const laneSpecNow = () =>
          blocksLaneSpec
            ? lanes.filter((lane) => lane.key).map((lane) => ({ id: lane.key, label: lane.label }))
            : laneIdsNow().reverse();
        let blockEditor = null;
        let blockLaneKey = '';

        function blockParams() {
          return structuredClone(current());
        }

        /**
         * Take a compiled pattern back from the block editor. Accepts either a
         * sequencer object or a { sequencer } wrapper, and only touches the
         * keys it recognises; normaliseSequencerList then repairs anything
         * malformed (lane padding, clamping) before the engine sees it, so a
         * half-built compile can't corrupt the track.
         */
        function applyBlockParams(next) {
          const incoming = isPlainObject(next) && isPlainObject(next.sequencer) ? next.sequencer : next;
          if (!isPlainObject(incoming)) return;
          const seq = current();
          if (incoming.steps !== undefined) seq.steps = incoming.steps;
          if (typeof incoming.mode === 'string') seq.mode = incoming.mode;
          normaliseSequencerList(settings.tracks[track], track);
          render();
          commitSequencer(track);
        }

        function closeBlocks() {
          blocksHost.hidden = true;
          scroll.hidden = false;
          blockButton.setAttribute('aria-expanded', 'false');
        }

        async function openBlocks() {
          const api = await loadBlocksModule();
          if (!api) {
            // The module resolved but has no createBlockEditor (a build older
            // than the page): retire the affordance rather than leave a button
            // that does nothing.
            blockButton.hidden = true;
            return;
          }
          const laneSpec = laneSpecNow();
          // A lane added/removed/reordered/renamed since the editor was built
          // means a different canvas, which blocks.js takes at CONSTRUCTION —
          // so the editor is rebuilt rather than fed a list it cannot adopt.
          const laneKey = lanes.map((lane) => `${lane.key}:${lane.label}`).join('|');
          if (blockEditor && laneKey !== blockLaneKey) {
            try {
              blockEditor.destroy?.();
            } catch {}
            blockEditor = null;
            blocksHost.innerHTML = '';
          }
          if (!blockEditor) {
            try {
              blockEditor = api.createBlockEditor(blocksHost, {
                track,
                timeSignature: settings.timeSignature,
                // Percussion names its lanes; a single-lane track passes none
                // and lets blocks.js infer its own lane id from the steps.
                ...(laneSpec.length ? { lanes: laneSpec } : {}),
                value: blockParams(),
                onChange: applyBlockParams,
              });
              blockLaneKey = laneKey;
            } catch {
              blocksHost.innerHTML = '';
              blockButton.hidden = true;
              return;
            }
          }
          try {
            blockEditor.setValue?.(blockParams());
          } catch {}
          blocksHost.hidden = false;
          scroll.hidden = true;
          blockButton.setAttribute('aria-expanded', 'true');
        }

        blockButton.addEventListener('click', () => {
          if (blocksHost.hidden) openBlocks();
          else closeBlocks();
        });
        describe(blockButton, `Build ${label}'s pattern out of blocks instead of the grid.`);

        function destroy() {
          try {
            blockEditor?.destroy?.();
          } catch {}
          blockEditor = null;
        }

        render();
        return { refresh: render, setPlayhead, noteChosen, clearChosen, destroy };
      }

      // ---- v6: arpeggiator section (lives in the Arp track's Edit panel) --

      let arpUI = null; // control refs while the arp editor is open

      const ARP_PATTERNS = [
        ['up', 'Up'],
        ['down', 'Down'],
        ['updown', 'Up-down'],
        ['random', 'Random'],
      ];
      const ARP_RATES = [
        ['1/4', '1/4'],
        ['1/8', '1/8'],
        ['1/16', '1/16'],
        ['1/8T', '1/8 triplet'],
      ];

      function buildArpSection(container) {
        const panel = document.createElement('div');
        panel.className = 'arp-inline';
        const title = document.createElement('span');
        title.className = 'panel-label';
        title.textContent = 'Arpeggiator';
        panel.append(title);

        const modeGroup = document.createElement('div');
        modeGroup.className = 'segmented';
        modeGroup.setAttribute('role', 'radiogroup');
        modeGroup.setAttribute('aria-label', 'Arpeggiator mode');
        const modeRadios = [];
        for (const m of ['auto', 'manual']) {
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = 'arp-mode';
          input.id = `arp-mode-${m}`;
          input.value = m;
          const lab = document.createElement('label');
          lab.htmlFor = input.id;
          lab.textContent = m === 'auto' ? 'Auto' : 'Manual';
          input.addEventListener('change', () => {
            if (!input.checked) return;
            settings.arp.mode = m;
            manual.hidden = m !== 'manual';
            engine.setParams({ arp: { mode: m } });
            updateComplexityDisplay();
            persistSettings();
          });
          modeGroup.append(input, lab);
          modeRadios.push(input);
        }
        panel.append(modeGroup);

        const manual = document.createElement('div');
        manual.className = 'arp-manual';
        panel.append(manual);

        function arpSelect(labelText, options, value, onChange) {
          const wrap = document.createElement('div');
          wrap.className = 'control';
          const id = `arp-${labelText.toLowerCase()}`;
          const lab = document.createElement('label');
          lab.htmlFor = id;
          lab.textContent = labelText;
          const select = document.createElement('select');
          select.id = id;
          for (const [v, text] of options) {
            const opt = document.createElement('option');
            opt.value = v;
            opt.textContent = text;
            select.append(opt);
          }
          select.value = value;
          select.addEventListener('change', () => onChange(select.value));
          wrap.append(lab, select);
          manual.append(wrap);
          return select;
        }

        function arpRange(labelText, { min, max, step, value, onChange }) {
          const wrap = document.createElement('div');
          wrap.className = 'control';
          const id = `arp-${labelText.toLowerCase()}`;
          const row = document.createElement('div');
          row.className = 'control-label-row';
          const lab = document.createElement('label');
          lab.htmlFor = id;
          lab.textContent = labelText;
          const readout = document.createElement('span');
          readout.className = 'value-readout';
          readout.textContent = String(value);
          row.append(lab, readout);
          const input = document.createElement('input');
          input.type = 'range';
          input.min = String(min);
          input.max = String(max);
          input.step = String(step);
          input.value = String(value);
          input.id = id;
          input.addEventListener('input', () => {
            readout.textContent = input.value;
            onChange(input.value);
          });
          wrap.append(row, input);
          manual.append(wrap);
          return { input, readout };
        }

        const pattern = arpSelect('Pattern', ARP_PATTERNS, settings.arp.pattern, (v) => {
          settings.arp.pattern = v;
          engine.setParams({ arp: { pattern: v } });
          persistSettings();
        });
        const rate = arpSelect('Rate', ARP_RATES, settings.arp.rate, (v) => {
          settings.arp.rate = v;
          engine.setParams({ arp: { rate: v } });
          updateComplexityDisplay();
          persistSettings();
          // The arp lane's length/pulse-marks are rate-derived (v8 ruling):
          // re-render its sequencer grid, same as a time-signature change.
          try {
            openEditors.get('arp')?.seq?.refresh();
          } catch {}
        });
        const octaves = arpRange('Octaves', {
          min: 1,
          max: 3,
          step: 1,
          value: settings.arp.octaves,
          onChange: (v) => {
            settings.arp.octaves = parseInt(v, 10);
            engine.setParams({ arp: { octaves: settings.arp.octaves } });
            persistSettings();
          },
        });
        const gate = arpRange('Gate', {
          min: 0.1,
          max: 1,
          step: 0.01,
          value: settings.arp.gate,
          onChange: (v) => {
            settings.arp.gate = parseFloat(v);
            engine.setParams({ arp: { gate: settings.arp.gate } });
            persistSettings();
          },
        });

        container.append(panel);
        arpUI = {
          modeRadios,
          manual,
          pattern,
          rate,
          octaves: octaves.input,
          octavesOut: octaves.readout,
          gate: gate.input,
          gateOut: gate.readout,
        };
        syncArpUI();
      }

      // Per-open-editor scope + knob handles, so re-renders, close and
      // engine state changes can tear down rAF loops and swap OFFLINE/LIVE.
      const openEditors = new Map(); // track -> { scope|null, knobs: [] }

      function teardownEditor(track) {
        const ed = openEditors.get(track);
        if (!ed) return;
        unregisterExtras(track, ed.extras);
        stateControls.delete(track);
        if (track === 'arp') arpUI = null;
        if (ed.scope) {
          if (ed.scope.debounce !== null) clearTimeout(ed.scope.debounce);
          if (ed.scope.live) {
            try {
              ed.scope.live.destroy();
            } catch {}
          }
          ed.scope.analyser = null;
        }
        for (const k of ed.knobs) {
          try {
            k.destroy?.();
          } catch {}
        }
        ed.seq?.destroy?.();
        openEditors.delete(track);
      }

      function scheduleScopeRender(track, immediate = false) {
        const ed = openEditors.get(track);
        if (!ed || !ed.scope || ed.scope.live) return;
        const s = ed.scope;
        if (s.debounce !== null) clearTimeout(s.debounce);
        s.debounce = setTimeout(
          () => {
            s.debounce = null;
            try {
              scopeApi.renderPatchWave(s.canvas, s.getPatch(), {
                freq: SCOPE_FREQ[voiceSetOf(track)] || 220,
              });
            } catch {}
          },
          immediate ? 0 : 80
        );
      }

      function updateScopeMode(track) {
        const ed = openEditors.get(track);
        if (!ed || !ed.scope) return;
        const s = ed.scope;
        let analyser = null;
        // A power tier that withholds the live scope (eco) falls back to the
        // cheap static trace — no rAF loop attaches at all. Same for a track
        // switched off: its analyser node keeps existing (silent) as long as
        // the engine graph runs, so "off" has to be checked explicitly here
        // rather than inferred from analyser presence — see docs/engine-v2-
        // contract.md v19 roadmap "Offline waveform rule".
        const scopeAllowed = powerBudget ? powerBudget.scopeEnabled !== false : true;
        const trackOff = settings.tracks[track] && settings.tracks[track].state === 'off';
        if (scopeAllowed && !trackOff && engine.running && typeof engine.getAnalysers === 'function') {
          try {
            analyser = (engine.getAnalysers() || {})[track] || null;
          } catch {
            analyser = null;
          }
        }
        if (analyser && typeof scopeApi.attachLiveScope === 'function') {
          // rebuildContext() (interruption/sample-rate recovery, iOS wake)
          // swaps the engine's whole graph — including analyser nodes —
          // while `running` stays true, so a same-track re-evaluation must
          // compare node IDENTITY rather than just "are we already live":
          // an early `if (s.live) return` here would keep tracing a dead
          // analyser off a closed context forever.
          if (s.live && s.analyser === analyser) return;
          if (s.live) {
            try {
              s.live.destroy();
            } catch {}
            s.live = null;
            s.analyser = null;
          }
          if (s.debounce !== null) {
            clearTimeout(s.debounce);
            s.debounce = null;
          }
          try {
            s.live = scopeApi.attachLiveScope(s.canvas, analyser);
            s.analyser = s.live ? analyser : null;
          } catch {
            s.live = null;
            s.analyser = null;
          }
          if (s.live) {
            s.indicator.textContent = 'LIVE';
            s.indicator.classList.add('scope-mode-live');
            return;
          }
        }
        if (s.live) {
          try {
            s.live.destroy();
          } catch {}
          s.live = null;
          s.analyser = null;
        }
        s.indicator.textContent = 'OFFLINE';
        s.indicator.classList.remove('scope-mode-live');
        scheduleScopeRender(track, true);
      }

      function updateAllScopeModes() {
        for (const track of openEditors.keys()) updateScopeMode(track);
        updateFrontScope();
      }

      let veControlId = 0;

      function veSection(parent, heading) {
        const section = document.createElement('div');
        section.className = 've-section';
        const h = document.createElement('span');
        h.className = 've-heading';
        h.textContent = heading;
        section.append(h);
        parent.append(section);
        return section;
      }

      function veRange(parent, labelText, { min, max, step, value, log = false, format, onChange }) {
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `ve-control-${++veControlId}`;
        const row = document.createElement('div');
        row.className = 'control-label-row';
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = labelText;
        const readout = document.createElement('span');
        readout.className = 'value-readout';
        row.append(label, readout);
        const input = document.createElement('input');
        input.type = 'range';
        input.id = id;
        if (log) {
          input.min = '0';
          input.max = '1';
          input.step = '0.001';
          input.value = String(valueToLog(clamp(value, min, max), min, max));
        } else {
          input.min = String(min);
          input.max = String(max);
          input.step = String(step);
          input.value = String(clamp(value, min, max));
        }
        const fmt = format || ((v) => String(Math.round(v * 100) / 100));
        const current = () =>
          log ? logToValue(parseFloat(input.value), min, max) : parseFloat(input.value);
        readout.textContent = fmt(clamp(value, min, max));
        input.addEventListener('input', () => {
          const v = clamp(current(), min, max);
          readout.textContent = fmt(v);
          onChange(v);
        });
        wrap.append(row, input);
        parent.append(wrap);
        return input;
      }

      function veSelect(parent, labelText, { options, value, onChange }) {
        const wrap = document.createElement('div');
        wrap.className = 'control ve-control';
        const id = `ve-control-${++veControlId}`;
        const label = document.createElement('label');
        label.htmlFor = id;
        label.textContent = labelText;
        const select = document.createElement('select');
        select.id = id;
        for (const [v, text] of options) {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = text;
          if (v === String(value)) opt.selected = true;
          select.append(opt);
        }
        select.addEventListener('change', () => onChange(select.value));
        wrap.append(label, select);
        parent.append(wrap);
        return select;
      }

      const OSC_TYPES = [
        ['sine', 'Sine'],
        ['triangle', 'Triangle'],
        ['sawtooth', 'Sawtooth'],
        ['square', 'Square'],
      ];
      const FILTER_TYPES = [
        ['lowpass', 'Low-pass'],
        ['highpass', 'High-pass'],
        ['bandpass', 'Band-pass'],
        ['notch', 'Notch'],
      ];

      const hzFormat = (v) => `${Math.round(v)} Hz`;
      const secFormat = (v) => (v < 0.1 ? `${Math.round(v * 1000)} ms` : `${Math.round(v * 100) / 100} s`);
      const plainFormat = (v) => String(Math.round(v * 100) / 100);

      const FILTER_ORDER = ['lowpass', 'highpass', 'bandpass', 'notch'];
      const FILTER_DIAL_LABELS = ['LP', 'HP', 'BP', 'Notch'];
      // knob.js marks are numeric tick positions; the shape/type names show
      // in the knob's value readout via `format`.
      const SHAPE_MARKS = [0, 1, 2, 3];
      const shapeFormat = (v) => {
        const r = Math.round(clamp(v, 0, 3));
        if (Math.abs(v - r) < 0.05) return SHAPE_LABELS[r];
        return `${SHAPE_LABELS[Math.floor(v)]}~${SHAPE_LABELS[Math.ceil(v)]}`;
      };

      // ---- v19 sculpting surface (noise voices) + call synthesis ----------
      // Sixteen source fields the engine and the voice library landed together;
      // both editors below build their dials straight off this table, so a
      // label, a unit or a range is stated exactly once. `fallback` is only
      // reached when neither the stored patch nor the voice's own defaults
      // carry the field (an older save opened on a newer voice).
      //
      // Only the Hz centres are log-mapped: sweep/gust rates run 0–0.5 Hz and
      // 0.02–0.5 Hz, where a linear dial already gives the slow end most of
      // its travel, and sweepRate reaches 0 (which no log map can express).
      // None takes rangeDefault — v7 puts filter cutoff and the sends on that
      // list, not these; they open as single values and split on a click.
      const rateHzFormat = (v) => (v < 0.005 ? 'Off' : `${(Math.round(v * 100) / 100).toFixed(2)} Hz`);
      const octaveSpanFormat = (v) => `${plainFormat(v)} oct`;
      const semitoneFormat = (v) => {
        const n = Math.round(v);
        return n > 0 ? `+${n} st` : `${n} st`;
      };
      const perBarFormat = (v) => `${plainFormat(v)}/bar`;

      const SCULPT_GROUPS = [
        ['Spectral', [
          {
            field: 'tilt',
            label: 'Tilt',
            min: -1,
            max: 1,
            marks: [-1, 0, 1],
            fallback: 0,
            format: (v) => (v <= -0.995 ? 'Brown' : v >= 0.995 ? 'White' : plainFormat(v)),
            hint: 'The colour of the noise bed: brown and rumbling at the left, flat white at the right.',
          },
          {
            field: 'bandCentre',
            label: 'Band',
            min: 60,
            max: 8000,
            log: true,
            fallback: 800,
            format: hzFormat,
            hint: 'Where the resonant band sits — the pitch you hear in the bed. Low is a rumble, high is a hiss.',
          },
          {
            field: 'bandWidth',
            label: 'Width',
            min: 0.1,
            max: 4,
            step: 0.05,
            fallback: 2,
            format: octaveSpanFormat,
            hint: 'How wide that band is, in octaves. Narrow whistles at one pitch; wide is closer to open weather.',
          },
        ]],
        ['Motion', [
          {
            field: 'sweepRate',
            label: 'Sweep',
            min: 0,
            max: 0.5,
            step: 0.005,
            fallback: 0.05,
            format: rateHzFormat,
            hint: 'How fast the band sweeps up and down. Off at the left; a slow breath a little way in.',
          },
          {
            field: 'sweepDepth',
            label: 'Depth',
            min: 0,
            max: 1,
            fallback: 0.15,
            format: pctFormat,
            parse: pctParse,
            hint: 'How far that sweep travels. At zero the band holds still whatever the sweep rate says.',
          },
          {
            field: 'gust',
            label: 'Gust',
            min: 0,
            max: 1,
            fallback: 0.2,
            format: pctFormat,
            parse: pctParse,
            hint: 'A slow random walk on level and brightness — the wind picking up and dying back.',
          },
          {
            field: 'gustRate',
            label: 'Gust rate',
            min: 0.02,
            max: 0.5,
            step: 0.005,
            fallback: 0.08,
            format: rateHzFormat,
            hint: 'How quickly those gusts come and go.',
          },
          {
            field: 'swell',
            label: 'Swell',
            min: 0,
            max: 1,
            fallback: 0,
            format: pctFormat,
            parse: pctParse,
            hint: 'Stretches the attack into a crescendo — small is a gentle rise, full is storm-scale.',
          },
        ]],
        ['Bursts', [
          {
            field: 'burst',
            label: 'Density',
            min: 0,
            max: 1,
            fallback: 0.2,
            format: pctFormat,
            parse: pctParse,
            hint: 'How many grains land per second: droplets at the bottom, a downpour at the top.',
          },
          {
            field: 'burstSharp',
            label: 'Sharpness',
            min: 0,
            max: 1,
            fallback: 0.5,
            format: pctFormat,
            parse: pctParse,
            hint: 'The character of each grain — soft damp drops at the left, dry bright crackle at the right.',
          },
        ]],
      ];

      const CALL_GROUPS = [
        ['Glide', [
          {
            field: 'glide',
            label: 'Sweep',
            min: -24,
            max: 24,
            step: 1,
            marks: [-24, -12, 0, 12, 24],
            fallback: 0,
            format: semitoneFormat,
            hint: 'How far each call slides in pitch, in semitones. Negative falls, positive rises.',
          },
          {
            field: 'glideCurve',
            label: 'Curve',
            min: 0,
            max: 1,
            fallback: 0.5,
            format: pctFormat,
            parse: pctParse,
            hint: 'The shape of that slide: even at the left, snapping to the target end at the right.',
          },
        ]],
        ['Formants', [
          {
            field: 'formant1',
            label: 'Formant 1',
            min: 60,
            max: 8000,
            log: true,
            fallback: 900,
            format: hzFormat,
            hint: 'The lower of the two resonances that give the call its vowel — its body.',
          },
          {
            field: 'formant2',
            label: 'Formant 2',
            min: 60,
            max: 8000,
            log: true,
            fallback: 2200,
            format: hzFormat,
            hint: 'The upper resonance. Far above the first reads as a whistle; close to it, as a hoot.',
          },
        ]],
        ['Phrasing', [
          {
            field: 'cadence',
            label: 'Cadence',
            min: 0.5,
            max: 8,
            step: 0.1,
            fallback: 2,
            format: perBarFormat,
            hint: 'Calls per bar — a single long note at the left, chattering at the right.',
          },
          {
            field: 'irregular',
            label: 'Irregular',
            min: 0,
            max: 1,
            fallback: 0.25,
            format: pctFormat,
            parse: pctParse,
            hint: 'How unevenly those calls are spaced. Zero is metronomic; higher sounds like a living thing.',
          },
        ]],
      ];

      /**
       * Which v19 group sets this voice actually asks for. A voice declares a
       * family by SHIPPING its fields in `defaults` — the same test the voice
       * library uses internally — because `controls: true` means "every field
       * in the schema applies", which was written long before these sixteen
       * existed and must not be read as a claim about them. `controls` then
       * gets the final say, so a voice can still hide a field it defaults.
       */
      function v19GroupsFor(sourceSpec, defaults) {
        const shipped = defaults && isPlainObject(defaults.source) ? defaults.source : null;
        if (!shipped) return [];
        const groups = [];
        if (engineCaps.patchSculpt && shipped.tilt !== undefined && controlsFieldAllowed(sourceSpec, 'tilt')) {
          groups.push(...SCULPT_GROUPS);
        }
        if (engineCaps.patchCall && shipped.cadence !== undefined && controlsFieldAllowed(sourceSpec, 'cadence')) {
          groups.push(...CALL_GROUPS);
        }
        return groups;
      }

      /** A v19 field's starting value: the patch's, else the voice's, else the table's. */
      function v19Value(patch, defaults, spec) {
        const stored = isPlainObject(patch.source) ? patch.source[spec.field] : undefined;
        const shipped = defaults && isPlainObject(defaults.source) ? defaults.source[spec.field] : undefined;
        const fallback = isNumberOrRange(shipped) ? shipped : spec.fallback;
        return sanitiseRangeValueIn(stored, spec.min, spec.max, fallback);
      }

      // ---- v8: applicable-controls (voice metadata may hide sections) ----
      // `controls` (VOICES[track][voiceId].controls, may be absent) is
      // { source?, filter?, adsr?, sends? }, each true | false | string[] of
      // field names. Absent whole descriptor, or an absent section key,
      // means "applies" (render everything) — only an explicit false or a
      // field array narrows what's shown. Field names match the Patch
      // schema: source: shape1/shape2/mix/detune/octave; filter:
      // type/cutoff/q/envAmount; adsr: attack/decay/sustain/release;
      // sends: reverb/delay.
      function controlsSectionSpec(controls, section) {
        if (!isPlainObject(controls)) return true;
        const v = controls[section];
        return v === undefined ? true : v;
      }
      function controlsSectionVisible(spec) {
        if (spec === false) return false;
        if (Array.isArray(spec)) return spec.length > 0;
        return true;
      }
      function controlsFieldAllowed(spec, field) {
        if (spec === false) return false;
        if (Array.isArray(spec)) return spec.includes(field);
        return true;
      }

      // Fallback editor: the pre-v5 slider/select controls — the path when
      // knob.js is missing or its API throws. Writes the same
      // shape-normalised patch the knob editor writes.
      //
      // v7 RangeValue: a plain <input type=range> has one thumb, so this
      // editor stays a single-value editor for the fields the knob editor
      // now ranges (mix, detune, filter cutoff/q/envAmount, ADSR ×4, both
      // sends) — it reads a RangeValue's midpoint for display and always
      // writes back a plain number, collapsing any existing {min,max}.
      function buildSliderEditor(container, patch, commit, controls, track = null, defaults = null) {
        const sourceSpec = controlsSectionSpec(controls, 'source');
        const filterSpec = controlsSectionSpec(controls, 'filter');
        const adsrSpec = controlsSectionSpec(controls, 'adsr');
        const sendsSpec = controlsSectionSpec(controls, 'sends');

        const source = controlsSectionVisible(sourceSpec) ? veSection(container, 'Source') : null;
        if (source && controlsFieldAllowed(sourceSpec, 'shape1')) {
          veSelect(source, 'Osc 1', {
            options: OSC_TYPES,
            value: SHAPE_NAMES[Math.round(readShape(patch.source, 1) ?? 0)],
            onChange: (v) => {
              writeShape(patch.source, 1, SHAPE_FROM_STRING[v]);
              commit();
            },
          });
        }
        // Same v26 linkage the knob editor makes: no second oscillator, no
        // balance to set between them.
        let osc2Enabled = null;
        let syncMixControl = () => {};
        if (source && controlsFieldAllowed(sourceSpec, 'shape2')) {
          const initialShape2 = readShape(patch.source, 2);
          osc2Enabled = initialShape2 !== null;
          const osc2Control = veSelect(source, 'Osc 2', {
            options: [['none', 'None'], ...OSC_TYPES],
            value: initialShape2 === null ? 'none' : SHAPE_NAMES[Math.round(initialShape2)],
            onChange: (v) => {
              writeShape(patch.source, 2, v === 'none' ? null : SHAPE_FROM_STRING[v]);
              osc2Enabled = v !== 'none';
              syncMixControl();
              commit();
            },
          });
          if (osc2Control) describe(osc2Control, 'Adds a second oscillator; Mix balances the two.');
        }
        if (source && controlsFieldAllowed(sourceSpec, 'mix')) {
          const mixControl = veRange(source, 'Mix', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.source.mix, 0, 1, 0.5)),
            onChange: (v) => {
              patch.source.mix = v;
              commit();
            },
          });
          const mixWrap = mixControl ? mixControl.closest('.control') : null;
          if (osc2Enabled !== null && mixWrap) {
            syncMixControl = () => {
              mixWrap.hidden = !osc2Enabled;
            };
            syncMixControl();
          }
        }
        if (source && controlsFieldAllowed(sourceSpec, 'detune')) {
          const bipolar = engineCaps.patchDetuneBipolar;
          const detuneMin = bipolar ? -DETUNE_MAX : 0;
          veRange(source, 'Detune', {
            min: detuneMin,
            max: DETUNE_MAX,
            step: 1,
            value: rangeMid(sanitiseRangeValueIn(patch.source.detune, detuneMin, DETUNE_MAX, 4)),
            format: (v) => detuneFormat(v, bipolar),
            onChange: (v) => {
              const n = Math.round(v);
              patch.source.detune = bipolar && Math.abs(n) <= DETUNE_DETENT ? 0 : n;
              commit();
            },
          });
        }
        // v18: the same percussion Pitch/Noise swap the knob editor makes,
        // gated on the same engine probe (see buildKnobEditor).
        const pitchInPlaceOfOctave = track === 'percussion' && engineCaps.patchPitch;
        const sourceEditable = (field) =>
          controlsFieldAllowed(sourceSpec, field) || controlsFieldAllowed(sourceSpec, 'octave');

        if (source && !pitchInPlaceOfOctave && controlsFieldAllowed(sourceSpec, 'octave')) {
          veSelect(source, 'Octave', {
            options: [
              ['-1', '-1'],
              ['0', '0'],
              ['1', '+1'],
            ],
            value: String(patch.source.octave),
            onChange: (v) => {
              patch.source.octave = parseInt(v, 10);
              commit();
            },
          });
        }
        if (source && pitchInPlaceOfOctave && sourceEditable('pitch')) {
          veRange(source, 'Pitch', {
            min: -24,
            max: 24,
            step: 1,
            value: clamp(
              typeof patch.source.pitch === 'number'
                ? patch.source.pitch
                : (patch.source.octave || 0) * 12,
              -24,
              24
            ),
            format: (v) => (v > 0 ? `+${Math.round(v)} st` : `${Math.round(v)} st`),
            onChange: (v) => {
              patch.source.pitch = Math.round(clamp(v, -24, 24));
              commit();
            },
          });
        }
        if (source && track === 'percussion' && engineCaps.patchNoise && sourceEditable('noise')) {
          veRange(source, 'Noise', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.source.noise, 0, 1, defaults?.source?.noise ?? 1)),
            format: pctFormat,
            parse: pctParse,
            onChange: (v) => {
              patch.source.noise = clamp(v, 0, 1);
              commit();
            },
          });
        }
        // AUDIT FIX: gated on the VOICE publishing a `fold`, not on it having a
        // shape1. engine-voices only builds a folder where `defaults.source.fold`
        // exists (folding()), and patchFor drops the field otherwise — so on
        // wash, both call voices and all four kits the dial moved, wrote into
        // the patch, persisted into presets and share links, and did NOTHING.
        if (
          source &&
          engineCaps.patchFold &&
          controlsFieldAllowed(sourceSpec, 'fold') &&
          typeof defaults?.source?.fold === 'number'
        ) {
          veRange(source, 'Fold', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.source.fold, 0, 1, defaults?.source?.fold ?? 0)),
            format: pctFormat,
            parse: pctParse,
            onChange: (v) => {
              patch.source.fold = clamp(v, 0, 1);
              commit();
            },
          });
        }
        // The v19 groups get their own sections here too — the fallback is the
        // no-knob.js path, not a cut-down instrument, and these sixteen dials
        // ARE the sculpting voices. Single-value only, like every other
        // rangeable field in this editor.
        for (const [heading, specs] of v19GroupsFor(sourceSpec, defaults)) {
          const groupSection = veSection(container, heading);
          for (const spec of specs) {
            veRange(groupSection, spec.label, {
              min: spec.min,
              max: spec.max,
              step: spec.step || 0.01,
              log: spec.log === true,
              value: rangeMid(v19Value(patch, defaults, spec)),
              format: spec.format,
              onChange: (v) => {
                patch.source[spec.field] = spec.step === 1 ? Math.round(v) : v;
                commit();
              },
            });
          }
        }

        const filter = controlsSectionVisible(filterSpec) ? veSection(container, 'Filter') : null;
        if (filter && controlsFieldAllowed(filterSpec, 'type')) {
          veSelect(filter, 'Type', {
            options: FILTER_TYPES,
            value: patch.filter.type,
            onChange: (v) => {
              patch.filter.type = v;
              commit();
            },
          });
        }
        if (filter && controlsFieldAllowed(filterSpec, 'cutoff')) {
          veRange(filter, 'Cutoff', {
            min: 40,
            max: 12000,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.filter.cutoff, 40, 12000, 2000)),
            format: hzFormat,
            onChange: (v) => {
              patch.filter.cutoff = Math.round(v);
              commit();
            },
          });
        }
        if (filter && controlsFieldAllowed(filterSpec, 'q')) {
          veRange(filter, 'Resonance', {
            min: 0.1,
            max: 20,
            step: 0.1,
            value: rangeMid(sanitiseRangeValueIn(patch.filter.q, 0.1, 20, 0.7)),
            onChange: (v) => {
              patch.filter.q = v;
              commit();
            },
          });
        }
        if (filter && controlsFieldAllowed(filterSpec, 'envAmount')) {
          veRange(filter, 'Env amount', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.filter.envAmount, 0, 1, 0.3)),
            onChange: (v) => {
              patch.filter.envAmount = v;
              commit();
            },
          });
        }

        const adsr = controlsSectionVisible(adsrSpec) ? veSection(container, 'Envelope') : null;
        if (adsr && controlsFieldAllowed(adsrSpec, 'attack')) {
          veRange(adsr, 'Attack', {
            min: 0.001,
            max: 8,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.attack, 0.001, 8, 0.01)),
            format: secFormat,
            onChange: (v) => {
              patch.adsr.attack = v;
              commit();
            },
          });
        }
        if (adsr && controlsFieldAllowed(adsrSpec, 'decay')) {
          veRange(adsr, 'Decay', {
            min: 0.001,
            max: 8,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.decay, 0.001, 8, 0.2)),
            format: secFormat,
            onChange: (v) => {
              patch.adsr.decay = v;
              commit();
            },
          });
        }
        if (adsr && controlsFieldAllowed(adsrSpec, 'sustain')) {
          veRange(adsr, 'Sustain', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.sustain, 0, 1, 0.7)),
            onChange: (v) => {
              patch.adsr.sustain = v;
              commit();
            },
          });
        }
        if (adsr && controlsFieldAllowed(adsrSpec, 'release')) {
          veRange(adsr, 'Release', {
            min: 0.01,
            max: 12,
            log: true,
            value: rangeMid(sanitiseRangeValueIn(patch.adsr.release, 0.01, 12, 0.5)),
            format: secFormat,
            onChange: (v) => {
              patch.adsr.release = v;
              commit();
            },
          });
        }

        const sends = controlsSectionVisible(sendsSpec) ? veSection(container, 'Sends') : null;
        if (sends && controlsFieldAllowed(sendsSpec, 'reverb')) {
          veRange(sends, 'Reverb', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.sends.reverb, 0, 1, 0.3)),
            onChange: (v) => {
              patch.sends.reverb = v;
              commit();
            },
          });
        }
        if (sends && controlsFieldAllowed(sendsSpec, 'delay')) {
          veRange(sends, 'Delay', {
            min: 0,
            max: 1,
            step: 0.01,
            value: rangeMid(sanitiseRangeValueIn(patch.sends.delay, 0, 1, 0.15)),
            onChange: (v) => {
              patch.sends.delay = v;
              commit();
            },
          });
        }
      }

      // Knob-based editor (v5 module look). Throws only if createKnob does —
      // the caller catches and falls back to buildSliderEditor.
      // v12: `defaults` is the voice's own default Patch (base = deepMerge
      // (FALLBACK_PATCH, voice.defaults) in renderVoiceEditor) — every knob's
      // `defaultValue` comes from it, so double-click resets to what the
      // VOICE ships with, not just whatever the patch happened to load with.
      /**
       * `ghost` (v14 kit editor, percussion only) is null on the Common tab and
       * otherwise describes the per-instrument override being edited:
       *   { get(field), isOverridden(field), follow(field), refreshers }
       * `field` on a knob's options is the dotted patch path it edits
       * ('filter.cutoff'); it is consumed here, never passed to createKnob.
       */
      function buildKnobEditor(container, patch, commit, knobs, controls, defaults, ghost = null, track = null) {
        const sourceSpec = controlsSectionSpec(controls, 'source');
        const filterSpec = controlsSectionSpec(controls, 'filter');
        const adsrSpec = controlsSectionSpec(controls, 'adsr');
        const sendsSpec = controlsSectionSpec(controls, 'sends');
        const allowed = (spec, field) => controlsFieldAllowed(spec, field);

        const sections = document.createElement('div');
        sections.className = 'knob-sections';
        container.append(sections);

        function knobSection(heading) {
          const s = document.createElement('div');
          s.className = 'knob-section';
          const h = document.createElement('span');
          h.className = 'panel-label';
          h.textContent = heading;
          const row = document.createElement('div');
          row.className = 'knob-row';
          s.append(h, row);
          sections.append(s);
          return row;
        }

        function addKnob(row, options) {
          const cell = document.createElement('div');
          cell.className = 'knob-cell';
          row.append(cell);
          const { field, ghostMap, ...knobOptions } = options;
          // The kit editor's "common" value, in this dial's own domain (a log
          // dial's ghost has to be mapped exactly as its live value was).
          // Handed to createKnob up front so a ghost-capable knob.js draws the
          // muted pointer on its first paint, not one frame later.
          const common = ghost && field ? ghost.get(field) : undefined;
          const ghostValue =
            common === undefined || common === null
              ? null
              : ghostMap
                ? ghostMap(common)
                : common;
          const handle = knobApi.createKnob(
            cell,
            ghostValue === null ? knobOptions : { ...knobOptions, ghostValue }
          );
          knobs.push(handle);
          if (ghostValue !== null) addGhost(cell, handle, field, knobOptions.format, ghostValue);
          return { cell, handle };
        }

        /**
         * The kit editor's "what does Common say" affordance, in whichever
         * form knob.js supports: a real GHOST POINTER on the dial face when it
         * exposes setGhost(), and otherwise a secondary text readout under the
         * dial ("common 2.0 kHz") with a dot in the track colour. Either way an
         * overridden dial takes the track accent (a ring on the cell) plus a
         * "follow" button that clears the override.
         */
        function addGhost(cell, handle, field, format, shown) {
          const fmt = typeof format === 'function' ? format : (v) => String(v);
          const pointer = typeof handle.setGhost === 'function';
          const row = document.createElement('div');
          row.className = 'knob-ghost';
          const follow = document.createElement('button');
          follow.type = 'button';
          follow.className = 'link-button knob-follow';
          follow.textContent = 'follow';
          follow.addEventListener('click', () => ghost.follow(field));
          describe(follow, 'Drop this instrument’s own value and follow the Common dial again.');
          if (pointer) {
            row.append(follow);
          } else {
            const dot = document.createElement('span');
            dot.className = 'knob-ghost-dot';
            dot.setAttribute('aria-hidden', 'true');
            const text = document.createElement('span');
            text.className = 'knob-ghost-value';
            text.textContent = `common ${
              isPlainObject(shown) ? `${fmt(shown.min)}–${fmt(shown.max)}` : fmt(shown)
            }`;
            row.append(dot, text, follow);
          }
          cell.classList.add('knob-cell-ghosted');
          if (pointer) cell.classList.add('knob-cell-ghost-pointer');
          cell.append(row);
          const refresh = () => {
            const overridden = ghost.isOverridden(field);
            cell.classList.toggle('knob-cell-overridden', overridden);
            follow.hidden = !overridden;
            // Re-asserted rather than set once: a knob that rebuilt its face
            // (a range split, a value commit) must not lose the pointer.
            if (pointer) {
              try {
                handle.setGhost(shown);
              } catch {}
            }
          };
          refresh();
          ghost.refreshers.push(refresh);
        }

        // The page owns the log transforms: the knob itself is linear, its
        // 0–1 position mapped onto the unit's range in format/onInput. v7:
        // `value`/the value onValue receives may be number|{min,max} — the
        // log map is monotonic over the (positive) domains this is used for,
        // so mapping each thumb independently preserves min ≤ max. `knobOpts`
        // carries allowRange/rangeDefault through to createKnob. v12:
        // `defaultLinear` (optional, same domain as `value`) is mapped through
        // the same toLog and passed on as the knob's `defaultValue`.
        function addLogKnob(row, label, min, max, value, format, onValue, knobOpts, defaultLinear) {
          const toLog = (v) => valueToLog(clamp(v, min, max), min, max);
          const fromLog = (t) => logToValue(clamp(t, 0, 1), min, max);
          return addKnob(row, {
            label,
            min: 0,
            max: 1,
            value: mapRV(value, toLog),
            format: (t) => format(fromLog(t)),
            // Typed entry arrives in the dial's DISPLAY unit (Hz, ms, %…) —
            // the same unit format prints — and maps back through the log.
            parse: (n) => toLog(n),
            onInput: (t) => onValue(mapRV(t, fromLog)),
            // The ghost readout is handed the COMMON patch value in this
            // param's own units, so it needs the same linear→log mapping the
            // live value got before the (log-domain) format runs on it.
            ghostMap: (v) => mapRV(v, toLog),
            ...(defaultLinear != null ? { defaultValue: mapRV(defaultLinear, toLog) } : {}),
            ...knobOpts,
          });
        }

        // -- source --
        const source = controlsSectionVisible(sourceSpec) ? knobSection('Source') : null;
        if (source && allowed(sourceSpec, 'shape1')) {
          addKnob(source, {
            label: 'OSC 1',
            field: 'source.shape1',
            glyphOnly: true,
            // v0.0.74: the morph spreads. It was always CONTINUOUS — fractional
            // positions between sine, triangle, saw and square have been legal
            // since v5 — so calling it discrete was simply wrong.
            min: 0,
            max: 3,
            value: readShape(patch.source, 1) ?? 0,
            marks: SHAPE_MARKS,
            markGlyphs: SHAPE_MARK_GLYPHS,
            glyph: shapeGlyph,
            format: shapeFormat,
            defaultValue: readShape(defaults.source, 1) ?? 0,
            onInput: (v) => {
              writeShape(patch.source, 1, v);
              commit();
            },
          });
        }

        // v26: Mix is the osc1↔osc2 BALANCE, so it means nothing with one
        // source — it hides and re-shows with the Osc 2 toggle. `null` here is
        // "this voice has no Osc 2 control at all", which leaves Mix alone.
        let osc2Enabled = null;
        let syncMixCell = () => {};

        // Osc 2's "off" affordance: a toggle beside its dial (shape2 null).
        if (source && allowed(sourceSpec, 'shape2')) {
          let lastShape2 = readShape(patch.source, 2);
          osc2Enabled = lastShape2 !== null;
          const shape2Default = readShape(defaults.source, 2);
          const osc2Cell = document.createElement('div');
          osc2Cell.className = 'knob-cell knob-cell-toggle';
          const osc2Toggle = document.createElement('button');
          osc2Toggle.type = 'button';
          osc2Toggle.className = 'secondary-button osc2-toggle';
          osc2Toggle.textContent = 'Osc 2';
          osc2Toggle.setAttribute('aria-pressed', String(lastShape2 !== null));
          osc2Toggle.setAttribute('aria-label', 'Oscillator 2 on');
          osc2Cell.append(osc2Toggle);
          source.append(osc2Cell);
          describe(osc2Toggle, 'Adds a second oscillator; Mix balances the two.');

          const shape2Knob = addKnob(source, {
            label: 'OSC 2',
            // v0.0.74: the morph spreads. It was always CONTINUOUS — fractional
            // positions between sine, triangle, saw and square have been legal
            // since v5 — so calling it discrete was simply wrong.
            field: 'source.shape2',
            glyphOnly: true,
            min: 0,
            max: 3,
            value: lastShape2 ?? 0,
            marks: SHAPE_MARKS,
            markGlyphs: SHAPE_MARK_GLYPHS,
            glyph: shapeGlyph,
            format: shapeFormat,
            // Only a voice whose own default has osc2 ON declares a dial
            // default here — an off-by-default voice has no canonical "on"
            // shape to reset to, so the knob falls back to its own initial
            // (0) while the cell is reachable at all (i.e. toggled on).
            ...(shape2Default != null ? { defaultValue: shape2Default } : {}),
            onInput: (v) => {
              lastShape2 = mapRV(v, (x) => clamp(x, 0, 3));
              writeShape(patch.source, 2, lastShape2);
              commit();
            },
          });
          shape2Knob.cell.hidden = lastShape2 === null;

          osc2Toggle.addEventListener('click', () => {
            const on = osc2Toggle.getAttribute('aria-pressed') !== 'true';
            osc2Toggle.setAttribute('aria-pressed', String(on));
            shape2Knob.cell.hidden = !on;
            osc2Enabled = on;
            syncMixCell();
            if (on) {
              if (lastShape2 === null) lastShape2 = 0;
              writeShape(patch.source, 2, lastShape2);
              try {
                shape2Knob.handle.set?.(lastShape2);
              } catch {}
            } else {
              writeShape(patch.source, 2, null);
            }
            commit();
          });
        }

        if (source && allowed(sourceSpec, 'mix')) {
          const mixKnob = addKnob(source, {
            label: 'Mix',
            field: 'source.mix',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.source.mix, 0, 1, 0.5),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.source.mix,
            onInput: (v) => {
              patch.source.mix = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
          // Visibility only — patch.source.mix is left exactly as it was, so
          // re-enabling Osc 2 brings the stored balance back untouched.
          if (osc2Enabled !== null && mixKnob) {
            syncMixCell = () => {
              mixKnob.cell.hidden = !osc2Enabled;
            };
            syncMixCell();
          }
        }
        // v12 shipped this unipolar because the sanitiser clamped detune to
        // [0,50]; it has taken -50..50 since v18, and the boot probe says so
        // rather than the version number. Bipolar gets a centre detent: the
        // ±1 ct either side of zero is inaudible, so swallowing it buys a
        // dial you can return to true by feel.
        if (source && allowed(sourceSpec, 'detune')) {
          const bipolar = engineCaps.patchDetuneBipolar;
          const detuneMin = bipolar ? -DETUNE_MAX : 0;
          const detent = (x) => {
            const n = Math.round(clamp(x, detuneMin, DETUNE_MAX));
            return bipolar && Math.abs(n) <= DETUNE_DETENT ? 0 : n;
          };
          addKnob(source, {
            label: 'Detune',
            field: 'source.detune',
            min: detuneMin,
            max: DETUNE_MAX,
            step: 1,
            ...(bipolar ? { marks: [-DETUNE_MAX, 0, DETUNE_MAX] } : {}),
            value: sanitiseRangeValueIn(patch.source.detune, detuneMin, DETUNE_MAX, 4),
            format: (v) => detuneFormat(v, bipolar),
            allowRange: true,
            defaultValue: defaults.source.detune,
            onInput: (v) => {
              patch.source.detune = mapRV(v, detent);
              commit();
            },
          });
        }
        // v18: percussion trades the 3-position Octave switch for a continuous
        // Pitch dial (±24 semitones) and gains a Noise dial — but only where
        // the engine's own PATCH_SCHEMA accepts those fields (probed at boot).
        // Without engine support the Octave switch stays exactly as it was.
        const pitchInPlaceOfOctave = track === 'percussion' && engineCaps.patchPitch;
        // The voice's `controls` may not name the new fields yet: a percussion
        // voice that lets you edit Octave is letting you edit the same thing.
        const sourceEditable = (field) =>
          allowed(sourceSpec, field) || allowed(sourceSpec, 'octave');

        // v12: octave ships ±1, not the addendum's sketched ±2 — both the
        // engine sanitiser (patchNumber(v, -1, 1)) and every voice's own
        // OCTAVES = [-1, 0, 1] (engine-voices.js) clamp there; a ±2 dial
        // would silently round-trip through Math.round(clamp(v,-1,1)) and
        // never actually reach ±2.
        if (source && !pitchInPlaceOfOctave && allowed(sourceSpec, 'octave')) {
          addKnob(source, {
            label: 'Octave',
            field: 'source.octave',
            // v0.0.74: this spreads now. The owner's "either tell me why you
            // won't add variation to all dials, or add it to them all" — and
            // the reason I had given did not survive contact. An oscillator
            // that jumps octave bar by bar is an ordinary synth behaviour;
            // the engine takes a span here and rounds the walk to one of the
            // switch's own stops, so a span never lands between them.
            min: -1,
            max: 1,
            step: 1,
            value: sanitiseRangeValueIn(patch.source.octave, -1, 1, 0),
            marks: [-1, 0, 1],
            format: (v) => (v > 0 ? `+${Math.round(v)}` : String(Math.round(v))),
            defaultValue: defaults.source.octave,
            onInput: (v) => {
              patch.source.octave = mapRV(v, (n) => Math.round(clamp(n, -1, 1)));
              commit();
            },
          });
        }

        if (source && pitchInPlaceOfOctave && sourceEditable('pitch')) {
          const semitones = (v) => {
            const n = Math.round(v);
            return n > 0 ? `+${n} st` : `${n} st`;
          };
          addKnob(source, {
            label: 'Pitch',
            field: 'source.pitch',
            min: -24,
            max: 24,
            step: 1,
            // An older stored patch carries the octave switch instead; ×12
            // reads it in the new dial's units so nothing jumps on upgrade.
            // AUDIT FIX: pitch is rangeable like every numeric dial — the old
            // clamp() on a {min,max} span produced NaN, so a sideways drag
            // wrote NaN into the patch and the pitch silently reverted.
            value: sanitiseRangeValueIn(
              patch.source.pitch ?? (patch.source.octave || 0) * 12,
              -24,
              24,
              0
            ),
            marks: [-24, -12, 0, 12, 24],
            format: semitones,
            defaultValue: defaults.source.pitch ?? (defaults.source.octave || 0) * 12,
            onInput: (v) => {
              patch.source.pitch = mapRV(v, (n) => Math.round(clamp(n, -24, 24)));
              commit();
            },
          });
        }

        if (source && track === 'percussion' && engineCaps.patchNoise && sourceEditable('noise')) {
          addKnob(source, {
            label: 'Noise',
            field: 'source.noise',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.source.noise, 0, 1, defaults.source.noise ?? 0.5),
            format: pctFormat,
            parse: pctParse,
            allowRange: engineCaps.patchNoiseRange,
            ...(defaults.source.noise != null ? { defaultValue: defaults.source.noise } : {}),
            onInput: (v) => {
              patch.source.noise = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }

        // v20 wavefolder: a shape MODIFIER, so it belongs to whatever has an
        // oscillator to fold — a voice that lets you re-type shape1 has one.
        // Bypassed at 0 (no extra nodes), which is every voice's default until
        // the library starts shipping folded ones.
        // AUDIT FIX (see the fallback builder above): the voice must publish a
        // fold for the dial to do anything.
        if (
          source &&
          engineCaps.patchFold &&
          allowed(sourceSpec, 'fold') &&
          typeof defaults?.source?.fold === 'number'
        ) {
          addKnob(source, {
            label: 'Fold',
            field: 'source.fold',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.source.fold, 0, 1, defaults.source.fold ?? 0),
            format: pctFormat,
            parse: pctParse,
            allowRange: true,
            defaultValue: defaults.source.fold ?? 0,
            onInput: (v) => {
              patch.source.fold = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }

        // -- v19 sculpting / call groups --
        // Their own labelled sub-rows rather than more dials crowded into
        // Source: sixteen fields in one row would read as a wall, and the
        // group names (Spectral / Motion / Bursts, Glide / Formants /
        // Phrasing) are how the surface is taught.
        for (const [heading, specs] of v19GroupsFor(sourceSpec, defaults)) {
          const row = knobSection(heading);
          for (const spec of specs) {
            const write = (v) => {
              patch.source[spec.field] = mapRV(v, (x) =>
                spec.step === 1 ? Math.round(clamp(x, spec.min, spec.max)) : clamp(x, spec.min, spec.max)
              );
              commit();
            };
            const knobOpts = {
              allowRange: engineCaps.patchV19Range,
              field: `source.${spec.field}`,
              ...(spec.step ? { step: spec.step } : {}),
              ...(spec.marks ? { marks: spec.marks } : {}),
            };
            const shipped = isPlainObject(defaults.source) ? defaults.source[spec.field] : undefined;
            const fallbackDefault = isNumberOrRange(shipped) ? shipped : spec.fallback;
            const cell = spec.log
              ? addLogKnob(
                  row,
                  spec.label,
                  spec.min,
                  spec.max,
                  v19Value(patch, defaults, spec),
                  spec.format,
                  write,
                  knobOpts,
                  fallbackDefault
                )
              : addKnob(row, {
                  label: spec.label,
                  min: spec.min,
                  max: spec.max,
                  value: v19Value(patch, defaults, spec),
                  format: spec.format,
                  defaultValue: fallbackDefault,
                  onInput: write,
                  ...knobOpts,
                });
            describe(cell.handle.el, spec.hint);
          }
        }

        // -- filter --
        const filter = controlsSectionVisible(filterSpec) ? knobSection('Filter') : null;
        if (filter && allowed(filterSpec, 'type')) {
          addKnob(filter, {
            label: 'Type',
            field: 'filter.type',
            allowRange: false, // an enumeration — see the Octave dial above
            // The dial's domain is the index, the patch stores the name.
            ghostMap: (v) => Math.max(0, FILTER_ORDER.indexOf(v)),
            min: 0,
            max: 3,
            step: 1,
            value: Math.max(0, FILTER_ORDER.indexOf(patch.filter.type)),
            marks: [0, 1, 2, 3],
            format: (v) => FILTER_DIAL_LABELS[Math.round(clamp(v, 0, 3))],
            defaultValue: Math.max(0, FILTER_ORDER.indexOf(defaults.filter.type)),
            onInput: (v) => {
              patch.filter.type = FILTER_ORDER[Math.round(clamp(v, 0, 3))];
              commit();
            },
          });
        }
        if (filter && allowed(filterSpec, 'cutoff')) {
          // v7: cutoff is on the default-RANGE list — rangeDefault starts a
          // freshly-opened (plain-number) patch already split into a
          // min=max=value range, ready for the second thumb.
          addLogKnob(
            filter,
            'Cutoff',
            40,
            12000,
            sanitiseRangeValueIn(patch.filter.cutoff, 40, 12000, 2000),
            hzFormat,
            (v) => {
              patch.filter.cutoff = mapRV(v, Math.round);
              commit();
            },
            { allowRange: true, rangeDefault: true, field: 'filter.cutoff' },
            defaults.filter.cutoff
          );
        }
        if (filter && allowed(filterSpec, 'q')) {
          addKnob(filter, {
            label: 'Resonance',
            field: 'filter.q',
            min: 0.1,
            max: 20,
            step: 0.1,
            value: sanitiseRangeValueIn(patch.filter.q, 0.1, 20, 0.7),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.filter.q,
            onInput: (v) => {
              patch.filter.q = mapRV(v, (x) => clamp(x, 0.1, 20));
              commit();
            },
          });
        }
        if (filter && allowed(filterSpec, 'envAmount')) {
          addKnob(filter, {
            label: 'Env amount',
            field: 'filter.envAmount',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.filter.envAmount, 0, 1, 0.3),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.filter.envAmount,
            onInput: (v) => {
              patch.filter.envAmount = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }

        // -- envelope --
        const env = controlsSectionVisible(adsrSpec) ? knobSection('Envelope') : null;
        if (env && allowed(adsrSpec, 'attack')) {
          addLogKnob(
            env,
            'Attack',
            0.001,
            8,
            sanitiseRangeValueIn(patch.adsr.attack, 0.001, 8, 0.01),
            secFormat,
            (v) => {
              patch.adsr.attack = v;
              commit();
            },
            { allowRange: true, field: 'adsr.attack' },
            defaults.adsr.attack
          );
        }
        if (env && allowed(adsrSpec, 'decay')) {
          addLogKnob(
            env,
            'Decay',
            0.001,
            8,
            sanitiseRangeValueIn(patch.adsr.decay, 0.001, 8, 0.2),
            secFormat,
            (v) => {
              patch.adsr.decay = v;
              commit();
            },
            { allowRange: true, field: 'adsr.decay' },
            defaults.adsr.decay
          );
        }
        if (env && allowed(adsrSpec, 'sustain')) {
          addKnob(env, {
            label: 'Sustain',
            field: 'adsr.sustain',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.adsr.sustain, 0, 1, 0.7),
            format: plainFormat,
            allowRange: true,
            defaultValue: defaults.adsr.sustain,
            onInput: (v) => {
              patch.adsr.sustain = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
        if (env && allowed(adsrSpec, 'release')) {
          addLogKnob(
            env,
            'Release',
            0.01,
            12,
            sanitiseRangeValueIn(patch.adsr.release, 0.01, 12, 0.5),
            secFormat,
            (v) => {
              patch.adsr.release = v;
              commit();
            },
            { allowRange: true, field: 'adsr.release' },
            defaults.adsr.release
          );
        }

        // -- sends --
        // Both sends are on the v7 default-RANGE list too (like Cutoff
        // above) — rangeDefault starts a plain-number patch pre-split.
        const sends = controlsSectionVisible(sendsSpec) ? knobSection('Sends') : null;
        if (sends && allowed(sendsSpec, 'reverb')) {
          addKnob(sends, {
            label: 'Reverb',
            field: 'sends.reverb',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.sends.reverb, 0, 1, 0.3),
            format: plainFormat,
            allowRange: true,
            rangeDefault: true,
            defaultValue: defaults.sends.reverb,
            onInput: (v) => {
              patch.sends.reverb = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
        if (sends && allowed(sendsSpec, 'delay')) {
          addKnob(sends, {
            label: 'Delay',
            field: 'sends.delay',
            min: 0,
            max: 1,
            value: sanitiseRangeValueIn(patch.sends.delay, 0, 1, 0.15),
            format: plainFormat,
            allowRange: true,
            rangeDefault: true,
            defaultValue: defaults.sends.delay,
            onInput: (v) => {
              patch.sends.delay = mapRV(v, (x) => clamp(x, 0, 1));
              commit();
            },
          });
        }
      }

      /**
       * `opts.voiceId` overrides which voice the dial set edits — used when
       * the engine's voice wander has moved this track onto a different
       * voice (v14 "editor follows the sounding voice"). The row's <select>
       * is untouched: it keeps showing the user's own choice, because the
       * wander is ephemeral and getParams still reports the chosen voice.
       */
      async function renderVoiceEditor(track, opts = {}) {
        const container = document.getElementById(`voice-editor-${track}`);
        const voiceId = opts.voiceId || settings.tracks[track].voice;

        // Claim the editor slot BEFORE the await, not after: a quick row
        // switch closes this container (hiding it, tearing down whatever
        // was registered) while we're still awaiting the voices module, so
        // registering openEditors first lets that teardown actually find
        // and cancel us instead of racing a build onto a hidden container.
        teardownEditor(track);
        container.innerHTML = '';
        const ed = { scope: null, knobs: [], extras: null, seq: null };
        openEditors.set(track, ed);

        const voices = await getVoicesTable();
        if (container.hidden) return; // closed while awaiting — leave no live rAF scope loop behind
        const voiceEntry = voices && voices[track] && voices[track][voiceId] ? voices[track][voiceId] : null;
        // Feature-detect .defaults / .controls — absent on an older
        // engine-voices build; absent .controls = render every section/field
        // (the pre-v8 behaviour).
        const defaults = voiceEntry && voiceEntry.defaults ? voiceEntry.defaults : null;
        const controls = voiceEntry && voiceEntry.controls ? voiceEntry.controls : null;
        // The voice's full default Patch — every knob's `defaultValue` (what a
        // double-click returns to) is read off it. Same expression
        // resolveTrackPatch merges the stored override onto, so the dials and
        // the sound they describe can never disagree.
        const base = deepMerge(FALLBACK_PATCH, defaults || {});
        // resolveTrackPatch reads voicesTable (set by the getVoicesTable()
        // await just above) + normalises shapes the same way this used to
        // inline — also feeds the front oscilloscope's stopped-state preview.
        const patch = resolveTrackPatch(track, voiceId);

        // ---- v14 kit editor: Common | High | Mid | Low -------------------
        // The percussion patch may carry sparse per-instrument overrides at
        // patch.perKind[kind]; `kitKind` is null on the Common tab and the
        // kind id on an instrument tab. The dials always edit ONE object:
        // `editView` — the patch itself on Common, or a merged
        // common+override view on an instrument tab, whose differences from
        // common are folded back into perKind on every commit (so an
        // override only ever exists for a dial the user actually moved).
        // The engine may not honour perKind yet; the overrides persist and
        // are preset-captured regardless, and an engine that ignores the key
        // simply plays the common patch.
        //
        // v21: the tabs are the LANE list, not a fixed low/mid/high triple —
        // perKind keys follow lane ids, so a lane the user added gets its own
        // tab and its own overrides. The three built-in lanes keep the ids the
        // v14 kit editor wrote, so every stored override still lands.
        const kitCapable = track === 'percussion';
        const kitTabList = () =>
          kitCapable
            ? laneListFor(track, settings.tracks[track]).map((lane) => [lane.key, lane.label])
            : [];
        let kitKind =
          kitCapable && kitTabList().some(([k]) => k === opts.kind) ? opts.kind : null;
        let editView = patch;
        let ghostRefreshers = [];

        function commonPatch() {
          const clone = structuredClone(patch);
          delete clone.perKind;
          return clone;
        }

        function kindOverride(kind) {
          const per = isPlainObject(patch.perKind) ? patch.perKind : null;
          return per && isPlainObject(per[kind]) ? per[kind] : {};
        }

        /** Fields of `view` that differ from `common`, section by section. */
        function sparseOverride(common, view) {
          const out = {};
          for (const section of PATCH_SECTIONS) {
            const from = isPlainObject(common[section]) ? common[section] : {};
            const to = isPlainObject(view[section]) ? view[section] : {};
            for (const field of Object.keys(to)) {
              if (JSON.stringify(to[field]) === JSON.stringify(from[field])) continue;
              if (!out[section]) out[section] = {};
              out[section][field] = structuredClone(to[field]);
            }
          }
          return out;
        }

        function storePatch() {
          if (!settings.patches[track]) settings.patches[track] = {};
          settings.patches[track][voiceId] = patch;
          sendPatch(track, voiceId, patch);
          scheduleScopeRender(track);
          persistSettings();
          // The row's selector reads "Custom (…)" from this comparison.
          refreshVoiceSelect(track);
        }

        function commit() {
          if (kitKind) {
            const over = sparseOverride(commonPatch(), editView);
            if (!isPlainObject(patch.perKind)) patch.perKind = {};
            if (Object.keys(over).length) patch.perKind[kitKind] = over;
            else delete patch.perKind[kitKind];
            if (!Object.keys(patch.perKind).length) delete patch.perKind;
            for (const refresh of ghostRefreshers) refresh();
          }
          storePatch();
        }

        // v14 header: track name + "sounding" note, the Off/Auto/On state
        // control (moved out of the single-line row), the dice re-roll and
        // the Randomness mirror.
        container.classList.add(trackColourClass(track));
        const header = document.createElement('div');
        header.className = 've-header';
        const headerTitle = document.createElement('span');
        headerTitle.className = 'panel-label ve-title';
        headerTitle.textContent = TRACK_LABELS[track];
        const sounding = document.createElement('span');
        sounding.className = 'value-readout ve-sounding';
        sounding.hidden = true;
        const extrasBox = document.createElement('div');
        extrasBox.className = 'track-extras ve-extras';
        header.append(headerTitle, sounding, extrasBox);
        container.append(header);
        buildStateControl(extrasBox, track);
        ed.extras = buildTrackExtras(extrasBox, track, { knobs: ed.knobs, withDice: true });
        ed.sounding = sounding;
        ed.voiceId = voiceId;
        registerExtras(track, ed.extras);
        // Mono/glide belong to the LINE, so they sit in the header beside the
        // state lamp rather than among the patch dials — and only on the
        // melodic tracks: a kit has no pitch to slur between.
        if (TUNED_TRACKS.includes(track)) buildMonoGlide(extrasBox, track, ed.knobs);
        buildVaryRow(container, track, ed.knobs);
        // v26: ONE aligned row for this track's feel dials — Dissonance,
        // Drift rate, Swing, Density, Breath — however few of them this
        // track and this engine build actually have.
        const feelRow = document.createElement('div');
        feelRow.className = 'dissonance-row feel-row';
        container.append(feelRow);
        buildDissonanceControl(feelRow, track, ed.knobs);
        buildDriftRateControl(feelRow, track, ed.knobs);
        // Beside the rate, because the two are one idea: what the spread does,
        // and how fast it does it.
        buildDriftShapeControl(feelRow, track);
        buildFeelRow(feelRow, track, ed.knobs);
        // An editor opened while the dial is Universal must arrive with its
        // per-track copy already hidden, not hide it a frame later.
        applyScopeVisibility();
        buildPadBreathControl(feelRow, track, ed.knobs);
        if (!feelRow.childElementCount) feelRow.remove();

        // v6 step sequencer at the top of the pulsed tracks' panels. Arp
        // always shows it (on/off degrades to the legacy boolean mask);
        // melody/bass/percussion need engine support or the grid is dead.
        const showSeq =
          track === 'arp' ||
          ((SEQ_SINGLE_TRACKS.includes(track) || isPercussiveTrack(track)) &&
            engineCaps.sequencer[track]);
        // Editing the lane list re-keys perKind, so the kit tabs below have to
        // follow it. Assigned once they exist; a no-op until then.
        let syncKitTabs = () => {};
        if (showSeq) ed.seq = buildSequencer(container, track, { onLanes: () => syncKitTabs() });

        // Arpeggiator controls live here now, above the voice sections.
        if (track === 'arp') buildArpSection(container);

        if (scopeApi) {
          const head = document.createElement('div');
          head.className = 'scope-head';
          const scopeCanvas = document.createElement('canvas');
          scopeCanvas.className = 'patch-scope';
          scopeCanvas.setAttribute('aria-label', `${track} voice waveform preview`);
          const indicator = document.createElement('span');
          indicator.className = 'scope-mode';
          indicator.textContent = 'OFFLINE';
          head.append(scopeCanvas, indicator);
          container.append(head);
          ed.scope = {
            canvas: scopeCanvas,
            indicator,
            live: null,
            analyser: null, // the analyser node s.live is currently attached to
            debounce: null,
            // The scope traces whatever the dials are editing — the common
            // patch, or the instrument view on a kit tab.
            getPatch: () => editView,
          };
          updateScopeMode(track); // draws the static trace or attaches live
        }

        // Kit tabs (percussion only), directly above the dials they retarget.
        let kitTabs = null;
        if (kitCapable) {
          kitTabs = document.createElement('div');
          kitTabs.className = 'segmented kit-tabs';
          kitTabs.setAttribute('role', 'radiogroup');
          kitTabs.setAttribute('aria-label', 'Kit editor target');
          const renderKitTabs = () => {
            kitTabs.innerHTML = '';
            for (const [value, labelText] of [['common', 'Common'], ...kitTabList()]) {
              const input = document.createElement('input');
              input.type = 'radio';
              input.name = `kit-kind-${track}`;
              input.id = `kit-kind-${track}-${value}`;
              input.value = value;
              input.checked = (kitKind || 'common') === value;
              const label = document.createElement('label');
              label.htmlFor = input.id;
              label.textContent = labelText;
              input.addEventListener('change', () => {
                if (!input.checked) return;
                kitKind = value === 'common' ? null : value;
                opts.kind = kitKind;
                buildPatchControls();
                scheduleScopeRender(track, true);
              });
              kitTabs.append(input, label);
            }
          };
          renderKitTabs();
          syncKitTabs = () => {
            // A lane the tabs were pointing at may have gone (or been
            // renamed): fall back to Common rather than editing an override
            // nothing plays any more.
            if (kitKind && !kitTabList().some(([k]) => k === kitKind)) {
              kitKind = null;
              opts.kind = null;
              renderKitTabs();
              buildPatchControls();
              scheduleScopeRender(track, true);
              return;
            }
            renderKitTabs();
          };
          container.append(kitTabs);
          describe(
            kitTabs,
            'Common holds the whole kit’s sound. Pick an instrument to give it its own values for any dial — the rest keep following Common.'
          );
        }

        // The dial set is rebuilt in place whenever the kit tab changes; the
        // knobs it owns are tracked separately so a rebuild destroys exactly
        // those and leaves the header/vary/sequencer knobs alone.
        const patchBox = document.createElement('div');
        patchBox.className = 'patch-controls';
        container.append(patchBox);
        let patchKnobs = [];

        function buildPatchControls() {
          for (const knob of patchKnobs) {
            try {
              knob.destroy?.();
            } catch {}
          }
          ed.knobs = ed.knobs.filter((knob) => !patchKnobs.includes(knob));
          patchKnobs = [];
          ghostRefreshers = [];
          patchBox.innerHTML = '';

          let ghost = null;
          if (kitKind) {
            const common = commonPatch();
            editView = deepMerge(common, kindOverride(kitKind));
            const readPath = (source, field) => {
              const [section, key] = field.split('.');
              const box = isPlainObject(source[section]) ? source[section] : null;
              return box ? box[key] : undefined;
            };
            ghost = {
              refreshers: ghostRefreshers,
              get: (field) => readPath(common, field),
              isOverridden: (field) => readPath(kindOverride(kitKind), field) !== undefined,
              follow: (field) => {
                const [section, key] = field.split('.');
                const per = isPlainObject(patch.perKind) ? patch.perKind : null;
                if (per && isPlainObject(per[kitKind]) && isPlainObject(per[kitKind][section])) {
                  delete per[kitKind][section][key];
                  if (!Object.keys(per[kitKind][section]).length) delete per[kitKind][section];
                  if (!Object.keys(per[kitKind]).length) delete per[kitKind];
                  if (!Object.keys(per).length) delete patch.perKind;
                }
                storePatch();
                buildPatchControls();
                scheduleScopeRender(track, true);
              },
            };
          } else {
            editView = patch;
          }

          let knobsBuilt = false;
          if (knobApi) {
            try {
              buildKnobEditor(patchBox, editView, commit, patchKnobs, controls, base, ghost, track);
              knobsBuilt = true;
            } catch {
              for (const knob of patchKnobs) {
                try {
                  knob.destroy?.();
                } catch {}
              }
              patchKnobs = [];
              patchBox.innerHTML = '';
            }
          }
          // Slider fallback: no knob.js, so no ghost pointers either — the
          // instrument tabs still edit the override, just without the
          // "common" read-out.
          if (!knobsBuilt) buildSliderEditor(patchBox, editView, commit, controls, track, base);
          ed.knobs.push(...patchKnobs);
          if (resetButton) resetButton.textContent = resetLabel();
        }

        function resetLabel() {
          if (!kitKind) return 'Reset to default';
          const found = kitTabList().find(([k]) => k === kitKind);
          return `Clear ${found ? found[1] : kitKind} overrides`;
        }

        const resetButton = document.createElement('button');
        resetButton.type = 'button';
        resetButton.className = 'secondary-button';
        resetButton.addEventListener('click', () => {
          if (kitKind) {
            // On an instrument tab, reset means "drop THIS instrument's
            // overrides" — the common patch the whole kit shares is not the
            // thing the user is looking at.
            const per = isPlainObject(patch.perKind) ? patch.perKind : null;
            if (per) {
              delete per[kitKind];
              if (!Object.keys(per).length) delete patch.perKind;
            }
            storePatch();
            buildPatchControls();
            scheduleScopeRender(track, true);
            return;
          }
          if (settings.patches[track]) {
            delete settings.patches[track][voiceId];
            if (Object.keys(settings.patches[track]).length === 0) {
              delete settings.patches[track];
            }
          }
          // An empty patch merges over the voice defaults engine-side; when
          // the defaults are known, send them explicitly for robustness.
          sendPatch(track, voiceId, defaults ? structuredClone(defaults) : {});
          persistSettings();
          refreshVoiceSelect(track);
          renderVoiceEditor(track);
        });

        buildPatchControls(); // also sets the reset button's label
        container.append(resetButton);
      }

      // ---- v8: single-open voice-editor accordion ------------------------
      // A track row gaining focus/selection (click or keyboard, anywhere
      // except the Edit button, which has its own explicit toggle below)
      // opens that track's editor and collapses any other open one. Both
      // paths funnel through the same open/close pair so they can never
      // fight each other, and both compose with teardownEditor (scope
      // destroy, knob destroy, extras unregister).
      // v13: closing an editor with the Edit toggle disarms focus-driven
      // reopening for that track until Edit is pressed again — otherwise the
      // next Tab into the row instantly undoes the close the user just asked
      // for. Only the Edit toggle re-arms it.
      const focusOpenDisarmed = new Set();

      function closeTrackEditor(id) {
        const editor = document.getElementById(`voice-editor-${id}`);
        const toggle = document.getElementById(`voice-edit-toggle-${id}`);
        if (!editor || !toggle) return;
        if (editor.hidden) return;
        editor.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        teardownEditor(id);
      }

      // restoreScroll: only click-initiated opens put the viewport back
      // where the user's eye was — a keyboard/focusin-driven open (Tab
      // landing in the row) already has the browser scrolling the newly
      // focused control into view, and overriding that with the old
      // scrollY would just scroll the focused control back out of sight.
      function openTrackEditor(id, { restoreScroll = false } = {}) {
        const editor = document.getElementById(`voice-editor-${id}`);
        const toggle = document.getElementById(`voice-edit-toggle-${id}`);
        if (!editor || !toggle) return;
        if (!editor.hidden) return; // already the one open
        const scrollY = restoreScroll ? window.scrollY : null;
        for (const other of TRACK_IDS) {
          if (other !== id) closeTrackEditor(other);
        }
        editor.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        renderVoiceEditor(id);
        if (restoreScroll) {
          // The accordion swap changes page height above/below the fold;
          // put the viewport back where the user's eye was.
          requestAnimationFrame(() => window.scrollTo(0, scrollY));
        }
      }

      function isEditToggle(el) {
        return !!(el && el.closest && el.closest('.voice-edit-toggle'));
      }

      // v14: a lamp/state click is a MUSICAL action, never a navigation one —
      // turning a track off must not expand (or keep open) its editor.
      function isStateControl(el) {
        return !!(el && el.closest && el.closest('.track-lamp'));
      }

      /** Wire one row's Edit accordion and its focus/click open behaviour. */
      function wireTrackEditorToggle(id) {
        const toggle = document.getElementById(`voice-edit-toggle-${id}`);
        const editor = document.getElementById(`voice-editor-${id}`);
        const row = document.querySelector(`.track-row[data-track="${id}"]`);
        if (!toggle || !editor) return;

        // Edit button: explicit, secondary affordance — still routes through
        // the same accordion open/close so it can never desync from focus-
        // driven opens. It is also the ONLY thing that re-arms focus-opening
        // after an explicit close.
        toggle.addEventListener('click', () => {
          if (editor.hidden) {
            focusOpenDisarmed.delete(id);
            openTrackEditor(id, { restoreScroll: true });
          } else {
            focusOpenDisarmed.add(id);
            closeTrackEditor(id);
          }
        });

        // Row focus/selection: click or keyboard-focus anywhere in the row
        // (voice select, level knob, randomness knob) opens it, EXCEPT the
        // Edit button itself (handled above, to avoid a focusin-then-click
        // race that would open-then-instantly-close it) and the lamp.
        if (row) {
          row.addEventListener('click', (event) => {
            if (isEditToggle(event.target) || isStateControl(event.target)) return;
            if (focusOpenDisarmed.has(id)) return;
            openTrackEditor(id, { restoreScroll: true });
          });
          row.addEventListener('focusin', (event) => {
            if (isEditToggle(event.target) || isStateControl(event.target)) return;
            if (focusOpenDisarmed.has(id)) return;
            openTrackEditor(id);
          });
        }
      }

      for (const id of TRACK_IDS) wireTrackEditorToggle(id);

      // Tracks-panel row instance of the Randomness knob (no dice: that lives
      // in the Edit panel header only).
      function wireTrackExtras(id) {
        const box = document.getElementById(`track-extras-${id}`);
        if (!box) return;
        registerExtras(id, buildTrackExtras(box, id));
      }

      for (const id of TRACK_IDS) wireTrackExtras(id);

      // The two busiest generative tracks; the power governor's
      // textureDensityScale is applied to what the engine is SENT for these
      // (see applyPowerBudget), never to the user's stored Level. This is
      // page POLICY, not a registry view — the registry publishes identity
      // and presentation, nothing about how many notes a track spends — so
      // the ids stay named here, filtered against the live list so a track
      // this engine doesn't have can never be scaled.
      const POWER_SCALED_TRACKS = ['texture', 'arp'].filter((id) => TRACK_IDS.includes(id));

      function scaledLevel(track, value) {
        const scale = powerBudget ? powerBudget.textureDensityScale : 1;
        if (scale >= 1 || !POWER_SCALED_TRACKS.includes(track)) return value;
        return mapRV(value, (v) => clamp(v * scale, 0, 1));
      }

      // ---- v8: per-track Level knob (RangeValue: number | {min,max}) -----
      // Lives in the main tracks-panel row (not just the Edit panel), so
      // level is reachable without opening the accordion. Feature-tolerant:
      // always sent, regardless of whether this engine build understands
      // `tracks[track].level` — an older sanitiser just drops the key.
      const levelControls = new Map(); // track -> { set(value) }

      function buildLevelControl(container, track) {
        const commitLevel = (value) => {
          settings.tracks[track].level = value;
          engine.setParams({ tracks: { [track]: { level: scaledLevel(track, value) } } });
          persistSettings();
        };
        const readMid = (v) => (typeof v === 'number' ? v : (v.min + v.max) / 2);
        if (knobApi) {
          try {
            const cell = document.createElement('div');
            cell.className = 'level-knob';
            container.append(cell);
            const handle = knobApi.createKnob(cell, {
              label: 'Level',
              min: 0,
              max: 1,
              value: settings.tracks[track].level,
              format: pctFormat,
            parse: pctParse,
              allowRange: true,
              defaultValue: DEFAULTS.tracks[track].level,
              onInput: commitLevel,
            });
            return {
              set: (v) => {
                try {
                  handle.set?.(v);
                } catch {}
              },
              // v0.0.70: the level dial lives in its own registry rather than
              // in an editor's knob list, so the live-mark feed reaches it by
              // this handle instead of by walking the editors.
              setLive: (v) => {
                try {
                  handle.setLive?.(v);
                } catch {}
              },
            };
          } catch {
            container.innerHTML = '';
          }
        }
        const wrap = document.createElement('label');
        wrap.className = 'level-slider';
        const name = document.createElement('span');
        name.className = 'visually-hidden';
        name.textContent = `${TRACK_LABELS[track]} level`;
        const input = document.createElement('input');
        input.type = 'range';
        input.min = '0';
        input.max = '1';
        input.step = '0.01';
        input.value = String(readMid(settings.tracks[track].level));
        input.addEventListener('input', () => commitLevel(parseFloat(input.value)));
        wrap.append(name, input);
        container.append(wrap);
        return { set: (v) => (input.value = String(readMid(v))), setLive: () => {} };
      }

      function wireTrackLevel(id) {
        const box = document.getElementById(`track-level-${id}`);
        if (box && engineCaps.level[id]) levelControls.set(id, buildLevelControl(box, id));
      }

      for (const id of TRACK_IDS) wireTrackLevel(id);

      /**
       * Everything a track row needs to be a live control, in the order the
       * boot loops do it. THIS is the answer to the pre-mortem's fourth
       * blocker: a runtime row is not wired by a second, parallel set of
       * listeners written to match — it is wired by calling the very functions
       * the build-time rows were wired by.
       */
      function attachTrackRow(id) {
        wireTrackRowControls(id);
        wireTrackEditorToggle(id);
        wireTrackExtras(id);
        wireTrackLevel(id);
      }

      // The build-time six were wired by the loops above; the rows appended for
      // a STORED user track were built before those loops ran, so they went
      // through them too. This is only for rows that appear later.
      // ---- v23 Add Track --------------------------------------------------

      /** What each engine fault code says to the person who caused it. */
      const ADD_TRACK_FAULTS = {
        'bad-label': 'Give the track a name.',
        'bad-id': 'That name has no letters or digits in it.',
        'reserved-id': 'That name is taken by a built-in track.',
        'duplicate-id': 'You already have a track with that name.',
        'bad-family': 'Pick melodic or percussive.',
        'bad-voice-set': 'That kind and that voice set do not go together.',
        'bad-colour-token': 'That colour is not one the theme defines.',
        cap: `Six of your own is the limit — remove one to add another.`,
      };

      let addTrackButton = null;
      let addTrackForm = null;
      let addTrackName = null;
      let addTrackNote = null;
      let addTrackError = null;

      /** Whether there is still room, asked of the engine rather than counted. */
      function addTrackFault(spec) {
        if (!engineCaps.addTrack) return 'cap';
        try {
          return engine.canAddTrack(spec);
        } catch {
          return 'cap';
        }
      }

      function refreshAddTrackControl() {
        if (!addTrackButton) return;
        const full = addTrackFault(undefined) === 'cap';
        addTrackButton.disabled = full;
        // The note is ALWAYS in the document and always occupies its line, so
        // filling it in cannot move the button above it (v18 hardware panel:
        // a control never moves or resizes because its text changed).
        addTrackNote.textContent = full
          ? ADD_TRACK_FAULTS.cap
          : `${USER_TRACK_MAX - USER_TRACKS.length} of your own left.`;
      }

      function setAddTrackFormOpen(open) {
        if (!addTrackForm) return;
        addTrackForm.hidden = !open;
        addTrackButton.setAttribute('aria-expanded', String(open));
        if (open) {
          addTrackError.textContent = '';
          addTrackName.focus();
          addTrackName.select();
        }
      }

      function buildAddTrackControl() {
        // Probe-gated: the control exists ONLY where the engine can both answer
        // "may I" and act on it. Against a build without them the tracks panel
        // is exactly the panel it has always been.
        if (!engineCaps.addTrack || !trackRowsBox || !trackRowsBox.parentElement) return;
        const foot = document.createElement('div');
        foot.className = 'track-add';

        addTrackButton = document.createElement('button');
        addTrackButton.type = 'button';
        addTrackButton.id = 'add-track';
        addTrackButton.className = 'secondary-button track-add-button';
        addTrackButton.textContent = 'Add track';
        addTrackButton.setAttribute('aria-expanded', 'false');
        addTrackButton.setAttribute('aria-controls', 'add-track-form');

        addTrackNote = document.createElement('span');
        addTrackNote.className = 'track-add-note';
        addTrackNote.id = 'add-track-note';
        foot.append(addTrackButton, addTrackNote);

        addTrackForm = document.createElement('form');
        addTrackForm.className = 'track-add-form';
        addTrackForm.id = 'add-track-form';
        addTrackForm.hidden = true;

        const nameLabel = document.createElement('label');
        nameLabel.className = 'track-add-field';
        const nameText = document.createElement('span');
        nameText.textContent = 'Name';
        addTrackName = document.createElement('input');
        addTrackName.type = 'text';
        addTrackName.id = 'add-track-name';
        addTrackName.maxLength = USER_TRACK_LABEL_MAX;
        addTrackName.value = 'My track';
        addTrackName.autocomplete = 'off';
        nameLabel.append(nameText, addTrackName);

        const kinds = document.createElement('div');
        kinds.className = 'track-add-kinds';
        const kindLabel = document.createElement('span');
        kindLabel.className = 'track-add-kind-label';
        kindLabel.textContent = 'Kind';
        kinds.append(kindLabel);
        for (const [value, text, hint] of [
          ['melodic', 'Melodic', 'Plays pitches from the current chord.'],
          ['percussive', 'Percussive', 'Strikes its own kit lanes.'],
        ]) {
          const wrap = document.createElement('label');
          wrap.className = 'track-add-kind';
          const radio = document.createElement('input');
          radio.type = 'radio';
          radio.name = 'add-track-family';
          radio.value = value;
          radio.checked = value === 'melodic';
          const caption = document.createElement('span');
          caption.textContent = text;
          wrap.append(radio, caption);
          describe(wrap, hint);
          kinds.append(wrap);
        }

        const actions = document.createElement('div');
        actions.className = 'track-add-actions';
        const create = document.createElement('button');
        create.type = 'submit';
        create.className = 'secondary-button';
        create.textContent = 'Create';
        const cancel = document.createElement('button');
        cancel.type = 'button';
        cancel.className = 'secondary-button';
        cancel.textContent = 'Cancel';
        actions.append(create, cancel);

        addTrackError = document.createElement('span');
        addTrackError.className = 'track-add-error';
        addTrackError.id = 'add-track-error';
        addTrackError.setAttribute('role', 'status');

        addTrackForm.append(nameLabel, kinds, actions, addTrackError);
        // Both go BELOW the row list, inside the same panel: an insertion below
        // is not a layout shift of anything above it.
        trackRowsBox.after(foot, addTrackForm);

        addTrackButton.addEventListener('click', () => {
          setAddTrackFormOpen(addTrackForm.hidden);
        });
        cancel.addEventListener('click', () => {
          setAddTrackFormOpen(false);
          addTrackButton.focus();
        });
        addTrackForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const family = addTrackForm.querySelector('input[name="add-track-family"]:checked')?.value
            ?? 'melodic';
          const spec = { label: addTrackName.value.trim(), family };
          const fault = addTrackFault(spec);
          if (fault) {
            addTrackError.textContent = ADD_TRACK_FAULTS[fault] || 'That track cannot be added.';
            return;
          }
          let made = null;
          try {
            made = engine.addTrack(spec);
          } catch (err) {
            addTrackError.textContent = ADD_TRACK_FAULTS[err && err.code] || 'That track cannot be added.';
            return;
          }
          setAddTrackFormOpen(false);
          addTrackName.value = 'My track';
          // The row is already in the document — adding a track emits `tracks`,
          // and that is the only thing that builds a row.
          const lamp = made ? document.getElementById(`track-lamp-${made.id}`) : null;
          (lamp || addTrackButton).focus();
        });
        describe(addTrackButton, 'Make a track of your own. It plays a stock voice set and its own step grid.');
        refreshAddTrackControl();
      }

      /**
       * The engine's registry changed — through Add Track, through a Remove,
       * or through a preset that carried tracks of its own. ONE handler for all
       * three: the event is the page's only trigger, so a track that arrives by
       * a route nobody thought of still lands a working row.
       */
      function onRegistryChanged() {
        let params = null;
        try {
          params = engine.getParams();
        } catch {
          return;
        }
        const before = TRACK_IDS.slice();
        settings.userTracks = Array.isArray(params.userTracks)
          ? structuredClone(params.userTracks)
          : [];
        syncTrackViews(settings.userTracks);
        const gone = before.filter((id) => !TRACK_IDS.includes(id));
        const fresh = TRACK_IDS.filter((id) => !before.includes(id));
        for (const id of fresh) {
          // The ENGINE's own entry for the track, not a second guess at it: it
          // has already seeded the opening grid, the level and the state, and a
          // page that invented its own would disagree with what is sounding.
          const entry = USER_TRACK_BY_ID.get(id);
          const base = entry ? defaultUserTrackSettings(entry) : {};
          settings.tracks[id] = isPlainObject(params.tracks?.[id])
            ? deepMerge(base, structuredClone(params.tracks[id]))
            : base;
        }
        // The same repair every load path runs: it drops the orphans a removal
        // leaves behind and settles the new entries' shapes in one pass.
        normaliseV6Tracks(settings);
        for (const id of fresh) probeTrackCaps(id);
        for (const id of gone) removeTrackRow(id);
        for (const entry of USER_TRACKS) buildTrackRow(entry);
        for (const id of fresh) attachTrackRow(id);
        refreshAddTrackControl();
        syncTrackStateUI();
        syncAllTrackExtras();
        for (const id of fresh) {
          levelControls.get(id)?.set(settings.tracks[id].level);
          refreshVoiceSelect(id);
        }
        refreshScopeRegistry();
        updateVisualiserRegistry();
        persistSettings();
      }

      /** The piano roll reads the registry at init; nudge it where it can. */
      function updateVisualiserRegistry() {
        if (!visualiserHandle) return;
        try {
          if (typeof visualiserHandle.refreshTracks === 'function') visualiserHandle.refreshTracks();
        } catch {
          // Decoration. A visualiser that cannot re-read the registry keeps
          // drawing the tracks it knows about, which is not a failure state.
        }
      }

      buildAddTrackControl();
      if (typeof engine.on === 'function') engine.on('tracks', onRegistryChanged);

      // ---- v9/v14 power governor + Processor dial --------------------------
      // The dial reads Eco / Low / Med / Full / Auto; power.js owns the tier
      // budgets and the auto sensing, the page applies the parts of the
      // budget that live up here (live scope on/off, texture/arp density).
      const PROCESSOR_TIERS = ['eco', 'low', 'med', 'full', 'auto'];
      const PROCESSOR_LABELS = ['Eco', 'Low', 'Med', 'Full', 'Auto'];
      const processorReadout = document.getElementById('processor-readout');

      function applyPowerBudget(budget) {
        powerBudget = budget;
        if (processorReadout) {
          const requested = governor ? governor.getTier() : settings.ui.processor;
          const auto = requested === 'auto' ? ` (${budget.tier})` : '';
          processorReadout.textContent =
            `${PROCESSOR_LABELS[PROCESSOR_TIERS.indexOf(requested)] || 'Auto'}${auto}` +
            ` · ${budget.maxNotes === Infinity ? 'no note cap' : `${budget.maxNotes} notes`}` +
            ` · ${budget.visualFps} fps`;
        }
        // scopeEnabled: the page owns the live scope, so this one is applied
        // directly — updateAllScopeModes falls back to the cheap static
        // trace whenever the budget withholds it.
        updateAllScopeModes();
        // textureDensityScale: the engine has no density hook, so this is
        // applied as a LEVEL scale on the two busiest tracks (texture, arp).
        // It trims how present they are at a low tier; it does NOT reduce
        // node count — the real CPU lever is maxNotes, which power.js hands
        // to engine.setPowerBudget() itself. The user's own Level values are
        // never overwritten: only what we send the engine is scaled.
        applyDensityScale();
        // visualFps: visualiser.js grew setFps() (it clamps 1–60 and re-caps
        // its existing timestamp gate, so the reduced-motion 2 fps floor still
        // wins where it applies). Still feature-detected — scope.js has no
        // equivalent yet and self-caps instead.
        try {
          visualiserHandle?.setFps?.(budget.visualFps);
        } catch {}
        // reverbSeconds: the tier's ceiling on IR length. The user's own
        // Reverb tail setting is untouched; only what the engine is sent is
        // capped, so raising the tier restores the full tail.
        applyReverbTail();
      }

      function applyDensityScale() {
        const tracks = {};
        for (const id of POWER_SCALED_TRACKS) {
          if (!engineCaps.level[id]) continue;
          tracks[id] = { level: scaledLevel(id, settings.tracks[id].level) };
        }
        if (Object.keys(tracks).length) engine.setParams({ tracks });
      }

      function setProcessorTier(tier) {
        settings.ui.processor = tier;
        persistSettings();
        if (governor) governor.setTier(tier);
        else if (powerBudget) applyPowerBudget(powerBudget);
      }

      try {
      const { createGovernor } = await import('../scripts/power.js');
        if (typeof createGovernor === 'function') {
          governor = createGovernor({ engine, onTierChange: applyPowerBudget });
        }
      } catch {
        // No governor module: everything below simply never runs.
      }

      if (governor) {
        const tierIndex = Math.max(0, PROCESSOR_TIERS.indexOf(settings.ui.processor));
        processorDial = buildSimpleDial(
          'processor-dial',
          {
            id: 'processor',
            label: 'Processor',
            // v0.0.57 opt-out: five NAMED tiers (Eco, Low, Med, Full, Auto),
            // which makes this an enumeration — and `setProcessorTier` takes
            // one of them, so a span would be silently rounded to whichever
            // end the midpoint landed on. The TODO item asking for a
            // Eco→Full range here is a different feature: it needs the power
            // governor to be the thing that moves the value INSIDE the range,
            // which is a governor change, not a dial change.
            allowRange: false,
            min: 0,
            max: 4,
            step: 1,
            marks: [0, 1, 2, 3, 4],
            value: tierIndex,
            format: (v) => PROCESSOR_LABELS[clamp(Math.round(v), 0, 4)],
            defaultValue: 4,
          },
          (v) => setProcessorTier(PROCESSOR_TIERS[clamp(Math.round(v), 0, 4)])
        );
        describe(
          processorDial.el,
          'How hard the generator may work. Auto watches CPU pressure and frame times and picks for you; Eco is the coolest, Full the busiest.'
        );
        setProcessorTier(settings.ui.processor);
      } else {
        // Label, dial and readout live in the one row now: one removal.
        document.querySelector('.processor-row')?.remove();
      }

      // ---- v13/v18 front-page oscilloscope (above the tabs) ---------------
      // One canvas, one coloured trace per selected track, between the
      // transport strip and the piano roll and persistent across both tabs.
      // scope.js owns the drawing, the colours (--track-<id> read off the
      // canvas), the analyser re-fetch and the fps/IntersectionObserver
      // gating; this block owns WHICH tracks are traced and whether the trace
      // may run at all (governor budget, collapsed panel, engine stopped),
      // plus the persisted panel state.
      //
      // attachMultiScope(canvas, engine, { tracks }) is feature-detected — the
      // page can deploy ahead of the scope.js that exports it, and then the
      // whole module stays hidden rather than showing a dead canvas. So is
      // setTracks(ids): without it, a selection change re-attaches instead.
      //
      // v18 legend: scope.js may own it (opts.legendContainer + the
      // onSelectionChange callback). That is detected by RESULT, not by
      // version — the opts go in on every attach, and if the container comes
      // back empty this block renders its own legend with the same markup,
      // colours and click/double-click gestures. The legend is also the
      // control surface while the trace is detached (stopped, collapsed,
      // budget-paused, or nothing selected), which is exactly when scope.js
      // is not there to draw it, so the fallback is a live path rather than
      // an old-build contingency.
      {
        const scopeModule = document.getElementById('front-scope-module');
        const scopeCanvas = document.getElementById('front-scope');
        const scopeBody = document.getElementById('front-scope-body');
        const scopeLegend = document.getElementById('front-scope-legend');
        const scopeToggle = document.getElementById('front-scope-toggle');
        const scopeWord = document.getElementById('front-scope-word');
        const scopeNote = document.getElementById('front-scope-note');
        const scopeOverlay = document.getElementById('front-scope-overlay');
        const scopeSpreadButton = document.getElementById('front-scope-spread');
        const scopeTotalButton = document.getElementById('front-scope-total');
        const scopeFullscreenButton = document.getElementById('front-scope-fullscreen');
        const available =
          !!scopeModule &&
          !!scopeCanvas &&
          !!scopeApi &&
          typeof scopeApi.attachMultiScope === 'function';

        if (!available) {
          if (scopeModule) scopeModule.hidden = true;
        } else {
          scopeModule.hidden = false;
          let handle = null;
          let attachedKey = '';
          // v26 scope options. Both are HANDLE capabilities the scope module
          // may not have landed yet, so neither button shows until an attach
          // has proved the method is there — a toggle that does nothing is
          // worse than no toggle.
          let spreadSupported = false;
          let totalSupported = false;
          const spreadOn = () => settings.ui.scopeSpread === true;
          const totalOn = () => settings.ui.scopeTotal === true;

          /**
           * The white "total" trace taps the POST-EFFECTS master output. The
           * engine currently publishes per-track analysers only, so this asks
           * getAnalysers() for a master key and then the accessor that would
           * carry one; with neither, the Total toggle never renders.
           *
           * Owed by the engine's next pass: a master/compressor-output
           * analyser, as `getMasterAnalyser()` or a 'master' key on
           * getAnalysers(). Nothing here changes when it lands.
           */
          function masterAnalyser() {
            try {
              const map = typeof engine.getAnalysers === 'function' ? engine.getAnalysers() : null;
              if (map) {
                for (const key of ['master', 'total', 'output']) {
                  if (map[key]) return map[key];
                }
              }
            } catch {}
            try {
              const node = engine.getMasterAnalyser?.();
              if (node) return node;
            } catch {}
            return null;
          }

          const applyScopeOptions = () => {
            if (!handle) return;
            try {
              handle.setSpread?.(spreadOn());
            } catch {}
            try {
              handle.setTotalVisible?.(totalSupported && totalOn());
            } catch {}
          };

          const syncScopeOptions = () => {
            const open = settings.ui.scopeOpen !== false;
            if (scopeSpreadButton) {
              scopeSpreadButton.hidden = !spreadSupported || !open;
              scopeSpreadButton.setAttribute('aria-pressed', String(spreadOn()));
            }
            if (scopeTotalButton) {
              scopeTotalButton.hidden = !totalSupported || !open;
              scopeTotalButton.setAttribute('aria-pressed', String(totalOn()));
            }
            if (scopeFullscreenButton && !scopeFullscreenButton.dataset.unsupported) {
              scopeFullscreenButton.hidden = !open;
            }
          };

          /**
           * The overlay sits ON the display. Where the scope module can say how
           * much of its own top edge it draws into (getLayout), the overlay is
           * pushed clear of it rather than guessing; an older module reports
           * nothing and the overlay stays flush with the top.
           */
          const applyOverlayLayout = () => {
            if (!scopeOverlay) return;
            let top = 0;
            try {
              const layout =
                handle && typeof handle.getLayout === 'function' ? handle.getLayout() : null;
              const reported = layout ? (layout.insetTop ?? layout.padTop ?? layout.top) : null;
              if (Number.isFinite(reported) && reported > 0) top = reported;
            } catch {}
            scopeOverlay.style.top = top ? `${Math.round(top)}px` : '';
          };

          if (scopeSpreadButton) {
            scopeSpreadButton.addEventListener('click', () => {
              settings.ui.scopeSpread = !spreadOn();
              persistSettings();
              applyScopeOptions();
              syncScopeOptions();
            });
            describe(
              scopeSpreadButton,
              'Spread traces vertically — each track gets its own flat line to wobble on, stacked up the display.'
            );
          }
          if (scopeTotalButton) {
            const toggleTotal = () => {
              settings.ui.scopeTotal = !totalOn();
              persistSettings();
              applyScopeOptions();
              syncScopeOptions();
              // v0.0.36: with no track traces selected, turning Total on or off
              // changes whether there is anything to attach at all, so the
              // attachment itself has to be reconsidered — not just the setter.
              updateFrontScope();
            };
            // Same click/dblclick discipline as the track legend entries: the
            // toggle waits out the double-click window so a solo never
            // flickers through a toggled state first.
            scopeTotalButton.addEventListener('click', () => {
              if (pendingClickTimer !== null && pendingClickId === 'total') {
                clearPendingClick();
                return;
              }
              clearPendingClick();
              pendingClickId = 'total';
              pendingClickTimer = setTimeout(() => {
                pendingClickTimer = null;
                pendingClickId = null;
                toggleTotal();
              }, LEGEND_CLICK_DELAY_MS);
            });
            // v0.0.49: double-click shows the mix alone — every track trace
            // off, Total on — mirroring double-click-to-solo on a track.
            scopeTotalButton.addEventListener('dblclick', () => {
              clearPendingClick();
              if (!totalOn()) {
                settings.ui.scopeTotal = true;
                persistSettings();
              }
              applySelection([]);
              applyScopeOptions();
              syncScopeOptions();
            });
            describe(scopeTotalButton, 'Add a white trace of the finished mix, effects and all. Double-click to show only the mix.');
          }
          // Set while a legend gesture is being applied, so the persist +
          // re-render it triggers can never be mistaken for a fresh gesture.
          let applyingSelection = false;
          const LEGEND_CLICK_DELAY_MS = 250;
          let pendingClickTimer = null;
          let pendingClickId = null;

          const selectedTracks = () => {
            const stored = settings.ui.scopeTracks;
            if (Array.isArray(stored)) return TRACK_IDS.filter((id) => stored.includes(id));
            // The live default: every track that isn't switched off.
            return TRACK_IDS.filter((id) => settings.tracks[id].state !== 'off');
          };

          const applySelection = (ids) => {
            if (applyingSelection) return;
            applyingSelection = true;
            try {
              settings.ui.scopeTracks = TRACK_IDS.filter((id) => ids.includes(id));
              persistSettings();
              updateFrontScope();
            } finally {
              applyingSelection = false;
            }
          };

          const detach = () => {
            if (!handle) return;
            try {
              handle.destroy?.();
            } catch {}
            handle = null;
            attachedKey = '';
          };

          // -- the page's own legend (scope.js's is preferred; see above) --
          const legendButtons = new Map();

          const clearPendingClick = () => {
            if (pendingClickTimer !== null) clearTimeout(pendingClickTimer);
            pendingClickTimer = null;
            pendingClickId = null;
          };

          const toggleTrack = (id) => {
            const current = selectedTracks();
            applySelection(current.includes(id) ? current.filter((t) => t !== id) : [...current, id]);
          };

          function buildPageLegend() {
            clearPendingClick();
            legendButtons.clear();
            scopeLegend.textContent = '';
            for (const id of TRACK_IDS) {
              const button = document.createElement('button');
              button.type = 'button';
              button.className = `scope-legend-track ${trackColourClass(id)}`;
              const dot = document.createElement('span');
              dot.className = 'scope-legend-dot';
              dot.setAttribute('aria-hidden', 'true');
              const label = document.createElement('span');
              label.className = 'scope-legend-label';
              label.textContent = TRACK_LABELS[id];
              button.append(dot, label);
              // A single click toggles, a double click solos: the toggle waits
              // out the double-click window so a solo never flickers through
              // an off state first.
              button.addEventListener('click', () => {
                if (pendingClickTimer !== null && pendingClickId === id) {
                  clearPendingClick();
                  return;
                }
                clearPendingClick();
                pendingClickId = id;
                pendingClickTimer = setTimeout(() => {
                  pendingClickTimer = null;
                  pendingClickId = null;
                  toggleTrack(id);
                }, LEGEND_CLICK_DELAY_MS);
              });
              button.addEventListener('dblclick', () => {
                clearPendingClick();
                applySelection([id]);
              });
              describe(button, `Show ${TRACK_LABELS[id]} on the oscilloscope. Double-click to solo it.`);
              legendButtons.set(id, button);
              scopeLegend.append(button);
            }
          }

          /**
           * v0.0.36 tri-state, matching the piano roll's lamp rather than the
           * old two-state opacity:
           *   shown   — trace selected, in the track's own colour
           *   sounding— selected AND playing right now, white
           *   hidden  — playing but its trace is switched off, drawn as a bar
           * `aria-pressed` still carries the selected/not truth for AT; the
           * data-state is purely what the eye reads.
           */
          const syncPageLegend = (ids) => {
            for (const [id, button] of legendButtons) {
              const selected = ids.includes(id);
              button.setAttribute('aria-pressed', String(selected));
              const playing = engine.running && settings.tracks[id]?.state !== 'off';
              button.dataset.state = selected
                ? (playing ? 'sounding' : 'shown')
                : (playing ? 'hidden' : 'shown');
            }
          };

          /** scope.js empties the container on destroy, so this re-checks every pass. */
          const ensureLegend = (ids) => {
            if (scopeLegend.querySelector('.scope-legend-track:not([data-page-legend])')) {
              // scope.js's own legend is in place and syncs itself.
              legendButtons.clear();
              return;
            }
            if (!legendButtons.size || !scopeLegend.firstElementChild) {
              buildPageLegend();
              for (const button of legendButtons.values()) button.dataset.pageLegend = '';
            }
            syncPageLegend(ids);
          };

          scopeToggle.addEventListener('click', () => {
            settings.ui.scopeOpen = !settings.ui.scopeOpen;
            persistSettings();
            updateFrontScope();
          });
          describe(scopeToggle, 'Show or hide the oscilloscope.');

          updateFrontScope = function updateFrontScopeImpl() {
            const open = settings.ui.scopeOpen !== false;
            scopeBody.hidden = !open;
            scopeToggle.setAttribute('aria-expanded', String(open));
            // Collapsed is the one state that shows the module's name — and
            // the one state where the overlay drops back into the flow,
            // because there is no display left underneath it.
            if (scopeWord) scopeWord.hidden = open;
            scopeModule.classList.toggle('scope-collapsed', !open);
            syncScopeOptions();
            const ids = selectedTracks();

            const allowed = powerBudget ? powerBudget.scopeEnabled !== false : true;
            // v0.0.36: the total trace is an analyser of the finished mix and
            // owes nothing to any track, but this guard used to bail out
            // whenever no TRACK trace was selected — so Total only came alive
            // once some other trace was turned on, which is the bug the owner
            // hit. An empty track list is a legitimate attach when the total is
            // what the listener asked for; scope.js's normaliseTracks already
            // accepts `[]` and simply draws no per-track traces.
            const totalOnly = !ids.length && totalOn();
            if (!allowed || !open || (!ids.length && !totalOnly)) {
              detach();
              scopeNote.textContent = !allowed
                ? 'paused — Processor tier'
                : !ids.length
                  ? 'no tracks selected'
                  : '';
              ensureLegend(ids);
              return;
            }
            if (!engine.running) {
              // v19 roadmap "Offline waveform rule": stopped shows a
              // composite static preview of every selected track's current
              // patch, overlaid on the shared graticule, rather than the
              // blank/detached canvas this used to leave behind.
              // Owner ruling (fromMartin 22, supersedes the v19 stopped-state
              // composite here): the front scope stays DARK until Play — the
              // live trace is kept as a surprise. Editor scopes keep their
              // static previews; only this front composite is retired.
              detach();
              try {
                const c2d = scopeCanvas.getContext('2d');
                c2d && c2d.clearRect(0, 0, scopeCanvas.width, scopeCanvas.height);
              } catch { /* cosmetic */ }
              scopeNote.textContent = 'press Play';
              ensureLegend(ids);
              return;
            }
            scopeNote.textContent = '';

            const key = `${ids.join(',')}|${totalOn() ? 'T' : ''}`;
            if (handle && key === attachedKey) {
              ensureLegend(ids);
              return;
            }
            if (handle && typeof handle.setTracks === 'function') {
              try {
                handle.setTracks(ids);
                attachedKey = key;
                ensureLegend(ids);
                return;
              } catch {
                // fall through to a clean re-attach
              }
            }
            detach();
            const total = masterAnalyser();
            try {
              handle = scopeApi.attachMultiScope(scopeCanvas, engine, {
                tracks: ids,
                legendContainer: scopeLegend,
                onSelectionChange: (next) => {
                  if (Array.isArray(next)) applySelection(next);
                },
                // v26 options. A scope build that predates them ignores the
                // extra keys; the setters below are what actually prove it
                // can honour either one.
                spread: spreadOn(),
                totalVisible: totalOn(),
                ...(total ? { totalAnalyser: total } : {}),
              });
            } catch {
              handle = null;
            }
            if (handle) {
              attachedKey = key;
              spreadSupported = typeof handle.setSpread === 'function';
              totalSupported = typeof handle.setTotalVisible === 'function' && !!total;
              applyScopeOptions();
              applyOverlayLayout();
            } else {
              scopeNote.textContent = 'unavailable';
            }
            syncScopeOptions();
            ensureLegend(ids);
          };

          // The registry changed under a live trace: drop the attachment and
          // the legend outright and let the pass above rebuild both. Anything
          // cheaper leaves the scope tracing a list that no longer exists.
          refreshScopeRegistry = function refreshScopeRegistryImpl() {
            detach();
            legendButtons.clear();
            scopeLegend.textContent = '';
            updateFrontScope();
          };
        }
      }

      // ---- v26 fullscreen for the two displays ---------------------------
      // Both the oscilloscope and the piano roll carry a ⛶. Whichever one is
      // pressed goes fullscreen alone, and a "+ the other" control then
      // stacks the second below it. The modules are MOVED into the fullscreen
      // host and put back on exit rather than duplicated, so each keeps its
      // canvas bitmap, its listeners and its live handle; both redraw at the
      // new size (and dpr) off their own ResizeObserver. Esc, the browser's
      // own exit affordance and the Exit button all land in one place.
      {
        const stage = document.getElementById('fullscreen-stage');
        const slots = document.getElementById('fullscreen-slots');
        const addButton = document.getElementById('fullscreen-add');
        const exitButton = document.getElementById('fullscreen-exit');
        const bar = document.getElementById('fullscreen-bar');
        const menuButton = document.getElementById('fullscreen-menu');
        const DISPLAYS = [
          {
            id: 'scope',
            label: 'oscilloscope',
            el: document.getElementById('front-scope-module'),
            button: document.getElementById('front-scope-fullscreen'),
          },
          {
            id: 'roll',
            label: 'piano roll',
            el: document.getElementById('roll-stage'),
            button: document.getElementById('roll-fullscreen'),
          },
        ].filter((display) => display.el && display.button);

        // v0.0.36: the native Fullscreen API is now preferred, not required.
        // iPhone Safari implements neither requestFullscreen nor
        // exitFullscreen, so the old gate hid both ⛶ buttons on the device the
        // owner most wanted to maximise on. Where the API is absent the stage
        // is pinned over the viewport by CSS instead — the same result to the
        // eye, minus the browser chrome the API would have hidden.
        const nativeFullscreen =
          typeof stage?.requestFullscreen === 'function' &&
          typeof document.exitFullscreen === 'function';

        const supported = !!stage && !!slots && !!addButton && !!exitButton;

        if (!supported) {
          for (const display of DISPLAYS) {
            display.button.hidden = true;
            display.button.dataset.unsupported = '';
          }
        } else {
          // A comment node marks where each borrowed module came from, so the
          // order they were taken in cannot affect where they go back.
          const markers = new Map();
          let shown = [];

          const moveIn = (display) => {
            if (shown.includes(display.id) || !display.el.parentNode) return;
            const marker = document.createComment(`fullscreen:${display.id}`);
            display.el.parentNode.insertBefore(marker, display.el);
            markers.set(display.id, marker);
            slots.append(display.el);
            shown.push(display.id);
          };

          const restoreAll = () => {
            for (const [id, marker] of markers) {
              const display = DISPLAYS.find((entry) => entry.id === id);
              if (display && marker.parentNode) marker.parentNode.replaceChild(display.el, marker);
            }
            markers.clear();
            shown = [];
          };

          const missingDisplay = () => DISPLAYS.find((display) => !shown.includes(display.id));

          /** Maximised right now, by whichever mechanism this browser has. */
          const isActive = () =>
            nativeFullscreen
              ? document.fullscreenElement === stage
              : stage.dataset.pseudo !== undefined;

          const enterFullscreen = () => {
            if (nativeFullscreen) return Promise.resolve(stage.requestFullscreen());
            stage.dataset.pseudo = '';
            document.documentElement.dataset.pseudoFullscreen = '';
            onFullscreenChange();
            return Promise.resolve();
          };

          const exitFullscreen = () => {
            if (nativeFullscreen) return Promise.resolve(document.exitFullscreen());
            delete stage.dataset.pseudo;
            delete document.documentElement.dataset.pseudoFullscreen;
            onFullscreenChange();
            return Promise.resolve();
          };

          const syncChrome = () => {
            const active = isActive();
            stage.hidden = !active;
            const missing = missingDisplay();
            addButton.hidden = !active || !missing;
            if (missing) addButton.textContent = `+ ${missing.label}`;
            for (const display of DISPLAYS) {
              display.button.setAttribute('aria-pressed', String(active && shown[0] === display.id));
            }
          };

          for (const display of DISPLAYS) {
            display.button.addEventListener('click', () => {
              if (isActive()) {
                exitFullscreen().catch(() => {});
                return;
              }
              stage.hidden = false;
              moveIn(display);
              syncChrome();
              enterFullscreen().catch(() => {
                restoreAll();
                syncChrome();
              });
            });
            describe(display.button, `Show the ${display.label} full screen.`);
          }

          addButton.addEventListener('click', () => {
            const missing = missingDisplay();
            if (missing) moveIn(missing);
            syncChrome();
            armMenuCollapse();
          });
          exitButton.addEventListener('click', () => {
            exitFullscreen().catch(() => {});
          });

          // v27 owner request: the menu slides out to a subtle ☰ in the top
          // right. It shows on entry (so Exit and "+ the other" are seen to
          // exist), glides away after a beat, and ☰ brings it back — the bar
          // overlays the displays, so nothing resizes either way.
          const MENU_LINGER_MS = 2600;
          let menuTimer = null;
          // v0.0.59: the borrowed modules' own chrome hides and shows with the
          // bar. One flag on the host drives both, so there is no second timer
          // to fall out of step with this one.
          const collapseMenu = () => {
            if (bar) bar.dataset.collapsed = '';
            if (stage) stage.dataset.chromeHidden = '';
            menuButton?.setAttribute('aria-expanded', 'false');
          };
          const revealMenu = () => {
            if (bar) delete bar.dataset.collapsed;
            if (stage) delete stage.dataset.chromeHidden;
            menuButton?.setAttribute('aria-expanded', 'true');
          };
          const armMenuCollapse = () => {
            clearTimeout(menuTimer);
            menuTimer = setTimeout(collapseMenu, MENU_LINGER_MS);
          };
          menuButton?.addEventListener('click', () => {
            if (bar && bar.dataset.collapsed !== undefined) {
              revealMenu();
              armMenuCollapse();
            } else {
              clearTimeout(menuTimer);
              collapseMenu();
            }
          });
          bar?.addEventListener('pointerenter', () => clearTimeout(menuTimer));
          bar?.addEventListener('pointerleave', armMenuCollapse);

          function onFullscreenChange() {
            if (!isActive()) {
              restoreAll();
              clearTimeout(menuTimer);
              revealMenu(); // reset for the next entry
            } else {
              revealMenu();
              armMenuCollapse();
            }
            syncChrome();
          }

          document.addEventListener('fullscreenchange', onFullscreenChange);

          // The native API gives Escape for free; the pinned fallback has to
          // provide it, or the only way out would be the Exit button — which
          // the menu hides after a couple of seconds.
          if (!nativeFullscreen) {
            document.addEventListener('keydown', (event) => {
              if (event.key === 'Escape' && isActive()) {
                event.preventDefault();
                exitFullscreen().catch(() => {});
              }
            });
          }
          syncChrome();
        }
      }

      // ---- v14 sequencer playhead ----------------------------------------
      // The sounding step lights white. One 'bar' event schedules that bar's
      // step changes as plain timeouts (≤20 per bar, and only while an editor
      // with a grid is open) — a DOM class swap at step rate, never a rAF
      // loop and nothing at all while the grids are closed.
      let playheadTimers = [];

      function clearPlayheadTimers() {
        for (const timer of playheadTimers) clearTimeout(timer);
        playheadTimers = [];
      }

      function clearPlayhead() {
        clearPlayheadTimers();
        for (const ed of openEditors.values()) ed.seq?.setPlayhead(-1);
      }

      // The last barline the engine announced, which is the origin every note
      // time is measured from when placing it on a grid.
      let lastBarTime = 0;
      let lastBarIndex = 0;
      let currentBeatsPerBar = 4;

      function schedulePlayhead(barTime, beatsPerBar) {
        lastBarTime = barTime;
        lastBarIndex += 1;
        currentBeatsPerBar = beatsPerBar || 4;
        clearPlayheadTimers();
        // AUDIT FIX: the playhead timed its sweep from a 40–120 clamp that
        // predates the 20–220 tempo range (desyncing above 120), and read
        // settings.bpm raw — a spread tempo is a {min,max} object, clamp()
        // of which is NaN, so every step timer fired at once. The ENGINE's
        // own number (always plain; spans live under params.spans) is the
        // truth the bars are actually scheduled with.
        const live = (() => {
          try {
            return engine.getParams();
          } catch {
            return null;
          }
        })();
        const liveBpm = clamp((live?.bpm ?? rangeMid(settings.bpm)) * (live?.speed ?? 1), 10, 400);
        const barSeconds = (beatsPerBar || 4) * (60 / liveBpm);
        for (const [track, ed] of openEditors) {
          if (!ed.seq) continue;
          const n = stepsPerBarFor(track);
          const stepSeconds = barSeconds / n;
          for (let i = 0; i < n; i++) {
            const delayMs = (barTime + i * stepSeconds - engine.now()) * 1000;
            if (delayMs < -stepSeconds * 1000) continue; // already past
            playheadTimers.push(
              setTimeout(() => {
                try {
                  ed.seq?.setPlayhead(i);
                } catch {}
              }, Math.max(0, delayMs))
            );
          }
        }
      }

      // ---- v9 per-track cost meters --------------------------------------
      // A thin bar in each row, tinted by that track's own colour, fed from
      // engine.getStats() at 1 Hz while running (and once on stop, to empty
      // them). Nothing polls while the engine is idle.
      const COST_METER_FULL = 12; // active notes that read as a full bar
      let costTimer = null;

      function updateCostMeters() {
        let stats = null;
        try {
          stats = engine.getStats();
        } catch {}
        const perTrack = stats && isPlainObject(stats.perTrack) ? stats.perTrack : null;
        for (const id of TRACK_IDS) {
          const meter = document.getElementById(`cost-meter-${id}`);
          if (!meter) continue;
          const entry = perTrack ? perTrack[id] : null;
          const share = entry ? clamp(entry.activeNotes / COST_METER_FULL, 0, 1) : 0;
          meter.hidden = !perTrack;
          meter.firstElementChild.style.width = `${Math.round(share * 100)}%`;
          meter.setAttribute(
            'aria-label',
            `${TRACK_LABELS[id]} load: ${entry ? entry.activeNotes : 0} notes sounding`
          );
        }
      }

      function setCostPolling(on) {
        if (!engineCaps.getStats) return;
        if (on) {
          if (costTimer === null) costTimer = setInterval(updateCostMeters, 1000);
          updateCostMeters();
        } else if (costTimer !== null) {
          clearInterval(costTimer);
          costTimer = null;
          updateCostMeters();
        }
      }

      // ---- v14 live readouts (resolved / drifting values) -----------------
      // engine.getResolved() reports what is ACTUALLY being played right now:
      // every RangeValue resolved through its walk, and the voice that is
      // really sounding (voice wander included). Polled at 4 Hz while
      // running; the numbers land as secondary text beside the row's dials,
      // and a wander to a different voice re-renders the open editor so the
      // dial set follows the voice you can hear.
      let resolvedTimer = null;

      /**
       * v0.0.56: the live mark on any global dial the user has spread. The
       * engine reports only the spread ones (`resolved.globals`), so a dial
       * that is not drifting is told `null` and hides its mark — the main
       * pointer already says everything there is to say about a still value.
       *
       * Each entry maps the ENGINE's units back into the DIAL's, which is not
       * always the identity: Tempo and Energy are log maps over bpm and Volume
       * is tapered, so feeding the raw param straight in would put the mark in
       * the wrong place on exactly the dials most worth watching.
       */
      function applyResolvedGlobals(globals) {
        const g = isPlainObject(globals) ? globals : {};
        const at = (key, map) => (typeof g[key] === 'number' ? map(g[key]) : null);
        speedDial?.setLive?.(at('bpm', speedTFromBpm));
        simpleSpeedDial?.setLive?.(at('bpm', speedTFromBpm));
        energyDial?.setLive?.(at('complexity', energyFromComplexity));
        complexityDial?.setLive?.(at('complexity', (v) => v));
        repetitionDial?.setLive?.(at('repetition', (v) => v));
        volumeDial?.setLive?.(at('volume', volumeDialFromParam));
        swingDial?.setLive?.(at('swing', (v) => v));
        reverbTailDial?.setLive?.(at('reverbTail', (v) => v));
      }

      /**
       * v0.0.70: the live mark on the PER-TRACK dials too.
       *
       * His ask was "more importantly can it be applied to every dial", and
       * v0.0.56 fed only the seven globals — so a spread level or randomness on
       * a track showed two ends and no indication of where between them the
       * engine actually was. `getResolved().tracks` has carried exactly that
       * number since v14; nothing was reading it for this.
       */
      function applyResolvedTracks(tracks) {
        if (!isPlainObject(tracks)) return;
        for (const [id, control] of levelControls) {
          const live = tracks[id];
          control?.setLive?.(live && typeof live.level === 'number' ? live.level : null);
        }
        for (const [id, ed] of openEditors) {
          const live = tracks[id];
          if (!live || !ed || !Array.isArray(ed.knobs)) continue;
          for (const handle of ed.knobs) {
            if (!handle || typeof handle.setLive !== 'function') continue;
            const field = handle.liveField;
            if (!field) continue;
            const value = live[field];
            handle.setLive(typeof value === 'number' ? value : null);
          }
        }
      }

      function applyResolved(resolved) {
        applyResolvedGlobals(resolved && resolved.globals);
        applyResolvedTracks(resolved && resolved.tracks);
        const tracks = resolved && isPlainObject(resolved.tracks) ? resolved.tracks : null;
        for (const id of TRACK_IDS) {
          const readout = document.getElementById(`resolved-${id}`);
          if (!readout) continue;
          const entry = tracks ? tracks[id] : null;
          if (!entry) {
            readout.textContent = '';
            continue;
          }
          const bits = [`level ${pctFormat(entry.level ?? 0)}`];
          bits.push(entry.held ? 'held' : `random ${pctFormat(entry.randomness ?? 0)}`);
          // Iteration 4: swing/density resolved values, feature-detected on
          // the live payload itself — this engine may report them on some
          // tracks and not others (swing on the pulsed ones, density on the
          // tuned ones), exactly like `dissonance` above already does.
          if (typeof entry.swing === 'number') bits.push(`swing ${pctFormat(entry.swing)}`);
          if (typeof entry.density === 'number') bits.push(`density ${plainFormat(entry.density)}×`);
          readout.textContent = bits.join(' · ');
        }
        // v18: the row's <select> follows the SOUNDING voice too (through its
        // display-only first option — the stored choice is never overwritten).
        // Only a CHANGE redraws it: this runs at 4 Hz.
        for (const id of TRACK_IDS) {
          const entry = tracks ? tracks[id] : null;
          const voice = entry && typeof entry.voice === 'string' ? entry.voice : null;
          if (!voice || soundingVoice.get(id) === voice) continue;
          soundingVoice.set(id, voice);
          refreshVoiceSelect(id);
        }
        // The editor follows the SOUNDING voice as well: its header says what
        // is actually sounding, and the dial set re-renders when that changes.
        // Snapshot the entries: a wander re-render replaces this track's
        // openEditors entry mid-loop, which a live Map iteration would trip
        // over.
        for (const [track, ed] of Array.from(openEditors)) {
          const entry = tracks ? tracks[track] : null;
          const voice = entry ? entry.voice : null;
          if (!voice || !ed.sounding) continue;
          const chosen = settings.tracks[track].voice;
          ed.sounding.hidden = voice === chosen;
          ed.sounding.textContent = voice === chosen ? '' : `sounding: ${voiceLabel(track, voice)}`;
          if (voice !== ed.voiceId) renderVoiceEditor(track, { voiceId: voice });
        }
      }

      function setResolvedPolling(on) {
        if (!engineCaps.getResolved) return;
        if (on) {
          if (resolvedTimer === null) {
            resolvedTimer = setInterval(() => {
              try {
                applyResolved(engine.getResolved());
              } catch {}
            }, 250);
          }
        } else if (resolvedTimer !== null) {
          clearInterval(resolvedTimer);
          resolvedTimer = null;
        }
      }

      function voiceLabel(track, voiceId) {
        const found = VOICE_LABELS[voiceSetOf(track)]?.[voiceId];
        return found || voiceId;
      }

      /** A voice's synthesis class, when engine-voices exports one (v18). */
      function voiceEngineType(track, voiceId) {
        const entry = voicesTable?.[voiceSetOf(track)]?.[voiceId];
        const type = entry && typeof entry.engineType === 'string' ? entry.engineType.trim() : '';
        return type ? type[0].toUpperCase() + type.slice(1) : null;
      }

      /** Shape-normalised copy, so an osc1/shape1 spelling never reads as an edit. */
      function normalisedPatch(patch) {
        const copy = structuredClone(patch);
        if (!isPlainObject(copy.source)) copy.source = {};
        writeShape(copy.source, 1, readShape(copy.source, 1) ?? 0);
        writeShape(copy.source, 2, readShape(copy.source, 2));
        return copy;
      }

      /** Does the stored patch for this voice differ from the voice's own defaults? */
      function patchIsEdited(track, voiceId) {
        const stored = (settings.patches[track] || {})[voiceId];
        if (!isPlainObject(stored)) return false;
        const entry = voicesTable?.[voiceSetOf(track)]?.[voiceId];
        const base = normalisedPatch(deepMerge(FALLBACK_PATCH, (entry && entry.defaults) || {}));
        const live = normalisedPatch(deepMerge(base, stored));
        if (isPlainObject(live.perKind) && Object.keys(live.perKind).length) return true;
        for (const section of PATCH_SECTIONS) {
          const from = isPlainObject(base[section]) ? base[section] : {};
          const to = isPlainObject(live[section]) ? live[section] : {};
          for (const field of new Set([...Object.keys(from), ...Object.keys(to)])) {
            if (JSON.stringify(from[field]) !== JSON.stringify(to[field])) return true;
          }
        }
        return false;
      }

      /**
       * v18: the row's <select> shows what you are HEARING — the sounding
       * voice once wander has moved it, and "Custom (Subtractive)" when that
       * voice's patch has been edited away from its defaults. Both are a
       * dynamic, disabled first option: settings.tracks[t].voice keeps the
       * user's own selection untouched whatever the engine is doing, and the
       * option disappears again the moment the two agree. Called on wander
       * (applyResolved) and on every patch commit, never on a timer.
       */
      function refreshVoiceSelect(track) {
        const select = document.getElementById(`track-voice-${track}`);
        if (!select || !settings.tracks[track]) return;
        const chosen = settings.tracks[track].voice;
        const sounding = soundingVoice.get(track) || chosen;
        const edited = patchIsEdited(track, sounding);
        let live = select.querySelector('.voice-live-option');
        if (!edited && sounding === chosen) {
          if (live) live.remove();
          select.value = chosen;
          return;
        }
        if (!live) {
          live = document.createElement('option');
          live.className = 'voice-live-option';
          live.value = VOICE_LIVE_VALUE;
          live.disabled = true;
          select.prepend(live);
        }
        const engineType = edited ? voiceEngineType(track, sounding) : null;
        // v0.0.100 (his item 91): a pure wander SAYS it is one. He read
        // "Texture: Call" in Synthwave as a setting, because the sounding
        // voice was labelled exactly like a chosen one — the generator's
        // gentle anti-monotony wander was indistinguishable from his own
        // choice. The label now carries the state, and the title carries the
        // escape hatch.
        const wandering = !edited && sounding !== chosen;
        const text = edited
          ? engineType
            ? `Custom (${engineType})`
            : 'Custom'
          : wandering
            ? `${voiceLabel(track, sounding)} · wandering`
            : voiceLabel(track, sounding);
        live.title = wandering
          ? 'The generator wandered onto this voice for variety — your own choice is unchanged, and picking any voice ends the wander at once.'
          : '';
        if (live.textContent !== text) live.textContent = text;
        live.selected = true;
      }

      // ---- structure + custom structure builder -------------------------

      // v0.0.57: the ⓘ beside Structure, and the one beside the link name.
      {
        const slot = document.getElementById('structure-info');
        if (slot) infoButton(slot, 'Structure', STRUCTURE_INFO);
      }
      {
        const slot = document.getElementById('share-name-info');
        if (slot) infoButton(slot, 'the link name', SHARE_NAME_INFO);
      }
      {
        const slot = document.getElementById('submit-terms-info');
        if (slot) infoButton(slot, 'submitting a preset', SUBMIT_TERMS);
      }

      const customBuilder = document.getElementById('custom-structure-builder');
      const structureBlocks = document.getElementById('structure-blocks');
      const addBlockButton = document.getElementById('add-structure-block');
      // AUDIT FIX (cleanup): the ENGINE's own list, not a second copy of it —
      // the engine sanitises a block label against STRUCTURE_LABELS, so a
      // page-side copy that drifted would offer a label the engine drops (the
      // v21 track-registry lesson, applied to structure labels). The literal
      // is kept as the fallback an older engine bundle boots on.
      const blockLabels = Array.isArray(engineModule?.STRUCTURE_LABELS)
        ? [...engineModule.STRUCTURE_LABELS]
        : ['A', 'B', 'C', 'D', 'V', 'V1', 'V2', 'V3', 'V4'];

      function renderStructureBlocks() {
        structureBlocks.innerHTML = '';
        settings.customStructure.forEach((block, index) => {
          const row = document.createElement('div');
          row.className = 'structure-block';

          const labelSelect = document.createElement('select');
          labelSelect.setAttribute('aria-label', `Block ${index + 1} label`);
          for (const l of blockLabels) {
            const opt = document.createElement('option');
            opt.value = l;
            opt.textContent = `Section ${l}`;
            if (l === block.label) opt.selected = true;
            labelSelect.append(opt);
          }
          labelSelect.addEventListener('change', () => {
            settings.customStructure[index].label = labelSelect.value;
            commitCustomStructure();
          });

          // v0.0.97: the optional title — B can double as "bridge", C as
          // "chorus". Shown on the roll's section strip in place of the
          // letter when present.
          const titleInput = document.createElement('input');
          titleInput.type = 'text';
          titleInput.maxLength = 24;
          titleInput.placeholder = 'title';
          titleInput.className = 'block-title';
          titleInput.value = typeof block.title === 'string' ? block.title : '';
          titleInput.setAttribute('aria-label', `Block ${index + 1} title`);
          titleInput.addEventListener('change', () => {
            const t = titleInput.value.trim().slice(0, 24);
            if (t) settings.customStructure[index].title = t;
            else delete settings.customStructure[index].title;
            commitCustomStructure();
          });

          // v0.0.57: visible labels. Both inputs carried an aria-label and
          // nothing a sighted user could read, and the owner's report was
          // exactly that — he could not identify them. The full-width slider
          // immediately above this panel is BPM and unrelated, which is what
          // made an unlabelled range control here actively misleading.
          const barsWrap = document.createElement('label');
          barsWrap.className = 'block-field';
          const barsName = document.createElement('span');
          barsName.className = 'block-field-name';
          barsName.textContent = 'bars';

          const barsInput = document.createElement('input');
          barsInput.type = 'number';
          barsInput.min = '1';
          barsInput.max = '32';
          barsInput.value = String(block.bars);
          barsInput.setAttribute('aria-label', `Block ${index + 1} bars`);
          barsInput.addEventListener('input', () => {
            const parsed = parseInt(barsInput.value, 10);
            if (!Number.isFinite(parsed)) return; // mid-edit blank; keep stored value
            const bars = Math.round(clamp(parsed, 1, 32));
            settings.customStructure[index].bars = bars;
            // Reflect the clamp so UI, stored state and engine can't diverge.
            if (barsInput.value !== String(bars)) barsInput.value = String(bars);
            commitCustomStructure();
          });

          const intensityWrap = document.createElement('label');
          intensityWrap.className = 'block-field block-field-wide';
          const intensityName = document.createElement('span');
          intensityName.className = 'block-field-name';
          intensityName.textContent = 'intensity';
          const intensityOut = document.createElement('span');
          intensityOut.className = 'block-field-value';

          const intensityInput = document.createElement('input');
          intensityInput.type = 'range';
          intensityInput.min = '0';
          intensityInput.max = '1';
          intensityInput.step = '0.01';
          intensityInput.value = String(block.intensity);
          intensityInput.setAttribute('aria-label', `Block ${index + 1} intensity`);
          const showIntensity = () => {
            intensityOut.textContent = pctFormat(parseFloat(intensityInput.value));
          };
          showIntensity();
          intensityInput.addEventListener('input', () => {
            settings.customStructure[index].intensity = parseFloat(intensityInput.value);
            showIntensity();
            commitCustomStructure();
          });

          const upButton = document.createElement('button');
          upButton.type = 'button';
          upButton.className = 'block-move';
          upButton.textContent = '↑';
          upButton.setAttribute('aria-label', `Move block ${index + 1} up`);
          upButton.disabled = index === 0;
          upButton.addEventListener('click', () => {
            if (index === 0) return;
            const blocks = settings.customStructure;
            [blocks[index - 1], blocks[index]] = [blocks[index], blocks[index - 1]];
            commitCustomStructure();
            renderStructureBlocks();
          });

          const downButton = document.createElement('button');
          downButton.type = 'button';
          downButton.className = 'block-move';
          downButton.textContent = '↓';
          downButton.setAttribute('aria-label', `Move block ${index + 1} down`);
          downButton.disabled = index === settings.customStructure.length - 1;
          downButton.addEventListener('click', () => {
            const blocks = settings.customStructure;
            if (index === blocks.length - 1) return;
            [blocks[index + 1], blocks[index]] = [blocks[index], blocks[index + 1]];
            commitCustomStructure();
            renderStructureBlocks();
          });

          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.className = 'block-remove';
          removeButton.textContent = 'Remove';
          removeButton.setAttribute('aria-label', `Remove block ${index + 1}`);
          removeButton.disabled = settings.customStructure.length <= 1;
          removeButton.addEventListener('click', () => {
            if (settings.customStructure.length <= 1) return;
            settings.customStructure.splice(index, 1);
            commitCustomStructure();
            renderStructureBlocks();
          });

          /**
           * v0.0.73 — what each instrument does in THIS block.
           *
           * Owner's 76, second half. The intensity ladder decided which
           * instruments played in a section and nothing could touch it, so
           * "drop the drums in the verse" was unreachable.
           *
           * Six initials rather than six labelled selects, and they cycle
           * rather than opening anything — his 77 in this very panel was
           * "don't let minor things take up a tonne of UI space". A dash means
           * the app decides, which is what every block means until you press
           * one.
           */
          const sectionTracks = document.createElement('span');
          sectionTracks.className = 'block-tracks';
          const tracksName = document.createElement('span');
          tracksName.className = 'block-field-name';
          tracksName.textContent = 'plays';
          sectionTracks.append(tracksName);
          const CYCLE = [undefined, 'on', 'off'];
          const MARK = { undefined: '–', on: '●', off: '○' };
          for (const id of TRACK_IDS) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'block-track';
            const paint = () => {
              const state = settings.customStructure[index].tracks?.[id];
              button.textContent = TRACK_LABELS[id].slice(0, 1);
              button.dataset.state = state || 'auto';
              button.title = `${TRACK_LABELS[id]} in section ${settings.customStructure[index].label}: ${
                state === 'on' ? 'always plays' : state === 'off' ? 'never plays' : 'the app decides'}`;
              button.setAttribute('aria-label', button.title);
            };
            button.addEventListener('click', () => {
              const block = settings.customStructure[index];
              if (!block.tracks || typeof block.tracks !== 'object') block.tracks = {};
              const current = block.tracks[id];
              const next = CYCLE[(CYCLE.indexOf(current === 'on' ? 'on' : current === 'off' ? 'off' : undefined) + 1) % CYCLE.length];
              if (next) block.tracks[id] = next; else delete block.tracks[id];
              paint();
              commitCustomStructure();
            });
            paint();
            sectionTracks.append(button);
          }

          barsWrap.append(barsName, barsInput);
          intensityWrap.append(intensityName, intensityInput, intensityOut);
          row.append(labelSelect, titleInput, barsWrap, intensityWrap, sectionTracks, upButton, downButton, removeButton);
          structureBlocks.append(row);
        });

        addBlockButton.disabled = settings.customStructure.length >= 8;
      }

      function commitCustomStructure() {
        engine.setParams({ customStructure: settings.customStructure });
        updateComplexityDisplay();
        persistSettings();
      }

      addBlockButton.addEventListener('click', () => {
        if (settings.customStructure.length >= 8) return;
        settings.customStructure.push({ label: 'A', bars: 8, intensity: 0.4 });
        commitCustomStructure();
        renderStructureBlocks();
      });

      function syncStructureUI() {
        structureSelect.value = settings.structure;
        customBuilder.hidden = settings.structure !== 'custom';
        renderStructureBlocks();
        updateComplexityDisplay();
      }

      structureSelect.addEventListener('change', () => {
        settings.structure = structureSelect.value;
        customBuilder.hidden = settings.structure !== 'custom';
        const partial = { structure: settings.structure };
        if (settings.structure === 'custom') partial.customStructure = settings.customStructure;
        engine.setParams(partial);
        updateComplexityDisplay();
        persistSettings();
      });

      // ---- arpeggiator sync (controls live in the Arp Edit panel) -------

      function syncArpUI() {
        updateComplexityDisplay();
        if (!arpUI) return; // arp editor closed — nothing rendered to sync
        for (const radio of arpUI.modeRadios) {
          radio.checked = radio.value === settings.arp.mode;
        }
        arpUI.manual.hidden = settings.arp.mode !== 'manual';
        arpUI.pattern.value = settings.arp.pattern;
        arpUI.rate.value = settings.arp.rate;
        arpUI.octaves.value = String(settings.arp.octaves);
        arpUI.octavesOut.textContent = String(settings.arp.octaves);
        arpUI.gate.value = String(settings.arp.gate);
        arpUI.gateOut.textContent = String(settings.arp.gate);
      }

      // ---- transport (Play / Finish / Stop now) -------------------------

      let finishing = false;
      let playNotice = '';

      // v26 pause. `engine.pause()` holds the piece where it stands and
      // `engine.resume()` picks it up at that exact position; without it the
      // page can only stop and start again, which loses the position and
      // rebuilds the piece. Both are real pauses to the listener, so the
      // button ships either way — what the probe decides is which one runs
      // (and what the button's own explanation says it will do).
      const exactPause = typeof engine.pause === 'function';
      let paused = false;

      function clearPaused() {
        paused = false;
      }

      function setTransportUI() {
        const running = !!engine.running;
        // A paused piece is still a piece: the main key stays on Finish and
        // Stop stays live, whether or not this engine keeps `running` true
        // while it holds.
        const active = running || paused;
        toggleButton.setAttribute('aria-pressed', String(active));
        // v0.0.41: the separate Stop button is gone, so this one button is the
        // whole control: Play → Finish → Stop. It must therefore stay ENABLED
        // while finishing (it used to disable itself and read "Finishing…"),
        // because pressing it again is now how you cut the outro short.
        playLabel.textContent = finishing ? 'Stop' : active ? 'Finish' : 'Play';
        toggleButton.disabled = false;
        // v15: ▶ before "Play"; the final-barline 𝄂 after "Finish". v0.0.55:
        // and the square while it is finishing, where the caption reads Stop —
        // one glyph per caption, never a caption wearing the previous glyph.
        playGlyph.hidden = active || finishing;
        finishGlyph.hidden = finishing || !active;
        if (stopGlyph) stopGlyph.hidden = !finishing;
        pauseButton.disabled = !active || finishing;
        pauseButton.setAttribute('aria-pressed', String(paused));
        pauseLabel.textContent = paused ? 'Resume' : 'Pause';
        pauseGlyph.hidden = paused;
        resumeGlyph.hidden = !paused;
        setCostPolling(running);
        setResolvedPolling(running);
        refreshRecordAvailability();
        if (!running) clearPlayhead();
        try {
          if ('mediaSession' in navigator) {
            navigator.mediaSession.playbackState = running && !paused ? 'playing' : 'paused';
          }
        } catch {}
        // Every transport change re-evaluates open editors' scopes
        // (OFFLINE static trace ↔ LIVE analyser trace).
        updateAllScopeModes();
      }

      // Lock-screen / hardware-key transport. Full lock-screen support also
      // needs the engine's media-element routing; the handlers are correct
      // without it.
      let mediaSessionReady = false;
      function setupMediaSession() {
        if (mediaSessionReady) return;
        try {
          if (!('mediaSession' in navigator) || typeof MediaMetadata !== 'function') return;
          navigator.mediaSession.metadata = new MediaMetadata({
            title: 'Ambi4 generator',
            artist: 'Ambi4',
          });
          navigator.mediaSession.setActionHandler('play', () => {
            // A lock-screen play on a HELD piece resumes it; otherwise it is
            // an ordinary start.
            if (paused) pauseButton.click();
            else if (!engine.running) engine.start().catch(() => {});
          });
          navigator.mediaSession.setActionHandler('pause', () => {
            // v26: the hardware pause key holds the piece where a real pause
            // exists, and stops it where one does not — which is what the
            // page's own Pause button does either way.
            if (engine.running && !paused) pauseButton.click();
            else engine.stop();
          });
          navigator.mediaSession.setActionHandler('stop', () => {
            clearPaused();
            engine.stop();
          });
          mediaSessionReady = true;
        } catch {}
      }

      async function finishOrStop() {
        // A held piece has no bar left to play its outro in — ending it here
        // is the honest reading of Finish while paused.
        if (paused) {
          clearPaused();
          engine.stop();
          setTransportUI();
          return;
        }
        // Feature-detect finish() — an older engine only has stop().
        if (typeof engine.finish !== 'function') {
          engine.stop();
          setTransportUI();
          return;
        }
        // v0.0.41: pressing it again while it is finishing stops outright. That
        // makes the dual button the whole control — Play, then Finish, then
        // Stop — and it is the one form of double click worth having, because
        // two presses reach the same place however slowly they are made. The
        // separate Stop button is gone.
        if (finishing) {
          engine.stop();
          finishing = false;
          setTransportUI();
          return;
        }
        finishing = true;
        setTransportUI();
        try {
          await engine.finish();
        } catch {
          engine.stop();
        } finally {
          finishing = false;
          setTransportUI();
        }
      }

      /**
       * The Play path, shared with the fallback resume (which is a start by
       * definition — no engine.pause() means no position to pick up).
       */
      async function startPlayback() {
        if (alarmTarget !== null) cancelAlarm(); // starting now supersedes it
        clearPaused();
        toggleButton.disabled = true;
        playNotice = '';
        updateTimerUI();
        // start() can wedge (a context stuck pending resume never resolves);
        // don't leave the button dead — give the UI back after 3 s. A late
        // resolve still syncs the UI via the engine 'state' event.
        const outcome = await Promise.race([
          engine.start().then(
            () => 'started',
            () => 'failed'
          ),
          new Promise((resolve) => setTimeout(() => resolve('timeout'), 3000)),
        ]);
        toggleButton.disabled = false;
        if (outcome === 'started') {
          setupMediaSession();
        } else if (outcome === 'failed' || (outcome === 'timeout' && !engine.running)) {
          playNotice = 'Audio didn’t start — tap Play again.';
          updateTimerUI();
        }
        setTransportUI();
      }

      toggleButton.addEventListener('click', async () => {
        // v0.0.55: NO `if (finishing) return` guard here. That guard is what
        // made the owner's "the Stop button doesn't appear to do anything"
        // report true: v0.0.41 made this one button the whole control
        // (Play → Finish → Stop) and wrote the second-press stop inside
        // finishOrStop(), but the guard above it returned before ever calling
        // it — so the branch was unreachable and the outro played on. The
        // guard predates the dual button, when a separate Stop key existed to
        // do this job and re-entering finish() was the only thing it could
        // have meant.
        if (engine.running || paused || finishing) {
          await finishOrStop();
          return;
        }
        await startPlayback();
      });

      pauseButton.addEventListener('click', async () => {
        if (finishing) return;
        if (paused) {
          paused = false;
          if (exactPause) {
            setTransportUI();
            try {
              await engine.resume();
            } catch {}
            setTransportUI();
          } else {
            await startPlayback();
          }
          return;
        }
        if (!engine.running) return;
        paused = true;
        if (exactPause) {
          try {
            engine.pause();
          } catch {
            paused = false;
          }
        } else {
          // No exact pause: hold by stopping. The resume above starts a fresh
          // build rather than pretending to pick up where this left off.
          engine.stop();
        }
        setTransportUI();
      });

      describe(
        pauseButton,
        exactPause
          ? 'Hold the piece where it is. Resume picks it up at the same point.'
          : 'Hold the piece. This engine can’t resume mid-bar, so Resume starts it building again.'
      );

      // ---- v26 genre transport (picker, favourites, fast-forward) ---------
      // A genre is compiled into ordinary params and loaded like any other
      // snapshot, so everything stays editable afterwards and the piece is
      // shareable without the compiler being present to read it back. The
      // `genre` field is only a TAG saying where the params came from.

      /**
       * Compiled genre params as a settings object. Two carve-outs, both
       * deliberate: the tempo is rounded, because the page's tempo control is
       * whole bpm and a stored 71.903 would show as one, and the master volume
       * is the LISTENER's — a genre is a piece of music, not a listening
       * level, and having the volume jump on every pick is the kind of thing
       * that makes someone stop pressing the button.
       */
      function settingsFromGenre(compiled, slug, { keepUser = true } = {}) {
        const next = structuredClone(compiled);
        next.genre = typeof slug === 'string' ? slug : null;
        if (typeof next.bpm === 'number') next.bpm = Math.round(clamp(next.bpm, 20, 220));
        if (typeof settings?.volume === 'number') next.volume = settings.volume;
        // No genre declares a kit LANE LIST — the one in a compiled object is
        // only there because the compiler sanitises through the engine, and it
        // carries the engine's own low→high `order`, which this page renders
        // top-down (high first). Dropping it keeps the kit rows the right way
        // up; the genre's actual patterns are the sequencer steps, keyed by
        // lane id, and they are untouched.
        if (isPlainObject(next.tracks) && isPlainObject(next.tracks.percussion)) {
          delete next.tracks.percussion.lanes;
        }
        // keepUser: false is the SHARE-BASE path — a base must be a pure
        // function of (genre, seed), never of this session's own tracks.
        return keepUser ? keepUserTracks(next) : next;
      }

      /**
       * Carry the listener's OWN tracks into a params object that has no
       * opinion about them. A preset and a share link are different: they
       * declare their track list outright and removing one is what loading them
       * means. A genre and a Blank slate are not — a genre is a colour applied
       * to the setup you already have, and "silence everything" is an
       * instruction about states, not about what exists. Losing a hand-made
       * track to either would be losing work to a button that never said so.
       */
      function keepUserTracks(next) {
        if (!Array.isArray(settings?.userTracks) || !settings.userTracks.length) return next;
        next.userTracks = structuredClone(settings.userTracks);
        if (!isPlainObject(next.tracks)) next.tracks = {};
        for (const entry of settings.userTracks) {
          if (!isPlainObject(next.tracks[entry.id]) && isPlainObject(settings.tracks[entry.id])) {
            next.tracks[entry.id] = structuredClone(settings.tracks[entry.id]);
          }
        }
        return next;
      }

      /** The genre the current params were compiled from, or null. */
      function currentGenre() {
        return typeof settings.genre === 'string'
          ? GENRE_BY_SLUG.get(settings.genre) || null
          : null;
      }

      /**
       * Compile `genre` at `seed` and load it as the live settings — the same
       * path a preset takes, so the dials, the editors and the persistence all
       * behave exactly as they do for any other load. setParams is bar-
       * quantised engine-side, so a pick while playing lands on the next bar
       * rather than cutting the current one off.
       */
      function applyGenre(genre, seed = randomSeed()) {
        const compiled = compileGenreParams(genre, seed);
        if (!compiled) return false;
        const next = settingsFromGenre(compiled, genre.slug);
        // The SEED is the half of the provenance that was being thrown away.
        // `settings.genre` said which genre; nothing said which compile, and
        // one genre has as many bases as there are seeds.
        next.origin = { kind: 'genre', id: genre.slug, seed };
        loadParamsSnapshot(next);
        recordCleanGenreKit();
        return true;
      }

      // ---- v0.0.104: editable genre rules (his ruling — the GENRE layer) --
      // settings.genreRules is a SPARSE override: only the boxes that differ
      // from the genre file are stored, an empty box means "the genre's own".
      // Recompiles reuse settings.origin.seed, so bpm, mode, time signature,
      // swing, harmonic rhythm and structure survive every edit untouched —
      // the fixed draw order spends its rng calls before the grammar does.
      /** Kit-path genres write their kit from fallbackLists.grooves (three
       * lanes per groove); grammar-path genres only carry anchorPatterns as
       * density guidance. The panel edits WHICHEVER of those is live —
       * showing an anchor box that the kit never reads would be the exact
       * dial-the-engine-ignores failure this project tests against. */
      function genreKitPath(genre) {
        return Array.isArray(genre?.fallbackLists?.grooves) && genre.fallbackLists.grooves.length > 0;
      }

      function groovesToLines(grooves) {
        const blocks = [];
        for (const groove of grooves || []) {
          if (!isPlainObject(groove)) continue;
          const block = [];
          for (const lane of ['low', 'mid', 'high']) {
            if (typeof groove[lane] === 'string') block.push(`${lane}: ${groove[lane]}`);
          }
          if (block.length) blocks.push(block.join('\n'));
        }
        return blocks.join('\n\n');
      }

      function effectiveGenreRules(genre) {
        const rules = isPlainObject(settings.genreRules) ? settings.genreRules : {};
        const essence = genre?.essence || {};
        return {
          progressionGrammar:
            rules.progressionGrammar || essence.chordLanguage?.progressionGrammar || [],
          grooves: rules.grooves || genre?.fallbackLists?.grooves || [],
          anchorPatterns:
            rules.anchorPatterns || essence.grooveGrammar?.anchorPatterns || [],
          syncopationCells:
            rules.syncopationCells || essence.grooveGrammar?.syncopationCells || [],
        };
      }

      function genreRulesEdited() {
        return isPlainObject(settings.genreRules) && Object.keys(settings.genreRules).length > 0;
      }

      function syncGenreRulesUI() {
        const toggle = document.getElementById('genre-rules-toggle');
        if (!toggle) return;
        const genre = currentGenre();
        toggle.hidden = !genre || !genreCompiler || genreRow.hidden;
        const edited = genreRulesEdited();
        toggle.textContent = edited ? 'Rules · edited' : 'Rules';
        const reset = document.getElementById('genre-rules-reset');
        if (reset) reset.hidden = !edited;
        if (!genre) return;
        const rules = effectiveGenreRules(genre);
        const fill = (id, text) => {
          const el = document.getElementById(id);
          if (el && document.activeElement !== el) el.value = text;
        };
        const kitPath = genreKitPath(genre);
        const kitLabel = document.getElementById('genre-rules-anchors-label');
        if (kitLabel) {
          kitLabel.textContent = kitPath
            ? 'Kit patterns (low / mid / high lanes, x is a hit, - a rest; blank line between patterns)'
            : 'Kit anchor patterns (x is a hit, - a rest; guidance for the auto kit)';
        }
        fill('genre-rules-progressions', rules.progressionGrammar.join('\n'));
        fill(
          'genre-rules-anchors',
          kitPath ? groovesToLines(rules.grooves) : rules.anchorPatterns.join('\n')
        );
        fill('genre-rules-cells', rules.syncopationCells.join('\n'));
      }

      function readGenreRulesForm(kitPath) {
        const raw = (id) => document.getElementById(id)?.value || '';
        const lines = (id) =>
          raw(id)
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean);
        const form = {
          progressionGrammar: lines('genre-rules-progressions'),
          syncopationCells: lines('genre-rules-cells'),
          anchorPatterns: [],
          grooves: [],
        };
        if (kitPath) {
          for (const blockText of raw('genre-rules-anchors').split(/\n\s*\n/)) {
            const groove = {};
            for (const line of blockText.split('\n')) {
              const m = /^\s*(low|mid|high)\s*:\s*([x-]+)\s*$/i.exec(line);
              if (m) groove[m[1].toLowerCase()] = m[2];
              else if (line.trim()) groove.INVALID = line.trim();
            }
            if (Object.keys(groove).length) form.grooves.push(groove);
          }
        } else {
          form.anchorPatterns = lines('genre-rules-anchors');
        }
        return form;
      }

      /** The first thing wrong with the form, in plain words — or null. */
      function validateGenreRules(form) {
        for (const line of form.progressionGrammar) {
          for (const token of line.split(/\s+/)) {
            if (!genreCompiler.parseChordToken(token)) {
              return `Chord line not understood — "${token}" in "${line}" is not a roman-numeral chord.`;
            }
          }
        }
        for (const groove of form.grooves) {
          if (groove.INVALID) {
            return `Kit lines are "low: x---", "mid: …" or "high: …" — not "${groove.INVALID}"`;
          }
          for (const lane of ['low', 'mid', 'high']) {
            if (groove[lane] !== undefined && !/^[x-]{4,32}$/.test(groove[lane])) {
              return `Kit patterns use only x and - (4 to 32 steps): "${groove[lane]}"`;
            }
          }
        }
        for (const pattern of form.anchorPatterns) {
          if (!/^[x-]{4,32}$/.test(pattern)) {
            return `Anchor patterns use only x and - (4 to 32 steps): "${pattern}"`;
          }
        }
        for (const cell of form.syncopationCells) {
          if (!/^[x-]{2,16}$/.test(cell)) {
            return `Syncopation cells use only x and - (2 to 16 steps): "${cell}"`;
          }
        }
        return null;
      }

      /** The genre deep-copied with the stored rule OVERRIDES laid on. */
      function genreWithOverrides(genre, overrides) {
        const edited = structuredClone(genre);
        edited.essence = edited.essence || {};
        if (overrides.progressionGrammar) {
          edited.essence.chordLanguage = edited.essence.chordLanguage || {};
          edited.essence.chordLanguage.progressionGrammar = overrides.progressionGrammar;
          // The seed pool also draws from fallbackLists.progressions (they
          // weigh double, deliberately) — a user rewriting the chord rules
          // means THESE rules, so the fallback pool empties too.
          edited.fallbackLists = edited.fallbackLists || {};
          edited.fallbackLists.progressions = [];
        }
        if (overrides.grooves) {
          edited.fallbackLists = edited.fallbackLists || {};
          edited.fallbackLists.grooves = overrides.grooves.map((groove) => {
            const clean = {};
            for (const lane of ['low', 'mid', 'high']) {
              if (groove[lane] !== undefined) clean[lane] = groove[lane];
            }
            return clean;
          });
        }
        if (overrides.anchorPatterns || overrides.syncopationCells) {
          edited.essence.grooveGrammar = edited.essence.grooveGrammar || {};
          if (overrides.anchorPatterns) {
            edited.essence.grooveGrammar.anchorPatterns = overrides.anchorPatterns;
          }
          if (overrides.syncopationCells) {
            edited.essence.grooveGrammar.syncopationCells = overrides.syncopationCells;
          }
        }
        return edited;
      }

      /**
       * Energy stage 1c bookkeeping: the kit as the GENRE machinery last wrote
       * it. While the grid still matches this string the kit is provably the
       * genre's own and Energy may re-shape it; the first hand edit breaks the
       * match and the follow stands down for good — the user's data wins.
       */
      function recordCleanGenreKit() {
        settings.genreKitClean = JSON.stringify(settings.tracks?.percussion?.sequencers ?? null);
      }

      /**
       * Energy stage 1c — the kit-softness ladder, applied by RECOMPILING the
       * genre's kit at the dial's new value (same seed, so nothing else moves)
       * and writing it into the grid where it can be SEEN. Never a hidden
       * note-on multiplier: the grid showing one velocity while another plays
       * is the exact lie this project tests against. Only runs while the kit
       * is provably untouched by hand (recordCleanGenreKit above).
       */
      function followGenreKit(complexityValue) {
        const genre = currentGenre();
        if (!genre || !genreCompiler) return;
        if (!Array.isArray(genre.fallbackLists?.grooves) || !genre.fallbackLists.grooves.length) return;
        const seed = Number.isFinite(settings.origin?.seed) ? settings.origin.seed : null;
        if (seed === null) return;
        const clean = settings.genreKitClean;
        if (typeof clean !== 'string') return;
        const currentKit = JSON.stringify(settings.tracks?.percussion?.sequencers ?? null);
        if (currentKit !== clean) return; // hand-edited: theirs, not the dial's
        const overrides = isPlainObject(settings.genreRules) ? settings.genreRules : {};
        const edited = genreWithOverrides(genre, overrides);
        // Anchor the ladder to the genre's OWN compiled Energy: at the anchor
        // the kit is exactly as authored; deviation spends the ladders.
        const cleanCompile = compileGenreParams(edited, seed);
        if (!cleanCompile) return;
        const anchor = clamp(rangeMid(cleanCompile.complexity ?? 0.5), 0, 1);
        const kc = kitComplexityFor(complexityValue, anchor);
        const compiled = Math.abs(kc - 0.5) < 1e-9
          ? cleanCompile
          : compileGenreParams(edited, seed, { kitComplexity: kc });
        // Through the SAME pipeline a share base takes (settingsFromGenre →
        // DEFAULTS merge → normaliseV6Tracks): a kit written raw from the
        // compiler differs from the rebuilt one in every field the normaliser
        // touches, which put the whole kit into every diff even with the
        // shaping recorded in the origin.
        const shapedTree = deepMerge(DEFAULTS, settingsFromGenre(compiled, genre.slug, { keepUser: false }));
        normaliseV6Tracks(shapedTree);
        const kit = shapedTree?.tracks?.percussion?.sequencers;
        if (!Array.isArray(kit)) return;
        settings.tracks.percussion.sequencers = structuredClone(kit);
        settings.tracks.percussion.sequencer = settings.tracks.percussion.sequencers[0];
        engine.setParams({ tracks: { percussion: { sequencers: structuredClone(kit) } } });
        // The kit is a FUNCTION of (genre, seed, this shaping) — so the origin
        // records the shaping and a share base can rebuild it. Without this
        // the whole kit landed in every diff the moment Energy moved, which
        // pushed a submission past the URL ceiling into the clipboard
        // fallback (caught by submit-drive once its skipped assertions were
        // made real).
        if (isPlainObject(settings.origin) && settings.origin.kind === 'genre') {
          if (Math.abs(kc - 0.5) < 1e-9) delete settings.origin.kitAt;
          else settings.origin.kitAt = Math.round(kc * 1000) / 1000;
        }
        recordCleanGenreKit();
        const editor = document.getElementById('voice-editor-percussion');
        if (editor && !editor.hidden) renderVoiceEditor('percussion');
      }

      function applyGenreRules() {
        const genre = currentGenre();
        const errorEl = document.getElementById('genre-rules-error');
        const say = (text) => {
          if (!errorEl) return;
          errorEl.textContent = text || '';
          errorEl.hidden = !text;
        };
        if (!genre || !genreCompiler) return;
        const kitPath = genreKitPath(genre);
        const form = readGenreRulesForm(kitPath);
        const error = validateGenreRules(form);
        if (error) {
          say(error);
          return;
        }
        const own = genre.essence || {};
        const differs = (lines, base) =>
          lines.length > 0 && JSON.stringify(lines) !== JSON.stringify(base || []);
        const overrides = {};
        if (differs(form.progressionGrammar, own.chordLanguage?.progressionGrammar)) {
          overrides.progressionGrammar = form.progressionGrammar;
        }
        if (kitPath && differs(form.grooves, genre.fallbackLists?.grooves)) {
          overrides.grooves = form.grooves;
        }
        if (!kitPath && differs(form.anchorPatterns, own.grooveGrammar?.anchorPatterns)) {
          overrides.anchorPatterns = form.anchorPatterns;
        }
        if (differs(form.syncopationCells, own.grooveGrammar?.syncopationCells)) {
          overrides.syncopationCells = form.syncopationCells;
        }
        const edited = genreWithOverrides(genre, overrides);
        const seed = Number.isFinite(settings.origin?.seed) ? settings.origin.seed : randomSeed();
        const compiled = compileGenreParams(edited, seed);
        if (!compiled) {
          say('These rules did not compile — nothing was changed.');
          return;
        }
        const next = settingsFromGenre(compiled, genre.slug);
        next.origin = { kind: 'genre', id: genre.slug, seed };
        if (Object.keys(overrides).length) next.genreRules = overrides;
        loadParamsSnapshot(next);
        recordCleanGenreKit();
        say(null);
        syncGenreRulesUI();
        sayUnderDials('Re-drawn from your rules — same dice, so only what you changed, changes.', 4000);
      }

      function resetGenreRules() {
        const genre = currentGenre();
        if (!genre) return;
        const seed = Number.isFinite(settings.origin?.seed) ? settings.origin.seed : randomSeed();
        applyGenre(genre, seed);
        const errorEl = document.getElementById('genre-rules-error');
        if (errorEl) errorEl.hidden = true;
        syncGenreRulesUI();
      }

      function clearGenreTag() {
        settings.genre = null;
        engine.setParams({ genre: null });
        persistSettings();
        syncGenreUI();
      }

      /** The genres the list offers: favourites only where the listener asked. */
      function listedGenres() {
        const favourites = genrePrefs.favourites;
        // PUBLIC_GENRES, not GENRES: a hidden genre still exists and still
        // compiles, so an old link keeps working — it just is not offered.
        const listable = PUBLIC_GENRES;
        const current = settings.genre;
        // A hidden genre that IS in play stays listed, because a select cannot
        // show a value it has no option for — the alternative is a picker that
        // silently reads as some other genre.
        const withCurrent = HIDDEN_GENRES.has(current) && GENRE_BY_SLUG.has(current)
          ? [...listable, GENRE_BY_SLUG.get(current)]
          : listable;
        if (!genrePrefs.hideOthers || !favourites.length) return withCurrent;
        return withCurrent.filter(
          (genre) => favourites.includes(genre.slug) || genre.slug === current
        );
      }

      /** Favourites grouped by mood, in MOODS order, empty groups dropped. */
      function favouriteMoodGroups() {
        const groups = [];
        for (const mood of [...MOODS, OTHER_MOOD]) {
          const members = PUBLIC_GENRES.filter(
            (genre) => genrePrefs.favourites.includes(genre.slug) && moodOf(genre).id === mood.id
          );
          if (members.length) groups.push({ mood, members });
        }
        return groups;
      }

      /** A random genre from `pool`, never the one already playing. */
      function drawGenre(pool) {
        const choices = pool.filter((genre) => genre.slug !== settings.genre);
        const source = choices.length ? choices : pool;
        return source.length ? source[Math.floor(Math.random() * source.length)] : null;
      }

      function genreOption(value, label) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = label;
        return option;
      }

      function renderGenreSelect() {
        genreSelect.innerHTML = '';
        genreSelect.append(genreOption('', 'No genre'));

        const genres = document.createElement('optgroup');
        genres.label = 'Genres';
        for (const genre of listedGenres()) {
          genres.append(genreOption(`g:${genre.slug}`, genre.name));
        }
        genreSelect.append(genres);

        const groups = favouriteMoodGroups();
        if (groups.length) {
          const moods = document.createElement('optgroup');
          moods.label = 'Favourite moods';
          for (const { mood, members } of groups) {
            moods.append(genreOption(`mood:${mood.id}`, `${mood.label} (${members.length})`));
          }
          genreSelect.append(moods);
        }

        const extras = document.createElement('optgroup');
        extras.label = 'More';
        extras.append(genreOption('surprise', 'Surprise me'));
        extras.append(
          genreOption('favourites', genrePrefs.picked ? 'Edit favourites…' : 'Favourites…')
        );
        genreSelect.append(extras);

        // The tag stays honest: a genre playing under edited rules says so
        // right in the picker, where the claim is made.
        if (genreRulesEdited() && settings.genre) {
          const current = [...genreSelect.options].find((o) => o.value === `g:${settings.genre}`);
          if (current) current.textContent += ' · edited rules';
        }
        genreSelect.value = settings.genre ? `g:${settings.genre}` : '';
        syncGenreRulesUI();
      }

      function syncGenreUI() {
        // Nothing to sync where the row is hidden: a build with no compiler
        // has no genre to offer, and a list of entries that cannot act is
        // worse than no list.
        if (genreRow.hidden) return;
        renderGenreSelect();
      }

      genreSelect.addEventListener('change', () => {
        const value = genreSelect.value;
        if (value === 'favourites') {
          syncGenreUI(); // the entry is an action, not a selection
          openFavourites();
          return;
        }
        // Everything past this point replaces the whole setup, so the one
        // being left is remembered for Back. The `favourites` entry above is
        // the sole exception — it opens a panel and changes nothing.
        rememberSetup();
        if (value === 'surprise') {
          const genre = drawGenre(listedGenres());
          if (!genre || !applyGenre(genre)) syncGenreUI();
          return;
        }
        if (value.startsWith('mood:')) {
          const group = favouriteMoodGroups().find(
            (entry) => entry.mood.id === value.slice('mood:'.length)
          );
          const genre = group ? drawGenre(group.members) : null;
          if (!genre || !applyGenre(genre)) syncGenreUI();
          return;
        }
        if (value.startsWith('g:')) {
          const genre = GENRE_BY_SLUG.get(value.slice(2));
          if (!genre || !applyGenre(genre)) syncGenreUI();
          return;
        }
        clearGenreTag();
      });

      describe(
        genreSelect,
        'Pick a genre and the whole setup is drawn from its rules — a different piece each time. ' +
          'Loading a factory preset clears the genre, because a preset is a fixed snapshot.'
      );

      // ---- favourites editor ----------------------------------------------

      const favouritesPopover = setupPopover(null, 'genre-favourites', {
        focusReturn: genreSelect,
      });

      setupPopover('genre-rules-toggle', 'genre-rules');
      document.getElementById('genre-rules-apply')?.addEventListener('click', applyGenreRules);
      document.getElementById('genre-rules-reset')?.addEventListener('click', resetGenreRules);
      describe(
        document.getElementById('genre-rules-toggle'),
        'See and edit the rules this genre draws from — its chord grammar, kit anchors and syncopation cells. Applying re-draws the piece from your rules with the same dice.'
      );
      syncGenreRulesUI();
      const favouritesList = document.getElementById('genre-favourites-list');
      const hideOthersToggle = document.getElementById('genre-hide-others');

      function persistGenrePrefs() {
        persistKey('genre', genrePrefs);
      }

      function renderFavourites() {
        favouritesList.innerHTML = '';
        for (const mood of [...MOODS, OTHER_MOOD]) {
          // Only the public set: offering a favourites tick-box for a genre
          // the picker will not list is a control that cannot do anything.
          const members = PUBLIC_GENRES.filter((genre) => moodOf(genre).id === mood.id);
          if (!members.length) continue;
          const group = document.createElement('div');
          group.className = 'genre-fav-group';
          const heading = document.createElement('span');
          heading.className = 'panel-label';
          heading.textContent = mood.label;
          group.append(heading);
          for (const genre of members) {
            const row = document.createElement('label');
            row.className = 'genre-fav-item';
            const box = document.createElement('input');
            box.type = 'checkbox';
            box.value = genre.slug;
            box.checked = genrePrefs.favourites.includes(genre.slug);
            box.addEventListener('change', () => {
              const favourites = genrePrefs.favourites.filter((slug) => slug !== genre.slug);
              if (box.checked) favourites.push(genre.slug);
              genrePrefs.favourites = favourites;
              persistGenrePrefs();
              syncGenreUI();
            });
            const name = document.createElement('span');
            name.textContent = genre.name;
            row.append(box, name);
            group.append(row);
          }
          favouritesList.append(group);
        }
        hideOthersToggle.checked = genrePrefs.hideOthers;
      }

      hideOthersToggle.addEventListener('change', () => {
        genrePrefs.hideOthers = hideOthersToggle.checked;
        persistGenrePrefs();
        syncGenreUI();
      });

      document.getElementById('genre-favourites-done').addEventListener('click', () => {
        favouritesPopover.close();
      });

      function openFavourites() {
        // First use is what "picked" records: from here on the entry reads
        // "Edit favourites…" rather than offering the choice again.
        genrePrefs.picked = true;
        persistGenrePrefs();
        renderFavourites();
        favouritesPopover.open();
        syncGenreUI();
      }

      // ---- Back: undo a setup replacement ----------------------------------
      /**
       * v0.0.58. Next has always been destructive — it recompiles the genre at
       * a fresh seed, or re-rolls the current params, and the setup it replaced
       * was gone. Nothing anywhere in the page kept a history, so "that one was
       * better, take me back" was impossible. This is that history.
       *
       * Deliberately NOT a general undo. It remembers the two gestures that
       * replace an entire setup at once — Next, and picking a genre — and
       * nothing else. An undo stack over every dial move is a different and
       * much larger feature (every commit path would have to opt in, and a
       * drag would have to coalesce), and pretending a two-entry-per-gesture
       * stack is one would mislead: the button would sometimes undo a dial and
       * sometimes a whole piece.
       *
       * Capped, because a snapshot is the entire settings tree and a listener
       * can press Next for an hour.
       */
      const HISTORY_LIMIT = 24;
      const setupHistory = [];
      const rewindButton = document.getElementById('rewind');

      function syncRewind() {
        if (rewindButton) rewindButton.disabled = setupHistory.length === 0;
      }

      /** Remember the setup as it stands, immediately before replacing it. */
      function rememberSetup() {
        try {
          setupHistory.push(paramsSnapshot());
          if (setupHistory.length > HISTORY_LIMIT) setupHistory.shift();
          syncRewind();
        } catch {
          // A snapshot that cannot be cloned is not worth failing the gesture
          // the user actually asked for.
        }
      }

      /**
       * v0.0.78 — cmd-z, and it undoes whatever you did last.
       *
       * His ask, verbatim: "cmd-z undoes the last user input, whatever it was
       * — including Next. Not the setup-only stack Back uses; a single
       * universal undo over every input, unlimited within a session. Back
       * stays as the coarse control."
       *
       * The v0.0.58 note above says a general undo would mean "every commit
       * path would have to opt in, and a drag would have to coalesce". Both
       * were true and neither needed solving separately, because the page
       * already has one funnel every committed change goes through:
       * `persistSettings()`. It is called by every dial, every select, every
       * grid edit, every genre pick and by Next — and it already DEBOUNCES,
       * which is exactly the coalescing a drag needs. So the undo watches the
       * funnel rather than instrumenting a hundred call sites, and one drag is
       * one entry because one drag is one persist.
       *
       * Entries are the PREVIOUS value of whichever top-level keys changed,
       * not whole snapshots: settings is a large tree and "unlimited within a
       * session" would otherwise mean tens of megabytes. Top-level granularity
       * rather than per-field is deliberate — a partial patch cannot express
       * "this key used to be absent", and restoring a whole subtree always
       * can.
       *
       * Redo is here for one reason: an undo with no redo makes an accidental
       * cmd-z unrecoverable, which is the same trap the single-click dial
       * reset was, and that one was already ruled against.
       */
      const undoStack = [];
      const redoStack = [];
      let undoBaseline = null;
      let undoSuspended = 0;
      let undoTimer = null;

      const UNDO_IGNORE = new Set(['ui']);

      /** The top-level keys whose value differs between two snapshots. */
      function changedTopKeys(before, after) {
        const keys = new Set([...Object.keys(before || {}), ...Object.keys(after || {})]);
        const changed = [];
        for (const key of keys) {
          if (UNDO_IGNORE.has(key)) continue;
          if (JSON.stringify(before ? before[key] : undefined)
            !== JSON.stringify(after ? after[key] : undefined)) changed.push(key);
        }
        return changed;
      }

      /** The settings tree with one entry's keys written back over it. */
      function applyUndoEntry(entry) {
        const next = paramsSnapshot();
        for (const [key, value] of Object.entries(entry.keys)) {
          if (value === undefined) delete next[key];
          else next[key] = structuredClone(value);
        }
        return next;
      }

      /**
       * Called whenever the settings tree may have moved. Coalesced, so a drag
       * that fires two hundred commits leaves one entry behind it.
       */
      function noteUndoPoint() {
        if (undoSuspended) return;
        if (undoTimer !== null) clearTimeout(undoTimer);
        undoTimer = setTimeout(() => {
          undoTimer = null;
          if (undoSuspended) return;
          let now;
          try { now = paramsSnapshot(); } catch { return; }
          if (!undoBaseline) { undoBaseline = now; return; }
          const changed = changedTopKeys(undoBaseline, now);
          if (!changed.length) return;
          const keys = {};
          for (const key of changed) {
            keys[key] = key in undoBaseline ? structuredClone(undoBaseline[key]) : undefined;
          }
          undoStack.push({ keys });
          // A fresh edit ends the redo branch, which is what every editor does
          // and what anyone who has used one expects.
          redoStack.length = 0;
          undoBaseline = now;
        }, 300);
      }

      function stepUndo(from, to) {
        const entry = from.pop();
        if (!entry) return false;
        let current;
        try { current = paramsSnapshot(); } catch { return false; }
        const inverse = {};
        for (const key of Object.keys(entry.keys)) {
          inverse[key] = key in current ? structuredClone(current[key]) : undefined;
        }
        to.push({ keys: inverse });
        const next = applyUndoEntry(entry);
        undoSuspended += 1;
        try {
          loadParamsSnapshot(next);
          syncGenreUI();
        } finally {
          undoBaseline = null;
          // Released a tick later than the load: loadParamsSnapshot's own
          // persist and the sync it triggers must not be read as a new edit.
          setTimeout(() => {
            undoSuspended -= 1;
            try { undoBaseline = paramsSnapshot(); } catch {}
          }, 0);
        }
        return true;
      }

      onSettingsCommitted = () => {
        noteUndoPoint();
        // Cheap: a diff of two trees, at most once per settled edit.
        if (typeof syncProvenance === 'function') syncProvenance();
      };

      window.addEventListener('keydown', (event) => {
        if (!(event.metaKey || event.ctrlKey) || event.altKey) return;
        const key = event.key.toLowerCase();
        const redo = key === 'y' || (key === 'z' && event.shiftKey);
        if (key !== 'z' && !redo) return;
        // Inside a text field the browser's own undo is the right one: it
        // undoes the typing, which is what the person is actually looking at.
        const target = event.target;
        const tag = target && target.tagName;
        if (tag === 'INPUT' && target.type !== 'range' && target.type !== 'checkbox') return;
        if (tag === 'TEXTAREA' || (target && target.isContentEditable)) return;
        const moved = redo ? stepUndo(redoStack, undoStack) : stepUndo(undoStack, redoStack);
        if (!moved) {
          sayUnderDials(redo ? 'Nothing to redo.' : 'Nothing left to undo.', 1800);
          return;
        }
        event.preventDefault();
        sayUnderDials(redo ? 'Redone.' : 'Undone.', 1500);
      });

      rewindButton?.addEventListener('click', () => {
        const previous = setupHistory.pop();
        syncRewind();
        if (!previous) return;
        loadParamsSnapshot(previous);
        syncGenreUI();
      });

      describe(
        rewindButton,
        'Back to the setup you had before the last Next, or the last genre change. It remembers the last two dozen. For anything smaller — a dial, a chord, a step — use ⌘Z, which undoes whatever you did last.'
      );
      syncRewind();

      // ---- fast-forward -----------------------------------------------------
      // "Something else, now." With a genre in play that is the same genre
      // compiled at a fresh seed — a genuinely different setup (metre, mode,
      // tempo, chord loop, kit), still recognisably the genre. With no genre
      // there is nothing to recompile, so it re-rolls the material the current
      // params describe: the engine's randomise() drops every track's frozen
      // plan, hook and groove, and the next bar is built afresh.
      if (!genreCompiler && !engineCaps.randomise) UNAVAILABLE_TRANSPORT.add('fastforward');

      function reseedCurrentParams() {
        if (!engineCaps.randomise) return;
        try {
          engine.randomise();
        } catch {}
      }

      forwardButton.addEventListener('click', () => {
        rememberSetup();
        const genre = currentGenre();
        if (genre && genreCompiler && applyGenre(genre)) return;
        reseedCurrentParams();
      });

      describe(
        forwardButton,
        'Skip to a completely different setup — the same genre rebuilt from scratch, ' +
          'or a fresh roll of the current one with no genre set.'
      );

      // The picker's own list is built by the first syncUIFromSettings below.
      genreRow.hidden = !genreCompiler || !GENRES.length;

      // ---- v15 record ------------------------------------------------------
      // MediaRecorder over the engine's own mixed output. The engine keeps
      // that MediaStream private (it lives on an internal <audio> element and
      // is not on the public API), so the page can only record once the
      // engine exposes it — every plausible accessor is probed here, and the
      // button ships disabled with an explanation when none answers. Summing
      // the per-track analysers would "work", but they tap pre-mix, pre-
      // effects and pre-master, so the file would not be what the listener
      // heard: a wrong recording is worse than none.
      function engineOutputStream() {
        for (const name of ['getOutputStream', 'getMediaStream', 'getStream']) {
          try {
            const stream = typeof engine[name] === 'function' ? engine[name]() : null;
            if (stream && typeof stream.getAudioTracks === 'function') return stream;
          } catch {}
        }
        try {
          const el = typeof engine.getOutputElement === 'function' ? engine.getOutputElement() : null;
          if (el && el.srcObject && typeof el.srcObject.getAudioTracks === 'function') {
            return el.srcObject;
          }
        } catch {}
        return null;
      }

      const canRecord = typeof window.MediaRecorder === 'function';
      let recorder = null;
      let recordChunks = [];
      let recordStartedAt = 0;
      let recordTimer = null;

      // v18 hardware-panel rule: the elapsed time swaps INSIDE a box that is
      // always there (see .record-status) — hiding the element would let the
      // status line re-flow every time recording starts and stops.
      function updateRecordStatus() {
        recordStatus.textContent = recorder
          ? `Recording ${formatCountdown(Date.now() - recordStartedAt)}`
          : '';
      }

      function stopRecording() {
        if (!recorder) return;
        try {
          recorder.stop();
        } catch {
          recorder = null;
        }
      }

      function startRecording() {
        const stream = engineOutputStream();
        if (!stream) return;
        try {
          recorder = new MediaRecorder(stream);
        } catch {
          recorder = null;
          return;
        }
        recordChunks = [];
        recorder.addEventListener('dataavailable', (event) => {
          if (event.data && event.data.size) recordChunks.push(event.data);
        });
        recorder.addEventListener('stop', () => {
          const blob = new Blob(recordChunks, { type: recorder.mimeType || 'audio/webm' });
          recordChunks = [];
          recorder = null;
          if (recordTimer !== null) {
            clearInterval(recordTimer);
            recordTimer = null;
          }
          recordButton.setAttribute('aria-pressed', 'false');
          recordButton.classList.remove('recording');
          updateRecordStatus();
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `ambi4-${new Date().toISOString().replace(/[:.]/g, '-')}.webm`;
          link.click();
          setTimeout(() => URL.revokeObjectURL(url), 10000);
        });
        recorder.start();
        recordStartedAt = Date.now();
        recordButton.setAttribute('aria-pressed', 'true');
        recordButton.classList.add('recording');
        recordTimer = setInterval(updateRecordStatus, 1000);
        updateRecordStatus();
      }

      function refreshRecordAvailability() {
        if (recorder) return;
        const ready = canRecord && !!engineOutputStream();
        recordButton.disabled = !ready;
      }

      recordButton.disabled = true;
      // Pre-launch the button is hidden outright (applyTransportVisibility), so
      // it gets no tooltip either — a description node beside a control nobody
      // can use still reaches a screen reader, which is the same tease. The
      // whole MediaRecorder path above stays live for the flag going false.
      if (!PAID_FEATURES_HIDDEN) {
        describe(
          recordButton,
          canRecord
            ? 'Records the mix to a .webm file on this device. Needs the engine to publish its output stream — arriving with the next engine update.'
            : 'This browser has no MediaRecorder, so recording is unavailable here.'
        );
        if (canRecord) {
          recordButton.addEventListener('click', () => {
            if (recorder) stopRecording();
            else startRecording();
          });
          refreshRecordAvailability();
        }
      }

      // ---- v28 play along (computer keyboard + MIDI) + Capture -------------
      // The keys sound through the CHOSEN TRACK's own voice, patch and level —
      // the engine routes a live note down the same chain the piece uses — and
      // they are armed ONLY while the toggle is on. Nothing here listens to the
      // keyboard otherwise: a page that quietly ate keystrokes would break
      // every name box and every dial on it.
      //
      // Capture records what is played into that track's step grid. A step
      // grid holds rhythm, velocity and note length — never pitch — so a
      // captured take plays in the piece's own harmony. The note line under
      // the row says exactly that, and never changes, so nothing on the panel
      // moves when the state does.

      const playAlongToggle = document.getElementById('play-along-toggle');
      const playAlongTrack = document.getElementById('play-along-track');
      const playAlongPanel = document.getElementById('play-along');
      const playAlongReadout = document.getElementById('play-along-readout');
      const captureButton = document.getElementById('play-along-capture');
      const captureUndoButton = document.getElementById('play-along-undo');

      if (!engineCaps.playAlong) UNAVAILABLE_TRANSPORT.add('playalong');

      /**
       * The two-row keyboard every DAW ships: the bottom row is one octave
       * from C (z x c v b n m, with the black keys on s d / g h j), and the
       * upper row the octave above it (q w e r t y u, black keys 2 3 / 5 6 7).
       * Values are semitones above the bottom row's C.
       */
      const PLAY_ALONG_KEYS = {
        z: 0, s: 1, x: 2, d: 3, c: 4, v: 5, g: 6, b: 7, h: 8, n: 9, j: 10, m: 11,
        ',': 12, l: 13, '.': 14, ';': 15, '/': 16,
        q: 12, 2: 13, w: 14, 3: 15, e: 16, r: 17, 5: 18, t: 19, 6: 20, y: 21, 7: 22,
        u: 23, i: 24, 9: 25, o: 26, 0: 27, p: 28,
      };
      // Octave shift. Not z/x (a DAW's usual pair) — both are notes on the
      // bottom row here, and a key cannot be two things.
      const OCTAVE_DOWN = new Set(['-', '_']);
      const OCTAVE_UP = new Set(['=', '+']);
      const OCTAVE_MIN = 1;
      const OCTAVE_MAX = 7;
      // One spelling of a note name in the whole page: see pitchName.
      const noteName = pitchName;

      let playAlongOn = false;
      let playAlongOctave = 4;
      // v0.0.87 (his item 96): tap-a-rhythm — while on, Space is a tap on
      // the selected track, and Capture writes the taps into its grid.
      let tapMode = false;
      const playAlongDown = new Map();   // keyboard key → { track, midi }

      const playAlongTarget = () =>
        (TRACK_IDS.includes(playAlongTrack.value) ? playAlongTrack.value : TRACK_IDS[0]);

      /** The track picker, rebuilt from the live registry, keeping its choice. */
      function renderPlayAlongTracks() {
        const wanted = TRACK_IDS.includes(playAlongTrack.value)
          ? playAlongTrack.value
          : TRACK_IDS.includes('melody')
            ? 'melody'
            : TRACK_IDS[0];
        playAlongTrack.innerHTML = '';
        for (const id of TRACK_IDS) {
          const option = document.createElement('option');
          option.value = id;
          option.textContent = TRACK_LABELS[id] || id;
          playAlongTrack.appendChild(option);
        }
        playAlongTrack.value = wanted;
      }

      /** Whether a take can be recorded into this track at all. */
      const canCapture = (track) => engineCaps.capture && SEQ_TRACKS.includes(track);

      function captureState() {
        if (!engineCaps.capture) return { armed: false, undoable: false };
        try {
          return engine.getCapture() || { armed: false, undoable: false };
        } catch {
          return { armed: false, undoable: false };
        }
      }

      /**
       * Buttons change their pressed and disabled states and NOTHING else —
       * no label swaps, no controls appearing or disappearing. The readout is
       * a fixed-width box, so even the note name cannot move its neighbours.
       */
      const playAlongOpen = document.getElementById('play-along-open');
      function setPlayAlongUI() {
        const capture = captureState();
        playAlongToggle.setAttribute('aria-pressed', String(playAlongOn));
        playAlongOpen?.classList.toggle('play-along-live', playAlongOn);
        captureButton.setAttribute('aria-pressed', String(capture.armed));
        captureButton.disabled = !playAlongOn || !canCapture(playAlongTarget());
        captureUndoButton.disabled = !capture.undoable;
        const refit = document.getElementById('create-refit');
        if (refit) {
          refit.hidden = !(
            engineCaps.capture && typeof engine.requantiseCapture === 'function' && capture.take
          );
        }
      }

      const showPlayed = (text) => {
        playAlongReadout.textContent = text;
      };

      /**
       * v0.0.107 — the missing half of every capture write: the ENGINE had
       * the take and the PAGE never learned. The grid drew the pre-take
       * lane, the next page-side edit silently wiped the take, and a reload
       * lost it outright (persistence saves the page's settings, which were
       * stale). Any capture-path write now pulls the written track's
       * sequencers back into settings, refreshes an open editor, persists.
       */
      function adoptEngineSequencers(track) {
        try {
          const live = engine.getParams()?.tracks?.[track];
          if (!live || !Array.isArray(live.sequencers) || !settings.tracks[track]) return;
          settings.tracks[track].sequencers = structuredClone(live.sequencers);
          settings.tracks[track].sequencer = settings.tracks[track].sequencers[0];
          const editor = document.getElementById(`voice-editor-${track}`);
          if (editor && !editor.hidden) renderVoiceEditor(track);
          persistSettings();
        } catch {}
      }

      /** Stop a running take and say what it wrote. */
      function endCapture() {
        if (!engineCaps.capture || !captureState().armed) return;
        let take = null;
        try {
          take = engine.stopCapture();
        } catch {}
        if (take && take.written) adoptEngineSequencers(take.track);
        showPlayed(take && take.written ? `♪ ${take.written}` : '');
        setPlayAlongUI();
      }

      function setPlayAlong(on) {
        if (on === playAlongOn) return;
        playAlongOn = on;
        if (on) {
          // The click IS the gesture a browser needs before it will make
          // sound, and arm() is the engine's "build the audio graph, play
          // nothing" door — so the keys work with the transport stopped.
          try {
            if (typeof engine.arm === 'function') engine.arm();
          } catch {}
          attachMidi();
        } else {
          endCapture();
          releaseAll();
          // Keys off stands the Space drum down with them: tap mode
          // surviving disarmed keys was invisible state that swallowed Space
          // and resumed unasked when the keys came back.
          if (tapMode) {
            tapMode = false;
            document.getElementById('create-tap')?.setAttribute('aria-pressed', 'false');
          }
        }
        showPlayed('');
        setPlayAlongUI();
      }

      function releaseAll() {
        for (const [key, held] of playAlongDown) {
          try {
            engine.noteOff(held.track, held.midi);
          } catch {}
          playAlongDown.delete(key);
        }
        try {
          if (typeof engine.allNotesOff === 'function') engine.allNotesOff();
        } catch {}
      }

      /**
       * Whether the keys belong to something else. A text box, a select, a
       * contenteditable or an open dialog is someone TYPING — the instrument
       * must never eat a character meant for a preset name.
       */
      function typingTarget(target) {
        const el = target && target.nodeType === 1 ? target : null;
        if (!el) return false;
        if (el.isContentEditable) return true;
        const tag = (el.tagName || '').toLowerCase();
        if (tag === 'input' || tag === 'textarea' || tag === 'select' || tag === 'option') return true;
        // The play-along popover is itself role="dialog", and enabling the
        // keys leaves focus on the Enable button inside it — so treating any
        // dialog as "typing" swallowed every note exactly when the panel was
        // open, which is the only state in which the keys are armed (the
        // popover disarms on close, by design). That killed the instrument
        // outright from the v0.0.40 popover collapse until v0.0.82. The
        // instrument's own panel is the one dialog that is NOT typing; every
        // other dialog, and the track select above, still is.
        if (typeof el.closest !== 'function') return false;
        const scope = el.closest('[role="dialog"], dialog, [contenteditable="true"]');
        return !!scope && scope.id !== 'play-along';
      }

      const midiForKey = (key) => {
        const semitone = PLAY_ALONG_KEYS[key];
        if (semitone === undefined) return null;
        return clamp(12 * (playAlongOctave + 1) + semitone, 0, 127);
      };

      function playAlongKeyDown(event) {
        if (!playAlongOn || event.repeat) return;
        // A key another control has already acted on is not a note. The step
        // grid's cells preventDefault on every key they handle (T, G, comma,
        // dot, the gate keys), and without this line the armed musical-typing
        // keys played over them — worst of all recording the collisions into
        // an armed Capture, whose stop then REPLACED the very grid the user
        // was hand-editing.
        if (event.defaultPrevented) return;
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        if (typingTarget(event.target)) return;
        const key = tapMode && event.key === ' '
          ? 'z'
          : typeof event.key === 'string' && event.key.length === 1
            ? event.key.toLowerCase()
            : event.key;
        if (OCTAVE_DOWN.has(key) || OCTAVE_UP.has(key)) {
          playAlongOctave = clamp(
            playAlongOctave + (OCTAVE_UP.has(key) ? 1 : -1),
            OCTAVE_MIN,
            OCTAVE_MAX
          );
          showPlayed(`Oct ${playAlongOctave}`);
          event.preventDefault();
          return;
        }
        const midi = midiForKey(key);
        if (midi === null || playAlongDown.has(key)) return;
        event.preventDefault();
        const track = playAlongTarget();
        let sounded = false;
        try {
          sounded = engine.noteOn(track, midi, 0.8) === true;
        } catch {}
        if (!sounded) return;
        playAlongDown.set(key, { track, midi });
        showPlayed(noteName(midi));
        setPlayAlongUI();
      }

      function playAlongKeyUp(event) {
        // No defaultPrevented gate here: a note that DID start must always be
        // releasable, whatever the keyup landed on.
        const key = tapMode && event.key === ' '
          ? 'z'
          : typeof event.key === 'string' && event.key.length === 1
            ? event.key.toLowerCase()
            : event.key;
        const held = playAlongDown.get(key);
        if (!held) return;
        playAlongDown.delete(key);
        try {
          engine.noteOff(held.track, held.midi);
        } catch {}
        setPlayAlongUI();
      }

      // ---- Web MIDI (feature-detected; silent where the browser has none) --
      let midiRequested = false;

      function attachMidi() {
        if (midiRequested || typeof navigator.requestMIDIAccess !== 'function') return;
        midiRequested = true;
        let request = null;
        try {
          request = navigator.requestMIDIAccess({ sysex: false });
        } catch {
          return;
        }
        if (!request || typeof request.then !== 'function') return;
        request
          .then((access) => {
            const listen = () => {
              try {
                access.inputs.forEach((input) => {
                  input.onmidimessage = onMidiMessage;
                });
              } catch {}
            };
            listen();
            // An instrument plugged in later is the same instrument.
            try {
              access.onstatechange = listen;
            } catch {}
          })
          // Refused permission, or no instrument: the keyboard still works and
          // nothing is said about it.
          .catch(() => {});
      }

      function onMidiMessage(event) {
        if (!playAlongOn) return;
        const data = event && event.data;
        if (!data || data.length < 3) return;
        const command = data[0] & 0xf0;
        const midi = data[1];
        const velocity = data[2];
        const track = playAlongTarget();
        try {
          if (command === 0x90 && velocity > 0) {
            if (engine.noteOn(track, midi, velocity / 127) === true) showPlayed(noteName(midi));
          } else if (command === 0x80 || (command === 0x90 && velocity === 0)) {
            engine.noteOff(track, midi);
          }
        } catch {}
        setPlayAlongUI();
      }

      if (engineCaps.playAlong) {
        renderPlayAlongTracks();
        setPlayAlongUI();
        playAlongToggle.addEventListener('click', () => setPlayAlong(!playAlongOn));
        playAlongTrack.addEventListener('change', () => {
          // A take belongs to the track it was played on: switching tracks
          // ends it where it stands rather than dragging it across.
          endCapture();
          releaseAll();
          setPlayAlongUI();
        });
        captureButton.addEventListener('click', () => {
          if (captureState().armed) {
            endCapture();
            return;
          }
          try {
            engine.armCapture(playAlongTarget());
          } catch {}
          showPlayed('');
          setPlayAlongUI();
        });
        captureUndoButton.addEventListener('click', () => {
          const undoing = captureState().undoTrack;
          let undone = false;
          try {
            undone = engine.undoCapture();
          } catch {}
          if (undone && undoing) adoptEngineSequencers(undoing);
          showPlayed('');
          setPlayAlongUI();
        });
        document.addEventListener('keydown', playAlongKeyDown);
        document.addEventListener('keyup', playAlongKeyUp);
        // A key held when the tab or the window goes away never sends its
        // keyup, and a note nobody can stop is the worst bug this row could
        // ship. Let go of everything instead.
        window.addEventListener('blur', releaseAll);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) releaseAll();
        });
        if (typeof engine.on === 'function') engine.on('tracks', renderPlayAlongTracks);
      }

      if (typeof engine.on === 'function') {
        engine.on('state', ({ running, paused: enginePaused }) => {
          if (!running) {
            finishing = false;
            // Where the engine really pauses, a stop is a stop and the hold is
            // over. In the stop-and-rebuild fallback the engine IS stopped
            // while held, so the page's own flag is the only record of it and
            // clearing it here would lose the Resume affordance.
            if (exactPause) clearPaused();
          } else if (typeof enginePaused === 'boolean') {
            paused = enginePaused;
          }
          if (running) {
            setupMediaSession();
            if (playNotice) {
              playNotice = '';
              updateTimerUI();
            }
          }
          setTransportUI();
        });
        engine.on('bar', ({ time, beatsPerBar }) => {
          schedulePlayhead(time, beatsPerBar);
        });

        // v0.0.67: every scheduled note lands in its track's grid as a CHOSEN
        // step, so an Auto sequencer shows the pattern it is actually playing
        // instead of an empty grid with a playhead sweeping over it.
        //
        // A note is placed by WHEN it sounds, quantised to that grid's own step
        // resolution — which is the only honest mapping, because the engine
        // does not think in steps at all. Live play-along notes are skipped:
        // they are the listener's hands, not the app's choice, and marking them
        // as chosen would credit the app with something a person did.
        engine.on('note', (event) => {
          if (!event || event.live) return;
          const ed = openEditors.get(event.track);
          if (!ed || !ed.seq || typeof ed.seq.noteChosen !== 'function') return;
          const n = stepsPerBarFor(event.track);
          if (!n || !Number.isFinite(event.time)) return;
          const beats = currentBeatsPerBar || 4;
          const barSeconds = beats * (60 / clamp(rangeMid(settings.bpm), 20, 220));
          if (!(barSeconds > 0)) return;
          const bar = Math.floor((event.time - lastBarTime) / barSeconds);
          const within = ((event.time - lastBarTime) % barSeconds + barSeconds) % barSeconds;
          const step = Math.round((within / barSeconds) * n) % n;
          try {
            ed.seq.noteChosen(step, event.lane ?? null, lastBarIndex + Math.max(0, bar), event.midi);
          } catch {}
        });
      }

      // ---- sleep timer + alarm (wall-clock re-check, drift-proof) -------

      const sleepIdle = document.getElementById('sleep-idle');
      const sleepActive = document.getElementById('sleep-active');
      const sleepCountdown = document.getElementById('sleep-countdown');
      const sleepCustom = document.getElementById('sleep-custom');
      const alarmIdle = document.getElementById('alarm-idle');
      const alarmActive = document.getElementById('alarm-active');
      const alarmCountdown = document.getElementById('alarm-countdown');
      const alarmTimeInput = document.getElementById('alarm-time');
      const sleepChip = document.getElementById('sleep-chip');
      const alarmChip = document.getElementById('alarm-chip');

      // ---- v6: sleep/alarm popovers (anchored, keyboard-operable dialogs) -
      // Esc and outside-click close; focus moves into the panel on open and
      // back to its button on close; Tab wraps within the panel while open.
      // v26: `toggleId` may be null for a dialog with no button of its own
      // (the genre favourites editor is opened from an entry in the genre
      // list), in which case `focusReturn` says where focus goes on close.
      function setupPopover(toggleId, popoverId, { focusReturn = null, onClose = null } = {}) {
        const toggle = toggleId ? document.getElementById(toggleId) : null;
        const popover = document.getElementById(popoverId);
        const anchor =
          (toggle && toggle.closest('.popover-anchor')) ||
          popover.closest('.popover-anchor') ||
          (toggle ? toggle.parentElement : popover.parentElement);

        function focusables() {
          return Array.from(
            popover.querySelectorAll(
              'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
            )
          ).filter((el) => !el.disabled && el.offsetParent !== null);
        }

        function open() {
          if (!popover.hidden) return;
          popover.hidden = false;
        // v0.0.85: an anchored popover defaults to growing LEFT from its
        // anchor (the icons sit at the right edge), but an anchor near the
        // page's left would clip — so measure once on open and take the side
        // with room. Inline styles are cleared first so the flip never sticks.
        popover.style.left = '';
        popover.style.right = '';
        {
          const r = popover.getBoundingClientRect();
          if (r.left < 8 && window.innerWidth > 560) {
            popover.style.left = '0';
            popover.style.right = 'auto';
          }
        }
          toggle?.setAttribute('aria-expanded', 'true');
          const first = focusables()[0];
          try {
            (first || popover).focus();
          } catch {}
        }

        function close({ refocus = true } = {}) {
          if (popover.hidden) return;
          popover.hidden = true;
          toggle?.setAttribute('aria-expanded', 'false');
          if (refocus) (toggle || focusReturn)?.focus();
          // Every route out lands here — the toggle, Escape, an outside click —
          // so a caller needing to stand something down on close only has to
          // say so once.
          try {
            onClose?.();
          } catch {
            // A caller's cleanup must never wedge the popover open.
          }
        }

        toggle?.addEventListener('click', () => {
          if (popover.hidden) open();
          else close();
        });

        popover.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            close();
            return;
          }
          if (event.key !== 'Tab') return;
          const els = focusables();
          if (els.length === 0) return;
          const first = els[0];
          const last = els[els.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        document.addEventListener('pointerdown', (event) => {
          if (popover.hidden) return;
          // AUDIT FIX: `anchor.contains` was too generous where two popovers
          // SHARE an anchor (the genre row holds both the favourites editor
          // and the rules panel): opening one left the other open, because a
          // press inside the shared anchor counted as "inside me". A press
          // inside the OTHER popover — or on the toggle that opens it — now
          // closes this one, which is what "one at a time" means.
          if (popover.contains(event.target)) return;
          if (toggle && toggle.contains(event.target)) return;
          const inSomePopover = event.target instanceof Element
            && event.target.closest('.popover');
          if (!inSomePopover && anchor.contains(event.target)) return;
          close({ refocus: false });
        });

        return { open, close };
      }

      // v0.0.40: one clock, one popover holding both timers, plus the
      // play-along keyboard as a third peer icon.
      // ---- v0.0.85: the Create doors (his item 96) -----------------------
      {
        const createBlank = document.getElementById('create-blank');
        const createSeed = document.getElementById('create-seed');
        const guidedTip = document.getElementById('guided-tip');
        const composeChords = document.getElementById('compose-chords');
        // His guided-start: name what a genre's composers usually start with.
        const GENRE_START_WITH = {
          synthwave: 'Synthwave writers usually start with the chords, then the bassline against them.',
          'techno-tools': 'Techno starts with the drums — a kick pattern first, then the bassline locked to it.',
          'deep-house': 'Deep house starts with the drums and the bassline, chords after.',
          'lofi-beats': 'Lofi starts with the chords, drums brushed in after.',
          downtempo: 'Downtempo usually starts with the drums and the bass together.',
          minimalism: 'Minimalism starts with one small repeating cell — the arp is the natural first instrument.',
          ambient: 'Ambient starts with the pad or the texture — the air before any note.',
          'soul-groove': 'Soul starts with the chords, and the bass answers them.',
          bossa: 'Bossa starts with the chords and their rhythm.',
          'acid-jazz': 'Acid jazz starts with the bassline.',
          cinematic: 'Cinematic writing starts with the pad — the bed everything else sits on.',
          'new-age': 'New age starts with the pad.',
        };
        if (createSeed) {
          for (const genre of PUBLIC_GENRES) {
            const option = document.createElement('option');
            option.value = genre.slug;
            option.textContent = genre.name;
            createSeed.appendChild(option);
          }
        }
        // The REAL blank (his 103: "blank slate isn't working… still have
        // massive reverb and delay"): the same full snapshot the Advanced
        // Blank-slate button loads — tracks off, grids cleared, no genre, FX
        // zeroed — not a stub that only switched states off.
        createBlank?.addEventListener('click', () => {
          loadParamsSnapshot(buildBlankParams());
          clearGenreTag();
          presetName.value = '';
          if (guidedTip) {
            guidedTip.textContent =
              'Silence, genuinely: instruments off, grids cleared, FX zeroed. Build up from here.';
          }
        });

        // Zero one layer at a time, so ANY preset can be the source.
        // AUDIT FIX (critical 1): the snapshot base is the PAGE's settings —
        // the user's own ask-values — never engine.getParams(). The engine's
        // tree holds what we SENT it: power-scaled texture/arp levels, the
        // tier-capped reverb tail, walked positions for every spread global.
        // Round-tripping that baked the Eco tier's half-level into stored
        // settings (halving again on every press) and collapsed spans to
        // wherever the walk happened to sit. settings also already carries
        // origin/genreRules/genreKitClean, so no provenance rescue is needed.
        const zeroWith = (mutate, said) => () => {
          const p = structuredClone(settings);
          mutate(p);
          loadParamsSnapshot(p);
          if (guidedTip) guidedTip.textContent = said;
        };
        // Every sequencer of a track, not just the first: `t.sequencer` is an
        // ALIAS of `t.sequencers[0]`, so clearing it alone left bars 2+ of a
        // multi-bar (typed/chained) track playing under a tip that said the
        // grids were cleared.
        const eachSequencer = (t, act) => {
          const list = Array.isArray(t.sequencers) && t.sequencers.length ? t.sequencers : [t.sequencer];
          for (const seq of list) { if (seq) act(seq); }
        };
        const clearSequencerSteps = (seq) => {
          const clearLane = (lane) => lane.forEach((step) => { step.on = false; });
          if (Array.isArray(seq.steps)) clearLane(seq.steps);
          else Object.values(seq.steps).forEach(clearLane);
        };
        document.getElementById('zero-voices')?.addEventListener('click', zeroWith((p) => {
          for (const [id, t] of Object.entries(p.tracks || {})) {
            if (DEFAULTS.tracks[id]?.voice) t.voice = DEFAULTS.tracks[id].voice;
            if (p.patches && p.patches[id]) delete p.patches[id];
          }
        }, 'Voices back to stock, patches cleared. Everything else kept.'));
        document.getElementById('zero-chords')?.addEventListener('click', zeroWith((p) => {
          // An array, not a string: the engine's seed sanitiser rejects a
          // bare string whole (audit major #5), which made this button a no-op.
          p.harmony = { ...(p.harmony || {}), seed: ['I'] };
        }, 'One chord: the loop is just I now. Everything else kept.'));
        document.getElementById('zero-notes')?.addEventListener('click', zeroWith((p) => {
          if (p.arp && Array.isArray(p.arp.steps)) p.arp.steps = p.arp.steps.map(() => false);
          for (const [id, t] of Object.entries(p.tracks || {})) {
            if (id === 'percussion' || !t.sequencer) continue;
            eachSequencer(t, (seq) => {
              seq.mode = 'manual';
              clearSequencerSteps(seq);
            });
          }
        }, 'Melodic grids cleared and set to Manual. Rhythms and chords kept.'));
        document.getElementById('zero-rhythms')?.addEventListener('click', zeroWith((p) => {
          p.swing = 0;
          const t = p.tracks && p.tracks.percussion;
          if (t && t.sequencer) {
            eachSequencer(t, (seq) => {
              seq.mode = 'manual';
              clearSequencerSteps(seq);
            });
          }
        }, 'Drum grid cleared, swing straight. Notes and chords kept.'));
        document.getElementById('zero-fx')?.addEventListener('click', zeroWith((p) => {
          p.reverbTail = 0.5;
          p.patches = p.patches && typeof p.patches === 'object' ? p.patches : {};
          for (const [id, t] of Object.entries(p.tracks || {})) {
            if (typeof t.voice !== 'string') continue;
            p.patches[id] = {
              ...(p.patches[id] || {}),
              [t.voice]: {
                ...((p.patches[id] || {})[t.voice] || {}),
                sends: { reverb: 0, delay: 0 },
              },
            };
          }
        }, 'Dry: room to its smallest, every send to zero. Notes untouched.'));

        // The instructions live in the ⓘ, not the panel (his rule).
        {
          const createInfo = document.getElementById('create-info');
          if (createInfo) {
            infoButton(
              createInfo,
              'create',
              'Blank slate silences and empties everything — instruments off, grids cleared, no genre, FX zeroed — so what follows is entirely yours: start from Blank slate or from a zero-AI preset to be eligible for a zero-AI badge. The Zero buttons strip ONE layer (voices, chords, notes, rhythms or FX) so any preset or genre can be your starting material. Tap a rhythm turns Space into a drum and writes your taps into the drum grid; the raw timing is kept, so Re-fit the last take can land the same performance on a new time signature or tempo. Seed voices borrows a genre\u2019s instruments without playing a note, and names what that genre\u2019s composers usually start with. Type the chords opens the chord editor, and Type a melody writes note names straight onto the melody grid \u2014 each plays exactly the note you name (C4 E4 G4, dash holds, dot rests). Words and MIDI-file import land next.'
            );
          }
          const typingInfo = document.getElementById('musical-typing-info');
          if (typingInfo) {
            infoButton(
              typingInfo,
              'musical typing',
              'Your computer keyboard plays the selected track: z x c v b n m are one octave and q w e r t y u the next, black keys on the rows above, - and = shift octave. A MIDI keyboard plays the same track the moment it is connected \u2014 nothing to set up (Chrome and Edge; iOS Safari has no MIDI). Capture records the rhythm, velocity and note length you play into that track\u2019s step grid \u2014 pitches follow the piece\u2019s own harmony \u2014 and Undo puts the old grid back.'
            );
          }
        }
        createSeed?.addEventListener('change', () => {
          const genre = GENRE_BY_SLUG.get(createSeed.value);
          if (!genre) return;
          const compiled = compileGenreParams(genre, (Math.random() * 0x7fffffff) | 0);
          const tracks = {};
          for (const [id, cfg] of Object.entries((compiled && compiled.tracks) || {})) {
            if (settings.tracks[id] && typeof cfg.voice === 'string') {
              tracks[id] = { voice: cfg.voice };
              settings.tracks[id].voice = cfg.voice;
            }
          }
          if (Object.keys(tracks).length) {
            engine.setParams({ tracks });
            persistSettings();
            syncUIFromSettings();
          }
          if (guidedTip) {
            guidedTip.textContent = (GENRE_START_WITH[genre.slug] ||
              'Start with whichever instrument pulls you.') +
              ' Voices are seeded; nothing plays until you switch an instrument on.';
          }
        });
        // Guided start, the fuller flow (his item 96): "ask if people want to
        // produce a certain genre (possibly giving them a genre tree, with
        // other as final answer with most) then let them know which
        // instruments composers in that genre most commonly start with. That
        // would help the many people who simply don't know where to start."
        //
        // Two questions, never more: the MOOD (the grouping the genre list
        // already uses, so nothing new has to be learned) and then the genre
        // inside it, with "Something else" at the end of each level exactly as
        // he asked. Answering seeds that genre's voices and names the
        // instrument its writers start with — the same seed path the picker
        // uses, so the guided route is not a second implementation.
        const guidedTree = document.getElementById('guided-tree');
        const guidedQuestion = document.getElementById('guided-question');
        const guidedChoices = document.getElementById('guided-choices');

        function closeGuidedTree() {
          if (!guidedTree) return;
          guidedTree.hidden = true;
          if (guidedChoices) guidedChoices.innerHTML = '';
        }

        function askGuided(question, choices) {
          if (!guidedTree || !guidedChoices || !guidedQuestion) return;
          guidedTree.hidden = false;
          guidedQuestion.textContent = question;
          guidedChoices.innerHTML = '';
          for (const choice of choices) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'secondary-button guided-choice';
            button.textContent = choice.label;
            button.addEventListener('click', choice.onPick);
            guidedChoices.append(button);
          }
          const first = guidedChoices.querySelector('button');
          try {
            first?.focus();
          } catch {}
        }

        /** Seed a genre's voices and say what its writers start with. */
        function guidedSeed(genre) {
          closeGuidedTree();
          if (!createSeed) return;
          createSeed.value = genre.slug;
          createSeed.dispatchEvent(new Event('change', { bubbles: true }));
        }

        function askGuidedGenre(mood) {
          const inMood = PUBLIC_GENRES.filter((genre) => moodOf(genre).id === mood.id);
          const choices = inMood.map((genre) => ({
            label: genre.name,
            onPick: () => guidedSeed(genre),
          }));
          choices.push({
            label: 'Something else',
            onPick: () => askGuidedMood(),
          });
          askGuided(
            inMood.length
              ? `${mood.label}: which of these is nearest?`
              : 'Nothing is listed under that yet — pick another feel:',
            inMood.length ? choices : [{ label: 'Back', onPick: () => askGuidedMood() }]
          );
        }

        function askGuidedMood() {
          const moods = MOODS.filter((mood) =>
            PUBLIC_GENRES.some((genre) => moodOf(genre).id === mood.id));
          const choices = moods.map((mood) => ({
            label: mood.label,
            onPick: () => askGuidedGenre(mood),
          }));
          // His "other as final answer with most": the last choice does not
          // dead-end — it offers every listed genre at once, then the ways in
          // that need no genre at all.
          choices.push({
            label: 'Something else',
            onPick: () => askGuided('Any of these, or start from nothing:', [
              ...PUBLIC_GENRES.map((genre) => ({
                label: genre.name,
                onPick: () => guidedSeed(genre),
              })),
              {
                label: 'No genre — I will just play',
                onPick: () => {
                  closeGuidedTree();
                  if (guidedTip) {
                    guidedTip.textContent =
                      'Nothing seeded. Three ways in with no genre at all: Tap a rhythm for a groove, '
                      + 'Type the chords for harmony, or the keys below for a tune.';
                  }
                },
              },
            ]),
          });
          askGuided('What do you want to make? Pick the nearest feel:', choices);
        }

        document.getElementById('guided-start')?.addEventListener('click', () => {
          if (guidedTree && !guidedTree.hidden) {
            closeGuidedTree();
            return;
          }
          if (guidedTip) guidedTip.textContent = '';
          askGuidedMood();
        });

        // v0.0.110 — typed melody (his compose list: "type in notes/chords/
        // words"). One token per BEAT: a note name writes a PINNED step (the
        // v0.0.109 schema), a dash holds the note through the next beat, a
        // dot rests it. One bar per write — the grid's own span — and the
        // writer says what it wrote and what it dropped.
        // v0.0.134 (his item 96: "MIDI file import is a compose option IMHO,
        // the assumption is that the user composed the MIDI in another app").
        // The file's notes land as PINNED steps on the chosen track's grid, at
        // the track's own resolution, chained bar by bar — the same machinery
        // typed melody uses, so an imported piece is as editable as a typed
        // one. Everything the import could not fit is REPORTED: a chord
        // collapsing to one note per slot is a fact about a step grid, not
        // something to hide.
        const midiInput = document.getElementById('compose-midi');
        const midiTrackSelect = document.getElementById('compose-midi-track');
        let midiModule = null;

        function renderMidiTracks() {
          if (!midiTrackSelect) return;
          const wanted = midiTrackSelect.value;
          midiTrackSelect.innerHTML = '';
          for (const id of SEQ_TRACKS) {
            const option = document.createElement('option');
            option.value = id;
            option.textContent = TRACK_LABELS[id] || id;
            midiTrackSelect.append(option);
          }
          midiTrackSelect.value = SEQ_TRACKS.includes(wanted) ? wanted : 'melody';
        }
        renderMidiTracks();
        if (typeof engine.on === 'function') engine.on('tracks', renderMidiTracks);
        describe(midiTrackSelect, 'Which instrument the file is imported onto.');

        async function importMidiFile(file) {
          const say = (text) => { if (guidedTip) guidedTip.textContent = text; };
          if (!file) return;
          if (!midiModule) {
            try {
              midiModule = await import('../scripts/midi-file.js');
            } catch {
              say('The MIDI reader could not load — reload the page and try again.');
              return;
            }
          }
          let parsed;
          try {
            const bytes = new Uint8Array(await file.arrayBuffer());
            parsed = midiModule.parseMidiFile(bytes);
          } catch (error) {
            // The reader refuses two file kinds with a reason a musician can
            // act on (format 2, SMPTE timing); anything else is a bad file.
            say(`That file could not be read: ${error && error.message ? error.message : 'unknown format'}.`);
            return;
          }
          if (!parsed.notes.length) {
            say('That file has no notes in it.');
            return;
          }
          const track = SEQ_TRACKS.includes(midiTrackSelect.value) ? midiTrackSelect.value : 'melody';
          const stepBeats = trackStepBeats(track);
          const slotsPerBar = stepsPerBarFor(track);
          const fitted = midiModule.notesToBars(parsed.notes, {
            stepBeats,
            slotsPerBar,
            maxBars: 8,
          });
          if (!fitted.bars.length) {
            say('Nothing in that file fitted the grid.');
            return;
          }
          const blank = () => ({ on: false, prob: 1, vmin: 0.6, vmax: 0.8 });
          const laneLength = engineModule && typeof engineModule.laneSlotsFor === 'function'
            ? engineModule.laneSlotsFor(stepBeats)
            : 20;
          const list = fitted.bars.map((barSteps) => {
            const steps = Array.from({ length: laneLength }, blank);
            for (const record of barSteps) {
              if (record.slot >= steps.length) continue;
              steps[record.slot] = {
                on: true,
                prob: 1,
                vmin: clamp(record.velocity, 0.05, 1),
                vmax: clamp(record.velocity, 0.05, 1),
                midi: record.midi,
                ...(Math.abs(record.gate - 1) > 0.01 ? { gate: record.gate } : {}),
              };
            }
            return { mode: 'manual', weights: fitted.bars.map(() => 1), steps };
          });
          const settingsTrack = settings.tracks[track];
          settingsTrack.sequencers = list;
          settingsTrack.sequencer = list[0];
          if (list.length > 1) settingsTrack.sequencerAdvance = 'chain';
          else delete settingsTrack.sequencerAdvance;
          if (settingsTrack.state === 'off') settingsTrack.state = 'on';
          engine.setParams({
            tracks: {
              [track]: {
                state: settingsTrack.state,
                sequencers: structuredClone(list),
                sequencerAdvance: list.length > 1 ? 'chain' : null,
              },
            },
          });
          adoptEngineSequencers(track);
          syncTrackStateUI();
          persistSettings();
          const label = TRACK_LABELS[track] || track;
          const notes = [`Imported ${fitted.written} note${fitted.written === 1 ? '' : 's'} onto ${label},`
            + ` ${fitted.bars.length} bar${fitted.bars.length === 1 ? '' : 's'}`
            + (list.length > 1 ? ' played in order' : '') + '.'];
          if (fitted.collapsed) {
            notes.push(`${fitted.collapsed} note${fitted.collapsed === 1 ? '' : 's'} shared a step with another`
              + ' — a grid step holds one note, so the highest won.');
          }
          if (fitted.dropped) {
            notes.push(`${fitted.dropped} went past eight bars and were left out.`);
          }
          if (parsed.tempoBpm) notes.push(`The file says ${parsed.tempoBpm} bpm.`);
          if (parsed.timeSignature && parsed.timeSignature !== settings.timeSignature) {
            notes.push(`It is written in ${parsed.timeSignature}; this piece is in ${settings.timeSignature}.`);
          }
          say(notes.join(' '));
        }

        midiInput?.addEventListener('change', () => {
          const file = midiInput.files && midiInput.files[0];
          importMidiFile(file);
          midiInput.value = ''; // so the same file can be imported again
        });
        describe(
          document.querySelector('.create-midi-label'),
          'Import a MIDI file you composed elsewhere. Its notes land on the chosen instrument\u2019s grid as pinned steps at the grid\u2019s current resolution, one bar per tab played in order, and anything that could not fit is reported.'
        );

        const melodyText = document.getElementById('compose-melody-text');
        const melodyWrite = document.getElementById('compose-melody-write');

        function writeTypedMelody() {
          const raw = (melodyText?.value || '').trim();
          if (!raw) return;
          const tokens = raw.split(/[\s,|]+/).filter(Boolean);
          const slotsPerBar = stepsPerBarFor('melody');
          const beats = Math.floor(slotsPerBar / 4);
          // A writer that REPLACES a lane says null out loud where a step has
          // nothing — the engine's tie/gate/group/midi are sticky by design
          // (the same discipline explicitStep documents for captures), so a
          // bare blank would silently inherit whatever pins, ties or groups
          // the previous grid had, and the piece the engine plays would no
          // longer be the piece the page shows or saves.
          const blank = () => ({
            on: false, prob: 1, vmin: 0.6, vmax: 0.8,
            tie: false, gate: null, group: null, midi: null,
          });
          // v0.0.116: a phrase longer than a bar writes MORE BARS — one
          // sequencer each, chained in order (the engine's chain mode), so a
          // typed melody of any length plays back as composed. Cap at eight
          // bars, saying so.
          const MAX_BARS = 8;
          const bars = [Array.from({ length: 20 }, blank)];
          let beat = 0;
          let lastRef = null; // { bar, slot } of the previous NOTE, for holds
          let written = 0;
          const dropped = [];
          const barBeat = () => beat % beats;
          const barIndex = () => Math.floor(beat / beats);
          const ensureBar = () => {
            while (bars.length <= barIndex() && bars.length < MAX_BARS) {
              bars.push(Array.from({ length: 20 }, blank));
            }
            return barIndex() < MAX_BARS;
          };
          for (const token of tokens) {
            if (!ensureBar()) { dropped.push(token); continue; }
            const steps = bars[barIndex()];
            if (token === '.' || token.toLowerCase() === 'r') {
              lastRef = null;
              beat += 1;
              continue;
            }
            if (token === '-') {
              // Hold: tie through this beat. Within one bar it ties slots;
              // across a barline it re-states the note tied through the new
              // bar's beat (a lane cannot tie into the next sequencer).
              if (lastRef !== null) {
                const midi = bars[lastRef.bar][lastRef.slot].midi;
                const from = lastRef.bar === barIndex() ? lastRef.slot : barBeat() * 4;
                if (lastRef.bar !== barIndex() && !steps[from].on) {
                  steps[from] = { ...blank(), on: true, midi };
                  lastRef = { bar: barIndex(), slot: from };
                }
                for (let s = from; s < (barBeat() + 1) * 4 - 1 && s < 19; s++) {
                  if (!steps[s].on) { steps[s].on = true; steps[s].midi = midi; }
                  steps[s].tie = true;
                  if (!steps[s + 1].on) {
                    steps[s + 1] = { ...blank(), on: true, midi };
                  }
                }
              }
              beat += 1;
              continue;
            }
            const midi = parseNoteNameToMidi(token);
            if (midi === null) { dropped.push(token); continue; }
            const slot = barBeat() * 4;
            steps[slot] = { ...blank(), on: true, midi };
            lastRef = { bar: barIndex(), slot };
            written += 1;
            beat += 1;
          }
          if (!written) {
            if (guidedTip) guidedTip.textContent = 'No notes understood — write note names like C4, E♭4, G3; dash holds, dot rests.';
            return;
          }
          const track = settings.tracks.melody;
          const list = bars.map((steps) => ({
            mode: 'manual',
            weights: bars.map(() => 1),
            steps,
          }));
          track.sequencers = list;
          track.sequencer = list[0];
          if (bars.length > 1) track.sequencerAdvance = 'chain';
          if (track.state === 'off') track.state = 'on';
          engine.setParams({
            tracks: {
              melody: {
                state: track.state,
                sequencers: structuredClone(list),
                ...(bars.length > 1 ? { sequencerAdvance: 'chain' } : {}),
              },
            },
          });
          syncTrackStateUI();
          const editor = document.getElementById('voice-editor-melody');
          if (editor && !editor.hidden) renderVoiceEditor('melody');
          persistSettings();
          if (guidedTip) {
            guidedTip.textContent =
              `Melody written: ${written} note${written === 1 ? '' : 's'} across ` +
              `${bars.length} bar${bars.length === 1 ? '' : 's'}` +
              (bars.length > 1 ? ' (played in order)' : '') +
              (dropped.length ? ` — dropped: ${dropped.join(' ')} (eight bars is the cap).` : '.');
          }
        }

        melodyWrite?.addEventListener('click', writeTypedMelody);
        melodyText?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            writeTypedMelody();
          }
        });
        describe(melodyWrite, 'Writes the typed notes onto the melody grid as PINNED steps — each plays exactly the note you named. One token per beat: C4, then - to hold it, . to rest.');

                composeChords?.addEventListener('click', () => {
          activateTab('advanced', { focus: false });
          document.getElementById('control-progression')?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        });

        // Tap a rhythm (his item 96, and 89's "space bar or button"): one
        // press points the keys at the kit, arms them and arms Capture, so
        // every Space tap sounds AND lands in the drum grid at its current
        // resolution. Press again to stop; Capture reports what it wrote.
        const createTap = document.getElementById('create-tap');
        createTap?.addEventListener('click', () => {
          tapMode = !tapMode;
          createTap.setAttribute('aria-pressed', String(tapMode));
          if (tapMode) {
            if (TRACK_IDS.includes('percussion')) playAlongTrack.value = 'percussion';
            if (!playAlongOn) setPlayAlong(true);
            setPlayAlongUI();
            // AUDIT FIX: tapping re-points the KEYS at percussion, so an
            // already-armed capture on another track must re-point too — it
            // records nothing the keys are now playing, and every Space tap
            // was silently discarded.
            if (canCapture(playAlongTarget())) {
              const armed = captureState();
              if (!armed.armed) captureButton.click();
              else if (armed.track !== playAlongTarget()) {
                try {
                  engine.armCapture(playAlongTarget());
                } catch {}
                setPlayAlongUI();
              }
            }
            if (guidedTip) {
              guidedTip.textContent =
                'Tap Space — each tap sounds the kit and Capture writes it into the drum grid. Press the button again to stop.';
            }
          } else {
            endCapture();
          }
        });

        // v0.0.107 (his "keep the raw tap data so the user can re-quantise"):
        // the raw take survives in the engine; this lands it on whatever grid
        // is CURRENT — change the time signature or tempo first, then re-fit.
        const createRefit = document.getElementById('create-refit');
        createRefit?.addEventListener('click', () => {
          let result = null;
          try {
            result = engine.requantiseCapture();
          } catch {}
          if (result && result.written) {
            adoptEngineSequencers(result.track);
            if (guidedTip) {
              guidedTip.textContent = `Re-fitted: ${result.written} notes landed on the current grid.`;
            }
          } else if (guidedTip) {
            guidedTip.textContent = 'Nothing to re-fit yet — tap or capture a take first.';
          }
          setPlayAlongUI();
        });
        describe(createRefit, 'Lands your last take on the grid as it is NOW — change the time signature or tempo first, and the raw timing you played is re-fitted to it.');
      }

      setupPopover('timers-toggle', 'timers-popover');
      // v0.0.84 (his item 95): closing the popover no longer disarms the
      // keys — the popover toggles keyboard-playing and its close is just a
      // close. The old worry (stray keystrokes making noise with nothing on
      // screen to explain why) is answered by the icon: it stays pressed and
      // orange while the keys are live, so the state IS on screen.
      //
      // TAP MODE is different from the keys and does not get item 95's pass:
      // it remaps Space — a key with a job on every focused button — and
      // holds a Capture armed, and both were surviving the close with
      // NOTHING on screen saying so (the pressed Tap button is inside the
      // shut panel). Closing the panel stands tap mode down; the keys stay
      // armed exactly as he asked.
      setupPopover('play-along-open', 'play-along', {
        onClose: () => {
          const tapButton = document.getElementById('create-tap');
          if (tapMode && tapButton) tapButton.click();
        },
      });

      let sleepTarget = null; // epoch ms
      let alarmTarget = null; // epoch ms
      let tickHandle = null;
      let alarmNotice = '';

      function formatCountdown(ms) {
        const total = Math.max(0, Math.round(ms / 1000));
        const h = Math.floor(total / 3600);
        const m = Math.floor((total % 3600) / 60);
        const s = total % 60;
        const pad = (n) => String(n).padStart(2, '0');
        return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
      }

      // Hiding the row that currently holds focus (e.g. clicking "Start" in
      // sleep-idle, which then hides sleep-idle for sleep-active) drops
      // focus to <body>, breaking Esc/Tab-wrap in the still-open popover.
      // If that happened, move focus into the newly-visible counterpart.
      function swapTimerRow(idleEl, activeEl, isActive) {
        const focusWasInside = idleEl.contains(document.activeElement) || activeEl.contains(document.activeElement);
        idleEl.hidden = isActive;
        activeEl.hidden = !isActive;
        if (focusWasInside && document.activeElement === document.body) {
          const visible = isActive ? activeEl : idleEl;
          const target = visible.querySelector(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          );
          if (target) {
            try {
              target.focus();
            } catch {}
          }
        }
      }

      function updateTimerUI() {
        const now = Date.now();
        swapTimerRow(sleepIdle, sleepActive, sleepTarget !== null);
        swapTimerRow(alarmIdle, alarmActive, alarmTarget !== null);
        sleepChip.hidden = sleepTarget === null;
        if (sleepTarget !== null) sleepChip.textContent = formatCountdown(sleepTarget - now);
        alarmChip.hidden = alarmTarget === null;
        if (alarmTarget !== null) alarmChip.textContent = formatCountdown(alarmTarget - now);
        const bits = [];
        if (sleepTarget !== null) {
          const text = `Fades out in ${formatCountdown(sleepTarget - now)}`;
          sleepCountdown.textContent = text;
          bits.push(`Sleep: ${formatCountdown(sleepTarget - now)}`);
        }
        if (alarmTarget !== null) {
          const at = new Date(alarmTarget);
          const pad = (n) => String(n).padStart(2, '0');
          const hhmm = `${pad(at.getHours())}:${pad(at.getMinutes())}`;
          alarmCountdown.textContent = `Starts at ${hhmm} (in ${formatCountdown(alarmTarget - now)})`;
          bits.push(`Alarm: ${hhmm}`);
        }
        if (alarmNotice) bits.push(alarmNotice);
        if (playNotice) bits.push(playNotice);
        transportStatus.textContent = bits.join(' · ');
      }

      // Re-check the wall clock every second rather than one long
      // setTimeout, so laptop sleep can't silently skip the target. The tick
      // runs in an inline-blob Web Worker: hidden silent tabs get main-thread
      // timers clamped to once a minute (Chrome intensive throttling), which
      // would fire the alarm up to a minute late — worker timers aren't
      // clamped that hard. Falls back to setInterval where workers fail.
      let tickWorkerURL = null;

      function ensureTicker() {
        if (sleepTarget === null && alarmTarget === null) return;
        if (tickHandle !== null) return;
        try {
          tickWorkerURL = URL.createObjectURL(
            new Blob(['setInterval(function () { postMessage(0); }, 1000);'], {
              type: 'text/javascript',
            })
          );
          const worker = new Worker(tickWorkerURL);
          worker.onmessage = () => tick();
          tickHandle = { worker };
        } catch {
          if (tickWorkerURL !== null) {
            URL.revokeObjectURL(tickWorkerURL);
            tickWorkerURL = null;
          }
          tickHandle = { interval: setInterval(tick, 1000) };
        }
      }

      function idleTickerIfDone() {
        if (tickHandle === null || sleepTarget !== null || alarmTarget !== null) return;
        if (tickHandle.worker) tickHandle.worker.terminate();
        if (tickHandle.interval) clearInterval(tickHandle.interval);
        tickHandle = null;
        if (tickWorkerURL !== null) {
          URL.revokeObjectURL(tickWorkerURL);
          tickWorkerURL = null;
        }
      }

      // Keep the screen on ONLY while an alarm is armed — a sleeping device
      // can't fire it. Ordinary playback takes no lock.
      let wakeLock = null;

      function acquireWakeLock() {
        if (alarmTarget === null || wakeLock !== null) return;
        if (!('wakeLock' in navigator) || typeof navigator.wakeLock.request !== 'function') return;
        navigator.wakeLock
          .request('screen')
          .then((lock) => {
            if (alarmTarget === null) {
              Promise.resolve(lock.release()).catch(() => {});
              return;
            }
            wakeLock = lock;
            // The OS can revoke it (tab hidden); we re-request on visible.
            lock.addEventListener('release', () => {
              if (wakeLock === lock) wakeLock = null;
            });
          })
          .catch(() => {});
      }

      function releaseWakeLock() {
        if (wakeLock === null) return;
        Promise.resolve(wakeLock.release()).catch(() => {});
        wakeLock = null;
      }

      function tick() {
        const now = Date.now();
        if (sleepTarget !== null && now >= sleepTarget) {
          sleepTarget = null;
          if (engine.running) finishOrStop();
        }
        if (alarmTarget !== null && now >= alarmTarget) {
          alarmTarget = null;
          releaseWakeLock();
          // AUDIT FIX: an exact-pause engine is still "running" while held,
          // so a due alarm nulled its target and started NOTHING — it
          // self-destructed silently. An alarm start is a new piece: release
          // the hold and fall through to the fresh start below.
          if (engine.running && paused) {
            try {
              engine.stop();
            } catch {}
            clearPaused();
          }
          if (!engine.running) {
            clearPaused(); // an alarm start is a new piece, never a resume
            engine
              .start()
              .then(() => {
                alarmNotice = '';
                setTransportUI();
                updateTimerUI();
                setupMediaSession();
                // A start() in a throttled background tab can resolve with
                // the context still effectively suspended; poke it once it
                // should be audible. resume() is an idempotent context-poke.
                setTimeout(() => {
                  if (engine.running && typeof engine.resume === 'function') {
                    try {
                      // resume() can silently rebuildContext() (fresh
                      // analyser nodes) without a 'state' event — re-check
                      // any open scope's live analyser once it settles.
                      Promise.resolve(engine.resume()).then(updateAllScopeModes).catch(() => {});
                    } catch {}
                  }
                }, 1500);
              })
              .catch(() => {
                alarmNotice = 'Couldn’t start automatically — press Play.';
                updateTimerUI();
              });
          }
        }
        updateTimerUI();
        idleTickerIfDone();
      }

      function startSleepTimer(minutes) {
        if (!Number.isFinite(minutes) || minutes <= 0) return;
        sleepTarget = Date.now() + minutes * 60000;
        ensureTicker();
        updateTimerUI();
      }

      function cancelAlarm() {
        alarmTarget = null;
        alarmNotice = '';
        releaseWakeLock();
        updateTimerUI();
        idleTickerIfDone();
      }

      for (const button of document.querySelectorAll('.sleep-preset')) {
        button.addEventListener('click', () => {
          startSleepTimer(parseInt(button.dataset.minutes, 10));
        });
      }

      document.getElementById('sleep-start').addEventListener('click', () => {
        startSleepTimer(parseInt(sleepCustom.value, 10));
      });

      document.getElementById('sleep-cancel').addEventListener('click', () => {
        sleepTarget = null;
        updateTimerUI();
        idleTickerIfDone();
      });

      document.getElementById('alarm-set').addEventListener('click', () => {
        const value = alarmTimeInput.value;
        if (!value) return;
        // arm() from this user gesture so start() can later succeed outside
        // one. Feature-detect: an older engine has no arm() — we still set
        // the timer and let start() try.
        if (typeof engine.arm === 'function') engine.arm();
        const [h, m] = value.split(':').map(Number);
        const target = new Date();
        target.setHours(h, m, 0, 0);
        if (target.getTime() <= Date.now()) target.setDate(target.getDate() + 1);
        alarmTarget = target.getTime();
        alarmNotice = '';
        acquireWakeLock();
        ensureTicker();
        updateTimerUI();
      });

      document.getElementById('alarm-cancel').addEventListener('click', cancelAlarm);

      // ---- lifecycle recovery (throttled tabs, bfcache, iOS interrupts) --

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState !== 'visible') return;
        // Timers may have been clamped while hidden — re-check immediately.
        if (sleepTarget !== null || alarmTarget !== null) tick();
        if (alarmTarget !== null) acquireWakeLock();
        // v26: never while PAUSED — resume() is also the un-pause call, so an
        // unattended context-poke would restart a piece the listener held.
        if (engine.running && !paused) {
          // Recovers iOS 'interrupted' contexts once the engine ships
          // resume() — which can rebuildContext() (fresh analyser nodes)
          // without emitting a 'state' event, so re-evaluate any open
          // scope's live analyser once resume() settles.
          try {
            Promise.resolve(engine.resume?.()).then(updateAllScopeModes).catch(() => {});
          } catch {}
        }
      });

      window.addEventListener('focus', () => {
        if (engine.running && !paused) {
          try {
            Promise.resolve(engine.resume?.()).then(updateAllScopeModes).catch(() => {});
          } catch {}
        }
      });

      window.addEventListener('pagehide', () => {
        flushPersistSettings();
        try {
          engine.stop();
        } catch {}
      });

      window.addEventListener('pageshow', (event) => {
        // Restored from bfcache with the audio graph gone — show stopped UI.
        if (event.persisted) {
          clearPaused();
          finishing = false;
          setTransportUI();
        }
      });

      // ---- presets -------------------------------------------------------

      const presetName = document.getElementById('preset-name');
      const presetLoad = document.getElementById('preset-load');
      const presetSave = document.getElementById('preset-save');
      const presetDelete = document.getElementById('preset-delete');
      const presetSubmit = document.getElementById('preset-submit');
      const presetCopy = document.getElementById('preset-copy');
      const presetShare = document.getElementById('preset-share');
      const shareNote = document.getElementById('share-note');
      const shareNameValue = document.getElementById('share-name-value');

      /**
       * The reserved line under the Share row. It is never hidden and never
       * empty — an em dash holds the space before there is a name — so a name
       * appearing cannot push the fieldset around under the cursor.
       */
      function setShareName(name) {
        if (shareNameValue) shareNameValue.textContent = name || '—';
      }

      let presets = [];
      try {
        const stored = prefs.get('presets');
        if (Array.isArray(stored)) presets = stored;
      } catch {}

      function paramsSnapshot() {
        const s = structuredClone(settings);
        delete s.ui;
        // Session-local bookkeeping, like ui: the Energy follow's provenance
        // string is ~10 KB of kit JSON that was riding every share link,
        // undo entry and preset. It is recomputed where it matters
        // (recordCleanGenreKit after a genre apply) and a loaded snapshot
        // rightly stands the follow down.
        delete s.genreKitClean;
        return s;
      }

      /**
       * The same snapshot, minus the two REDUNDANT mirrors the normaliser
       * rebuilds on load: `tracks[t].sequencers` when it holds a single
       * sequencer (identical to `tracks[t].sequencer`), and the legacy
       * `arp.steps` boolean mask (re-derived from the arp sequencer). Both are
       * long arrays, and a share link is a URL somebody has to paste — this
       * roughly halves it, losslessly.
       */
      /**
       * v0.0.79 — what a share link actually carries: the origin plus a diff,
       * falling back to the whole tree only when the origin cannot rebuild a
       * base. Same shape and same reasoning as submissionPayload; the
       * difference is only in the key names, which are one letter each because
       * this one rides in a URL somebody has to paste.
       */
      function sharePayload() {
        const base = originBase();
        if (!base) return shareSnapshot();
        const compact = {
          [SHARE_ORIGIN_KEY]: originSnapshot(),
          [SHARE_DIFF_KEY]: diffTree(base, paramsSnapshot()),
        };
        // A safety net rather than an optimisation: if the diff somehow came
        // out bigger than the tree it was diffed against, send the tree. The
        // whole point of this change is that a link stays paste-able.
        const full = shareSnapshot();
        return JSON.stringify(compact).length < JSON.stringify(full).length ? compact : full;
      }

      function shareSnapshot() {
        const s = paramsSnapshot();
        for (const id of SEQ_TRACKS) {
          const track = s.tracks[id];
          if (Array.isArray(track.sequencers) && track.sequencers.length <= 1) {
            delete track.sequencers;
          }
        }
        delete s.arp.steps;
        return s;
      }

      function persistPresets() {
        persistKey('presets', presets);
      }

      function refreshPresetSelect(selectedName) {
        presetLoad.innerHTML = '';
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Load preset…';
        presetLoad.append(placeholder);
        presets.forEach((preset, index) => {
          const opt = document.createElement('option');
          opt.value = String(index);
          opt.textContent = preset.name;
          if (preset.name === selectedName) opt.selected = true;
          presetLoad.append(opt);
        });
      }

      presetSave.addEventListener('click', () => {
        const name = presetName.value.trim() || 'Untitled';
        const entry = { name, params: paramsSnapshot() };
        const existing = presets.findIndex((p) => p.name === name);
        if (existing >= 0) presets[existing] = entry;
        else presets.push(entry);
        persistPresets();
        refreshPresetSelect(name);
      });

      /**
       * Load a params snapshot (user preset or factory preset) as the live
       * settings. Same migration/normalisation order as the init load path: a
       * pre-v6 snapshot needs its arp mask mapped to a sequencer BEFORE the
       * deepMerge, and every lane needs padding to SEQ_SLOTS right after —
       * skipping either step leaves laneSteps()[i] undefined and throws
       * inside the un-awaited renderVoiceEditor triggered by syncUIFromSettings.
       */
      function loadParamsSnapshot(params) {
        const ui = settings.ui;
        const clone = structuredClone(params);
        migrateLegacyArpSteps(clone);
        settings = deepMerge(DEFAULTS, clone);
        normaliseV6Tracks(settings);
        settings.ui = ui;
        engine.setParams(engineParamsFrom(settings));
        syncUIFromSettings();
        applyDensityScale();
        persistSettings();
      }

      presetLoad.addEventListener('change', () => {
        const index = parseInt(presetLoad.value, 10);
        const preset = presets[index];
        if (!preset) return;
        loadParamsSnapshot(preset.params);
        presetName.value = preset.name;
      });

      // ---- blank slate (owner request, fromMartin 25) ---------------------
      // Everything silent and empty: every track off, every sequencer lane
      // cleared and pinned to Manual (so nothing auto-composes back in), no
      // arp steps, no genre, zero swing/complexity/repetition. What plays
      // after this is only what the user builds. Groundwork for the AI-free
      // pledge on listed presets/albums.
      function buildBlankParams() {
        const blank = structuredClone(DEFAULTS);
        blank.swing = 0;
        blank.complexity = 0;
        blank.repetition = 0;
        blank.arp.steps = new Array(16).fill(false);
        // v0.0.89 (his 103): blank means the FX too — he pressed Blank slate
        // and "still [had] massive reverb and delay", because the voices'
        // default sends and the room survived. Room to its smallest, every
        // default voice's sends to zero.
        blank.reverbTail = 0.5;
        blank.patches = blank.patches && typeof blank.patches === 'object' ? blank.patches : {};
        // The user's own tracks survive a Blank slate and are silenced with
        // everything else — the button empties the piece, it does not delete
        // the instruments the listener built.
        keepUserTracks(blank);
        for (const track of Object.keys(blank.tracks)) {
          const t = blank.tracks[track];
          t.state = 'off';
          t.randomness = 0;
          if (typeof t.voice === 'string') {
            blank.patches[track] = {
              ...(blank.patches[track] || {}),
              [t.voice]: {
                ...((blank.patches[track] || {})[t.voice] || {}),
                sends: { reverb: 0, delay: 0 },
              },
            };
          }
          if (t.sequencer) {
            t.sequencer.mode = 'manual';
            const clearLane = (lane) => lane.forEach((step) => { step.on = false; });
            if (Array.isArray(t.sequencer.steps)) clearLane(t.sequencer.steps);
            else Object.values(t.sequencer.steps).forEach(clearLane);
          }
        }
        return blank;
      }
      const blankSlate = document.getElementById('blank-slate');
      if (blankSlate) {
        describe(
          blankSlate,
          'Silence everything: all tracks off, all sequencers cleared and set to Manual, no genre. ' +
            'Whatever plays after this is entirely yours.'
        );
        blankSlate.addEventListener('click', () => {
          loadParamsSnapshot(buildBlankParams());
          clearGenreTag();
          presetName.value = '';
        });
      }

      // ---- factory preset gallery ----------------------------------------
      // A loaded factory preset is ordinary settings from that moment on:
      // every dial, track and editor behaves exactly as if the user had
      // dialled it in by hand.
      const factoryRow = document.getElementById('factory-preset-row');
      if (factoryRow) {
        for (const preset of FACTORY_PRESETS) {
          const card = document.createElement('button');
          card.type = 'button';
          card.className = 'secondary-button factory-preset';
          const name = document.createElement('span');
          name.className = 'factory-preset-name';
          name.textContent = preset.name;
          const blurb = document.createElement('span');
          blurb.className = 'factory-preset-blurb';
          blurb.textContent = preset.oneLiner ?? '';
          card.append(name, blurb);
          // v16: the rationale — WHY this preset is shaped the way it is — is
          // the card's tooltip rather than more text on the card itself.
          // v26: and the genre consequence, because a preset is a fixed
          // params snapshot — loading one leaves the params it carries, so
          // the genre tag it did not come from is cleared rather than left
          // claiming a piece it no longer describes.
          const rationale = [preset.rationale, 'Loading a preset clears the genre.']
            .filter(Boolean)
            .join(' ');
          describe(card, rationale);
          card.addEventListener('click', () => {
            loadParamsSnapshot(preset.params);
            presetName.value = preset.name;
          });
          factoryRow.append(card);
        }
      }

      // Advanced keeps its way in: the gallery itself lives on Simple now
      // (v16), so this jumps tabs and puts the focus on the first card.
      document.getElementById('factory-presets-jump')?.addEventListener('click', () => {
        activateTab('simple');
        const panel = document.getElementById('factory-presets');
        const first = factoryRow?.querySelector('.factory-preset');
        (first || panel)?.focus?.();
        panel?.scrollIntoView?.({ block: 'nearest' });
      });

      presetDelete.addEventListener('click', () => {
        const index = parseInt(presetLoad.value, 10);
        if (!Number.isFinite(index) || !presets[index]) return;
        presets.splice(index, 1);
        persistPresets();
        refreshPresetSelect();
      });

      /**
       * v0.0.62 — a preset is a BASE plus what you changed, not a settings dump.
       *
       * The owner hit the wall this exists to remove: Submit built a URL out of
       * the entire settings tree and it came to 115,897 characters. Browsers
       * cap a URL somewhere between two and eight thousand, and Cloudflare
       * closes the connection on a long one — which is exactly the
       * ERR_CONNECTION_CLOSED he saw. His fix, and it is the right one: "take
       * the preset or genre that the preset is based on and send an ID of that
       * and a diff. That will also give provenance of presets and should give
       * you an idea of which can be considered AI-free."
       *
       * `settings.origin` is that anchor. A genre compile is deterministic in
       * (slug, seed), so those two numbers reproduce the base byte for byte
       * without shipping any of it — which is what makes the diff meaningful
       * rather than just smaller.
       *
       * Provenance falls out of it for free: a submission says what it grew
       * from and exactly how far it moved. So does the AI-free question — a
       * piece that is one of our own genres plus a human's edits is a very
       * different object from one that arrived as an opaque settings blob, and
       * until now the two were indistinguishable on arrival.
       */
      function originSnapshot() {
        const o = settings && isPlainObject(settings.origin) ? settings.origin : null;
        if (!o || typeof o.kind !== 'string') return { kind: 'unknown' };
        return { ...o };
      }

      /** The settings tree the current origin reproduces, or null if it cannot. */
      function originBase() {
        return baseFromOrigin(originSnapshot());
      }

      /**
       * The settings tree a given origin reproduces, or null if it cannot.
       * Split out from originBase so the share DECODER can reach it: a link
       * arrives long before the submission code exists, and it needs the same
       * rebuild rather than a second copy of it.
       */
      function baseFromOrigin(origin) {
        const o = isPlainObject(origin) && typeof origin.kind === 'string'
          ? { ...origin }
          : { kind: 'unknown' };
        if (o.kind === 'genre' && typeof o.id === 'string' && Number.isFinite(o.seed)) {
          const genre = GENRE_BY_SLUG.get(o.id);
          // Origins stamped `kit: 1` were compiled with the genre's own
          // Energy shaping the kit (compileGenreShaped); rebuilding them any
          // other way would put the whole kit into every diff. Links minted
          // before the stamp rebuild exactly as they always did.
          const compiled = !genre ? null
            : Number.isFinite(o.kitAt) ? compileGenreParams(genre, o.seed, { kitComplexity: o.kitAt })
            : o.kit === 1 ? compileGenreShapedLegacy(genre, o.seed)
            : compileGenreParams(genre, o.seed);
          if (!compiled) return null;
          // Rebuilt through the SAME pipeline a genre takes when it is
          // applied — deepMerge onto DEFAULTS, then normaliseV6Tracks. Skip
          // the normalise step and the base differs from the live tree in
          // every field the normaliser rebuilds (per-track sequencer mirrors,
          // kit lanes, arp steps), which turns a three-dial edit into a diff
          // of the whole tree.
          // AUDIT FIX: the base injected THIS session's user tracks through
          // keepUserTracks — so a sender's custom tracks vanished from the
          // diff (the link silently dropped them) and a receiver's own
          // tracks were smuggled into the sender's piece. A share base is a
          // pure function of the origin, and now it is.
          const base = deepMerge(DEFAULTS, settingsFromGenre(compiled, o.id, { keepUser: false }));
          normaliseV6Tracks(base);
          base.origin = { kind: 'genre', id: o.id, seed: o.seed };
          if (o.kit === 1) base.origin.kit = 1;
          if (Number.isFinite(o.kitAt)) base.origin.kitAt = o.kitAt;
          delete base.ui;
          return base;
        }
        if (o.kind === 'blank' || o.kind === 'unknown') {
          const base = deepMerge(DEFAULTS, {});
          normaliseV6Tracks(base);
          base.origin = { ...o };
          delete base.ui;
          return base;
        }
        return null;
      }

      /**
       * A sparse tree of everything in `now` that differs from `base`.
       *
       * Arrays are all-or-nothing: a step grid or a block list is a shape, and
       * half of one is not a smaller version of it, it is a different thing.
       * A key absent from the result means "unchanged", which is why the
       * decoder must apply a diff onto a freshly rebuilt base rather than onto
       * whatever the recipient happens to be playing.
       */
      function diffTree(base, now) {
        if (!isPlainObject(base) || !isPlainObject(now)) {
          return JSON.stringify(base) === JSON.stringify(now) ? undefined : now;
        }
        const out = {};
        for (const key of Object.keys(now)) {
          const a = base[key];
          const b = now[key];
          if (Array.isArray(a) || Array.isArray(b)) {
            if (JSON.stringify(a) !== JSON.stringify(b)) out[key] = b;
            continue;
          }
          if (isPlainObject(a) && isPlainObject(b)) {
            const nested = diffTree(a, b);
            if (nested !== undefined && Object.keys(nested).length) out[key] = nested;
            continue;
          }
          if (JSON.stringify(a) !== JSON.stringify(b)) out[key] = b;
        }
        // A key the base has and the current tree does not is a real removal,
        // and silence about it would restore it on decode.
        for (const key of Object.keys(base)) {
          if (!(key in now)) out[key] = null;
        }
        return out;
      }

      /**
       * What a submission actually carries. Falls back to the whole tree only
       * when the origin cannot rebuild a base — better a big payload than a
       * diff against something we cannot name.
       */
      /**
       * v0.0.79 — provenance as EVIDENCE, which is what the AI-free label
       * needs to stop being self-declared.
       *
       * TODO's wording: "a piece that is one of our genres plus a human's
       * edits is a different object from one that arrived as an opaque blob,
       * and until v0.0.62 the two were indistinguishable on arrival."
       *
       * This does not decide whether anything is AI-free — the label is a
       * claim a person signs about the MUSIC, not a fact about the source, and
       * CONTRIBUTING.md is explicit about that. What it does is put the
       * evidence beside the claim: what this grew from, whether that base can
       * be rebuilt from two numbers, and how many fields the person actually
       * moved. A reviewer reading a submission can then see the difference
       * between "our Synthwave, eleven fields changed" and "an opaque tree
       * with no origin at all", which is exactly the distinction he asked for.
       */
      function countDiffLeaves(diff) {
        if (!isPlainObject(diff)) return diff === undefined ? 0 : 1;
        let n = 0;
        for (const value of Object.values(diff)) n += countDiffLeaves(value);
        return n;
      }

      const provenanceLine = document.getElementById('preset-provenance');

      /**
       * Kept current from the settings funnel, like every other readout that
       * has to agree with the tree: a provenance line that was right when the
       * panel opened and wrong ever after would be worse than none.
       */
      function syncProvenance() {
        // Wrapped whole, not just the sentence: this is called from the
        // settings funnel, which fires during boot — before `provenanceLine`
        // above it has been initialised. Reading a const in its dead zone
        // throws, and a throw here would take the page down.
        try {
          if (!provenanceLine) return;
          provenanceLine.textContent = provenanceSentence();
        } catch {}
      }
      syncProvenance();

      function provenanceSummary() {
        const o = originSnapshot();
        const base = originBase();
        const rebuildable = !!base;
        const changed = rebuildable ? countDiffLeaves(diffTree(base, paramsSnapshot())) : null;
        let from;
        if (o.kind === 'genre' && typeof o.id === 'string') {
          const genre = GENRE_BY_SLUG.get(o.id);
          from = genre ? genre.name || o.id : o.id;
        } else if (o.kind === 'blank') {
          from = 'a blank slate';
        } else {
          from = null;
        }
        return { kind: o.kind, id: o.id ?? null, seed: o.seed ?? null, from, rebuildable, changed };
      }

      /** The provenance in one plain sentence, for the person about to submit. */
      function provenanceSentence() {
        const p = provenanceSummary();
        if (!p.rebuildable) {
          return 'This setup carries no record of what it grew from, so a submission can only send the whole thing. That is still fine — it just cannot show its working.';
        }
        if (p.kind === 'blank') {
          return p.changed === 0
            ? 'Built from a blank slate, with nothing changed yet — everything you hear is silence.'
            : `Built from a blank slate: every one of the ${p.changed} setting${p.changed === 1 ? '' : 's'} in this piece is yours.`;
        }
        if (p.kind === 'genre' && p.from) {
          return p.changed === 0
            ? `This is our ${p.from} style exactly as the app compiled it — nothing of yours in it yet.`
            : `Built on our ${p.from} style, with ${p.changed} setting${p.changed === 1 ? '' : 's'} changed by you. A submission sends that style's id and your changes, not a copy of the style.`;
        }
        return 'A submission sends what this grew from plus your own changes.';
      }

      function submissionPayload(name) {
        const base = originBase();
        const now = paramsSnapshot();
        if (!base) {
          return { v: 1, name, origin: originSnapshot(), params: now, note: 'full tree — origin could not be rebuilt' };
        }
        return {
          v: 1,
          name,
          origin: originSnapshot(),
          diff: diffTree(base, now),
          // Evidence beside the claim, never instead of it: the AI-free label
          // is something a person signs about the music.
          provenance: provenanceSummary(),
        };
      }

      function presetJSON() {
        const name = presetName.value.trim() || 'Untitled';
        return JSON.stringify({ name, params: paramsSnapshot() }, null, 2);
      }

      presetSubmit.addEventListener('click', async () => {
        const name = presetName.value.trim() || 'Untitled';
        // The anonymous choice rides in the message, because the contact form
        // is a plain form with no field of its own for it. Stated as the first
        // line so it cannot be missed by whoever reads the submission.
        const anonymous = document.getElementById('preset-anonymous')?.checked;
        // Compact, not pretty-printed: every newline and run of indent is
        // three characters once URL-encoded, and this rides in a query string.
        // Copy JSON beside the button still hands over the readable form.
        const payload = JSON.stringify(submissionPayload(name));
        const body = anonymous
          ? `ANONYMOUS SUBMISSION — do not credit the sender.\n\n${payload}`
          : payload;
        // The contact form's param contract v1 (brain2 coordination.md,
        // 2026-07-23): `source` is REQUIRED and is the calling site's
        // hostname, recorded with every submission. Without it a submission
        // arrives with no idea which andeye site sent it.
        // A HARD CEILING on the URL. The previous version had none, and a
        // full settings tree URL-encoded came to 115,897 characters — far past
        // any browser's limit and past what Cloudflare will accept, which is
        // why the form answered with a closed connection rather than an error
        // anyone could read. 1,800 leaves room for the base URL and the other
        // params inside the ~2,000 that even the strictest stack allows.
        const MAX_URL = 1800;
        const base =
          `${CONTACT_URL}?source=${encodeURIComponent(location.hostname || 'ambi4.work')}` +
          `&subject=${encodeURIComponent(`Ambi4 preset: ${name}`)}`;
        const withBody = `${base}&message=${encodeURIComponent(body)}`;
        if (withBody.length <= MAX_URL) {
          window.open(withBody, '_blank', 'noopener');
          return;
        }
        // Too big even as a diff — a heavily edited preset can be. Put it on
        // the clipboard and open the form with a line telling them to paste,
        // which is what the hint under the button has always offered as the
        // fallback. Never a truncated payload: half a preset is not a preset.
        let copied = false;
        try {
          await navigator.clipboard.writeText(body);
          copied = true;
        } catch {
          // Clipboard refused (no gesture, insecure context) — say so rather
          // than pretend.
        }
        const note = copied
          ? 'This preset is too long for a web address, so it is on your clipboard — paste it into the message box.'
          : 'This preset is too long for a web address. Use Copy JSON beside Submit, then paste it into the message box.';
        window.open(`${base}&message=${encodeURIComponent(note)}`, '_blank', 'noopener');
      });

      // Share: params only, in the fragment, straight to the clipboard. If the
      // clipboard is refused (Safari without a user-gesture-bound permission,
      // an insecure context), the link is printed in the note instead so it
      // can still be copied by hand — a failed copy must not lose the link.
      presetShare?.addEventListener('click', async () => {
        let url = '';
        let name = '';
        try {
          const fragment = `${SHARE_PARAM}=${encodeShareParams(sharePayload())}`;
          url = `${SHARE_BASE}#${fragment}`;
          // The same fragment the receiver's browser will hash on arrival, so
          // both ends read the same three words off the same link.
          name = shareNameFor(fragment, SHARE_WORDS);
        } catch {
          presetShare.textContent = 'Share failed';
          setTimeout(() => {
            presetShare.textContent = 'Share';
          }, 2000);
          return;
        }
        setShareName(name);
        // A suggestion, never an overwrite: the link's own name is a better
        // starting point than "Untitled" for the Save the user is about to do.
        if (name && !presetName.value.trim()) presetName.value = name;
        try {
          await navigator.clipboard.writeText(url);
          presetShare.textContent = 'Link copied';
          if (shareNote) {
            shareNote.textContent = name
              ? `Share link copied — its name is ${name}. It carries your settings, never any code.`
              : 'Share link copied — it carries your settings, never any code.';
            shareNote.hidden = false;
          }
        } catch {
          presetShare.textContent = 'Copy failed';
          if (shareNote) {
            shareNote.textContent = name
              ? `Copy this link (${name}): ${url}`
              : `Copy this link: ${url}`;
            shareNote.hidden = false;
          }
        }
        setTimeout(() => {
          presetShare.textContent = 'Share';
        }, 2000);
      });

      presetCopy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(presetJSON());
          presetCopy.textContent = 'Copied';
        } catch {
          presetCopy.textContent = 'Copy failed';
        }
        setTimeout(() => {
          presetCopy.textContent = 'Copy JSON';
        }, 2000);
      });

      // ---- v13 tutorial panel (right-docked, stepped, no library) ---------
      // Each step names the control it is talking about; opening a step
      // switches to the tab that control lives on and rings it. Open state
      // and position persist through prefs like every other UI preference.
      //
      // The arc is a first run, in the order a newcomer meets the thing:
      // Simple tab (start it, steer it, pick a genre) → the two displays that
      // sit above the tabs → Advanced (tracks, editors, your own tracks) →
      // sharing it → what this actually is. Every `target` must resolve to
      // exactly ONE element and every `tab` must be a real tab —
      // tests/tutorial-smoke.mjs holds both, and page-boot re-checks the
      // targets against the booted document (some are built by the script).
      const TUTORIAL_STEPS = [
        {
          tab: 'simple',
          target: '#toggle-play',
          text: 'Press Play — sound starts within a second, and the button becomes Finish (a musical ending) and then Stop. Pause holds the piece exactly where it is; Next jumps to a new setup drawn from the current genre\'s rules; Back returns to the one before. ⌘Z (Ctrl-Z) undoes anything at all — a dial, a chord, a Next — as far back as you like, and ⇧⌘Z redoes it.',
        },
        {
          tab: 'simple',
          target: '#genre-select',
          text: 'Pick a genre and the whole setup is drawn from its rules — tempo, chords, kit and voices together, a different piece each time you pick it. Surprise me, at the foot of the list, chooses for you. Favourites keeps the ones you come back to, and each mood you favourite gets its own entry that plays a random favourite from it.',
        },
        {
          tab: 'simple',
          target: '#panel-simple .sliders-module',
          text: 'These dials are the whole instrument for most people. Drag up and down for the value, LEFT AND RIGHT to give it a range to drift between, or click the number underneath to type one. Double-click restores the default, and the pointer thickens while a dial is still following your drag. Change at zero means hold: the generator loops exactly what it is playing. Nearly every dial in the app takes a range the same way.',
        },
        {
          tab: 'simple',
          target: '#factory-presets',
          text: 'Factory presets sit under the Simple dials: starting points, not presets in the locked sense — load one and change anything. Hover one to read why it is built the way it is. Each has its own web address, so you can link straight to it. Save your own under Your presets on Advanced.',
        },
        {
          tab: 'simple',
          target: '.processor-row',
          text: 'Processor decides how hard this runs. Auto watches the machine and backs off when it gets warm; Eco is the coolest setting.',
        },
        {
          target: '#play-along',
          text: 'The orange piano icon — Create — is the app\'s second main door. Blank slate empties everything, FX included, so what follows is entirely yours; the Zero buttons strip one layer at a time; Tap a rhythm turns the Space bar into a drum; and Musical typing hands your computer keyboard, or a MIDI one, to a track, with Capture recording what you play into its grid. The panel\'s two ⓘs hold the detail.',
        },
        {
          target: '#front-scope-module',
          text: 'The oscilloscope and the piano roll sit above the tabs, so they stay put while you work. In the legend, a click hides one instrument\'s trace and a double-click solos it; Spread gives each track a line of its own and Total adds the finished mix. The button beside them fills the screen with either display, where a second control brings the other one in below it, and the twisty folds the whole thing away.',
        },
        {
          tab: 'advanced',
          target: '#control-progression',
          text: 'Chords is the loop the piece keeps coming back to. Each chord has a card: press one to hear it, and the notes it plays are printed on it, so you never have to imagine a chord from its name. The arrows move a chord through the scale and the button beside them makes it wider. Leave the box empty and the app writes the loop itself.',
        },
        {
          tab: 'advanced',
          target: '.track-rows',
          text: 'Six tracks, one line each. The coloured lamp beside the name cycles off, auto and on, the box beside it picks that track\'s voice, and the two dials are its level and its own randomness.',
        },
        {
          tab: 'advanced',
          target: '#voice-edit-toggle-percussion',
          text: 'Edit opens a track\'s panel: its step sequencer at the top, then the dials that build its sound. \u00d72 / \u00f72 under the grid set what one cell is worth, and Triplets puts three in the time of two. Drag sideways across cells to tie them into one long note. An outlined cell is a step the app chose, not one you typed; on a tuned track a line inside it shows how high the note is, so a bass line\'s shape reads off the grid. Hover a cell for note names.',
        },
        {
          tab: 'advanced',
          target: '#voice-edit-toggle-texture',
          text: 'Give Texture the Coloured noise or Grain cloud voice and its panel grows Spectral, Motion and Burst rows. Wind, rain and surf all live in there — you sculpt them with the dials rather than picking a sample. The Call voice does the same for birdsong: a pitch sweep, two formants and a cadence.',
        },
        {
          tab: 'advanced',
          target: '#add-track',
          text: 'Add track gives you tracks of your own, under the six built-in ones: name it, say whether it is melodic or percussive, and it gets a row, a voice and an editor like the rest. Six of your own is the limit, and only your own can be removed.',
        },
        {
          tab: 'advanced',
          target: '#preset-share',
          text: 'Share copies a link that carries the style it grew from plus your own changes — nothing is uploaded, and no code travels with it, so a link stays short enough to paste anywhere. Each link works out its own three-word name, shown on the line below, so you can say which link you mean out loud. Save keeps a setup on this device under Your presets.',
        },
        {
          target: null,
          text: 'Nothing here is AI and nothing is a recording. Every note is worked out as you listen by ordinary code running in this tab — the same rules you can see and change on the Advanced tab. What you make stays on this device unless you hand someone a link.',
        },
      ];

      const tutorialPanel = document.getElementById('tutorial-panel');
      const tutorialToggle = document.getElementById('tutorial-toggle');
      const tutorialText = document.getElementById('tutorial-step-text');
      const tutorialProgress = document.getElementById('tutorial-progress');
      let tutorialHighlighted = null;

      function highlightTutorialTarget(selector) {
        if (tutorialHighlighted) tutorialHighlighted.classList.remove('tutorial-highlight');
        tutorialHighlighted = selector ? document.querySelector(selector) : null;
        if (tutorialHighlighted) tutorialHighlighted.classList.add('tutorial-highlight');
      }

      function renderTutorial() {
        const index = clamp(settings.ui.tutorialStep | 0, 0, TUTORIAL_STEPS.length - 1);
        settings.ui.tutorialStep = index;
        const step = TUTORIAL_STEPS[index];
        tutorialText.textContent = step.text;
        tutorialProgress.textContent = `${index + 1} / ${TUTORIAL_STEPS.length}`;
        document.getElementById('tutorial-prev').disabled = index === 0;
        document.getElementById('tutorial-next').disabled = index === TUTORIAL_STEPS.length - 1;
        if (step.tab) activateTab(step.tab);
        highlightTutorialTarget(step.target);
      }

      function setTutorialOpen(open) {
        settings.ui.tutorialOpen = open;
        tutorialPanel.hidden = !open;
        tutorialToggle.setAttribute('aria-expanded', String(open));
        if (open) renderTutorial();
        else highlightTutorialTarget(null);
        persistSettings();
      }

      tutorialToggle.addEventListener('click', () => setTutorialOpen(tutorialPanel.hidden));
      document.getElementById('tutorial-close').addEventListener('click', () => {
        setTutorialOpen(false);
        tutorialToggle.focus();
      });
      document.getElementById('tutorial-prev').addEventListener('click', () => {
        settings.ui.tutorialStep -= 1;
        renderTutorial();
        persistSettings();
      });
      document.getElementById('tutorial-next').addEventListener('click', () => {
        settings.ui.tutorialStep += 1;
        renderTutorial();
        persistSettings();
      });
      tutorialPanel.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        setTutorialOpen(false);
        tutorialToggle.focus();
      });

      // ---- initial sync ---------------------------------------------------

      /**
       * Push the whole settings tree back onto every control. Runs on a preset
       * load, a share arrival and at boot.
       *
       * v0.0.57: every dial position derived from a global param has to be
       * mapped through `mapRangeValue`, because any of them may now be a
       * {min,max} span. Passing a span to a scalar mapping returns NaN, and
       * `knob.set(NaN)` silently keeps the previous number — which reads as a
       * spread that quietly collapsed a moment after being made. That is what
       * it did: a sideways drag on Energy landed as a value change.
       */
      function syncUIFromSettings() {
        if (bpmInput) bpmInput.value = String(rangeMid(settings.bpm));
        bpmTypable?.refresh();
        speedDial?.set(mapRangeValue(settings.bpm, speedTFromBpm));
        simpleSpeedDial?.set(mapRangeValue(settings.bpm, speedTFromBpm));
        energyDial?.set(mapRangeValue(settings.complexity, energyFromComplexity));
        repetitionDial?.set(settings.repetition);
        volumeDial?.set(mapRangeValue(settings.volume, volumeDialFromParam));
        randomnessDial?.set(changeDialValueFromState());
        variationDial?.set(trackRandomnessValue());
        swingDial?.set(settings.swing);
        complexityDial?.set(settings.complexity);
        if (reverbTailDial && isNumberOrRange(settings.reverbTail)) {
          reverbTailDial.set(settings.reverbTail);
          applyReverbTail();
        }
        rootSelect.value = settings.root;
        modeSelect.value = settings.mode;
        {
          const named = [...timeSignatureSelect.options].some(
            (o) => o.value === settings.timeSignature);
          timeSignatureSelect.value = named ? settings.timeSignature : 'custom';
          const wrap = document.getElementById('custom-metre');
          if (wrap) wrap.hidden = named;
          if (!named) {
            const [n, d] = String(settings.timeSignature).split('/');
            const nEl = document.getElementById('custom-metre-n');
            const dEl = document.getElementById('custom-metre-d');
            if (nEl) nEl.value = n;
            if (dEl) dEl.value = d === '8' ? '8' : '4';
          }
        }
        // A preset, a genre or a share link can bring its own loop, key and
        // scale in together, so the chords are re-read here rather than only
        // when someone edits them.
        if (engineCaps.harmonySeed) {
          try { renderProgression(); } catch {}
        }
        syncGenreUI();
        if (engineCaps.harmonyRhythm) chordLengthSelect.value = String(settings.harmony.rhythm);
        syncStructureUI();
        syncArpUI();
        syncTrackStateUI();
        syncAllTrackExtras();
        for (const id of TRACK_IDS) {
          // Every lookup here is guarded since v23: TRACK_IDS is the engine's
          // live list, so a row can legitimately be a moment behind it (a
          // preset that has just brought a track in), and a throw inside the
          // initial sync is a blank page.
          const select = document.getElementById(`track-voice-${id}`);
          if (select && settings.tracks[id]) select.value = settings.tracks[id].voice;
          // A loaded preset brings its own patches, so the "Custom (…)"
          // display has to be recomputed, not just the stored selection.
          soundingVoice.delete(id);
          refreshVoiceSelect(id);
          levelControls.get(id)?.set(settings.tracks[id]?.level);
          const editor = document.getElementById(`voice-editor-${id}`);
          if (editor && !editor.hidden) renderVoiceEditor(id);
        }
        updateComplexityDisplay();
        updateFrontScope();
      }

      syncUIFromSettings();
      refreshPresetSelect();
      engine.setParams(engineParamsFrom(settings));
      // AUDIT FIX: seed the undo baseline with the BOOT state — it used to
      // be seeded lazily by the first edit's own snapshot, so the first ⌘Z
      // of every session had nothing to return to and did nothing.
      try {
        undoBaseline = paramsSnapshot();
      } catch {}
      activateTab(settings.ui.activeTab, { persist: false });
      applyDensityScale();
      setTransportUI();
      updateTimerUI();
      if (settings.ui.tutorialOpen) setTutorialOpen(true);
      if (sharedParams && shareNote) {
        // v23: a shared link can bring tracks this device has never had. They
        // are created and they sound — through the stock voice set the sender
        // named, because no user track has voice code of its own to be missing
        // (the v10 boundary). Saying how many arrived is the whole notice: it
        // stops the extra rows reading as a bug.
        const brought = USER_TRACKS.length;
        const madeNote = brought
          ? ` Brought ${brought} custom track${brought === 1 ? '' : 's'}, playing stock voices.`
          : '';
        // v0.0.35: a link minted by a newer Ambi4 may carry settings this build
        // has no idea about, and the sanitiser drops them silently. Say so —
        // the alternative is the listener hearing a different piece under the
        // right name and having no way to know why.
        const newerNote = arrivedFromNewerBuild
          ? ' This link was made with a newer version of Ambi4, so some of its settings may be missing here.'
          : '';
        // v0.0.79: a base-and-diff link names the genre it grew from and
        // carries only the sender's changes. If that genre cannot be rebuilt
        // here — an unknown slug, a compiler that refused — the changes are
        // applied to the plain defaults instead, which is a worse reproduction
        // than the sender heard. Saying so beats a listener wondering why it
        // sounds wrong.
        const baseNote = shareBaseMissing
          ? ' The style this was built from could not be rebuilt here, so only the sender’s own changes are loaded.'
          : '';
        shareNote.textContent = (routePreset
          ? `Loaded the ${routePreset.name} preset — Save to keep it.`
          : arrivedShareName
            ? `Loaded ${arrivedShareName} — this link's name. Save to keep it.`
            : 'Loaded shared preset — Save to keep it.') + madeNote + newerNote + baseNote;
        shareNote.hidden = false;
      }
      // v29: a link announces itself by name in the Share row too, and offers
      // that name for the Save the note just asked for.
      if (arrivedShareName) {
        setShareName(arrivedShareName);
        if (!presetName.value.trim()) presetName.value = arrivedShareName;
      }
      if (routePreset) presetName.value = routePreset.name;

      app.hidden = false;
    }

    init().catch((err) => {
      // A dead init must never leave a blank page: show the fallback and say why.
      console.error('Ambi4 init failed:', err);
      const un = document.getElementById('generator-unavailable');
      if (un) {
        un.hidden = false;
        un.textContent = 'Something went wrong starting the generator (' + (err && err.message ? err.message : err) + '). Please hard-refresh; if it persists, this build is faulty.';
      }
    });
  </script>

  <!-- Global on purpose: most of these controls are built by the page
       script, so Astro's scoped-style attribute would never reach them.
       Class names are page-unique (checked against the other pages). -->
  <style is:global>
    /* `hidden` is only a UA `display: none` rule, so ANY author display
       declaration beats it — and nearly every panel/row/cell below sets one.
       That silently defeated `el.hidden = true` in the page script: the dial
       label rows buildSimpleDial hides stayed visible (every dial showed its
       name twice, once above and once under the knob), the switched-off Osc 2
       cell still drew, the empty cost meters still drew. One rule fixes the
       whole class of bug; `!important` is what makes it beat the class rules. */
    [hidden] {
      display: none !important;
    }

    #generator-app {
      max-width: 640px;

      /* -- v18 dial alignment contract --------------------------------------
         Every dial on the page is the same three stacked zones, in this order
         and at these fixed heights, so faces line up on one baseline in ANY
         row and the text under them can never push a face up or down:

           face  — the knob's own square SVG, exactly --knob-size tall
           label — its name (knob.js's .knob-label)
           value — its read-out (.knob-value), tall enough for the wave glyph

         The zones are fixed HEIGHTS with visible overflow rather than min-
         heights: a long read-out ("2.0 kHz–8.0 kHz") bleeds into the gutter
         instead of wrapping the box taller and dragging its neighbours out of
         line. Nothing is reserved ABOVE a face — the end-marks and the centre
         mark hang below the read-out (.dial-ends / .dial-mid), which is what
         let the old `.simple-dial { padding-top }` compensation hack go. */
      --dial-label-h: 15px;
      --dial-value-h: 20px;
      --dial-ends-h: 15px;
    }

    .knob > svg {
      height: var(--knob-size, 72px);
    }

    .knob-label {
      height: var(--dial-label-h);
      line-height: var(--dial-label-h);
      white-space: nowrap;
      overflow: visible;
    }

    .knob-value {
      display: block;
      height: var(--dial-value-h);
      line-height: var(--dial-value-h);
      white-space: nowrap;
      overflow: visible;
    }

    /* -- 70s module furniture (theme owns the .module-panel appearance /
          tokens) -- */

    .module-panel {
      position: relative;
    }

    .transport-module,
    .sliders-module {
      margin-bottom: 20px;
    }

    .transport-module .transport-row {
      margin-bottom: 0;
    }

    /* Pushes the right-hand group (PROCESSOR + the `?`) to the far end, and
       keeps doing so if the Processor title is removed with its dial. */
    .transport-label {
      display: block;
      margin-right: auto;
    }

    /* -- v15 transport strip: [▶ Play/Finish] [■ Stop] [● Record] ... and,
          far right, the sleep + schedule icons stacked at half height -- */

    /* v18: TRANSPORT and PROCESSOR are one header row — both engraved titles
       on a single baseline, the panel's `?` last. The Processor title sits at
       the right end, over the dial it names. */
    /* Transport left, Processor right, on one baseline. */
    .transport-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
    }

    /* ONE transport row: Play/Stop/Record, the sleep+schedule icons and the
       Processor dial all live on the same line. `wrap` is the narrow-screen
       escape hatch — at ~360 px the dial drops to a second line rather than
       squashing the buttons. `center` (not `stretch`) keeps the buttons at
       their own height now that the tallest item in the row is a dial. Every
       item in it is a FIXED size: the processor's status text (whose length
       changes as the tier and the note count change) lives in the row BELOW,
       where it cannot resize the transport buttons. */
    .transport-main {
      display: flex;
      align-items: center;
      /* v0.0.43: wrapping is fine again — it was never the problem. The
         staircase came from the NESTED wrap (a button group that became two
         rows tall, with the icons centred against it). With `display: contents`
         dissolving the wrappers, every button, icon and the dial share one set
         of line boxes, so a wrap moves whole items down together. */
      flex-wrap: wrap;
      gap: 8px 12px;
      margin-bottom: 8px;
    }

    .transport-buttons {
      display: flex;
      flex: 1 1 auto;
      /* Lets the group actually shrink inside a nowrap parent instead of
         forcing its min-content width and shoving the icons out. */
      min-width: 0;
      flex-wrap: wrap;
      align-items: stretch;
      gap: 8px;
    }

    /* v18 hardware-panel rule: the key is sized to its WIDEST caption
       ("Finishing…"), so Play → Finish → Finishing… only ever swaps text
       inside a box that never changes size. Reserving it in `ch` (the label
       span, not the button) keeps the reservation honest when the font
       stack, the letter-spacing or the caption changes. */
    .play-toggle {
      display: inline-flex;
      /* v0.0.43: was `2 1 200px`, which took nearly half the row on its own and
         forced everything after Pause onto a second line. It is still the
         primary action and still the widest control, but it now grows at the
         same rate as the space allows rather than twice it, and stops. */
      flex: 1 1 150px;
      max-width: 260px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 56px;
      padding: 16px;
      font-size: 18px;
      font-weight: 700;
      color: var(--bg);
      background: var(--link);
      border: none;
      border-radius: var(--radius);
      cursor: pointer;
    }

    .play-toggle-label {
      display: inline-block;
      min-width: 11ch;
      text-align: center;
    }

    /* Both glyphs are the same 18px box, so swapping ▶ for 𝄂 moves nothing. */
    .transport-glyph {
      display: inline-flex;
      align-items: center;
    }

    /* `hidden` must beat the display rule above, or both glyphs show at once
       (shipped bug: Play carried the barline icon too). */
    .transport-glyph[hidden] {
      display: none !important;
    }

    .transport-button {
      display: inline-flex;
      flex: 0 0 56px;
      width: 56px;
      height: 56px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 6px 4px;
      font-size: 10px;
      font-weight: 600;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .transport-button:focus-visible,
    .round-button:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .transport-button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    /* -- v26 genre row: directly under the Play key, full width -- */

    /* The picker is the second control on the panel, so it gets the whole
       line rather than competing for space in the button strip. 44px is the
       touch-target floor; the select carries its own font-size 16 so iOS
       does not zoom the page when it opens. */
    .genre-row {
      display: flex;
      align-items: center;
      gap: 8px;
      /* v0.0.42: the grid's row-gap spaces this now. */
      margin-bottom: 0;
    }

    .genre-select {
      flex: 1 1 auto;
      min-height: 44px;
      padding: 8px 10px;
      font-size: 16px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .genre-select:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    /* -- v28 play along: the row under the genre picker -- */

    /* Same shape as the genre row: the track picker takes the slack and every
       button keeps its own width. Nothing here resizes when the toggle goes
       on — the buttons change colour and disabled state, never their text. */
    /* v0.0.38: the fold button is icon-only — the whole panel is the label. */
    /* v0.0.40: the panel is a popover now, so it needs a width of its own
       rather than the full page row it used to occupy. */
    .play-along.popover {
      width: min(420px, calc(100vw - 32px));
    }

    /* Two chips can show at once (a sleep timer and a scheduled start), so the
       second sits beside the first instead of on top of it. */
    .countdown-chip-alarm {
      transform: translateX(-18px);
    }

    /* v0.0.43: no grid and no reserved column — the processor items are simply
       the last thing in each of the three rows, pushed right with margin-left.
       The grid was buying alignment at the cost of a column that had to be as
       wide as its widest member on every row.

       The staircase that produced (Play, Pause, then the clock half a button
       low, then Next dropped again) came from nesting: `.transport-buttons` is
       its own wrapping flex box, so when the row got tight it became two rows
       tall, and `.transport-icons` — a sibling centred against it — floated to
       its vertical middle. `display: contents` dissolves both wrappers so every
       button and icon is a direct child of one wrapping row, sharing one set of
       line boxes. They can then only ever wrap as equals. */
    .transport-buttons,
    .transport-icons {
      display: contents;
    }

    .transport-main > .processor-row,


    /* The dial carries a value caption under it, so its block is taller than a
       56px transport button — and centring the block lifts the dial itself
       above the buttons' centre line. Both are 56px, so aligning their TOPS is
       what actually puts the dial level with Play. */
    .transport-main > .processor-row {
      align-self: flex-start;
    }
    .processor-row {
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
    .processor-row .processor-readout {
      text-align: center;
      white-space: nowrap;
    }



    /* The status line is an empty <p> most of the time, and nothing in the
       sheet resets paragraph margins — so the user agent's own ~16px top and
       bottom were sitting under the genre picker doing nothing. That, not the
       reserved band, was the "huge gap". */
    .transport-row > p {
      margin: 0;
    }

    .timer-section {
      margin-top: 10px;
    }

    /* v0.0.40: the genre picker was full width for a single short name. */
    .genre-row .genre-select {
      max-width: 50%;
    }

    .play-along-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }

    .play-along-select {
      flex: 1 1 120px;
      min-width: 0;
    }

    /* A reserved box for the note name: present and empty until a key is
       pressed, and FIXED at its widest reading ("Oct 7"), so neither the first
       note played nor a longer one after it can move the buttons beside it. */
    .play-along-readout {
      flex: 0 0 auto;
      width: 6ch;
      overflow: hidden;
      white-space: nowrap;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .play-along-button[aria-pressed='true'],
    .play-along-capture[aria-pressed='true'] {
      border-color: var(--accent-warm, var(--link));
      box-shadow: inset 0 0 0 1px var(--accent-warm, var(--link));
    }

    .play-along-capture[aria-pressed='true'] {
      border-color: #c8302f;
      box-shadow: inset 0 0 0 1px #c8302f;
    }

    /* Two lines of height, held whether or not there is anything to say: the
       note under this row changes as the state does, and a line that grows
       would push the whole panel below it down. */
    .play-along-note {
      min-height: 2.8em;
      margin: 0 0 12px;
    }

    /* The favourites editor hangs off the row itself, not off a button of its
       own — the genre list is where it is opened from. */
    .genre-rules-toggle {
      flex: 0 0 auto;
    }

    .genre-rules {
      width: min(480px, calc(100vw - 32px));
    }

    .genre-rules-label {
      display: block;
      margin: 10px 0 4px;
      font-size: 0.78rem;
      color: var(--muted);
    }

    .genre-rules-text {
      width: 100%;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85rem;
      background: var(--bg);
      color: var(--fg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 8px;
      resize: vertical;
    }

    .genre-rules-error {
      color: var(--warn, #c0392b);
    }

    .genre-favourites {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: min(320px, 88vw);
    }

    .genre-fav-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: 46vh;
      overflow-y: auto;
    }

    .genre-fav-group {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .genre-fav-item,
    .genre-fav-hide {
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: 32px;
      font-size: 14px;
      cursor: pointer;
    }

    .genre-fav-hide {
      min-height: 44px;
      border-top: 1px solid var(--border);
    }

    .genre-fav-actions {
      display: flex;
      justify-content: flex-end;
    }

    .record-button .record-dot {
      color: #c8302f;
    }

    .record-button:disabled .record-dot {
      color: var(--secondary);
    }

    .record-button.recording {
      border-color: #c8302f;
      box-shadow: inset 0 0 0 1px #c8302f;
    }

    /* Reserved box: present (and empty) while idle, so "Recording 0:07"
       appearing never re-flows the line it shares. */
    .record-status {
      flex: 0 0 auto;
      min-width: 15ch;
      text-align: right;
      color: #c8302f;
      font-size: 14px;
      font-weight: 600;
    }

    /* Small round utility button: the "?" tour opener, the ⓘ info buttons
       and the per-track dice re-roll. */
    .round-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      font-size: 14px;
      font-weight: 700;
      font-family: var(--label-font, inherit);
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 50%;
      cursor: pointer;
    }

    .round-button:hover {
      border-color: var(--accent-warm, var(--link));
    }

    .play-toggle:hover {
      background: var(--link-hover);
    }

    .play-toggle:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 3px;
    }

    .play-toggle[aria-pressed='true'] {
      background: var(--secondary);
    }

    .play-toggle:disabled {
      opacity: 0.7;
      cursor: wait;
    }

    /* The status line under the transport row. Two visual lines in one box:
       transport status and record elapsed on the first, the processor's own
       status on a full-width second line. Both lines reserve their height
       whether or not they have anything to say, so text arriving or leaving
       can never move a control above them. */
    .transport-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 4px 12px;
      /* v0.0.42: this band is reserved so status text appearing cannot reflow
         the panel — that stays. What went was 4px of surplus reservation and a
         12px margin under it. Together with the genre row's old margin and the
         grid gap, roughly 50px of empty space sat under the genre dropdown for
         a line of text that is usually blank. */
      min-height: 18px;
      margin-bottom: 0;
    }

    .timer-status {
      color: var(--secondary);
      font-size: 14px;
    }

    /* Takes the slack on the status line so the record box beside it keeps
       its reserved width. It is the one element allowed to grow to a second
       line — a warning ("Audio didn't start…") must not be truncated — and it
       sits below every control in the panel, so nothing above it can move. */
    .transport-row .timer-status {
      flex: 1 1 auto;
      min-width: 0;
    }

    .link-button {
      padding: 0;
      font-size: 14px;
      color: var(--link);
      background: none;
      border: none;
      text-decoration: underline;
      cursor: pointer;
    }

    .link-button:hover {
      color: var(--link-hover);
    }

    .link-button:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    /* -- transport icon buttons + sleep/alarm popovers (v6) -- */

    /* Far right of the strip: the two popover icons stacked, each about half
       the Play button's height. Width is generous so the pair still offers
       comfortable targets at half height. */
    .transport-icons {
      display: flex;
      flex: 0 0 auto;
      flex-direction: column;
      gap: 4px;
    }

    .transport-icons {
      flex-direction: row;
    }

    .transport-icons .icon-button {
      width: 56px;
      height: 56px;
    }

    /* v0.0.89: Create is the second main door — the orange ICON in the icon
       row (his 103: icon-only, CREATE in the tooltip, no row space taken). */
    .create-button {
      color: var(--accent-warm, var(--link));
    }
    .create-row {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      margin: 4px 0;
    }

    .create-guided-tree {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .guided-question {
      margin: 0;
      font-weight: 600;
    }

    .create-midi-row {
      align-items: center;
    }

    .create-midi-label {
      cursor: pointer;
    }

    .create-midi-track {
      flex: 0 1 auto;
      max-width: 14ch;
    }

    .create-melody-input {
      flex: 1 1 220px;
      min-width: 0;
      background: var(--bg);
      color: var(--fg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 8px;
      font-size: 0.85rem;
    }
    /* v0.0.84: the Create button stays lit while the keys are armed, so an
       armed instrument behind a closed popover is never invisible state. */
    .play-along-live {
      background: var(--accent-warm, var(--link));
      color: #14100b;
    }
    .popover-anchor {
      position: relative;
    }

    .icon-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      min-width: 44px;
      padding: 0;
      color: var(--text);
      background: linear-gradient(rgba(255, 255, 255, 0.06), rgba(0, 0, 0, 0.03)), var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .icon-button:hover {
      border-color: var(--accent-warm, var(--link));
    }

    .icon-button[aria-expanded='true'] {
      color: var(--bg);
      background: var(--link);
      border-color: var(--link);
    }

    .icon-button:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .countdown-chip {
      position: absolute;
      top: -6px;
      right: -6px;
      padding: 2px 6px;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.4;
      color: var(--on-amber, var(--bg));
      background: var(--accent-warm, var(--link));
      border-radius: 999px;
      white-space: nowrap;
      pointer-events: none;
    }

    .popover {
      position: absolute;
      top: calc(100% + 8px);
      /* v0.0.84 (his item 95): anchored icons sit at the page's right edge,
         so a popover growing rightward left the screen. Right-aligned to the
         anchor, growing left. */
      left: auto;
      right: 0;
      z-index: 20;
      width: max-content;
      min-width: 240px;
      max-width: calc(100vw - 32px);
    }

    /* v0.0.84: on a narrow screen no anchored placement can fit — an icon at
       the right edge right-aligns to a popover wider than the space left of
       it. Below 560px the popover takes the viewport instead: fixed, inset
       16px each side, under the header. */
    @media (max-width: 560px) {
      .popover {
        position: fixed;
        left: 16px;
        right: 16px;
        top: 84px;
        width: auto;
        min-width: 0;
      }
    }
    .popover-title {
      display: block;
      margin-bottom: 10px;
    }

    .popover input[type='number'],
    .popover input[type='time'] {
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .popover input[type='number'] {
      width: 72px;
    }

    #track-visualiser {
      display: block;
      width: 100%;
      height: 200px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg);
    }

    /* v26: the piano roll's own stage, so it has something to hang a
       fullscreen button off and something to hand to requestFullscreen.
       visualiser.js inserts its lamp host between this and the canvas. */
    .roll-stage {
      position: relative;
      margin-bottom: 20px;
    }

    .roll-overlay {
      position: absolute;
      top: 6px;
      right: 8px;
      display: flex;
      gap: 6px;
    }

    .stage-fs-button {
      background: none;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--secondary);
      padding: 0 7px;
      min-height: 24px;
      line-height: 1;
      font-size: 13px;
      cursor: pointer;
    }

    .stage-fs-button:hover {
      color: var(--text);
      border-color: var(--link);
    }

    /* The fullscreen host. Off-screen duty only: everything inside it is
       borrowed from the page and put back on exit. */
    /* v0.0.49: bezel-free — black to the very edge, traces edge to edge.
       Full screen means the music's picture and nothing else, so the stage
       drops the page background and its own padding. */
    .fullscreen-stage {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 100%;
      height: 100%;
      padding: 0;
      background: #000;
    }

    /* v0.0.49: the collapse twisty makes no sense while maximised — the
       module cannot be folded away inside the stage it is filling. */
    .fullscreen-slots .scope-collapse {
      display: none;
    }

    /* v0.0.49: the menu bar overlays the stage's top-right corner, and with
       the stage padding gone the scope's own overlay row (note, legend,
       options) would sit directly behind it. Clear the bar; the canvas
       itself still runs edge to edge. */
    .fullscreen-slots .scope-overlay {
      margin-top: 44px;
    }

    .fullscreen-stage[hidden] {
      display: none;
    }

    /* v0.0.36 iOS fallback. iPhone Safari has no Element.requestFullscreen at
       all, so the capability gate used to hide both ⛶ buttons outright and
       maximising was simply unavailable on the device the owner most wanted it
       on. When the native API is missing the stage is pinned over the viewport
       instead — visually the same result, minus the browser chrome the API
       would have hidden. `100dvh` rather than `vh` so Safari's collapsing
       address bar does not crop the bottom of the display. */
    .fullscreen-stage[data-pseudo] {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      z-index: 900;
      padding: 0;
      overscroll-behavior: contain;
    }

    :root[data-pseudo-fullscreen] body {
      overflow: hidden;
    }

    /* v27: the menu OVERLAYS the displays (absolute, not in-flow) so sliding
       it away never resizes a canvas — the panel rule. It glides out to the
       right, leaving only the subtle ☰ in the corner. */
    .fullscreen-bar {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 5;
      display: flex;
      /* stretch, not center: the ☰ is a glyph and the others are words, so
         their natural heights differ by a couple of pixels — which is exactly
         the kind of not-quite-aligned the owner was looking at. */
      align-items: stretch;
      justify-content: flex-end;
      gap: 8px;
    }

    /* Only the ACTIONS slide away. The ☰ beside them is what brings them
       back, so it cannot travel with them — it fades to a quiet glyph and
       stays exactly where the pointer last saw it. */
    .fullscreen-actions {
      display: flex;
      gap: 8px;
      transition: transform 0.4s ease, opacity 0.4s ease;
    }

    .fullscreen-bar[data-collapsed] .fullscreen-actions {
      transform: translateX(calc(100% + 56px));
      opacity: 0;
      pointer-events: none;
    }

    /* v0.0.59: the scope's own chrome goes with the menu.
       The scope module is MOVED into the fullscreen stage rather than
       re-rendered there, so its overlay — the track legend and the spread
       control — arrived with it and was unaffected by the 2.6 s collapse.
       The result was a stage that promised to clear itself and then left two
       rows of controls sitting over the visuals for as long as full screen
       lasted, which is the one thing full screen exists not to do.

       Tied to the bar's own collapsed state rather than to a second timer, so
       the two can never disagree, and ☰ brings back everything at once. The
       transition matches the bar's so they leave together. */
    .fullscreen-stage[data-chrome-hidden] .scope-overlay,
    .fullscreen-stage[data-chrome-hidden] .scope-collapse {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    .fullscreen-stage .scope-overlay,
    .fullscreen-stage .scope-collapse {
      transition: opacity 0.4s ease;
    }

    /* Same secondary button as the two beside it — that is the whole point of
       this change — sized to its glyph rather than to a word. */
    .fullscreen-menu {
      flex: 0 0 auto;
      min-width: 2.4em;
      text-align: center;
      transition: opacity 0.3s ease;
    }

    /* Once the actions have gone, this recedes with them rather than sitting
       alone and lit over the visuals, which is the thing full screen exists
       not to do. Still fully reachable, and full strength the moment a
       pointer or the keyboard finds it. */
    .fullscreen-bar[data-collapsed] .fullscreen-menu {
      opacity: 0.3;
    }

    .fullscreen-menu:hover,
    .fullscreen-menu:focus-visible {
      opacity: 1;
    }

    .fullscreen-slots {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1 1 auto;
      min-height: 0;
    }

    /* Each borrowed module takes an equal share of the height, and its canvas
       fills that share — the modules redraw off their own ResizeObserver. */
    .fullscreen-slots > * {
      flex: 1 1 0;
      min-height: 0;
      margin-bottom: 0;
    }

    /* Down through whatever nesting each module keeps (the scope's collapse
       body; the lamp host visualiser.js wraps its canvas in) to the canvas. */
    .fullscreen-slots .scope-stage,
    .fullscreen-slots .scope-body,
    .fullscreen-slots .front-scope,
    .fullscreen-slots .roll-stage > :not(.roll-overlay),
    .fullscreen-slots #track-visualiser {
      height: 100%;
    }

    /* -- tabs -- */

    .tabs {
      display: flex;
      gap: 4px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .tabs [role='tab'] {
      padding: 10px 18px;
      font-size: 16px;
      font-weight: 600;
      color: var(--secondary);
      background: none;
      border: none;
      border-bottom: 3px solid transparent;
      cursor: pointer;
    }

    .tabs [role='tab'][aria-selected='true'] {
      color: var(--link);
      border-bottom-color: var(--link);
    }

    .tabs [role='tab']:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: -3px;
    }

    [role='tabpanel']:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 4px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .control {
      margin-bottom: 20px;
    }

    .control-label-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 6px;
    }

    .control label {
      font-weight: 700;
    }

    .value-readout {
      color: var(--secondary);
      font-size: 14px;
    }

    /* v14 single labelling: knob.js draws each dial's name under its face, so
       the markup label row is hidden once a knob builds (the .dial-knob
       class) and the end-marks sit at the tick extremes instead of a second
       label row above. The slider fallback (.dial-fallback) keeps the label
       row and lays the end-marks out as an ordinary row beneath. */
    .dial-ends {
      display: flex;
      justify-content: space-between;
      color: var(--secondary);
      font-size: 11px;
      font-family: var(--label-font, inherit);
      letter-spacing: 0.04em;
      pointer-events: none;
    }

    /* v18: the scale marks are ONE caption line under the whole dial — low
       left, centre mark in the middle, high right — clear of the name and the
       read-out above them. The line is absolutely positioned (so an unequal
       mark set can't shift a face) and the space it needs is reserved in flow
       by the slot's own padding-bottom, so it never overlaps what follows. */
    .dial-knob .dial-slot {
      position: relative;
      /* the caption line's own height plus the 4px it hangs below the read-out */
      padding-bottom: calc(var(--dial-ends-h) + 4px);
    }

    .dial-knob .dial-ends {
      position: absolute;
      left: 50%;
      top: calc(
        var(--knob-size, 96px) + var(--dial-label-h) + var(--dial-value-h) + 4px
      );
      width: calc(var(--knob-size, 96px) + 52px);
      height: var(--dial-ends-h);
      transform: translateX(-50%);
    }

    .dial-knob .dial-mid {
      position: absolute;
      left: 50%;
      top: calc(
        var(--knob-size, 96px) + var(--dial-label-h) + var(--dial-value-h) + 4px
      );
      height: var(--dial-ends-h);
      transform: translateX(-50%);
      color: var(--secondary);
      font-size: 11px;
      font-family: var(--label-font, inherit);
      letter-spacing: 0.04em;
      pointer-events: none;
    }

    .dial-fallback .dial-slot {
      flex-wrap: wrap;
    }

    .dial-fallback .dial-mid {
      width: 100%;
      text-align: center;
      color: var(--secondary);
      font-size: 11px;
    }

    .dial-fallback .dial-ends {
      width: 100%;
      margin-top: 2px;
    }

    /* v12: Simple tab — five music-box dials in a row (knob.js path), each
       a generously-sized knob per the theme's --knob-size token; the
       slider fallback (knob.js absent) keeps the pre-v12 vertical stack
       look via the shared .control/input[type=range] rules above. */
    .sliders-module {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-around;
      align-items: flex-start;
      gap: 24px 16px;
    }

    .simple-dial {
      flex: 1 1 130px;
      max-width: 220px;
      margin-bottom: 0;
      --knob-size: 96px;
    }

    /* v0.0.51: the three-second what-just-changed line under the Simple
       dials. Reserved height whether empty or not — a confirmation must
       never bounce the panel it is explaining. */
    .dial-confirm {
      flex: 1 1 100%;
      min-height: 1.3em;
      margin: 0;
      text-align: center;
      font-size: 13px;
      color: var(--secondary);
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .dial-confirm.shown {
      opacity: 1;
    }

    /* v0.0.51: a lamp blinks when a dial move flips its track's auto state,
       so the layer change has a visual anchor at the moment it happens. */
    .lamp-dot.lamp-flash {
      animation: lamp-flash 0.45s ease 2;
    }

    @keyframes lamp-flash {
      50% {
        transform: scale(1.55);
        filter: brightness(1.7);
      }
    }

    .dial-slot {
      display: flex;
      justify-content: center;
    }

    /* -- processor dial (transport panel) -- */

    /* v18: the title is up in the panel header (one baseline with TRANSPORT)
       and the status text is down in the transport status row, so what sits
       in the button row is the dial and nothing else — a fixed-size item. */
    .processor-row {
      display: flex;
      flex: 0 0 auto;
      justify-content: center;
      --knob-size: 56px;
    }

    .processor-label {
      display: block;
    }

    /* v0.0.40: directly under its own dial, inside .processor-column, instead
       of a full-width line at the foot of the panel two rows away from the
       control it describes. Height is still always reserved — the
       tier/notes/fps text changes length constantly and must never be able to
       resize or re-flow the row above it. */
    .processor-readout {
      min-height: 14px;
      font-size: 10px;
      line-height: 1.3;
      color: var(--secondary);
    }

    /* The page has already named this dial above it, so knob.js's own caption
       is suppressed — the same string stays on the knob as its aria-label
       (knob.js sets role="slider" + aria-label from `label`), so nothing is
       lost to assistive tech and the name is drawn exactly once. */
    .dial-label-external .knob-label {
      display: none;
    }

    /* -- v13 tooltips + ⓘ info boxes -- */

    /* v0.0.45: dial range labels live in here now, one per line with arrows,
       so the tooltip has to keep its newlines. */
    .ui-tooltip {
      white-space: pre-line;
      position: absolute;
      z-index: 40;
      max-width: 260px;
      padding: 6px 9px;
      font-size: 13px;
      line-height: 1.4;
      color: var(--text);
      background: var(--panel, var(--bg));
      border: 1px solid var(--panel-edge, var(--border));
      border-radius: var(--radius);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      pointer-events: none;
    }

    .info-anchor {
      position: relative;
      display: inline-flex;
    }

    .info-button {
      width: 22px;
      height: 22px;
      font-size: 12px;
      font-style: italic;
    }

    .info-box {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 30;
      width: max-content;
      max-width: min(360px, calc(100vw - 32px));
      padding: 10px 12px;
      font-size: 13px;
      line-height: 1.5;
      color: var(--text);
      background: var(--panel, var(--bg));
      border: 1px solid var(--panel-edge, var(--border));
      border-radius: var(--radius);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      /* v0.0.57: the body is set with textContent and may carry newlines —
         an explanation with one line per option is far easier to read than
         the same words as a paragraph. `pre-line` keeps the breaks and still
         wraps long lines, which `pre` would not. */
      white-space: pre-line;
    }

    /* v0.0.57: the anonymous choice sits on the same line as the ⓘ that
       explains what it governs, because the terms are the reason it exists. */
    .submit-anon-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .checkbox-row {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--secondary);
      cursor: pointer;
    }

    .checkbox-row input {
      /* A real 16px target rather than the 13px the surrounding font would
         otherwise shrink it to. */
      width: 16px;
      height: 16px;
      margin: 0;
      flex: 0 0 auto;
    }

    /* -- v13 click-to-type readouts -- */

    .typable {
      padding: 1px 4px;
      font: inherit;
      color: inherit;
      background: none;
      border: 1px dashed transparent;
      border-radius: 4px;
      cursor: text;
    }

    .typable:hover,
    .typable:focus-visible {
      border-color: var(--border);
    }

    .typable-input {
      width: 5em;
      padding: 1px 4px;
      font: inherit;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--link);
      border-radius: 4px;
    }

    .control input[type='range'] {
      width: 100%;
    }

    .control select {
      width: 100%;
      padding: 8px;
      font-size: 16px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .control input:focus-visible,
    .control select:focus-visible,
    .presets-group input:focus-visible,
    .presets-group select:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .hint {
      margin-top: 6px;
      color: var(--secondary);
      font-size: 14px;
    }

    /* -- presets fieldset (the old sleep/alarm fieldset was replaced by the
          transport popovers below) -- */

    .presets-group {
      margin-bottom: 20px;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .presets-group legend {
      padding: 0 6px;
      font-weight: 700;
    }

    .timer-row,
    .preset-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .timer-custom {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .presets-group input[type='text'] {
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      flex: 1 1 160px;
    }

    .presets-group select {
      flex: 1 1 160px;
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* -- segmented control (3-state track state / 2-state arp mode) -- */

    .segmented {
      display: inline-flex;
      flex-wrap: wrap;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .segmented input[type='radio'] {
      position: absolute;
      opacity: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }

    .segmented label {
      padding: 6px 12px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      color: var(--text);
      border-right: 1px solid var(--border);
    }

    .segmented label:last-of-type {
      border-right: none;
    }

    .segmented input[type='radio']:checked + label {
      background: var(--link);
      color: var(--bg);
    }

    .segmented input[type='radio']:focus-visible + label {
      outline: 3px solid var(--link);
      outline-offset: -3px;
    }

    /* -- tracks section -- */

    .tracks-section {
      margin-bottom: 24px;
    }

    .tracks-heading {
      font-size: 16px;
      margin-top: 0;
      margin-bottom: 12px;
    }

    .track-rows {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* v23 Add Track. Both the footer and the form sit BELOW the row list, so
       opening either moves nothing above it. The button's own width is fixed
       and its label never changes — the count and the cap message go in the
       note, which always occupies its line whether or not it has words in it
       (the v18 rule: a control never moves or resizes because text changed). */
    .track-add {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 12px;
    }

    .track-add-button {
      flex: none;
      min-width: 110px;
    }

    .track-add-note {
      flex: 1;
      min-height: 1.3em;
      font-size: 12px;
      color: var(--secondary);
    }

    .track-add-button[disabled] {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .track-add-form {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: 10px;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg);
    }

    .track-add-field {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
    }

    .track-add-field input {
      width: 12ch;
      padding: 6px 8px;
      font: inherit;
      font-size: 13px;
      color: var(--text);
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .track-add-kinds {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
    }

    .track-add-kind-label {
      color: var(--secondary);
    }

    .track-add-kind {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .track-add-actions {
      display: flex;
      gap: 8px;
    }

    /* Full-width so a message never reflows the row of controls above it. */
    .track-add-error {
      flex-basis: 100%;
      min-height: 1.3em;
      font-size: 12px;
      color: var(--link);
    }

    /* Removal is offered on user tracks only — a built-in cannot go, so it
       never carries the affordance. Fixed size, so no row changes shape. */
    .track-remove {
      flex: none;
      width: 26px;
      height: 26px;
      font-size: 15px;
      line-height: 1;
      color: var(--secondary);
    }

    .track-remove:hover {
      color: var(--text);
    }

    /* v18: every dial that belongs to a track — the row's Level/Randomness
       and everything in its editor — wears that track's colour on its ring,
       so which track you are adjusting is glanceable from the dial alone.
       Only the ring is re-tinted: the pointer keeps the brass token, because
       the track colours are contrast-checked against --panel/--bg (where the
       ring is drawn) and NOT against the dark --knob-face the pointer crosses.
       Dials that belong to no track (the four main dials, Processor) are left
       on the theme's brass default. */
    .track-row,
    .voice-editor {
      --knob-ring: var(--track-accent, var(--knob-ring-default));
    }

    /* v14: ONE line per track — lamp+name, voice, Level, Randomness, Edit —
       with the track's own colour as a left accent bar. */
    .track-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      padding-left: 8px;
      border-left: 3px solid var(--track-accent, var(--border));
    }

    /* v9 cost meter: a thin bar showing how many notes this track has
       sounding, tinted with the track colour. Populated at 1 Hz while the
       engine runs, hidden when there are no stats to show. */
    .cost-meter {
      display: block;
      width: 100%;
      height: 3px;
      margin-top: 2px;
      background: var(--panel-inset, var(--border));
      border-radius: 2px;
      overflow: hidden;
    }

    .cost-meter-fill {
      display: block;
      width: 0;
      height: 100%;
      background: var(--track-accent, var(--link));
      transition: width 0.4s linear;
    }

    /* Status strip under the row's controls: what the engine is actually
       resolving to right now, plus the cost meter. Its height covers both
       (14px read-out + a 5px meter) at all times — the meter only exists
       while the engine reports stats, and a row that grew when Play was
       pressed would move every row below it. */
    .track-foot {
      display: block;
      flex-basis: 100%;
      min-height: 19px;
    }

    .resolved-readout {
      display: block;
      color: var(--secondary);
      font-size: 12px;
      font-family: var(--label-font, inherit);
      letter-spacing: 0.04em;
      min-height: 14px;
    }

    /* v0.0.46: was 84px, which is narrower than the content it has to hold.
       "Percussion" alone overflowed it (rendering as "Percussio"), and the
       "— off" suffix below pushed the longest labels onto a second line inside
       the button, so a switched-off Arp read as "Arp —" over "off". Wide enough
       for "Percussion — off" now, and nowrap so it can never stack again. The
       width stays fixed rather than auto so the voice pickers still line up
       down the column. */
    .track-name {
      width: 140px;
      flex-shrink: 0;
      font-weight: 600;
      white-space: nowrap;
    }

    /* v12: track-name is now a lamp button — off/auto/on lamp dot (black/
       grey/white) + the track name, cycling state on click, native <button>
       so it's keyboard-operable for free. */
    .track-lamp {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      width: 140px;
      border: none;
      background: none;
      padding: 3px 4px;
      margin: -3px -4px;
      border-radius: var(--radius);
      cursor: pointer;
      font: inherit;
      color: inherit;
      text-align: left;
    }

    .track-lamp:hover {
      background: var(--panel-inset, rgba(255, 255, 255, 0.08));
    }

    .track-lamp:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    /* The lamp dot is the shared .track-chip, so it carries the track's own
       identity colour; state modulates how lit it reads. */
    .track-row[data-track-state='off'] .lamp-dot {
      background: var(--knob-face);
      opacity: 0.5;
    }

    .track-row[data-track-state='auto'] .lamp-dot {
      opacity: 0.65;
    }

    .track-row[data-track-state='on'] .lamp-dot {
      opacity: 1;
      box-shadow: 0 0 5px var(--track-accent, var(--knob-pointer));
    }

    /* v8: melody/bass ship state 'off' — a textual cue (not colour alone)
       so a silent track is obviously wake-able, not just quietly missing. */
    .track-row[data-track-state='off'] .track-name {
      color: var(--secondary);
      font-weight: 400;
      font-style: italic;
    }

    .track-row[data-track-state='off'] .track-name::after {
      content: ' — off';
    }

    .track-voice {
      flex: 1 1 140px;
      min-width: 120px;
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* v8: per-track Level knob/slider, in the main tracks-panel row */
    .track-level {
      display: flex;
      align-items: center;
    }

    .level-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .level-slider {
      display: inline-flex;
      align-items: center;
    }

    .level-slider input[type='range'] {
      width: 120px;
    }

    .voice-edit-toggle[aria-expanded='true'] {
      background: var(--link);
      color: var(--bg);
      border-color: var(--link);
    }

    /* -- track-extras: Random / Hold / Randomness cluster (main row AND the
          voice editor header mirror share this class) -- */

    .track-extras {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }

    .rand-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .rand-slider {
      display: inline-flex;
      align-items: center;
    }

    .rand-slider input[type='range'] {
      width: 120px;
    }

    /* -- voice editor module (faceplate look comes from .module-panel) -- */

    .voice-editor {
      margin-top: 10px;
    }

    .scope-head {
      position: relative;
      max-width: 420px;
      margin: 0 auto 16px;
    }

    .patch-scope {
      display: block;
      width: 100%;
      height: 130px;
      background: var(--scope-bg, #10140f);
      border: 1px solid var(--panel-edge, var(--border));
      border-radius: var(--radius);
    }

    .scope-mode {
      position: absolute;
      top: 8px;
      right: 10px;
      font-family: var(--label-font, inherit);
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--secondary);
    }

    .scope-mode-live {
      color: var(--accent-warm, #d98324);
    }

    /* -- v13/v18/v26 front-page oscilloscope (above the tabs, full width) --
          No title and, since v26, no faceplate: the display is bare, exactly
          like the piano roll below it, and every piece of chrome (note,
          legend, options, fullscreen, twisty) floats over the display's top
          edge. Collapsed, the overlay returns to the flow — otherwise the
          twisty would vanish with the canvas it was sitting on. */

    .scope-module {
      margin-bottom: 20px;
    }

    .scope-stage {
      position: relative;
    }

    .scope-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      display: flex;
      align-items: flex-start;
      gap: 8px;
      padding: 6px 8px;
      /* A scrim, so a trace running along the top edge can't make the legend
         unreadable; it fades out well above the middle of the display. */
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--scope-bg, #10140f) 85%, transparent),
        transparent
      );
      border-radius: var(--radius) var(--radius) 0 0;
      pointer-events: none;
    }

    .scope-overlay > * {
      pointer-events: auto;
    }

    .scope-module.scope-collapsed .scope-overlay {
      position: static;
      padding: 0;
      background: none;
    }

    /* Collapsed there is no trace to key, so the legend goes with the display
       (it stays in the DOM — it is still the selection state). */
    .scope-module.scope-collapsed .scope-legend {
      display: none;
    }

    .scope-controls {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-left: auto;
      flex: none;
    }

    .scope-option {
      background: none;
      border: 1px solid var(--border);
      border-radius: 999px;
      color: var(--secondary);
      padding: 2px 9px;
      font-family: var(--label-font, inherit);
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      min-height: 24px;
    }

    /* Icon-only variant: a square target rather than a word-shaped pill. */
    .scope-option-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      padding: 0;
    }

    .scope-option-icon svg {
      width: 11px;
      height: 15px;
      display: block;
    }

    .scope-option[aria-pressed='true'] {
      border-color: var(--link);
      color: var(--text);
    }

    /* v0.0.49: Total is a legend entry now (same label styling as the
       tracks); its dot is the trace's own white with the trace's dark
       outline, so the legend teaches the reading. */
    .scope-legend-total .scope-legend-dot {
      background: #ffffff;
      box-shadow: 0 0 0 1px rgba(8, 8, 8, 0.65);
    }

    .scope-option:focus-visible,
    .stage-fs-button:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 2px;
    }

    .scope-note {
      flex: 0 1 auto;
      font-size: 11px;
    }

    .scope-collapse {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: none;
      border: 0;
      padding: 0;
      cursor: pointer;
      color: inherit;
      font: inherit;
    }

    .scope-collapse-word {
      font-family: var(--label-font, inherit);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text);
    }

    .scope-twisty::before {
      content: '▾';
      color: var(--secondary);
    }

    .scope-collapse[aria-expanded='false'] .scope-twisty::before {
      content: '▸';
    }

    .scope-collapse:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 3px;
    }

    /* v26: same treatment as #track-visualiser — a bare display, one hairline
       edge and nothing else around it. */
    .front-scope {
      display: block;
      width: 100%;
      height: 160px;
      background: var(--scope-bg, #10140f);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* v18 legend: one key per track in that track's own colour. Single click
       toggles a trace, double click solos. Styled here for BOTH legends —
       scope.js's DOM legend and the page's own fallback build the same three
       class names. v26: it rides the display's top edge instead of sitting
       under it, so it right-aligns into the space the note leaves. */
    .scope-legend {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      align-content: flex-start;
      gap: 4px 6px;
      flex: 1 1 auto;
      min-width: 0;
    }

    /* v0.0.36: these are labels, not buttons. They were pill-shaped, bordered,
       uppercase and letter-spaced, which made 11px read visibly larger than the
       piano roll's own 11px lane labels sitting right beside them — the owner's
       "the P of PAD looks bigger" observation. Same size, same case, same
       weight as the roll now; state lives entirely in the dot. */
    .scope-legend-track {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 0;
      border-radius: 0;
      background: none;
      color: var(--secondary);
      padding: 3px 6px;
      font-family: var(--label-font, inherit);
      font-size: 11px;
      letter-spacing: 0;
      text-transform: none;
      cursor: pointer;
      min-height: 26px;
    }

    .scope-legend-track:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 1px;
    }

    /* Tri-state, matching the piano roll's lamp (auto grey / on white / off).
       Filled in the track's own colour = will show when this track plays;
       white = sounding right now; a bar = playing but its trace is hidden. */
    .scope-legend-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--track-accent, var(--scope-trace));
      opacity: 0.35;
      flex: none;
    }

    .scope-legend-track[data-state='sounding'] .scope-legend-dot {
      background: #ffffff;
      opacity: 1;
      box-shadow: 0 0 0 1px var(--track-accent, var(--border));
    }

    .scope-legend-track[data-state='hidden'] .scope-legend-dot {
      border-radius: 1px;
      height: 3px;
      opacity: 0.9;
    }

    .scope-legend-track[aria-pressed='true'] {
      color: var(--text);
    }

    .scope-legend-track[aria-pressed='true'] .scope-legend-dot {
      opacity: 1;
    }

    .scope-legend-track:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 2px;
    }

    /* -- share links -- */

    .share-note {
      overflow-wrap: anywhere;
    }

    /* v29 link name: an engraved read-out under the Share row. The line is
       always in the layout (the value falls back to an em dash), so a name
       arriving never moves the buttons above it — the same reserved-space rule
       the dial rows follow. */
    .share-name-row {
      margin-bottom: 6px;
      min-height: 22px;
    }

    .share-name-label {
      color: var(--secondary);
    }

    .share-name-value {
      color: var(--text);
      font-size: 15px;
      letter-spacing: 0.04em;
      overflow-wrap: anywhere;
    }

    /* -- the Advanced tab's copy of the four main dials -- */

    /* v18: START, not END — every dial in the row hangs from one baseline at
       the top, and the reserved label/read-out zones below keep the bottoms
       level too. Bottom-aligning made any dial with an extra line of text
       (a ghost read-out, a wrapped name) ride up above its neighbours. */
    /* v0.0.37: the Main dials were stacking into one preposterous vertical
       column. Cause: `#advanced-dials` carries `.sliders-module`, which is
       `display: flex` for the Simple tab's row of dials — so the grid inside it
       was a flex item with no width of its own, shrink-to-fit, and `auto-fit`
       resolved to the single narrowest column it could. The panel is a wrapper
       around a label, a grid and a hint; it was never meant to be a flex row.
       Explicit four columns now, so the four that mirror Simple fill the first
       row and the extra three sit beneath them, which is the shape the owner
       asked for and also the one that reads. */
    /* Two short controls to a row. */
    .control-pair {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 16px;
    }

    @media (max-width: 420px) {
      .control-pair {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    #advanced-dials {
      display: block;
    }

    /* The ⓘ sits at the end of the dial grid rather than above it, so the panel
       opens with dials and nothing else. */
    .dial-info-row {
      display: flex;
      justify-content: flex-end;
      margin-top: 4px;
    }

    .advanced-dial-row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      align-items: start;
    }

    /* A grid cell already centres its dial; the flex-context max-width would
       only strand the label off to one side. */
    .advanced-dial-row .simple-dial {
      max-width: none;
    }

    @media (max-width: 760px) {
      .advanced-dial-row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 400px) {
      .advanced-dial-row {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .knob-sections {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 14px;
    }

    .knob-section > .panel-label {
      display: block;
      margin-bottom: 8px;
    }

    /* Knobs wrap into a grid; still usable at 360 px viewport width. */
    /* v0.0.59: a FIXED four columns rather than auto-fill.
       auto-fill packs as many columns as fit, which at the editor's ~600px
       width is six — so the Source row's seven dials rendered 6 + 1, the
       "three on one line and one below" complaint in its worst form. Four
       columns split seven as 4 + 3 and four as one clean row, and every
       other knob row in the editor has four or fewer.

       Measured, not guessed: a probe grouping each row's children by the top
       of their box reported 5 + 1 + 1 at first, which was wrong — the Osc-2
       toggle cell is 34px tall against the dials' 109px, so it took a
       different `top` while sitting on the same line. It is 6 + 1. */
    .knob-row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px 8px;
      align-items: start;
      justify-items: center;
    }

    /* Two columns on a phone: seven becomes 2+2+2+1 and four becomes 2+2,
       both as even as the counts allow. One column would strand a 96px dial
       in a full-width cell. */
    @media (max-width: 520px) {
      .knob-row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .knob-cell {
      display: flex;
      justify-content: center;
      width: 100%;
    }

    /* Not a dial: the Osc 2 key centres against the faces beside it. */
    .knob-cell-toggle {
      align-self: center;
    }

    /* -- v14 kit editor (percussion): Common | High | Mid | Low -- */

    .kit-tabs {
      margin: 0 0 14px;
    }

    .knob-cell-ghosted {
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    /* The common-value affordance. knob.js draws a real muted ghost pointer
       on the dial face when it supports one — then this row holds only the
       "follow" button. On an older knob.js the same row carries the text
       fallback instead: a secondary read-out with a dot in the track colour. */
    .knob-ghost {
      display: flex;
      align-items: center;
      gap: 4px;
      font-family: var(--label-font, inherit);
      font-size: 10px;
      letter-spacing: 0.04em;
      color: var(--secondary);
    }

    .knob-ghost-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--track-accent, var(--secondary));
      opacity: 0.55;
      flex: none;
    }

    .knob-follow {
      font-size: 10px;
    }

    /* An overridden dial takes the track accent so the kit's exceptions are
       visible at a glance. */
    /* No padding: a ring drawn INSIDE the cell tints an overridden dial
       without nudging its face out of the row's shared baseline. */
    .knob-cell-overridden {
      border-radius: var(--radius);
      box-shadow: inset 0 0 0 1px var(--track-accent, var(--link));
    }

    .knob-cell-overridden .knob-ghost-dot {
      opacity: 1;
    }

    /* v12: shape-dial glyph readout (knob.js's `glyph` option) — icon(s)
       inline before the text, coloured with the readout's own text colour. */
    .knob-value-glyph {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      margin-right: 4px;
      vertical-align: middle;
      color: var(--text);
    }

    .osc2-toggle[aria-pressed='true'] {
      background: var(--link);
      color: var(--bg);
      border-color: var(--link);
    }

    .voice-editor .ve-section {
      margin-bottom: 12px;
    }

    .voice-editor .ve-heading {
      display: block;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--secondary);
    }

    .voice-editor .ve-control {
      margin-bottom: 10px;
    }

    .voice-editor .ve-control label {
      font-size: 14px;
    }

    .voice-editor select {
      width: 100%;
      padding: 6px 8px;
      font-size: 14px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* -- v6/v8: voice-editor header (track name + Random/Hold/Randomness) -- */

    .ve-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
    }

    .ve-extras {
      flex: 1 1 auto;
      justify-content: flex-end;
    }

    /* -- v6: per-track randomisation-target mini knobs -- */

    .vary-row {
      margin-bottom: 16px;
    }

    .vary-row > .panel-label {
      display: block;
      margin-bottom: 8px;
    }

    .vary-cells {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 10px 8px;
    }

    .vary-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .vary-slider {
      flex: 1 1 160px;
      margin-bottom: 0;
    }

    /* -- v6: arpeggiator section (relocated into the Arp track's editor) -- */

    .arp-inline {
      margin-bottom: 20px;
    }

    .arp-inline > .panel-label {
      display: block;
      margin-bottom: 8px;
    }

    .arp-manual {
      margin-top: 10px;
    }

    /* -- v6: shared step sequencer (melody/bass/arp single-lane,
          percussion three-lane) — grid width driven by --seq-cols, set by
          the page script per track/metre/arp-rate -- */

    .seq {
      margin-bottom: 20px;
    }

    .seq-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
    }

    .seq-editors {
      display: flex;
      gap: 6px;
    }

    .seq-editor-button {
      font-size: 12px;
      letter-spacing: 0;
    }

    .seq-editor-button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .seq-blocks {
      margin-bottom: 8px;
    }

    .seq-scroll {
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .seq-beats,
    .seq-lane {
      display: grid;
      grid-template-columns: repeat(var(--seq-cols, 16), minmax(22px, 1fr));
      gap: 3px;
    }

    .seq-beats {
      margin-bottom: 2px;
    }

    /* Pulls the (now separate role="row") probability strip back up
       against its own cell row rather than sitting a full flex gap away. */
    .seq-prob-row {
      margin-top: -3px;
    }

    .seq-beat-mark {
      font-size: 10px;
      text-align: center;
      color: var(--secondary);
    }

    .seq-rows {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .seq-lane-label {
      grid-column: 1 / -1;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--secondary);
    }

    /* -- v21 kit lanes: add / rename / re-kind / reorder / remove -------- */

    .seq-lane-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .seq-lane-add {
      padding: 4px 12px;
      line-height: 1;
    }

    /* v0.0.68: the chord loop. One line — a text field and a way out of it —
       because a row of chip widgets for something most people will never touch
       would take more of the panel than the thing deserves. */
    /* v0.0.76: the audible chord editor. One chip per chord in the loop —
       press its face to hear it, use the small tools to move it through the
       scale or widen it. The face is the whole chip because hearing the chord
       is the primary act; the tools recede until wanted. */
    .progression-chords {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }

    .chord-chip {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      min-width: 96px;
      background: var(--bg);
    }

    .chord-chip-hear {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 8px 10px 6px;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
      font: inherit;
      text-align: center;
    }

    .chord-chip-hear:hover,
    .chord-chip-hear:focus-visible {
      background: color-mix(in srgb, var(--link) 12%, transparent);
    }

    .chord-chip-numeral {
      font-family: var(--label-font, inherit);
      font-size: 1.15rem;
      letter-spacing: 0.08em;
    }

    .chord-chip-name {
      font-size: 0.78rem;
      opacity: 0.8;
    }

    .chord-chip-notes {
      font-size: 0.72rem;
      opacity: 0.62;
      letter-spacing: 0.04em;
    }

    /* While a chord is sounding. The same accent the playhead uses, so "this
       is the thing making the noise right now" means one thing in the app. */
    .chord-chip-sounding {
      border-color: var(--link);
      box-shadow: inset 0 0 0 1px var(--link);
    }

    .chord-chip-tools {
      display: flex;
      align-items: stretch;
      border-top: 1px solid var(--border);
    }

    .chord-chip-tools button {
      flex: 1 1 auto;
      border: 0;
      border-left: 1px solid var(--border);
      background: transparent;
      color: inherit;
      font: inherit;
      font-size: 0.72rem;
      padding: 4px 2px;
      cursor: pointer;
      min-height: 28px;
    }

    .chord-chip-tools button:first-child {
      border-left: 0;
    }

    .chord-chip-tools button:hover:not(:disabled),
    .chord-chip-tools button:focus-visible {
      background: color-mix(in srgb, var(--link) 16%, transparent);
    }

    .chord-chip-tools button:disabled {
      opacity: 0.35;
      cursor: default;
    }

    .chord-chip-colour {
      flex: 2 1 auto !important;
      letter-spacing: 0.02em;
    }

    .chord-chip-trailing {
      display: flex;
      flex-direction: column;
      gap: 6px;
      justify-content: center;
    }

    .progression-row {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }

    .progression-input {
      flex: 1 1 220px;
      min-width: 0;
      font-family: var(--label-font, inherit);
      letter-spacing: 0.06em;
    }

    .progression-input::placeholder {
      letter-spacing: normal;
      font-style: italic;
      opacity: 0.7;
    }

    .progression-clear {
      flex: 0 0 auto;
    }

    /* v0.0.67: a step the APP chose, as distinct from one you typed.
       Outlined, not filled — the fill is reserved for a user's own step, and
       the difference between "the app decided this" and "I decided this" is
       the entire reason for showing it. Drawn with an inset shadow rather
       than a border so it cannot change the cell's size and shift the grid
       under the pointer. */
    .seq-cell-chosen {
      box-shadow: inset 0 0 0 2px var(--accent-warm, #c98a4b);
    }

    /* v0.0.75: where the app's chosen notes sit in pitch. A tick per note,
       positioned by MIDI number inside the step, so a line's shape reads
       across a bar without reading a single name. It is a readout: no pointer
       events, and it never changes the cell's size. */
    .seq-pitch {
      position: absolute;
      inset: 3px 2px;
      pointer-events: none;
    }

    .seq-pitch-mark {
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      margin-bottom: -1px;
      border-radius: 1px;
      background: var(--link);
      opacity: 0.9;
    }

    /* On a step the user typed, the fill is already the loud thing — the tick
       sits on top of it and needs to read against it rather than compete. */
    .seq-cell-on .seq-pitch-mark {
      background: var(--bg);
      opacity: 0.95;
    }

    .seq-pitch-legend {
      margin: 6px 0 0;
      font-size: 0.8rem;
      opacity: 0.75;
    }

    /* A cell that is both chosen and typed reads as typed: the user's own
       statement wins, and the outline would only muddy a filled cell. */
    .seq-cell-chosen.seq-cell-on {
      box-shadow: none;
    }

    /* v0.0.66: the lane's rare controls recede until wanted. Opacity rather
       than display, so they hold their space and the header cannot jump as the
       pointer crosses it — and so they stay in the accessibility tree, which
       `display: none` would take them out of. Focus reveals them too, which is
       what keeps the keyboard route real rather than nominal. On touch, where
       there is no hover, they are simply always visible. */
    .seq-lane-tools {
      display: inline-flex;
      gap: 4px;
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    .seq-lane-head:hover .seq-lane-tools,
    .seq-lane-head:focus-within .seq-lane-tools {
      opacity: 1;
    }

    @media (hover: none) {
      .seq-lane-tools {
        opacity: 1;
      }
    }

    .seq-lane-head {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      min-height: 26px;
    }

    /* The lane's own tint, mixed from the track accent — one instrument, its
       lanes told apart by shade rather than by six unrelated colours. */
    .seq-lane-tinted .seq-lane-label {
      color: var(--lane-tint, var(--secondary));
    }

    .seq-lane-tinted .seq-cell-on .seq-band {
      background: var(--lane-tint, var(--accent-warm, var(--link)));
    }

    .seq-lane-name {
      max-width: 12ch;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .seq-lane-input {
      width: 12ch;
    }

    .seq-lane-grip {
      padding: 0 2px;
      font-size: 13px;
      line-height: 1;
      color: var(--secondary);
      background: none;
      border: 0;
      cursor: grab;
      touch-action: none;
    }

    .seq-lane-dragging {
      opacity: 0.6;
    }

    .seq-lane-drop {
      box-shadow: inset 0 -2px 0 var(--link);
    }

    .seq-lane-kind {
      padding: 2px 4px;
      font-size: 11px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .seq-lane-move,
    .seq-lane-remove {
      width: 22px;
      height: 22px;
      min-width: 0;
      padding: 0;
      font-size: 11px;
      line-height: 1;
    }

    .seq-lane-move:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    /* v14 multi-sequencer strip: tab per sequencer, "+" copies the current
       one, and one weight number ("how likely the others hand over to me"). */
    .seq-tabs {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .seq-tabs-single .seq-tab-strip,
    .seq-tabs-single .seq-weight {
      display: none;
    }

    .seq-title {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .seq-add {
      padding: 4px 12px;
      line-height: 1;
    }

    .seq-weight {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--secondary);
    }

    .seq-weight input {
      width: 68px;
      padding: 4px 6px;
      font-size: 13px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* v14 probability groups: a dot per step above its lane, coloured by
       group. Inside a group a step only gets its chance if the group's
       previous step actually sounded. */
    .seq-dot-row {
      margin-bottom: 2px;
    }

    .seq-dot-cell {
      display: flex;
      justify-content: center;
    }

    .seq-dot {
      width: 10px;
      height: 10px;
      padding: 0;
      background: none;
      border: 1px solid var(--border);
      border-radius: 50%;
      cursor: pointer;
    }

    .seq-dot-on {
      border-color: transparent;
    }

    /* The group selected for painting: its members ring so "which group am I
       adding to" is answered on the grid itself, not from memory. */
    /* v0.0.131: the ×2 / ÷2 editing-resolution control, beside mass edit. */
    .seq-res-bar {
      align-items: center;
      gap: 6px;
    }

    .seq-res-readout {
      min-width: 16ch;
      text-align: center;
    }

    .seq-res-triplet[aria-pressed='true'] {
      border-color: var(--link);
      color: var(--link);
    }

    .seq-dot-active {
      box-shadow: 0 0 0 2px var(--link);
    }

    .seq-dot:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 2px;
    }

    /* v0.0.111: the pitch pin, on the cell where the claim is made. */
    .seq-pin {
      position: absolute;
      top: 2px;
      left: 3px;
      font-size: 0.62rem;
      line-height: 1;
      color: var(--fg);
      background: color-mix(in srgb, var(--bg) 70%, transparent);
      border-radius: 3px;
      padding: 1px 2px;
      pointer-events: none;
      z-index: 2;
    }

    .seq-pitch-input {
      position: absolute;
      inset: 4px;
      width: calc(100% - 8px);
      background: var(--bg);
      color: var(--fg);
      border: 1px solid var(--link);
      border-radius: 4px;
      font-size: 0.75rem;
      padding: 2px 4px;
      z-index: 3;
    }

    .seq-cell {
      position: relative;
      min-height: 48px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      cursor: pointer;
      overflow: hidden;
    }

    .seq-cell-beat {
      border-left: 2px solid var(--accent-warm, var(--link));
    }

    .seq-cell-on {
      border-color: var(--link);
    }

    .seq-cell:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    .seq-band {
      position: absolute;
      display: block;
      left: 2px;
      right: 2px;
      bottom: 0;
      height: 0;
      background: var(--accent-warm, var(--link));
      opacity: 0.55;
      border-radius: 2px;
      pointer-events: none;
    }

    .seq-cell-on .seq-band {
      opacity: 0.85;
    }

    /* Fat grab handle riding the band's loud edge — ≥10 px tall so the
       velocity top is grabbable without pixel-hunting (v13 correction). */
    .seq-band-top {
      position: absolute;
      display: block;
      left: 0;
      right: 0;
      height: 12px;
      margin-bottom: -6px;
      cursor: ns-resize;
      touch-action: none;
    }

    .seq-band-top::after {
      content: '';
      position: absolute;
      left: 2px;
      right: 2px;
      top: 5px;
      height: 2px;
      border-radius: 2px;
      background: var(--knob-pointer, var(--text));
      opacity: 0.7;
    }

    /* v0.0.92: a tied run IS one wide box (the head cell spans it; the
       absorbed cells are gone), so the box needs no bridge marker — a thin
       warm underline is all that says "tied" rather than "long gate". */
    .seq-cell-tie {
      box-shadow: inset 0 -3px 0 var(--accent-warm, var(--link));
    }

    /* v21 note length past the step it starts in: the band cannot show width
       it hasn't got, so the overhang is marked with an arrow into the next
       step (distinct from the tie bridge, which joins two struck steps). */
    .seq-cell-legato::before {
      content: '›';
      position: absolute;
      right: 2px;
      top: 1px;
      font-size: 12px;
      line-height: 1;
      color: var(--accent-warm, var(--link));
      pointer-events: none;
    }

    /* v14 playhead: the sounding step lights up. The cream --knob-pointer
       reads as the asked-for white on the dark theme; --text carries the
       mark on the light theme, where a literal white would vanish. */
    .seq-cell-playing {
      border-color: var(--text);
      box-shadow: inset 0 0 0 2px var(--knob-pointer);
    }

    .seq-prob {
      position: relative;
      display: block;
      height: 5px;
      margin-top: 2px;
      background: var(--border);
      border-radius: 3px;
      cursor: pointer;
      overflow: hidden;
    }

    .seq-prob-fill {
      position: absolute;
      display: block;
      top: 0;
      left: 0;
      bottom: 0;
      width: 0;
      background: var(--link);
    }

    /* A ranged (drifting) step prob shows its min–max window instead of a
       from-zero fill, tinted like the knob's own range arc. */
    .seq-prob-fill-range {
      background: var(--accent-warm, var(--link));
      opacity: 0.85;
    }

    /* -- v14: dissonance dial, factory presets, tutorial panel -- */

    /* v26: the ONE feel row per editor. Fixed-width cells on a wrapping flex
       line, aligned at the top so every face hangs from the same baseline and
       the text under it stays below (v18 dial contract) — a long read-out can
       never shove its neighbour up. */
    .dissonance-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 12px 8px;
      margin-bottom: 16px;
      --knob-size: 72px;
    }

    .dissonance-row > .knob-cell {
      width: calc(var(--knob-size, 72px) + 12px);
    }

    /* The slider fallback has no square face to align, so it takes a readable
       width and wraps onto the next line rather than squeezing the dials. */
    .dissonance-row > .ve-control {
      flex: 1 1 200px;
      margin-bottom: 0;
    }

    .dissonance-knob {
      width: 84px;
    }

    /* v12 mono/glide, in the voice-editor header beside the state lamp. The
       dial takes the same 84px cell every other knob in a row uses, so the
       header's faces stay on one baseline (v18 layout contract).

       v0.0.58: the toggle is a Poly | Mono segmented pair rather than one
       button wearing a pressed state. Sized to sit against the 84px dial cell
       beside it without being the tallest thing in the header. */
    .segmented.voice-mode label {
      padding: 5px 10px;
      font-size: 12px;
    }

    .segmented.voice-mode input:checked + label {
      background: var(--link);
      color: var(--bg);
    }

    .glide-knob,
    .drift-knob {
      display: flex;
      justify-content: center;
      width: 84px;
    }

    .glide-slider {
      display: inline-flex;
      align-items: center;
    }

    .glide-slider input[type='range'] {
      width: 120px;
    }

    .factory-presets {
      margin-bottom: 20px;
    }

    .factory-presets > .panel-label {
      display: block;
      margin-bottom: 10px;
    }

    /* v16: the gallery itself lives on Simple; Advanced keeps a way in. */
    .factory-presets-link {
      margin-bottom: 20px;
    }

    .factory-preset-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 8px;
    }

    .factory-preset {
      display: flex;
      flex-direction: column;
      gap: 3px;
      align-items: flex-start;
      text-align: left;
    }

    .factory-preset-name {
      font-weight: 700;
    }

    .factory-preset-blurb {
      font-weight: 400;
      font-size: 13px;
      color: var(--secondary);
    }

    /* Docked right of the main column on a wide screen; a plain block
       beneath it on a narrow one. */
    .tutorial-panel {
      position: fixed;
      top: 96px;
      right: 16px;
      z-index: 25;
      width: 280px;
      max-height: calc(100vh - 128px);
      overflow-y: auto;
    }

    .tutorial-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
    }

    .tutorial-step-text {
      margin: 0 0 12px;
      font-size: 14px;
      line-height: 1.5;
    }

    .tutorial-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .tutorial-highlight {
      outline: 3px solid var(--accent-warm, var(--link));
      outline-offset: 4px;
      border-radius: var(--radius);
    }

    @media (max-width: 1100px) {
      .tutorial-panel {
        position: static;
        width: auto;
        max-width: 640px;
        max-height: none;
        margin-bottom: 20px;
      }
    }

    /* -- custom structure builder -- */

    .custom-structure {
      margin: -8px 0 20px;
    }

    .structure-blocks {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 12px;
    }

    .structure-block {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      padding: 8px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    /* v0.0.57: each numeric control carries its name. Baseline-aligned rather
       than stacked, so a block row stays one line on a desktop and wraps as a
       unit on a phone. */
    .custom-metre {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      margin-left: 6px;
    }
    .custom-metre input {
      width: 44px;
    }
    .block-title {
      width: 76px;
      font-size: 11px;
      padding: 3px 5px;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 4px;
    }
    .block-field {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--secondary);
    }

    .block-field-wide {
      flex: 1 1 200px;
      min-width: 160px;
    }

    .block-field-wide input[type='range'] {
      flex: 1 1 auto;
      min-width: 80px;
    }

    /* v0.0.72: the spread-shape picker, sized to sit in the feel row beside
       the drift-rate dial rather than starting a line of its own. */
    .drift-shape {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--secondary);
    }

    .drift-shape select {
      width: auto;
      padding: 4px 6px;
      font-size: 12px;
    }

    /* v0.0.73: six initials, one per instrument, cycling app-decides → always
       → never. Sized as text rather than as buttons, because a row of six real
       buttons in every structure block is exactly the "tonne of UI space" the
       owner objected to in this panel. */
    .block-tracks {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-size: 12px;
      color: var(--secondary);
    }

    .block-track {
      width: 20px;
      height: 20px;
      padding: 0;
      font-size: 11px;
      font-weight: 700;
      line-height: 20px;
      color: var(--secondary);
      background: none;
      border: 1px solid var(--border);
      border-radius: 4px;
      cursor: pointer;
    }

    .block-track[data-state='on'] {
      color: var(--bg);
      background: var(--link);
      border-color: var(--link);
    }

    .block-track[data-state='off'] {
      color: var(--secondary);
      border-style: dashed;
      opacity: 0.55;
    }

    .block-field-name {
      white-space: nowrap;
    }

    /* Reserved width so the row does not jog as the percentage changes. */
    .block-field-value {
      min-width: 4ch;
      text-align: right;
      font-variant-numeric: tabular-nums;
      color: var(--text);
    }

    .structure-block select {
      width: auto;
      padding: 6px;
    }

    .structure-block input[type='number'] {
      width: 64px;
      padding: 6px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .structure-block input[type='range'] {
      flex: 1 1 100px;
    }

    .structure-block button {
      padding: 4px 8px;
      font-size: 13px;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .structure-block button:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .secondary-button {
      padding: 8px 14px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .secondary-button:focus-visible {
      outline: 3px solid var(--link);
      outline-offset: 2px;
    }

    #generator-unavailable {
      color: var(--secondary);
    }

    /* -- small-screen touch targets (~44px) -- */

    @media (max-width: 480px) {
      .segmented label {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 10px 14px;
      }
    }

    /* -- v0.0.57: Universal | Per instrument, under the dial it governs ----
       The TODO flagged this as "wider than the dial it governs; needs a layout
       answer". The answer is to stop treating it as a button and treat it as a
       third caption: dial-label type size, dial-label colour, no fill, hairline
       divider between the two halves. At 10px with 5px padding the pair is
       ~118px against a 4-column cell that floors at ~145px, so it fits the
       tightest desktop case without an ellipsis rule — and the row it sits in
       collapses to 2 columns at 760px and 1 at 400px, both of which are wider.

       It is centred under the readout rather than left-aligned because the dial
       above it is centred, and a control that governs a dial should sit under
       its middle. */
    .scope-slot {
      display: flex;
      justify-content: center;
      margin-top: 6px;
      min-height: 0;
      /* The control keeps its own width and bleeds into the grid gutter rather
         than being squeezed — the same rule the v18 dial contract already
         applies to a long readout, and for the same reason: the alternative is
         a box that silently cuts its own text off. */
      overflow: visible;
    }

    .scope-slot > .segmented {
      flex: 0 0 auto;
    }

    .segmented.dial-scope {
      border-radius: 999px;
      /* Never wrap. The base .segmented wraps, which on a 143px dial cell put
         "Universal" on one line and "Per instrument" on the next — a vertical
         pair that no longer reads as one control with two halves. Measured, not
         guessed: `.vibe/measure.sh local drive` against the 4-column desktop
         case is what caught it. */
      flex-wrap: nowrap;
    }

    /* Sentence case with no letter-spacing, which is what buys the fit: the
       uppercase + 0.04em version measured 197px against a 143px cell. It also
       stops the control reading as a third dial CAPTION — the two labels above
       it are the uppercase ones. */
    .segmented.dial-scope label {
      padding: 3px 4px;
      font-size: 10px;
      font-weight: 600;
      white-space: nowrap;
      color: var(--secondary);
      font-family: var(--label-font, inherit);
    }

    /* The selected half is the one that reads as text; the other recedes.
       Deliberately NOT a filled pill — a filled half on a 10px control next to
       a dial face reads as a lit indicator, i.e. as state the ENGINE is
       reporting rather than a choice the user has made. */
    .segmented.dial-scope input:checked + label {
      color: var(--text);
      background: var(--surface-raised, rgba(0, 0, 0, 0.05));
    }

    @media (prefers-color-scheme: dark) {
      .segmented.dial-scope input:checked + label {
        background: rgba(255, 255, 255, 0.08);
      }
    }

    .segmented.dial-scope input:focus-visible + label {
      outline: 2px solid var(--accent-warm, #c98a4b);
      outline-offset: -2px;
    }

    /* -- v0.0.56: dials on a touch screen --------------------------------
       Two changes, both consequences of the horizontal-drag gesture.

       The dials that shrank to 56 px (the processor dial) and 72 px (the
       per-lane rows) are now targets for a gesture with a CENTRE zone as
       well as a rim: at 56 px the hub is under 13 px across, which is half
       the ~24 px an adult fingertip actually resolves. On a touch screen
       they take the same 88 px the main dials use, so the hub is a real
       target rather than a notional one. Pointer devices keep the compact
       sizes, where a mouse can hit 13 px without thinking about it.

       `touch-action: none` is set by knob.js on each knob's own root, which
       is what stops iOS reading a horizontal drag on a dial as the page's
       back-swipe. It is repeated here for the cells around them so a drag
       that starts a pixel outside the face is not stolen either. */
    @media (pointer: coarse) {
      .processor-row,
      .dissonance-row,
      .vary-cells {
        --knob-size: 88px;
      }

      .knob-cell,
      .vary-knob,
      .simple-dial {
        touch-action: none;
      }
    }
  </style>
</Base>
